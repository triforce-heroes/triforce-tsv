  {
    "key": "upgrade_lamp_light_pickup_01",
    "value": "Sonnenanbeterin",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Besiegte Gegner haben eine Chance, eine zusätzliche Lichtkugel zu hinterlassen.",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_flavor",
    "value": ""Bringe ihre innere Sonne hervor."",
