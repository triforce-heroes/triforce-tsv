  {
    "key": "collectibles.collectible_amulet",
    "notes": "Pun on Boom boxx song "Balla da li"",
    "value": "Amulett von Baal Ahdahli-Dihla",
  },
  {
    "key": "collectibles.collectible_amulet_desc",
    "value": "Augenscheinlich potenter als ein Glückskleeblatt oder eine Hasenpfote. Die Augen besitzen ein unheimliches Glühen und es beginnt sich warm anzufühlen. Ist das ein Gesang, der da aus seinem Inneren zu vernehmen ist?",
  },
  {
    "key": "collectibles.collectible_amulet_flavor",
    "notes": "https://www.youtube.com/watch?v=iVC6nlhU4-E Phrase from song",
    "value": ""Shalalala-la."",
  },
  {
    "key": "collectibles.collectible_cereal",
    "value": "Schüssel mit Cornflakes",
  },
  {
    "key": "collectibles.collectible_cereal_desc",
    "notes": "Pun on Jurassic Park 2 - The lost world",
    "value": "Einst das wichtigste Mahl des Tages. Nun sind es nur noch die vertrockneten Überreste einer vergangenen Welt.",
  },
  {
    "key": "collectibles.collectible_cereal_flavor",
    "notes": "Pun on Winston Churchill quote "History will be kind to me for I intend to write it."",
    "value": ""Die Geschichte wird mir wohlgesonnen sein. Denn ich habe vor, es zu essen."",
  },
  {
    "key": "collectibles.collectible_dead_rat",
    "notes": "Latin for a rat type",
    "value": "Rattus norvegicus",
  },
  {
    "key": "collectibles.collectible_dead_rat_desc",
    "value": "Durch das enge Zusammenleben mit Menschen könnte man denken, dass es sich um entfernte Cousins handeln würde. Sie besitzt erstaunliche kognitive Fähigkeiten und eine sagenhafte Auffassungsgabe. Man munkelt, dass es eine sogar bis zum Premierminister von Norwegen gebracht habe.",
  },
  {
    "key": "collectibles.collectible_dead_rat_flavor",
    "value": ""Wenn man ist, was man isst, dann will ich sicherlich nur das Beste essen."",
  },
  {
    "key": "collectibles.collectible_fertilizer",
    "value": "Dünger",
  },
  {
    "key": "collectibles.collectible_fertilizer_desc",
    "notes": "It's poop.",
    "value": "Welche Kreatur auch immer diesen stattlichen Haufen hinterlassen haben mag, muss am Tag zuvor ein 4-Gänge-Menü verdrückt haben. Riecht würzig.",
  },
  {
    "key": "collectibles.collectible_fertilizer_flavor",
    "notes": "Bowel movements.",
    "value": ""Auf seinem Misthaufen ist der Hahn König."",
  },
  {
    "key": "collectibles.collectible_scented_candle",
    "value": "Duftkerze",
  },
  {
    "key": "collectibles.collectible_scented_candle_desc",
    "notes": "http://www.ucl.ac.uk/archaeology/boneview/Interactive%20Components/Mammalian%20Skeleton/Elements/Skull/oviscapralateral.html",
    "value": "Die berühmte Form des Schädels einer Hausziege. Strömt eine Aura aus, die an Zerstörung und ... Vanille erinnert.",
  },
  {
    "key": "collectibles.collectible_scented_candle_flavor",
    "value": ""Der Drang zu zerstören, ist ebenfalls ein kreativer Drang."",
  },
  {
    "key": "collectibles.collectible_wrapped_gift",
    "notes": "Pun on Schrödinger's cat https://en.wikipedia.org/wiki/Schr%C3%B6dinger%27s_cat",
    "value": "Schrödinger's Was?",
  },
  {
    "key": "collectibles.collectible_wrapped_gift_desc",
    "value": "In diesem ordentlich verpackten Paket könnte sich nahzu alles befinden. Vielleicht ist es eine Puppe, ein Fußball oder eine Katze.",
  },
  {
    "key": "collectibles.collectible_wrapped_gift_flavor",
    "value": ""Was ist in der Schachtel?"",
  },
  {
    "key": "collectibles.collectible_holy_toast",
    "notes": "Pun on Expression "Holy... and then anything" Like Holy Moly!",
    "value": "Heiliger Toast",
  },
  {
    "key": "collectibles.collectible_holy_toast_desc",
    "value": "Manchmal versucht das Universum selbst mit uns niederen Wesen zu kommunizieren – durch völlig unscheinbare Objekte. Dies ist keines davon.",
  },
  {
    "key": "collectibles.collectible_holy_toast_flavor",
    "notes": "Pun on all things bread = BREADy, SOUR = sour dough, DONUT, LOAF = loaf of bread",
    "value": ""Lasset uns beten. Die Wege der Götter sind wahrlich unergründlich."",
  },
  {
    "key": "collectibles.collectible_lime_snowman",
    "value": "Limonenschneemann",
  },
  {
    "key": "collectibles.collectible_lime_snowman_desc",
    "notes": "Spoof on song White Christmas",
    "value": "Schneemann, Schneemann, kalter Mann. Hast ne grüne Nase dran. Grüne Augen, grüner Mund. Bist so dick und kugelrund. Kommt der warme Sonnenschein, wirst du bald geschmolzen sein.",
  },
  {
    "key": "collectibles.collectible_lime_snowman_flavor",
    "value": ""Ich liebe Schnee. Außer wenn er gelb ist."",
  },
  {
    "key": "collectibles.collectible_inflatable_friend",
    "value": "Aufblasbarer Freund",
  },
  {
    "key": "collectibles.collectible_inflatable_friend_desc",
    "value": "Die Einsamkeit ist ein seltsamer Zeitgenosse. Alleine überwältigt sie einen. Aber wenn man sie mit anderen zusammen sucht, ist sie nie zu finden.",
  },
  {
    "key": "collectibles.collectible_inflatable_friend_flavor",
    "notes": "Lyrics from Celine Dion song All by myself",
    "value": ""Immer, wenn ich anrufe, ist keiner zu Hause."",
  },
  {
    "key": "collectibles.collectible_book_groda",
    "notes": "Groda = Frog in Swedish",
    "value": "Dr. S. Ophias Lehrbuch für Kinder",
  },
  {
    "key": "collectibles.collectible_book_groda_desc",
    "value": "Die gute alte Dr. S.Ophia hatte schon immer eine Schwäche dafür, junge Menschen an ihrer Weisheit teilhaben zu lassen.",
  },
  {
    "key": "collectibles.collectible_book_groda_flavor",
    "notes": "Frogret is a frog pun on word forget.",
    "value": ""Wissen macht Ah!"",
  },
  {
    "key": "collectibles.collectible_birdie_seeds",
    "notes": "From Peter Sellers movie "The Party"",
    "value": "Cindys super leckere Spatzensamen",
  },
  {
    "key": "collectibles.collectible_birdie_seeds_desc",
    "notes": "Peter Sellers",
    "value": "Köstliche Spezialität und der Hit auf jeder Party.",
  },
  {
    "key": "collectibles.collectible_birdie_seeds_flavor",
    "notes": "Pun on old adverb A bird in the hand is worth two in the bush = what you got is more worth than what you don't have",
    "value": ""Besser den Spatz in der Hand als den Tauben auf dem Dach."",
  },
  {
    "key": "collectibles.collectible_straw_doll",
    "notes": "Woodoo Doll",
    "value": "Akupunkturstrohpuppe",
  },
  {
    "key": "collectibles.collectible_straw_doll_desc",
    "value": "Beeindruckende Handwerkskunst! Die vereinzelten roten Flecken verleihen diesem Gegenstand das gewisse Etwas.",
  },
  {
    "key": "collectibles.collectible_straw_doll_flavor",
    "value": ""Auf der Rückseite befinden sich einige Initialen: W. U. D. U."",
  },
  {
    "key": "collectibles.collectible_glowing_goo",
    "value": "Leuchtender Glibber",
  },
  {
    "key": "collectibles.collectible_glowing_goo_desc",
    "value": "Ein hell leuchtender Schleim, der nicht von dieser Welt zu sein scheint. Sieht ungewöhnlich ungesund aus. Besser nicht in den Mund stecken.",
  },
  {
    "key": "collectibles.collectible_glowing_goo_flavor",
    "notes": "Web series.",
    "value": ""Nicht essen. Außer wenn's dir Spaß macht."",
  },
  {
    "key": "collectibles.collectible_lost_penguin",
    "notes": " Just a lost lonely penguin that has a photo of his missing loved one. Name shortened from last iteration",
    "value": "Foto einer vermissten Liebe",
  },
  {
    "key": "collectibles.collectible_lost_penguin_desc",
    "value": "Es ist ziemlich schwierig, vor Freude zu tanzen, wenn man die wahre Liebe aus den Augen verloren hat.",
  },
  {
    "key": "collectibles.collectible_lost_penguin_flavor",
    "notes": "True nature fact",
    "value": ""Die Liebe eines Pinguins währt wahrhaft ewig."",
  },
  {
    "key": "collectibles.collectible_old_invitations",
    "value": "Ungeöffnete alte Einladungen",
  },
  {
    "key": "collectibles.collectible_old_invitations_desc",
    "value": "Hoffnungen und Träume, chronologisch geordnet, aber nie zur Kenntnis genommen",
  },
  {
    "key": "collectibles.collectible_old_invitations_flavor",
    "value": ""Riskiere einen Blick oder stirb vor Neugier."",
  },
  {
    "key": "collectibles.collectible_sacred_documentation",
    "value": "Legendäre Lichtspielhausfilmrolle",
  },
  {
    "key": "collectibles.collectible_sacred_documentation_desc",
    "notes": "Celebration of the old hit tv series "Dallas"",
    "value": "Sich bewegende Bilder, die die Popkultur einen großen Schritt nach vorne katapultiert und die das Leben, so wie man es bis dahin kannte, von Grund auf revolutioniert haben.",
  },
  {
    "key": "collectibles.collectible_sacred_documentation_flavor",
    "notes": "Character Bobby Ewing, dead since last season, appears in the shower = last season was just a dream.",
    "value": ""Was wärmt die Herzen von Mutti und Vati und was treibt die Kinder aus dem Haus – jawoll die Lindenstraße! Jeden Abend um acht."",
  },
  {
    "key": "collectibles.collectible_chainsaw",
    "notes": "Spoof on popular brand Hello Kitty, Katze = Cat in german",
    "value": "Hallo-Katze'-Kettensäge",
  },
  {
    "key": "collectibles.collectible_chainsaw_desc",
    "value": "Eine ziemlich bekannte Marke. Dieses Produkt ist ganz klar der Kollektion Texas-Style zuzuordnen.",
  },
  {
    "key": "collectibles.collectible_chainsaw_flavor",
    "value": ""Das Teil hat einfach Stihl."",
  },
  {
    "key": "collectibles.collectible_toy_rocket",
    "value": "Spielzeugrakete",
  },
  {
    "key": "collectibles.collectible_toy_rocket_desc",
    "notes": "Song reference: Moon River by Henry Mancini",
    "value": "Der kleine Neil wollte schon immer mal zum Mond fliegen.",
  },
  {
    "key": "collectibles.collectible_toy_rocket_flavor",
    "value": ""Houston, wir haben kein Problem."",
  },
  {
    "key": "collectibles.collectible_monster_plushy",
    "notes": "Chtuhlu reference",
    "value": "Monstergesichtiges Plüschtier",
  },
  {
    "key": "collectibles.collectible_monster_plushy_desc",
    "notes": "A referense to Chtuhlu,HP Lovecrafts mythical creation",
    "value": "Kleines Stofftier zum Knuddeln und Einschlafen. Die Warnung "Achtung: Erstickungsgefahr" findet sich hier sogar auf Sumerisch, Ägyptisch und Akkadisch.",
  },
  {
    "key": "collectibles.collectible_monster_plushy_flavor",
    "notes": "In his house at R'lyeh dead Cthulhu waits dreaming = translation from Lovecrafts fictional language",
    "value": ""Ph'nglui mglw'nafh Cthulhu R'lyeh wgah'nagl fhtagn."",
  },
  {
    "key": "collectibles.collectible_shark_tooth",
    "notes": "Ginsu sharks lived around 80 million years ago.",
    "value": "Zahn eines Ginsuhais",
  },
  {
    "key": "collectibles.collectible_shark_tooth_desc",
    "value": "Schwierig, sauber zu halten.",
  },
  {
    "key": "collectibles.collectible_shark_tooth_flavor",
    "notes": "Calcium, like in teeth and bone",
    "value": ""Der verkalkte Albtraum eines jeden Zahnarztes."",
  },
  {
    "key": "collectibles.collectible_rubber_chickens",
    "value": "Tasche voller Gummihühner",
  },
  {
    "key": "collectibles.collectible_rubber_chickens_desc",
    "notes": "Pun: Why did the chicken cross the road? Hence crossroads",
    "value": "Eine Tasche voller Hühner. Es sind wirklich alles nur Hühner. Hühner aus Gummi.",
  },
  {
    "key": "collectibles.collectible_rubber_chickens_flavor",
    "notes": "Pun on expression Like poetry to my ears.",
    "value": ""Warum das Huhn die Straße überquerte? Wen interessiert's!"",
  },
  {
    "key": "collectibles.collectible_cake",
    "notes": "Pun on the Cake from game Portal",
    "value": "Kuchen",
  },
  {
    "key": "collectibles.collectible_cake_desc",
    "value": "Das heutige Motto: Es gibt keinen Kuchen. Keinen Kuchen, der nicht gut schmeckt.",
  },
  {
    "key": "collectibles.collectible_cake_flavor",
    "notes": "Lyric from Celebration by kool and the gang",
    "value": ""Wenn der Kuchen spricht, haben die Krümel Pause."",
  },
  {
    "key": "collectibles.collectible_banana_peels",
    "value": "Konservierte Bananenschalen",
  },
  {
    "key": "collectibles.collectible_banana_peels_desc",
    "notes": "Expression that's just bananas - that's just crazy",
    "value": "Wer auch immer auf die Idee kam, die Schale zu konservieren, muss ziemlich Banane gewesen sein.",
  },
  {
    "key": "collectibles.collectible_banana_peels_flavor",
    "notes": "Pun: Fruit flies - they like bananas. If impossible to translate - make up something completely different :)",
    "value": ""Nichts ist gelber als Gelb selber."",
  },
  {
    "key": "collectibles.collectible_theremin",
    "notes": "The musical instrument",
    "value": "Theremin",
  },
  {
    "key": "collectibles.collectible_theremin_desc",
    "value": "Die Zukunft synthetischer Elektromusik beginnt jetzt! Das Produkt, das der Firma Leon, Lew & Moog zu Weltruhm verhalf. Der Prototyp ihres nächsten Welthits steht bereits in den Startlöchern: der Sünd'Testeiser.",
  },
  {
    "key": "collectibles.collectible_theremin_flavor",
    "notes": "Its original selling text when it was modern!",
    "value": ""Trifft immer die richtigen Töne. Auch ohne Hautkontakt."",
  },
  {
    "key": "collectibles.collectible_weird_stone",
    "value": "Seltsam aussehender Stein",
  },
  {
    "key": "collectibles.collectible_weird_stone_desc",
    "value": "Die Form dieses Steins erinnert entfernt an einen implodierenden, astronomischen Nebel oder den Sog einer Toilette.",
  },
  {
    "key": "collectibles.collectible_weird_stone_flavor",
    "value": ""Wenn's im All genauso aussieht wie im Klo."",
  },
  {
    "key": "collectibles.collectible_action_figure",
    "value": "Ninja-Katzen-Actionfigur",
  },
  {
    "key": "collectibles.collectible_action_figure_desc",
    "notes": "Tennage mutant ninja turtles spoof: Meow-Taunt = Mutant, then Vanilla Ice lyrics "Go Ninja Go Ninja Go" from song Ninja Rap",
    "value": "Bis an die Zähne bewaffnete, Pizza liebende Ninja-Katzen. Was es nicht alles gibt.",
  },
  {
    "key": "collectibles.collectible_action_figure_flavor",
    "notes": "April O'Neill character spoof from Turtles",
    "value": ""Hey jetzt komm' die Ninja-Katzen, super starke Ninja-Katzen. Jeder kennt die Ninja-Katzen. Immer auf der Lauer – und immer etwas schlauer!"",
  },
  {
    "key": "collectibles.collectible_fossil",
    "value": "Fossil",
  },
  {
    "key": "collectibles.collectible_fossil_desc",
    "notes": "See Vectron",
    "value": "Die elektrische Präsenz von Vectron hatte einen unerwarteten Einfluss auf beides, lebende als auch fossile Kreaturen der Tiefen.",
  },
  {
    "key": "collectibles.collectible_fossil_flavor",
    "notes": "Pun on pre-historical",
    "value": ""Da soll mal einer sagen, dass Geschichte langweilig ist."",
  },
  {
    "key": "collectibles.collectible_diary",
    "value": "Spelunkentagebuch",
  },
  {
    "key": "collectibles.collectible_diary_desc",
    "notes": "See Archaea.",
    "value": "Das Tagebuch von Bob dem Bohrmeister, seines Zeichens Tiefenbohrungsexperte, den es in die finstersten Ecken von Archaea verschlug. Die dabei gemachten Entdeckungen finden sich in diesem Buch. Sehr spannend, voller Kritzeleien und das ideale Geschenk für alle Fans von ""Malen nach Zahlen"".",
  },
  {
    "key": "collectibles.collectible_diary_flavor",
    "value": ""Bob: Alle Mädchen wollen ihn haben und alle Jungen möchten wie er sein."",
  },
  {
    "key": "collectibles.collectible_fifty",
    "notes": "Pun on Book Fifty Shades of Gray",
    "value": "Fifty Shades of Klischee",
  },
  {
    "key": "collectibles.collectible_fifty_desc",
    "value": "Eine ausgetrocknete Geschichte gefüllt mit monotoner, grauer Masse.",
  },
  {
    "key": "collectibles.collectible_fifty_flavor",
    "notes": "Pun of passage from the book: "Why don't you like to be touched" Ana whispered, staring up into soft grey eyes. "Because I'm fifty shades of fucked-up, Anastasia"",
    "value": ""Wieso magst du dieses Buch nicht?" flüstert die Anästhesistin und schaute in seine wässrig-roten Augen. "Alles nur Klischee!"",
  },
  {
    "key": "collectibles.collectible_wagon_wheel",
    "value": "Wagenrad",
  },
  {
    "key": "collectibles.collectible_wagon_wheel_desc",
    "value": "Viele Bots der südwärts gerichteten kleinen Siedlungen und Städte trotzten Wind und Wetter, um ihre Furcht zu überwinden. Die Meisten von ihnen träumten von einer besseren Zukunft. Heute liegen ihre Träume fein säuberlich unter den brennenden Dünen der Westwüste begraben.",
  },
  {
    "key": "collectibles.collectible_wagon_wheel_flavor",
    "value": ""Der Weg eines Pioniers ist steinig und schwer. Ein Hoch auf den Planwagen."",
  },
  {
    "key": "collectibles.collectible_black_box",
    "notes": "Like a plane's black box.",
    "value": "Raketen-Blackbox",
  },
  {
    "key": "collectibles.collectible_black_box_desc",
    "value": "Das landesweite Netzwerk von Raketenkuschlern und -liebhabern, ein Verein voller Gehirnakrobaten, wird von diesen Daten hoffentlich profitieren.",
  },
  {
    "key": "collectibles.collectible_black_box_flavor",
    "notes": "An aeroplane's "black" box is typically orange even though.",
    "value": ""Ja, wir wissen, dass sie eigentlich orange ist."",
  },
  {
    "key": "collectibles.collectible_red_cloth",
    "notes": "Nod to Character Rusty from Steamworld Dig",
    "value": "Rotes Stoffstück",
  },
  {
    "key": "collectibles.collectible_red_cloth_desc",
    "notes": "Western, as in from The Wild West.",
    "value": "Robust und dicht gewebt, wahrscheinlich infolge eines Kampfes zerrissen. Mutet wie eine typische Westernhalsbedeckung an.",
  },
  {
    "key": "collectibles.collectible_red_cloth_flavor",
    "value": ""Pioniere sind genau wie Schildkröten: Sie sind am produktivsten, wenn sie ihren Hals hervorstrecken."",
  },
  {
    "key": "collectibles.collectible_cult_list",
    "value": "Aufgabenliste des Kults der Verdammten",
  },
  {
    "key": "collectibles.collectible_cult_list_desc",
    "value": "Göttliche Entität der Zerstörung ausfindig machen – Fertig
Organisationsschaubild des Kults erläutern – Fertig
Vaporisierte Mitglieder des Komitees ersetzen – Fertig
Wünsche der Entität vernehmen – Fertig
Alte Statue enthaupten – Fertig
Milch kaufen – ?
Pilgerreise ausrichten – Fertig
Auf das Ende der Welt vorbereiten – in Arbeit",
  },
  {
    "key": "collectibles.collectible_cult_list_flavor",
    "notes": "First line of lyrics from Johnny Cash's song The Man comes around. Also in the bible.",
    "value": ""Der Kult der Verdammten – wir müssen mehr Broschüren drucken."",
  },
  {
    "key": "collectibles.collectible_amiigo",
    "notes": "Pun on Amiibo, line of Nintendo toys",
    "value": "Amiigo-Figur",
  },
  {
    "key": "collectibles.collectible_amiigo_desc",
    "value": "Nur all jenen, die hohes Ansehen genossen und ein ansehnliches Antlitz besaßen, war es erlaubt, den alten Künstlern und Bildhauern Modell zu stehen. Diese Actionfigur repräsentiert ganz bestimmt ein Wesen majestätischen Anblicks und überirdischen Intellekts.",
  },
  {
    "key": "collectibles.collectible_amiigo_flavor",
    "value": ""ACHTUNG: ERSTICKUNGSGEFAHR – Figur sieht bunt und knuffig aus, aber bitte nicht in den Mund stecken!"",
  },
  {
    "key": "collectibles.collectible_stone_tablet",
    "value": "Feurige Marke",
  },
  {
    "key": "collectibles.collectible_stone_tablet_desc",
    "value": "Die Glyphen auf diesem uralten Artefakt lassen die ursprünglichen Gründer des Tempels als menschlichen Feuerkult erscheinen.",
  },
  {
    "key": "collectibles.collectible_stone_tablet_flavor",
    "value": ""Dem Feuer zur Ehre fackeln wir unseren Tempel ab!"",
  },
  {
    "key": "collectibles.collectible_orchid",
    "value": "Leuchtende Orichidee",
  },
  {
    "key": "collectibles.collectible_orchid_desc",
    "notes": "See Yarrow",
    "value": "Nachdem die Yarrow-Blume im Laufe der Zeit mehr und mehr kontaminierte Schmiere aufsog, fing sie an zu mutieren. Einige nachtaktive Kreaturen finden den neuen Taint ungemein stimulierend.",
  },
  {
    "key": "collectibles.collectible_orchid_flavor",
    "notes": "carbon dating pun= determin how old things are",
    "value": ""Das ideale Geschenk für Naturfreunde."",
  },
  {
    "key": "collectibles.collectible_manual",
    "notes": "Pun on swedish brand IKEA",
    "value": "INCREA-Produktanleitung",
  },
  {
    "key": "collectibles.collectible_manual_desc",
    "notes": "You never seem to get all the parts you need.",
    "value": "Diese Do-it-yourself-Apparatur war früher für das Verstärken von Bergbauausrüstung unerlässlich. Der Name, der auf das Gerät gedruckt wurde, hörte sich entweder total unsinnig oder nach einem Fluch in einer nordischen Sprache an.",
  },
  {
    "key": "collectibles.collectible_manual_flavor",
    "value": ""Das 30-Tage-Rückgaberecht schließt zwar keinen kostenlosen Versand, aber dafür ein Gratislächeln mit ein."",
  },
  {
    "key": "collectibles.collectible_pills",
    "value": "Gelbe Pillen",
  },
  {
    "key": "collectibles.collectible_pills_desc",
    "notes": "Doktor Schwester - A pun because it would be like saying Doctor Nurse.",
    "value": "Gelb und klein,so,wie Pillen eben aussehen sollten. Auf dem handgeschriebenen Rezept steht: Doktor Sestra - und daneben ein hingekritzelter ""Daumen hoch"".",
  },
  {
    "key": "collectibles.collectible_pills_flavor",
    "value": ""Genau, was der Doktor verschrieben hat."",
  },
  {
    "key": "collectibles.collectible_painting",
    "value": "Stillleben, gutes Leben",
  },
  {
    "key": "collectibles.collectible_painting_desc",
    "value": "Beim Malen ist es wie mit dem Kochen: Man braucht die richtigen Zutaten und ein Händchen für neue Ideen, um ein großartiges Gericht zu zaubern. Wie dem auch sei – eine Welt ohne Kunst, ist wie eine Ratatouille ohne Gemüse.",
  },
  {
    "key": "collectibles.collectible_painting_flavor",
    "value": ""Ein schönes Gemälde, nicht wahr?
Wie heißt dieser Künstler?
Vincent der Koch!"",
  },
  {
    "key": "collectibles.collectible_six_pack",
    "notes": "Moon Juice is like moon shine homemade booze but we can't say it's that.",
    "value": "Sechserpack Mondsaft",
  },
  {
    "key": "collectibles.collectible_six_pack_desc",
    "notes": "caddywompus = crazy",
    "value": "Der feuchte Traum eines Schnapsis. Zwei Dinge sind todsicher: Sie lieben dieses Zeug und ohne diese flüssige Köstlichkeit würden sie sicher irgendwann verrückt werden.",
  },
  {
    "key": "collectibles.collectible_six_pack_flavor",
    "notes": "It looks like alcohol but we can't say that it's alcohol.",
    "value": ""Auf dem Etikett steht: 'Kein Rauschmittel. Nur Saft! Wirklich!'"",
  },
  {
    "key": "collectibles.collectible_building_plans",
    "notes": "*DEMO*",
    "value": "Abgelehnte Baupläne",
  },
  {
    "key": "collectibles.collectible_building_plans_desc",
    "value": "Diese Pläne wurden leider nie in die Tat umgesetzt. Aber wen wundert's. Wer wünscht sich schon ein Haus, durch das ein Bahngleis führt. Soll der Besitzer etwa jedes Mal die Tür aufmachen, wenn ein Zug kommt?",
  },
  {
    "key": "collectibles.collectible_building_plans_flavor",
    "notes": "Spoof on No Woman No Cry (Bob Marley song)",
    "value": ""Der Zeichner dieser Pläne wurde bereits disziplinarisch zur Verantwortung gezogen und entwirft jetzt Kindergärten und Altenheime."",
  },
  {
    "key": "collectibles.collectible_dumbells",
    "notes": "Dumbbells = weight for training",
    "value": "Rosies Hanteln",
  },
  {
    "key": "collectibles.collectible_dumbells_desc",
    "value": "Diese metallischen Trainingsgerätschaften lassen jeden Raum wie eine Muckibude erscheinen.",
  },
  {
    "key": "collectibles.collectible_dumbells_flavor",
    "notes": "Nuttin' = Reference to nut, as in nuts and bolts.",
    "value": ""Sei Pippi, nicht Annika!"",
  },
  {
    "key": "collectibles.collectible_completion_proof",
    "value": "Beendigungsnachweis",
  },
  {
    "key": "collectibles.collectible_completion_proof_desc",
    "value": "Wir entschuldigen uns für die Unannehmlichkeiten.",
  },
  {
    "key": "collectibles.collectible_completion_proof_flavor",
    "value": ""Wie sie im guten alten Sweden sagen: De ska va gôtt å gräva!"",
  },
  {
    "key": "vectron_messages.message_pre",
    "value": ">",
  },
  {
    "key": "vectron_messages.message_post",
    "value": "_",
  },
  {
    "key": "vectron_messages.message_trespasser_text_1",
    "notes": " Error message. Translate only actual words. Keep approximate length between 
.",
    "value": "SURGE BOOT: INITIATING THREAT ANALYSIS

DIRECTIVE A, B, COMPILED.  #8F000025.28C40A8
VCT_SYSTEM_OFFLINE
AX=000A DIRECTIVE A: BLUE SAVIOR, FAIL LEVEL: CRITICAL BX=7FFF SP=000007C4
