  {
    "key": "upgrades.upgrade_jackhammer_faster_windup_flavor",
    "notes": "Frankie goes to Hollywood song Relax",
    "value": ""Romperé, ooh, cavaré, oh oh oh oh."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed",
    "notes": "Tribute to band KLF - also known as the Justified Ancients of Mu Mu",
    "value": "Viejo cilindro menudo",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed_desc",
    "value": "Cilindro neumático mejorado. Permite aumentar la velocidad de excavación, pero también aumenta el uso de agua.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed_flavor",
    "notes": "Their tune Last train to Trancentral",
    "value": ""Súbete a mi moto, nunca has conocido un martillo tan veloz."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push",
    "value": "Estela de chorro",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push_desc",
    "value": "Te arrastra hacia adelante cada vez que el martillo atraviesa algún material.",
