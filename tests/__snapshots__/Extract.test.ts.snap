  {
    "key": "resource_description_value",
    "metadata": {
      "raw": " A paragraph in resource descriptions, stating its individual value. %1% is the value.",
    },
    "value": "Je Stück $%1%{image money_small} wert.",
  },
  {
    "key": "resource_trashium",
    "metadata": {
      "raw": "*DEMO*",
    },
    "value": "Schrottium",
  },
  {
    "key": "resource_trashium_desc",
    "value": "Ganz einfach Schrott, der durch die Naturgewalten zusammengeschweißt wurde.",
  },
  {
    "key": "resource_copper",
    "value": "Kupfer",
  },
  {
    "key": "resource_copper_desc",
    "value": "Hohe Stabilität und ein geringer Widerstand machen Kupfer zu einem zuverlässigen, elektrischen Leiter.",
  },
  {
    "key": "resource_cinnabar",
    "value": "Zinnober",
  },
  {
    "key": "resource_cinnabar_desc",
    "metadata": {
      "raw": "Vermillion is a scarlet pigment made of Cinnabar, expression "you look like a million dollars"",
    },
    "value": "Ein helles, toxisches Quecksilbersulfid, das schon seit langem als Pigment verwendet wird. Gibt deinen Wangen diesen zinnoberroten Touch!",
  },
  {
    "key": "resource_ironium",
    "metadata": {
      "raw": "Like irony",
    },
    "value": "Ironium",
  },
  {
    "key": "resource_ironium_desc",
    "value": "In seiner reinsten Form relativ weich, wenn du es allerdings mit Hitze in Berühung bringst, nimmt seine Härte ungeahnte Ausmaße an.",
  },
  {
    "key": "resource_cornflorium",
    "metadata": {
      "raw": "From cornflower blue, color from the flower",
    },
    "value": "Zyanium",
  },
  {
    "key": "resource_cornflorium_desc",
    "value": "Selten anzutreffen und unter Grafikdesignern aus den Niederlanden wegen seinem bläulichen Farbton sehr beliebt.",
  },
  {
    "key": "resource_obsidian",
    "metadata": {
      "raw": "Spoof on Yngwie Malmsteen - swedish famous guitarr virtuoso",
    },
    "value": "Yngwium",
  },
  {
    "key": "resource_obsidian_desc",
    "value": "Ein meisterhaftes Erz. Zählt zur 8. Gruppe der Malmsteen-Metalle.",
  },
  {
    "key": "resource_silver",
    "value": "Silber",
  },
  {
    "key": "resource_silver_desc",
    "metadata": {
      "raw": "Werewolves are best killed with silver",
    },
    "value": "Die einzige Sache, die hilft, wenn eine Horde Werwölfe in deinem Hinterhof einmarschiert. Und das werden sie, ist nur eine Frage der Zeit.",
  },
  {
    "key": "resource_zoinkonium",
    "value": "Zoinkonium",
  },
  {
    "key": "resource_zoinkonium_desc",
    "metadata": {
      "raw": "Spoof on video game company Zoink and their titles Zombie Vikings and Stick it to the man",
    },
    "value": "Ein schwacher, stickiger Geruch von Met umgibt diesen einfachen, aber bunten Klumpen.",
  },
  {
    "key": "resource_gold",
    "value": "Gold",
  },
  {
    "key": "resource_gold_desc",
    "metadata": {
      "raw": "connectors = gold are used in technology",
    },
    "value": "Ein königliches Metall, das Buddlern und Minenarbeitern total den Kopf verdreht. Erste Wahl von Investoren und Konnektoren seit 3000 v. Chr.",
  },
  {
    "key": "resource_lazurite",
    "value": "Lasurit",
  },
  {
    "key": "resource_lazurite_desc",
    "value": "Ein brüchiges Mineral, das für seinen Nutzen als Pigment in der Malerei und Textilfärbung bekannt ist.",
  },
  {
    "key": "resource_saturnium",
    "metadata": {
      "raw": "Saturnus, god of fertility",
    },
    "value": "Saturnium",
  },
  {
    "key": "resource_saturnium_desc",
    "value": "Landwirte glauben fest daran, dass es eine begünstigende Wirkung auf die Ernte hat, darum wird es im Winter entlang der Äcker platziert.",
  },
  {
    "key": "resource_plutonium",
    "value": "Plutonium",
  },
  {
    "key": "resource_plutonium_desc",
    "metadata": {
      "raw": "Shiner Wars is an old conflict preceeding the game story, Pluto = disney dog",
    },
    "value": "Ein chemisches Element, das vor den Großen Alk-Kriegen weite Verwendung fand. Hat am Ende niemandem einen Vorteil verschafft. Nicht wie allgemein gedacht nach einem berühmten Hund benannt.",
  },
  {
    "key": "resource_meteorum",
    "value": "Meteoritengestein",
  },
  {
    "key": "resource_meteorum_desc",
    "metadata": {
      "raw": "Nod to Game Maniac Mansion and the antagonist Dr Fred Edison, also the game creators Gilbert and Winnick",
    },
    "value": "Erstmals in der Nähe eines Landhauses von Gilbert Winnick höchstpersönlich gefunden.",
  },
  {
    "key": "resource_unobtainium",
    "metadata": {
      "raw": "Just a spoof on the word unobtainable",
    },
    "value": "Unerreichbarium",
  },
  {
    "key": "resource_unobtainium_desc",
    "value": "Niemand hatte erwartet, es je zu besitzen. Doch hier ist es. Schön.",
  },
  {
    "key": "resource_darkmatter",
    "value": "Dunkle Materie",
  },
  {
    "key": "resource_darkmatter_desc",
    "metadata": {
      "raw": "Play with mothers comments on dating bad boys",
    },
    "value": "Die Art von Materie, vor der dich deine liebe Mutter immer gewarnt hat. Ist oft in Spelunken zu finden und ... oh Moment mal ... mein Fehler.",
  },
  {
    "key": "resource_sodium",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Natrium",
  },
  {
    "key": "resource_sodium_desc",
    "value": "Regelmäßiger Kontakt mit seinem weichen, silberweißen Staub kann zu schneller Austrocknung führen.",
  },
  {
    "key": "resource_aluminium",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Aluminium",
  },
  {
    "key": "resource_aluminium_desc",
    "value": "Das weitverbreitetste Metall auf dem Planeten. Eignet sich hervorragend für Behälter traditioneller Getränke der Menschen.",
  },
  {
    "key": "resource_beryl",
    "value": "Beryll",
  },
  {
    "key": "resource_beryl_desc",
    "value": "Man glaubt, er könne Träume und Wünsche wahr werden lassen, und negative Energien neutralisieren.",
  },
  {
    "key": "resource_azurite",
    "metadata": {
      "raw": "Azurite just sounds like these two expressions put together – Do as you want with this :)",
    },
    "value": "Azurit",
  },
  {
    "key": "resource_azurite_desc",
    "value": "Fördert die Konzentrationsfähigkeit und Aufnahmebereitschaft.",
  },
  {
    "key": "resource_tremolite",
    "value": "Tremaulit",
  },
  {
    "key": "resource_tremolite_desc",
    "metadata": {
      "raw": "Dr Dre = music producer and rapper – Dr Tre is a made up brother to make a pun on the resource name – mole pun molite",
    },
    "value": "Das geheime Kind von Dr. Dres Bruder, Dr. Tre, und einem Maulwurf.",
  },
  {
    "key": "resource_topaz",
    "value": "Topas",
  },
  {
    "key": "resource_topaz_desc",
    "value": "Taucht die Umgebung in eine Atmosphäre von Fürsorge und Geborgenheit. Die violette Variante ist sehr selten.",
  },
  {
    "key": "resource_ametrine",
    "value": "Ametrin",
  },
  {
    "key": "resource_ametrine_desc",
    "metadata": {
      "raw": "The spanish queen was said to have been given an ametrine stone as gift from the first batch leaving the mines",
    },
    "value": "Ein seltener Edelstein, dem mysteriöse Kräfte nachgesagt werden. Das größte Exemplar liegt angeblich in der Grabstätte einer spanischen Königin begraben.",
  },
  {
    "key": "resource_diamond",
    "value": "Diamant",
  },
  {
    "key": "resource_diamond_desc",
    "metadata": {
      "raw": "Margareth Thatcher was chosen for her reputation as cold hearted – feel free to exchange for other politician of your country!",
    },
    "value": "Das Original. So hart und kalt wie das Eis der Polarkappen. Aber im Gegensatz zu denen, übersteht er den Klimawandel.",
  },
  {
    "key": "resource_bismuth",
    "value": "Bismut",
  },
  {
    "key": "resource_bismuth_desc",
    "metadata": {
      "raw": "Bismuth sounds a bit like Bismarck, thats why the pun is on German Otto Bismarck, but if the mineral is named something else in your country, feel free to pun away :) https://en.wikipedia.org/wiki/Otto_von_Bismarck",
    },
    "value": "Etwa 1400 v. Chr. durch geheimnisvolle Alchemisten entdeckt. Wird leider oft mit Blei oder einem deutschen Reichskanzler verwechselt.",
  },
  {
    "key": "resource_imagenite",
    "value": "Fantasit",
  },
  {
    "key": "resource_imagenite_desc",
    "metadata": {
      "raw": "A pun on song from John Lennon Imagine – imagine there's no heaven, and no religion too",
    },
    "value": "Unter Bergleuten heiß diskutiert: Existiert es wirklich? Fantasit ist das eigentliche Individuellit und Besondrit eines Jeden.",
  },
  {
    "key": "resource_amethyst",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Amethyst",
  },
  {
    "key": "resource_amethyst_desc",
    "value": "Seine Leuchtkraft lässt deine Sorgen verschwinden, kurbelt deine Gefühle wieder an und schickt dich direkt auf die Suche nach der nächsten ewigen Liebe.",
  },
  {
    "key": "resource_blooddrop",
    "value": "Kleiner Blutjaspis",
  },
  {
    "key": "resource_blooddrop_desc",
    "value": "Eine kleine Ansammlung des Zorns halbdunkler Kreaturen.",
  },
  {
    "key": "resource_bloodstone",
    "value": "Blutjaspis",
  },
  {
    "key": "resource_bloodstone_desc",
    "value": "Dieser Heliotrop stellt die mentale Klarheit seines Besitzers wieder her.",
  },
  {
    "key": "resource_bloodrock",
    "value": "Großer Blutjaspis",
  },
  {
    "key": "resource_bloodrock_desc",
    "value": "Eine Ansammlung von Angst und bösen Absichten. Schärft die Sinne, trübt jedoch das geistige Auge.",
  },
  {
