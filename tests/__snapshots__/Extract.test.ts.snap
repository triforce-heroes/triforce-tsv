  {
    "key": "upgrade_lamp",
    "value": "Linterna",
  },
  {
    "key": "upgrade_broken_lamp",
    "value": "Linterna rota",
  },
  {
    "key": "upgrade_broken_lamp_desc",
    "metadata": {
      "raw": "Dorothy fell and broke her lamp.",
    },
    "value": ""Alguien la ha roto al tropezarse. Necesita ser reparada o remplazada."",
  },
  {
    "key": "upgrade_broken_lamp_next_level_desc",
    "value": "Repara la linterna para poder entrar en la mina.",
  },
  {
    "key": "upgrade_lamp_desc",
    "value": "Ilumina tus alrededores. Consume combustible, el cual puedes repostar en el pueblo.",
  },
  {
    "key": "upgrade_lamp_next_level_desc",
    "value": "Mejora tu linterna para reducir el consumo de combustible.",
  },
  {
    "key": "upgrade_lamp_01",
    "metadata": {
      "raw": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    },
    "value": "Linterna demacrada",
  },
  {
    "key": "upgrade_lamp_01_desc",
    "value": ""Ya no está rota, pero poco más."",
  },
  {
    "key": "upgrade_lamp_02",
    "value": "Linterna de principiante",
  },
  {
    "key": "upgrade_lamp_02_desc",
    "value": ""Más económica en cuanto a consumo de combustible se refiere."",
  },
  {
    "key": "upgrade_lamp_03",
    "value": "Linterna de carburo modificado",
  },
  {
    "key": "upgrade_lamp_03_desc",
    "value": ""Tiene un mejor control de flujo de combustible, por lo que es más eficiente."",
  },
  {
    "key": "upgrade_lamp_04",
    "value": "Polaris",
  },
  {
    "key": "upgrade_lamp_04_desc",
    "metadata": {
      "raw": "Rudolf the Red nose reindeer – lyrics pun.",
    },
    "value": ""Pero Navidad llegó, Santa Claus bajó y a Polaris eligió, por su singular brillo."",
  },
  {
    "key": "upgrade_lamp_05",
    "value": "Farol",
  },
  {
    "key": "upgrade_lamp_05_desc",
    "metadata": {
      "raw": "Green Lantern pun – Green lantern inaguration text.",
    },
    "value": ""En el día más brillante, en la noche más oscura, ningún mineral escapará de mi vista."",
  },
  {
    "key": "upgrade_lamp_06",
    "metadata": {
      "raw": "The Alexandrian Lighthouse",
    },
    "value": "Luz de Faros",
  },
  {
    "key": "upgrade_lamp_06_desc",
    "value": ""Reforzada con plomo fundido para soportar el paso del tiempo."",
  },
  {
    "key": "upgrade_lamp_07",
    "metadata": {
      "raw": "*NEW* Name meaning "Unconquered Sun", Official sun god of the later Roman Empire and also reference to Emperor Constantines old roman coins with inscription SOL INVICTO COMITI = Commited to the Invincible Sun",
    },
    "value": "Sol Invictus",
  },
  {
    "key": "upgrade_lamp_07_desc",
    "value": ""Encomiéndate al Sol Invencible, o al menos disfruta del magnífico alcance de su luz."",
  },
  {
    "key": "upgrade_lamp_increased_area_01",
    "metadata": {
      "raw": "Backstreet Boys pun, lyrics from """Larger than Life""" too for flare.",
    },
    "value": "A la luz le pido",
  },
  {
    "key": "upgrade_lamp_increased_area_01_desc",
    "value": "Aumenta el alcance de tu linterna.",
  },
  {
    "key": "upgrade_lamp_increased_area_01_flavor",
    "metadata": {
      "raw": "Backstreet Boys pun, lyrics from "Larger than Life" too for flare.",
    },
    "value": ""Que mis ojos más observen, a la luz de tu linterna."",
  },
  {
    "key": "upgrade_lamp_light_pickup_01",
    "value": "Invocador",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Posibilidad de obtener un orbe de luz extra de los enemigos derrotados.",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_flavor",
    "value": ""Libera su luz interior."",
  },
  {
    "key": "upgrade_lamp_infinite_light_01",
    "metadata": {
      "raw": "Movie Eternal Sunshine on the spotless mind.",
    },
    "value": "Mente sin recuerdos",
  },
  {
    "key": "upgrade_lamp_infinite_light_01_desc",
    "value": "Evita que tu linterna caiga por debajo del 50%%.",
  },
  {
    "key": "upgrade_lamp_infinite_light_01_flavor",
    "value": ""Nunca estarás solo en la oscuridad."",
  },
  {
    "key": "upgrade_lamp_damaging_light_01",
    "metadata": {
      "raw": "Song: I am the God of hellfire by Arthur Brown*NOT CURRENTLY USED*",
    },
    "value": "Maldito engranaje",
  },
  {
    "key": "upgrade_lamp_damaging_light_01_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Daña a todos los enemigos que estén al alcance de tu luz.",
  },
  {
    "key": "upgrade_lamp_damaging_light_01_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": ""Te sientes tan fuerte que piensas que nadie te puede tocar."",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01",
    "metadata": {
      "raw": " Kubera – Hindu Mythology Lord of Wealth, Quote is from Thomas Aquinas",
    },
    "value": "Flama de Kubera",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01_desc",
    "value": "Hace que los elementos coleccionables brillen, por lo que son más fáciles de encontrar.",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01_flavor",
    "value": ""Es mejor arder que apagarse lentamente."",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes",
    "metadata": {
      "raw": " Gordon is a reference to character Flash Gordon and particularily important is the ""Flash"" part which is referencing this upgrade being for the light."",
    },
    "value": "Reflejos de Gordon",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes_desc",
    "value": "Aumenta la probabilidad de esquivar automáticamente desprendimientos de rocas y trampas similares.",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes_flavor",
    "metadata": {
      "raw": "*NEW* Quote is a reference to Queen Song "Flash" and the lyrics- He save with a mighty hand every man, every woman every child, with a mighty Flash",
    },
    "value": ""¡Hago chas y aparezco a tu lado!"",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness",
    "metadata": {
      "raw": " Text from Pink Floyd's song Another brick in the wall: We don't need no education ,We don't need no thought control, All in all you're just another brick in the wall . Quote by Joseph Ford Newton regarding intolerans, hate and not enough love in the world.",
    },
    "value": "Detector de debilidades",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness_desc",
    "value": "Te permite ver los puntos débiles de los muros cuando los iluminas. Eres el vigilante del muro. La luz que trae el amanecer.",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness_flavor",
    "value": ""Los hombres construyen demasiados muros y muy pocos puentes."",
  },
  {
    "key": "upgrade_pickaxe",
    "value": "Pica",
  },
  {
    "key": "upgrade_pickaxe_desc",
    "value": "La principal herramienta para cavar de Dorothy.",
  },
  {
    "key": "upgrade_pickaxe_next_level_desc",
    "metadata": {
      "raw": " This means that whatever you hit, you'll need to hit it two times less when you equip this cog in your Pickaxe",
    },
    "value": "Mejora tu pica para que excave de forma más eficiente.",
  },
  {
    "key": "upgrade_pickaxe_01",
    "metadata": {
      "raw": "it's rusty",
    },
    "value": "Pica oxidada",
  },
  {
    "key": "upgrade_pickaxe_01_desc",
    "value": ""Se nota que ya ha cavado bastante."",
  },
  {
    "key": "upgrade_pickaxe_02",
    "value": "Pica de hierro común",
  },
  {
    "key": "upgrade_pickaxe_02_desc",
    "value": ""La herramienta básica de todo minero."",
  },
  {
    "key": "upgrade_pickaxe_03",
    "metadata": {
      "raw": " Bardur is an Icelandic half-troll half-man from their mythology.",
    },
    "value": "Pica con mango de Balder",
  },
  {
    "key": "upgrade_pickaxe_03_desc",
    "value": ""Una compañera modesta pero robusta."",
  },
  {
    "key": "upgrade_pickaxe_04",
    "metadata": {
      "raw": "Pun on Pikachu",
    },
    "value": "Pica-chu",
  },
  {
    "key": "upgrade_pickaxe_04_desc",
    "metadata": {
      "raw": "Based on the old Japanese Cho measuring system, cho, an ancient Japanese unit of length approximately equal to 109.1 meters",
    },
    "value": ""Medida con precisión siguiendo un método tradicional japonés."",
  },
  {
    "key": "upgrade_pickaxe_05",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Pica de aleación de acero",
  },
  {
    "key": "upgrade_pickaxe_05_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Su tratamiento de carbono patentado le da un balance perfecto a tu golpe."",
  },
  {
    "key": "upgrade_pickaxe_06",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Pica de tungsteno",
  },
  {
    "key": "upgrade_pickaxe_06_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Fabricada con la densidad y dureza exactas para otorgar una experiencia de excavación prémium."",
  },
  {
    "key": "upgrade_pickaxe_07",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Pica del norte baldío",
  },
  {
    "key": "upgrade_pickaxe_07_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Más duradera y eficiente. Justo lo que uno necesita en el norte baldío."",
  },
  {
    "key": "upgrade_pickaxe_08",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Pica templaria",
  },
  {
    "key": "upgrade_pickaxe_08_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Perfectamente balanceada. ¡Parece como si cavase sola!"",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01",
    "metadata": {
      "raw": "This is an upgrade for the pickaxe",
    },
    "value": "Borde afilado",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01_desc",
    "value": "Causa daño adicional a tus enemigos.",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01_flavor",
    "metadata": {
      "raw": "From song The first cut is the deepest.",
    },
    "value": ""¿Quién les va a curar el corazón partío?"",
  },
  {
    "key": "upgrade_pickaxe_speed_01",
    "metadata": {
      "raw": "Pun on movie title Midnight Express",
    },
    "value": "Expreso de mediomosaico",
  },
  {
    "key": "upgrade_pickaxe_speed_01_desc",
    "metadata": {
      "raw": " new: minor rephasing",
    },
    "value": "Su aerodinámica refinada acelerará tu golpe desde la cadera.",
  },
  {
    "key": "upgrade_pickaxe_speed_01_flavor",
    "metadata": {
      "raw": "Old Duke Ellington song.",
    },
    "value": ""Te besa y te emociona con su aire demencial. Tú cierras los ojitos y te pones a cavar."",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01",
    "value": "Matón de recursos",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01_desc",
    "value": "Causa daño adicional a los mosaicos de recursos.",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01_flavor",
    "metadata": {
      "raw": "Spoof on Patrik Swayzee line from Roadhouse: My way or the highway",
    },
    "value": ""A mi manera o carretera."",
  },
  {
    "key": "upgrade_pickaxe_knockback_01",
    "metadata": {
      "raw": "Movie Total Recall",
    },
    "value": "Empujator",
  },
  {
    "key": "upgrade_pickaxe_knockback_01_desc",
    "value": "Empuja a tus enemigos más lejos cuando los golpeas.",
  },
  {
    "key": "upgrade_pickaxe_knockback_01_flavor",
    "metadata": {
      "raw": "Arnold Schwartzenegger quote from T2",
    },
    "value": ""Sayonara, baby."",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01",
    "value": "Devolver al remitente",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing.",
    },
    "value": "Te permite golpear proyectiles en el aire para modificar su trayectoria.",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01_flavor",
    "value": ""Un cambio de suerte muy oportuno."",
  },
  {
    "key": "upgrade_pickaxe_fire",
    "value": "Hacha de combustión",
  },
  {
    "key": "upgrade_pickaxe_fire_desc",
    "value": "Otorga fuego a tu pico, además, aumenta el daño y el alcance. Quizás tenga otros usos...",
  },
  {
    "key": "upgrade_pickaxe_fire_flavor",
    "value": ""Me hierve la sangre."",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp",
    "value": "Pica de cazador",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp_desc",
    "value": "Otorga +5 de XP adicional cuando derrotas a enemigos con la pica.",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp_flavor",
    "metadata": {
      "raw": " Old Ghanaian proverb meaning that the hunter didn't get anything that he hunted so instead he picked mushrooms, but telling him that might hurt his feelings",
    },
    "value": ""Si el cazador vuelve con una cesta de setas, no le preguntes cómo ha ido la caza."",
  },
  {
    "key": "upgrade_pickaxe_bounty",
    "value": "Cazarrecompensas",
  },
  {
    "key": "upgrade_pickaxe_bounty_desc",
    "value": "Te otorga una recompensa monetaria al abatir enemigos con la pica.",
  },
  {
    "key": "upgrade_pickaxe_bounty_flavor",
    "value": ""Algunos están aquí por el dinero, otros por la caza."",
  },
  {
    "key": "upgrade_pickaxe_health_pickup",
    "value": "Sanador",
  },
  {
    "key": "upgrade_pickaxe_health_pickup_desc",
    "value": "Probabilidad de que aparezca un orbe de salud adicional cuando derrotas a enemigos con tu pica.",
  },
  {
    "key": "upgrade_pickaxe_health_pickup_flavor",
    "metadata": {
      "raw": "*NEW* Marvin Gaye song "sexual healing"",
    },
    "value": ""Devuélveme la vida, recoge el orbe que mi pica arrancó de tu corazón."",
  },
  {
    "key": "upgrade_backpack",
    "value": "Mochila",
  },
  {
    "key": "upgrade_backpack_desc",
    "value": "Para guardar los minerales y gemas que encuentres.",
  },
  {
    "key": "upgrade_backpack_next_level_desc",
    "value": "Mejora tu mochila y obtén una ranura adicional para minerales y gemas.",
  },
  {
    "key": "upgrade_backpack_01",
    "value": "Mochila de minero",
  },
  {
    "key": "upgrade_backpack_01_desc",
    "value": ""No es muy grande, pero caben distintos tipos de minerales y gemas."",
  },
  {
    "key": "upgrade_backpack_02",
    "value": "Mochila de animalito",
  },
  {
    "key": "upgrade_backpack_02_desc",
    "metadata": {
      "raw": "Pun on Shakespeare play "Taming of the shrew"",
    },
    "value": ""De los animalitos se aprovechan hasta los andares."",
  },
  {
    "key": "upgrade_backpack_03",
    "value": "Bolsa de almacenamiento",
  },
  {
    "key": "upgrade_backpack_03_desc",
    "value": ""El nombre lo explica todo."",
  },
  {
    "key": "upgrade_backpack_04",
    "metadata": {
      "raw": " Pun on the lost epic of ancient Greek litterature, The Sack of Troy",
    },
    "value": "Saco troyano",
  },
  {
    "key": "upgrade_backpack_04_desc",
    "metadata": {
      "raw": " Pun on Achillean heel,expression meaning where your weakness is",
    },
    "value": ""Ríndete ante los irresistibles encantos de la calidad aquileana."",
  },
  {
    "key": "upgrade_backpack_05",
    "metadata": {
      "raw": "Pun on the old "I can't believe it's not butter" https://en.wikipedia.org/wiki/I_Can%27t_Believe_It%27s_Not_Butter!",
    },
    "value": "La-bolsa-de-mamá",
  },
  {
    "key": "upgrade_backpack_05_desc",
    "metadata": {
      "raw": "When re-released the product had an additional line on the package - Good on everything.",
    },
    "value": ""Nadie sabe cómo, pero en ella cabe la casa entera."",
  },
  {
    "key": "upgrade_backpack_06",
    "value": "Bolso de Gremlins",
  },
  {
    "key": "upgrade_backpack_06_desc",
    "metadata": {
      "raw": " A pun on the creatures Gremlins from movie Gremlins. They get evil if they eat after midnight.",
    },
    "value": ""¡No metas nada en él después de medianoche!"",
  },
  {
    "key": "upgrade_backpack_07",
    "metadata": {
      "raw": "Elves like Legolas from Lord of The rings",
    },
    "value": "Bolsita élfica",
  },
  {
    "key": "upgrade_backpack_07_desc",
    "metadata": {
      "raw": "Pun on Legolas quote: let a ploughman plough, but choose an otter for swimming, and for running light over grass and leaf, or over snow--an Elf.",
    },
    "value": ""Elige una nutria para nadar, y para correr ligeramente sobre la hierba y las hojas, o sobre la nieve..., una bolsita élfica."",
  },
  {
    "key": "upgrade_backpack_08",
    "metadata": {
      "raw": "Lord of the Rings pun - One ring to tame them all.",
    },
    "value": "Un saco para guardarlos a todos",
  },
  {
    "key": "upgrade_backpack_08_desc",
    "value": ""Es adorable cómo seguimos reciclando juegos de palabras, ¿verdad? Pero el saco es de lo mejor."",
  },
  {
    "key": "upgrade_backpack_09",
    "metadata": {
      "raw": " The big and extinct Elephant-like creature.",
    },
    "value": "Mochila de Mamut",
  },
  {
    "key": "upgrade_backpack_09_desc",
    "value": ""Lanudamente espaciosa."",
  },
  {
    "key": "upgrade_backpack_10",
    "metadata": {
      "raw": "Pun on the Hindu Scripture Bhagavad Gita https://en.wikipedia.org/wiki/Bhagavad_Gita",
    },
    "value": "Bolsín itzá",
  },
  {
    "key": "upgrade_backpack_10_desc",
    "metadata": {
      "raw": "sanskrit vedanta – vedan't ya? Hinduism - Hindsight",
    },
    "value": ""Una bolsa de proporciones mitológicas. No necesitas ofrecerte en sacrificio, simplemente guarda tus riquezas y protégelas del fin del mundo."",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01",
    "value": "Separador magnético",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Atrae recursos expuestos.",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01_flavor",
    "metadata": {
      "raw": "Harry Potter pun on spell accio = fetch",
    },
    "value": ""¡Accio cosas!."",
  },
  {
    "key": "upgrade_backpack_extra_ore_01",
    "metadata": {
      "raw": " Norse God Freyr owned a ship that he could fold into his pocket when not needed",
    },
    "value": "Bolsillo de Frey",
  },
  {
    "key": "upgrade_backpack_extra_ore_01_desc",
    "value": "Te permite guardar un trozo de mineral adicional en cada ranura común.",
  },
  {
    "key": "upgrade_backpack_extra_ore_01_flavor",
    "metadata": {
      "raw": " Taken from norse mythology, The books of Snorri, The prose Edda, The poetic Edda.",
    },
    "value": ""Prosaico, poético, precioso."",
  },
  {
    "key": "upgrade_backpack_extra_gem_01",
    "value": "Depósito doble",
  },
  {
    "key": "upgrade_backpack_extra_gem_01_desc",
    "metadata": {
      "raw": " new: rephrasing",
    },
    "value": "Te permite guardar dos gemas por ranura.",
  },
  {
    "key": "upgrade_backpack_extra_gem_01_flavor",
    "value": ""Muchos más beneficios en menos espacio."",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01",
    "value": "Dinero de enajenación",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01_desc",
    "value": "Recibes un porcentaje del valor en monedas de los recursos que descartas.",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01_flavor",
    "metadata": {
      "raw": "Lyrics From Sades song Smooth Operator",
    },
    "value": ""Descartaría lo que fuera por tener tan sólo unas monedas para el mercader..."",
  },
  {
    "key": "upgrade_backpack_discard_give_health",
    "metadata": {
      "raw": " Pun on Elton john song circle of life meaning that everything goes around and comes back to life – from song circle of life, Recycle the present is just a quote on how recycling today will make the future a better place.",
    },
    "value": "Re-ciclo de la vida",
  },
  {
    "key": "upgrade_backpack_discard_give_health_desc",
    "value": "Recuperas un poco de tu salud cuando descartas un recurso. Descartar gemas restaura más salud que si descartas minerales.",
  },
  {
    "key": "upgrade_backpack_discard_give_health_flavor",
    "value": ""Recicla el presente, garantiza tu futuro."",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01",
    "value": "Descuento de la Parca",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Pierdes menos recursos cuando mueres.",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01_flavor",
    "metadata": {
      "raw": "Blue Öyster Cult cult classic song Don't fear the reaper",
    },
    "value": ""No le tengo miedo a la muerte, ni tampoco a la vida."",
  },
  {
    "key": "upgrade_backpack_town_portal",
    "value": "Portal del perdón",
  },
  {
    "key": "upgrade_backpack_town_portal_desc",
    "metadata": {
      "raw": "El Machino is the name of the city",
    },
    "value": "Te permite volver a El Machino instantáneamente sin perder recursos. Activa esta habilidad en la pestaña de Sistema.\\n\\n{format bold}Deshabilitado en cuevas y cuando estás en peligro. El icono de habilidad {image town_portal_small} te muestra cuándo la puedes usar.{format reset}",
  },
  {
    "key": "upgrade_backpack_town_portal_flavor",
    "value": ""Te lo llevarás a la tumba."",
  },
  {
    "key": "upgrade_backpack_double_resources",
    "metadata": {
      "raw": "Famous Internet meme Double Rainbow https://www.youtube.com/watch?v=OQSNhk5ICTI",
    },
    "value": "Arco iris doble",
  },
  {
    "key": "upgrade_backpack_double_resources_desc",
    "metadata": {
      "raw": "new: minor rephrasing",
    },
    "value": "Tienes la posibilidad de recibir dos recursos de un solo mosaico de recursos.",
  },
  {
    "key": "upgrade_backpack_double_resources_flavor",
    "metadata": {
      "raw": "From meme double rainbow",
    },
    "value": ""¡Qué intenso!."",
  },
  {
    "key": "upgrade_backpack_pickup_money",
    "value": "El rey pobre",
  },
  {
    "key": "upgrade_backpack_pickup_money_desc",
    "value": "Recibes dinero cuando recoges recursos de escaso valor. Cuanto más bajo sea su valor, más dinero ganarás. No funciona con recursos cuyo valor esté por encima de $7.",
  },
  {
    "key": "upgrade_backpack_pickup_money_flavor",
    "metadata": {
      "raw": " Quote from Tolkiens books, character Samwise Gamgee's line: It's like in the great stories, Mr. Frodo, the ones that really mattered.",
    },
    "value": ""Con y sin dinero, yo hago siempre lo que quiero y mi palabra es la ley."",
  },
  {
    "key": "upgrade_backpack_extra_value",
    "metadata": {
      "raw": "Pun on Bruce Willis Line in Die Hard, yippie ki-yay combined with yuppie as in newly rich person that makes money",
    },
    "value": "¡Yupi ka-yay!",
  },
  {
    "key": "upgrade_backpack_extra_value_desc",
    "value": "Consigue un 30%% más de dinero al vender recursos.",
  },
  {
    "key": "upgrade_backpack_extra_value_flavor",
    "metadata": {
      "raw": "From Internet meme: http://knowyourmeme.com/memes/it-prints-money",
    },
    "value": ""It prints money!"",
  },
  {
    "key": "upgrade_armor",
    "value": "Armadura",
  },
  {
    "key": "upgrade_armor_desc",
    "value": "La armadura te protege de los peligros que se esconden en las profundidades.",
  },
  {
    "key": "upgrade_armor_next_level_desc",
    "value": "Mejora tu armadura para aumentar tu salud total.",
  },
  {
    "key": "upgrade_armor_01",
    "value": "Armadura de placas",
  },
  {
    "key": "upgrade_armor_01_desc",
    "value": ""Una armadura protectora básica, nada especial."",
  },
  {
    "key": "upgrade_armor_02",
    "value": "Armadura robusta",
  },
  {
    "key": "upgrade_armor_02_desc",
    "value": ""Más resistente que la armadura básica, pero sigue siendo bastante simple."",
  },
  {
    "key": "upgrade_armor_03",
    "value": "Armadura sólida",
  },
  {
    "key": "upgrade_armor_03_desc",
    "value": ""Te da mejor protección en lugares peligrosos."",
  },
  {
    "key": "upgrade_armor_04",
    "value": "Armadura templada",
  },
  {
    "key": "upgrade_armor_04_desc",
    "value": ""Templada diferencialmente siguiendo una técnica tradicional europea."",
  },
  {
    "key": "upgrade_armor_05",
    "value": "Armadura famosa",
  },
  {
    "key": "upgrade_armor_05_desc",
    "metadata": {
      "raw": "From lyrics to song Fame from movie Fame",
    },
    "value": ""Una gran armadura conlleva una gran responsabilidad."",
  },
  {
    "key": "upgrade_armor_06",
    "value": "Armadura Doom",
  },
  {
    "key": "upgrade_armor_06_desc",
    "metadata": {
      "raw": "From Doom game manual description of their armor and pun on title "knee-deep in the dead" – the first level from original Doom",
    },
    "value": ""Una armadura defensiva común, diseñada para cuando estás con el agua hasta el cuello."",
  },
  {
    "key": "upgrade_armor_07",
    "value": "Armadura de luna llena",
  },
  {
    "key": "upgrade_armor_07_desc",
    "metadata": {
      "raw": "Reference to Tom Petty's song "Won't back down" from album "Full Moon Fever"",
    },
    "value": ""Tranquilo, no se convertirá en una piel de lobo en noches de luna llena."",
  },
  {
    "key": "upgrade_armor_08",
    "value": "Armadura del fénix",
  },
  {
    "key": "upgrade_armor_08_desc",
    "metadata": {
      "raw": "Thou – old english",
    },
    "value": ""Resucitad, quitaos las cenizas del cuerpo y convertíos en una nueva estrella."",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01",
    "metadata": {
      "raw": " Landing soft like the cougar feline",
    },
    "value": "Garras de puma",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01_desc",
    "value": "Reduce el daño al caer.",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01_flavor",
    "value": ""Si caigo, atrápame en tus brazos."",
  },
  {
    "key": "upgrade_armor_thorns",
    "value": "Placas del karma",
  },
  {
    "key": "upgrade_armor_thorns_desc",
    "value": "Inflige daños a quienes te dañen al tocarte.",
  },
  {
    "key": "upgrade_armor_thorns_flavor",
    "metadata": {
      "raw": "A power ballad song by band Poison",
    },
    "value": ""Tiene espinas el rosal."",
  },
  {
    "key": "upgrade_armor_guts",
    "metadata": {
      "raw": "A spoof on Hasselhoff's song True Survivor for short film Kung Fury",
    },
    "value": "Verdadero superviviente",
  },
  {
    "key": "upgrade_armor_guts_desc",
    "value": "Recupera toda la barra de salud tras recibir daño letal. Un solo uso por recarga. Para recargarlo, visita la ciudad.",
  },
  {
    "key": "upgrade_armor_guts_flavor",
    "value": ""Resurge de entre las cenizas como el único sobreviviente."",
  },
  {
    "key": "upgrade_armor_resistliquids",
    "metadata": {
      "raw": "Vidar = The Norse God that slayed the Fenrir Wolf",
    },
    "value": "Botas de Vidar",
  },
  {
    "key": "upgrade_armor_resistliquids_desc",
    "value": "Te vuelven invulnerable al ácido y a la lava durante un breve periodo de tiempo.",
  },
  {
    "key": "upgrade_armor_resistliquids_flavor",
    "value": ""Con estás botas no caminarás sobre el agua, pero sí sobre la lava y el fuego."",
  },
  {
    "key": "upgrade_armor_damage_reduction",
    "value": "Armadura de ultra compuestos",
  },
  {
    "key": "upgrade_armor_damage_reduction_desc",
    "value": "Reduce el daño que recibes.",
  },
  {
    "key": "upgrade_armor_damage_reduction_flavor",
    "value": ""Una muestra de la protección más resistente jamás creada."",
  },
  {
    "key": "upgrade_armor_rainbow_orbs",
    "metadata": {
      "raw": "*NEW* Song "As long as you love me" by Backstreet Boys. I don't care who you are, Where you're from, What you did, As long as you love me. The terms diversity, fluid and rainbow are used as an hommage to tolerance and the LGBTQ community.",
    },
    "value": "Diversidad nuclear",
  },
  {
    "key": "upgrade_armor_rainbow_orbs_desc",
    "value": "Una armadura líquida policromática que te da una pequeña oportunidad de obtener 3 orbes de arco iris cuando derrotas a un enemigo.",
  },
  {
    "key": "upgrade_armor_rainbow_orbs_flavor",
    "value": ""¿A quién le importa lo que yo haga? ¿A quién le importa lo que yo diga? Yo soy así, así vestiré, nunca cambiaré."",
  },
  {
    "key": "upgrade_armor_deflect",
    "value": "Armadura de aramida",
  },
  {
    "key": "upgrade_armor_deflect_desc",
    "value": "Rechaza el primer proyectil que te golpee. Se recarga tras 30 segundos.",
  },
  {
    "key": "upgrade_armor_deflect_flavor",
    "metadata": {
      "raw": "A riposte used when someone calls you a name. Indicates that whatever ... I'm rubber you're glue, your words bounce off me and stick to you. Also a nod to its usage in Monkey Island game series.",
    },
    "value": ""Rebota, rebota y en tu cara explota."",
  },
  {
    "key": "upgrade_watertank",
    "value": "Tanque de agua",
  },
  {
    "key": "upgrade_watertank_desc",
    "value": "Muchas de las herramientas necesitan agua. La puedes reponer en los manantiales que se encuentran en las minas.",
  },
  {
    "key": "upgrade_watertank_next_level_desc",
    "value": "Mejora tu tanque de agua para aumentar tu reserva total de agua.",
  },
  {
    "key": "upgrade_watertank_01",
    "value": "Jarra simple",
  },
  {
    "key": "upgrade_watertank_01_desc",
    "value": ""Es la piedra angular de la tecnología de vapor."",
  },
  {
    "key": "upgrade_watertank_02",
    "metadata": {
      "raw": "Herman Melville - author of Moby Dick",
    },
    "value": "Regulador Melville",
  },
  {
    "key": "upgrade_watertank_02_desc",
    "value": ""Dale un toque clásico a tu tecnología acuática."",
  },
  {
    "key": "upgrade_watertank_03",
    "metadata": {
      "raw": "The Notourious B.I.G. and his song Mo money Mo problems",
    },
    "value": "Mojada Rodríguez",
  },
  {
    "key": "upgrade_watertank_03_desc",
    "value": ""Y si ya tengo el agua que me da la lluvia."",
  },
  {
    "key": "upgrade_watertank_04",
    "metadata": {
      "raw": "Old band The Sisters of Mercy",
    },
    "value": "Las cisternas muertas",
  },
  {
    "key": "upgrade_watertank_04_desc",
    "metadata": {
      "raw": "One of their songs",
    },
    "value": ""Agüita amarilla."",
  },
  {
    "key": "upgrade_watertank_05",
    "metadata": {
      "raw": "From Captain Nemo's submarine Nautilus",
    },
    "value": "Nautilus II",
  },
  {
    "key": "upgrade_watertank_05_desc",
    "metadata": {
      "raw": "Spoof on Jules Verne's book Twenty Thousand Leagues under the sea",
    },
    "value": ""Veinte mil leguas de agua submarina."",
  },
  {
    "key": "upgrade_watertank_water_pickup_01",
    "value": "Invocalluvias",
  },
  {
    "key": "upgrade_watertank_water_pickup_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing.",
    },
    "value": "Probabilidad de que los enemigos derrotados produzcan un orbe de agua adicional.",
  },
  {
    "key": "upgrade_watertank_water_pickup_01_flavor",
    "metadata": {
      "raw": "BJ Thomas song Raindrops Keep falling on my head",
    },
    "value": ""Llueve sobre mojado."",
  },
  {
    "key": "upgrade_watertank_improved_water_pump",
    "metadata": {
      "raw": "Technotronics old song",
    },
    "value": "Chorreo estéreo",
  },
  {
    "key": "upgrade_watertank_improved_water_pump_desc",
    "value": "Absorbe agua más rápido de los depósitos.",
  },
  {
    "key": "upgrade_watertank_improved_water_pump_flavor",
    "metadata": {
      "raw": "From the song Pump up the Jam",
    },
    "value": ""De la absorción de agua ligera, nada nos libre, agua más llega."",
  },
  {
    "key": "upgrade_watertank_water_condenser",
    "value": "Vaporizador de humedad",
  },
  {
    "key": "upgrade_watertank_water_condenser_desc",
    "value": "Transforma el vapor en agua corriente.",
  },
  {
    "key": "upgrade_watertank_water_condenser_flavor",
    "metadata": {
      "raw": "Jimmy cliff song lyrics: I can see clearly now the rain is gone",
    },
    "value": ""Ojalá llueva vapor en las minas."",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water",
    "value": "Cazatormentas",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water_desc",
    "value": "Este chisme condensador convierte los orbes de luz en orbes de agua. No afecta a los orbes arco iris.",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water_flavor",
    "metadata": {
      "raw": "Reference to the Bible where Jesus turned water into wine",
    },
    "value": ""La luz en agua, el agua en vino: es el truco más antiguo de todos."",
  },
  {
    "key": "upgrade_watertank_regeneration",
    "value": "Regeneración acuática",
  },
  {
    "key": "upgrade_watertank_regeneration_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Recupera tu salud cuando estás en fuentes de agua.",
  },
  {
    "key": "upgrade_watertank_regeneration_flavor",
    "value": ""El ciclo del agua y el de la vida son uno."",
  },
  {
    "key": "upgrade_minimap",
    "value": "Mapa",
  },
  {
    "key": "upgrade_minimap_desc",
    "value": "Te muestra dónde has estado y a dónde vas.",
  },
  {
    "key": "upgrade_minimap_01",
    "value": "Mapa",
  },
  {
    "key": "upgrade_minimap_01_desc",
    "metadata": {
      "raw": "Quote from Earl Nightingale, american writer",
    },
    "value": ""Todo lo que necesitas es un plan, un mapa y la valentía necesaria para lanzarte hacia tu próximo destino."",
  },
  {
    "key": "upgrade_minimap_quest_pointer",
    "metadata": {
      "raw": " (Renamed)",
    },
    "value": "Marcadores de mapa",
  },
  {
    "key": "upgrade_minimap_quest_pointer_desc",
    "metadata": {
      "raw": " Text within { } should not be translated.",
    },
    "value": "Muestra los marcadores ({image quest_pointer_arrow} y {image quest_pointer_crosshair}) en el mapa hacia tu destino de misión.\\n\\n{format bold}Si prefieres explorar sin ayuda, desactiva este engranaje modificador.{format reset}",
  },
  {
    "key": "upgrade_minimap_quest_pointer_flavor",
    "metadata": {
      "raw": "A nod to Lemmy's Show and the character Falconhoof. https://www.youtube.com/watch?v=oWmiShFb0go",
    },
    "value": ""Atención en carretera, le atiende Belén, ¿en qué puedo ayudarle?"",
  },
  {
    "key": "upgrade_minimap_mineral_detector",
    "metadata": {
      "raw": "Nod to the Harry Potter Marauder's Map",
    },
    "value": "Mapa del acaparador",
  },
  {
    "key": "upgrade_minimap_mineral_detector_desc",
    "value": "Muestra todos los minerales en el minimapa.",
  },
  {
    "key": "upgrade_minimap_mineral_detector_flavor",
    "metadata": {
      "raw": "Small pun on actor Roger Moore",
    },
    "value": ""¡Mineralízate!"",
  },
  {
    "key": "upgrade_minimap_hp_bar",
    "metadata": {
      "raw": " Odin – all-seeing father of norse mythology, quote is merely a question without reference, feel free to make it into your own languages equivalent",
    },
    "value": "Ojo de Odín",
  },
  {
    "key": "upgrade_minimap_hp_bar_desc",
    "value": "Muestra la salud de los enemigos cuando sufren algún daño.",
  },
  {
    "key": "upgrade_minimap_hp_bar_flavor",
    "value": ""¿Qué hay más allá de lo que los ojos ven?"",
  },
  {
    "key": "upgrade_run_boots",
    "metadata": {
      "raw": "*DEMO*",
    },
    "value": "Esprint hidráulico",
  },
  {
    "key": "upgrade_run_boots_desc",
    "value": "Mantén {indicator run} para correr.\\nSi corres, te mueves más rápido y saltas más alto.",
  },
  {
    "key": "upgrade_run_boots_flavor",
    "metadata": {
      "raw": "I Blame Coco lyrics from song Quicker",
    },
    "value": ""¡Sé más rápido que King África en un buffet libre!"",
  },
  {
    "key": "upgrade_buddy",
    "metadata": {
      "raw": "Name",
    },
    "value": "Fen",
  },
  {
    "key": "upgrade_buddy_desc",
    "value": "Un ser fantasmagórico misterioso que ha convertido la caldera de vapor en su hogar.",
  },
  {
    "key": "upgrade_fate",
    "value": "Motor del Destino",
  },
  {
    "key": "upgrade_fate_desc",
    "value": "Mejoras misteriosas que cambian los engranajes del universo.",
  },
  {
    "key": "upgrade_fate_flavor",
    "metadata": {
      "raw": "Black Sabbath lyrics from song Symptom of the universe",
    },
    "value": ""Llevas el destino del universo escrito en tu mirada."",
  },
  {
    "key": "upgrade_fate_bloodquest",
    "value": "{image danger}Misión de sangre{image danger}",
  },
  {
    "key": "upgrade_fate_bloodquest_desc",
    "metadata": {
      "raw": "Blood Stone is a resource in the game. Text within { } should not be translated. ",
    },
    "value": "¡Derrama sangre para ganar recompensas!\\nDuplica las posibilidades de obtener piedras de sangre cuando los enemigos mueren, pero también duplica el daño que te causan.\\n\\n{format bold}Activar este engranaje modificador hará tu misión mucho más difícil. Solo se recomienda para veteranos.{format reset}",
  },
  {
    "key": "upgrade_fate_bloodquest_flavor",
    "value": ""Un arma de doble filo."",
  },
  {
    "key": "upgrade_fate_xpx2",
    "value": "{image danger}El Libro de los aventureros{image danger}",
  },
  {
    "key": "upgrade_fate_xpx2_desc",
    "metadata": {
      "raw": "Text within { } should not be translated. ",
    },
    "value": "Obtén el doble de XP con cada muerte, pero los enemigos solo te darán orbes por muertes creativas o bonificaciones.\\n\\n{format bold}Activar este engranaje modificador hará tus misiones mucho más difíciles. Recomendado solo para veteranos.{format reset}",
  },
  {
    "key": "upgrade_fate_xpx2_flavor",
    "metadata": {
      "raw": "Made up proverb",
    },
    "value": ""El que no sufre, no avanza."",
  },
  {
    "key": "upgrade_fate_explosions",
    "value": "{image danger}Explosión mortis{image danger}",
  },
  {
    "key": "upgrade_fate_explosions_desc",
    "metadata": {
      "raw": "Text within { } should not be translated. ",
    },
    "value": "Los enemigos explotan al morir.\\n\\n{format bold}Activar este engranaje modificador hará tus misiones mucho más difíciles.{format reset}",
  },
  {
    "key": "upgrade_fate_explosions_flavor",
    "metadata": {
      "raw": "Let there be light, from the bible",
    },
    "value": ""¡Hágase la explosión!"",
  },
  {
    "key": "upgrade_fate_resource_exploder",
    "metadata": {
      "raw": " Criss-Cross is refering to that the adjacent tiles will break in a cross pattern. Totally krossed out is Rap duo Kriss-Kross debut album, so it's a pun on that, but with correct spelling with c, not k.",
    },
    "value": "Combustión cruzada",
  },
  {
    "key": "upgrade_fate_resource_exploder_desc",
    "value": "Destruir un mosaico de recursos produce una pequeña explosión que daña los mosaicos adyacentes.",
  },
  {
    "key": "upgrade_fate_resource_exploder_flavor",
    "value": ""La que has liado, pollito."",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil",
    "metadata": {
      "raw": " Latin for Seal of Heaven and Hell",
    },
    "value": "Sigillum Caelum et Infernum",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil_desc",
    "value": "En la solitaria cima del tiempo\\nun aullido recorre el desierto\\nalcanza los cielos para sellar tu destino\\nen un lugar extraño, vacío, divino.",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil_flavor",
    "metadata": {
      "raw": " Nod to Twin Peaks: Fire Walk With Me, meaning that you invite the devil to join you. Fate walk with me implies that you invite fate into your life.",
    },
    "value": ""Destino, camina conmigo."",
  },
  {
    "key": "upgrade_steampack",
    "value": "Motor de reacción",
  },
  {
    "key": "upgrade_steampack_desc",
    "value": "Mantén {indicator jump} para volar.\\nEste motor de combustión diésel experimental se puede usar sin utilizar agua, pero se sobrecalienta rápidamente.",
  },
  {
    "key": "upgrade_steampack_next_level_desc",
    "value": "Mejora el motor de reacción para que dure más.",
  },
  {
    "key": "upgrade_steampack_01",
    "metadata": {
      "raw": "From Rocketeer comic origin 1939, character Cliff Secord",
    },
    "value": "Propulsor diésel",
  },
  {
    "key": "upgrade_steampack_01_desc",
    "value": ""Un motor básico de cuatro cilindros en línea."",
  },
  {
    "key": "upgrade_steampack_02",
    "value": "Ciclón doble",
  },
  {
    "key": "upgrade_steampack_02_desc",
    "value": ""Invertido y con aire acondicionado."",
  },
  {
    "key": "upgrade_steampack_03",
    "metadata": {
      "raw": "Reference to a French WW1 engine.",
    },
    "value": "Le Rhône 69",
  },
  {
    "key": "upgrade_steampack_03_desc",
    "value": ""Tiene un sistema de enfriamiento de agua y aire. Es todo o nada, nena, ¡todo o nada!"",
  },
  {
    "key": "upgrade_steampack_slayer",
    "value": "Estatoreactor Vigor",
  },
  {
    "key": "upgrade_steampack_slayer_desc",
    "value": "Cuando usas la explosión de tu propulsor, destruirás a todos los enemigos y mosaicos débiles que te toquen.",
  },
  {
    "key": "upgrade_steampack_slayer_flavor",
    "metadata": {
      "raw": "Reference to Eric Clapton song Grand Illusion",
    },
    "value": ""Atrapado entre la locura y el fuego."",
  },
  {
    "key": "upgrade_steampack_feather_fall",
    "metadata": {
      "raw": " References is to song Falling by Julee Cruise, and song line Don't let yourself be hurt this time.",
    },
    "value": "Control de crucero",
  },
  {
    "key": "upgrade_steampack_feather_fall_desc",
    "value": "Cuando el propulsor se sobrecaliente, mantén {indicator jump} para reducir la velocidad de caída.",
  },
  {
    "key": "upgrade_steampack_feather_fall_flavor",
    "value": ""No dejes que nada te dañe esta vez."",
  },
  {
    "key": "upgrade_steampack_boost",
    "metadata": {
      "raw": " Quote from character Maverick from movie Top Gun. Maverick Afterburner is also a reference to the character played by Tom Cruise.",
    },
    "value": "Postquemador rebelde",
  },
  {
    "key": "upgrade_steampack_boost_desc",
    "value": "Aumenta la velocidad de tu propulsor. ¡Pon tu motor a todo gas y escucha cómo ruge!",
  },
  {
    "key": "upgrade_steampack_boost_flavor",
    "value": ""Siento la necesidad de la velocidad."",
  },
  {
    "key": "upgrade_steampack_in_air_cooling",
    "metadata": {
      "raw": "*NEW* Eastbound and down is a song from the movie "Smokey and the Bandit" Cletus Snow is a character from the movie, and his dog's name is Fred.",
    },
    "value": "Enfriamiento por aire",
  },
  {
    "key": "upgrade_steampack_in_air_cooling_desc",
    "value": "Suelta {indicator jump} en el aire para enfriar tu propulsor. Fabricado por Jon y Nieve y Cía.",
  },
  {
    "key": "upgrade_steampack_in_air_cooling_flavor",
    "value": ""¡Ve al infinito y más allá sin sobrecalentarte!"",
  },
  {
    "key": "upgrade_pressurebomb",
    "value": "Bomba de presión",
  },
  {
    "key": "upgrade_pressurebomb_desc",
    "value": "La puedes lanzar hacia el frente, arriba o abajo. Consume agua.\\n¡Pulsa {indicator tool_pressurebomb} para lanzarla!",
  },
  {
    "key": "upgrade_pressurebomb_next_level_desc",
    "value": "Mejora tus bombas de presión para poder lanzarlas más lejos.",
  },
  {
    "key": "upgrade_pressurebomb_01",
    "metadata": {
      "raw": "Osmotic= water pressure terminology",
    },
    "value": "Bomba de presión osmótica",
  },
  {
    "key": "upgrade_pressurebomb_01_desc",
    "metadata": {
      "raw": "A small refernence, mid-range migraine, to song The Message by Grandmaster Flash and the Furious Five",
    },
    "value": ""La alta presión implica una gran explosión -y un gran dolor de cabeza- a media distancia."",
  },
  {
    "key": "upgrade_pressurebomb_02",
    "metadata": {
      "raw": "Per Scholander= physiologist renowned for pressure bomb technology",
    },
    "value": "Bomba hidrostática Scholander",
  },
  {
    "key": "upgrade_pressurebomb_02_desc",
    "value": ""¡Lanza la destrucción presurizada aún más lejos!"",
  },
  {
    "key": "upgrade_pressurebomb_03",
    "value": "Bomba ácida",
  },
  {
    "key": "upgrade_pressurebomb_03_desc",
    "metadata": {
      "raw": "Reference to Scooter song Acid Bomb",
    },
    "value": ""Para matar, esto es una bomba, para cavar, esto es una bomba."",
  },
  {
    "key": "upgrade_pressurebomb_04",
    "metadata": {
      "raw": "*NEW* Reference: Song Who Put The Bomp by Barry Mann: "Who put the bomp in the bomp bah bomp bah bomp / Who put the ram in the rama lama ding dong / Who put the bop in the bop shoo bop shoo bop / Who put the dip in the dip da dip da dip." =So now you can throw the bomb further = bomb bah LONGA' =longer",
    },
    "value": "Bombaleo",
  },
  {
    "key": "upgrade_pressurebomb_04_desc",
    "value": ""¡Bombaleo, bombalea, porque mi vida yo la prefiero vivir así, lanzando bombas hasta morir!"",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker",
    "value": "Proyectiles antibúnker",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker_desc",
    "value": "¡Otorga penetración a tus bombas de presión para que puedas romper rocas aún más resistentes!",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker_flavor",
    "metadata": {
      "raw": "Ghostbusters pun - When there's something strange in the neighbourhood, who ya gonna call",
    },
    "value": ""¿A quién vas a llamar?."",
  },
  {
    "key": "upgrade_pressurebomb_launcher",
    "value": "Granada de presión",
  },
  {
    "key": "upgrade_pressurebomb_launcher_desc",
    "value": "Mantén {indicator tool_pressurebomb} para lanzar la granada de presión en un arco de destrucción masiva.",
  },
  {
    "key": "upgrade_pressurebomb_launcher_flavor",
    "metadata": {
      "raw": "Billy Ray Cyrus song Achy breaky heart",
    },
    "value": ""Ahora sí podrás pasarte todo por el arco del triunfo."",
  },
  {
    "key": "upgrade_pressurebomb_improved_water",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Reducción de impuestos",
  },
  {
    "key": "upgrade_pressurebomb_improved_water_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Disminuye el consumo de agua a la mitad.",
  },
  {
    "key": "upgrade_pressurebomb_improved_water_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED* Biblical referense to Moses",
    },
    "value": ""Igual a cómo Moisés partió las aguas por la mitad."",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup",
    "value": "Bomba húmeda",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup_desc",
    "value": "Genera un orbe de agua extra al destruir mosaicos con bombas de presión.",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup_flavor",
    "metadata": {
      "raw": "Reference to band Wet Wet Wet and their song Love is all around",
    },
    "value": ""Humidifiquemos el ambiente."",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Amplificador de presión",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "La onda explosiva de la bomba de presión daña a enemigos aún más lejos.",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED* Chris Cornell song wave Goodbye",
    },
    "value": ""No quiero estar solo corriendo, todos directo al infierno, todos directo al infierno."",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity",
    "metadata": {
      "raw": "Pun on Molotov Cocktail",
    },
    "value": "Vacuna Molotov",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity_desc",
    "value": "Evita que te dañen las bombas de presión.",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity_flavor",
    "value": ""Me gusta el olor del napalm por la mañana."",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple",
    "metadata": {
      "raw": " ThreeForce is a reference to the Legend of Zelda TriForce, The quote is just a rhyme and not important.",
    },
    "value": "Trigranada",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple_desc",
    "value": "¡Esta cosita tan molona te permite disparar tres granadas de presión en vez de una cuando la cargas para disparar!",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple_flavor",
    "value": ""Una sorpresa multiplicada por tres."",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb",
    "metadata": {
      "raw": " Norman Greenbaum song lyrics Spirit in the sky, pun on somebody being a mean spirit = bad and mean to people.",
    },
    "value": "Asaltante celestial",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb_desc",
    "value": "Te permite lanzar bombas de presión mientras vuelas. ¡Vuela por los aires y lanza bombas desde una distancia más segura!",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb_flavor",
    "value": ""Te recomendaré al espíritu vengador del cielo."",
  },
  {
    "key": "upgrade_jackhammer",
    "value": "Martillo neumático",
  },
  {
    "key": "upgrade_jackhammer_desc",
    "value": "Una herramienta excepcional para destruir materiales duros, pero ineficaz contra enemigos. Necesita agua. Mantén {indicator tool_jackhammer} para tener más potencia.",
  },
  {
    "key": "upgrade_jackhammer_next_level_desc",
    "value": "Mejora tu martillo mecánico para que excave de forma más eficiente.",
  },
  {
    "key": "upgrade_jackhammer_01",
    "metadata": {
      "raw": "Pun on Peter Gabriels song Sledgehammer",
    },
    "value": "Amor-tillo",
  },
  {
    "key": "upgrade_jackhammer_01_desc",
    "metadata": {
      "raw": "Pun on Peter Gabriels song Sledgehammer - I want to be your sledgehammer",
    },
    "value": ""Seré tu amante martillo, martillo."",
  },
  {
    "key": "upgrade_jackhammer_02",
    "metadata": {
      "raw": "Titans=Mythological adversaries to the gods",
    },
    "value": "La perdición del titán",
  },
  {
    "key": "upgrade_jackhammer_02_desc",
    "metadata": {
      "raw": "Removed MC Hammer reference",
    },
    "value": ""Consumo de combustible mejorado para que des más golpes por cada cubo de agua."",
  },
  {
    "key": "upgrade_jackhammer_03",
    "metadata": {
      "raw": "From Rocky 4 - Character Ivan Drago",
    },
    "value": "Iván Drago M4",
  },
  {
    "key": "upgrade_jackhammer_03_desc",
    "metadata": {
      "raw": "His signature phrase "I must break you"",
    },
    "value": ""Su punta ha sido reforzada con carburo de tungsteno para tener una potencia que rompe hasta la muralla de hierro."",
  },
  {
    "key": "upgrade_jackhammer_04",
    "metadata": {
      "raw": "In norse mythology Mjölnir is the hammer of the mighty Thor",
    },
    "value": "Voluntad de Mjolnir",
  },
  {
    "key": "upgrade_jackhammer_04_desc",
    "value": ""Todo aquel que posea este martillo, si es digno, poseerá el poder de Thor."",
  },
  {
    "key": "upgrade_jackhammer_improved_water",
    "metadata": {
      "raw": "Jab - to punch NOT CURRENTLY USED",
    },
    "value": "Golpe seco",
  },
  {
    "key": "upgrade_jackhammer_improved_water_desc",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Disminuye el consumo de agua a la mitad.",
  },
  {
    "key": "upgrade_jackhammer_improved_water_flavor",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": ""Hace calor, un calor muy seco."",
  },
  {
    "key": "upgrade_jackhammer_faster_windup",
    "value": "Lubricante sintético",
  },
  {
    "key": "upgrade_jackhammer_faster_windup_desc",
    "value": "Mejora la velocidad de golpe del martillo.",
  },
  {
    "key": "upgrade_jackhammer_faster_windup_flavor",
    "metadata": {
      "raw": "Frankie goes to Hollywood song Relax",
    },
    "value": ""Romperé, ooh, cavaré, oh oh oh oh."",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed",
    "metadata": {
      "raw": "Tribute to band KLF - also known as the Justified Ancients of Mu Mu",
    },
    "value": "Viejo cilindro menudo",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed_desc",
    "value": "Cilindro neumático mejorado. Permite aumentar la velocidad de excavación, pero también aumenta el uso de agua.",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed_flavor",
    "metadata": {
      "raw": "Their tune Last train to Trancentral",
    },
    "value": ""Súbete a mi moto, nunca has conocido un martillo tan veloz."",
  },
  {
    "key": "upgrade_jackhammer_push",
    "value": "Estela de chorro",
  },
  {
    "key": "upgrade_jackhammer_push_desc",
    "value": "Te arrastra hacia adelante cada vez que el martillo atraviesa algún material.",
  },
  {
    "key": "upgrade_jackhammer_push_flavor",
    "metadata": {
      "raw": "Pun on Dolly Parton and Kenny Rodgers song Islands in the stream lyrics",
    },
    "value": ""Arrástrame o pegaré más fuerte."",
  },
  {
    "key": "upgrade_jackhammer_shockwave",
    "metadata": {
      "raw": "DO NOT TRANSLATE, NOT CURRENTLY USED",
    },
    "value": "Quebradura profunda",
  },
  {
    "key": "upgrade_jackhammer_shockwave_desc",
    "metadata": {
      "raw": "DO NOT TRANSLATE, NOT CURRENTLY USED",
    },
    "value": "Hace que tu martillo dañe más mosaicos",
  },
  {
    "key": "upgrade_jackhammer_shockwave_flavor",
