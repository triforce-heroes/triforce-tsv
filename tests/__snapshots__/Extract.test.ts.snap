  {
    "key": "upgrade_broken_lamp",
    "value": "Lampada Rotta",
  },
  {
    "key": "upgrade_broken_lamp_desc",
    "metadata": {
      "raw": "Dorothy fell and broke her lamp.",
    },
    "value": ""Rotta dopo un brusco atterraggio, necessita di essere riparata o sostituita con urgenza."",
