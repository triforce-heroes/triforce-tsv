exports[`extract(tests\\fixtures\\ru_conversations.csv) function > matches snapshot > tests\\fixtures\\ru_conversations.csv 1`] = `
[
  {
    "key": "buddy_inventory_full.conversation_yjp8nk_text",
    "notes": "Speaker=Fen Notes=Comes up when your inventory is full anyou try to pick up more ores.",
    "value": "Эй, у тебя {format highlight}мешок уже полон{format reset}, чудилка.",
  },
  {
    "key": "ore_vendor.conversation_hxfr0f_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* added "there"",
    "value": "Эй, поделишься со мной чем-нибудь блестящим?",
  },
  {
    "key": "ore_vendor.conversation_jh3i2m_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Ну что, хочешь поменять камушки на тугрики?",
  },
  {
    "key": "ore_vendor.conversation_69vpc2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo. Moved this node",
    "value": "Есть что-нибудь ценное на обмен?",
  },
  {
    "key": "ore_vendor.conversation_mi3myw_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Так вперед! Займемся-ка настоящим делом, а?",
  },
  {
    "key": "ore_vendor.conversation_2l670i_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Ну что, есть что-нибудь в этот раз?",
  },
  {
    "key": "ore_vendor.conversation_89hare_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Давай, покажи, что нашла.",
  },
  {
    "key": "ore_vendor.conversation_dfflv5_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Но пока что я готов забирать у тебя руду. Есть что?",
  },
  {
    "key": "ore_vendor.conversation_dvsj68_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Знаешь, мэр Йонкер - дубина редкая, но тут он прав. Нам нужен поток руды!",
  },
  {
    "key": "ore_vendor.conversation_gk3axq_text",
    "notes": "Speaker=Barnacle Jones Notes=*format* Hair on steambots is made of metal.",
    "value": "Говорят, он так извелся из-за руды, что аж волосы ржаветь начали.",
  },
  {
    "key": "ore_vendor.conversation_mosq62_text",
    "notes": "Speaker=Barnacle Jones Notes=" clamps" is the equivavlent of hands, since they are robots.",
    "value": "Что до меня, я всегда рад любой руде от любого шахтера при любых обстоятельствах!",
  },
  {
    "key": "ore_vendor.conversation_fnygz1_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll-face to kiddo.",
    "value": "Нет ничего важнее, чем поддерживать поток руды, детка.",
  },
  {
    "key": "ore_vendor.conversation_7dsj17_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Весь город гудит, что у нас есть новый бот-шахтер.",
  },
  {
    "key": "ore_vendor.conversation_mh0ja0_text",
    "notes": "Speaker=Dorothy",
    "value": "Я тут вообще-то ищу кое-кого. Такой скромный, в красном шарфике.",
  },
  {
    "key": "ore_vendor.conversation_y6ys6p_text",
    "notes": "Speaker=Barnacle Jones Notes=Real McCoy= the real deal.",
    "value": "Знаю такого. Выглядел на все сто, а на деле - ничего особенного!",
  },
  {
    "key": "ore_vendor.conversation_0lzsu6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Обратно так и не вернулся, понимаешь?",
  },
  {
    "key": "ore_vendor.conversation_bhqgnn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    "value": "Надеюсь, ты справишься с этим получше, детка.",
  },
  {
    "key": "ore_vendor.conversation_21a760_text",
    "notes": "Speaker=Barnacle Jones Notes=Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    "value": "А... Ты ведь уже слышала про забитые пневмошахты?",
  },
  {
    "key": "ore_vendor.conversation_oxkxen_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Я не из болтливых, но говорят, мэр закрыл их, чтобы братьям своим отомстить.",
  },
  {
    "key": "ore_vendor.conversation_2zloko_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Кстати, давненько я их не видел.",
  },
  {
    "key": "ore_vendor.conversation_xwxxg4_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Я думал, они начнут шевелиться, раз уж ты составила им конкуренцию.",
  },
  {
    "key": "ore_vendor.conversation_gmenrv_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "В кои веки понадеялся на этих лодырей.",
  },
  {
    "key": "ore_vendor.conversation_xkngbf_text",
    "notes": "Speaker=Barnacle Jones Notes=mazumas= slang for money, please do translate.",
    "value": "Так или иначе, пока шахты закрыты, я теряю деньги, понимаешь?",
  },
  {
    "key": "ore_vendor.conversation_xfxkz8_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Под этой кирпичной кладкой несметные сокровища.",
  },
  {
    "key": "ore_vendor.conversation_op5xlx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Если набредешь на бомжей, чикни их прежде, чем сама наденешь деревянный макинтош.",
  },
  {
    "key": "ore_vendor.conversation_whma58_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Говорят, они там все под бузой и ищут металлолом, ясно?",
  },
  {
    "key": "ore_vendor.conversation_t5mwlu_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Им этой отравы всегда мало. Эта штука делает их сильнее, но одновременно срывает с катушек.",
  },
  {
    "key": "ore_vendor.conversation_649tjr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "А еще от нее жуткая коррозия, так что не прикасайся к ней.",
  },
  {
    "key": "ore_vendor.conversation_03e7vh_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Не знаю, слышала ты или нет, но профессорша-то совсем рехнулась.",
  },
  {
    "key": "ore_vendor.conversation_u2ersk_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Спятила, когда ее дом перевернуло первым землетрясением, ясно?",
  },
  {
    "key": "ore_vendor.conversation_h9iaiy_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Теперь она {format emph}строит ракету{format reset} и готова спустить на это все свое наследство.",
  },
  {
    "key": "ore_vendor.conversation_3jgp0a_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Слышал, она даже в общество ракетчиков вступила.",
  },
  {
    "key": "ore_vendor.conversation_9mc50k_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Они эти штуки по всему миру строят.",
  },
  {
    "key": "ore_vendor.conversation_bsxzro_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Слышишь, у тебя найдется время по пути обыскать пещеры, а, детка?",
  },
  {
    "key": "ore_vendor.conversation_dz2y8u_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Они, конечно, покруче шахт, там не расслабишься.",
  },
  {
    "key": "ore_vendor.conversation_3g80ch_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Но зато больше шансов найти что-нибудь ценное, улавливаешь?",
  },
  {
    "key": "ore_vendor.conversation_nmjdda_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Как только в пещере найдется что-нибудь, оно тут же будет отмечено {image cave_small} на карте. Так что нет нужды копать наобум.",
  },
  {
    "key": "ore_vendor.conversation_u3ck3c_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Кто мог подумать, что у этих сумасшедших фанатиков под их развалюхой столько сокровищ!",
  },
  {
    "key": "ore_vendor.conversation_zh09qm_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Надо было три года назад раскопки начать!",
  },
  {
    "key": "ore_vendor.conversation_g3jyqr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*'",
    "value": "Ну да, я слышал, что в развалинах живет безумная секта поклонников конца света.",
  },
  {
    "key": "ore_vendor.conversation_m4g0mn_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Это их дело, я туда не суюсь, ясно?",
  },
  {
    "key": "ore_vendor.conversation_figdnq_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ты посмотри на этот город. Я сюда юнцом приехал. Надоело пахать в доках.",
  },
  {
    "key": "ore_vendor.conversation_saxa80_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Городок был куда меньше, но вот потенциала было - ого-го!",
  },
  {
    "key": "ore_vendor.conversation_c0haij_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Я тут построил отличный бизнес, оставалось найти того, у кого шестеренка не тонка.",
  },
  {
    "key": "ore_vendor.conversation_3qiyya_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid",
    "value": "Нужно спускаться в неразведанные глубины этого мира, детка.",
  },
  {
    "key": "ore_vendor.conversation_281tok_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Это рискованно, зато и награда стоит того.",
  },
  {
    "key": "ore_vendor.conversation_ef7tr2_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Слышал про какие-то странные джунгли прямо в шахтах.",
  },
  {
    "key": "ore_vendor.conversation_amxf2l_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ну, тебя-то они не остановят.",
  },
  {
    "key": "ore_vendor.conversation_mp7r9y_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Просто боюсь, что остальные нытики испугаются, ясно?",
  },
  {
    "key": "ore_vendor.conversation_fmy8mc_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Говорят, ракета профессорши готова к запуску.",
  },
  {
    "key": "ore_vendor.conversation_mxjgvx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Я думал, у нее шурупы в башке заржавели, а теперь вижу, что она дело задумала, ясно?",
  },
  {
    "key": "ore_vendor.conversation_gd4ef6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Космос совсем не изучен, там полно возможностей для бизнеса.",
  },
  {
    "key": "ore_vendor.conversation_wr4wq2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo",
    "value": "Я и раньше строил бизнес с нуля, детка.",
  },
  {
    "key": "ore_vendor.conversation_mkud7m_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "А нынче у меня больше опыта, чем в молодости.",
  },
  {
    "key": "ore_vendor.conversation_08cc91_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved it to the bottom",
    "value": "Как будет руда на продажу - сразу приходи, ясно?",
  },
  {
    "key": "inhabitant_01.conversation_07qv1j_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Мой никчемный сынок понятия не имеет, что делает.",
  },
  {
    "key": "inhabitant_01.conversation_vx6mcl_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Нам нужны опытные исследователи, чтобы спуститься под землю и найти причину этих землетрясений!",
  },
  {
    "key": "inhabitant_01.conversation_hlqiyo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я знаю, на что похоже смещение тектонической плиты. Разрази меня гром, детка, тут что-то другое!",
  },
  {
    "key": "inhabitant_01.conversation_q4ltpg_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Нам нужен кто-то с мозгами и энтузиазмом. Кто-то, кто готов спуститься в эту шахту.",
  },
  {
    "key": "inhabitant_01.conversation_8w93yl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я работаю в шахтах сколько себя помню, детка... Но таких землетрясений не видела.",
  },
  {
    "key": "inhabitant_01.conversation_ibhbb2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я бы и сама слазила посмотреть, но посмотри на меня... Я уже не шахтер.",
  },
  {
    "key": "inhabitant_01.conversation_ffq3ty_text",
    "notes": "Speaker=Dorothy",
    "value": "Что с вами случилось?",
  },
  {
    "key": "inhabitant_01.conversation_9hmzci_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ох! Это бы несчастный случай в шахте?",
  },
  {
    "key": "inhabitant_01.conversation_uy4syk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Если бы! Потратила кучу деталей на моих сынков-недоумков. Главная моя ошибка в жизни...",
  },
  {
    "key": "inhabitant_01.conversation_g3ij4k_text",
    "notes": "Speaker=Fen Notes=*new* changed format from emph to singsong",
    "value": "{format singsong}Ску-у-ука!{format reset}",
  },
  {
    "key": "inhabitant_01.conversation_xxgpup_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Если б я могла, я б мухой сгоняла в эти туннели!",
  },
  {
    "key": "inhabitant_01.conversation_dgq9o3_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Если хочешь спуститься ниже, тебе нужно {format highlight}починить фонарь{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_o8vje6_text",
    "notes": "Speaker=Dorothy",
    "value": "А что, в шахте и правда так опасно?",
  },
  {
    "key": "inhabitant_01.conversation_0c28a8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ну, там ползает всякое зверье, но зато я бомжей давно не видала.",
  },
  {
    "key": "inhabitant_01.conversation_tt1za6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Мои старшенькие ремонтировали стены, чтоб эти двуногие не лезли.",
  },
  {
    "key": "inhabitant_01.conversation_n71xfs_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Во время бомжацких войн я была совсем юной, но ужасы помню до сих пор.",
  },
  {
    "key": "inhabitant_01.conversation_u3tho1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Но внизу стоит быть ко всему готовой, детка.",
  },
  {
    "key": "inhabitant_01.conversation_8xtyi1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Иди в {format highlight}мастерскую{format reset} возле шахты и почини фонарь. Понятно, если можешь себе позволить детали...",
  },
  {
    "key": "inhabitant_01.conversation_y2vq9y_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Разрази меня гром! Теперь ты и впрямь готова {format highlight}спуститься в шахту{format reset}, детка.",
  },
  {
    "key": "inhabitant_01.conversation_st3zju_text",
    "notes": "Speaker=Dorothy",
    "value": "Кто-нибудь бывал последнее время в Краснокаменном штреке?",
  },
  {
    "key": "inhabitant_01.conversation_0zamqc_text",
    "notes": "Speaker=Ma Yonker",
    "value": "С тех пор как перестали работать пневмолифты, никто.",
  },
  {
    "key": "inhabitant_01.conversation_5atg04_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Если хочешь исследовать всю шахту, придется идти этим путем.",
  },
  {
    "key": "inhabitant_01.conversation_caroq1_text",
    "notes": "Speaker=Dorothy",
    "value": "Попробую сначала {format highlight}расчистить пневмошахту{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_kq5k2e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Только учти, что там порода чем глубже, тем тверже. Тебе нужны будут приличные инструменты.",
  },
  {
    "key": "inhabitant_01.conversation_yo8vom_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Забраться глубже в шахту можно только через Краснокаменный штрек. По крайней мене, пока пневмолифты не работают.",
  },
  {
    "key": "inhabitant_01.conversation_sxlsip_text",
    "notes": "Speaker=Dorothy",
    "value": "Надеюсь взрывчатка мне поможет пробиться в Краснокаменный штрек.",
  },
  {
    "key": "inhabitant_01.conversation_2e9pz1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Должно сработать. Я сама так делала, и не раз.",
  },
  {
    "key": "inhabitant_01.conversation_wkl33e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Отправляйся на Взрывную станцию и {format highlight}получи взрывчатку{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_xtf9h2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну разве не славно, что штрек на месте и не завален? Не думаю, что мы застрахованы от взрыва.",
  },
  {
    "key": "inhabitant_01.conversation_5jzc1m_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Пока пневмолифты не работают, вглубь шахты можно попасть только через Краснокаменный штрек.",
  },
  {
    "key": "inhabitant_01.conversation_3vmqnk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Надеюсь, ты там справляешься, детка.",
  },
  {
    "key": "inhabitant_01.conversation_u6rmdw_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Из-за профессора Шерман я забеспокоилась насчет этих землетрясений, ржа их съешь.",
  },
  {
    "key": "inhabitant_01.conversation_nxlgy6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Она тратит все деньги на свою ракету.",
  },
  {
    "key": "inhabitant_01.conversation_ginz3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Она умная. Думаю, она планирует эвакуацию.",
  },
  {
    "key": "inhabitant_01.conversation_jkfreb_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Надеюсь, моему ржавомозглому сынку хватит шурупов выслушать ее.",
  },
  {
    "key": "inhabitant_01.conversation_3pntbk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Так! А ты отличный шахтер, а?",
  },
  {
    "key": "inhabitant_01.conversation_ebwh66_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Возвращайся в Краснокаменный и разгреби этот завал.",
  },
  {
    "key": "inhabitant_01.conversation_dayt2l_text",
    "notes": "Speaker=Dorothy",
    "value": "Один правильный заряд - и Краснокаменный открыт!",
  },
  {
    "key": "inhabitant_01.conversation_5ji97r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Да, не считая каверн, он чертовски прочный.",
  },
  {
    "key": "inhabitant_01.conversation_m6zdrd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Рад, что он еще цел.",
  },
  {
    "key": "inhabitant_01.conversation_k7klvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Чтобы раскапывать грязь на такой глубине, тебе нужно позаботиться об инструментах.",
  },
  {
    "key": "inhabitant_01.conversation_dspvhm_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "И, да! Не забывай приносить нам новые драгоценные камни!",
  },
  {
    "key": "inhabitant_01.conversation_sl7olj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Потрать часть денег на улучшение инструментов. На глубине затраты окупятся.",
  },
  {
    "key": "inhabitant_01.conversation_x0wxp1_text",
    "notes": "Speaker=Dorothy",
    "value": "Мне нужно попасть на Камнеломную станцию.",
  },
  {
    "key": "inhabitant_01.conversation_63gsgh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Внизу масса проломов и проходов, уж поверь!",
  },
  {
    "key": "inhabitant_01.conversation_qp9quj_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "У моих братьев талант отыскивать их... И блуждать там неделями.",
  },
  {
    "key": "inhabitant_01.conversation_x7yuib_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Говорят, эти мясоголовые бомжи прорываются сквозь стену и устраивают тут бедлам.",
  },
  {
    "key": "inhabitant_01.conversation_hc3b2x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Сходи на разведку к бомжацким стенам. Ты наверняка {format highlight}найдешь станцию{format reset}, детка.",
  },
  {
    "key": "inhabitant_01.conversation_gducoe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ну как, детка, видела бомжей? Давненько они к нам не наведывались.",
  },
  {
    "key": "inhabitant_01.conversation_yr3kie_text",
    "notes": "Speaker=Dorothy",
    "value": "Я заметила, что из-под Тамблтона, моего родного города, они тоже пропали.",
  },
  {
    "key": "inhabitant_01.conversation_owuynx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "То есть, это массовое явление? Я их не встречала уже с пару месяцев как минимум.",
  },
  {
    "key": "inhabitant_01.conversation_3h8ujv_text",
    "notes": "Speaker=Dorothy",
    "value": "Они начали пропадать с тех пор, как Расти уничтожил Вектрона.",
  },
  {
    "key": "inhabitant_01.conversation_ezzezr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Про это я мало знаю, но уж с бомжами-то знакома.",
  },
  {
    "key": "inhabitant_01.conversation_dpbib8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Они вечно пробирались сквозь стену и путались у шахтеров под ногами.",
  },
  {
    "key": "inhabitant_01.conversation_3c3lpm_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Может, их тоже выгнали землетрясения? Сбежали, как крысы с тонущего корабля!",
  },
  {
    "key": "inhabitant_01.conversation_tcvt6a_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Уж не знаю, к добру это или к худу, что бомжи так приутихли.",
  },
  {
    "key": "inhabitant_01.conversation_67vh5i_text",
    "notes": "Speaker=Dorothy",
    "value": "Я нашла бомжей! У них в шахте небольшой городок.",
  },
  {
    "key": "inhabitant_01.conversation_iu5kqd_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Ржа их съешь! Я бы в такое место не совалась. Там опасно!",
  },
  {
    "key": "inhabitant_01.conversation_vhdww6_text",
    "notes": "Speaker=Dorothy",
    "value": "Они вроде бы не такие уж и плохие. Не такие, как я раньше видела.",
  },
  {
    "key": "inhabitant_01.conversation_cbcmjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я только в одном до ржавого болта уверена. Бомжам доверять нельзя!",
  },
  {
    "key": "inhabitant_01.conversation_0glm7l_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Держись подальше от этого их городка, если жизнь дорога!",
  },
  {
    "key": "inhabitant_01.conversation_umbt7u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Копать у храма довольно опасно, но там до сих пор полно сокровищ.",
  },
  {
    "key": "inhabitant_01.conversation_c5baff_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ха, звучит многообещающе! Тебе явно стоит сходить туда и поискать их.",
  },
  {
    "key": "inhabitant_01.conversation_r8rlnp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ай, ржа! Чтобы полезть в эти руины и найти там руду, нужен энтузиазм.",
  },
  {
    "key": "inhabitant_01.conversation_m8hqwy_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Даже его братья не такие тупицы, чтобы {format highlight}сунуться в храм{format reset} под Ветреными равнинами.",
  },
  {
    "key": "inhabitant_01.conversation_bvz9xj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Их захватила безумная секта, культ конца света.",
  },
  {
    "key": "inhabitant_01.conversation_fj6bw8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Развалины в западной пустыне они тоже захватили.",
  },
  {
    "key": "inhabitant_01.conversation_u26tuh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Могу поспорить: там до сих пор командует старый пень Рональд. Он был неплохой мужик, но свихнулся на этой религиозной дури.",
  },
  {
    "key": "inhabitant_01.conversation_gr738j_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Храм под Ветреными равнинами, может, и набит сокровищами, но он еще и опасен, как сто бомжей.",
  },
  {
    "key": "inhabitant_01.conversation_grrmq6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ты, детка, похоже, по уши в своей миссии!",
  },
  {
    "key": "inhabitant_01.conversation_335kyr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Тебе могут попасться следы древних цивилизаций. Вроде тех старых машин на станциях.",
  },
  {
    "key": "inhabitant_01.conversation_2jepw2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "На моей памяти они там всегда были.",
  },
  {
    "key": "inhabitant_01.conversation_mv0s6q_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Некоторые умники говорят, будто это бомжи нас построили.",
  },
  {
    "key": "inhabitant_01.conversation_vxki0p_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Как по мне, так они вовсе не умники. Они себя еще экспертами называют.",
  },
  {
    "key": "inhabitant_01.conversation_ysj9vo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я бы, пожалуй, не рисковала подкапываться под город бомжей. Кто знает, что ты там найдешь!",
  },
  {
    "key": "inhabitant_01.conversation_uj1muo_text",
    "notes": "Speaker=Dorothy",
    "value": "Если я хочу остановить землетрясения, то мне нужно раскопать много мест.",
  },
  {
    "key": "inhabitant_01.conversation_ykczsp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Слышала, профессорша что-то говорит про джунгли в шахте.",
  },
  {
    "key": "inhabitant_01.conversation_z8gocf_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ржа заешь! Не нравится мне это!",
  },
  {
    "key": "inhabitant_01.conversation_dzwjvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "И как нормальному боту копать в таких условиях... Мои сынки не справятся...",
  },
  {
    "key": "inhabitant_01.conversation_x3v93r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Может, ты не заметила, но они тупы, как ведро с болтами.",
  },
  {
    "key": "inhabitant_01.conversation_jmwahi_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Думаю, нам стоит купить билеты на эту ракету.",
  },
  {
    "key": "inhabitant_01.conversation_8augkl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Мои мальчики, может, и бесполезны, но это все равно шестеренка от шестеренки моей.",
  },
  {
    "key": "inhabitant_01.conversation_9v0sjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Думаю, надо будет забронировать пять билетов на ракету.",
  },
  {
    "key": "inhabitant_01.conversation_p75xau_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Мило, что ты так вежливо слушаешь старую железку. Родители тобой наверняка гордятся!",
  },
  {
    "key": "inhabitant_01.conversation_8hjn65_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Не то что мои сынки. Нет от них проку.",
  },
  {
    "key": "inhabitant_01.conversation_x6q3po_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Большая часть постоянно теряется, когда "работает" в шахте. А один - политик, ржа его ешь.",
  },
  {
    "key": "inhabitant_01.conversation_8tssip_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Приятно, что хоть кто-то в шахте знает, что делает!",
  },
  {
    "key": "inhabitant_02.conversation_royiqq_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*new*",
    "value": "Ого-го! Ничего себе {format nervous}землетрясение{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_0z0jlu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Круто! Ты смахиваешь на бота-провинциала - вроде меня! {format singsong}Как мило!{format reset}",
  },
  {
    "key": "inhabitant_02.conversation_i3c2ki_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Мне было так одиноко в последнее время. Деревенщиной себя чувствую.",
  },
  {
    "key": "inhabitant_02.conversation_fnv0dz_text",
    "notes": "Speaker=Fen",
    "value": "Мне-то казалось, это из сортира потянуло, а это деревенские тут ходят...",
  },
  {
    "key": "inhabitant_02.conversation_q58pva_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Искорка твоя верно говорит. Не гожусь я для большого города.",
  },
  {
    "key": "inhabitant_02.conversation_r68qcd_text",
    "notes": "Speaker=Dorothy",
    "value": "Фен, ты можешь для разнообразия быть чуточку вежливее? Вдруг тебе понравится!",
  },
  {
    "key": "inhabitant_02.conversation_6c81lb_text",
    "notes": "Speaker=Fen",
    "value": "Сомневаюсь.",
  },
  {
    "key": "inhabitant_02.conversation_qy4k1b_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Думаю, мне надо возвращаться домой, на ферму.",
  },
  {
    "key": "inhabitant_02.conversation_q27f56_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Привет тебе еще раз, мой провинциальный друг!",
  },
  {
    "key": "inhabitant_02.conversation_bfqhtj_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "На нашего бедного мэра кто только не жалуется.",
  },
  {
    "key": "inhabitant_02.conversation_xpriw7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "А по мне, он знает, что говорит.",
  },
  {
    "key": "inhabitant_02.conversation_kqxpuz_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ну, он же городской... Он-то привык к местным порядкам.",
  },
  {
    "key": "inhabitant_02.conversation_tdhokx_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Если б меня поставили управлять эдакой махиной, я б с винтиков слетела - хоть в металлолом отправляй.",
  },
  {
    "key": "inhabitant_02.conversation_0k5x6v_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Мэр наверняка знает, что делает.",
  },
  {
    "key": "inhabitant_02.conversation_unbiry_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Приятно тебя снова видеть!",
  },
  {
    "key": "inhabitant_02.conversation_fdlynd_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Тут знакомства заводить ох как непросто.",
  },
  {
    "key": "inhabitant_02.conversation_7ymnmr_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Не то что дома: как тебя соберут, сразу всех знаешь.",
  },
  {
    "key": "inhabitant_02.conversation_enl4xa_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Этот город живет в своем ритме, все слишком заняты, чтобы просто поболтать. Даже на вежливость времени не хватает!",
  },
  {
    "key": "inhabitant_02.conversation_aptgjz_text",
    "notes": "Speaker=Fen",
    "value": "Нет, дело просто в тебе.",
  },
  {
    "key": "inhabitant_02.conversation_cqddcg_text",
    "notes": "Speaker=Dorothy",
    "value": "Фен, прекрати, повежливее!",
  },
  {
    "key": "inhabitant_02.conversation_3avufg_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Эх... Я иногда думаю: а они вообще замечают, когда кто-то пропал?",
  },
  {
    "key": "inhabitant_02.conversation_bibnd6_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Я ж так понимаю, тут народ вечно теряется.",
  },
  {
    "key": "inhabitant_02.conversation_l5r7sq_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "У нас-то дома хоть дружить умеют и своих не бросают.",
  },
  {
    "key": "inhabitant_02.conversation_axrc0a_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Я как тебя увидела - сразу поняла, что ты из маленького городка! Ты ведь умеешь дружить, правда?",
  },
  {
    "key": "inhabitant_02.conversation_4ure1i_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ты говорила с этой чокнутой профессоршей, которая ракету строит?",
  },
  {
    "key": "inhabitant_02.conversation_qahysn_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Говорят, она унаследовала кучу денег и все их тратит на ракету.",
  },
  {
    "key": "inhabitant_02.conversation_5923lp_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Вот прям некуда больше!",
  },
  {
    "key": "inhabitant_02.conversation_t94xdc_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "У нас в деревне тоже были такие - ракету строили.",
  },
  {
    "key": "inhabitant_02.conversation_x71xpu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Может, что-то тут затевается, ты как думаешь?",
  },
  {
    "key": "inhabitant_02.conversation_q3y399_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Но, по-моему, эта - самая красивая. Нашу-то из силосной башни мастерили.",
  },
  {
    "key": "inhabitant_02.conversation_12pu8k_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ты только подумай: чокнутые ботаники строят ракеты по всему миру. Как подумаю, {format laugh}смех разбирает{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_e4onuf_text",
    "notes": "Speaker=Dorothy",
    "value": "У тебя усталый вид.",
  },
  {
    "key": "inhabitant_02.conversation_ob0wy7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Тут столько всего творится... Голова кругом!",
  },
  {
    "key": "inhabitant_02.conversation_54qfjg_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Я решила. Поеду домой.",
  },
  {
    "key": "inhabitant_02.conversation_i33o07_text",
    "notes": "Speaker=Penny Kettlebottom Notes=Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    "value": "Мы там волнуемся, только когда папаша Пеппер выгоняет парокопытных из хлева.",
  },
  {
    "key": "inhabitant_02.conversation_7bo632_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Не работаю я под стрессом. Может, заведу себе десяток парокотиков.",
  },
  {
    "key": "inhabitant_02.conversation_jcodma_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Может, я еще потягаюсь с Бесс Клепкинс в конкурсе смазчиков.",
  },
  {
    "key": "inhabitant_02.conversation_rjax07_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Вот будет {format singsong}здорово{format reset} утереть нос этой задаваке Бесс Клепкинс.",
  },
  {
    "key": "inhabitant_02.conversation_kzt23q_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Думаю, мне надо возвращаться домой, на ферму.",
  },
  {
    "key": "climber_01.conversation_vyjpoj_text",
    "notes": "Speaker=Lady Botterley Notes=*format* There is a crashed elevator just next to them.",
    "value": "Из-за землетрясения лифт просто оборвался!",
  },
  {
    "key": "climber_01.conversation_ctbic6_text",
    "notes": "Speaker=Fen Notes=*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    "value": "{format singsong}Ой-ё-ёй{format reset}. Кто-нибудь разбился?",
  },
  {
    "key": "climber_01.conversation_m9r7tc_text",
    "notes": "Speaker=Lady Botterley Notes=*new* changed horrible to terrible and emphasised "thing"",
    "value": "Что вы, {format nervous}как можно!{format reset} Что ты за ужасное {format emph}создание{format reset}?",
  },
  {
    "key": "climber_01.conversation_045qay_text",
    "notes": "Speaker=Fen Notes=She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    "value": "Эй, от {format emph}создания{format reset} слышу! Будь у меня мой амулет, я бы испарила тебя на месте!",
  },
  {
    "key": "climber_01.conversation_fccwnq_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ну, кем бы ты ни была, тебе стоит поучиться манерам!",
  },
  {
    "key": "climber_01.conversation_8oqmau_text",
    "notes": "Speaker=Dorothy",
    "value": "Пожалуйста, простите нас, мэм. Фен еще плохо ориентируется в нашем обществе.",
  },
  {
    "key": "climber_01.conversation_acx7g7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "И сколько же мне ждать, пока этот лифт не починят?",
  },
  {
    "key": "climber_01.conversation_matp87_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ждать здесь в пустыне, в одиночестве, не пристало боту моего положения.",
  },
  {
    "key": "climber_01.conversation_eb6uiw_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ждать здесь в пустыне, в одиночестве, не пристало боту моего положения.",
  },
  {
    "key": "climber_01.conversation_c7c7g6_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Местному мэру недостает бренда, но он небезнадежен.",
  },
  {
    "key": "climber_01.conversation_mdqfxx_text",
    "notes": "Speaker=Lady Botterley Notes=This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    "value": "Боты нередко становятся большим, чем простая комбинация сборочных деталей.",
  },
  {
    "key": "climber_01.conversation_uynh2z_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Мне следует позволить себе довериться его суждению. И всем остальным тоже.",
  },
  {
    "key": "climber_01.conversation_if7w3g_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Не вижу ничего страшного в этих землетрясениях. Этот лифт наверняка давно нуждался в починке.",
  },
  {
    "key": "climber_01.conversation_540zgf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Очень надеюсь, что они пришлют кого-нибудь починить этот механизм. У меня, знаете ли, {format emph}не так много{format reset} времени, чтобы стоять тут и ждать.",
  },
  {
    "key": "climber_01.conversation_t8w29c_text",
    "notes": "Speaker=Dorothy",
    "value": "Так, э... лифт все еще сломан?",
  },
  {
    "key": "climber_01.conversation_2y8m3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Разумеется, нет.",
  },
  {
    "key": "climber_01.conversation_sbn8ap_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Здесь не место для такой леди, как я, но тут хотя бы тихо.",
  },
  {
    "key": "climber_01.conversation_x0xmdc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Эта невыносимая профессорша по соседству постоянно шумит со своими ракетами!",
  },
  {
    "key": "climber_01.conversation_9hvgg5_text",
    "notes": "Speaker=Fen Notes="Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    "value": "Может, ты их с обрыва скинешь?",
  },
  {
    "key": "climber_01.conversation_b63bbp_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Пф! Леди не лазают.",
  },
  {
    "key": "climber_01.conversation_ff5hlh_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Леди не лазают. Я намерена ждать, пока не починят лифт или пока меня кто-нибудь не унесет. Другое мне не подходит.",
  },
  {
    "key": "climber_01.conversation_3lbfex_text",
    "notes": "Speaker=Fen",
    "value": "Все тут торчим, а?",
  },
  {
    "key": "climber_01.conversation_ykf245_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Да, я {format emph}все еще здесь{format reset}. И, да, лифт {format emph}все еще сломан{format reset}. Насмешки здесь неуместны.",
  },
  {
    "key": "climber_01.conversation_c50t6h_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Но это же абсурд! Леди вроде меня наверняка обыскались там, среди этих ржавых железок наверху.",
  },
  {
    "key": "climber_01.conversation_8rvp8u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Мэру стоит объяснить свое поведение.",
  },
  {
    "key": "climber_01.conversation_wpxim7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Я уверена, что все горюют обо мне. Я важная персона, знаешь ли.",
  },
  {
    "key": "climber_01.conversation_gtukg8_text",
    "notes": "Speaker=Fen",
    "value": "Ты ж никуда не собираешься, так?",
  },
  {
    "key": "climber_01.conversation_cudej5_text",
    "notes": "Speaker=Lady Botterley",
    "value": "У меня появилось новое хобби.",
  },
  {
    "key": "climber_01.conversation_h438q0_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Считаю паломников, которые направляются на запад, к этому мерзкому храму.",
  },
  {
    "key": "climber_01.conversation_e0mg3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "В нормальных условиях я бы на них никакого внимания не обратила, но здесь так скучно.",
  },
  {
    "key": "climber_01.conversation_x9lbaf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Эти паломники что-то замышляют. Мне, право, не стоит опускаться до подобных мелочей.",
  },
  {
    "key": "climber_01.conversation_ef66r2_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Опять ты? Тебе больше делать нечего, кроме как беспокоить меня?",
  },
  {
    "key": "climber_01.conversation_4ay3w5_text",
    "notes": "Speaker=Fen",
    "value": "Есть, но троллить тебя так весело!",
  },
  {
    "key": "climber_01.conversation_b1t04s_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Мало мне этих землетрясений.",
  },
  {
    "key": "climber_01.conversation_6ntyzc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ладно. Я пришла к заключению, что этот мэр - идиот.",
  },
  {
    "key": "climber_01.conversation_9sm12u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Понимаю, в это трудно поверить, но даже я порой слегка отклоняюсь от истины в своих суждениях.",
  },
  {
    "key": "climber_01.conversation_ce5r53_text",
    "notes": "Speaker=Fen",
    "value": "Да ты что!",
  },
  {
    "key": "climber_01.conversation_1zdfzx_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Интересно, сколько может стоить билет на ракету...",
  },
  {
    "key": "climber_01.conversation_4y3t9l_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Интересно, сколько может стоить билет на ракету...",
  },
  {
    "key": "climber_01.conversation_bfqth1_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ждать здесь в пустыне, в одиночестве, не пристало особе моего положения.",
  },
  {
    "key": "entering_guidance.conversation_kohvbb_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "{format emph}Ай!{format reset}",
  },
  {
    "key": "entering_guidance.conversation_1a5f80_text",
    "notes": "Speaker=Dorothy Notes=*format* *DEMO*",
    "value": "Да чтоб тебя! Свет погас. Сломался.",
  },
  {
    "key": "entering_guidance.conversation_9rx08a_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Ого! Это еще {format emph}что{format reset} за место?",
  },
  {
    "key": "entering_guidance.conversation_ojjbl5_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Нужно осмотреться тут и {format highlight}найти другой путь наружу{format reset}.",
  },
  {
    "key": "cutscene_fen.conversation_y5enud_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "О {format singsong}великий Путеводный Свет!{format reset} Воссияй нам.",
  },
  {
    "key": "cutscene_fen.conversation_hnsad0_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "ДА, МОЖЕШЬ ГРЕТЬСЯ В МОЕМ РАЗРУШИТЕЛЬНОМ СИЯНИИ.",
  },
  {
    "key": "cutscene_fen.conversation_a1al3q_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "{format singsong}О счастье!{format reset} Нас ждет великое вознесение!",
  },
  {
    "key": "cutscene_fen_02.conversation_2ln8fi_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Эй! Чокнутый фанатик, я тебя щас освещу!",
  },
  {
    "key": "cutscene_fen_02.conversation_qzp3tz_text",
    "notes": "Speaker=Dorothy",
    "value": "Я же говорю, я {format emph}не фанатик!{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_ksn1s4_text",
    "notes": "Speaker=Fen",
    "value": "Да ну? Вы, боты, для меня все на одно лицо.",
  },
  {
    "key": "cutscene_fen_02.conversation_g22jzu_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Ты{format reset} смахиваешь на спрайт Вектрона. Как так {format emph}может быть?{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_01a075_text",
    "notes": "Speaker=Dorothy",
    "value": "Мой друг Расти уничтожил Вектрон - прежде чем сам пропал.",
  },
  {
    "key": "cutscene_fen_02.conversation_w28at6_text",
    "notes": "Speaker=Fen",
    "value": "Секта украла меня и подрубила сюда, чтобы поклоняться. Хотели, чтоб я их испарила. Вознесла, {format laugh}гы-гы-гы!{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_krzwlf_text",
    "notes": "Speaker=Fen",
    "value": "Хм... А я без амулета с этим не справлюсь. И что нам теперь делать?",
  },
  {
    "key": "cutscene_fen_02.conversation_wfa9i6_text",
    "notes": "Speaker=Dorothy",
    "value": "Ну... {format emph}Лично я{format reset} собираюсь наверх, в большой город. Говорят, там видели Расти.",
  },
  {
    "key": "cutscene_fen_02.conversation_qhu4n0_text",
    "notes": "Speaker=Fen",
    "value": "В город, говоришь? Ну ладно, раз ты так настаиваешь, придется пойти с тобой.",
  },
  {
    "key": "cutscene_fen_01.conversation_e2v16f_text",
    "notes": "Speaker=The Guiding Light Notes=*DEMO*",
    "value": "В ЯБЛОЧКО! {format laugh}ХА-ХА-ХА!{format reset}",
  },
  {
    "key": "cutscene_fen_01.conversation_z0997i_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Ух ты! Что там {format emph}происходит{format reset}?",
  },
  {
    "key": "cutscene_fen_01.conversation_0dz6we_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "КАК МИЛО! ЕЩЕ ОДИН ПАЛОМНИК!",
  },
  {
    "key": "cutscene_fen_01.conversation_mzljgp_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Но я не...",
  },
  {
    "key": "cutscene_fen_01.conversation_yadt78_text",
    "notes": "Speaker=The Guiding Light Notes=*new* *DEMO* moved the pew-pew line from below into this line.",
    "value": "ГОТОВЬСЯ ИСПАРИТЬСЯ! {format laugh}ПИУ-ПИУ!{format reset}",
  },
  {
    "key": "fen_ledge_01.conversation_cukwql_text",
    "notes": "Speaker=Fen",
    "value": "О-о-о, что за вид! Хочешь поближе посмотреть?",
  },
  {
    "key": "fen_ledge_02.conversation_aszmw4_text",
    "notes": "Speaker=Fen",
    "value": "Давай, подойди ближе!",
  },
  {
    "key": "fen_ledge_02.conversation_skvrgn_text",
    "notes": "Speaker=Fen",
    "value": "{format singsong}Бли-и-иже, бандерлоги...{format reset} {format laugh}хи-хи-хи!{format reset}",
  },
  {
    "key": "old_salesbot_01.conversation_x6t79e_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ржа меня ешь, если это не Дороти Мак-Скряг!",
  },
  {
    "key": "old_salesbot_01.conversation_yu1bwf_text",
    "notes": "Speaker=Dorothy",
    "value": "Мистер Карсон! Я уж не думала, что встречу знакомых так далеко от дома.",
  },
  {
    "key": "old_salesbot_01.conversation_0hioym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну что, как там делишки в вашем Тамблтоне? Слухи разные ходят!",
  },
  {
    "key": "old_salesbot_01.conversation_dslq5p_text",
    "notes": "Speaker=Dorothy",
    "value": "Все началось с приезда Расти. Он накопал в шахте кучу всего ценного и привел город к процветанию.",
  },
  {
    "key": "old_salesbot_01.conversation_8tr70j_text",
    "notes": "Speaker=Dorothy",
    "value": "Но потом внизу он обнаружил какую-то странную технику. Он объединился с ней и стал сильнее.",
  },
  {
    "key": "old_salesbot_01.conversation_70kkpo_text",
    "notes": "Speaker=Fen",
    "value": "Давай уже, переходи к самому интересному!",
  },
  {
    "key": "old_salesbot_01.conversation_xfpxnh_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно. Оказалось, источник таинственной силы опасен для всех нас.",
  },
  {
    "key": "old_salesbot_01.conversation_epbknd_text",
    "notes": "Speaker=Dorothy",
    "value": "Он одолел его и спас нас, но после этого исчез. И с тех пор я его ищу.",
  },
  {
    "key": "old_salesbot_01.conversation_c5qvu8_text",
    "notes": "Speaker=Dorothy",
    "value": "Один путешественник увидел мои объявления о пропаже, и сказал мне, что Расти видели в шахте в Эль Макино.",
  },
  {
    "key": "old_salesbot_01.conversation_i625og_text",
    "notes": "Speaker=Trader Carson",
    "value": "Да, классная история!",
  },
  {
    "key": "old_salesbot_01.conversation_umknih_text",
    "notes": "Speaker=Dorothy",
    "value": "Если в двух словах, мой друг пропал.",
  },
  {
    "key": "old_salesbot_01.conversation_hp7xc3_text",
    "notes": "Speaker=Dorothy",
    "value": "Один путешественник увидел мои объявления о пропаже и сказал, что видел его в шахте в Эль Макино.",
  },
  {
    "key": "old_salesbot_01.conversation_nfwjrx_text",
    "notes": "Speaker=Trader Carson Notes=*new* changed "well", to "now"",
    "value": "Сейчас лифт в город сломан, придется тебе {format highlight}лезть вверх самой{format reset}.",
  },
  {
    "key": "old_salesbot_01.conversation_c1qqn0_text",
    "notes": "Speaker=Trader Carson",
    "value": "Я, кстати, тоже скоро там буду. Заходи, если тебе понадобятся детали {image cogs_small}. Купи их, чтобы легче было в шахтах.",
  },
  {
    "key": "old_salesbot_01.conversation_m6jpam_text",
    "notes": "Speaker=Trader Carson",
    "value": "Надеюсь, тебе повезет его отыскать.",
  },
  {
    "key": "old_salesbot_01.conversation_q4eiud_text",
    "notes": "Speaker=Trader Carson",
    "value": "А я еще посижу здесь, дам старым пружинам отдохнуть, прежде чем подниматься в город.",
  },
  {
    "key": "old_salesbot_01.conversation_yx3y9m_text",
    "notes": "Speaker=Trader Carson",
    "value": "А пока я жду, может, ты расскажешь мне, что случилось в Тамблтоне?",
  },
  {
    "key": "old_salesbot_01.conversation_x7qfv2_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ладно, может, в другой раз.",
  },
  {
    "key": "old_salesbot_01.conversation_5nktdz_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ах! Обожаю городскую роскошь.",
  },
  {
    "key": "old_salesbot_01.conversation_tj5uh7_text",
    "notes": "Speaker=Trader Carson",
    "value": "Хипстероботы тут готовы платить любую цену за мои фирменные детали для улучшений {image cogs_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_nqd450_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Я неплохо устроился. Езжу туда-сюда, продаю полезные детальки.",
  },
  {
    "key": "old_salesbot_01.conversation_ny6f1a_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Обычно я их покупаю на распродажах и в комиссионках, но некоторые можно найти просто у дороги.",
  },
  {
    "key": "old_salesbot_01.conversation_smo857_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Они производят такой характерный шум, будто тикают негромко.",
  },
  {
    "key": "old_salesbot_01.conversation_gq1rfi_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "С непривычки их трудно услышать, но если будешь старательно прислушиваться, то все получится.",
  },
  {
    "key": "old_salesbot_01.conversation_dm175r_text",
    "notes": "Speaker=Trader Carson",
    "value": "Давненько я твоего папашу не видал, как он там?",
  },
  {
    "key": "old_salesbot_01.conversation_w6hv5b_text",
    "notes": "Speaker=Dorothy",
    "value": "Боюсь, помер недавно.",
  },
  {
    "key": "old_salesbot_01.conversation_by4nym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ох, грустно-то как! Я всегда думал, он нас всех переживет...",
  },
  {
    "key": "old_salesbot_01.conversation_1g9zr8_text",
    "notes": "Speaker=Trader Carson",
    "value": "...Уж хотя бы из чистого упрямства.",
  },
  {
    "key": "old_salesbot_01.conversation_cgmjf4_text",
    "notes": "Speaker=Dorothy",
    "value": "Я тоже...",
  },
  {
    "key": "old_salesbot_01.conversation_i5igy1_text",
    "notes": "Speaker=Trader Carson",
    "value": "А что же случилось с вашим магазинчиком, раз ты тут копаешь?",
  },
  {
    "key": "old_salesbot_01.conversation_lp4kx4_text",
    "notes": "Speaker=Dorothy",
    "value": "О, в Тамблтоне все по-прежнему. У меня была куча покупателей на бизнес.",
  },
  {
    "key": "old_salesbot_01.conversation_a7uh25_text",
    "notes": "Speaker=Dorothy",
    "value": "Я-то всегда хотела в шахте работать, только папа говорил, что это слишком опасно.",
  },
  {
    "key": "old_salesbot_01.conversation_kyijyo_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну что ж, я рад, что ты теперь занимаешься любимым делом.",
  },
  {
    "key": "old_salesbot_01.conversation_s5417g_text",
    "notes": "Speaker=Trader Carson",
    "value": "Хорошо было бы все-таки найти того парня, что спас твой городишко.",
  },
  {
    "key": "old_salesbot_01.conversation_tgpso6_text",
    "notes": "Speaker=Trader Carson",
    "value": "У меня тогда не было дел в ваших краях.",
  },
  {
    "key": "old_salesbot_01.conversation_10nfc4_text",
    "notes": "Speaker=Trader Carson",
    "value": "Как ты говоришь, его зовут? Страсти... Или нет... Здрасти! Так ведь, да?",
  },
  {
    "key": "old_salesbot_01.conversation_vzg8gx_text",
    "notes": "Speaker=Dorothy",
    "value": "Расти...",
  },
  {
    "key": "old_salesbot_01.conversation_ymzbde_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну да, точно. Так что, он одолел огромного монстра в шахте? Сам, без всякой помощи?",
  },
  {
    "key": "old_salesbot_01.conversation_la8vr6_text",
    "notes": "Speaker=Trader Carson",
    "value": "А когда все закончилось, просто исчез!",
  },
  {
    "key": "old_salesbot_01.conversation_k59dwv_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну что ж, крошка Дот, удачи в поисках. Надеюсь, он жив-здоров и ты его найдешь.",
  },
  {
    "key": "old_salesbot_01.conversation_bzq0aw_text",
    "notes": "Speaker=Trader Carson Notes=*new* removed "nothing"",
    "value": "Мир здорово изменился с тех пор, как я был юным ботом.",
  },
  {
    "key": "old_salesbot_01.conversation_zc6l96_text",
    "notes": "Speaker=Trader Carson",
    "value": "В шахте растет лес, боты в космос собираются...",
  },
  {
    "key": "old_salesbot_01.conversation_jnptai_text",
    "notes": "Speaker=Trader Carson",
    "value": "А я все продаю детали {image cogs_small}, как всегда.",
  },
  {
    "key": "old_salesbot_01.conversation_rk0bii_text",
    "notes": "Speaker=Trader Carson",
    "value": "Будущее - его вы, молодые, строите.",
  },
  {
    "key": "old_salesbot_01.conversation_r74j24_text",
    "notes": "Speaker=Trader Carson Notes=Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    "value": "Кстати, у меня тут есть детали {image cogs_small} на продажу. С тебя много не возьму!",
  },
  {
    "key": "old_salesbot_01.conversation_0qym9q_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну как, хочешь еще шестеренку-другую {image cogs_small}?",
  },
  {
    "key": "old_salesbot_01.conversation_yx06g0_text",
    "notes": "Speaker=Trader Carson",
    "value": "Как тебе предложение: Можешь купить отличную новую шестеренку {image cogs_small} всего-то за \${var pricelist_next:carson_cogs}{image money_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_x4iaao_text",
    "notes": "Speaker=Trader Carson",
    "value": "С тобой приятно иметь дело, заходи еще!",
  },
  {
    "key": "old_salesbot_01.conversation_zfed36_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ты отличный клиент, Дотти! Это последняя деталь. Рад, что они тебе пригодились!",
  },
  {
    "key": "old_salesbot_01.conversation_koo3mt_text",
    "notes": "Speaker=Trader Carson",
    "value": "Эх, хотел бы я тебе задаром помочь, но нам, торговцам, тоже надо на что-то жить.",
  },
  {
    "key": "old_salesbot_01.conversation_1yrec8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ну ладно. Приходи, как шестеренки понадобятся {image cogs_small}!",
  },
  {
    "key": "old_salesbot_01.conversation_27y4o8_text",
    "notes": "Speaker=Trader Carson",
    "value": "А у тебя папашина смекалка, я смотрю.",
  },
  {
    "key": "cutscene_fen_03.conversation_c3lb0g_text",
    "notes": "Speaker=Dorothy",
    "value": "Эй, ты что творишь? А ну, {format emph}прочь{format reset} из моей топки!",
  },
  {
    "key": "fen_conquerer.conversation_f2k0wg_text",
    "notes": "Speaker=Fen",
    "value": "Вот, значит, как оно наверху. Светло!",
  },
  {
    "key": "fen_conquerer.conversation_x8lfrw_text",
    "notes": "Speaker=Dorothy",
    "value": "Эй, а у тебя клевая карта! Можешь по ней кого-нибудь найти?",
  },
  {
    "key": "fen_conquerer.conversation_02breo_text",
    "notes": "Speaker=Fen",
    "value": "И хотела бы - не нашла б.",
  },
  {
    "key": "fen_conquerer.conversation_fek90f_text",
    "notes": "Speaker=Dorothy Notes=Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    "value": "Ты мне напоминаешь светляков из папиных историй. Они были просто феноменально противные.",
  },
  {
    "key": "fen_conquerer.conversation_duq0rd_text",
    "notes": "Speaker=Dorothy",
    "value": "Буду звать тебя Феномен. Фен для краткости.",
  },
  {
    "key": "fen_conquerer.conversation_uostgv_text",
    "notes": "Speaker=Dorothy Notes=*new* split from line above",
    "value": "Я Дороти. Можно Дот.",
  },
  {
    "key": "fen_conquerer.conversation_em0ovz_text",
    "notes": "Speaker=Fen",
    "value": "Ну и ладно. Полезу-ка я назад, греться.",
  },
  {
    "key": "fen_conquerer.conversation_tats2u_text",
    "notes": "Speaker=Fen",
    "value": "Разбуди, как будет что-нибудь интересное.",
  },
  {
    "key": "mayor_01.conversation_szoc5w_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Добрый день, я опаздываю на полировку. Жалобы оставляйте в кабинете.",
  },
  {
    "key": "mayor_01.conversation_r6bmk4_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Если это насчет землетрясений, можете не беспокоиться. Обычное явление в этой местности.",
  },
  {
    "key": "mayor_01.conversation_orgrlo_text",
    "notes": "Speaker=Dorothy",
    "value": "Я не жаловаться пришла. Мне нужен доступ в шахту, чтобы найти там пропавшего бота.",
  },
  {
    "key": "mayor_01.conversation_2k8w6x_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format laugh}Ха!{format reset} А мне нужно, чтобы шахта снова заработала. У тебя даже фонаря нет!",
  },
  {
    "key": "mayor_01.conversation_o8zw9i_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ты скорее сама там потеряешься, а мне это совсем некстати. Только не перед выборами.",
  },
  {
    "key": "mayor_01.conversation_2ok5e8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Я же сказал: есть {format emph}зона побезопаснее{format reset}. В шахте, слева от лестницы.",
  },
  {
    "key": "mayor_01.conversation_kbljxa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Если {format highlight}накопаешь руды{format reset} на новый фонарь, охрана пустит тебя в большую шахту.",
  },
  {
    "key": "mayor_01.conversation_dgln8s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй! Я не могу позволить тебе пропасть в шахте. {format highlight}Насобирай ресурсов{format reset} и почини фонарь!",
  },
  {
    "key": "mayor_01.conversation_wdf2e3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Я смотрю, ты хорошо поработала! Не думал, что у тебя выйдет. Иди к Клешнерукому Джонсу!",
  },
  {
    "key": "mayor_01.conversation_y8rutk_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Вон там, зеленый такой, с клешнями. {format highlight}Обменяй руду{format reset} на деньги.",
  },
  {
    "key": "mayor_01.conversation_35uglo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format highlight}Продай руду{format reset} Клешнерукому Джонсу.",
  },
  {
    "key": "mayor_01.conversation_p2p0j1_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй! Деньги чего-то стоят, только если их тратить.",
  },
  {
    "key": "mayor_01.conversation_hd3efw_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Иди-ка {format highlight}почини фонарь{format reset} в мастерской.",
  },
  {
    "key": "mayor_01.conversation_z86wxp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Тот квадратный тихоня тебе поможет.",
  },
  {
    "key": "mayor_01.conversation_w5r2nd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Иди {format highlight}почини фонарь{format reset} в мастерской.",
  },
  {
    "key": "mayor_01.conversation_ujjfnb_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну вот, так-то лучше! Теперь ты и впрямь готова {format highlight}спуститься в шахту{format reset}.",
  },
  {
    "key": "mayor_01.conversation_woghf0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Да, и не забывай таскать нам руду, мою прелес-сть!",
  },
  {
    "key": "mayor_01.conversation_5r6n65_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Привет! Приятно, что хоть кто-то снова начал поставку руды.",
  },
  {
    "key": "mayor_01.conversation_x2jdkd_text",
    "notes": "Speaker=Dorothy",
    "value": "Расту над собой. Не считая стычек со всякими противными тварями.",
  },
  {
    "key": "mayor_01.conversation_b8dzdr_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ну да, я это всем говорю! Они все дергаются почем зря.",
  },
  {
    "key": "mayor_01.conversation_cjntod_text",
    "notes": "Speaker=Dorothy",
    "value": "Я отправлюсь в Краснокаменный штрек и посмотрю, можно ли {format highlight}починить лифт{format reset}.",
  },
  {
    "key": "mayor_01.conversation_pnbpzi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ты, главное, не прекращай таскать сюда руду!",
  },
  {
    "key": "mayor_01.conversation_2pgjla_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "И трать заработок в городских заведениях.",
  },
  {
    "key": "mayor_01.conversation_j881iu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй! Там и перед Краснокаменным полно руды. Нечего туда лезть попусту.",
  },
  {
    "key": "mayor_01.conversation_827vm7_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Понятия не имею, почему бы тебе не оставить взрывную станцию в покое.",
  },
  {
    "key": "mayor_01.conversation_850lak_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Нам правда нужно взрывать все, будто чокнутым бомжам?",
  },
  {
    "key": "mayor_01.conversation_ebyo6x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "А у тебя, сынок, есть другой план, как расчистить Краснокаменный?",
  },
  {
    "key": "mayor_01.conversation_hkla2t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Я просто не понимаю, зачем ей лезть так глубоко.",
  },
  {
    "key": "mayor_01.conversation_s2zuik_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я же говорю: там руда поценнее, чем у поверхности.",
  },
  {
    "key": "mayor_01.conversation_o84rmq_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* changed format from laugh to emph",
    "value": "Ну, раз {format emph}так{format reset}, то конечно...",
  },
  {
    "key": "mayor_01.conversation_wray1t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Чем тебе не нравится старая добрая кирка? Нам что, прям вот так уж нужны бомбы?",
  },
  {
    "key": "mayor_01.conversation_b6rus0_text",
    "notes": "Speaker=Dorothy",
    "value": "Я лучше пойду к Краснокаменному, займусь расчисткой.",
  },
  {
    "key": "mayor_01.conversation_j39zeq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Для нас всех будет лучше, если его расчистят.",
  },
  {
    "key": "mayor_01.conversation_vxn818_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Эй, я же {format emph}не против{format reset} заполучить все эти драгоценные камни из глубокой шахты.",
  },
  {
    "key": "mayor_01.conversation_7zj949_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Будем надеяться, что ты расчистишь Краснокаменный, а не сделаешь еще хуже.",
  },
  {
    "key": "mayor_01.conversation_f7egkh_text",
    "notes": "Speaker=Dorothy",
    "value": "Теперь Краснокаменный штрек открыт, и я смогу искать Расти еще глубже.",
  },
  {
    "key": "mayor_01.conversation_ksg9fp_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Эй, а его что, еще не нашли? Ну, ты только носи сюда побольше руды.",
  },
  {
    "key": "mayor_01.conversation_gu106f_text",
    "notes": "Speaker=Ma Yonker",
    "value": "До защитной стены можешь копать без препятствий, детка.",
  },
  {
    "key": "mayor_01.conversation_56ijq0_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Боюсь, твой дружок провалился в какую-нибудь трещину в стене.",
  },
  {
    "key": "mayor_01.conversation_ynbcdq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я бы на твоем месте заглянула на каменоломную станцию.",
  },
  {
    "key": "mayor_01.conversation_twgnbe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Там есть старая машинка, которая тебе здорово поможет.",
  },
  {
    "key": "mayor_01.conversation_51emyp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Это та, которую мои брательники в прошлом году в кирпичную кладку замуровали?",
  },
  {
    "key": "mayor_01.conversation_8gee3i_text",
    "notes": "Speaker=Ma Yonker",
    "value": "А, ржа их ешь! Но ты наверняка {format highlight}найдешь способ{format reset} справиться с кирпичами.",
  },
  {
    "key": "mayor_01.conversation_4sh4u4_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed the line beneath this.",
    "value": "Эй! Если найдешь - скажи, я потом кого-нибудь пошлю залатать стену.",
  },
  {
    "key": "mayor_01.conversation_gbjzn6_text",
    "notes": "Speaker=Dorothy Notes=*new* changed cave to passage",
    "value": "Я нашла под стеной очень странный проход. Он зарос странными растениями.",
  },
  {
    "key": "mayor_01.conversation_jsqibo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну, как по мне, на такой глубине все странным кажется. В конце концов, там страна бомжей недалеко.",
  },
  {
    "key": "mayor_01.conversation_2xq01z_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Мои остальные тупые сынки что-то говорили о заросшей пещере.",
  },
  {
    "key": "mayor_01.conversation_aukq83_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Я-то думала, это давление им шурупы сместило.",
  },
  {
    "key": "mayor_01.conversation_8rttb6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Братья обнесли камнеломную станцию стеной.",
  },
  {
    "key": "mayor_01.conversation_6scmnj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Они такие, моим парням всем шурупов не хватает.",
  },
  {
    "key": "mayor_01.conversation_jseqve_text",
    "notes": "Speaker=Dorothy",
    "value": "Я добралась до стены и нашла камнеломную станцию... А вот следов Расти пока не вижу.",
  },
  {
    "key": "mayor_01.conversation_saqvas_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй! Да какой разумный бот закопается так глубоко? Ты же не хочешь {format highlight}залезть к бомжам{format reset}, правда же?",
  },
  {
    "key": "mayor_01.conversation_41t2gq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Этот отбойный молоток вмиг расколотит кирпичи и поможет тебе спуститься туда.",
  },
  {
    "key": "mayor_01.conversation_nlrzra_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Только следи, чтоб вода не кончилась. Он ее расходует, как БОТсман в пустыне!",
  },
  {
    "key": "mayor_01.conversation_x4aowp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, ты только бомжей сюда не приводи. Этого мне точно не надо!",
  },
  {
    "key": "mayor_01.conversation_acygrc_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Будешь стену пробивать - осторожней. И берегись этих бомжей ненормальных.",
  },
  {
    "key": "mayor_01.conversation_mo33pi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed fake news to tone down Trumpism",
    "value": "Эта психованная профессор Шерман сеет панику со своими псевдоисследованиями землетрясений.",
  },
  {
    "key": "mayor_01.conversation_27gaig_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, толчки даже не перевернули ничего.",
  },
  {
    "key": "mayor_01.conversation_ydzkaa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Носится со своей ракетой, а на нас свысока смотрит. Только потому что у нее ученая степень.",
  },
  {
    "key": "mayor_01.conversation_667vwu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Шерман думает, она умнее всех, раз степень получила. {format laugh}Ха!{format reset} Из всех бумажек тут ценятся только зеленые...",
  },
  {
    "key": "mayor_01.conversation_jx90fz_text",
    "notes": "Speaker=Dorothy",
    "value": "Эта тупая секта прячет какую-то {format emph}машину судного дня{format reset}.",
  },
  {
    "key": "mayor_01.conversation_jw27fp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Это из-за нее земля трясется, ржа ее?",
  },
  {
    "key": "mayor_01.conversation_9baw7n_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, ну так это точно не наша проблема!",
  },
  {
    "key": "mayor_01.conversation_7m1f5t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Нельзя же ждать от мэрии, чтоб мы разбирались со всякими там концами света.",
  },
  {
    "key": "mayor_01.conversation_qbl22o_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Моя задача - отправлять ботов в шахту и получать драгоценные камни. И налогами шахтеров облагать.",
  },
  {
    "key": "mayor_01.conversation_v4im3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ты тут за все отвечаешь, тупица. Занял должность - теперь разбирайся!",
  },
  {
    "key": "mayor_01.conversation_v6x25f_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, а девочка ж уже бывала в храме. Она может сходить туда еще раз и отключить машину!",
  },
  {
    "key": "mayor_01.conversation_6dx6ev_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Нет машины - нет проблемы! И не забывай приносить новые драгоценные камни!",
  },
  {
    "key": "mayor_01.conversation_6aje4l_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, ну как, было время заскочить в храм и {format highlight}разобраться с этой дурацкой машиной{format reset}?",
  },
  {
    "key": "mayor_01.conversation_3lxi6c_text",
    "notes": "Speaker=Dorothy",
    "value": "Мы уничтожили машину рока.",
  },
  {
    "key": "mayor_01.conversation_rv004f_text",
    "notes": "Speaker=Fen",
    "value": "Ага, мы круты! Вы б видели, как она взорвалась!",
  },
  {
    "key": "mayor_01.conversation_7nmsnx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну вот! У мэрии все под контролем!",
  },
  {
    "key": "mayor_01.conversation_qpbmn2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format emph}Идиот!{format reset}",
  },
  {
    "key": "mayor_01.conversation_j8m71m_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, {format emph}это ведь я{format reset}, между прочим, отправил ее в шахту.",
  },
  {
    "key": "mayor_01.conversation_sptgv3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Мои заслуги нужно признать. Это ведь я отправил тебя в шахту.",
  },
  {
    "key": "mayor_01.conversation_2h1yth_text",
    "notes": "Speaker=Dorothy",
    "value": "Мы нашли в шахте и другие устройства, вызывающие землетрясения.",
  },
  {
    "key": "mayor_01.conversation_xbnodu_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* enclosed "come" into the format",
    "value": "Ой, да {format emph}хватит{format reset}! Можно мне хоть минуту вздохнуть спокойно?",
  },
  {
    "key": "mayor_01.conversation_6c2elx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, мне всего-то нужна была непыльная работка - чтоб не лазить в эти вонючие шахты.",
  },
  {
    "key": "mayor_01.conversation_kk8x0s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Если ты не {format highlight}отключишь эти устройства{format reset}, мне придется эвакуировать весь город!",
  },
  {
    "key": "mayor_01.conversation_hmjz7t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ты хоть представляешь, сколько это будет стоить?",
  },
  {
    "key": "mayor_01.conversation_qzd676_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ну хоть ценные ископаемые потаскай с глубины, раз ты все равно там.",
  },
  {
    "key": "mayor_01.conversation_ocz2bm_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну что, ты уже отключила те устройства?",
  },
  {
    "key": "mayor_01.conversation_wihfk8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "То джунгли в шахте растут, то сектанты конец света готовят...",
  },
  {
    "key": "mayor_01.conversation_jcggy6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Прошлому-то мэру наверняка не приходилось иметь с таким дело...",
  },
  {
    "key": "mayor_01.conversation_8d282i_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Я уже почти жалею, что не пошел в семейный бизнес. Братья-то, вон, не жалуются.",
  },
  {
    "key": "mayor_01.conversation_w4v0m6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Думаю, надо паковать чемоданы вместе с избирателями.",
  },
  {
    "key": "mayor_01.conversation_mm9lt2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Не могу же я быть мэром без города, так? Хм, это утешает...",
  },
  {
    "key": "mayor_01.conversation_e4p6yr_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, может, я тогда займусь семейным бизнесом. Буду астероиды разрабатывать...",
  },
  {
    "key": "mayor_01.conversation_yzrylo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Привет! Как тебе слоган? "Делай дело, что бы ни взлетело!" Нравится, а?",
  },
  {
    "key": "talk_to_mayor.conversation_pap70a_text",
    "notes": "Speaker=Dorothy",
    "value": "Шахтер с красным шарфом? Это {format emph}Расти{format reset}! В кои веки зацепка!",
  },
  {
    "key": "talk_to_mayor.conversation_n0lq8o_text",
    "notes": "Speaker=Fen",
    "value": "Мне нравятся эти землетрясения.",
  },
  {
    "key": "talk_to_mayor.conversation_3nu9ex_text",
    "notes": "Speaker=Fen",
    "value": "Ничто так не красит приключение, как хаос и неразбериха!",
  },
  {
    "key": "talk_to_mayor.conversation_elfbhm_text",
    "notes": "Speaker=Dorothy",
    "value": "Нужно {format highlight}поговорить с мэром{format reset} и получить пропуск в шахту.",
  },
  {
    "key": "guard_archaea.conversation_lty8j0_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Эй! Вам тут копать нельзя, юная леди!",
  },
  {
    "key": "guard_archaea.conversation_ml6q7x_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Шахтеров и так достаточно пропало, ясно вам?",
  },
  {
    "key": "guard_archaea.conversation_cmr7ae_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Думаю, вам с мэром надо поговорить. Получите пропуск.",
  },
  {
    "key": "guard_archaea.conversation_jqyolm_text",
    "notes": "Speaker=Coral Armstrong Notes=Her chest lamp is busted",
    "value": "Па-астойте-ка, девушка! Я вас не пропущу без надлежащего источника света.",
  },
  {
    "key": "guard_archaea.conversation_jmhinb_text",
    "notes": "Speaker=Dorothy",
    "value": "Мне же просто друга найти нужно! Можно я одним глазком загляну?",
  },
  {
    "key": "guard_archaea.conversation_97lht6_text",
    "notes": "Speaker=Fen",
    "value": "Да, пусть заглянет. Может, она даже вернуться сможет. {format emph}Или нет.{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_naakhs_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Я так понимаю, у нас {format emph}еще один{format reset} шахтер пропал.",
  },
  {
    "key": "guard_archaea.conversation_wjso4t_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Лезть туда на ощупь слишком опасно. Может, лучше {format highlight}покопаешь руду{format reset} в освещенной зоне?",
  },
  {
    "key": "guard_archaea.conversation_iom5do_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Лезть туда на ощупь слишком опасно. Может, лучше сначала {format highlight}починишь фонарь{format reset} в городе?",
  },
  {
    "key": "guard_archaea.conversation_c5cn1e_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Эй! Чтобы заработать на хороший фонарь, тебе нужно {format highlight}накопать руды{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_6b9sev_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Может, {format highlight}продашь свою руду{format reset} и отдашь фонарь в починку?",
  },
  {
    "key": "guard_archaea.conversation_66rd82_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ты вроде как сможешь {format highlight}починить фонарь{format reset} в мастерской в город.",
  },
  {
    "key": "guard_archaea.conversation_94r9zk_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Хм! Похоже, ты готова к раскопкам!",
  },
  {
    "key": "guard_archaea.conversation_n9j9h3_text",
    "notes": "Speaker=Dorothy",
    "value": "Так вы мне разрешаете {format highlight}спуститься в шахту{format reset}?",
  },
  {
    "key": "guard_archaea.conversation_p0ntw5_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Конечно! Только покажи, как ты {format highlight}зажжешь фонарь{format reset} вон там, и я открываю люки.",
  },
  {
    "key": "guard_archaea.conversation_wphcux_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format highlight}Зажги вон тот фонарь{format reset}, и я пущу тебя в шахту.",
  },
  {
    "key": "guard_archaea.conversation_f36o1k_text",
    "notes": "Speaker=Coral Armstrong Notes=*new* expanded this as I removed the full text that was used before. It was repatative.",
    "value": "По-моему, воспользоваться пневмолифтом будет куда быстрее, чем топать до города пешком.",
  },
  {
    "key": "guard_archaea.conversation_ih3zjl_text",
    "notes": "Speaker=Dorothy",
    "value": "Вы были правы насчет Краснокаменного штрека. Он завален.",
  },
  {
    "key": "guard_archaea.conversation_lynw1k_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Неудивительно.",
  },
  {
    "key": "guard_archaea.conversation_arg7cq_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Но по мне, немного взрывчатки его расчистит.",
  },
  {
    "key": "guard_archaea.conversation_94selp_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "По мне, если правильно установить заряд, Краснокаменный расчистится как миленький",
  },
  {
    "key": "guard_archaea.conversation_pl5kjt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "По мне, тебе стоит рассказать мэру, как расчистишь Краснокаменный.",
  },
  {
    "key": "guard_archaea.conversation_d3sb26_text",
    "notes": "Speaker=Coral Armstrong Notes=Shiners are cave dwelling human decendants.",
    "value": "Мне в шахтах много кто встречался, но бомжи - самые опасные и непредсказуемые.",
  },
  {
    "key": "guard_archaea.conversation_a458ae_text",
    "notes": "Speaker=Coral Armstrong Notes=A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    "value": "Война еще до меня была, но на мою долю тоже выпали стычки с этими обалдуями.",
  },
  {
    "key": "guard_archaea.conversation_t6mrk7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Говорить с ними смысла нет, надо сразу бить - и побыстрее",
  },
  {
    "key": "guard_archaea.conversation_pygh76_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Может, это грубо, но я предпочитаю не рисковать.",
  },
  {
    "key": "guard_archaea.conversation_xgdjhu_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Хорошо, что после войны стену построили.",
  },
  {
    "key": "guard_archaea.conversation_ujn89n_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Может, раньше эти бомжи и другие были.",
  },
  {
    "key": "guard_archaea.conversation_nd5hoz_text",
    "notes": "Speaker=Coral Armstrong Notes=Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    "value": "Теперь они на всю голову больные и землю трясут.",
  },
  {
    "key": "guard_archaea.conversation_5xd7xt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "По мне, мутантам никогда нельзя доверять.",
  },
  {
    "key": "guard_archaea.conversation_y6jyvf_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Видела ненормальных паломников из секты?",
  },
  {
    "key": "guard_archaea.conversation_1tzeuc_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Они иногда бродят по шахте между храмами.",
  },
  {
    "key": "guard_archaea.conversation_147ntm_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Обычно-то они по Ветреным Равнинам идут.",
  },
  {
    "key": "guard_archaea.conversation_f34oeg_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ничего против них не имею против. Хоть не так одиноко, когда они тут.",
  },
  {
    "key": "guard_archaea.conversation_l509g4_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ничего себе, как глубоко ты забралась.",
  },
  {
    "key": "guard_archaea.conversation_lbobkd_text",
    "notes": "Speaker=Coral Armstrong Notes=*format*",
    "value": "Но смотри, не зевай. Мне рассказывали об опасностях, про которые в городе мало кто знает.",
  },
  {
    "key": "guard_archaea.conversation_alemgw_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Всегда смотри, чтоб ты могла вернуться. Туннель без выхода - это, почитай, большой гроб.",
  },
  {
    "key": "guard_archaea.conversation_51bz8w_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format emph}Помни об этом{format reset} и запасись броней.",
  },
  {
    "key": "guard_archaea.conversation_e9lgr6_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Будь начеку и следи за снаряжением - вот лучший совет, что я могу дать.",
  },
  {
    "key": "guard_archaea.conversation_19pnkh_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Братья Йонкеры, кажись, видели какие-то заросли в шахте.",
  },
  {
    "key": "guard_archaea.conversation_205qqo_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Говорят, они разрастаются, но в город я их не пропущу.",
  },
  {
    "key": "guard_archaea.conversation_59fokz_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Надо бы топор получше купить на всякий случай. В конце концов, не пригодится - найду другое применение.",
  },
  {
    "key": "guard_archaea.conversation_vwt53j_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Жуть берет, когда джунгли могут вот так выскочить из ниоткуда.",
  },
  {
    "key": "guard_archaea.conversation_1re540_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Я, признаться, чуток волнуюсь из-за землетрясений.",
  },
  {
    "key": "guard_archaea.conversation_25kyco_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "В последнее время они сильнее стали. Но не бойся, я с поста не уйду.",
  },
  {
    "key": "guard_archaea.conversation_e0zgh7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Если никто не защищает шахтеров, они могут в беду попасть.",
  },
  {
    "key": "guard_archaea.conversation_jkptm2_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "В моем корпусе места страху нет. Только долг. Я выполняю долг.",
  },
  {
    "key": "guard_archaea.conversation_4niz25_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format highlight}Береги фонарь{format reset}, чтоб не остаться в темноте.",
  },
  {
    "key": "guard_archaea.conversation_aex9as_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Если начнет мигать, сразу поворачивай назад и {format highlight}залей топливо наверху{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_dmvx8z_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Шахта - место опасное, так что держи снаряжение в порядке.",
  },
  {
    "key": "welcome_to_el_machino.conversation_uimryl_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй, там! Всем успокоиться!",
  },
  {
    "key": "welcome_to_el_machino.conversation_31d0sd_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Вообще-то из-за этих {format nervous}землетрясений{format reset} стоит волноваться.",
  },
  {
    "key": "welcome_to_el_machino.conversation_4njhbf_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Я вам уже говорила: мой сейсмограф выдает очень странные показатели!",
  },
  {
    "key": "welcome_to_el_machino.conversation_l4n0br_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Есть вещи и поважнее. Например, поддерживать поток руды.",
  },
  {
    "key": "welcome_to_el_machino.conversation_dzl3uz_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Дубина! Чего экспертов не слушаешь?",
  },
  {
    "key": "welcome_to_el_machino.conversation_7blj3t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ну мам! Эти мне "эксперты" с "фактами"... Они за камнями шахты не видят.",
  },
  {
    "key": "welcome_to_el_machino.conversation_lwjidu_text",
    "notes": "Speaker=Ma Yonker",
    "value": "А что насчет того {format emph}парнишки в красном шарфике{format reset}, что в шахту залез, да так и не вернулся?",
  },
  {
    "key": "welcome_to_el_machino.conversation_jije2r_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Я поставил охрану, чтобы больше никто не пропадал.",
  },
  {
    "key": "welcome_to_el_machino.conversation_jhc64p_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Так, давайте рассуждать здраво и помнить самое главное: мэрия тут ни при чем.",
  },
  {
    "key": "welcome_to_el_machino.conversation_njlyi9_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Дурная башка!",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_xqrxw3_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ха-ха! Бабах!{format reset} Давай еще раз!",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_y6g3s7_text",
    "notes": "Speaker=Dorothy",
    "value": "Эти бомбы нам точно пригодятся. Они нам откроют путь туда, куда с киркой не добраться.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_c5us81_text",
    "notes": "Speaker=Dorothy",
    "value": "Думаю, пора {format highlight}сказать мэру{format reset}, что штрек снова открыт.",
  },
  {
    "key": "guard_open_hatch.conversation_ig8tga_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Через некоторое время кто-то снова начал минировать туннели.",
  },
  {
    "key": "guard_open_hatch.conversation_3li9iu_text",
    "notes": "Speaker=Dorothy",
    "value": "Наконец-то я напала на след Расти.",
  },
  {
    "key": "guard_open_hatch.conversation_ti9ln5_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "По мне, твой дружок должен был так или иначе пройти Краснокаменным штреком.",
  },
  {
    "key": "guard_open_hatch.conversation_60et06_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Обычно туда можно попасть на пневмолифте.",
  },
  {
    "key": "guard_open_hatch.conversation_cix8sl_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Но землетрясение завалило лифтовую шахту Стоит {format highlight}расчистить штрек{format reset}.",
  },
  {
    "key": "guard_open_hatch.conversation_h47l73_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Так что, я открываю люк, а ты спускаешься вниз?",
  },
  {
    "key": "buddy_need_light.conversation_q6n8pp_text",
    "notes": "Speaker=Fen",
    "value": "Темновато становится. Я хоть и свечусь, а ни зги не вижу.",
  },
  {
    "key": "buddy_need_light.conversation_1dc723_text",
    "notes": "Speaker=Fen Notes=The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    "value": "{format highlight}Возвращайся в город{format reset} и залей фонарь горючим, а то я тут потеряюсь.",
  },
  {
    "key": "fen_cave_in.conversation_ytvst4_text",
    "notes": "Speaker=Dorothy",
    "value": "Кажется, это и есть Краснокаменный штрек. Обвал, как мы и думали.",
  },
  {
    "key": "fen_cave_in.conversation_ac4a61_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Была б у тебя взрывчатка, можно было бы разнести завал на раз-два.",
  },
  {
    "key": "fen_cave_in.conversation_f2qhr1_text",
    "notes": "Speaker=Dorothy",
    "value": "Неплохая идея! Нужно вернуться в город и расспросить народ.",
  },
  {
    "key": "fen_cave_in.conversation_8j9cex_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ага, взрывчаточка!{format reset} Может, ты даже руки-ноги себе поотрываешь!",
  },
  {
    "key": "fen_cave_in.conversation_0g7tly_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Зараза! Давай-ка расчистим эту пневмошахту, а?",
  },
  {
    "key": "fen_cave_in.conversation_n67xrl_text",
    "notes": "Speaker=Dorothy",
    "value": "Кажется, это и есть Краснокаменный штрек. Завален.",
  },
  {
    "key": "fen_cave_in.conversation_1kwj0v_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Его можно бомбами расчистить.",
  },
  {
    "key": "fen_cave_in.conversation_661ekz_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Мне, может, не стоит поощрять твою страсть к разрушению, но идея неплохая.",
  },
  {
    "key": "fen_cave_in.conversation_xdrduu_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ага, взрывчаточка!{format reset} Может, ты даже руки-ноги себе поотрываешь!",
  },
  {
    "key": "fen_cave_in.conversation_6c0vsm_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Зараза! Давай сначала попытаем счастья с той пневмошахтой, ладно?",
  },
  {
    "key": "mechanic.conversation_h5wj1m_text",
    "notes": "Speaker=Turtle Bucket Notes=Very nervous person",
    "value": "Я... Не хочу навязываться, но... эти {format nervous}землетрясения{format reset}немного пугают.",
  },
  {
    "key": "mechanic.conversation_o86kfe_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Но, э... Если это правда серьезно, то мэр бы, наверное, волновался сильнее.",
  },
  {
    "key": "mechanic.conversation_o2oiou_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Мэр говорит, что об этих {format nervous}землетрясениях{format reset} беспокоиться не стоит, так что... Наверное, он прав.",
  },
  {
    "key": "mechanic.conversation_h7ppy6_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э, привет...",
  },
  {
    "key": "mechanic.conversation_kg1mo1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* The light source is set in the middle of the chest.",
    "value": "Вижу, у тебя фонарь сломан.",
  },
  {
    "key": "mechanic.conversation_q3my9j_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Мне, э... кажется, что не стоит бродить в темноте, особенно когда тут эти {format nervous}обвалы{format reset}.",
  },
  {
    "key": "mechanic.conversation_ltmso8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "В общем, э... если тебе нужно в шахту, то... э... лучше бы {format highlight}починить твой фонарь{format reset}.",
  },
  {
    "key": "mechanic.conversation_9zjn4q_text",
    "notes": "Speaker=Turtle Bucket Notes=Workbench",
    "value": "Можешь использовать мою мастерскую... Если хочешь.",
  },
  {
    "key": "mechanic.conversation_izda31_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Можешь {format highlight}починить фонарь{format reset} в моей мастерской... Если хочешь.",
  },
  {
    "key": "mechanic.conversation_649j7z_text",
    "notes": "Speaker=Turtle Bucket Notes=Dorothys speed boots.",
    "value": "Э-э... Отличные ботинки.",
  },
  {
    "key": "mechanic.conversation_fjqq9f_text",
    "notes": "Speaker=Dorothy",
    "value": "Правда? Я их улучшила в одной машине под пустыней.",
  },
  {
    "key": "mechanic.conversation_v3f2hn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Дополнительная... э... беговая гидравлика... Очень ускоряет движение.",
  },
  {
    "key": "mechanic.conversation_qnv8df_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Модификаторы снаряжения на станциях - отличная вещь, правда?",
  },
  {
    "key": "mechanic.conversation_f9qput_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "То есть, э... вот. Их можно по всей шахте найти.",
  },
  {
    "key": "mechanic.conversation_ji4atj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Они, э.... очень... {format emph}очень старые{format reset}. Мы не знаем, кто их построил, но для нас они отлично работают.",
  },
  {
    "key": "mechanic.conversation_kn7n3g_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Со временем шахтеры построили вокруг них станции.",
  },
  {
    "key": "mechanic.conversation_w8uqp5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Про некоторые мы знаем, но, э... Шахта гораздо, {format emph}гораздо больше{format reset}, чем мы успели освоить.",
  },
  {
    "key": "mechanic.conversation_m5pbwk_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Мне приходилось читать о других станциях с интересным оборудованием, они, э... прячутся в шахтах, которых нет на карте.",
  },
  {
    "key": "mechanic.conversation_wad1be_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "То есть, э...",
  },
  {
    "key": "mechanic.conversation_apkmkg_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Ух ты, ты нашла бомбомет!",
  },
  {
    "key": "mechanic.conversation_qjmh35_text",
    "notes": "Speaker=Turtle Bucket Notes=This is techno jibberish, feel free to make up new stuff.",
    "value": "Трехпоршневая система обеспечивает {format singsong}плавность{format reset} скольжения по сифонной трубке.",
  },
  {
    "key": "mechanic.conversation_ua28gp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Стреляет самозакрепляющимися снарядами, которые перед детонацией прилипают к любой поверхности.",
  },
  {
    "key": "mechanic.conversation_saczrj_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The pressure bomb works with water.",
    "value": "Наверняка круто взрывается! Хи-хи...",
  },
  {
    "key": "mechanic.conversation_tz9y1l_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э... простите. Не стоило мне так... увлекаться.",
  },
  {
    "key": "mechanic.conversation_yxae4k_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "О, э... Ты добралась до камнеломной станции.",
  },
  {
    "key": "mechanic.conversation_rz6lrl_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The upgrade is a mechanical fist that works like a jack hammer.",
    "value": "Этот молоток продырявит даже самые твердые кирпичи.",
  },
  {
    "key": "mechanic.conversation_art1sv_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ты сможешь обследовать обратную сторону стены просто на раз-два.",
  },
  {
    "key": "mechanic.conversation_1ghl26_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "А еще тут можно улучшать расход топлива - и вот это все!",
  },
  {
    "key": "mechanic.conversation_a315z5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Модификация пневмоцилиндра дает повышенную скорость работы...",
  },
  {
    "key": "mechanic.conversation_lyy59m_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э, то есть, у него большой потенциал... вот.",
  },
  {
    "key": "mechanic.conversation_ornloo_text",
    "notes": "Speaker=Turtle Bucket Notes=See "Spelunker Station" in other document",
    "value": "{format singsong}Ничего себе!{format reset} У меня-то и сомнений не было, что спелеостанции конец!",
  },
  {
    "key": "mechanic.conversation_uo7wrd_text",
    "notes": "Speaker=Turtle Bucket Notes=The hook shot look like a grapling hook and is shot out of your arm",
    "value": "А ты раздобыла кошку!",
  },
  {
    "key": "mechanic.conversation_4x94pz_text",
    "notes": "Speaker=Turtle Bucket Notes="zip" as in fly or move fast",
    "value": "С этой штукой ты будешь летать по шахте, как {format emph}никогда{format reset} не летала.",
  },
  {
    "key": "mechanic.conversation_wt4pay_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Сможешь заглянуть в самые укромные уголки и самые узкие щели!",
  },
  {
    "key": "mechanic.conversation_jc96m9_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Шахты полны секретов и загадок, только знай находи и открывай.",
  },
  {
    "key": "mechanic.conversation_xxorzf_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "{format singsong}ПОТРЯСАЮЩЕ!{format reset} Это то, что я думаю?",
  },
  {
    "key": "mechanic.conversation_h0sfna_text",
    "notes": "Speaker=Turtle Bucket Notes=It's a falaming Pick Axe",
    "value": "Как! Как тебе удалось раздобыть пламенный топор?",
  },
  {
    "key": "mechanic.conversation_4p03fk_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Наверняка его прятали где-нибудь в восточном храме.",
  },
  {
    "key": "mechanic.conversation_7shcmp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Про него писали в каком-то из моих журналов Но что такое существует в реальности... Я просто {format emph}поверить не могу{format reset}!",
  },
  {
    "key": "mechanic.conversation_9e6rbj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "То есть... Очень здорово.",
  },
  {
    "key": "mechanic.conversation_8x0zgn_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* see Aeronaut Station in the other document",
    "value": "Прекрати! Только не говори мне, что была на аэростанции!",
  },
  {
    "key": "mechanic.conversation_gqdbky_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Она же где-то очень глубоко за пределами освоенной шахты.",
  },
  {
    "key": "mechanic.conversation_34ele3_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Даже в голову не приходило, что я однажды увижу настоящий реактивный ранец!",
  },
  {
    "key": "mechanic.conversation_vr5wop_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Просто отвал башки!",
  },
  {
    "key": "mechanic.conversation_0czv1r_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* just hammering home that the world is more open at this point.",
    "value": "С этой штукой сможешь всю шахту облазить. Ты исследуешь такие места, куда вообще невозможно было забраться.",
  },
  {
    "key": "mechanic.conversation_2bpv40_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* as in the old saying "the world is your oyster"",
    "value": "Эта шахта - просто золотая жила.",
  },
  {
    "key": "mechanic.conversation_6c8k38_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Думаю, я даже модификации для него могу придумать... Ну, если разрешишь...",
  },
  {
    "key": "mechanic.conversation_kddst5_text",
    "notes": "Speaker=Turtle Bucket Notes=This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    "value": "Эти... джунгли в шахте... В городе только про них и говорят.",
  },
  {
    "key": "mechanic.conversation_1ibifo_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Надеюсь, они не разрастутся до поверхности. Э... Даже подходить к этим жутким колючкам страшно.",
  },
  {
    "key": "mechanic.conversation_qxg2dp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Вот будь у тебя подходящий... ну... топор или что... Ты бы эти растения в куски порубила.",
  },
  {
    "key": "mechanic.conversation_jn0ayb_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Жаль, что на старых станциях ничего такого нет...",
  },
  {
    "key": "mechanic.conversation_evptsm_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э... надеюсь, эти {format nervous}странные растения{format reset} не доберутся до города.",
  },
  {
    "key": "mechanic.conversation_d2k8hv_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "М-м... Не хочется беспокоить профессора...",
  },
  {
    "key": "mechanic.conversation_zfm1c4_text",
    "notes": "Speaker=Turtle Bucket Notes=The rocket is a space rocket.",
    "value": "Но может, стоит попросить разрешения заглянуть в ракету? Посмотреть, как она устроена.",
  },
  {
    "key": "mechanic.conversation_js74jz_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Она крутая, правда же?",
  },
  {
    "key": "mechanic.conversation_bufmli_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Мне... ужасно хотелось бы заглянуть в эту ракету...",
  },
  {
    "key": "mechanic.conversation_yxbbjn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ракеты - это круто!",
  },
  {
    "key": "mechanic.conversation_1ovqzn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* rephrased this line to work in more situations.",
    "value": "Можешь чинить или улучшать снаряжение в моей мастерской... э, в любое время, да.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_4dhtk4_text",
    "notes": "Speaker=Fen",
    "value": "Да, да! Взорвем ее {format singsong}вдр-р-ребезги!{format reset}",
  },
  {
    "key": "fen_cave_in_bomb.conversation_eff23g_text",
    "notes": "Speaker=Dorothy",
    "value": "Тебе явно стоит с кем-нибудь поговорить насчет твоей мании разрушения.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_oxrw0l_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ну вот сейчас я с тобой говорю. Да я вообще все время говорю о разрушениях.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_nmb2rq_text",
    "notes": "Speaker=Dorothy",
    "value": "Угу...",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_t0dmfu_text",
    "notes": "Speaker=Fen Notes=*new* This message is shown when the player have unused upgrade-cogs.",
    "value": "Зачем ты копишь все эти шестеренки {image cogs_small}, как бешеный бот-хомяк?",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_w2gq2j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Иди уже в мастерскую да пусти их в дело!",
  },
  {
    "key": "rosie.conversation_enxhfq_text",
    "notes": "Speaker=Dorothy Notes=*format* *new* rephrased this line",
    "value": "Ого! Такого мы еще не видели!",
  },
  {
    "key": "rosie.conversation_dsse8r_text",
    "notes": "Speaker=Rosie",
    "value": "Спасибо. Я построила Оазис, чтобы собрать своих. Защитить их!",
  },
  {
    "key": "rosie.conversation_fu699v_text",
    "notes": "Speaker=Rosie",
    "value": "Пока им тут хорошо и спокойно, они остаются. В безопасности.",
  },
  {
    "key": "rosie.conversation_hx3qqt_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Ну, так было, пока твой друг не устроил тут эти землетрясения.",
  },
  {
    "key": "rosie.conversation_6o8eta_text",
    "notes": "Speaker=Dorothy",
    "value": "Как мог Расти такое сотворить? Он {format emph}жизнью рисковал{format reset}, чтобы нас от Вектрона спасти.",
  },
  {
    "key": "rosie.conversation_x9aify_text",
    "notes": "Speaker=Rosie",
    "value": "А ты его действительно хорошо знала? Может, борьба с этим светящимся монстром изменила его?",
  },
  {
    "key": "rosie.conversation_y8f4q2_text",
    "notes": "Speaker=Fen",
    "value": "Вектрон такой... {format nervous}Он нас меняет.{format reset}",
  },
  {
    "key": "rosie.conversation_qjs5hn_text",
    "notes": "Speaker=Rosie",
    "value": "Он явился сюда и заявил, что обрушит на нас всю шахту. Мы его еле сдержали!",
  },
  {
    "key": "rosie.conversation_mbjnhf_text",
    "notes": "Speaker=Dorothy",
    "value": "Мне жаль, я... Мне бы только найти его... Поговорить с ним...",
  },
  {
    "key": "rosie.conversation_7sza3z_text",
    "notes": "Speaker=Rosie",
    "value": "Я понимаю, ты верна ему, но если бы ты нашла причину землетрясений, ты бы сама все узнала.",
  },
  {
    "key": "rosie.conversation_hihmd6_text",
    "notes": "Speaker=Rosie Notes=*new* rephrasing and added an emphasis",
    "value": "Ты могла бы остановить землетрясения. А я помогу {format emph}тебе{format reset}, чем только смогу.",
  },
  {
    "key": "rosie.conversation_47pkq7_text",
    "notes": "Speaker=Rosie Notes=*new* added a bit at the end to this one.",
    "value": "{format highlight}Иди на станцию{format reset}, я ее как склад использую. Все тамошнее старье, машины и инструменты - к твоим услугам.",
  },
  {
    "key": "rosie.conversation_m6cj0e_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Иди на станцию{format reset} и бери, что хочешь.",
  },
  {
    "key": "rosie.conversation_4vzxih_text",
    "notes": "Speaker=Rosie",
    "value": "Рада, что тебе у меня что-то пригодилось. Ну что, готова?",
  },
  {
    "key": "rosie.conversation_f1jnf5_text",
    "notes": "Speaker=Rosie",
    "value": "Я тебя попрошу разузнать, что вызывает эти землетрясения, и остановить их.",
  },
  {
    "key": "rosie.conversation_ln5j60_text",
    "notes": "Speaker=Rosie",
    "value": "Помоги мне защитить мой народ! Я из сил выбиваюсь, чтобы они меня хотя бы слушали.",
  },
  {
    "key": "rosie.conversation_u5463y_text",
    "notes": "Speaker=Rosie",
    "value": "Больше я про землетрясения ничего не знаю, но может, ты найдешь наверху {format highlight}умного бота{format reset}?",
  },
  {
    "key": "rosie.conversation_dohwhw_text",
    "notes": "Speaker=Dorothy",
    "value": "И может, я пойму наконец, куда пропал Расти!",
  },
  {
    "key": "rosie.conversation_77fdqq_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Отыщи наверху умного робота.{format reset}",
  },
  {
    "key": "rosie.conversation_0jmccn_text",
    "notes": "Speaker=Rosie",
    "value": "Может, тебе объяснят, из-за чего земля трясется.",
  },
  {
    "key": "rosie.conversation_xpdrbe_text",
    "notes": "Speaker=Dorothy",
    "value": "Я выяснила, что последнее землетрясение вызвало что-то в восточном храме.",
  },
  {
    "key": "rosie.conversation_oqlaq7_text",
    "notes": "Speaker=Rosie",
    "value": "Тамошняя секта помешалась на разрушении.",
  },
  {
    "key": "rosie.conversation_1kkqf6_text",
    "notes": "Speaker=Fen",
    "value": "Да, знаю я этих ребят.",
  },
  {
    "key": "rosie.conversation_v0wzpo_text",
    "notes": "Speaker=Rosie",
    "value": "Они наверняка стеной встанут за все, что относится к землетрясениям.",
  },
  {
    "key": "rosie.conversation_nytcr5_text",
    "notes": "Speaker=Rosie",
    "value": "Тебе нужно {format highlight}обыскать храм{format reset} и найти причину землетрясений.",
  },
  {
    "key": "rosie.conversation_x2gmu8_text",
    "notes": "Speaker=Rosie",
    "value": "Тебе нужно {format highlight}обыскать храм{format reset} и найти причину землетрясений.",
  },
  {
    "key": "rosie.conversation_ly3hpt_text",
    "notes": "Speaker=Dorothy",
    "value": "Ты была права, Рози. {format highlight}Расти втянули{format reset} во все это.",
  },
  {
    "key": "rosie.conversation_mp86jk_text",
    "notes": "Speaker=Rosie",
    "value": "Так ты поняла... {format emph}Он злой!{format reset}",
  },
  {
    "key": "rosie.conversation_26ewef_text",
    "notes": "Speaker=Dorothy",
    "value": "Он построил какую-то машину конца света. Она-то и трясет землю.",
  },
  {
    "key": "rosie.conversation_r154n3_text",
    "notes": "Speaker=Rosie",
    "value": "Нужно {format highlight}уничтожить устройство!{format reset} Я-то за своих тревожусь, но эта штука угрожает всем.",
  },
  {
    "key": "rosie.conversation_mlv5kh_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Чего мы ждем? Пора взрывать!",
  },
  {
    "key": "rosie.conversation_607awg_text",
    "notes": "Speaker=Rosie",
    "value": "У тебя есть шанс остановить землетрясения. {format highlight}Уничтожь машину рока!{format reset}",
  },
  {
    "key": "rosie.conversation_ck3lck_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Нам удалось обезвредить ту штуку, что вызывала землетрясения.",
  },
  {
    "key": "rosie.conversation_kd9cyi_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Отлично! Мы молодцы, мы справились!",
  },
  {
    "key": "rosie.conversation_mw42bj_text",
    "notes": "Speaker=Fen",
    "value": "Да, круто!",
  },
  {
    "key": "rosie.conversation_3beotd_text",
    "notes": "Speaker=Dorothy",
    "value": "А вот Расти пока не видать...",
  },
  {
    "key": "rosie.conversation_akywya_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Хм... Если та штука под названием Вектрон его изменила, может, он там, внизу? В его остатках.",
  },
  {
    "key": "rosie.conversation_rwy0gr_text",
    "notes": "Speaker=Dorothy",
    "value": "Эта машина рока {format emph}и правда{format reset} частично состояла из технологий Вектрона...",
  },
  {
    "key": "rosie.conversation_ucjkci_text",
    "notes": "Speaker=Fen",
    "value": "Ой, нет, я знаю, о чем ты думаешь! Я не хочу {format nervous}туда возвращаться!{format reset}",
  },
  {
    "key": "rosie.conversation_7irted_text",
    "notes": "Speaker=Fen",
    "value": "Ты не знаешь, каково там. Когда у тебя своей воли нет.",
  },
  {
    "key": "rosie.conversation_21ym6y_text",
    "notes": "Speaker=Dorothy",
    "value": "Я уже столько прошла... Я не могу все бросить. Фен, ты мне просто вход покажи...",
  },
  {
    "key": "rosie.conversation_oredyt_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Почему? Почему нельзя просто пойти и взорвать что-нибудь?",
  },
  {
    "key": "rosie.conversation_tc3nlv_text",
    "notes": "Speaker=Dorothy Notes=*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    "value": "Он одолел Вектрона. Расти спас нас...",
  },
  {
    "key": "rosie.conversation_0xyfid_text",
    "notes": "Speaker=Fen",
    "value": "...",
  },
  {
    "key": "rosie.conversation_uvs1vb_text",
    "notes": "Speaker=Fen",
    "value": "Я тебе помогу. Но когда ты {format highlight}войдешь в Вектрон{format reset}, я тебе больше не помогаю.",
  },
  {
    "key": "rosie.conversation_pq0jjj_text",
    "notes": "Speaker=Rosie",
    "value": "Чтобы найти Расти, тебе нужно {format highlight}войти в Вектрон{format reset}.",
  },
  {
    "key": "rosie.conversation_vcgjsk_text",
    "notes": "Speaker=Fen",
    "value": "Может, лучше разбомбим чего-нибудь, а?",
  },
  {
    "key": "rosie.conversation_3bw741_text",
    "notes": "Speaker=Rosie",
    "value": "Ты {format emph}вернулась{format reset}...",
  },
  {
    "key": "rosie.conversation_6r8y8d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Да... Но следов Расти я там не нашла.",
  },
  {
    "key": "rosie.conversation_jdhos3_text",
    "notes": "Speaker=Fen",
    "value": "Зато мы выяснили, что {format emph}есть и другие машины рока{format reset}.",
  },
  {
    "key": "rosie.conversation_hlfgz1_text",
    "notes": "Speaker=Rosie",
    "value": "Ну конечно! Он бы не стал класть все яйца в одну корзину.",
  },
  {
    "key": "rosie.conversation_kix6a6_text",
    "notes": "Speaker=Rosie",
    "value": "Так не годится. Нужно {format emph}найти все машины{format reset}! Иначе нам всем грозит опасность.",
  },
  {
    "key": "rosie.conversation_58f8ga_text",
    "notes": "Speaker=Fen Notes=*new* added "Dorothy"",
    "value": "Дороти... Я уже знаю, где они. Они так ясно ощущались. К ним тянется энергия.",
  },
  {
    "key": "rosie.conversation_diuokv_text",
    "notes": "Speaker=Fen",
    "value": "Одна из них {format emph}в храме, где мы встретились.{format reset}",
  },
  {
    "key": "rosie.conversation_5npqb6_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Вторая - в тех странных {format emph}подземных джунглях{format reset}, мимо которых мы проходили по пути сюда.",
  },
  {
    "key": "rosie.conversation_3v2hek_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "И наконец, есть еще одна, {format emph}в восточном храме{format reset}.",
  },
  {
    "key": "rosie.conversation_k5nk0l_text",
    "notes": "Speaker=Dorothy Notes=*new* added "then" moved the line",
    "value": "Ну что, пошли {format highlight}взорвем эти устройства{format reset}!",
  },
  {
    "key": "rosie.conversation_1alf3v_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Мир шахт велик, он полон тайн и опасностей. И кратчайший путь не всегда лучший.",
  },
  {
    "key": "rosie.conversation_b6r8b9_text",
    "notes": "Speaker=Dorothy Notes=*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    "value": "Этот реактивный двигатель поможет нам исследовать шахту быстрее.",
  },
  {
    "key": "rosie.conversation_p2pe6o_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Да, мы сможем летать повсюду, выкапывать секреты и взрывать все подряд! Погнали!",
  },
  {
    "key": "rosie.conversation_jglhmm_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Нужно найти и {format highlight}уничтожить оставшиеся машины{format reset}.",
  },
  {
    "key": "rosie.conversation_mqmqfa_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Ты уже побывала в храмах и нашла оборудование, которое поможет тебе в поисках.",
  },
  {
    "key": "rosie.conversation_v81wm2_text",
    "notes": "Speaker=Rosie",
    "value": "На самом деле я не очень много знаю о загадочных джунглях.",
  },
  {
    "key": "rosie.conversation_ckclse_text",
    "notes": "Speaker=Dorothy",
    "value": "Мы разрушили еще одно устройство Расти.",
  },
  {
    "key": "rosie.conversation_wzvouk_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Да, было круто!{format reset}",
  },
  {
    "key": "rosie.conversation_yb1vmx_text",
    "notes": "Speaker=Rosie",
    "value": "Он их хитро спрятал во всей шахте.",
  },
  {
    "key": "rosie.conversation_hw5xmd_text",
    "notes": "Speaker=Rosie",
    "value": "Добраться до остальных будет непросто, хоть ты и знаешь, где они.",
  },
  {
    "key": "rosie.conversation_oeqkzs_text",
    "notes": "Speaker=Rosie",
    "value": "Хотела бы я помочь больше, но мне надо присматривать за моими ребятами.",
  },
  {
    "key": "rosie.conversation_1wlu3i_text",
    "notes": "Speaker=Rosie",
    "value": "Думаю, некоторые тут собираются в шахту вернуться.",
  },
  {
    "key": "rosie.conversation_y85nbk_text",
    "notes": "Speaker=Fen",
    "value": "Тогда пошли {format highlight}грохнем остальные машины{format reset}!",
  },
  {
    "key": "rosie.conversation_o9wzoz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Надеюсь, ты скоро найдешь своего друга и остановишь его раз и навсегда.",
  },
  {
    "key": "rosie.conversation_g8unqh_text",
    "notes": "Speaker=Rosie",
    "value": "Пожалуйста, {format highlight}уничтожь остальные устройства{format reset}. Не знаю, сколько я еще смогу сдерживать моих ребят.",
  },
  {
    "key": "rosie.conversation_hinklt_text",
    "notes": "Speaker=Dorothy",
    "value": "Чувствовала толчки, когда мы разрушили устройство?",
  },
  {
    "key": "rosie.conversation_7bjdrx_text",
    "notes": "Speaker=Rosie",
    "value": "Да, мои тут переполох устроили. Их тряска просто бесит.",
  },
  {
    "key": "rosie.conversation_ot1xb4_text",
    "notes": "Speaker=Rosie",
    "value": "Я их еще не пересчитала. Надеюсь, все тут.",
  },
  {
    "key": "rosie.conversation_8vqdk5_text",
    "notes": "Speaker=Dorothy Notes=*new* removed a "yes"",
    "value": "Да, осталось еще одно устройство, с ним тоже нужно разобраться.",
  },
  {
    "key": "rosie.conversation_1t4jq7_text",
    "notes": "Speaker=Rosie",
    "value": "Когда эти страшные штуки исчезнут, нам всем станет спокойнее.",
  },
  {
    "key": "rosie.conversation_5hrt2a_text",
    "notes": "Speaker=Rosie",
    "value": "Пожалуйста, {format highlight}уничтожь последнюю машину{format reset}. Пока она цела, мы все в опасности!",
  },
  {
    "key": "rosie.conversation_2jw2v2_text",
    "notes": "Speaker=Rosie",
    "value": "Ты не такая, как остальные боты.",
  },
  {
    "key": "rosie.conversation_pf575r_text",
    "notes": "Speaker=Rosie",
    "value": "Не думала, что встречу робота, который мне понравится.",
  },
  {
    "key": "used_teleporter.conversation_tb8lha_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Эй! Я не давал разрешения на разблокировку лифтов!",
  },
  {
    "key": "used_teleporter.conversation_c3vudp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Челюсть прикрути! Лифты - лучший способ перемещаться по шахте.",
  },
  {
    "key": "used_teleporter.conversation_of6kl3_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Краснокаменный штрек завалило из-за землетрясений.",
  },
  {
    "key": "used_teleporter.conversation_p4u169_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ты не докажешь, что это землетрясения. Это что угодно могло быть!",
  },
  {
    "key": "used_teleporter.conversation_wr7t16_text",
    "notes": "Speaker=Dorothy",
    "value": "Ну, так или иначе, мне нужна взрывчатка, чтобы его расчистить.",
  },
  {
    "key": "used_teleporter.conversation_ljkhuj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ты наверняка {format highlight}найдешь взрывчатку{format reset} возле взрывной станции.",
  },
  {
    "key": "used_teleporter.conversation_kf7hxd_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Просто возьми чуток восточнее, когда будешь спускаться в следующий раз. Найдешь без труда.",
  },
  {
    "key": "used_teleporter.conversation_fsgerc_text",
    "notes": "Speaker=Dorothy",
    "value": "Так или иначе, я хочу добыть взрывчатки, чтобы его расчистить.",
  },
  {
    "key": "used_teleporter.conversation_atnqc9_text",
    "notes": "Speaker=Ma Yonker",
    "value": "О, я смотрю, кто-то побывал на взрывной станции. Теперь ты сможешь {format highlight}расчистить штрек{format reset}, детка!",
  },
  {
    "key": "hub_guard_hurt.conversation_7mti7b_text",
    "notes": "Speaker=Schwifty Shawn",
    "value": "{format nervous}АЙ!{format reset}",
  },
  {
    "key": "hub_guard_woke.conversation_bg1gtj_text",
    "notes": "Speaker=Schwifty Shawn Notes=*new* changed a ) to a }",
    "value": "{format nervous}...а?{format reset}",
  },
  {
    "key": "welcome_to_the_hub.conversation_5yt2bx_text",
    "notes": "Speaker=Fen",
    "value": "Подкрепление! Грохни обоих, а то их больше станет!",
  },
  {
    "key": "welcome_to_the_hub.conversation_0y97x7_text",
    "notes": "Speaker=Rosie",
    "value": "Опять землетрясение... И новый злобный бот. Будь начеку, Шон!",
  },
  {
    "key": "welcome_to_the_hub.conversation_swc23b_text",
    "notes": "Speaker=Dorothy",
    "value": "Ты говорить умеешь?!",
  },
  {
    "key": "welcome_to_the_hub.conversation_sa7wlq_text",
    "notes": "Speaker=Rosie",
    "value": "А с чего бы мне не говорить? Эй, робот, а ты раньше {format emph}пыталась{format reset} с кем-нибудь из нас поговорить?",
  },
  {
    "key": "welcome_to_the_hub.conversation_h9pnyw_text",
    "notes": "Speaker=Dorothy",
    "value": "Ты права. Прости. Я сюда не драться пришла, я ищу пропавшего друга.",
  },
  {
    "key": "welcome_to_the_hub.conversation_mkx6nq_text",
    "notes": "Speaker=Rosie",
    "value": "Это такая коричневая черепашка, похожая на консервную банку?",
  },
  {
    "key": "welcome_to_the_hub.conversation_jignph_text",
    "notes": "Speaker=Dorothy",
    "value": "Да! Вы его видели! Что с ним случилось? Где он?",
  },
  {
    "key": "welcome_to_the_hub.conversation_ryszmg_text",
    "notes": "Speaker=Rosie",
    "value": "Хм... может, это глупо впускать сюда робота, но ты вроде правду говоришь.",
  },
  {
    "key": "welcome_to_the_hub.conversation_2r5k9z_text",
    "notes": "Speaker=Rosie",
    "value": "Я Рози Заходи, {format highlight}поговорим внутри{format reset}. Расскажу, что знаю.",
  },
  {
    "key": "floaty.conversation_ty7umo_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Тс-с-с... Ты шумишь прям как Рози.",
  },
  {
    "key": "floaty.conversation_35muig_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Тс-с-с...",
  },
  {
    "key": "floaty.conversation_trxx9s_text",
    "notes": "Speaker=Cleo Johnson Notes=She has a fishing pole",
    "value": "Тс-с-с... Ты их распугаешь...",
  },
  {
    "key": "floaty.conversation_bcfgsy_text",
    "notes": "Speaker=Dorothy",
    "value": "Без обид, но по-моему рыба в этой грязи не выживет.",
  },
  {
    "key": "floaty.conversation_ufdh71_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Рыба? Какая рыба? Это ботинки мои. Скользкие, убегают все время.",
  },
  {
    "key": "floaty.conversation_x3mdff_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Клео хочет ботиночки, боти-боти-боти...",
  },
  {
    "key": "floaty.conversation_6wq728_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* run offt is old 20's hillbilly-talk.",
    "value": "Боти-боти! Плывите Клео на ножки, Клео хочет побегать!",
  },
  {
    "key": "floaty.conversation_vrn5ho_text",
    "notes": "Speaker=Dorothy",
    "value": "По-моему, ботинки не плавают...",
  },
  {
    "key": "floaty.conversation_syk9tk_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Ничего-то ты не знаешь про боти, вот что Клео думает.",
  },
  {
    "key": "floaty.conversation_ejlda7_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Как они, по-твоему, оказались тут в бузе?",
  },
  {
    "key": "floaty.conversation_9ssddv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Чего это, не плавают! Конечно, плавают.",
  },
  {
    "key": "floaty.conversation_f5fe22_text",
    "notes": "Speaker=Dorothy",
    "value": "Ну что, приплыли ботинки?",
  },
  {
    "key": "floaty.conversation_uwbwbt_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* Speachimpediment: "Dry mouf"="dry mouth"",
    "value": "А! Надоели ботинки. У Клео в горле пересохло, Клео больше не хочет ждать.",
  },
  {
    "key": "floaty.conversation_7dil67_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "У Клео планы. Клео отсюда убежит и больше не будет ловить ботинки.",
  },
  {
    "key": "floaty.conversation_e7vvqa_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно...",
  },
  {
    "key": "floaty.conversation_mkd1g9_text",
    "notes": "Speaker=Cleo Johnson Notes=You dumb bucket thing, Cleo should kick you before say more stupid things.",
    "value": "Тупое ведерко! Клео тебе щас как наподдаст, чтоб глупостей не говорила.",
  },
  {
    "key": "floaty.conversation_7c453w_text",
    "notes": "Speaker=Cleo Johnson Notes=Pay attention to the translation of "moon juice"",
    "value": "Клео скоро уйдет, тут буза кончается.",
  },
  {
    "key": "floaty.conversation_nny1i7_text",
    "notes": "Speaker=Cleo Johnson Notes=thursty",
    "value": "Клео питьки хочет.",
  },
  {
    "key": "floaty.conversation_atofqv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Бо-оть, боть-боть-боть!",
  },
  {
    "key": "gran.conversation_dk7b1d_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Моя здоровенная дурында впустила робота? Она еще тупее, чем кажется!",
  },
  {
    "key": "gran.conversation_0fdyik_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Тебе что тут надо, жестянка?",
  },
  {
    "key": "gran.conversation_xx02dp_text",
    "notes": "Speaker=Dorothy",
    "value": "Рози пригласила меня поговорить.",
  },
  {
    "key": "gran.conversation_qvnh5f_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ну да, это на нее похоже, на мою дочку-мутанта. Здоровая деваха, а жестянку раздавить не может",
  },
  {
    "key": "gran.conversation_n9fykw_text",
    "notes": "Speaker=Dorothy",
    "value": "Эй, это не очень вежливо.",
  },
  {
    "key": "gran.conversation_mypcv4_text",
    "notes": "Speaker=Dynomyte Harriet Notes=*new* rephrased. Boom sticks here are sticks of dynamite",
    "value": "А что еще делать с шашками?",
  },
  {
    "key": "gran.conversation_e6z5ja_text",
    "notes": "Speaker=Fen",
    "value": "Мне нравится это мясо.",
  },
  {
    "key": "gran.conversation_3zke2l_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Думаешь, сколько шашек надо на робота?",
  },
  {
    "key": "gran.conversation_a9cchj_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Не хочу, чтоб тут жестянки шастали.",
  },
  {
    "key": "gran.conversation_9svalt_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ей надо было тебя грохнуть, а не впускать.",
  },
  {
    "key": "gran.conversation_3su3ui_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "В старое доброе время шахты были наши. А жестянок дурацких мы взрывали.",
  },
  {
    "key": "gran.conversation_oza28i_text",
    "notes": "Speaker=Fen",
    "value": "Это мясо все интересней и интересней!",
  },
  {
    "key": "gran.conversation_yrhik2_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Берегись, жестюха!",
  },
  {
    "key": "gran.conversation_ihr9we_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Достало шаркать тут тапками.",
  },
  {
    "key": "gran.conversation_agybew_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Пора повылазить отсюда и повзрывать эти землетрясения. И лес этот тоже.",
  },
  {
    "key": "gran.conversation_nvv14n_text",
    "notes": "Speaker=Dynomyte Harriet Notes=Pay attention to translation of Moon Juice",
    "value": "Щас вот глотну только еще чуток бузы - и свалю.",
  },
  {
    "key": "gran.conversation_ezltzc_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "А как насчет шашки вместе склеить? Сунуть их куда надо - и никаких землетрясений больше!",
  },
  {
    "key": "gran.conversation_2h242j_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Отвали! Еще шашки на тебя тратить!",
  },
  {
    "key": "helpfulhelen.conversation_146h2g_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_w42y9y_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Уйди... Брысь отсюда, банка консервная!",
  },
  {
    "key": "helpfulhelen.conversation_lbsxjr_text",
    "notes": "Speaker=Dorothy",
    "value": "Я не опасная. Я просто хотела...",
  },
  {
    "key": "helpfulhelen.conversation_76kde3_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_nilvvh_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно... Ухожу!",
  },
  {
    "key": "helpfulhelen.conversation_nrvcc5_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed all-caps",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_na5ijp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Я хорошо режу роботов, знаешь ли.",
  },
  {
    "key": "helpfulhelen.conversation_t4gyc9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Как раз на той неделе одного побила.",
  },
  {
    "key": "helpfulhelen.conversation_8z4duw_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "А на мне ни царапины. Просто руку пришлось отрастить заново.",
  },
  {
    "key": "helpfulhelen.conversation_68xyfp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "К счастью, не ту, которой я обычно режу.",
  },
  {
    "key": "helpfulhelen.conversation_4tb6xl_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_mfx4dl_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Да, я крошила роботов на арене.",
  },
  {
    "key": "helpfulhelen.conversation_2z93th_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed "That"",
    "value": "Рози против, чтобы я ходила в шахту и резала всех, кто попадется.",
  },
  {
    "key": "helpfulhelen.conversation_2r5nu3_text",
    "notes": "Speaker=Dorothy",
    "value": "Правильно делает.",
  },
  {
    "key": "helpfulhelen.conversation_10fkd9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Но мне нравится резать!",
  },
  {
    "key": "helpfulhelen.conversation_sp7pdd_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_6iq52s_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Люблю резать.",
  },
  {
    "key": "helpfulhelen.conversation_1su49z_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed the last "left"",
    "value": "Мечтаю бегать по шахтам и резать, бегать и резать!",
  },
  {
    "key": "helpfulhelen.conversation_azc2px_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно...",
  },
  {
    "key": "helpfulhelen.conversation_14e8qj_text",
    "notes": "Speaker=Stabby Helen Notes=*new* changed right to left",
    "value": "Да, резать ровно и ладно!",
  },
  {
    "key": "helpfulhelen.conversation_cu3ase_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_5wwgu9_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "helpfulhelen.conversation_rnl3im_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Хочу в шахту - и всех порезать!",
  },
  {
    "key": "helpfulhelen.conversation_2kxxoa_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Вжик-вжик-вжик!",
  },
  {
    "key": "sign_shiver.conversation_iyd9iu_text",
    "notes": "Speaker=Dorothy",
    "value": ""ОСТОРОЖНО! Землетрясения! За подробной информацией обратитесь к мэру Эль Макино."",
  },
  {
    "key": "sign_miners_wanted.conversation_jn4gij_text",
    "notes": "Speaker=Dorothy",
    "value": ""Требуются шахтеры! Следуйте далее на восток к Эль Макино - и откопайте свое счастье!"",
  },
  {
    "key": "fen_on_shiners.conversation_04wf3d_text",
    "notes": "Speaker=Dorothy",
    "value": "Никогда раньше не видела говорящего бомжа. Обычно они только бушуют и дерутся.",
  },
  {
    "key": "fen_on_shiners.conversation_mlu9ml_text",
    "notes": "Speaker=Fen",
    "value": "Угу, а тут разговоры. Скука!",
  },
  {
    "key": "fen_on_shiners.conversation_mcuc1c_text",
    "notes": "Speaker=Dorothy Notes=*new* removed and, added this",
    "value": "Надо {format highlight}поговорить с этой Рози{format reset}. Может, она знает, где Расти.",
  },
  {
    "key": "guarding_hub.conversation_z2w2u3_text",
    "notes": "Speaker=Schwifty Shawn Notes=*format* *new* also removed the line break (
}",
    "value": "Э-э-эй! Сссстый, куда прешь?",
  },
  {
    "key": "guarding_hub.conversation_n2ebi3_text",
    "notes": "Speaker=Fen",
    "value": "Фу, прибей эту штуку!",
  },
  {
    "key": "guarding_hub.conversation_kljpda_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Класс! Опять землетрясение!{format reset}",
  },
  {
    "key": "dorothy_intro.conversation_t7sxdc_text",
    "notes": "Speaker=Dorothy",
    "value": "Куда же ты {format emph}пропал{format reset}, Расти?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_vmz2v5_text",
    "notes": "Speaker=Fen",
    "value": "Вот он. Вход в Вектрон.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_iupd4b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ну что, войдем в эту штуку?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_bbcmp1_text",
    "notes": "Speaker=Fen Notes=*format* *new*'",
    "value": "Говорю тебе, я {format emph}туда{format reset} не пойду. Не хочу...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rh2uj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Да и не могу на самом деле. Только не через {format emph}такой{format reset} портал.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_pkxjfo_text",
    "notes": "Speaker=Fen",
    "value": "Но мы договорились, что я отведу {format emph}тебя{format reset} туда...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_emqhdd_text",
    "notes": "Speaker=Dorothy",
    "value": "Если есть шанс, что Расти там, то я пойду.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rkegt_text",
    "notes": "Speaker=Fen",
    "value": "Ну, тогда иди...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_qrn9qn_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_bye",
    "value": "Ты там будешь одна и без моей карты.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_sfgslu_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_by",
    "value": "Выбираться сама будешь.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_j9uqnv_text",
    "notes": "Speaker=Fen",
    "value": "Ты точно хочешь?",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_69953l_text",
    "notes": "Speaker=Fen Notes=*format* *new*",
    "value": "Ладно...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_yjswup_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Поехали...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_uwxfmo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Да, {format emph}я{format reset} не собираюсь тебе руки выкручивать.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_91l718_text",
    "notes": "Speaker=Dorothy",
    "value": "Я выберусь оттуда и найду тебя.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vmzz9y_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_u6n77q_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Если там что-то шевельнется, беги оттуда. Беги изо всех сил...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vctaoa_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "exiting_vectron_firsttime_01.conversation_sp4sbx_text",
    "notes": "Speaker=Dorothy",
    "value": "Фен?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_rj6ww8_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "ФЕН?!",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_ad0u27_text",
    "notes": "Speaker=vectron_teleporter Notes=*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    "value": "Фен? Я... Я Фен.",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_1ajm6u_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Дороти?",
  },
  {
    "key": "run_away_with_rusty_1.conversation_wgoby1_text",
    "notes": "Speaker=Dorothy",
    "value": "РАСТИ!",
  },
  {
    "key": "rosie_boss_intro_01.conversation_r5a8b8_text",
    "notes": "Speaker=Dorothy",
    "value": "РАСТИ?!",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_pgjtz4_text",
    "notes": "Speaker=Dorothy",
    "value": "Давай, Фен! Надо спешить!",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_uzk2jn_text",
    "notes": "Speaker=Fen",
    "value": "Так нам в город {format nervous}вернуться{format reset}...",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_5rvneb_text",
    "notes": "Speaker=Fen Notes=*new* changed the format to affect more words",
    "value": "Но я могу вовремя вытащить {format emph}вас обоих{format reset}.",
  },
  {
    "key": "sign_thehub.conversation_32yflg_text",
    "notes": "Speaker=Dorothy",
    "value": ""ЗАКРЫТО! ИДИТЕ ДОМОЙ!"",
  },
  {
    "key": "fen_its_gonna_blow.conversation_ghi2wb_text",
    "notes": "Speaker=Fen",
    "value": "Эй, тут совсем {format nervous}дурдом!{format reset}",
  },
  {
    "key": "fen_its_gonna_blow.conversation_8xsftw_text",
    "notes": "Speaker=Fen Notes=*new* changed formated text from highlight to emph",
    "value": "Сваливаем отсюда! {format emph}Бегом!{format reset}",
  },
  {
    "key": "run_away_with_rusty_3.conversation_4v2csa_text",
    "notes": "Speaker=Dorothy",
    "value": "Ракета профессора Шерман!",
  },
  {
    "key": "run_away_with_rusty_3.conversation_izxx5d_text",
    "notes": "Speaker=Dorothy",
    "value": "Нужно возвращаться в город!",
  },
  {
    "key": "easteregg_ending.conversation_x1pswz_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Давай же! {format emph}Быстрее!{format reset}",
  },
  {
    "key": "easteregg_ending.conversation_bfup2f_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Думать некогда!",
  },
  {
    "key": "easteregg_ending.conversation_2ez9yy_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Давай!",
  },
  {
    "key": "easteregg_ending.conversation_kuytvd_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Хватит в героя играть!",
  },
  {
    "key": "fen_ending_goodbye.conversation_qsa1um_text",
    "value": "До встречи, Дотти...",
  },
  {
    "key": "rocketeer.conversation_hwmfh6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Жаль, что мэр Йонкер не прислушивается к голосу разума.",
  },
  {
    "key": "rocketeer.conversation_d0ozct_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Их жизнь на кону, а они ничего слушать не хотят.",
  },
  {
    "key": "rocketeer.conversation_bdyzc2_text",
    "notes": "Speaker=Professor Sherman",
    "value": "В этих землетрясениях есть что-то очень странное.",
  },
  {
    "key": "rocketeer.conversation_tjv7fp_text",
    "notes": "Speaker=Dorothy Notes=*new* changes since earlier version could be off in some instances.",
    "value": "Ничего себе! Какая классная ракета.",
  },
  {
    "key": "rocketeer.conversation_t09utv_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased to work with new version of above line",
    "value": "Ну, поскольку мэр сейчас проявляет поразительное равнодушие к науке, мне пришлось придумать план на случай ЧП.",
  },
  {
    "key": "rocketeer.conversation_f7plgb_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Мой сейсмограф показывает, что с этими землетрясениями что-то явно не так, видишь ли.",
  },
  {
    "key": "rocketeer.conversation_yhfxkq_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Наша шахта вырыта как раз по линии тектонического нарушения. Пара сильных толчков - и городу конец!",
  },
  {
    "key": "rocketeer.conversation_k00t1f_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Надеюсь, я успею подготовить корабль, пока не поздно.",
  },
  {
    "key": "rocketeer.conversation_220si9_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Новые землетрясения надо тщательно изучить. Это крайне важно.",
  },
  {
    "key": "rocketeer.conversation_yd21lh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Понимаешь, здесь, у нас под ногами, соединяются две тектонические плиты.",
  },
  {
    "key": "rocketeer.conversation_yhhdlm_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Город стоит на горе, которая образовалась миллионы лет назад в результате их столкновения.",
  },
  {
    "key": "rocketeer.conversation_jd18od_text",
    "notes": "Speaker=Dorothy",
    "value": "Ух ты...",
  },
  {
    "key": "rocketeer.conversation_ma515w_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Мне не нравятся эти странные сейсморитмы.",
  },
  {
    "key": "rocketeer.conversation_rh627j_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Это не просто смещение земной коры.",
  },
  {
    "key": "rocketeer.conversation_8vxt9k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Если начнется сильное землетрясение, оно разрушит весь город. Или того хуже: всю планету!",
  },
  {
    "key": "rocketeer.conversation_nid8rc_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Ничего себе!{format reset} Лучше мне тогда присмотреться, что внизу творится.",
  },
  {
    "key": "rocketeer.conversation_gqcn63_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Так держать!",
  },
  {
    "key": "rocketeer.conversation_q2vvjy_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Мне все еще не нравятся эти странные сейсморитмы.",
  },
  {
    "key": "rocketeer.conversation_46mop5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Защитная стена на дне шахты - это просто чудо техники.",
  },
  {
    "key": "rocketeer.conversation_k6sl9a_text",
    "notes": "Speaker=Dorothy",
    "value": "У нас в Тамблтоне под городом тоже была стена.",
  },
  {
    "key": "rocketeer.conversation_wb49hd_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Это та же самая стена. Длиной в много миль!",
  },
  {
    "key": "rocketeer.conversation_prdn7m_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Это самое невероятное творение рук одного бота во вселенной. Будь она на поверхности, ее было бы видно из космоса.",
  },
  {
    "key": "rocketeer.conversation_0b17qr_text",
    "notes": "Speaker=Dorothy",
    "value": "Столько кирпичей - и все чтобы не пустить бомжей...",
  },
  {
    "key": "rocketeer.conversation_4s3zz6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ну, бомжи, они же {format emph}homo devolvis{format reset}, довольно изобретательны в некоторых областях.",
  },
  {
    "key": "rocketeer.conversation_29dn85_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Эта их буза, которая помогает выжить под землей, - крайне занятное вещество...",
  },
  {
    "key": "rocketeer.conversation_8na87z_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added a comma after mutagenic",
    "value": "Сильный мутаген, вызывает стойкое привыкание, но при этом крайне эффективный источник энергии.",
  },
  {
    "key": "rocketeer.conversation_auy7u5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Я когда-то пыталась использовать ее как топливо для ракеты, но это слишком летучее соединение.",
  },
  {
    "key": "rocketeer.conversation_0144bl_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Защитная стена - это просто чудо света.",
  },
  {
    "key": "rocketeer.conversation_vfvf68_text",
    "notes": "Speaker=Dorothy",
    "value": "А вы слышали о пещерных растениях?",
  },
  {
    "key": "rocketeer.conversation_n56yib_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Я вообще-то не биолог, но в такой среде, кажется, могут выживать грибы.",
  },
  {
    "key": "rocketeer.conversation_6u259t_text",
    "notes": "Speaker=Dorothy",
    "value": "Я нашла пещеру, она аж до верха заросла.",
  },
  {
    "key": "rocketeer.conversation_4luy17_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Занятно! Видимо, они добывают энергию не фотосинтезом, а как-то иначе.",
  },
  {
    "key": "rocketeer.conversation_vq8bcq_text",
    "notes": "Speaker=Dorothy",
    "value": "Я нашла бомжей. Даже говорила с ними! Они построили город под стеной.",
  },
  {
    "key": "rocketeer.conversation_qbphbv_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Поразительно! Не слышала, чтобы современные бомжи могли разговаривать.",
  },
  {
    "key": "rocketeer.conversation_d8arjf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Те несколько, которых я видела, переговаривались гортанными возгласами. Просто уму непостижимо!",
  },
  {
    "key": "rocketeer.conversation_m0q6cs_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Я читала труды, утверждающие, что когда-то они были доминирующей расой на планете.",
  },
  {
    "key": "rocketeer.conversation_n96czx_text",
    "notes": "Speaker=Professor Sherman",
    "value": "В том, что касается homo devolvis, можно только предполагать...",
  },
  {
    "key": "rocketeer.conversation_9axbnb_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new* merged two lines into one.",
    "value": "Их практически невозможно изучать, не причиняя им вреда... Или не подвергая опасности собственную жизнь.",
  },
  {
    "key": "rocketeer.conversation_6qfwjp_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Эти бомжи - поразительные существа. За этими безумными глазами скрывается намек на личность.",
  },
  {
    "key": "rocketeer.conversation_wlfozb_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased",
    "value": "Профессор, вот вы умный робот. Как думаете, могут эти землетрясения быть делом рук роботов?",
  },
  {
    "key": "rocketeer.conversation_ylnbuf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Хочешь сказать, их кто-то специально устраивает?",
  },
  {
    "key": "rocketeer.conversation_x4pgec_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Это может объяснить до странности узкий эпицентр сейсмической активности.",
  },
  {
    "key": "rocketeer.conversation_934xqz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Толчки идут как раз из храма этой безумной секты конца света.",
  },
  {
    "key": "rocketeer.conversation_72gm7a_text",
    "notes": "Speaker=Dorothy",
    "value": "То есть, {format emph}это возможно{format reset}?",
  },
  {
    "key": "rocketeer.conversation_w0qkeb_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Чтобы проверить эту гипотезу, тебе придется {format highlight}перейти Ветреные Равнины{format reset} и исследовать восточный храм.",
  },
  {
    "key": "rocketeer.conversation_7xmo4l_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Твоя теория, что землетрясения устраивают искусственно, просто потрясающая.",
  },
  {
    "key": "rocketeer.conversation_p7mpft_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added the part about taking the ladder",
    "value": "Проверь ее {format highlight}по ту сторону Ветреных Равнин{format reset}. Спустись по лестнице в восточной части города.",
  },
  {
    "key": "rocketeer.conversation_9zagcy_text",
    "notes": "Speaker=Dorothy",
    "value": "Секта прячет какое-то устройство, способное вызывать землетрясения.",
  },
  {
    "key": "rocketeer.conversation_d8olb4_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Тогда следующий шаг - обезвредить это устройство. Это может остановить землетрясения.",
  },
  {
    "key": "rocketeer.conversation_vts8e3_text",
    "notes": "Speaker=Fen",
    "value": "{format emph}Да!{format reset} Уничтожить - это я люблю. За дело!",
  },
  {
    "key": "rocketeer.conversation_ly2vhz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Возможно, мне не придется достраивать ракету.",
  },
  {
    "key": "rocketeer.conversation_ypryh5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Строить космический корабль-разведчик, знаешь ли, не самое простое дело.",
  },
  {
    "key": "rocketeer.conversation_qq0n6k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Если ты {format highlight}отключишь генератор подземных толчков{format reset}, я смогу отдохнуть.",
  },
  {
    "key": "rocketeer.conversation_hbhl5o_text",
    "notes": "Speaker=Dorothy",
    "value": "Как может бот построить машину для землетрясений?",
  },
  {
    "key": "rocketeer.conversation_dpkudw_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Для этого нужны невероятные знания и очень продвинутые технологии.",
  },
  {
    "key": "rocketeer.conversation_irqx6c_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Технологии будущего, которые превосходят все, что мне известно...",
  },
  {
    "key": "rocketeer.conversation_gljg9h_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Я просматривала старые данные, пыталась расшифровать последовательность, но она хаотична.",
  },
  {
    "key": "rocketeer.conversation_j3paiq_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new*",
    "value": "Характер колебаний при землетрясении показывает, что мы все еще в опасности.",
  },
  {
    "key": "rocketeer.conversation_w8nhom_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Прекращать работу над ракетой явно рано.",
  },
  {
    "key": "rocketeer.conversation_ihi6uu_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Я пока не готова бросать ракету.",
  },
  {
    "key": "rocketeer.conversation_j6jtna_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Моему коллеге удалось достать образец их подземных джунглей.",
  },
  {
    "key": "rocketeer.conversation_oepnn1_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Странный, правда? И очень опасный.",
  },
  {
    "key": "rocketeer.conversation_kul85z_text",
    "notes": "Speaker=Fen",
    "value": "Да, клевый!",
  },
  {
    "key": "rocketeer.conversation_b4ld5b_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Так или иначе, он сказал, что обнаружил следы влияния мутагена.",
  },
  {
    "key": "rocketeer.conversation_h8rkzh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Похоже, растения берут энергию из мутагенной {format emph}бузы{format reset}, которую так любят бомжи.",
  },
  {
    "key": "rocketeer.conversation_bthpa5_text",
    "notes": "Speaker=Dorothy",
    "value": "Там {format emph}и правда{format reset} проходит много трубок.",
  },
  {
    "key": "rocketeer.conversation_wvpx34_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Вероятно, это источник заражения.",
  },
  {
    "key": "rocketeer.conversation_ll0rrj_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Но эти джунгли - лишь одна из загадок в этой череде странных событий.",
  },
  {
    "key": "rocketeer.conversation_gcue08_text",
    "notes": "Speaker=Dorothy",
    "value": "Мы отключил все сейсмогенераторы.",
  },
  {
    "key": "rocketeer.conversation_rhj5jo_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Мои приборы больше не мечутся и указывают в одну точку.",
  },
  {
    "key": "rocketeer.conversation_pgv6y7_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Последнее землетрясение началось как раз у деревни бомжей.",
  },
  {
    "key": "rocketeer.conversation_j878i8_text",
    "notes": "Speaker=Dorothy Notes=*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    "value": "Нам явно нужно отправляться туда, вниз, и {format highlight}поговорить с Рози.{format reset}",
  },
  {
    "key": "rocketeer.conversation_lv5xcl_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased the ending of the line.",
    "value": "Моя ракета готова наконец. Осталась пара приготовлений - и я могу улететь, если понадобится.",
  },
  {
    "key": "rocketeer.conversation_9rxm14_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Еще пара приготовлений - и можем улетать с планеты в случае большого землетрясения.",
  },
  {
    "key": "rocketeer.conversation_tnyv5r_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Как только я закончу свой корабль, улечу с этой планеты.",
  },
  {
    "key": "rocketeer.conversation_7an1z5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Кто хочет, присоединяйтесь. Места хватит всем.",
  },
  {
    "key": "workbench_conversation.conversation_f5xes1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ох!",
  },
  {
    "key": "workbench_conversation.conversation_vwbtbo_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "У меня есть просто фантастические обновления, как раз для тебя! Последний писк науки!",
  },
  {
    "key": "workbench_conversation.conversation_d17hfn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Эм... Извини, что отвлекаю... опять.",
  },
  {
    "key": "workbench_conversation.conversation_2hj8xd_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Но у меня появился новый товар! С ним можно очень круто обновить твои инструменты.",
  },
  {
    "key": "workbench_conversation.conversation_dnpk79_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ну... Просто решил предупредить.",
  },
  {
    "key": "workbench_conversation.conversation_cq63md_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ну как...?",
  },
  {
    "key": "workbench_conversation.conversation_eb2wqf_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}А-а{format reset}, в смысле... Как дела?",
  },
  {
    "key": "workbench_conversation.conversation_6hj11o_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Э... У меня есть новые детали!",
  },
  {
    "key": "workbench_conversation.conversation_ozu5go_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "С ними можно хорошо обновить и улучшить все инструменты... То есть, еще лучше их сделать. Круто, да?",
  },
  {
    "key": "workbench_conversation.conversation_rkault_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Я смотрю... Э... У тебя броня погнулась...",
  },
  {
    "key": "workbench_conversation.conversation_8lfpm2_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "У меня есть шикарные пластины, можно обновить ее.",
  },
  {
    "key": "workbench_conversation.conversation_kpzosz_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Чтобы у тебя было больше шансов.... Ну понимаешь.... уцелеть.",
  },
  {
    "key": "workbench_conversation.conversation_vk0in8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э... А что ты хочешь сделать?",
  },
  {
    "key": "workbench_conversation.conversation_xbec1d_text",
    "notes": "Speaker=Turtle Bucket Notes=This is the introductary phrase from the mechanich",
    "value": "Э... А что ты хочешь сделать?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_4nh80e_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Э... Хорошее снаряжение.",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_zb6ryl_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "То есть, ты, э... можешь его улучшить, если шестеренки есть. Может, э... хочешь узнать как?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_k47xd0_text",
    "notes": "Speaker=Turtle Bucket Notes=This person is very nervous",
    "value": "Э, извини... Не мешать, да?!",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_xsq7ao_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Тебе правда интересно?! Ну, л-ладно! Ладно!",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_9iwqjw_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ладно, в общем... да. Извини. Я буду тут, если что...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e2sw99_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Ты... это... Ты можешь {format highlight}улучшить инструменты{format reset} с помощью шестеренок {image cogs_small}.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_qsonke_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ты, может, видела такие вокруг.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_9chqoj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Воспользуйся верстаком, с его помощью ты сможешь улучшить свои инструменты. Просто вставь шестеренки {image cogs_small} в ячейки.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_0dnnax_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "О! Только это... Не бойся, можешь {format highlight}вытащить шестеренки{format reset} {image cogs_small} в любой момент!",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_90zfu2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Чем больше улучшаешь инструменты, тем круче улучшения.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_a5snuc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Вот... Могу еще порассказывать, но ты, наверное, не хочешь...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_b1szsc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Есть еще такие улучшения, для которых нужны чертежи.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_f0xxtp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "У Дэви Биттенборо, нашего, э... картографа, кажется, есть парочка.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_1q2dd2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Такие улучшения обычно очень классные! Ну, то есть, мне нравятся...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_i2a540_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Да, и, раз ты можешь доставать шестеренки {image cogs_small}, то можно поэкспериментировать.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_5p4bi7_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ну, менять экипировку то так, то эдак. То есть, если хочешь...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_iq6h9b_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Хм, круто, ты дослушала до конца! Обычно все уходят...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e4vdfi_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ну, э... Я буду тут, наверное.",
  },
  {
    "key": "fen_wall_found.conversation_9lkkka_text",
    "notes": "Speaker=Fen",
    "value": "Знакомое место. Может, сектанты притащили меня сюда по пути наверх.",
  },
  {
    "key": "fen_wall_found.conversation_qsa4d1_text",
    "notes": "Speaker=Fen",
    "value": "Как думаешь, а {format nervous}руины Вектрона{format reset} еще глубже?",
  },
  {
    "key": "fen_wall_found.conversation_3rahmd_text",
    "notes": "Speaker=Dorothy",
    "value": "Совсем глубоко. Мы пока в освоенной части шахты.",
  },
  {
    "key": "fen_wall_found.conversation_xecqeg_text",
    "notes": "Speaker=Fen",
    "value": "А, ну ладно. Просто спрашиваю.",
  },
  {
    "key": "fen_wall_found.conversation_mx4ktk_text",
    "notes": "Speaker=Dorothy",
    "value": "Теперь надо как-то пройти через эту дурацкую стену.",
  },
  {
    "key": "fen_wall_found.conversation_cat8cu_text",
    "notes": "Speaker=Fen",
    "value": "О! {format singsong}Пора что-нибудь взорвать!{format reset}",
  },
  {
    "key": "fen_wall_found.conversation_nq5gxh_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Это не сработает! Стену строили после бомжацких войн, чтобы эти ненормальные к нам не лазили.",
  },
  {
    "key": "fen_wall_found.conversation_gu7tji_text",
    "notes": "Speaker=Dorothy",
    "value": "Бомжи отлично разбираются во взрывчатке, так что стены выдерживают взрывы.",
  },
  {
    "key": "fen_below_wall.conversation_mbv8tf_text",
    "notes": "Speaker=Fen Notes=Place, refering to the underground jungle that they just passed thruogh.",
    "value": "Слушай, {format nervous}ну и местечко!{format reset}",
  },
  {
    "key": "fen_below_wall.conversation_cj1k6o_text",
    "notes": "Speaker=Dorothy",
    "value": "Похоже, я под первым слоем стены - как минимум.",
  },
  {
    "key": "fen_below_wall.conversation_5mo9pe_text",
    "notes": "Speaker=Dorothy",
    "value": "Надеюсь, эта станция где-то тут неподалеку.",
  },
  {
    "key": "fen_below_wall.conversation_vizvqs_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "А я надеюсь, мы там найдем что-нибудь клевое и взрывоопасное.",
  },
  {
    "key": "fen_on_yarrow.conversation_rswyd0_text",
    "notes": "Speaker=Fen",
    "value": "Слушай, {format emph}это{format reset} что за место? Выглядит мрачно и опасно. Посмотрим!",
  },
  {
    "key": "fen_on_yarrow.conversation_vqbkn5_text",
    "notes": "Speaker=Dorothy Notes=*new* shortened by removing description of place. Was a bit misrepresentative",
    "value": "Вообще-то здесь ничего не должно расти...",
  },
  {
    "key": "fen_on_yarrow.conversation_jk4t0s_text",
    "notes": "Speaker=Dorothy",
    "value": "Тут полно опасностей.",
  },
  {
    "key": "fen_on_yarrow.conversation_i4oq3o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ура!{format laugh}",
  },
  {
    "key": "fen_on_yarrow.conversation_qaywwl_text",
    "notes": "Speaker=Dorothy",
    "value": "Надо запастись топливом для лампы, прежде чем туда лезть.",
  },
  {
    "key": "fen_on_yarrow.conversation_sf4uwk_text",
    "notes": "Speaker=Fen",
    "value": "Скучная ты. Пошли!",
  },
  {
    "key": "blueprint_vendor_01.conversation_1135rj_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Честное слово! От этих землетрясений столько проблем. Мэру нужно послать кого-нибудь разобраться с ними.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dq65oq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "А что если эти сокровища разобьются? Даже подумать страшно!",
  },
  {
    "key": "blueprint_vendor_01.conversation_3fn5w0_text",
    "notes": "Speaker=Dorothy",
    "value": "Похоже, тебе очень нравятся драгоценные камни?",
  },
  {
    "key": "blueprint_vendor_01.conversation_npebbg_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Нет-нет! Я говорю о {format emph}настоящих{format reset} сокровищах. Удивительных и загадочных артефактах {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_a7uvtg_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Они прекрасны, и за каждым стоит захватывающая история.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mjgdjr_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    "value": "Если найдешь какой-нибудь артефакт {image artifacts_small}, то покажи мне его, пожалуйста, я буду очень благодарен.",
  },
  {
    "key": "blueprint_vendor_01.conversation_uwhgx6_text",
    "notes": "Speaker=Dorothy",
    "value": "Кажется, я нашла кое-что интересное для тебя.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iqy08o_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно, буду высматривать что-нибудь интересное.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rppjea_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Превосходно!{format reset} Я дам тебе {format highlight}чертеж{format reset}, если ты принесешь еще не меньше {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_br857t_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Вот это да!{format reset} Ущипните меня, неужели я не сплю?!",
  },
  {
    "key": "blueprint_vendor_01.conversation_iptdw9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Тебе удалось найти легендарный 43-й драгоценный артефакт{image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_lu65ll_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Как я об этом мечтал. Поколения моих предков искали эту вещицу. Как же мне не терпится увидеть его.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wu0y6m_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "...",
  },
  {
    "key": "blueprint_vendor_01.conversation_vyiiiz_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Погоди...",
  },
  {
    "key": "blueprint_vendor_01.conversation_ds3fs3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Это он?",
  },
  {
    "key": "blueprint_vendor_01.conversation_kheln9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Я так... так...",
  },
  {
    "key": "blueprint_vendor_01.conversation_axft9i_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Разочарован.",
  },
  {
    "key": "blueprint_vendor_01.conversation_66l4aw_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ну что ж, спасибо.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6ybt0n_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Моя жизнь потеряла смысл.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rlfp8l_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Превосходно!{format reset} Ты уже нашла артефакты, целых {var num_artifacts_current}! Удивительные артефакты {image artifacts_small}, отлично!",
  },
  {
    "key": "blueprint_vendor_01.conversation_as6lw7_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Превосходно!{format reset} Ты нашла артефакты, уже {var num_artifacts_current}! Удивительные артефакты {image artifacts_small}, отлично!",
  },
  {
    "key": "blueprint_vendor_01.conversation_p7vtak_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format* removed emph from appreciation",
    "value": "В знак благодарности я дам тебе {format highlight}чертеж{format reset} из своих запасов.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dcphb9_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* "it" refering to the blueprint",
    "value": "Просто возьми его в мастерскую и используй модификации. Он сослужит тебе отличную службу.",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8lzbu_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* gives the player som info on how many artefacts until next blueprint",
    "value": "Я дам тебе еще один чертеж, если ты покажешь мне не меньше {var num_artifacts_threshold} артефактов {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pwaqqk_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Хм, я смотрю, у тебя пока нет {format emph}ни одного{format reset} интересного артефакта {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tm2fum_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Я дам тебе {format highlight}чертеж{format reset}, если ты принесешь не меньше {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_31n97u_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Как чудесно, ты уже нашла кое-что! Целых {var num_artifacts_current}! Отличные артефакты {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_xkdvzp_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Я дам тебе {format highlight}чертеж{format reset}, если ты принесешь не меньше {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_vj87ok_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Отлично! Уже есть находки! Целых {var num_artifacts_current}, замечательные артефакты {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_c12v5z_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Эти драгоценные вещицы могут прятаться где угодно.",
  },
  {
    "key": "blueprint_vendor_01.conversation_r70wn4_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Но у тебя теперь есть отличное новое оборудование.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ozgox8_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Смотри по сторонам внимательно, хорошо?",
  },
  {
    "key": "blueprint_vendor_01.conversation_crg8xl_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    "value": "Я дам тебе еще один чертеж, если ты покажешь мне не меньше {var num_artifacts_threshold} артефактов {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rkqt88_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* removed "wonderful" as it conflicted with previous lines in some cases",
    "value": "Ты славно поработала. Думаю, ты нашла все артефакты шахты.",
  },
  {
    "key": "blueprint_vendor_01.conversation_4ngqs0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Как удачно, а у меня как раз кончились чертежи!",
  },
  {
    "key": "blueprint_vendor_01.conversation_75th6d_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Когда я был юным резвым ботом вроде тебя, то облазил всю шахту и составил отличные карты.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wvg349_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Я нанес на карту всю защитную стену задолго до того, как мои колени начали скрипеть и заедать.",
  },
  {
    "key": "blueprint_vendor_01.conversation_90qcuc_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Я начал с нижних ярусов, но эти неразумные бомжи мне очень мешали.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pffrd2_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "У этих созданий нет никакого уважения к чужому труду. Закладывать взрывчатку под такой шедевр? Это просто абсурд!",
  },
  {
    "key": "blueprint_vendor_01.conversation_fc5nyv_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Стена, конечно, поглощает большую часть урона, но понемногу они пробивают ее.",
  },
  {
    "key": "blueprint_vendor_01.conversation_219b44_text",
    "notes": "Speaker=Dorothy",
    "value": "Ты бывала в храме за Ветреными равнинами?",
  },
  {
    "key": "blueprint_vendor_01.conversation_0anv7h_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Эти развалины слабо изучены. Храм всегда был очень коварен.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tv8uil_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Мой коллега, Рональд Хаббот, был единственным, кто {format emph}рискнул{format reset} побывать там.",
  },
  {
    "key": "blueprint_vendor_01.conversation_u57vpi_text",
    "notes": "Speaker=Dorothy",
    "value": "И что с ним случилось?",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8rvft_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "О, у него, похоже, было какое-то жуткое видение о конце света.",
  },
  {
    "key": "blueprint_vendor_01.conversation_02chim_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Он обосновался в храме. Начал собирать вокруг себя безумных ботов.",
  },
  {
    "key": "blueprint_vendor_01.conversation_i026up_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Могу только предполагать, какие чудесные артефакты {image artifacts_small} таятся в тех развалинах.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tvge9q_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Знаешь, в глубинах шахты, должно быть, {format emph}горы{format reset} забытых артефактов {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iyk7r0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Просто вообрази все эти реликты забытых цивилизаций, которые ждут своего исследователя.",
  },
  {
    "key": "blueprint_vendor_01.conversation_hp4wcb_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "В какое чудесное время мы живем. Боты долгие годы не проникали так глубоко, как ты.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ekx3en_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Но тебе стоит отправиться еще глубже История покровительствует смелым.",
  },
  {
    "key": "blueprint_vendor_01.conversation_bb807w_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Западная пустыня - суровый засушливый край, но все же боты жили там веками.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6e53tq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Уверен, среди камней и песков там скрывается множество интересного.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ja68cp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Я очень высоко ценю артефакты.",
  },
  {
    "key": "blueprint_vendor_01.conversation_9w2c24_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Знаешь, обычно нужны {format emph}миллиарды лет{format reset}, чтобы Земля поменяла геологическую структуру.",
  },
  {
    "key": "blueprint_vendor_01.conversation_aactqp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Эти новые землетрясения способны изменить рельеф за пару десятков лет.",
  },
  {
    "key": "blueprint_vendor_01.conversation_fn5brp_text",
    "notes": "Speaker=Dorothy",
    "value": "Скоро мы разберемся с землетрясениями.",
  },
  {
    "key": "blueprint_vendor_01.conversation_d0c0zs_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "А что если шахта полностью обрушится? Мои карты станут бесполезны. Возмутительно!",
  },
  {
    "key": "blueprint_vendor_01.conversation_w56u9v_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Знаешь, это последнее землетрясение создало множество проблем.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mcnumi_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Может, профессор Шерман права... Возможно, нам всем придется покинуть эту планету.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mq34gi_text",
    "notes": "Speaker=Dorothy",
    "value": "Мы делаем все, чтобы этого избежать.",
  },
  {
    "key": "blueprint_vendor_01.conversation_h0mzw3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Создание звездных карт может оказаться интереснейшей задачей, подумай об этом.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uyr4r4_text",
    "notes": "Speaker=Clifford Heisenberg Notes=This person id located upp on a trellis with a fantastic view.",
    "value": "А, {format singsong}привет, милашка!{format reset} Отличный вид отсюда, правда? Повезло нашему мэру!",
  },
  {
    "key": "blueprint_vendor_02.conversation_w3sayh_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Только зря он профессора не слушает. Эти землетрясения сами по себе не кончатся!",
  },
  {
    "key": "blueprint_vendor_02.conversation_cww3zx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Мэра на месте нет. Интересно, когда он вернется.",
  },
  {
    "key": "blueprint_vendor_02.conversation_0g6nsc_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Это бомба у тебя?",
  },
  {
    "key": "blueprint_vendor_02.conversation_474v8c_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Скажи мне, что ты сейчас взорвешь этот домишко-уродец.",
  },
  {
    "key": "blueprint_vendor_02.conversation_o24esm_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format laugh}Да!{format reset} То есть, нет!",
  },
  {
    "key": "blueprint_vendor_02.conversation_yi4qcu_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed water bomb to pressure bomb",
    "value": "Я хотел показать мэру Йонкеру мою улучшенную пневмобомбу. Как раз то, что нужно городу!",
  },
  {
    "key": "blueprint_vendor_02.conversation_bqmi7g_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Только... От но меня отмахнулся и сказал принести ее в кабинет. А тут нет никого...",
  },
  {
    "key": "blueprint_vendor_02.conversation_5kay5a_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ну, ничего, я подожду! Мэр наверняка скоро вернется. Возможно. Наверное. Когда-нибудь.",
  },
  {
    "key": "blueprint_vendor_02.conversation_73lt57_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "У бомб много применений. Их можно использовать {format emph}везде{format reset}. Более или менее.",
  },
  {
    "key": "blueprint_vendor_02.conversation_2t4ktx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Можно туннели пробивать, разбивать твердые минералы, расчищать мусор и завалы...",
  },
  {
    "key": "blueprint_vendor_02.conversation_tkp0i2_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Про разрушение ради разрушения не забудь!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2ynw9y_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Когда-то они в шахтах постоянно грохотали. Ах, то была музыка для моих ушей!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2vgr7k_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Прекрасные взрывы со смертельным исходом!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nhr7x_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed pressurized water bomb to pressure bomb",
    "value": "Я так надеюсь, что мэр одобрит мою разработку новой пневмобомбы... За ними будущее!",
  },
  {
    "key": "blueprint_vendor_02.conversation_gbuars_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "А он соображает!",
  },
  {
    "key": "blueprint_vendor_02.conversation_h4evh3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Я рада, что ты нашла родственную душу, но лучше б у вас были другие общие интересы.",
  },
  {
    "key": "blueprint_vendor_02.conversation_v0gx3y_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Я обязательно докажу мэру, что за моими бомбами будущее.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hwchba_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Мистер Биттенборо как-то раз принес мне искореженный корпус от бомбы. Сказал, что нашел его на территории бомжей.",
  },
  {
    "key": "blueprint_vendor_02.conversation_q0vd7o_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Мне аж смотреть тошно было! Ты знала, что бомжи делают бомбы из {format nervous}нитроглицерина и бузы?{format reset}",
  },
  {
    "key": "blueprint_vendor_02.conversation_shtyfr_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "А что тут не так? Взрывается же?",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nsm4v_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Точно. Вместе с твоими пальцами, если повезет!",
  },
  {
    "key": "blueprint_vendor_02.conversation_s7nbis_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed pressurized water bomb to pressure bomb",
    "value": "Нет, спасибо! Я выбираю старую добрую пневмобомбу, надежную и безопасную.",
  },
  {
    "key": "blueprint_vendor_02.conversation_p2i5l7_text",
    "notes": "Speaker=Fen Notes=*format* *new* removed "..."",
    "value": "Отстой.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ptgzep_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Осторожней там внизу. С бомжами шутки плохи.",
  },
  {
    "key": "blueprint_vendor_02.conversation_l8kkmb_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ты уже видела новую ракету профессора Шерман? Красавица!",
  },
  {
    "key": "blueprint_vendor_02.conversation_9yditf_text",
    "notes": "Speaker=Dorothy Notes=This is Dororthy talking",
    "value": "Да, впечатляет.",
  },
  {
    "key": "blueprint_vendor_02.conversation_b8svck_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "И абсолютно надежна. Я же ей помогал с расчетами!",
  },
  {
    "key": "blueprint_vendor_02.conversation_wz8w9f_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Чтобы запустить такую махину в космос, нужно много усилий. Все нужно просчитать до тысячных долей!",
  },
  {
    "key": "blueprint_vendor_02.conversation_516qkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Я хочу сказать, по сути-то ракета - это огромная бомба, согласна?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8ly6iv_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Мне нравится, к чему он клонит. Может, попросим профессора дать покататься?",
  },
  {
    "key": "blueprint_vendor_02.conversation_pawve3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Может, позже, Фен.",
  },
  {
    "key": "blueprint_vendor_02.conversation_sqkxyn_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Не беспокойся. Если речь о бомбах, я никогда не ошибаюсь!",
  },
  {
    "key": "blueprint_vendor_02.conversation_ha9646_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Я тут думаю об этих землетрясениях. Землетрясение - это ведь по сути сильная вибрация, так?",
  },
  {
    "key": "blueprint_vendor_02.conversation_fs869d_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format singsong}И-и-и-и...{format reset} если создать эквивалентную вибрацию и попасть в {format emph}антирезонанс{format reset}, то они взаимоуничтожатся!",
  },
  {
    "key": "blueprint_vendor_02.conversation_1frwlw_text",
    "notes": "Speaker=Dorothy",
    "value": "Э... Вы... Я вас правильно поняла?",
  },
  {
    "key": "blueprint_vendor_02.conversation_qd7crv_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Именно! Бомбы! Всего-то и нужно, что создать сеть синхронизируемых бомб и нейтрализовать вибрацию!",
  },
  {
    "key": "blueprint_vendor_02.conversation_t8xdab_text",
    "notes": "Speaker=Fen",
    "value": "Прелесть! Отличный план.",
  },
  {
    "key": "blueprint_vendor_02.conversation_50z3oe_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Я так рад, что тебе нравится! Надо только поработать над расчетами годик-другой. Безопасность прежде всего!",
  },
  {
    "key": "blueprint_vendor_02.conversation_wdv8yf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ой...",
  },
  {
    "key": "blueprint_vendor_02.conversation_dx83ih_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Надо немедленно рассказать мэру Йонкеру о моем плане. Он наверняка будет в восторге! Когда же он вернется... Его уже давно нет.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hu5cr9_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Не нравятся мне эти разговоры про большое землетрясение. Слишком много неизвестных. Насколько большое? Когда начнется? Где?",
  },
  {
    "key": "blueprint_vendor_02.conversation_achdi1_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "С тех пор как обрушило лифт, я все думаю, что случится, если землетрясение будет {format emph}и впрямь{format reset} большим.",
  },
  {
    "key": "blueprint_vendor_02.conversation_k2l3ob_text",
    "notes": "Speaker=Dorothy",
    "value": "Профессор Шерман говорит, что ситуация будет ухудшаться.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ioi3ht_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ее стоит послушать. Она в городе самая умная.",
  },
  {
    "key": "blueprint_vendor_02.conversation_5oey6i_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Кажется мне, что мэр в кабинет не вернется.",
  },
  {
    "key": "blueprint_vendor_02.conversation_xoknkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed format from laugh to singsong",
    "value": "{format singsong}Ого!{format reset} Это что... пневмогранатомет? О да, роскошная модель!",
  },
  {
    "key": "blueprint_vendor_02.conversation_uhq93q_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Так ты... тоже любительница бомб? Как я?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8o8ba8_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Я покажу тебе мой секретный проект! О, я просто {format nervous}разрывался{format reset} от желания поделиться с ценителем!",
  },
  {
    "key": "blueprint_vendor_02.conversation_ux8mwy_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed format from highligh to emph",
    "value": "Патент только на рассмотрении, но с этой модификацией твой гранатомет станет {format emph}втрое разрушительнее{format reset}!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4urlt2_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Я бы дал тебе испытать ее в полевых условиях, только... {format singsong}Н-ну-у-у-у{format reset}... мой бюджет на исследования последнее время немного иссяк.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uxln27_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Может, если ты пожертвуешь, скажем \${var pricelist_next:blueprint_vendor_02}{image money_small}, я мог бы предложить уникальный, только для своих, {format highlight}чертеж{format reset} моего изобретения. Как тебе?",
  },
  {
    "key": "blueprint_vendor_02.conversation_dgw94e_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Кстати, не надумала еще пожертвовать на науку? Всего-то \${var pricelist_next:blueprint_vendor_02}{image money_small} за первый и уникальный {format highlight}чертеж{format reset}!",
  },
  {
    "key": "blueprint_vendor_02.conversation_20o2j5_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* split this line up",
    "value": "Отлично! Держи!",
  },
  {
    "key": "blueprint_vendor_02.conversation_52n8bq_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Отправляйся в мастерскую и пусти его в дело: улучши свои пушки.",
  },
  {
    "key": "blueprint_vendor_02.conversation_9p7l5p_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Чего ждешь? Иди и разбей что-нибудь вдребезги!",
  },
  {
    "key": "blueprint_vendor_02.conversation_gui6im_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Похоже, у тебя тоже с финансами туго. Не горюй! Приходи, как будешь при деньгах.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ijkhew_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Понимаю! Приходи в любое время, если передумаешь.",
  },
  {
    "key": "blueprint_vendor_02.conversation_02qawb_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Ну что, помог тебе чертеж? Ну как, нашла что взорвать?",
  },
  {
    "key": "blueprint_vendor_03.conversation_1hq43e_text",
    "notes": "Speaker=Ty Nuzak Notes=This Character is a mail man/pony express person.",
    "value": "Привет, подруга. С этими землетрясениями доставлять почту стало опасно.",
  },
  {
    "key": "blueprint_vendor_03.conversation_k6q6hf_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Кое-кто из наших ребят говорил, что в пустыне появились какие-то провалы.",
  },
  {
    "key": "blueprint_vendor_03.conversation_ple2sp_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Там для наших теперь небезопасно.",
  },
  {
    "key": "blueprint_vendor_03.conversation_dum6i9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Извини, подруга, сейчас я тебе с почтой помочь не могу.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qy63x4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Все наши сотрудники сейчас на доставке, бедолаги.",
  },
  {
    "key": "blueprint_vendor_03.conversation_4nc6nw_text",
    "notes": "Speaker=Dorothy",
    "value": "А вы почему не с ними?",
  },
  {
    "key": "blueprint_vendor_03.conversation_aozfk3_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Нет ничего {format nervous}страшнее{format reset}, чем открытые пространства. Пустота. Мили пустоты.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opkpi5_text",
    "notes": "Speaker=Ty Nuzak Notes=*format*",
    "value": "У меня от одной мысли клаустрофобия начинается.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opmgdu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Поверь, подруга, нет ничего ужасней огромных открытых пространств.",
  },
  {
    "key": "blueprint_vendor_03.conversation_384qc9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Наши пони бегали по всей пустыне. Эти землетрясения повсюду, подруга.",
  },
  {
    "key": "blueprint_vendor_03.conversation_c3vack_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Деревушки вокруг старых храмов в панике.",
  },
  {
    "key": "blueprint_vendor_03.conversation_alusmw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Мы даже больше не можем перевозить сюда руду.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5nkkkg_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "В этом городе многие зарабатывали на перевозке товаров по всей равнине.",
  },
  {
    "key": "blueprint_vendor_03.conversation_1u0u2r_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "И лучший способ перевозок - это "Паропони Экспресс".",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ufqac_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "У "Паропони Экспресс" отличная репутация. Я не хочу, чтобы эти землетрясения разрушили и ее, подруга.",
  },
  {
    "key": "blueprint_vendor_03.conversation_7idj7v_text",
    "notes": "Speaker=Dorothy",
    "value": "А ваши пони заходили в храмы?",
  },
  {
    "key": "blueprint_vendor_03.conversation_vfl4c6_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to Ron",
    "value": "Забавно, что ты спрашиваешь, подруга. У нас была срочная доставка в восточный храм буквально в том месяце.",
  },
  {
    "key": "blueprint_vendor_03.conversation_51nddn_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* changes to phrasing",
    "value": "Нам пришлось отправить курьера прямиком через Ветреные равнины.",
  },
  {
    "key": "blueprint_vendor_03.conversation_hsitea_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed "pardner".",
    "value": "А надо сказать, через такие вихри можно пробежать только на очень сильных ногах.",
  },
  {
    "key": "blueprint_vendor_03.conversation_g6i2qw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    "value": "Они заказали партию роскошных жаровен и просили доставить их как можно скорее.",
  },
  {
    "key": "blueprint_vendor_03.conversation_j223bu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Наверное, для своей дурацкой секты.",
  },
  {
    "key": "blueprint_vendor_03.conversation_p4ogy4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Тот, кто хочет пересечь Ветреные равнины, должен быть готов к сильному встречному ветру, подруга.",
  },
  {
    "key": "blueprint_vendor_03.conversation_pgpn5x_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Говорят, ты глубоко копаешь, подруга.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ir3fn_text",
    "notes": "Speaker=Dorothy",
    "value": "Да, мы ищем моего друга, он может быть там, в шахте.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0q9lw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* doggone to coggone",
    "value": "Иногда мне так хочется уйти из этого заржавелого города и посмотреть на мир.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0wgkw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "А потом я слышу рассказы про всякие страшные штуки вроде подземных джунглей.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qgwwxu_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Я начинаю размышлять о тайнах и опасностях, скрытых там, внизу.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5phwat_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "У меня начинается {format nervous}сердцебиение{format reset} и дрожь в коленках.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cp57ox_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Шпорами клянусь, я самый трусливый пони из всех, что ты встречала, правда же?",
  },
  {
    "key": "blueprint_vendor_03.conversation_x5lp6f_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Мне хотелось бы быть посмелее, а париться поменьше. В мире так много всего интересного, а я все пропускаю.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w4by19_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "А с этими землетрясениями стало еще хуже. У меня все четыре коленки трясутся.",
  },
  {
    "key": "blueprint_vendor_03.conversation_d4gln9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "По-моему, нам всем надо сматываться отсюда на ракете, да побыстрее.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w15szm_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Не то чтоб мне нравилась идея лететь в это пустое небо.",
  },
  {
    "key": "blueprint_vendor_03.conversation_jnag7u_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Но если планета развалится, то выбора-то особо нет...",
  },
  {
    "key": "blueprint_vendor_03.conversation_oawrk7_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Похоже, подруга, придется мне покинуть зону комфорта.",
  },
  {
    "key": "blueprint_vendor_03.conversation_e1e8ry_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Если вся планета разлетится на куски, мне просто придется отправиться навстречу приключениям.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cqe4nv_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Здорово, подруга! Было здорово встретить земляка-копальщика, особенно сейчас, когда из-за землетрясений все вверх дном.",
  },
  {
    "key": "cultist_worship_rusty.conversation_jm66o2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "cultist_worship_rusty.conversation_igsxan_text",
    "notes": "Speaker=Dorothy",
    "value": "Вы что, поклоняетесь {format emph}статуе Расти{format reset}?",
  },
  {
    "key": "cultist_worship_rusty.conversation_1voalp_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Да... Великий Расти - Разрушитель обетованный.",
  },
  {
    "key": "cultist_worship_rusty.conversation_pd5hzj_text",
    "notes": "Speaker=Cultist Notes=*new* removed reference to Ron and expanded the text format",
    "value": "Его пришествие предрек Великий Пророк. Он предвидел приход {format singsong}благословенного конца{format reset}.",
  },
  {
    "key": "cultist_worship_rusty.conversation_y6xyie_text",
    "notes": "Speaker=Fen",
    "value": "Вы, ребята, что найдете, тому и поклоняетесь, что ли?",
  },
  {
    "key": "cultist_worship_rusty.conversation_e76l4q_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Путеводный Свет! Эта неверная похитила тебя из Храма Пути!",
  },
  {
    "key": "cultist_worship_rusty.conversation_qo16zi_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Я принесу ее детали в жертву очищающему пламени!",
  },
  {
    "key": "yonker_01.conversation_mdyvq0_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "О, привет! Я-то думал, {format nervous}меня никто не найдет{format reset}.",
  },
  {
    "key": "yonker_01.conversation_zcgves_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Я не то чтоб там потерялся, нет, просто сюда непросто добраться!",
  },
  {
    "key": "yonker_01.conversation_ara3qe_text",
    "notes": "Speaker=Zebulon Yonker Notes="Feels like Ah should give..." is "Feels like I should give..."",
    "value": "Надо б тебе подарить что-нибудь за хлопоты. А у меня только вот, чертежик.",
  },
  {
    "key": "yonker_01.conversation_2ebftt_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Но ты только учти, если его применишь, твое путешествие может стать {format danger}сложнее{format reset}.",
  },
  {
    "key": "yonker_01.conversation_6jeiwp_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Так что используй его, только если хочешь заморочиться!",
  },
  {
    "key": "yonker_01.conversation_pvpsai_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ты не боись, я не потерялся. Я тут отдыхаю.",
  },
  {
    "key": "yonker_01.conversation_jbfsb5_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Мой брательник такой тупой, он заблочил всю старую транспортную систему.",
  },
  {
    "key": "yonker_01.conversation_rq43xc_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Сказал, там опасно или что-то вроде того. Я вообще-то не слушал.",
  },
  {
    "key": "yonker_01.conversation_v4t07d_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Я иногда думаю, что эти все мэрские заморочки ему шурупы в башке заклинили.",
  },
  {
    "key": "yonker_01.conversation_y4mgz6_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Без лифтов-то плохо. Домой придется ногами топать.",
  },
  {
    "key": "yonker_01.conversation_9kai6i_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "С этими пустынями что-то неладное творится, точно тебе говорю.",
  },
  {
    "key": "yonker_01.conversation_1hh5hs_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Видел этих чудил из секты возле храма.",
  },
  {
    "key": "yonker_01.conversation_vpsiim_text",
    "notes": "Speaker=Zebulon Yonker Notes=*format*",
    "value": "Я в ихних гитиках не разбираюсь. У них там ритуалы странные, все такое.",
  },
  {
    "key": "yonker_01.conversation_efhbif_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "В шахте любой спятит, если долго вылезать не будет.",
  },
  {
    "key": "yonker_01.conversation_914qie_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Я б тут еще чуток посидел. А то ж работать заставят...",
  },
  {
    "key": "yonker_02.conversation_ppa3hq_text",
    "notes": "Speaker=Luke Yonker",
    "value": "{format emph}У-у{format reset}, я думал, ты из тех {format nervous}тупых бомжей!{format reset}",
  },
  {
    "key": "yonker_02.conversation_rtaarn_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Не знаю, что и сказать. Это место отличается от всего, что я видел.",
  },
  {
    "key": "yonker_02.conversation_rqui5d_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Приятно встретить тут другого робота!",
  },
  {
    "key": "yonker_02.conversation_xpaj1a_text",
    "notes": "Speaker=Luke Yonker Notes=Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    "value": "Спасибо за компанию. Вот, возьми чертеж, это тебе.",
  },
  {
    "key": "yonker_02.conversation_5zxme4_text",
    "notes": "Speaker=Luke Yonker Notes=*NEW*",
    "value": "Но ты смотри. Если его применишь, твое путешествие может стать {format danger}сложнее{format reset}.",
  },
  {
    "key": "yonker_02.conversation_ncsd4z_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Не хочешь лишних приключений - не используй чертеж!",
  },
  {
    "key": "yonker_02.conversation_yp736j_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Эй, привет подруга-бот!",
  },
  {
    "key": "yonker_02.conversation_g21tdm_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Мои брательники говорят, что это они построили большую часть стены, но я-то знаю, что это не так.",
  },
  {
    "key": "yonker_02.conversation_iehmo4_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Они ставили заплатки, было дело, но стена тут всегда стояла.",
  },
  {
    "key": "yonker_02.conversation_aytv9n_text",
    "notes": "Speaker=Luke Yonker",
    "value": "В этих чуваках столько горячего воздуха, что они взлететь готовы!",
  },
  {
    "key": "yonker_02.conversation_8srkg6_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Что я точно усвоил - это что стену всегда можно обойти.",
  },
  {
    "key": "yonker_02.conversation_vb6b0a_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Точно говорю, я намедни видел, как эти грибы двигаются.",
  },
  {
    "key": "yonker_02.conversation_0yu226_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Как думаешь, быстро они до города доберутся?",
  },
  {
    "key": "yonker_02.conversation_onpk10_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Я пока тут побуду, посмотрю на грибочки.",
  },
  {
    "key": "yonker_03.conversation_xfyeov_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Прикинь, работал тут, работал, а потом - бац! - оказалось, что я инструменты забыл!",
  },
  {
    "key": "yonker_03.conversation_t1bq4v_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Если будешь про это помалкивать, дам тебе одну клевую бумажку.",
  },
  {
    "key": "yonker_03.conversation_odkj11_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Но тогда твои приключения станут... {format danger}сложнее{format reset}.",
  },
  {
    "key": "yonker_03.conversation_nvlvnn_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Так что бери ее, только если сам черт тебе не брат!",
  },
  {
    "key": "yonker_03.conversation_ajyl7v_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "О, и братикам ничего не говори, лады?",
  },
  {
    "key": "yonker_03.conversation_zdkcdy_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Рад, что мы друг друга поняли!",
  },
  {
    "key": "yonker_03.conversation_wpy2vc_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Не надо говорить моим, что ты меня тут нашла.",
  },
  {
    "key": "yonker_03.conversation_0fsp3k_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Я вообще-то прохвесс... пруфесс... {format emph}Искперт{format reset} я в общем, когда дело до стен доходит, точно тебе говорю.",
  },
  {
    "key": "yonker_03.conversation_l2xfyd_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Еще бы бомжары эти сюда не лезли.",
  },
  {
    "key": "yonker_03.conversation_a09h0a_text",
    "notes": "Speaker=Josh Yonker",
    "value": "У меня нет времени везде ходить и все проверять.",
  },
  {
    "key": "yonker_03.conversation_sy2ct5_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Я уже давно бомжей не видал. До землетрясений мне с ними постоянно приходилось разбираться.",
  },
  {
    "key": "yonker_03.conversation_w8p7tf_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Если мои брательники узнают, что я сам себя замуровал, они ж мне проходу не дадут.",
  },
  {
    "key": "sign_red_rock.conversation_rbdoyh_text",
    "notes": "Speaker=Dorothy",
    "value": ""Краснокаменный штрек"",
  },
  {
    "key": "fen_on_rocket.conversation_jofluh_text",
    "notes": "Speaker=Fen",
    "value": "Ох! Ты посмотри, какое крушение. {format singsong}Крруть ваще!!!!{format reset}",
  },
  {
    "key": "fen_on_rocket.conversation_rgfncb_text",
    "notes": "Speaker=Dorothy",
    "value": "Будем надеяться, профессор внесет в новую ракету серьезные улучшения.",
  },
  {
    "key": "fen_on_rocket.conversation_1mx9ap_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Угу. Добавит лазеры и всякое такое!",
  },
  {
    "key": "firetemple_boss_intro.conversation_z6izd0_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Кто посмел предстать пред очи Великого пророка Разрушителя?",
  },
  {
    "key": "firetemple_boss_intro.conversation_cu9az7_text",
    "notes": "Speaker=Fen",
    "value": "Эй, я знаю этого парня! Это он принес меня в тот другой храм!",
  },
  {
    "key": "firetemple_boss_intro.conversation_4ljao8_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Путеводный Свет! Что ты делаешь в компании этого никчемного бота в моем храме?",
  },
  {
    "key": "firetemple_boss_intro.conversation_m8bbt4_text",
    "notes": "Speaker=Dorothy",
    "value": "Где Расти? Что ты {format emph}с ним сделал?{format reset}",
  },
  {
    "key": "firetemple_boss_intro.conversation_6jm46x_text",
    "notes": "Speaker=Great Prophet Notes=*new* moved text format to other words.",
    "value": "Как было предсказано мной, Расти Разрушитель устроит {format laugh}Большое Землетрясение{format reset} и сбросит наши бренные оковы.",
  },
  {
    "key": "firetemple_boss_intro.conversation_mhn5s6_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Он дал нам машину рока! А затем покинул нас. Его пути неисповедимы.",
  },
  {
    "key": "firetemple_boss_intro.conversation_davhio_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "firetemple_boss_intro.conversation_39dqwa_text",
    "notes": "Speaker=Dorothy",
    "value": "Я должна обезвредить эту штуку!",
  },
  {
    "key": "firetemple_boss_intro.conversation_f5igne_text",
    "notes": "Speaker=Fen Notes=*format* removed one of the text formats",
    "value": "Да! Скажи нам, где скрыта машина рока, и мы {format laugh}взорвем ее{format reset}!",
  },
  {
    "key": "firetemple_boss_intro.conversation_t03c7h_text",
    "notes": "Speaker=Great Prophet",
    "value": "Ах, Путеводный Свет! Какое падение. Я не позволю вам испортить наш прекрасный апокалипсис!",
  },
  {
    "key": "firetemple_boss_outro.conversation_5ppdcr_text",
    "notes": "Speaker=Great Prophet",
    "value": "{format nervous}А-а-а!{format reset} Вам не остановить грядущее {format laugh}Большое Землетрясение{format reset}.",
  },
  {
    "key": "firetemple_boss_outro.conversation_veu3hm_text",
    "notes": "Speaker=Great Prophet",
    "value": "Машина рока в безопасности. Нам всем {format singsong}коне-е-ец!{format reset}",
  },
  {
    "key": "sign_maze_01.conversation_1l6ojp_text",
    "notes": "Speaker=Dorothy Notes=There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    "value": ""Впереди призрачная стена!"",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_cp9bbp_text",
    "notes": "Speaker=Fen Notes=*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    "value": "Ну что, никак?",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_p1i3bn_text",
    "notes": "Speaker=Dorothy Notes=*new* changed an I to a We.",
    "value": "Мне нужно только {format highlight}зажечь больше жаровен{format reset}, чтобы активировать кристаллы.",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_xqev6z_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    "value": "Они должны быть где-то здесь!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_kk5j23_text",
    "notes": "Speaker=Fen Notes=*new* changed the phrasing to be more Fen-like",
    "value": "Ага, давай уже зажжем их!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_4dihd5_text",
    "notes": "Speaker=Fen Notes=*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    "value": "Да, тебе нужно зажечь все жаровни.",
  },
  {
    "key": "sign_vectron2_1.conversation_7gz2cu_text",
    "notes": "Speaker=Dorothy",
    "value": ""СМЕРТЬ ВПЕРЕДИ!"",
  },
  {
    "key": "cultist_worship_rusty_intro.conversation_8fufl9_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "О Великий Разрушитель, нам всем точно конец!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_bj94jz_text",
    "notes": "Speaker=Fen",
    "value": "В чем задержка? Давай!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_i7wge8_text",
    "notes": "Speaker=Dorothy Notes=*new* made it clear that it's only the pipe to the oasis that is closed",
    "value": "Странно... Шахта обратно в Оазис не работает.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_t6jhkm_text",
    "notes": "Speaker=Fen Notes=*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    "value": "Это подозрительно... Может, выход с той стороны засорился?",
  },
  {
    "key": "hub_teleporter_blocked.conversation_kbmx5q_text",
    "notes": "Speaker=Dorothy Notes=*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    "value": "Нам нужно расчистить последний участок, чтобы вернуться.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_dhpyma_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to not refert to whole tube system",
    "value": "Шахта обратно в Оазис все еще не работает!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_xdvi4z_text",
    "notes": "Speaker=Fen Notes=*new* added a "come on then,"",
    "value": "Ну так давай {format highlight}найдем другой путь в Оазис{format reset}.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_efpvk6_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ты...Ты вернулась!",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xs0zex_text",
    "notes": "Speaker=Dorothy",
    "value": "Да, я точно не знаю, как я выбралась, но я же говорила, что вернусь.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_2gp05g_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "А мне пришлось тут в одиночестве... Торчать. Наверное... Меня сморило.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_v8dyjq_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Мне снилось... кое-что... Что надо рассказать тебе.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xvqfeq_text",
    "notes": "Speaker=Fen",
    "value": "Это связано с землетрясением, током и...",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_6uvdlp_text",
    "notes": "Speaker=Fen Notes=*new* changed format from nervous to emph",
    "value": "{format emph}Дороти!{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_x1cve3_text",
    "notes": "Speaker=Dorothy",
    "value": "Что, Фен? Что тебе снилось?",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_c268na_text",
    "notes": "Speaker=Fen",
    "value": "Там были... Нет... Там ощущались ... Ощущались другие машины рока.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_glw2u1_text",
    "notes": "Speaker=Dorothy Notes=*new* added the phrase "come on" at the start of the line.",
    "value": "Давай, надо {format highlight}рассказать Рози{format reset}. Мы еще не разобрались с землетрясением.",
  },
  {
    "key": "temple_generator_destroyed.conversation_vduxpt_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Хи-хи...{format reset} круто было!",
  },
  {
    "key": "temple_generator_destroyed.conversation_bez5tc_text",
    "notes": "Speaker=Dorothy",
    "value": "Да, теперь эта штука выглядит безобидной, правда?",
  },
  {
    "key": "temple_generator_destroyed.conversation_02t7hw_text",
    "notes": "Speaker=Dorothy",
    "value": "Тут соединены части робота и Вектрона.",
  },
  {
    "key": "temple_generator_destroyed.conversation_nloh4y_text",
    "notes": "Speaker=Dorothy",
    "value": "Зачем Расти построил такой механизм?",
  },
  {
    "key": "temple_generator_destroyed.conversation_uo5vst_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ты слишком много думаешь. Больше взрывов, меньше слов!",
  },
  {
    "key": "temple_generator_destroyed.conversation_cqegx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Нам нужно {format highlight}вернуться в Оазис{format reset} и сказать Рози, что устройство обезврежено.",
  },
  {
    "key": "last_generator_destroyed.conversation_o7pn77_text",
    "notes": "Speaker=Dorothy",
    "value": "Чувствую странное удовольствие.",
  },
  {
    "key": "last_generator_destroyed.conversation_fhtom3_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "О, становится интересно!",
  },
  {
    "key": "last_generator_destroyed.conversation_0j9ty2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "last_generator_destroyed.conversation_j80dt5_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Вот это ощущалось, Фен?",
  },
  {
    "key": "last_generator_destroyed.conversation_4ctogi_text",
    "notes": "Speaker=Fen",
    "value": "Не знаю, может быть.",
  },
  {
    "key": "last_generator_destroyed.conversation_5r8xoq_text",
    "notes": "Speaker=Dorothy",
    "value": "Как будто дрожь.",
  },
  {
    "key": "last_generator_destroyed.conversation_ue7igm_text",
    "notes": "Speaker=Fen",
    "value": "Давай пойдем и {format highlight}раскрошим еще одно устройство{format reset}!",
  },
  {
    "key": "last_generator_destroyed.conversation_kx4acl_text",
    "notes": "Speaker=Dorothy",
    "value": "Еще один готов!",
  },
  {
    "key": "last_generator_destroyed.conversation_7knnev_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Да!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_7xkz1w_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Круто, когда есть с кем работать... Когда ты в компании...",
  },
  {
    "key": "last_generator_destroyed.conversation_orn1ay_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Эй, а вот это точно было землетрясение!",
  },
  {
    "key": "last_generator_destroyed.conversation_b59rnh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Может, это из-за той штуки, что мы разгрохали.",
  },
  {
    "key": "last_generator_destroyed.conversation_s51o2b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "{format emph}Когда{format reset} найдем Расти, ему придется все это объяснить!",
  },
  {
    "key": "last_generator_destroyed.conversation_lxj451_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Не волнуйся, я тебя прикрою.",
  },
  {
    "key": "last_generator_destroyed.conversation_mk9qpq_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ура!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_p2ot9u_text",
    "notes": "Speaker=Dorothy",
    "value": "Последний.",
  },
  {
    "key": "last_generator_destroyed.conversation_xxw7zr_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Ого, круто тряхнуло!",
  },
  {
    "key": "last_generator_destroyed.conversation_p4nitu_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "В этом нет никакого смысла. Мне казалось, теперь не будет никаких землетрясений.",
  },
  {
    "key": "last_generator_destroyed.conversation_48h46n_text",
    "notes": "Speaker=Fen",
    "value": "Да, это точно было самое последнее устройство.",
  },
  {
    "key": "last_generator_destroyed.conversation_vkntr1_text",
    "notes": "Speaker=Dorothy Notes=*format* *new*",
    "value": "У меня плохое предчувствие. Слишком много вопросов без ответа.",
  },
  {
    "key": "last_generator_destroyed.conversation_nzra7p_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Секта конца света и ядовитые джунгли! И где Расти?",
  },
  {
    "key": "last_generator_destroyed.conversation_3r7w00_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Да, подозрительно...",
  },
  {
    "key": "last_generator_destroyed.conversation_mboiam_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Может, Расти ни при чем? Может, Рози ошиблась...",
  },
  {
    "key": "last_generator_destroyed.conversation_iz5s2x_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Или не все нам рассказала.",
  },
  {
    "key": "last_generator_destroyed.conversation_xd4lj1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Нам нужно возвращаться в Оазис и {format highlight}поговорить с Рози{format reset}.",
  },
  {
    "key": "fen_0_brazier_lit.conversation_7k0m7s_text",
    "notes": "Speaker=Fen Notes=*new* changed this since we now have the old version of it triggered up by the first lever at the entrance to this temple",
    "value": "Еще один бесполезный рычаг?",
  },
  {
    "key": "fen_0_brazier_lit.conversation_bqsv37_text",
    "notes": "Speaker=Dorothy Notes=*new* same as above",
    "value": "Кажется, нужно и сюда {format highlight}подать питание{format reset}.",
  },
  {
    "key": "fen_0_brazier_lit.conversation_rzhlfx_text",
    "notes": "Speaker=Dorothy",
    "value": "Пока ничего!",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_1l90nu_text",
    "notes": "Speaker=Fen",
    "value": "Эта жаровня должна сработать.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_q9t7dt_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased it.",
    "value": "Да, нужно только как-то ее поджечь.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_sb7zou_text",
    "notes": "Speaker=Fen",
    "value": "Давай уже {format laugh}подпалим{format reset} эту штуку!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_utqc5b_text",
    "notes": "Speaker=Rosie",
    "value": "Не стоило тебе возвращаться сюда.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8jri1u_text",
    "notes": "Speaker=Dorothy",
    "value": "Что ты делаешь?! Рози, отпусти его!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_q1eysc_text",
    "notes": "Speaker=Rosie Notes=*format* *new* changed "he was" to "he's"",
    "value": "Ты знаешь, сколько бомжей покалечилось, пока его схватили? Он чудовище!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_0g9r4c_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Теперь он лишь батарейка в моем робо-костюме, а мне наконец-то хватит сил избавиться от вас!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_icw8pm_text",
    "notes": "Speaker=Dorothy Notes=*new* changed format from nervous to emph",
    "value": "Ты {format emph}лгала{format reset} мне!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_ir71cz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Я {format emph}использовала{format reset} тебя! Ты инструмент! Кому-то нужно было обезвредить эти гадкие устройства.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_d3ola6_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Он построил их, чтобы вытянуть всю энергию из моего Дистиллятора... Но больше этому не бывать!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_pdqri5_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "С этим реактором я смогу полностью контролировать мой народ, ведь я получу... Бесконечный источник бузы!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_rdwldu_text",
    "notes": "Speaker=Rosie",
    "value": "Им больше не придется рыскать вокруг. Они будут сидеть здесь, в безопасности, и {format emph}воздавать мне почести{format reset}.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_03yhdy_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ах, так вот что ты имела в виду, когда говорила, что они только бушуют и дерутся.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_hj0t32_text",
    "notes": "Speaker=invisible_dummy_01 Notes=*new* removed a couple of format tags and just enclosed the whole line",
    "value": "{format nervous}Землетрясения... Реактор - нестабильная технология Вектрона{format reset}...",
  },
  {
    "key": "rosie_boss_intro_03.conversation_jndfz3_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}САМИ ВЫ НЕСТАБИЛЬНЫЕ! Я ЗДЕСЬ ГЛАВНАЯ!{format reset}",
  },
  {
    "key": "rosie_boss_intro_03.conversation_18qzvo_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Сумасшедшая!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8q2tds_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}ДОВОЛЬНО!{format reset}",
  },
  {
    "key": "rosie_boss_intro_02.conversation_iot2uu_text",
    "notes": "Speaker=invisible_dummy_01",
    "value": "{format nervous}Д... Дот?{format reset}",
  },
  {
    "key": "hub_guard_2.conversation_rtuuk8_text",
    "notes": "Speaker=hub_guard_2",
    "value": "А?",
  },
  {
    "key": "hub_guard_2.conversation_4hbzdf_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Привет, а что вы здесь делаете?",
  },
  {
    "key": "hub_guard_2.conversation_n15uxu_text",
    "notes": "Speaker=hub_guard_2",
    "value": "Ыа-а-а-а! Тварь!",
  },
  {
    "key": "run_away_with_rusty_2.conversation_ciyvzv_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Реактор... Сейчас взорвется!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_8qc79q_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Землетрясение здесь все уничтожит...{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_118c4u_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Тебе нужно уходить отсюда!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_qm6zc7_text",
    "notes": "Speaker=Dorothy",
    "value": "Черта с два! Нам {format emph}надо выбираться вместе!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_7421mi_text",
    "notes": "Speaker=Dorothy",
    "value": "Ни за что! Я тебя здесь не оставлю!",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_90knk7_text",
    "notes": "Speaker=Dorothy",
    "value": "Ты не сможешь пройти здесь с нами...",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_0kxcna_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Нет времени спорить. Другой дороги нет. Вы двое, полезайте сюда.",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_cd5m29_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Быстро!",
  },
  {
    "key": "buddy_everyone_left.conversation_ebuimt_text",
    "notes": "Speaker=Dorothy Notes=*new* changed phrasing",
    "value": "Куда все подевались?",
  },
  {
    "key": "buddy_everyone_left.conversation_nr0trv_text",
    "notes": "Speaker=Fen",
    "value": "Хм... чего-то {format nervous}мне жутко страшно.{format reset}",
  },
  {
    "key": "buddy_everyone_left.conversation_5r1v5j_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Нам нужно {format highlight}найти Рози{format reset} и понять, что она задумала.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_17f2xe_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Ого! Наверное, это и есть машина рока.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_jiz6v8_text",
    "notes": "Speaker=Dorothy",
    "value": "Я не хочу верить, что Расти мог сделать что-то подобное...",
  },
  {
    "key": "buddy_first_generator_seen.conversation_nkppty_text",
    "notes": "Speaker=Fen",
    "value": "Похоже, в этой штуке полно кусков от Вектрона.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_5mvh1h_text",
    "notes": "Speaker=Fen",
    "value": "Раздолбаем ее! {format laugh}Ура!{format reset}",
  },
  {
    "key": "buddy_first_generator_seen.conversation_t5tmkl_text",
    "notes": "Speaker=Dorothy",
    "value": "Ничего себе! Это что за штука?",
  },
  {
    "key": "buddy_first_generator_seen.conversation_96wcqq_text",
    "notes": "Speaker=Fen",
    "value": "Похоже на технологию Вектрона.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_3ss3dz_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Раздолбаем ее!",
  },
  {
    "key": "player_oasis_locked.conversation_4kheve_text",
    "notes": "Speaker=Dorothy",
    "value": "Вход блокирован!",
  },
  {
    "key": "player_oasis_locked.conversation_ruxx9o_text",
    "notes": "Speaker=Fen",
    "value": "Думаешь, это из-за землетрясения?",
  },
  {
    "key": "player_oasis_locked.conversation_cct3lh_text",
    "notes": "Speaker=Dorothy",
    "value": "Нам нужно {format highlight}найти другой путь туда{format reset} и поговорить с Рози.",
  },
  {
    "key": "cutscene_fen_04.conversation_s6wiy7_text",
    "notes": "Speaker=Fen",
    "value": "И что, плавать тут в тоске и одиночестве?",
  },
  {
    "key": "cutscene_fen_04.conversation_qzc1ay_text",
    "notes": "Speaker=Fen",
    "value": "У тебя в топке тепло и уютно, а подкалывать тебя очень весело. {format laugh}Хи-хи-хи!{format reset}",
  },
  {
    "key": "cutscene_fen_04.conversation_ruux6m_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Ржа тебя заешь!{format reset} У меня нет времени на это, мне нужно {format highlight}выбираться{format reset} отсюда!",
  },
  {
    "key": "cutscene_fen_04.conversation_34h62o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Хи-хи-хи!{format reset} Кажется, тебе все-таки нужна моя помощь...",
  },
  {
    "key": "cutscene_fen_04.conversation_de9yap_text",
    "notes": "Speaker=Fen",
    "value": "Эта область уже просканирована, так что, {format emph}полагаю{format reset}, ты можешь воспользоваться моей картой.",
  },
  {
    "key": "cutscene_fen_04.conversation_wk05yo_text",
    "notes": "Speaker=Fen",
    "value": "А теперь давай выбираться отсюда!",
  },
  {
    "key": "cutscene_fen_04.conversation_h6d5t0_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Эх! Ладно, пошли, что ли.",
  },
  {
    "key": "fen_haspants.conversation_a9gtqb_text",
    "notes": "Speaker=Fen",
    "value": "Привет! Что здесь делает этот жуткий мутант?",
  },
  {
    "key": "fen_haspants.conversation_hsioxg_text",
    "notes": "Speaker=Dorothy",
    "value": "Фен, это бомж. Не шуми, пусть он спит.",
  },
  {
    "key": "crab.conversation_cl8j2w_text",
    "notes": "Speaker=Handy Gabby Notes=*new*",
    "value": "Бар-гыр!",
  },
  {
    "key": "crab.conversation_erniqz_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Crab is a hideously mutated Shiner. Look like Crab. Talk like people.",
    "value": "Бар-гыр-бар-гар-гур!",
  },
  {
    "key": "crab.conversation_hgy6ga_text",
    "notes": "Speaker=Dorothy",
    "value": "Прошу прощения, я только...",
  },
  {
    "key": "crab.conversation_xsba9s_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Speaks jibberish and half sentences.",
    "value": "Камушки, быр-гыр!",
  },
  {
    "key": "crab.conversation_eottc5_text",
    "notes": "Speaker=Dorothy",
    "value": "Э-э.. Ладно...",
  },
  {
    "key": "crab.conversation_tolx3y_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Бар-гыр!",
  },
  {
    "key": "crab.conversation_cmj0mp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Бар-гыр!",
  },
  {
    "key": "crab.conversation_kqftzz_text",
    "notes": "Speaker=Dorothy Notes=*new* added a introductory line for dorothy",
    "value": "Эй, как тебе удалось забраться так далеко?",
  },
  {
    "key": "crab.conversation_x2c4hn_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Бар-гыр-бар-гар-гур!",
  },
  {
    "key": "crab.conversation_1d144p_text",
    "notes": "Speaker=Dorothy",
    "value": "Извините, но...",
  },
  {
    "key": "crab.conversation_opes3o_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Трубочки, быр-гыр!",
  },
  {
    "key": "crab.conversation_kzffu7_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ладно, но здесь, внизу, небезопасно. Лучше тебе подыскать другое место.",
  },
  {
    "key": "crab.conversation_514n8o_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Бар-гыр!",
  },
  {
    "key": "crab.conversation_rjibkc_text",
    "notes": "Speaker=Dorothy",
    "value": "Ладно, ладно.",
  },
  {
    "key": "crab.conversation_q4yhzp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Бар-гыр!",
  },
  {
    "key": "swimmer.conversation_mo6w8t_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Я тут моюсь. Давно пора. Чтоб не вонять.",
  },
  {
    "key": "swimmer.conversation_i5u7gc_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "А еще я пускаю {format singsong}пузырики.{format reset}",
  },
  {
    "key": "swimmer.conversation_h9b611_text",
    "notes": "Speaker=Dorothy",
    "value": "Да уж, удивительное местечко.",
  },
  {
    "key": "swimmer.conversation_7u1oej_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Это все Рози.. Она в детстве была такая мелкая.",
  },
  {
    "key": "swimmer.conversation_d9pcrg_text",
    "notes": "Speaker=Wet Willy",
    "value": "Щас-то она большая и сильная... И вся буза у нее.",
  },
  {
    "key": "swimmer.conversation_5hc8jc_text",
    "notes": "Speaker=Wet Willy Notes=*format* *new* broke this up into two lines",
    "value": "Искупаться бы в бузе! Тогда бы и {format emph}я{format reset} стал сильным.",
  },
  {
    "key": "swimmer.conversation_dqkik7_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "А Рози к бузе даже не притрагивается. Она тяжести таскает. Вот глупая!",
  },
  {
    "key": "swimmer.conversation_jra7p9_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Хочу бузы!",
  },
  {
    "key": "swimmer.conversation_0ga9xz_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "Мне тут нравится, но эти туннели... они зовут меня...",
  },
  {
    "key": "swimmer.conversation_6i3ly8_text",
    "notes": "Speaker=Wet Willy",
    "value": "Они дрожат и кричат.",
  },
  {
    "key": "swimmer.conversation_l4t4ta_text",
    "notes": "Speaker=Wet Willy",
    "value": "Хочу поплавать в бузе.",
  },
  {
    "key": "swimmer.conversation_brmgbs_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "Она густая и мутная, но я все равно пускаю пузырики.",
  },
  {
    "key": "swimmer.conversation_iyntgs_text",
    "notes": "Speaker=Wet Willy",
    "value": "Меня все время зовут в те туннели!",
  },
  {
    "key": "swimmer.conversation_rb7d43_text",
    "notes": "Speaker=Wet Willy",
    "value": "Видели тех тварей в туннелях?",
  },
  {
    "key": "swimmer.conversation_s21hym_text",
    "notes": "Speaker=Wet Willy",
    "value": "Из них выйдет отличный шашлык!",
  },
  {
    "key": "swimmer.conversation_ky29gq_text",
    "notes": "Speaker=Wet Willy",
    "value": "Только надо их {format singsong}помариновать в бузе.{format reset}",
  },
  {
    "key": "swimmer.conversation_7w4sjb_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "И можно устроить отличный пикник!",
  },
  {
    "key": "swimmer.conversation_4b9cj5_text",
    "notes": "Speaker=Wet Willy",
    "value": "М-м-м, щас бы шашлычка из тварей.",
  },
  {
    "key": "swimmer.conversation_ofc7fu_text",
    "notes": "Speaker=Wet Willy",
    "value": "От бузы я стану сильный! От бузы я стану самолучший!",
  },
  {
    "key": "swimmer.conversation_l41o8r_text",
    "notes": "Speaker=Wet Willy",
    "value": "И смогу ходить на трех ногах.",
  },
  {
    "key": "generator_sequence_break.conversation_hu136t_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ура!{format reset} {format singsong}Внезапный приступ разрушения!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_sfe0sl_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_fjpwyo_text",
    "notes": "Speaker=Dorothy",
    "value": "Фен... Я за тобой вернусь!",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_va1y6u_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Знаю.",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_5idlry_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Иди!",
  },
  {
    "key": "sign_vectron2_2.conversation_x36dp8_text",
    "notes": "Speaker=Dorothy",
    "value": ""ВНИМАНИЕ: НЕ ВХОДИТЬ!"",
  },
  {
    "key": "golden_hatch_open.conversation_p6icsu_text",
    "notes": "Speaker=Fen Notes=*new* chenged this to not be a quesetion",
    "value": "Эти сектанты, просто чокнутые.",
  },
  {
    "key": "golden_hatch_open.conversation_rm0amb_text",
    "notes": "Speaker=Dorothy",
    "value": "Точно.",
  },
  {
    "key": "golden_hatch_open.conversation_4rm6n6_text",
    "notes": "Speaker=Fen",
    "value": "А вот испарять их было весело. Давай поищем, может, они еще где-нибудь остались?",
  },
  {
    "key": "golden_hatch_open.conversation_5q7isk_text",
    "notes": "Speaker=Dorothy",
    "value": "Мне надо {format highlight}найти их пророка{format reset}. Он может знать, где Расти.",
  },
  {
    "key": "player_oasis_locked_2.conversation_jd7aed_text",
    "notes": "Speaker=Fen",
    "value": "Тут столько труб. Может, получится забраться через сток?",
  },
  {
    "key": "player_oasis_locked_2.conversation_5wy6ob_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "У меня такое чувство, что эта труба выведет нас к подземным джунглям.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_444mtr_text",
    "notes": "Speaker=Fen",
    "value": "Смотри, эта штука течет! Как думаешь, зачем она?",
  },
  {
    "key": "fen_entering_yarrow2.conversation_9gicpx_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Не знаю, но она мне не нравится.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_h3f7cn_text",
    "notes": "Speaker=Fen",
    "value": "Наверное, очистная система этих сейсмогенераторов.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_jf4lyk_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Не знаю, что тут творится, но джунгли, похоже, разрастаются.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_tkhd41_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Давай уже, пошли найдем эту машину и разобьем ее!",
  },
  {
    "key": "fen_treasure_brazier.conversation_uo28un_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "Хм, опять эти кристаллы. Не вижу никаких жаровен.",
  },
  {
    "key": "fen_treasure_brazier.conversation_orh8x3_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "Они где-то внутри этого проклятого храма!",
  },
  {
    "key": "fen_treasure_brazier.conversation_fytrwl_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "А вот машины рока здесь нет. Я хочу уничтожить эту штуку {format emph}прямо сейчас!{format reset}",
  },
  {
    "key": "fen_treasure_brazier.conversation_w7ohum_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "Да, ты еще не нашла все жаровни.",
  },
  {
    "key": "fen_treasure_brazier.conversation_r9v53t_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "А я хочу уничтожить машину рока прямо сейчас.",
  },
  {
    "key": "sign_rons_chamber.conversation_ubahwy_text",
    "notes": "Speaker=Dorothy Notes=*new* added new sign. Operating Acolytes is a referenece to Operating Thetan from Scientology",
    "value": ""Сокровищница Рональда. Вход разрешен только прислужникам уровня VI и выше."",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_y2rvga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ворота не движутся. От рычага толку нет.",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_voevwm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Может, нужно как-то {format highlight}подать питание{format reset}?",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_29icwu_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Пока без толку!",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_86fd8m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Я думаю, надо все же как-то {format highlight}подать питание{format reset}.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_one4s1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Эй, новая броня очень крутая. Тебе больше не придется жаловаться на удары и повреждения.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_i2p8ul_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Нет, конечно, совсем беззаботной быть нельзя, но выглядит действительно шикарно, правда ведь?",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_6i6u7w_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А знаешь, что сделает ее еще шикарнее?",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_716uhd_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "{format singsong}Пламя!{format reset}",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_mg2reo_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ух ты! Это устройство превратило мой реактивный двигатель в оружие.",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_3ldyrw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Прелесть! Пошли сожжем парочку растительных мутантов!",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_gbh1g1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Надеюсь, оно и с грязью справиться. Кажется, нас тут завалило!",
  },
  {
    "key": "fen_on_death_pit.conversation_tvs6ch_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Эй, тут же внизу нет ничего опасного, да? Как по мне, безопасно.",
  },
  {
    "key": "fen_on_death_pit.conversation_5oflga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А давай просто разобьем эту стену и посмотрим, что там внизу? {format laugh}Хи-хи-хи!{format reset}",
  },
  {
    "key": "fen_on_death_pit.conversation_6nymg5_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Я думаю, стену тут не зря поставили.",
  },
  {
    "key": "fen_on_death_pit.conversation_a8vok3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "И если мы упадем на самый низ, ты не разобьешься, в отличие от некоторых.",
  },
  {
    "key": "fen_on_death_pit.conversation_pi5rzp_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ох, а где же твоя жажда приключений?",
  },
  {
    "key": "fen_on_lava_sea.conversation_2h7zkh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Вот это {format emph}здоровый бассейн{format reset} расплавленной руды!",
  },
  {
    "key": "fen_on_lava_sea.conversation_tw04k8_text",
    "notes": "Speaker=Dorothy Notes=*new* These -> This",
    "value": "Эта секта и вправду помешалась на этом всем: конец света, огненные реки. Я расплавлюсь, если попытаюсь перейти здесь.",
  },
  {
    "key": "fen_on_lava_sea.conversation_c0o17p_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А может, сунешь ногу и посмотришь? Там не может быть {format emph}настолько{format reset} горячо.",
  },
  {
    "key": "fen_on_lava_sea.conversation_651wxm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Да тут нужна невоспламеняемость!",
  },
  {
    "key": "fen_on_lava_sea.conversation_1hn8s0_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А вот если бы ты была такая же крутая, как я, могла бы просто перелететь через эту штуку.",
  },
  {
    "key": "fen_on_hubtube.conversation_8yyuh8_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Мое дурное предчувствие не проходит. Что-то здесь не так.",
  },
  {
    "key": "fen_on_hubtube.conversation_jytjex_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Когда вернемся в Оазис, Рози придется многое объяснить.",
  },
  {
    "key": "fen_on_hubtube.conversation_g4kaqx_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Надо было с самого начала подозревать худшее!",
  },
  {
    "key": "fen_on_hubtube.conversation_vigvfw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Если бы ты с самого начала подозревала худшее, мне бы так и пришлось торчать в том храме.",
  },
  {
    "key": "fen_on_hubtube.conversation_2h3jtj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А теперь давай выбираться из этого стока. Надо понять, что происходит.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_w0gsxo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Эй! Эти ракеты точь в точь как те, что мы видели по пути сюда.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_n0y3vf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Попробуй вдарь по ним киркой!",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_nctmv1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Кто бы мог подумать, что я вернусь в этот храм.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_77tocr_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "А здесь просторно, не сравнить с тем закутком.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_jpag4c_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Когда сидишь внутри тотема, других частей храма особо не видно.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_rzcgxv_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Здесь должно быть полно смертельных ловушек и всяких крутых штук.",
  },
  {
    "key": "aftermath_elmachino.conversation_hbejz0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "{format nervous}Эй!{format reset} А ну, с дороги! Сначала спасайте мэров и детей!",
  },
  {
    "key": "aftermath_elmachino.conversation_ma479g_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}Извините! Э... Я делаю, что могу!{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_fudqd9_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Народ, успокойтесь! По одному! Становитесь в очередь, слышите!",
  },
  {
    "key": "aftermath_elmachino.conversation_pox4ng_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Эй! Нет времени в очередях стоять! Просто лезьте в ракету, пока тут все не разлетелось на куски!",
  },
  {
    "key": "aftermath_elmachino.conversation_ewm51b_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Челюсть прикрути! В проклятой шахте еще есть боты. Мы своих не бросаем!",
  },
  {
    "key": "aftermath_elmachino.conversation_tdyz6x_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Мистер Хейзенберг готов запускать ракету, и я могу задержать вылет только на пару минут... А потом {format emph}стартуем{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_vtsrcc_text",
    "notes": "Speaker=Barnacle Jones? Notes=*new*",
    "value": "{format nervous}Бип-бип{format reset}, быр-гыр!",
  },
  {
    "key": "aftermath_elmachino.conversation_9s60lp_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Да! Золотые слова, Клешнерукий!",
  },
  {
    "key": "aftermath_elmachino.conversation_qo44wn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Что? Я ни слова не говорил.",
  },
  {
    "key": "aftermath_elmachino.conversation_353gqh_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "{format nervous}Ржа их съешь!{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_1engeq_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Ох, вот и ты, милочка! Ты цела, вот радость-то!",
  },
  {
    "key": "aftermath_elmachino.conversation_ch1z21_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Замечательно! Я уже волновался, что ты потерялась.",
  },
  {
    "key": "aftermath_elmachino.conversation_tb8wpb_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Вижу, ты нашла шахтера с красным шарфом. Но где то сияющее существо, что было с тобой?",
  },
  {
    "key": "aftermath_elmachino.conversation_pbnvye_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Это... Это долгая история. Пришлось...",
  },
  {
    "key": "aftermath_elmachino.conversation_u2fefz_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Что ж, я рада видеть вас целыми и невредимыми, но должна напомнить: {format emph}время вышло{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_hi1tn7_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Все на борт ракеты!",
  },
  {
    "key": "aftermath_elmachino.conversation_t4edhq_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Пришло время паровых космоботов! {format singsong}И-и-и-ха!{format reset}",
  },
  {
    "key": "guard_open_hatch_post.conversation_as8gn2_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "И последнее замечание, мисс.",
  },
  {
    "key": "guard_open_hatch_post.conversation_3qlskx_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Вы собираетесь исследовать огромный загадочный мир там, внизу...",
  },
  {
    "key": "guard_open_hatch_post.conversation_24mz6s_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Чтобы отслеживать, куда вы направляетесь, можно использовать отметки на карте ({image quest_pointer_arrow} и {image quest_pointer_crosshair}).",
  },
  {
    "key": "guard_open_hatch_post.conversation_4j1s12_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Их использование - свидетельство ума и зрелости.",
  },
  {
    "key": "guard_open_hatch_post.conversation_mdsij3_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "И не умаляет храбрости.",
  },
  {
    "key": "guard_open_hatch_post.conversation_vaf0gm_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Вы, вероятно, уже обратили внимание на синие стрелки ({image quest_pointer_arrow}) и крестики ({image quest_pointer_crosshair}) на карте.",
  },
  {
    "key": "guard_open_hatch_post.conversation_4zvbgq_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Если не пользоваться отметками, ваш путь может стать классическим приключением. Сами решайте, хорошо это или плохо...",
  },
  {
    "key": "guard_open_hatch_post.conversation_9ah4fv_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Но не волнуйтесь. Отметки можно включить и выключить в любой момент на вкладке модификаций в мастерской.",
  },
  {
    "key": "guard_open_hatch_post.conversation_rkswy7_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Так что скажете? Вы выбираете использовать отметки ({image quest_pointer_arrow} и {image quest_pointer_crosshair}), чтобы указать путь?",
  },
  {
    "key": "guard_open_hatch_post.conversation_w3uj01_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Как я уже говорил...",
  },
  {
    "key": "guard_open_hatch_post.conversation_bw07t1_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Включайте и выключайте отметки по собственному желанию. Это можно сделать в мастерской в городе.",
  },
  {
    "key": "guard_open_hatch_post.conversation_dvacv4_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Все, больше не буду вас задерживать. Желаю удачи {format highlight}с прочисткой труб{format reset} в Краснокаменном штреке.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_wamta4_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Эй, это похоже на технологию Вектрона!",
  },
  {
    "key": "fen_on_teleporter_2.conversation_lkvb6m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Но, кажется, оно не работает.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_ocl1pj_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_llzd7n_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Фен?",
  },
  {
    "key": "fen_on_teleporter_2.conversation_74v2pp_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_hi83wt_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Кажется, здесь тупик. Давай выбираться.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_u4cd0d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Что это, Фен?",
  },
  {
    "key": "fen_on_teleporter_1.conversation_3rpf0f_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Я не хочу идти {format emph}туда{format reset}. Давай повернем.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_supvbe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Нам есть чем заняться в шахтах.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_tm3xhy_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Это бассейн из расплавленной руды, да?",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_35yo2u_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Думаю, в этот раз нам {format emph}придется{format reset} перебраться через него.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_mhir26_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Хорошо, что ты теперь такая же крутая, как и я, так что...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_fnd2g3_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ну почти.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b0opbb_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Вот это {format emph}здоровый бассейн{format reset} расплавленной руды!",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_17hzlg_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Секта и вправду помешалась на этом всем: конец света, огненные реки.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b7hr8v_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Давай уже перейдем через него.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_alk15j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Точно! Знаешь, с новым оборудованием твоя крутость уже равна моей...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_qa992m_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ну почти.",
  },
  {
    "key": "fen_on_totem.conversation_2ou9oe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Смотри! Остатки моего старого тотема.",
  },
  {
    "key": "fen_on_totem.conversation_wz87u3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Такое ощущение, что уже сто лет прошло с нашей встречи, правда?",
  },
  {
    "key": "fen_on_totem.conversation_qxncbz_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Угу... Но не могу сказать, что скучаю по своему пребыванию {format emph}здесь.{format reset}",
  },
  {
    "key": "fen_on_totem.conversation_rvd9qx_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Да, испарять сектантов было весело и все такое, но ведь приходилось сидеть тут безвылазно.",
  },
  {
    "key": "fen_on_distillery_door.conversation_flred4_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "В открытом виде оно выглядит еще страшнее.",
  },
  {
