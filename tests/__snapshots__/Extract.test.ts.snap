  {
    "key": "upgrades.upgrade_lamp",
    "value": "Lampada",
  },
  {
    "key": "upgrades.upgrade_broken_lamp",
    "value": "Lampada Rotta",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_desc",
    "notes": "Dorothy fell and broke her lamp.",
    "value": ""Rotta dopo un brusco atterraggio, necessita di essere riparata o sostituita con urgenza."",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_next_level_desc",
    "value": "Ripara la lampada per poter entrare nella miniera.",
  },
  {
    "key": "upgrades.upgrade_lamp_desc",
    "value": "Illumina l'area intorno a te. Consuma carburante nel tempo, di cui si può far rifornimento in città.",
  },
  {
    "key": "upgrades.upgrade_lamp_next_level_desc",
    "value": "Potenzia la lampada per ridurre il consumo di carburante.",
  },
  {
    "key": "upgrades.upgrade_lamp_01",
    "notes": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    "value": "Lampada di Scarsa Qualità",
  },
  {
    "key": "upgrades.upgrade_lamp_01_desc",
    "value": ""Non è rotta, perlomeno."",
  },
  {
    "key": "upgrades.upgrade_lamp_02",
    "value": "Luce del Minatore",
  },
  {
    "key": "upgrades.upgrade_lamp_02_desc",
    "value": ""Una combustione più economica."",
  },
  {
    "key": "upgrades.upgrade_lamp_03",
    "value": "Lampada a Carburo Modificata",
  },
  {
    "key": "upgrades.upgrade_lamp_03_desc",
    "value": ""Una fiamma migliore grazie a un controllo del flusso ottimizzato."",
  },
  {
    "key": "upgrades.upgrade_lamp_04",
    "value": "Stella Polare",
  },
  {
    "key": "upgrades.upgrade_lamp_04_desc",
    "notes": "Rudolf the Red nose reindeer – lyrics pun.",
    "value": ""C'era una stella che danzava, e sotto quella sono nata."",
  },
  {
    "key": "upgrades.upgrade_lamp_05",
    "value": "Lanterna",
  },
  {
    "key": "upgrades.upgrade_lamp_05_desc",
    "notes": "Green Lantern pun – Green lantern inaguration text.",
    "value": ""Nel giorno più splendente, nella notte più profonda, nessun metallo sfugga alla mia ronda."",
  },
  {
    "key": "upgrades.upgrade_lamp_06",
    "notes": "The Alexandrian Lighthouse",
    "value": "Luce di Pharos",
  },
  {
    "key": "upgrades.upgrade_lamp_06_desc",
    "value": ""Rinforzato con piombo colato per resistere alla prova del tempo."",
  },
  {
    "key": "upgrades.upgrade_lamp_07",
    "notes": "*NEW* Name meaning "Unconquered Sun", Official sun god of the later Roman Empire and also reference to Emperor Constantines old roman coins with inscription SOL INVICTO COMITI = Commited to the Invincible Sun",
    "value": "Sol Invictus",
  },
  {
    "key": "upgrades.upgrade_lamp_07_desc",
    "value": ""Inginocchiati davanti al potere del Sole Invincibile, o almeno fai buon uso del fascio di luce più ampio."",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01",
    "notes": "Backstreet Boys pun, lyrics from """Larger than Life""" too for flare.",
    "value": "Luce del Cammino",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01_desc",
    "value": "Aumenta l'ampiezza della luce della tua lampada.",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01_flavor",
    "notes": "Backstreet Boys pun, lyrics from "Larger than Life" too for flare.",
    "value": ""Luce Cammina con Me."",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01",
    "value": "Evocatore",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01_desc",
    "notes": " new: minor rephrasing",
    "value": "Aggiunge la possibilità di rilascio di un globo di luce extra dai nemici sconfitti.",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01_flavor",
    "value": ""Libera il loro sole interiore."",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01",
    "notes": "Movie Eternal Sunshine on the spotless mind.",
    "value": "Eterno Fulgore",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01_desc",
    "value": "Impedisce alla tua luce di andare al di sotto del 50%%.",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01_flavor",
    "value": ""Non sarai mai solo nell'oscurità."",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01",
    "notes": "Song: I am the God of hellfire by Arthur Brown*NOT CURRENTLY USED*",
    "value": "Ingranaggio Infernale",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Infligge danni ai nemici all'interno della tua luce.",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01_flavor",
    "notes": "*NOT CURRENTLY USED*",
    "value": ""Scatenate l'inferno!"",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01",
    "notes": " Kubera – Hindu Mythology Lord of Wealth, Quote is from Thomas Aquinas",
    "value": "Fiamma di Kubera",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01_desc",
    "value": "Fa sì che gli oggetti emettano luce, rendendoli più facili da trovare.",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01_flavor",
    "value": ""È meglio illuminare che brillare per sé stessi."",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes",
    "notes": " Gordon is a reference to character Flash Gordon and particularily important is the ""Flash"" part which is referencing this upgrade being for the light."",
    "value": "Riflessi di Gordon",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes_desc",
    "value": "Aumenta la possibilità di evitare automaticamente le rocce che cadono e altre trappole mortali simili.",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes_flavor",
    "notes": "*NEW* Quote is a reference to Queen Song "Flash" and the lyrics- He save with a mighty hand every man, every woman every child, with a mighty Flash",
    "value": ""Salvati in un flash!"",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness",
    "notes": " Text from Pink Floyd's song Another brick in the wall: We don't need no education ,We don't need no thought control, All in all you're just another brick in the wall . Quote by Joseph Ford Newton regarding intolerans, hate and not enough love in the world.",
    "value": "Occhio per i dettagli",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness_desc",
    "value": "Ti permette di vedere le parti deboli di un muro quando lo illumini. Parlare al muro non serve, basta guardarlo.",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness_flavor",
    "value": ""Gli uomini costruiscono troppi muri e troppi pochi ponti."",
  },
  {
    "key": "upgrades.upgrade_pickaxe",
    "value": "Piccone",
  },
  {
    "key": "upgrades.upgrade_pickaxe_desc",
    "value": "L'attrezzo principale usato da Dorothy per scavare.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_next_level_desc",
    "notes": " This means that whatever you hit, you'll need to hit it two times less when you equip this cog in your Pickaxe",
    "value": "Potenzia il piccone per migliorarne l'efficacia.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_01",
    "notes": "it's rusty",
    "value": "Piccone Arrugginito",
  },
  {
    "key": "upgrades.upgrade_pickaxe_01_desc",
    "value": ""Ha fatto il suo tempo, senza dubbio."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_02",
    "value": "Classico Piccone di Ferro",
  },
  {
    "key": "upgrades.upgrade_pickaxe_02_desc",
    "value": ""L'attrezzo di base di un minatore."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_03",
    "notes": " Bardur is an Icelandic half-troll half-man from their mythology.",
    "value": "Piccone con Impugnatura di Bardur",
  },
  {
    "key": "upgrades.upgrade_pickaxe_03_desc",
    "value": ""Un compagno semplice ma robusto."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_04",
    "notes": "Pun on Pikachu",
    "value": "Piccon-chu",
  },
  {
    "key": "upgrades.upgrade_pickaxe_04_desc",
    "notes": "Based on the old Japanese Cho measuring system, cho, an ancient Japanese unit of length approximately equal to 109.1 meters",
    "value": ""Accuratamente calibrato con un tradizionale sistema di misura giapponese."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_05",
    "notes": " Reordered some names",
    "value": "Piccone in Lega d'Acciaio",
  },
  {
    "key": "upgrades.upgrade_pickaxe_05_desc",
    "notes": " Reordered some names",
    "value": ""Questo trattamento al carbonio brevettato dona ai tuoi colpi un magnifico equilibrio."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_06",
    "notes": " Reordered some names",
    "value": "Piccone in Tungsteno",
  },
  {
    "key": "upgrades.upgrade_pickaxe_06_desc",
    "notes": " Reordered some names",
    "value": ""La densità e la robustezza perfetta per la migliore esperienza di scavo."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_07",
    "notes": " Reordered some names",
    "value": "Piccone dell'Arido Nord",
  },
  {
    "key": "upgrades.upgrade_pickaxe_07_desc",
    "notes": " Reordered some names",
    "value": ""Più durevole ed efficace. Proprio ciò che serve per l'arido Nord."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_08",
    "notes": " Reordered some names",
    "value": "Piccone dei Templari",
  },
  {
    "key": "upgrades.upgrade_pickaxe_08_desc",
    "notes": " Reordered some names",
    "value": ""Bilanciato alla perfezione. Sembra quasi che scavi da solo."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01",
    "notes": "This is an upgrade for the pickaxe",
    "value": "Punta Affilata",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01_desc",
    "value": "Infligge danni extra ai nemici.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01_flavor",
    "notes": "From song The first cut is the deepest.",
    "value": ""Il primo colpo non si scorda mai."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01",
    "notes": "Pun on movie title Midnight Express",
    "value": "Scheggia Come un Scheggia",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01_desc",
    "notes": " new: minor rephasing",
    "value": "Un assetto aerodinamico migliorato per velocizzare i tuoi colpi.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01_flavor",
    "notes": "Old Duke Ellington song.",
    "value": ""Si vive e si muore alla velocità della luce!"",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01",
    "value": "Delirio di Risorse",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01_desc",
    "value": "Infligge danni extra alle mattonelle che contengono risorse.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01_flavor",
    "notes": "Spoof on Patrik Swayzee line from Roadhouse: My way or the highway",
    "value": ""Le mattonelle non sono quello che sembrano."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_knockback_01",
    "notes": "Movie Total Recall",
    "value": "Impatto Imminente",
  },
  {
    "key": "upgrades.upgrade_pickaxe_knockback_01_desc",
    "value": "Respinge ulteriormente i nemici all'impatto.",
