  {
    "key": "buddy_first_generator_seen.conversation_nkppty_text",
    "notes": "Speaker=Fen",
    "value": "Sembra che ci siano parecchie parti di Vectron dentro questo aggeggio.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_5mvh1h_text",
    "notes": "Speaker=Fen",
    "value": "Distruggiamolo! {format laugh}Wooh!{format reset}",
