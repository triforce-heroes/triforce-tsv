  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity",
    "notes": "Pun on Molotov Cocktail",
    "value": "Vaccino contro le Molotov",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity_desc",
    "value": "Impedisce alle Bombe a Pressione di danneggiarti.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity_flavor",
    "value": ""Come restare immuni dai pericoli? Basta vaccinarsi."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple",
    "notes": " ThreeForce is a reference to the Legend of Zelda TriForce, The quote is just a rhyme and not important.",
    "value": "Granata Triforza",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple_desc",
    "value": "Quando carichi per sparare una Granata a Pressione, ti consente di sparare ben tre Granate a Pressione!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple_flavor",
    "value": ""Tripla sorpresa!"",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb",
    "notes": " Norman Greenbaum song lyrics Spirit in the sky, pun on somebody being a mean spirit = bad and mean to people.",
    "value": "Assalto dai Cieli",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_desc",
    "value": "Ti consente di usare le Bombe a Pressione mentre sei in aria, quindi spicca il volo e lancia le tue bombe da una distanza di sicurezza!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_flavor",
    "value": ""Degno della più spietata divinità dei cieli!"",
  },
  {
    "key": "upgrades.upgrade_jackhammer",
    "value": "Martello Pneumatico",
  },
  {
    "key": "upgrades.upgrade_jackhammer_desc",
    "value": "Un eccezionale attrezzo da scavo che distrugge i materiali troppo duri per il piccone. Funziona ad acqua. Tieni premuto {indicator tool_jackhammer} per una maggiore potenza!",
