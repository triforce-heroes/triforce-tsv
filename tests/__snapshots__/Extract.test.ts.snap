  {
    "key": "upgrades.upgrade_backpack_discard_give_health_flavor",
    "value": ""Ricicla il presente, salva il futuro."",
  },
  {
    "key": "upgrades.upgrade_backpack_lower_death_penalty_01",
    "value": "Lo Sconto del Mietitore",
