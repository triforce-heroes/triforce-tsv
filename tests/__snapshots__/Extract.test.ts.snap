  {
    "key": "resource_description_value",
    "metadata": {
      "raw": " A paragraph in resource descriptions, stating its individual value. %1% is the value.",
    },
    "value": "Valore individuale $%1%{image money_small}.",
  },
  {
    "key": "resource_trashium",
    "metadata": {
      "raw": "*DEMO*",
    },
    "value": "Rifiutonio",
  },
  {
    "key": "resource_trashium_desc",
    "value": "In parole povere, parti di metallo di scarto saldate insieme dalla forza della natura.",
  },
  {
    "key": "resource_copper",
    "value": "Rame",
  },
  {
    "key": "resource_copper_desc",
    "value": "La grande forza del rame e la sua bassa resistenza ne fanno un conduttore elettrico efficace e affidabile.",
  },
  {
    "key": "resource_cinnabar",
    "value": "Cinabro",
  },
  {
    "key": "resource_cinnabar_desc",
    "metadata": {
      "raw": "Vermillion is a scarlet pigment made of Cinnabar, expression "you look like a million dollars"",
    },
    "value": "Solfuro di mercurio: un minerale brillante e tossico, utilizzato nell'antichità come pigmento. Avrai l'aspetto di un Vermiglione di dollari!",
  },
  {
    "key": "resource_ironium",
    "metadata": {
      "raw": "Like irony",
    },
    "value": "Ferronico",
  },
  {
    "key": "resource_ironium_desc",
    "value": "Relativamente morbido nella sua forma più pura, una volta scaldato si indurisce notevolmente.",
  },
  {
    "key": "resource_cornflorium",
    "metadata": {
      "raw": "From cornflower blue, color from the flower",
    },
    "value": "Fiordalonio",
  },
  {
    "key": "resource_cornflorium_desc",
    "value": "Molto raro in natura. Particolarmente noto tra gli artigiani dei bassi Paesi Bassi, per il suo bluissimo blu.",
  },
  {
    "key": "resource_obsidian",
    "metadata": {
      "raw": "Spoof on Yngwie Malmsteen - swedish famous guitarr virtuoso",
    },
    "value": "Yngwinio",
  },
  {
    "key": "resource_obsidian_desc",
    "value": "Un minerale per veri maestri, della famiglia magmatica Malmsteen.",
  },
  {
    "key": "resource_silver",
    "value": "Argento",
  },
  {
    "key": "resource_silver_desc",
    "metadata": {
      "raw": "Werewolves are best killed with silver",
    },
    "value": "Un materiale che si può rivelare utile nel caso che un'orda di lupi mannari invada il tuo cortile. E prima o poi accadrà. È solo questione di tempo.",
  },
  {
    "key": "resource_zoinkonium",
    "value": "Zoinkonio",
  },
  {
    "key": "resource_zoinkonium_desc",
    "metadata": {
      "raw": "Spoof on video game company Zoink and their titles Zombie Vikings and Stick it to the man",
    },
    "value": "Un leggero ma persistente odore di idromele circonda questo materiale semplice ma colorato.",
  },
  {
    "key": "resource_gold",
    "value": "Oro",
  },
  {
    "key": "resource_gold_desc",
    "metadata": {
      "raw": "connectors = gold are used in technology",
    },
    "value": "Un metallo regale che lascia a scavatori e minatori un desiderio incontrollabile di trovarne di più. La scelta di investitori e connettori dal 3000 a.C.",
  },
  {
    "key": "resource_lazurite",
    "value": "Lazurite",
  },
  {
    "key": "resource_lazurite_desc",
    "value": "Un fragile minerale molto ricercato per il suo uso nella pittura e nelle tinture come pigmento.",
  },
  {
    "key": "resource_saturnium",
    "metadata": {
      "raw": "Saturnus, god of fertility",
    },
    "value": "Saturnio",
  },
  {
    "key": "resource_saturnium_desc",
    "value": "I contadini sostenevano che avesse un impatto positivo sul raccolto, e per questo motivo veniva posizionato sui campi durante la stagione della semina.",
  },
  {
    "key": "resource_plutonium",
    "value": "Plutonio",
  },
  {
    "key": "resource_plutonium_desc",
    "metadata": {
      "raw": "Shiner Wars is an old conflict preceeding the game story, Pluto = disney dog",
    },
    "value": "Un elemento chimico ampiamente usato durante la fine della Grande guerra dei Grappisti. In seguito, ha spostato l'ago della bilancia senza portare benefici a nessuno. Al contrario di quanto si crede, non deve il suo nome a un famoso cane.",
  },
  {
    "key": "resource_meteorum",
    "value": "Roccia Meteorica",
  },
  {
    "key": "resource_meteorum_desc",
    "metadata": {
      "raw": "Nod to Game Maniac Mansion and the antagonist Dr Fred Edison, also the game creators Gilbert and Winnick",
    },
    "value": "Scoperta per la prima volta nei pressi di una villa all'incrocio tra Gilbert Avenue e Winnick Road.",
  },
  {
    "key": "resource_unobtainium",
    "metadata": {
      "raw": "Just a spoof on the word unobtainable",
    },
    "value": "Introvabilanio",
  },
  {
    "key": "resource_unobtainium_desc",
    "value": "Nessuno si è mai illuso di poterlo trovare, e per questo non c'è alcuna informazione disponibile. Peccato.",
  },
  {
    "key": "resource_darkmatter",
    "value": "Materia Oscura",
  },
  {
    "key": "resource_darkmatter_desc",
    "metadata": {
      "raw": "Play with mothers comments on dating bad boys",
    },
    "value": "La materia per cui genitori e insegnanti continuano a tormentarti. Giorni, e persino settimane passate sui libri non ti basterebbero comunque per... oh, scusa, errore mio.",
  },
  {
    "key": "resource_sodium",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Sodio",
  },
  {
    "key": "resource_sodium_desc",
    "value": "Un contatto continuo con la sua polvere soffice, bianca e luminosa può causare una rapida disidratazione.",
  },
  {
    "key": "resource_aluminium",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Alluminio",
  },
  {
    "key": "resource_aluminium_desc",
    "value": "Il metallo più abbondante e diffuso sul pianeta. Perfetto per creare contenitori per le comuni bevande degli umani.",
  },
  {
    "key": "resource_beryl",
    "value": "Berillio",
  },
  {
    "key": "resource_beryl_desc",
    "value": "Si pensa che sia capace di trasformare i sogni e i desideri in realtà, nonché di eliminare le energie negative.",
  },
  {
    "key": "resource_azurite",
    "metadata": {
      "raw": "Azurite just sounds like these two expressions put together – Do as you want with this :)",
    },
    "value": "Azzurrite",
  },
  {
    "key": "resource_azurite_desc",
    "value": " La combinazione tra "azzurro" e "dermatite".",
  },
  {
    "key": "resource_tremolite",
    "value": "Tremolite",
  },
  {
    "key": "resource_tremolite_desc",
    "metadata": {
      "raw": "Dr Dre = music producer and rapper – Dr Tre is a made up brother to make a pun on the resource name – mole pun molite",
    },
    "value": " Un minerale noto per le sue vibrazioni positive, le quali influenzano l'umore di chiunque si avvicini facendolo fremere di gioia per qualche secondo.",
  },
  {
    "key": "resource_topaz",
    "value": "Topazio",
  },
  {
    "key": "resource_topaz_desc",
    "value": "Permea l'ambiente circostante con una radiosa aura rilassante. La varietà di colore viola è estremamente rara.",
  },
  {
    "key": "resource_ametrine",
    "value": "Ametrina",
  },
  {
    "key": "resource_ametrine_desc",
    "metadata": {
      "raw": "The spanish queen was said to have been given an ametrine stone as gift from the first batch leaving the mines",
    },
    "value": "Una pietra rara che si dice abbia strani poteri. Si pensa che l'esemplare più grande sia sepolto sotto la tomba di una regina spagnola.",
  },
  {
    "key": "resource_diamond",
    "value": "Diamante",
  },
  {
    "key": "resource_diamond_desc",
    "metadata": {
      "raw": "Margareth Thatcher was chosen for her reputation as cold hearted – feel free to exchange for other politician of your country!",
    },
    "value": "Un grande classico, duro e freddo come un abbraccio di Margaret Thatcher. Che tu sia uomo o donna, i diamanti saranno i tuoi migliori amici, per sempre.",
  },
  {
    "key": "resource_bismuth",
    "value": "Bismuto",
  },
  {
    "key": "resource_bismuth_desc",
    "metadata": {
      "raw": "Bismuth sounds a bit like Bismarck, thats why the pun is on German Otto Bismarck, but if the mineral is named something else in your country, feel free to pun away :) https://en.wikipedia.org/wiki/Otto_von_Bismarck",
    },
    "value": "Scoperto intorno al 1400 d.C. da un misterioso alchimista. Spesso confuso con il piombo o con qualche specie di animale.",
  },
  {
    "key": "resource_imagenite",
    "value": "Imaginite",
  },
  {
    "key": "resource_imagenite_desc",
    "metadata": {
      "raw": "A pun on song from John Lennon Imagine – imagine there's no heaven, and no religion too",
    },
    "value": "È oggetto di un acceso dibattito tra i minatori. Esiste veramente? Imaginite there's no Heavenite, and no Religionite too.",
  },
  {
    "key": "resource_amethyst",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Ametista",
  },
  {
    "key": "resource_amethyst_desc",
    "value": "La sua luce darà conforto alla tua sofferenza, stimolerà le tue emozioni e ti convincerà a tornare alla ricerca del vero amore.",
  },
  {
    "key": "resource_blooddrop",
    "value": "Goccia di Sangue",
  },
  {
    "key": "resource_blooddrop_desc",
    "value": "Un concentrato di rabbia eliotropica proveniente da creature della penombra.",
  },
  {
    "key": "resource_bloodstone",
    "value": "Pietra di Sangue",
  },
  {
    "key": "resource_bloodstone_desc",
    "value": "Questo eliotropo ripristina la lucidità mentale di chi la possiede",
  },
  {
    "key": "resource_bloodrock",
    "value": "Roccia di Sangue",
  },
  {
    "key": "resource_bloodrock_desc",
    "value": "Paura e cattive intenzioni coagulate. Affina i sensi ma annebbia gli occhi della mente.",
  },
  {
    "key": "resource_vectron",
    "value": "Criptio n. 5-1 16.17.4.8",
