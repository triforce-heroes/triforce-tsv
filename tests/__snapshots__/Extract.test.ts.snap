    "notes": "*NOT CURRENTLY USED*",
    "value": "Sparfuchs",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_improved_water_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Der Wasserverbrauch wird um die Hälfte reduziert.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_improved_water_flavor",
    "notes": "*NOT CURRENTLY USED* Biblical referense to Moses",
    "value": ""Wer spart, der hat."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup",
    "value": "Aquabombe",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup_desc",
    "value": "Durch Druckbomben zerstörte Felder hinterlassen eine zusätzliche Wasserkugel.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup_flavor",
    "notes": "Reference to band Wet Wet Wet and their song Love is all around",
    "value": ""Wasser gibt es überall."",
