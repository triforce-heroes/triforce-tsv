  {
    "key": "upgrade_lamp",
    "value": "Lampe",
  },
  {
    "key": "upgrade_broken_lamp",
    "value": "Kaputte Lampe",
  },
  {
    "key": "upgrade_broken_lamp_desc",
    "metadata": {
      "raw": "Dorothy fell and broke her lamp.",
    },
    "value": ""Wurde nach einer harten Landung beschädigt und muss dringend repariert oder ersetzt werden."",
  },
  {
    "key": "upgrade_broken_lamp_next_level_desc",
    "value": "Repariere die Lampe, um Zugang zu den Minen zu erlangen.",
  },
  {
    "key": "upgrade_lamp_desc",
    "value": "Erhellt deine Umgebung. Verbraucht mit der Zeit Brennstoff, der in der Stadt aufgefüllt werden kann.",
  },
  {
    "key": "upgrade_lamp_next_level_desc",
    "value": "Verbessere die Lampe, um den Brennstoffverbrauch zu reduzieren.",
  },
  {
    "key": "upgrade_lamp_01",
    "metadata": {
      "raw": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    },
    "value": "Verbeulte Lampe",
  },
  {
    "key": "upgrade_lamp_01_desc",
    "value": ""Sie ist nicht mehr kaputt, aber das ist auch wirklich alles."",
  },
  {
    "key": "upgrade_lamp_02",
    "value": "Minenarbeiterlampe",
  },
  {
    "key": "upgrade_lamp_02_desc",
    "value": ""Viel ökonomischer, wenn es um die Brenndauer geht."",
  },
  {
    "key": "upgrade_lamp_03",
    "value": "Veredelte Hartmetall-Lampe",
  },
  {
