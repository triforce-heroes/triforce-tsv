exports[`extract(tests\\fixtures\\de_conversations.csv) function > matches snapshot > tests\\fixtures\\de_conversations.csv 1`] = `
[
  {
    "key": "buddy_inventory_full.conversation_yjp8nk_text",
    "notes": "Speaker=Fen Notes=Comes up when your inventory is full anyou try to pick up more ores.",
    "value": "Hey, deine {format highlight}Tasche ist randvoll{format reset}, Doofy.",
  },
  {
    "key": "ore_vendor.conversation_hxfr0f_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* added "there"",
    "value": "Na, hast du was tolles für mich?",
  },
  {
    "key": "ore_vendor.conversation_jh3i2m_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Hast du ein paar Steine gefunden, die du gegen ein bisschen Knete eintauschen möchtest?",
  },
  {
    "key": "ore_vendor.conversation_69vpc2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo. Moved this node",
    "value": "Nun, hast du etwas nützliches, das du mit mir Handeln möchtest.",
  },
  {
    "key": "ore_vendor.conversation_mi3myw_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Na los! Lass uns ein paar Geschäfte machen, du und ich.",
  },
  {
    "key": "ore_vendor.conversation_2l670i_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Nun, was hast du diesmal für mich?",
  },
  {
    "key": "ore_vendor.conversation_89hare_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Jetzt zeig mal her, was du da unten gefunden hast.",
  },
  {
    "key": "ore_vendor.conversation_dfflv5_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Nun, ich nehme dir trotzdem jedes Erz aus den Klemmen.",
  },
  {
    "key": "ore_vendor.conversation_dvsj68_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Bürgermeister Yonker mag ein Trottel sein, aber diesmal hat er recht. Das Erz muss fließen!",
  },
  {
    "key": "ore_vendor.conversation_gk3axq_text",
    "notes": "Speaker=Barnacle Jones Notes=*format* Hair on steambots is made of metal.",
    "value": "Er schwitzt wohl so sehr wegen der Sache, sein Haar rostet schon, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_mosq62_text",
    "notes": "Speaker=Barnacle Jones Notes=" clamps" is the equivavlent of hands, since they are robots.",
    "value": "Und ich, ich nehme jedes Erz aus den Klemmen eines Minenarbeiters – egal wie, wo und wann.",
  },
  {
    "key": "ore_vendor.conversation_fnygz1_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll-face to kiddo.",
    "value": "Gibt nichts Wichtigeres, als den Erznachschub am Fließen zu halten, Schätzelein.",
  },
  {
    "key": "ore_vendor.conversation_7dsj17_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich hörte, dass wir einen neuen Bot für die Arbeit in den Minen gefunden haben.",
  },
  {
    "key": "ore_vendor.conversation_mh0ja0_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich bin auf der Suche nach einem Freund. Ruhiger Typ, trägt einen roten Schal.",
  },
  {
    "key": "ore_vendor.conversation_y6ys6p_text",
    "notes": "Speaker=Barnacle Jones Notes=Real McCoy= the real deal.",
    "value": "Den Bot kenne ich! Sah vielversprechend aus, aber verdammt war der eine Enttäuschung.",
  },
  {
    "key": "ore_vendor.conversation_0lzsu6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ist nicht einmal zurück nach oben gekommen, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_bhqgnn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    "value": "Ich Hoffe, du machst einen besseren Job, Schätzchen.",
  },
  {
    "key": "ore_vendor.conversation_21a760_text",
    "notes": "Speaker=Barnacle Jones Notes=Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    "value": "Ich nehme mal an, du hast von den verstopften Röhren gehört.",
  },
  {
    "key": "ore_vendor.conversation_oxkxen_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Nun, ich tratsche ja nicht gern, aber ich hörte, der Bürgermeister hat sie geschlossen, um es seinen Bergarbeiterbot-Brüdern heimzuzahlen.",
  },
  {
    "key": "ore_vendor.conversation_2zloko_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Und apropos, Ich habe diese Trottel seit einer Weile nicht mehr gesehen.",
  },
  {
    "key": "ore_vendor.conversation_xwxxg4_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich war der Hoffnung, sie würden mal ein bisschen Gas geben, jetzt wo es durch dich Konkurrenz gibt.",
  },
  {
    "key": "ore_vendor.conversation_gmenrv_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Hätte es besser wissen sollen, als von diesen Spätzündern harte Arbeit zu erwarten.",
  },
  {
    "key": "ore_vendor.conversation_xkngbf_text",
    "notes": "Speaker=Barnacle Jones Notes=mazumas= slang for money, please do translate.",
    "value": "Wie auch immer, durch die Schließung der Röhren verliere ich einen Haufen Knete, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_xfxkz8_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Viele Reichtümer warten nur darauf, unter diesen Schichten aus Ziegeln und Mörtel gefunden zu werden.",
  },
  {
    "key": "ore_vendor.conversation_op5xlx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Wenn du auf irgendwelche Schnapsis treffen solltest, hau sie um, bevor sie das Gleiche mit dir machen.",
  },
  {
    "key": "ore_vendor.conversation_whma58_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Von dem, was ich gehört habe, sollen sie die ganze Zeit vom Mondsaft benebelt ... und auf der Suche nach Streit sein.",
  },
  {
    "key": "ore_vendor.conversation_t5mwlu_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Von der Brühe kriegen sie nicht genug. Sie macht sie stärker, aber sie lässt sie auch vertrotteln.",
  },
  {
    "key": "ore_vendor.conversation_649tjr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Er ist außerdem hoch ätzend, also wirst du wohl kaum darin baden wollen.",
  },
  {
    "key": "ore_vendor.conversation_03e7vh_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Vielleicht hast du es ja gehört, aber die reiche Professorin da oben ist total verrückt geworden.",
  },
  {
    "key": "ore_vendor.conversation_u2ersk_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Seitdem ihr Haus während eines der ersten Erdbeben eingestürzt ist, hat sie den Verstand verloren.",
  },
  {
    "key": "ore_vendor.conversation_h9iaiy_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Jetzt ist sie dabei, mit ihren ganzen geerbten Moneten {format emph}eine Rakete zu bauen{format reset}.",
  },
  {
    "key": "ore_vendor.conversation_3jgp0a_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich habe gehört, dass sie sogar mit einem Netzwerk von Raketenexperten in Kontakt stehe.",
  },
  {
    "key": "ore_vendor.conversation_9mc50k_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Sie bauen die Dinger überall auf dem Planeten.",
  },
  {
    "key": "ore_vendor.conversation_bsxzro_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Sag mal, hast du dir die Zeit genommen, alle Höhlen zu durchforsten, an denen du vorbeigekommen bist, Schätzchen?",
  },
  {
    "key": "ore_vendor.conversation_dz2y8u_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Sie sind oft um einiges hartgesottener, als der Rest der Mine.",
  },
  {
    "key": "ore_vendor.conversation_3g80ch_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Aber mit hoher Wahrscheinlichkeit findest du in ihnen ein paar wertvolle Schätze.",
  },
  {
    "key": "ore_vendor.conversation_nmjdda_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Sobald du etwas in einer Höhle gefunden hast, wird es auf deiner Karte {image cave_small} markiert. Dann musst du nicht blind herumgraben.",
  },
  {
    "key": "ore_vendor.conversation_u3ck3c_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Wer hätte geglaubt, dass diese durchgeknallten Kultisten so viele Reichtümer unter der alten Ruine hatten.",
  },
  {
    "key": "ore_vendor.conversation_zh09qm_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Wir hätten dort schon vor Jahren graben sollen!",
  },
  {
    "key": "ore_vendor.conversation_g3jyqr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*'",
    "value": "Klar, ich hörte, dass die Ruinen von einem verrückten Kult besetzt sind, der dem Weltende huldigt.",
  },
  {
    "key": "ore_vendor.conversation_m4g0mn_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Das geht mich nichts an, und ich stecke meine Nase nicht gerne in die Angelegenheiten anderer Bots, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_figdnq_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Schau dir diese Stadt an. In meiner Jugend kam ich hier her. Ich versuchte, dem Hafenarbeiterleben zu entkommen.",
  },
  {
    "key": "ore_vendor.conversation_saxa80_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Die Stadt war damals viel kleiner, aber randvoll mit Potential, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_c0haij_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich konnte hier ein blühendes Geschäft aufbauen, und dazu brauchte ich nur den richtigen Mumm.",
  },
  {
    "key": "ore_vendor.conversation_3qiyya_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid",
    "value": "Du musst dich in die unerforschten Teile dieser Welt wagen, Schätzchen.",
  },
  {
    "key": "ore_vendor.conversation_281tok_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Das mag riskant sein, aber so kommst du an den dicken Gewinn.",
  },
  {
    "key": "ore_vendor.conversation_ef7tr2_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich habe von diesem merkwürdigen, unnatürlichen Dschungel gehört, der in der Mine wuchert.",
  },
  {
    "key": "ore_vendor.conversation_amxf2l_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Natürlich hält dich so etwas nicht auf.",
  },
  {
    "key": "ore_vendor.conversation_mp7r9y_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich mache mir nur Sorgen, dass er die Bergarbeiter, die immer gleich die Hose voll haben, davonjagt.",
  },
  {
    "key": "ore_vendor.conversation_fmy8mc_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Professorin Sherman macht ihre Rakete klar zum Abschuss.",
  },
  {
    "key": "ore_vendor.conversation_mxjgvx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ich hielt sie zuerst für einen Wirrkopf, aber jetzt glaube ich, dass sie die richte Idee hat, weißt du?",
  },
  {
    "key": "ore_vendor.conversation_gd4ef6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Der Weltraum ist gänzlich unerforscht und voll mit neuen Geschäftsmöglichkeiten.",
  },
  {
    "key": "ore_vendor.conversation_wr4wq2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo",
    "value": "Ich habe es schon mal geschafft, ein Leben aus dem Nichts aufzubauen, Schätzchen.",
  },
  {
    "key": "ore_vendor.conversation_mkud7m_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Wenn überhaupt bin ich jetzt vorbereiteter, als ich es in meiner Jugend war.",
  },
  {
    "key": "ore_vendor.conversation_08cc91_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved it to the bottom",
    "value": "Komm einfach vorbei, wenn du Erz zu verkaufen hast, okay?",
  },
  {
    "key": "inhabitant_01.conversation_07qv1j_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Mein nichtsnutziger Sohn hat keine Ahnung, was er da tut.",
  },
  {
    "key": "inhabitant_01.conversation_vx6mcl_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Wir brauchen fähige Leute da unten, die herausfinden, was diese verflixten Erdbeben verursacht!",
  },
  {
    "key": "inhabitant_01.conversation_hlqiyo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich weiß, wie sich eine tektonische Platte anfühlt, wenn sie sich bewegt. Potz Blitz! So sicher nicht, Herzchen!",
  },
  {
    "key": "inhabitant_01.conversation_q4ltpg_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wir brauchen jemanden mit Verstand und Schmackes, der in die Mine herabsteigt.",
  },
  {
    "key": "inhabitant_01.conversation_8w93yl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich arbeite in den Minen seit einer Ewigkeit, Herzchen ..., aber ich habe noch nie etwas wie diese Erdbeben gespürt.",
  },
  {
    "key": "inhabitant_01.conversation_ibhbb2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich würde ja selber nachsehen, wenn ich könnte, aber du siehst ja ... Da ist nicht viel Minenarbeiter übrig.",
  },
  {
    "key": "inhabitant_01.conversation_ffq3ty_text",
    "notes": "Speaker=Dorothy",
    "value": "Was ist dir zugestoßen?",
  },
  {
    "key": "inhabitant_01.conversation_9hmzci_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Oh! War es ein schrecklicher Minenunfall?",
  },
  {
    "key": "inhabitant_01.conversation_uy4syk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nee! Ich habe eine Menge Teile aufgegeben, um meine verdammten Jungs zu machen. Der Größte Fehler meines Lebens ...",
  },
  {
    "key": "inhabitant_01.conversation_g3ij4k_text",
    "notes": "Speaker=Fen Notes=*new* changed format from emph to singsong",
    "value": "{format singsong}Laaangweilig!{format reset}",
  },
  {
    "key": "inhabitant_01.conversation_xxgpup_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wenn ich könnte, wäre ich ratzfatz in diesen vermaledetein Tunneln!",
  },
  {
    "key": "inhabitant_01.conversation_dgq9o3_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wenn du vor hast, tief nach unten zu gehen, solltest du besser {format highlight}das Licht reparieren{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_o8vje6_text",
    "notes": "Speaker=Dorothy",
    "value": "Ist die Mine wirklich so gefährlich?",
  },
  {
    "key": "inhabitant_01.conversation_0c28a8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Naja, da gibt es ein paar fiese Kriecher, aber wenigstens habe ich lange keine verfluchten Schnapsis gesehen.",
  },
  {
    "key": "inhabitant_01.conversation_tt1za6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Meine Jungs waren damit beschäftigt, den Wall zu flicken, um diese fleischlichen Zweibeiner fernzuhalten.",
  },
  {
    "key": "inhabitant_01.conversation_n71xfs_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich war noch ein junger Mädchenbot als die Alkkriege endeten, aber ich erinnere mich noch gut an die schlechten Teile.",
  },
  {
    "key": "inhabitant_01.conversation_u3tho1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Jedenfalls ist es immer gut, dort unten vorbereitet zu sein, Herzchen.",
  },
  {
    "key": "inhabitant_01.conversation_8xtyi1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format highlight}Benutze die Werkbank{format reset} neben der Mine, um das Licht zu reparieren. Das heißt, wenn du dir die Teile leisten kannst ...",
  },
  {
    "key": "inhabitant_01.conversation_y2vq9y_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Potz Blitz! So bist du definitiv bereit, {format highlight}die Mine zu betreten{format reset}, Herzchen.",
  },
  {
    "key": "inhabitant_01.conversation_st3zju_text",
    "notes": "Speaker=Dorothy",
    "value": "War in letzter Zeit jemand im Rotfelsgang?",
  },
  {
    "key": "inhabitant_01.conversation_0zamqc_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nicht seit diese verfluchten Röhren nicht mehr funktionieren, Herzchen.",
  },
  {
    "key": "inhabitant_01.conversation_5atg04_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du wirst dort hindurch müssen, wenn du darüber nachdenkst, die ganze Mine zu erkunden.",
  },
  {
    "key": "inhabitant_01.conversation_caroq1_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich sollte wohl zuerst {format highlight}die Röhre freimachen{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_kq5k2e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Denke daran, dass der Dreck weiter unten immer zäher wird, du wirst also eine Ausrüstung in Schuss halten müssen.",
  },
  {
    "key": "inhabitant_01.conversation_yo8vom_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Rotfels ist der einzige Weg, tiefer in die Mine zu gelangen, zumindest solange das verdammte Röhrensystem außer Betrieb ist.",
  },
  {
    "key": "inhabitant_01.conversation_sxlsip_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich hoffe doch, dass ich den Rotfelsgang mit Sprengstoff freimachen kann.",
  },
  {
    "key": "inhabitant_01.conversation_2e9pz1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sollte klappen. Ich musste das schon mehr als ein paar verdammte Male selbst tun.",
  },
  {
    "key": "inhabitant_01.conversation_wkl33e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Begib dich erstmal runter zur Sprengladungsstation und {format highlight}hole den Sprengstoff{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_xtf9h2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Sollten wir nicht froh sein, dass der Gang überhaupt noch existiert? Ich glaube nicht, dass Sprengstoffe in unserer Versicherungspolice stehen.",
  },
  {
    "key": "inhabitant_01.conversation_5jzc1m_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Der Rotfelsgang ist der einzige Weg, tiefer in die Mine zu gelangen, jetzt wo das Röhrensystem außer Betrieb ist.",
  },
  {
    "key": "inhabitant_01.conversation_3vmqnk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich hoffe, du kommst da unten gut voran, Herzchen.",
  },
  {
    "key": "inhabitant_01.conversation_u6rmdw_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Professorin Sherman hat mir mit diesen schrecklichen Erdbeben Angst gemacht.",
  },
  {
    "key": "inhabitant_01.conversation_nxlgy6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sie ist da oben und gibt all ihr Geld für den Bau dieser Rakete aus.",
  },
  {
    "key": "inhabitant_01.conversation_ginz3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sie ist verdammt schlau, und ich ziehe daraus, dass sie an einem Ausstiegsplan arbeitet.",
  },
  {
    "key": "inhabitant_01.conversation_jkfreb_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich wünschte, mein dämlicher Sohn hätte so viel Verstand, ihr wenigstens für zwei Sekunden zuzuhören.",
  },
  {
    "key": "inhabitant_01.conversation_3pntbk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sieh an! Du bist einfach ein echter Minenarbeiter!",
  },
  {
    "key": "inhabitant_01.conversation_ebwh66_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Jetzt geh einfach zurück zum Rotfelsgang, und verpasse diesem Gestein die volle Ladung.",
  },
  {
    "key": "inhabitant_01.conversation_dayt2l_text",
    "notes": "Speaker=Dorothy",
    "value": "Rotfels hat es mit einer gut platzierten Sprengladung richtig freigeblasen.",
  },
  {
    "key": "inhabitant_01.conversation_5ji97r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ja, abgesehen von all den Niederbrüchen, ist es wirkliche eine stabile Konstruktion.",
  },
  {
    "key": "inhabitant_01.conversation_m6zdrd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ich bin nur froh, dass er noch steht.",
  },
  {
    "key": "inhabitant_01.conversation_k7klvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du wirst deine Ausrüstung auf der Höhe halten müssen, um mit dem Dreck in diesen Tiefen klarzukommen.",
  },
  {
    "key": "inhabitant_01.conversation_dspvhm_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Und hey, vergiss nicht, mehr von diesen kostbaren Steinen zurückzubringen.",
  },
  {
    "key": "inhabitant_01.conversation_sl7olj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Verwende etwas von dem Geld, um deine Ausrüstung aufzuwerten. Weiter unten macht sich das bezahlt.",
  },
  {
    "key": "inhabitant_01.conversation_x0wxp1_text",
    "notes": "Speaker=Dorothy",
    "value": "I muss einen Weg finden, zur Maurerstation zu kommen.",
  },
  {
    "key": "inhabitant_01.conversation_63gsgh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Dort unten gibt es Spalten und Gänge aller Art, glaube mir!",
  },
  {
    "key": "inhabitant_01.conversation_qp9quj_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Meine Brüder sind talentiert darin, sie zu finden ... und sich tagelang zu verlaufen.",
  },
  {
    "key": "inhabitant_01.conversation_x7yuib_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Diese Fleischsack-Schnapsis sind auch dafür bekannt, durchzubrechen und Chaos anzurichten.",
  },
  {
    "key": "inhabitant_01.conversation_hc3b2x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Erkunde die Mine in der Nähe des Schnapsiwalls. Ich bin mir sicher, {format highlight}du findest die Bergbaustation{format reset}, Herzchen.",
  },
  {
    "key": "inhabitant_01.conversation_gducoe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Schon so einem verfluchten Schnapsi begegnet, Herzchen? Sie haben lange keinen Ärger gemacht.",
  },
  {
    "key": "inhabitant_01.conversation_yr3kie_text",
    "notes": "Speaker=Dorothy",
    "value": "Mir ist aufgefallen, dass sie auch unter Tumbleton, meiner Heimatstadt, verschwunden sind.",
  },
  {
    "key": "inhabitant_01.conversation_owuynx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Also ist das überall so? Ich habe mindestens seit ein paar Monaten keinen mehr gesehen.",
  },
  {
    "key": "inhabitant_01.conversation_3h8ujv_text",
    "notes": "Speaker=Dorothy",
    "value": "Bald nachdem Rusty das technologische Ungetüm, Vectron, zerstörte, sind sie nur noch selten in Erscheinung getreten.",
  },
  {
    "key": "inhabitant_01.conversation_ezzezr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Darüber weiß ich wahrlich nicht viel, aber mit Schnapsis kenne ich mich aus.",
  },
  {
    "key": "inhabitant_01.conversation_dpbib8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Gewöhnlich fanden sie immer einen Weg, durch den Wall zu kommen, und uns Minenarbeitern Ärger zu bereiten.",
  },
  {
    "key": "inhabitant_01.conversation_3c3lpm_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Vielleicht bereiten ihnen diese Beben auch Sorgen? Verlassen das sinkende Schiff, wie die Ratten!",
  },
  {
    "key": "inhabitant_01.conversation_tcvt6a_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich weiß nicht, ob es ein gutes oder ein schlechtes Zeichen ist, dass die Schnapsis so ruhig sind.",
  },
  {
    "key": "inhabitant_01.conversation_67vh5i_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, ich habe die Schnapsis gefunden! Sie haben eine kleine, versteckte Stadt in der Mine errichtet.",
  },
  {
    "key": "inhabitant_01.conversation_iu5kqd_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Zum Kuckuck! Da würde ich keinen Fuß hineinsetzen. Viel zu unsicher!",
  },
  {
    "key": "inhabitant_01.conversation_vhdww6_text",
    "notes": "Speaker=Dorothy",
    "value": "So böse sahen sie eigentlich nicht aus. Nicht so wie die, denen ich zuvor begegnet bin.",
  },
  {
    "key": "inhabitant_01.conversation_cbcmjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Einer Sache bin ich mir verdammt sicher: Traue niemals einem Schnapsi!",
  },
  {
    "key": "inhabitant_01.conversation_0glm7l_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wenn du weißt, was gut für dich ist, hältst du dich lieber von dieser Schnapsi-Stadt fern!",
  },
  {
    "key": "inhabitant_01.conversation_umbt7u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Beim Tempel herumzugraben, kann verdammt gefährlich sein, aber dort befinden sich noch viele Kostbarkeiten.",
  },
  {
    "key": "inhabitant_01.conversation_c5baff_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, das klingt vielversprechend! Du solltest auf jeden Fall dorthin und ein paar davon einsammeln.",
  },
  {
    "key": "inhabitant_01.conversation_r8rlnp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Zum Henker! Du bräuchtest schon ein wenig Schmackes, um diese Ruinen zu betreten.",
  },
  {
    "key": "inhabitant_01.conversation_m8hqwy_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nicht einmal seine Brüder sind verrückt genug, {format highlight}den Tempel zu betreten{format reset}, der sich hinter den Windigen Ebenen befindet.",
  },
  {
    "key": "inhabitant_01.conversation_bvz9xj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Da gibt es so einen verrückten Kult von Weltuntergangspredigern, die ihn für sich beansprucht haben.",
  },
  {
    "key": "inhabitant_01.conversation_fj6bw8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sie haben selbst die Ruinen in der Westwüste eingenommen.",
  },
  {
    "key": "inhabitant_01.conversation_u26tuh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich wette dieser durchgeknallte alte Ronald gibt immer noch den Ton an. War mal ein netter Kerl, aber dieser religiöse Quatsch hat ihm das Hirn vernebelt.",
  },
  {
    "key": "inhabitant_01.conversation_gr738j_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Der Tempel hinter den Windigen Ebenen mag voller Reichtümer sein, aber er ist auch ein verdammt gefährlicher Ort zum Graben.",
  },
  {
    "key": "inhabitant_01.conversation_grrmq6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sieht so aus, als würdest du dich richtig reinknien müssen, Herzchen!",
  },
  {
    "key": "inhabitant_01.conversation_335kyr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du findest vielleicht Spuren alter Zivilisationen dort unten. So wie diese alten Maschinen in den Bergbaustationen.",
  },
  {
    "key": "inhabitant_01.conversation_2jepw2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sie waren schon dort unten, bevor es mich überhaupt gegeben hat.",
  },
  {
    "key": "inhabitant_01.conversation_mv0s6q_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ein paar schlaue Bots sind der Meinung, die Schnapsis hätten sie gebaut.",
  },
  {
    "key": "inhabitant_01.conversation_vxki0p_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Diese Bots klingen für mich nicht besonders schlau. Nennen sich bestimmt auch noch "Experten".",
  },
  {
    "key": "inhabitant_01.conversation_ysj9vo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich bin mir unsicher, ob es das Risiko wert ist, so tief unter Schnapsbergen zu graben. Wer weiß, was du dort finden wirst!",
  },
  {
    "key": "inhabitant_01.conversation_uj1muo_text",
    "notes": "Speaker=Dorothy",
    "value": "Für mich gibt es eine Menge zu graben, wenn ich diese Erdbeben stoppen will.",
  },
  {
    "key": "inhabitant_01.conversation_ykczsp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Die Professorin hat etwas von einem Dschungel erzählt, der sich überall in der Mine ausbreitet.",
  },
  {
    "key": "inhabitant_01.conversation_z8gocf_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Zum Henker! Das klingt gar nicht gut.",
  },
  {
    "key": "inhabitant_01.conversation_dzwjvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wie soll ein Bot umgeben von solchen Gefahren graben ... Wie werden meine verdammten Söhne damit klarkommen?",
  },
  {
    "key": "inhabitant_01.conversation_x3v93r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich weiß nicht, ob du es gemerkt hast, aber die sind wirklich verdammt dämlich.",
  },
  {
    "key": "inhabitant_01.conversation_jmwahi_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich schätze, wir werden uns einfach um einen Platz an Bord der Rakete kümmern müssen.",
  },
  {
    "key": "inhabitant_01.conversation_8augkl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Meine Jungs sind absolute Taugenichtse, das ist mir klar, aber sie sind noch immer meine Teile und Rädchen.",
  },
  {
    "key": "inhabitant_01.conversation_9v0sjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich schätze, ich werde einfach 5 Tickets für den Flug in den Weltraum besorgen müssen?",
  },
  {
    "key": "inhabitant_01.conversation_p75xau_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nett von dir, dem Geschwafel eines alten Bots zuzuhören. Deine Eltern müssen stolz auf dich sein!",
  },
  {
    "key": "inhabitant_01.conversation_8hjn65_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nicht so wie meine Söhne. Verdammt nutzlos, das ganze Pack.",
  },
  {
    "key": "inhabitant_01.conversation_x6q3po_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Die meisten sind damit beschäftigt, in der Mine zu "arbeiten". Und dann gibt es den verdammten Politiker dort.",
  },
  {
    "key": "inhabitant_01.conversation_8tssip_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Schön, jemanden in den Tunneln zu haben, der weiß, was er tut!",
  },
  {
    "key": "inhabitant_02.conversation_royiqq_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*new*",
    "value": "Oh je, oh je! Das war ein ziemlich großes {format nervous}Erdbeben{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_0z0jlu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Meine Güte! Du siehst mir aus wie ein Kleinstadtbot, genau wie ich! {format singsong}Wie wunderbar!{format reset}",
  },
  {
    "key": "inhabitant_02.conversation_i3c2ki_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Ich habe mich in letzter Zeit so einsam gefühlt. Wie ein echter Außenseiter.",
  },
  {
    "key": "inhabitant_02.conversation_fnv0dz_text",
    "notes": "Speaker=Fen",
    "value": "Ich dachte, es wäre nur ein Lüftchen vom Plumpsklo, aber es ist dieser Außenseitergeruch ...",
  },
  {
    "key": "inhabitant_02.conversation_q58pva_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Das leuchtend-glitzernde Ding hat recht. Ich bin für das Großstadtleben nicht gemacht.",
  },
  {
    "key": "inhabitant_02.conversation_r68qcd_text",
    "notes": "Speaker=Dorothy",
    "value": "Könntest du zur Abwechslung mal versuchen, nett zu sein Fen? Vielleicht gefällt es dir!",
  },
  {
    "key": "inhabitant_02.conversation_6c81lb_text",
    "notes": "Speaker=Fen",
    "value": "Das bezweifle ich.",
  },
  {
    "key": "inhabitant_02.conversation_qy4k1b_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich sollte wohl einfach zur Farm zurückkehren.",
  },
  {
    "key": "inhabitant_02.conversation_q27f56_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Nochmals hallo, Kleinstadtbot-Kollegin!",
  },
  {
    "key": "inhabitant_02.conversation_bfqhtj_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Es gibt viele Beschwerden über unseren armen Bürgermeister.",
  },
  {
    "key": "inhabitant_02.conversation_xpriw7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Für mich sieht es so aus, als wüsste er, wovon er spricht.",
  },
  {
    "key": "inhabitant_02.conversation_kqxpuz_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Immerhin ist er in der Großstadt aufgewachsen ... er muss es ja gewohnt sein, wie die Dinge hier laufen.",
  },
  {
    "key": "inhabitant_02.conversation_tdhokx_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Wenn ich mich an so einem vollgestopften Ort um Dinge kümmern müsste, wäre ich aufgeschmissen.",
  },
  {
    "key": "inhabitant_02.conversation_0k5x6v_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich bin mir sicher, der Bürgermeister weiß, was er tut.",
  },
  {
    "key": "inhabitant_02.conversation_unbiry_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Hallo nochmal, Freundin!",
  },
  {
    "key": "inhabitant_02.conversation_fdlynd_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Es ist nicht einfach, hier jemanden kennenzulernen.",
  },
  {
    "key": "inhabitant_02.conversation_7ymnmr_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Nicht so wie zu Hause, wo man einfach jeden vom Tag seiner Montage an kennt.",
  },
  {
    "key": "inhabitant_02.conversation_enl4xa_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Diese Stadt folgt ihrem eigenen Takt. Die Leute sind einfach zu beschäftigt, um zu plaudern. Selbst zu beschäftigt, nett zueinander zu sein!",
  },
  {
    "key": "inhabitant_02.conversation_aptgjz_text",
    "notes": "Speaker=Fen",
    "value": "Oder es liegt einfach an dir.",
  },
  {
    "key": "inhabitant_02.conversation_cqddcg_text",
    "notes": "Speaker=Dorothy",
    "value": "Komm schon Fen, sei nett!",
  },
  {
    "key": "inhabitant_02.conversation_3avufg_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Hm, manchmal frage ich mich, ob sie es überhaupt merken würden, wenn jemand verschwindet.",
  },
  {
    "key": "inhabitant_02.conversation_bibnd6_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "So wie ich es mitbekommen habe, verirrt sich hier ständig jemand.",
  },
  {
    "key": "inhabitant_02.conversation_l5r7sq_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Zumindest schätzen wir auf dem Land Freundschaft und Loyalität.",
  },
  {
    "key": "inhabitant_02.conversation_axrc0a_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich wusste, dass du ein Kleinstadtbot bist, als ich dich das erste mal traf!",
  },
  {
    "key": "inhabitant_02.conversation_4ure1i_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Hast du mit der verrückten Professorin gesprochen? Sie baut diese Rakete etwas oberhalb der Stadt.",
  },
  {
    "key": "inhabitant_02.conversation_qahysn_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Sie hat wohl eine Menge Geld geerbt, aber gibt jetzt alles für dieses Raumschiff aus.",
  },
  {
    "key": "inhabitant_02.conversation_5923lp_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "So eine Verschwendung!",
  },
  {
    "key": "inhabitant_02.conversation_t94xdc_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "In meinem Dorf hatten wir auch so jemanden, der eine Rakete baute.",
  },
  {
    "key": "inhabitant_02.conversation_x71xpu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Muss wohl in Mode sein, denkst du nicht auch?",
  },
  {
    "key": "inhabitant_02.conversation_q3y399_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich wette die hier ist die raffinierteste. Die aus meinem Dorf war nur ein umgebautes Silo.",
  },
  {
    "key": "inhabitant_02.conversation_12pu8k_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Stell dir nur vor, wie diese verrückten, schlauen Bots überall auf dem Globus ihre eigenen Raketen bauen. Wenn ich drüber nachdenke, muss ich {format laugh}schmunzeln{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_e4onuf_text",
    "notes": "Speaker=Dorothy",
    "value": "Du siehst müde aus.",
  },
  {
    "key": "inhabitant_02.conversation_ob0wy7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Hier ist einfach zu viel los. Ich kann da nicht mithalten!",
  },
  {
    "key": "inhabitant_02.conversation_54qfjg_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich habe mich entschieden. Ich werde in mein Dorf zurückkehren.",
  },
  {
    "key": "inhabitant_02.conversation_i33o07_text",
    "notes": "Speaker=Penny Kettlebottom Notes=Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    "value": "Am spannendsten wird es da noch, wenn Papi Pumpe das Wasser aus dem Brunnen holt.",
  },
  {
    "key": "inhabitant_02.conversation_7bo632_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich bin für diesen Stress nicht geschaffen. Vielleicht lasse ich mich irgendwo mit einem Dutzend Dampfkatzen nieder.",
  },
  {
    "key": "inhabitant_02.conversation_jcodma_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Vielleicht werde ich ja sogar eine ernsthafte Konkurrenz für Schraubenschlüssel Susi während des Rädchen-schmieren-Wettkampfs sein.",
  },
  {
    "key": "inhabitant_02.conversation_rjax07_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Es wäre einfach {format singsong}großartig{format reset}, diesen pedantischen Bot, Schraubenschlüssel Susi zu besiegen.",
  },
  {
    "key": "inhabitant_02.conversation_kzt23q_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ich sollte wohl einfach zur Farm zurückkehren.",
  },
  {
    "key": "climber_01.conversation_vyjpoj_text",
    "notes": "Speaker=Lady Botterley Notes=*format* There is a crashed elevator just next to them.",
    "value": "Durch das Erdbeben ist der Lift abgestürzt!",
  },
  {
    "key": "climber_01.conversation_ctbic6_text",
    "notes": "Speaker=Fen Notes=*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    "value": "{format singsong}Ooh!{format reset} Wurde jemand ekelhaft zerquetscht?",
  },
  {
    "key": "climber_01.conversation_m9r7tc_text",
    "notes": "Speaker=Lady Botterley Notes=*new* changed horrible to terrible and emphasised "thing"",
    "value": "Um {format nervous}Himmels willen!{format reset} Was für ein grausames {format emph}Ding{format reset} bist du?",
  },
  {
    "key": "climber_01.conversation_045qay_text",
    "notes": "Speaker=Fen Notes=She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    "value": "Hey, ich bin {format emph}kein{format reset} Ding! Wenn ich noch mein Totem hätte, würde ich dich jetzt abknallen!",
  },
  {
    "key": "climber_01.conversation_fccwnq_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Nun, was auch immer du bist, du solltest auf dein Benehmen achten.",
  },
  {
    "key": "climber_01.conversation_8oqmau_text",
    "notes": "Speaker=Dorothy",
    "value": "Entschuldigen Sie bitte, Fen hat noch keine soziale Kompetenz entwickelt.",
  },
  {
    "key": "climber_01.conversation_acx7g7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Wie lange soll ich hier noch auf jemanden warten, der endlich diesen Lift repariert?",
  },
  {
    "key": "climber_01.conversation_matp87_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Hier unten in der Wüste herumzustehen, ist einem Bot meines Formats nicht würdig.",
  },
  {
    "key": "climber_01.conversation_eb6uiw_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Hier unten in der Wüste herumzustehen, ist einem Bot meines Formats nicht würdig.",
  },
  {
    "key": "climber_01.conversation_c7c7g6_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Unser Bürgermeister mag nicht von bester Fertigungsqualität sein, aber es fehlt ihm nicht gänzlich an Finesse.",
  },
  {
    "key": "climber_01.conversation_mdqfxx_text",
    "notes": "Speaker=Lady Botterley Notes=This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    "value": "Es kommt nicht selten vor, dass man die schlichte Summe seiner Teile übertrifft.",
  },
  {
    "key": "climber_01.conversation_uynh2z_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich muss ihm in seinen Entscheidungen vertrauen, und das Gleiche gilt für alle anderen auch.",
  },
  {
    "key": "climber_01.conversation_if7w3g_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Offensichtlich muss man sich um diese Erdbeben keine Sorgen machen. Die Wartung des Lifts war mit Sicherheit so oder so überfällig.",
  },
  {
    "key": "climber_01.conversation_540zgf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich hoffe doch, dass sie bald jemanden schicken, der diese Vorrichtung repariert. Ich habe {format emph}Besseres{format reset} zu tun, als hier meine Zeit zu vergeuden.",
  },
  {
    "key": "climber_01.conversation_t8w29c_text",
    "notes": "Speaker=Dorothy",
    "value": "Also ... der Lift ist immer noch nicht repariert, hm?",
  },
  {
    "key": "climber_01.conversation_2y8m3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Offensichtlich nicht.",
  },
  {
    "key": "climber_01.conversation_sbn8ap_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Zwar schickt sich dieses Fleckchen nicht für einen Ladybot wie mich, aber wenigstens ist es hier ruhig.",
  },
  {
    "key": "climber_01.conversation_x0xmdc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Diese absurde Professorin nebenan hämmert Tag und Nacht an ihrer Raketen herum!",
  },
  {
    "key": "climber_01.conversation_9hvgg5_text",
    "notes": "Speaker=Fen Notes="Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    "value": "Warum marschierst du nicht einfach die Klippe hinauf?",
  },
  {
    "key": "climber_01.conversation_b63bbp_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Pfft! Eine Lady klettert nicht.",
  },
  {
    "key": "climber_01.conversation_ff5hlh_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Eine Lady klettert nicht. Ich werde hier warten bis der Lift repariert ist oder mich jemand trägt. Nur das ziemt sich mir.",
  },
  {
    "key": "climber_01.conversation_3lbfex_text",
    "notes": "Speaker=Fen",
    "value": "Immer noch hier, hm?",
  },
  {
    "key": "climber_01.conversation_ykf245_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ja, ich bin {format emph}immer noch hier{format reset}. Und ja, der Lift ist {format emph}immer noch kaputt{format reset}. Kein Grund schnippisch zu werden.",
  },
  {
    "key": "climber_01.conversation_c50t6h_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Aber das ist ziemlich lächerlich! Jemand so wichtiges wie ich muss doch unter den High-Society-Bots vermisst werden.",
  },
  {
    "key": "climber_01.conversation_8rvp8u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Der Bürgermeister hat dafür besser eine sehr gute Erklärung.",
  },
  {
    "key": "climber_01.conversation_wpxim7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich bin mir sicher, dass ich zutiefst vermisst werde. Ich bin ziemlich wichtig, weißt du.",
  },
  {
    "key": "climber_01.conversation_gtukg8_text",
    "notes": "Speaker=Fen",
    "value": "Du gehst irgendwie nirgendwo hin, oder?",
  },
  {
    "key": "climber_01.conversation_cudej5_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Nun, ich musste einem neuen Hobby frönen.",
  },
  {
    "key": "climber_01.conversation_h438q0_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich zähle alle Pilger, die auf ihrem Weg zu diesem unflätigen Tempel im Westen hier hindurchkommen.",
  },
  {
    "key": "climber_01.conversation_e0mg3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Unter normalen Bedingungen, würde ich sie selbstverständlich völlig ignorieren, aber ich bin mehr als gelangweilt.",
  },
  {
    "key": "climber_01.conversation_x9lbaf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Diese Pilger scheinen etwas vorzuhaben. Ich sollte wirklich nicht an solchen belanglosen Angelegenheiten interessiert sein müssen.",
  },
  {
    "key": "climber_01.conversation_ef66r2_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ihr schon wieder? Habt ihr nichts besseres zu tun, als mich zu belästigen?",
  },
  {
    "key": "climber_01.conversation_4ay3w5_text",
    "notes": "Speaker=Fen",
    "value": "Doch schon, aber es macht einfach Spaß!",
  },
  {
    "key": "climber_01.conversation_b1t04s_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Als wären die Erdbeben nicht schon genug.",
  },
  {
    "key": "climber_01.conversation_6ntyzc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Wie auch immer. Ich bin zu dem Schluss gekommen, dass unser Bürgermeister ein Idiot sein muss.",
  },
  {
    "key": "climber_01.conversation_9sm12u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Sicher ist es schwer zu glauben, aber selbst ich kann manchmal etwas weniger als absolut richtig liegen.",
  },
  {
    "key": "climber_01.conversation_ce5r53_text",
    "notes": "Speaker=Fen",
    "value": "Echt jetzt?",
  },
  {
    "key": "climber_01.conversation_1zdfzx_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich frage mich, wie viel wohl ein Ticket für diese Rakete kostet ...",
  },
  {
    "key": "climber_01.conversation_4y3t9l_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ich frage mich, wie viel wohl ein Ticket für diese Rakete kostet ...",
  },
  {
    "key": "climber_01.conversation_bfqth1_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Hier unten in der Wüste herumzustehen, ist meiner ganz einfach nicht würdig, ich habe Format!",
  },
  {
    "key": "entering_guidance.conversation_kohvbb_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "{format emph}Autsch!{format reset}",
  },
  {
    "key": "entering_guidance.conversation_1a5f80_text",
    "notes": "Speaker=Dorothy Notes=*format* *DEMO*",
    "value": "Mist, zum Henker! Meine Lampe ist kaputt.",
  },
  {
    "key": "entering_guidance.conversation_9rx08a_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Wow! Was {format emph}ist{format reset} das für ein Ort?",
  },
  {
    "key": "entering_guidance.conversation_ojjbl5_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Ich muss ihn erkunden, um {format highlight}einen anderen Weg herauszufinden{format reset}.",
  },
  {
    "key": "cutscene_fen.conversation_y5enud_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "Oh, {format singsong}prächtiges Licht der Führung!{format reset} Badet mich in Eurem Licht.",
  },
  {
    "key": "cutscene_fen.conversation_hnsad0_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "JA, HABE DIE EHRE, DICH IN MEINER VERNICHTENDEN GLUT ZU SONNEN.",
  },
  {
    "key": "cutscene_fen.conversation_a1al3q_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "{format singsong}Oh, seid gesegnet!{format reset} Die Glückseligkeit erwartet mich!",
  },
  {
    "key": "cutscene_fen_02.conversation_2ln8fi_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Hey! Ich war gerade drauf und dran, dich abzufackeln, du irrer Kultist.",
  },
  {
    "key": "cutscene_fen_02.conversation_qzp3tz_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe es ja versucht, dir klarzumachen: Ich bin {format emph}kein Kultist.{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_ksn1s4_text",
    "notes": "Speaker=Fen",
    "value": "Echt? Ihr Bots seht für mich alle gleich aus.",
  },
  {
    "key": "cutscene_fen_02.conversation_g22jzu_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Du{format reset} siehst wie ein Waldgeist aus Vectron aus. Wie ist das {format emph}möglich?{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_01a075_text",
    "notes": "Speaker=Dorothy",
    "value": "Mein Freund Rusty hat Vectron zerstört, bevor er verschwand.",
  },
  {
    "key": "cutscene_fen_02.conversation_w28at6_text",
    "notes": "Speaker=Fen",
    "value": "Dieser Kult stahl mich und steckte mich hier rein, um mich anzubeten. Sie wollten, dass ich sie abknalle, {format laugh}hihihi!{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_krzwlf_text",
    "notes": "Speaker=Fen",
    "value": "Hm ... Das kann ich aber nicht ohne mein cooles Totem. Also, was werden wir jetzt tun?",
  },
  {
    "key": "cutscene_fen_02.conversation_wfa9i6_text",
    "notes": "Speaker=Dorothy",
    "value": "Nun, {format emph}Ich{format reset} gehe hoch zur großen Stadt. Man sagte mir, dass Rusty dort gesehen wurde.",
  },
  {
    "key": "cutscene_fen_02.conversation_qhu4n0_text",
    "notes": "Speaker=Fen",
    "value": "Zur Stadt sagst du? Okay, wenn du darauf bestehst, kann ich natürlich mit dir mitgehen.",
  },
  {
    "key": "cutscene_fen_01.conversation_e2v16f_text",
    "notes": "Speaker=The Guiding Light Notes=*DEMO*",
    "value": "EIN SCHUSS! {format laugh}HIHIHI!{format reset}",
  },
  {
    "key": "cutscene_fen_01.conversation_z0997i_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Mal Langsam! Was zum Henker {format emph}geht hier vor sich{format reset}?",
  },
  {
    "key": "cutscene_fen_01.conversation_0dz6we_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "SPITZE! NOCH EIN PILGER!",
  },
  {
    "key": "cutscene_fen_01.conversation_mzljgp_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Aber ich bin k...",
  },
  {
    "key": "cutscene_fen_01.conversation_yadt78_text",
    "notes": "Speaker=The Guiding Light Notes=*new* *DEMO* moved the pew-pew line from below into this line.",
    "value": "MACH DICH BEREIT, ABGEKNALLT ZU WERDEN! {format laugh}PEW-PEW!{format reset}",
  },
  {
    "key": "fen_ledge_01.conversation_cukwql_text",
    "notes": "Speaker=Fen",
    "value": "Wow, was für ein Anblick! Warum schaust du nicht mal genauer hin?",
  },
  {
    "key": "fen_ledge_02.conversation_aszmw4_text",
    "notes": "Speaker=Fen",
    "value": "Du musst näher rankommen!",
  },
  {
    "key": "fen_ledge_02.conversation_skvrgn_text",
    "notes": "Speaker=Fen",
    "value": "{format singsong}Nääääheeer ...{format reset} {format laugh}hihihi!{format reset}",
  },
  {
    "key": "old_salesbot_01.conversation_x6t79e_text",
    "notes": "Speaker=Trader Carson",
    "value": "Na wenn das nicht die kleine Dorothy McCrank ist!",
  },
  {
    "key": "old_salesbot_01.conversation_yu1bwf_text",
    "notes": "Speaker=Dorothy",
    "value": "Händler Carson! Ich hätte nicht gedacht, so weit von zu Hause einem Bekannten zu begegnen.",
  },
  {
    "key": "old_salesbot_01.conversation_0hioym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Erzähl mir von deiner kleinen Stadt, Tumbleton. Ich habe viele verschiedene Gerüchte gehört!",
  },
  {
    "key": "old_salesbot_01.conversation_dslq5p_text",
    "notes": "Speaker=Dorothy",
    "value": "Es begann alles mit Rustys Ankunft. Er hat nach allen möglichen Schätzen gegraben und unserer Stadt geholfen, zu wachsen.",
  },
  {
    "key": "old_salesbot_01.conversation_8tr70j_text",
    "notes": "Speaker=Dorothy",
    "value": "Aber dann hat er tief unten eine merkwürdige Technologie entdeckt. Er ist mit ihr verschmolzen und wurde durch sie sehr mächtig.",
  },
  {
    "key": "old_salesbot_01.conversation_70kkpo_text",
    "notes": "Speaker=Fen",
    "value": "Na los, komm endlich zum spannenden Teil!",
  },
  {
    "key": "old_salesbot_01.conversation_xfpxnh_text",
    "notes": "Speaker=Dorothy",
    "value": "Nun, es stellte sich heraus, dass die Quelle dieser mysteriösen Macht für uns alle eine Gefahr war.",
  },
  {
    "key": "old_salesbot_01.conversation_epbknd_text",
    "notes": "Speaker=Dorothy",
    "value": "Er hat gegen sie gekämpft und uns alle gerettet, aber nach dem Kampf verschwand er. Seitdem versuche ich ihn zu finden.",
  },
  {
    "key": "old_salesbot_01.conversation_c5qvu8_text",
    "notes": "Speaker=Dorothy",
    "value": "Ein Reisender sah meine Vermisstenplakate und erzählte mir, dass er gesehen wurde, wie er die Mine von El Machino betrat.",
  },
  {
    "key": "old_salesbot_01.conversation_i625og_text",
    "notes": "Speaker=Trader Carson",
    "value": "Jepp, was für eine Geschichte!",
  },
  {
    "key": "old_salesbot_01.conversation_umknih_text",
    "notes": "Speaker=Dorothy",
    "value": "Kurz gesagt, mein Freund ist verschwunden.",
  },
  {
    "key": "old_salesbot_01.conversation_hp7xc3_text",
    "notes": "Speaker=Dorothy",
    "value": "Ein Reisender sah meine Vermisstenplakate und erzählte mir, dass er gesehen wurde, wie er die Mine von El Machino betrat.",
  },
  {
    "key": "old_salesbot_01.conversation_nfwjrx_text",
    "notes": "Speaker=Trader Carson Notes=*new* changed "well", to "now"",
    "value": "Nun, der Weg nach oben ist blockiert, du wirst {format highlight}die Klippen erklimmen{format reset} müssen, um hinaufzukommen.",
  },
  {
    "key": "old_salesbot_01.conversation_c1qqn0_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ich bin in Kürze selbst dort oben. Komm vorbei, wenn du ein paar Verbesserungsrädchen {image cogs_small} kaufen willst, um in der Mine besser klarzukommen.",
  },
  {
    "key": "old_salesbot_01.conversation_m6jpam_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ich hoffe, du hast bei deiner Suche hier mehr Glück.",
  },
  {
    "key": "old_salesbot_01.conversation_q4eiud_text",
    "notes": "Speaker=Trader Carson",
    "value": "Also gut, ich werde nur meine alten Gelenke etwas ausruhen, bevor ich zur Stadt hinaufklettere.",
  },
  {
    "key": "old_salesbot_01.conversation_yx3y9m_text",
    "notes": "Speaker=Trader Carson",
    "value": "Warum erzählst du mir nicht, was in Tumbleton passiert ist, während ich warte?",
  },
  {
    "key": "old_salesbot_01.conversation_x7qfv2_text",
    "notes": "Speaker=Trader Carson",
    "value": "Gut, dann eben ein anderes Mal.",
  },
  {
    "key": "old_salesbot_01.conversation_5nktdz_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ah! Ich liebe es einfach hier oben in dem hoch polierten Viertel der Stadt zu sein.",
  },
  {
    "key": "old_salesbot_01.conversation_tj5uh7_text",
    "notes": "Speaker=Trader Carson",
    "value": "Diese Hipsterbots hier zahlen jeden Preis für meine authentischen Verbesserungsrädchen {image cogs_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_nqd450_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Ich habe ein gutes Geschäft damit gemacht, durch die Gegend zu ziehen und diese kleinen Rädchen hier zu verkaufen.",
  },
  {
    "key": "old_salesbot_01.conversation_ny6f1a_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Meist kaufe ich sie auf Flohmärkten oder in Gebrauchtläden, aber manchmal findet man sie auch draußen in der Wildnis.",
  },
  {
    "key": "old_salesbot_01.conversation_smo857_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Sie machen dieses typische, schleifende Klick-Klack-Geräusch.",
  },
  {
    "key": "old_salesbot_01.conversation_gq1rfi_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Es braucht schon ein geschultes Ohr, um sie herauszuhören, aber wenn du genau hinhörst, kannst du sie identifizieren.",
  },
  {
    "key": "old_salesbot_01.conversation_dm175r_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ist eine Weile her, seit ich deinen Vati das letzte mal sah. Wie geht's ihm?",
  },
  {
    "key": "old_salesbot_01.conversation_w6hv5b_text",
    "notes": "Speaker=Dorothy",
    "value": "Er starb leider schon vor einer Weile.",
  },
  {
    "key": "old_salesbot_01.conversation_by4nym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Verdammt, das sind traurige Neuigkeiten! Ich dachte immer er würde uns alle überleben ...",
  },
  {
    "key": "old_salesbot_01.conversation_1g9zr8_text",
    "notes": "Speaker=Trader Carson",
    "value": "... schon alleine, um es uns heimzuzahlen.",
  },
  {
    "key": "old_salesbot_01.conversation_cgmjf4_text",
    "notes": "Speaker=Dorothy",
    "value": "Dachte ich auch ...",
  },
  {
    "key": "old_salesbot_01.conversation_i5igy1_text",
    "notes": "Speaker=Trader Carson",
    "value": "Also, was ist aus deinem kleinen Laden geworden, jetzt wo du hier mit dem Graben beschäftigt bist?",
  },
  {
    "key": "old_salesbot_01.conversation_lp4kx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Oh, Tumbleton floriert. Es gab viele Bots, die gewillt waren, den Handel dort aufzunehmen.",
  },
  {
    "key": "old_salesbot_01.conversation_a7uh25_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich wollte stattdessen immer in der Mine arbeiten, aber mein Vater hielt das für zu gefährlich.",
  },
  {
    "key": "old_salesbot_01.conversation_kyijyo_text",
    "notes": "Speaker=Trader Carson",
    "value": "Also gut. Ich bin froh, dass du nun das tust, was dich glücklich macht.",
  },
  {
    "key": "old_salesbot_01.conversation_s5417g_text",
    "notes": "Speaker=Trader Carson",
    "value": "Hab den Burschen ja nie getroffen, der deine Stadt gerettet hat.",
  },
  {
    "key": "old_salesbot_01.conversation_tgpso6_text",
    "notes": "Speaker=Trader Carson",
    "value": "Hatte wirklich keine dringlichen Geschäfte dort, als das alles passierte.",
  },
  {
    "key": "old_salesbot_01.conversation_10nfc4_text",
    "notes": "Speaker=Trader Carson",
    "value": "Wie war sein Name gleich? Crusty ... nein ... Trusty! So hieß der doch, richtig?",
  },
  {
    "key": "old_salesbot_01.conversation_vzg8gx_text",
    "notes": "Speaker=Dorothy",
    "value": "Rusty ...",
  },
  {
    "key": "old_salesbot_01.conversation_ymzbde_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ah, Genau so! Wie ich es verstanden habe, hat er ein gigantisches Monster dort in der Mine ausgeschaltet.",
  },
  {
    "key": "old_salesbot_01.conversation_la8vr6_text",
    "notes": "Speaker=Trader Carson",
    "value": "Und dann ist er einfach so verschwunden!",
  },
  {
    "key": "old_salesbot_01.conversation_k59dwv_text",
    "notes": "Speaker=Trader Carson",
    "value": "Viel Glück bei deiner Suche, kleine Dot. Ich hoffe, du findest ihn in einem Stück.",
  },
  {
    "key": "old_salesbot_01.conversation_bzq0aw_text",
    "notes": "Speaker=Trader Carson Notes=*new* removed "nothing"",
    "value": "Die Welt hat sich ganz schön verändert, seit ich ein junger Bot war.",
  },
  {
    "key": "old_salesbot_01.conversation_zc6l96_text",
    "notes": "Speaker=Trader Carson",
    "value": "Dieses Felskraut, das da unten in der Mine wuchert, und Bots, die Raketen bauen, um den Planeten zu fliehen.",
  },
  {
    "key": "old_salesbot_01.conversation_jnptai_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ich verkaufe einfach meine Verbesserungsrädchen {image cogs_small}, wie ich es schon immer getan habe.",
  },
  {
    "key": "old_salesbot_01.conversation_rk0bii_text",
    "notes": "Speaker=Trader Carson",
    "value": "Schätze, es liegt jetzt an euch Kindern, die Zukunft zu erschaffen.",
  },
  {
    "key": "old_salesbot_01.conversation_r74j24_text",
    "notes": "Speaker=Trader Carson Notes=Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    "value": "Hey, ich habe eine Handvoll Verbesserungsrädchen {image cogs_small} abzuladen. Es ist mir eine Freude, dir einen fairen Preis zu machen!",
  },
  {
    "key": "old_salesbot_01.conversation_0qym9q_text",
    "notes": "Speaker=Trader Carson",
    "value": "Schätze, du bist hier wegen meinen Verbesserungsrädchen? {image cogs_small}",
  },
  {
    "key": "old_salesbot_01.conversation_yx06g0_text",
    "notes": "Speaker=Trader Carson",
    "value": "Also, wie wäre es? Du bekommst ein funkelndes, neues Verbesserungsrädchen {image cogs_small} für nur \${var pricelist_next:carson_cogs}{image money_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_x4iaao_text",
    "notes": "Speaker=Trader Carson",
    "value": "Es ist immer wieder eine Freude, mit dir Geschäfte zu machen!",
  },
  {
    "key": "old_salesbot_01.conversation_zfed36_text",
    "notes": "Speaker=Trader Carson",
    "value": "Du bist eine echt gute Kundin, kleine Dot! Das war das letzte. Prima, dass sie dir von Nutzen waren!",
  },
  {
    "key": "old_salesbot_01.conversation_koo3mt_text",
    "notes": "Speaker=Trader Carson",
    "value": "Nun, ich wünschte, ich könnte dir umsonst helfen Dot, aber auch ein Händler muss seine Brötchen verdienen.",
  },
  {
    "key": "old_salesbot_01.conversation_1yrec8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Alles klar, komm jederzeit wieder, wenn du Verbesserungsrädchen brauchst! {image cogs_small}",
  },
  {
    "key": "old_salesbot_01.conversation_27y4o8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Du hast den Mut deines Vatis, so viel ist sicher.",
  },
  {
    "key": "cutscene_fen_03.conversation_c3lb0g_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, was machst du da? {format emph}Raus{format reset} aus meinem Ofen!",
  },
  {
    "key": "fen_conquerer.conversation_f2k0wg_text",
    "notes": "Speaker=Fen",
    "value": "So sieht es also an der Oberfläche aus. Ganz schön hell!",
  },
  {
    "key": "fen_conquerer.conversation_x8lfrw_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, eine tolle Karte hast du da! Könntest du damit jemanden lokalisieren?",
  },
  {
    "key": "fen_conquerer.conversation_02breo_text",
    "notes": "Speaker=Fen",
    "value": "Keine Chance.",
  },
  {
    "key": "fen_conquerer.conversation_fek90f_text",
    "notes": "Speaker=Dorothy Notes=Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    "value": "Du erinnerst mich an diese fiesen Waldgeister aus den Geschichten meines Vaters über das alte Land.",
  },
  {
    "key": "fen_conquerer.conversation_duq0rd_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich werde dich einfach Fen nennen.",
  },
  {
    "key": "fen_conquerer.conversation_uostgv_text",
    "notes": "Speaker=Dorothy Notes=*new* split from line above",
    "value": "Ich bin Dorothy, aber meine Freunde nennen mich Dot.",
  },
  {
    "key": "fen_conquerer.conversation_em0ovz_text",
    "notes": "Speaker=Fen",
    "value": "Meinetwegen, ich verzeihe mich wieder in deinen Ofen.",
  },
  {
    "key": "fen_conquerer.conversation_tats2u_text",
    "notes": "Speaker=Fen",
    "value": "Weck mich , wenn etwas Spannendes passiert.",
  },
  {
    "key": "mayor_01.conversation_szoc5w_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, ich komme zu spät zu meiner Politur. Wenn du eine Beschwerde einreichen möchtest, an meinem Büro hängt ein Briefkasten.",
  },
  {
    "key": "mayor_01.conversation_r6bmk4_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Und wenn es um die Beben geht, verschone mich bitte. In diesen Teilen ist das bisschen Rüttelei ganz normal.",
  },
  {
    "key": "mayor_01.conversation_orgrlo_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich will mich nicht beschweren. Ich brauche nur Zugang zur Mine, um nach einem vermissten Bot zu suchen.",
  },
  {
    "key": "mayor_01.conversation_2k8w6x_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format laugh}Pah!{format reset} Was ich brauche, ist die Mine wieder in Gang zu kriegen. Du hast nicht mal eine vernünftige Lampe!",
  },
  {
    "key": "mayor_01.conversation_o8zw9i_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "So verirrst du dich nur selber, und das kann ich mir nicht leisten. Nicht so kurz vor einer Wahl.",
  },
  {
    "key": "mayor_01.conversation_2ok5e8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Weißt du was, es gibt einen {format emph}sichereren Ort{format reset}, an dem du graben kannst. Gleich links neben der Leiter unten in der Mine.",
  },
  {
    "key": "mayor_01.conversation_kbljxa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Wenn du dein eigenes {format highlight}Erz abbaust{format reset}, um dir eine neue Lampe zu kaufen, wird dich die Wache in die richtige Mine lassen.",
  },
  {
    "key": "mayor_01.conversation_dgln8s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! Ich kann es mir nicht leisten, dass du in der Mine hopsgehst. {format highlight}Grabe nach Ressourcen{format reset}, um die Lampe zu reparieren!",
  },
  {
    "key": "mayor_01.conversation_wdf2e3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, du hast genug abgebaut, wunderbar! Ich dachte nicht, dass du das Zeug dazu hättest. Jetzt geh und statte Jones Vierfuß einen Besuch ab!",
  },
  {
    "key": "mayor_01.conversation_y8rutk_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Er ist der grüne Typ mit den Klemmen dort oben. {format highlight}Tausche das Erz{format reset} bei ihm gegen echte Moneten.",
  },
  {
    "key": "mayor_01.conversation_35uglo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format highlight}Tausche dein Erz{format reset} dort drüben bei Jones Vierfuß.",
  },
  {
    "key": "mayor_01.conversation_p2p0j1_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Alles klar! Das Geld ist dir aber nur von Nutzen, wenn du es auch ausgibst.",
  },
  {
    "key": "mayor_01.conversation_hd3efw_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Jetzt geh deine {format highlight}Lampe reparieren{format reset}, dort drüben in der Werkstatt.",
  },
  {
    "key": "mayor_01.conversation_z86wxp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Der schüchterne, eckig-aussehende Kerl dort wird dir helfen.",
  },
  {
    "key": "mayor_01.conversation_w5r2nd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Geh deine {format highlight}Lampe reparieren{format reset}, dort drüben in der Werkstatt.",
  },
  {
    "key": "mayor_01.conversation_ujjfnb_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, das sieht schon besser aus! Jetzt bist du bereit, {format highlight}die Mine zu betreten{format reset}.",
  },
  {
    "key": "mayor_01.conversation_woghf0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Und hey, vergiss nicht: Das süße, süße Erz muss fließen!",
  },
  {
    "key": "mayor_01.conversation_5r6n65_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! Es ist toll, wieder jemanden zu haben, der in regelmäßigen Abständen Erz zu Tage fördert.",
  },
  {
    "key": "mayor_01.conversation_x2jdkd_text",
    "notes": "Speaker=Dorothy",
    "value": "Nun, abgesehen von ein paar Begegnungen mit fiesen Kriechtieren, komme ich gut voran.",
  },
  {
    "key": "mayor_01.conversation_b8dzdr_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Genau so, wie ich es allen gesagt habe! Sie regen sich alle auf, dabei ist es halb so wild.",
  },
  {
    "key": "mayor_01.conversation_cjntod_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich werde mich zum Rotfelsgang begeben, und versuchen, {format highlight}die Röhre wieder in Gang zu bringen{format reset}.",
  },
  {
    "key": "mayor_01.conversation_pnbpzi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Vergiss nur nicht, das kostbare Erz an die Oberfläche zu bringen!",
  },
  {
    "key": "mayor_01.conversation_2pgjla_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Und zögere nicht, deine Einnahmen in den Geschäften der Stadt auszugeben.",
  },
  {
    "key": "mayor_01.conversation_j881iu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Aber, aber! Viele Reichtümer warten nur darauf, ausgegraben zu werden. Es gibt keinen Grund, sich mit Rotfels so zu beeilen.",
  },
  {
    "key": "mayor_01.conversation_827vm7_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, ich verstehe nicht, wieso du die Sprengladungsstation nicht einfach ignorieren kannst.",
  },
  {
    "key": "mayor_01.conversation_850lak_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Müssen wir wirklich auf Sprengstoff zurückgreifen, wie solche durchgeknallten Schnapsis?",
  },
  {
    "key": "mayor_01.conversation_ebyo6x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Hast du einen bessere Plan, wie wir den Rotfelsgang freilegen können, Söhnchen?",
  },
  {
    "key": "mayor_01.conversation_hkla2t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Nun, ich verstehe nicht, wieso sie überhaupt so tief vordringen muss.",
  },
  {
    "key": "mayor_01.conversation_s2zuik_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Glaub mir, das Erz da unten ist viel mehr wert, als das Zeugs hier oben.",
  },
  {
    "key": "mayor_01.conversation_o84rmq_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* changed format from laugh to emph",
    "value": "Hey, da wäre {format emph}dieser{format reset} Grund natürlich ...",
  },
  {
    "key": "mayor_01.conversation_wray1t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Wo ist das Problem, einfach eine gute alte Picke zu verwenden? Müssen wir wirklich auf Bomben zurückgreifen?",
  },
  {
    "key": "mayor_01.conversation_b6rus0_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich begebe mich besser wieder nach unten und räume den eingestürzten Durchgang beim Rotfels frei.",
  },
  {
    "key": "mayor_01.conversation_j39zeq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wäre wirklich eine super Sache für jeden, wenn ihn jemand freiräumen würde.",
  },
  {
    "key": "mayor_01.conversation_vxn818_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, ich {format emph}mag{format reset} den Gedanken wirklich, an diese kostbaren Steine da unten heranzukommen.",
  },
  {
    "key": "mayor_01.conversation_7zj949_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hoffen wir, dass du den Rotfels freiräumen kannst, ohne dabei alles schlimmer zu machen.",
  },
  {
    "key": "mayor_01.conversation_f7egkh_text",
    "notes": "Speaker=Dorothy",
    "value": "Jetzt wo der Rotfelsgang passierbar ist, kannst du weiter unten nach Rusty suchen.",
  },
  {
    "key": "mayor_01.conversation_ksg9fp_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, wird der Bot immer noch vermisst? Nun, vergiss nur nicht, ein bisschen von dem wertvollen Erz mit nach oben zu bringen.",
  },
  {
    "key": "mayor_01.conversation_gu106f_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du solltest ohne Probleme bist runter zum Schutzwall graben können, Herzchen.",
  },
  {
    "key": "mayor_01.conversation_56ijq0_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Es ist möglich, dass dein Freund durch einen der verdammten Risse in ihm geschlüpft ist.",
  },
  {
    "key": "mayor_01.conversation_ynbcdq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Wenn ich du wäre, würde ich mich runter zur Maurerstation begeben.",
  },
  {
    "key": "mayor_01.conversation_twgnbe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Da unten sollte irgendwo noch eine alte Ausrüstungsmaschine sein, die dir deine Arbeit erheblich leichter machen wird.",
  },
  {
    "key": "mayor_01.conversation_51emyp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Du meinst die, die meine dumpfbackigen Brüder letztes Jahr beim Ziegellegen eingemauert haben?",
  },
  {
    "key": "mayor_01.conversation_8gee3i_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ach, zum Henker! Ich wette, du {format highlight}findest einen Weg um die Ziegel herum{format reset}, wenn du dich richtig umsiehst.",
  },
  {
    "key": "mayor_01.conversation_4sh4u4_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed the line beneath this.",
    "value": "Hey! Berichte mir alle Öffnungen, die du findest, damit ich später jemanden losschicken kann, der den Wall zusammenflickt.",
  },
  {
    "key": "mayor_01.conversation_gbjzn6_text",
    "notes": "Speaker=Dorothy Notes=*new* changed cave to passage",
    "value": "Ich habe da unten beim Wall einen ultra-merkwürdigen Gang gefunden. Er ist komplett mit komischen Pflanzen überwuchert.",
  },
  {
    "key": "mayor_01.conversation_jsqibo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, die meisten Sachen in dieser Tiefe sind komisch, wenn du mich fragst. Immerhin befindet sich Schnapsbergen in der Nähe.",
  },
  {
    "key": "mayor_01.conversation_2xq01z_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Meine anderen nichtsnutzigen Söhne erzählten etwas davon, über eine merkwürdigen, durchwucherte Höhle gestolpert zu sein.",
  },
  {
    "key": "mayor_01.conversation_aukq83_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich dachte, sie litten unter dieser verdammten Druckkrankheit.",
  },
  {
    "key": "mayor_01.conversation_8rttb6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Meine Brüder haben die Maurerstation ordentlich eingemauert.",
  },
  {
    "key": "mayor_01.conversation_6scmnj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Sie sind nicht wirklich die besten Geräte im Schuppen, keiner meiner Jungs.",
  },
  {
    "key": "mayor_01.conversation_jseqve_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe es durch den Wall geschafft und die Maurerstation gefunden ..., aber kein Zeichen von Rusty.",
  },
  {
    "key": "mayor_01.conversation_saqvas_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, kein Bot bei klarem Verstand würde so tief graben wollen! Du willst doch nicht {format highlight} Schnapsbergen betreten{format reset}, oder?",
  },
  {
    "key": "mayor_01.conversation_41t2gq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Dieser Presslufthammer knackt das Gestein, und bringt dich in einem Augenblick bis ganz nach unten.",
  },
  {
    "key": "mayor_01.conversation_nlrzra_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Aber achte auf deinen Wasserstand. Dieses Gerät schluckt es runter wie ein Seemannsbot in der Wüste.",
  },
  {
    "key": "mayor_01.conversation_x4aowp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, bring bloß keine von diesen irren Schnapsis mit hier hoch. Das ist das Letzte, was ich gebrauchen kann.",
  },
  {
    "key": "mayor_01.conversation_acygrc_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Sei vorsichtig, wenn du Löcher in den Wall bohrst, und passe auf diese verwirrten Schnapsis auf.",
  },
  {
    "key": "mayor_01.conversation_mo33pi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed fake news to tone down Trumpism",
    "value": "Diese Exzentrikerin, Professorin Sherman, verbreitet immer noch Angst mit ihren Messwerten zu den Erdbeben.",
  },
  {
    "key": "mayor_01.conversation_27gaig_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, das letzte Rumpeln hat nicht mal etwas umgeworfen.",
  },
  {
    "key": "mayor_01.conversation_ydzkaa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Sie sieht von ihrer Raketenstartrampe auf uns herab, nur weil sie ein Diplom hat.",
  },
  {
    "key": "mayor_01.conversation_667vwu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Sherman denkt, sie sei so schlau mit ihrem Diplom. {format laugh}Pah!{format reset} Das einzige Papier das zählt, ist grün ...",
  },
  {
    "key": "mayor_01.conversation_jx90fz_text",
    "notes": "Speaker=Dorothy",
    "value": "Dieser irre Tempelkult beschützt wohl eine Art {format emph}Maschine des Jüngsten Gerichts{format reset}.",
  },
  {
    "key": "mayor_01.conversation_jw27fp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Diese Maschiene hat diese verdammten, unnatürlichen Erschütterungen verursacht?",
  },
  {
    "key": "mayor_01.conversation_9baw7n_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, das ist offensichtlich nicht unser Problem!",
  },
  {
    "key": "mayor_01.conversation_7m1f5t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Man kann vom Büro des Bürgermeister nicht verlangen, sich auch noch um Ende-der-Welt-Szenarien zu kümmern.",
  },
  {
    "key": "mayor_01.conversation_qbl22o_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Meine Hauptaufgabe besteht darin, Bots dazu zu bringen, kostbare Steine aus der Mine zu holen. Und sie zu besteuern.",
  },
  {
    "key": "mayor_01.conversation_v4im3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du hast hier das Sagen, Idiot. Du hast dich um dieses Amt bemüht, jetzt komm damit klar!",
  },
  {
    "key": "mayor_01.conversation_v6x25f_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, der Mädchenbot war bereits im Tempel. Sie kann doch einfach noch einmal runtergehen und die Maschine abschalten!",
  },
  {
    "key": "mayor_01.conversation_6dx6ev_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Na also, Problem gelöst! Und vergiss nicht, mehr von diesen kostbaren Steinen zurückzubringen.",
  },
  {
    "key": "mayor_01.conversation_6aje4l_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, bist du schon dazu gekommen, {format highlight} die Maschine des Jüngsten Gerichts abzuschalten{format reset}?",
  },
  {
    "key": "mayor_01.conversation_3lxi6c_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir haben es geschafft, die Maschine des Jüngsten Gerichts zu zerstören.",
  },
  {
    "key": "mayor_01.conversation_rv004f_text",
    "notes": "Speaker=Fen",
    "value": "Und wie wir das haben! Du hättest sie explodieren sehen sollen!",
  },
  {
    "key": "mayor_01.conversation_7nmsnx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Seht ihr? Das Bürgermeisterbüro hatte die ganze Zeit alles unter Kontrolle!",
  },
  {
    "key": "mayor_01.conversation_qpbmn2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format emph}Dummkopf!{format reset}",
  },
  {
    "key": "mayor_01.conversation_j8m71m_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, {format emph}Ich{format reset} war es, der sie ursprünglich runter in die Mine geschickt hat.",
  },
  {
    "key": "mayor_01.conversation_sptgv3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ich verlange etwas Anerkennung. Ich war es, der dich ursprünglich runter in die Mine geschickt hat.",
  },
  {
    "key": "mayor_01.conversation_2h1yth_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir haben noch mehr Erdbebenmaschinen unten in den Minen gefunden.",
  },
  {
    "key": "mayor_01.conversation_xbnodu_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* enclosed "come" into the format",
    "value": "Ach, {format emph}komm schon{format reset}! Kann ich hier nicht einmal eine Minute verschnaufen?",
  },
  {
    "key": "mayor_01.conversation_6c2elx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, alles was ich wollte, war ein bequemer Job, der nichts mit dem Graben in dieser dreckigen Mine zu tun hatte.",
  },
  {
    "key": "mayor_01.conversation_kk8x0s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Wenn du es nicht schaffst, {format highlight}diese Maschinen abzuschalten{format reset}, muss ich vielleicht die gesamte Stadt evakuieren!",
  },
  {
    "key": "mayor_01.conversation_hmjz7t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hast du überhaupt eine Idee, wie viel das kosten wird?",
  },
  {
    "key": "mayor_01.conversation_qzd676_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, sammle wenigstens ein paar Kostbarkeiten ein, während du dich dort unten herumtreibst, abgemacht?",
  },
  {
    "key": "mayor_01.conversation_ocz2bm_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hast du schon den Rest dieser Maschinen abgeschaltet?",
  },
  {
    "key": "mayor_01.conversation_wihfk8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ein wild wuchernder Dschungel in den Minen, kultische Untergangtheoretiker ...",
  },
  {
    "key": "mayor_01.conversation_jcggy6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ich wette, der letzte Bürgermeister musste sich nicht mit solchen Dingen herumschlagen ...",
  },
  {
    "key": "mayor_01.conversation_8d282i_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Irgendwie wünschte ich mir, ich wäre stattdessen ins Familiengeschäft eingestiegen. Meine Brüder sehen irgendwie glücklich aus.",
  },
  {
    "key": "mayor_01.conversation_w4v0m6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ich sollte einfach anfangen, meine Taschen zu packen, so wie der Rest der Wählerschaft.",
  },
  {
    "key": "mayor_01.conversation_mm9lt2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, ohne eine Stadt zum regieren kann ich kein Bürgermeister sein, oder nicht? Hm, der Gedanke ist eigentlich ganz tröstlich ...",
  },
  {
    "key": "mayor_01.conversation_e4p6yr_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, vielleicht sollte ich dem Familienunternehmen beitreten, und ein neues Leben als Asteroidenminenarbeiter starten.",
  },
  {
    "key": "mayor_01.conversation_yzrylo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! Was hälst du von diesem Slogan? "Alles bleibt, wie gehabt!" Ziemlich gut, oder?",
  },
  {
    "key": "talk_to_mayor.conversation_pap70a_text",
    "notes": "Speaker=Dorothy",
    "value": "Ein Bergarbeiter mit einem roten Schal? Das {format emph}muss{format reset} Rusty sein! Endlich eine aussichtsvolle Spur!",
  },
  {
    "key": "talk_to_mayor.conversation_n0lq8o_text",
    "notes": "Speaker=Fen",
    "value": "Diese Erdbeben klingen echt vielversprechend.",
  },
  {
    "key": "talk_to_mayor.conversation_3nu9ex_text",
    "notes": "Speaker=Fen",
    "value": "Nichts geht über ein wenig Chaos, um ein Abenteuer aufzupeppen.",
  },
  {
    "key": "talk_to_mayor.conversation_elfbhm_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich muss {format highlight}mit dem Bürgermeister darüber sprechen{format reset}, wie ich in die Mine gelange.",
  },
  {
    "key": "guard_archaea.conversation_lty8j0_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Junge Dame, es ist dir nicht gestattet, hier unten zu graben!",
  },
  {
    "key": "guard_archaea.conversation_ml6q7x_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Wir können nicht zulassen, dass sich noch mehr Bergarbeiter verirren, verstehst du?",
  },
  {
    "key": "guard_archaea.conversation_cmr7ae_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schlage vor, du sprichst mit dem Bürgermeister, und holst die entsprechende Genehmigung ein.",
  },
  {
    "key": "guard_archaea.conversation_jqyolm_text",
    "notes": "Speaker=Coral Armstrong Notes=Her chest lamp is busted",
    "value": "Stehen geblieben, junge Dame! Ich kann dir das Graben hier ohne geeignete Lichtquelle nicht gestatten.",
  },
  {
    "key": "guard_archaea.conversation_jmhinb_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich möchte hier unten nur nach meinem Freund suchen! Wie wäre es, wenn ich nur einmal kurz gucken gehe?",
  },
  {
    "key": "guard_archaea.conversation_97lht6_text",
    "notes": "Speaker=Fen",
    "value": "Ja, lass sie nachsehen. Sie wird es {format emph}sicher{format reset} zurück nach oben schaffen.",
  },
  {
    "key": "guard_archaea.conversation_naakhs_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, wir haben schon {format emph}einen{format reset} Minenarbeiter zu viel hier unten verloren.",
  },
  {
    "key": "guard_archaea.conversation_wjso4t_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Es ist zu gefährlich, den Weg im Dunkeln zu suchen. Wie wäre es, wenn du stattdessen an dem gut beleuchteten Ort dort drüben {format highlight}Erz abbaust{format reset}?",
  },
  {
    "key": "guard_archaea.conversation_iom5do_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Es ist zu gefährlich, den Weg im Dunkeln zu suchen. Wie wäre es, wenn du zuerst in der Stadt deine {format highlight}Lampe reparierst{format reset}?",
  },
  {
    "key": "guard_archaea.conversation_c5cn1e_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Du musst {format highlight}nach Erz graben{format reset}, um dir eine vernünftige Lampe leisten zu können.",
  },
  {
    "key": "guard_archaea.conversation_6b9sev_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Wie wäre es, wenn du {format highlight}alle Erze in deinem Besitz eintauschst{format reset}, und dann deine Lampe in der Werkstatt reparierst?",
  },
  {
    "key": "guard_archaea.conversation_66rd82_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, du kannst oben in der Werkstatt{format highlight} deine Lampe reparieren{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_94r9zk_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ah! Sieht so aus, als wärst du bereit zu graben!",
  },
  {
    "key": "guard_archaea.conversation_n9j9h3_text",
    "notes": "Speaker=Dorothy",
    "value": "Du lässt mich jetzt also {format highlight}tiefer{format reset} in die Mine hinein?",
  },
  {
    "key": "guard_archaea.conversation_p0ntw5_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Sicher! Zeig mir einfach, dass du die {format highlight}Laterne dort drüben anzünden{format reset} kannst, und ich öffne die Luken.",
  },
  {
    "key": "guard_archaea.conversation_wphcux_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Wie wäre es, wenn du zuerst die {format highlight}Laterne dort drüben anzündest{format reset}, dann lasse ich dich in die Mine.",
  },
  {
    "key": "guard_archaea.conversation_f36o1k_text",
    "notes": "Speaker=Coral Armstrong Notes=*new* expanded this as I removed the full text that was used before. It was repatative.",
    "value": "Ich schätze, das Röhrensystem wird dich weitaus schneller in die Stadt bringen, als du zu Fuß dazu in der Lage wärst.",
  },
  {
    "key": "guard_archaea.conversation_ih3zjl_text",
    "notes": "Speaker=Dorothy",
    "value": "Du hattest recht, der Rotfelsgang ist verschlossen.",
  },
  {
    "key": "guard_archaea.conversation_lynw1k_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Dachte ich es mir.",
  },
  {
    "key": "guard_archaea.conversation_arg7cq_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, du wirst ihn sehr einfach mit einem Satz Sprengstoff freisprengen können.",
  },
  {
    "key": "guard_archaea.conversation_94selp_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, mit einem gut platzierten Satz Sprengstoff fegt es Rotfels so richtig frei.",
  },
  {
    "key": "guard_archaea.conversation_pl5kjt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, der Bürgermeister wüsste gerne Bescheid, sobald Rotfels wieder passierbar ist.",
  },
  {
    "key": "guard_archaea.conversation_d3sb26_text",
    "notes": "Speaker=Coral Armstrong Notes=Shiners are cave dwelling human decendants.",
    "value": "Ich bin in den Minen vielen Kreaturen begegnet, aber keine sind so wankelmütig und gefährlich wie Schnapsis.",
  },
  {
    "key": "guard_archaea.conversation_a458ae_text",
    "notes": "Speaker=Coral Armstrong Notes=A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    "value": "Der Krieg war zwar lange vor meine Zeit, aber ich bin diesen Landeiern schon ein ums andere Mal begegnet.",
  },
  {
    "key": "guard_archaea.conversation_t6mrk7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Mit ihnen reden ist zwecklos, hau einfach so schnell und so oft drauf, wie du kannst.",
  },
  {
    "key": "guard_archaea.conversation_pygh76_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Das macht vielleicht einen etwas brutalen Eindruck, aber ich würde es nicht darauf ankommen lassen.",
  },
  {
    "key": "guard_archaea.conversation_xgdjhu_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Zum Glück hat man diesen Wall nach dem Krieg gebaut.",
  },
  {
    "key": "guard_archaea.conversation_ujn89n_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Diese verwirrten Schnapsis waren früher vielleicht ganz anders.",
  },
  {
    "key": "guard_archaea.conversation_nd5hoz_text",
    "notes": "Speaker=Coral Armstrong Notes=Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    "value": "Jetzt sind sie einfach nur mutierte Bebenmacher.",
  },
  {
    "key": "guard_archaea.conversation_5xd7xt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich schätze, du wirst einem Mutanten nie wirklich trauen können.",
  },
  {
    "key": "guard_archaea.conversation_y6jyvf_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Bist du diesen irren Kultisten auf ihrer Pilgerreise des Wahnsinns begegnet?",
  },
  {
    "key": "guard_archaea.conversation_1tzeuc_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Manchmal nehmen sie den Weg durch die Minen, wenn sie zwischen den Tempeln wandern.",
  },
  {
    "key": "guard_archaea.conversation_147ntm_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normalerweise würden sie einfach den Wüstenpfad durch die Windigen Ebenen nehmen.",
  },
  {
    "key": "guard_archaea.conversation_f34oeg_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich hab eigentlich nichts gegen Kultisten. Man fühlt sich auch weniger einsam, wenn sie hier hindurchkommen.",
  },
  {
    "key": "guard_archaea.conversation_l509g4_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich bin wirklich beeindruckt, wie weit du es nach unten geschafft hast.",
  },
  {
    "key": "guard_archaea.conversation_lbobkd_text",
    "notes": "Speaker=Coral Armstrong Notes=*format*",
    "value": "Sei trotzdem vorsichtig, ich habe Geschichten von Gefahren gehört, die normale Bürger nicht kennen.",
  },
  {
    "key": "guard_archaea.conversation_alemgw_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Stelle sicher, dass es immer einen Weg zurück gibt. Ein Tunnel ohne Ausgang ist nichts weiter als ein langer Sarg.",
  },
  {
    "key": "guard_archaea.conversation_51bz8w_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Würde nicht schaden, {format emph}das{format reset} im Hinterköpfchen zu behalten, und stelle sicher, dass du genügend Panzerung hast.",
  },
  {
    "key": "guard_archaea.conversation_e9lgr6_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Bleib wachsam und halte deine Ausrüstung auf dem neuesten Stand, besseren Rat kann ich dir nicht geben.",
  },
  {
    "key": "guard_archaea.conversation_19pnkh_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Anscheinend haben diese Yonker-Brüder einen merkwürdig wuchernden Dschungel in der Mine gesehen.",
  },
  {
    "key": "guard_archaea.conversation_205qqo_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Habe auch gehört, dass er sich ausbreitet, aber ich würde ihn nie an die Stadt herankommen lassen.",
  },
  {
    "key": "guard_archaea.conversation_59fokz_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Vielleicht investiere ich einfach in eine richtige Axt, nur für den Fall. Immerhin ist sie ein Mehrzweckgerät.",
  },
  {
    "key": "guard_archaea.conversation_vwt53j_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Schon beängstigend, das da einfach irgendwo urplötzlich ein Dschungel herausschießen könnte.",
  },
  {
    "key": "guard_archaea.conversation_1re540_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ich gebe zu, dass ich nach diesem letzten Erdbeben ein bisschen besorgt war.",
  },
  {
    "key": "guard_archaea.conversation_25kyco_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Scheint, als würden die Beben in letzter Zeit stärker werden. Aber keine Sorge, ich bleibe auf meinem Posten.",
  },
  {
    "key": "guard_archaea.conversation_e0zgh7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Möglicherweise verletzen sich Leute hier unten, wenn niemand sie vor den Gefahren bewahrt.",
  },
  {
    "key": "guard_archaea.conversation_jkptm2_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Für Angst gibt es keinen Platz unter dieser Brustplatte, ganz allein Pflichtbewusstsein. Das ist alles, was mich erfüllt.",
  },
  {
    "key": "guard_archaea.conversation_4niz25_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format highlight}Behalte dein Licht im Auge{format reset}, sodass du dort unten nicht plötzlich im Dunkeln sitzt.",
  },
  {
    "key": "guard_archaea.conversation_aex9as_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Geh einfach zurück und {format highlight}fülle es oben wieder auf{format reset}, wenn es langsam abnimmt.",
  },
  {
    "key": "guard_archaea.conversation_dmvx8z_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Die Mine ist nicht gerade der sicherste Ort, also halte deine Ausrüstung in tipptopper Form.",
  },
  {
    "key": "welcome_to_el_machino.conversation_uimryl_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hallo! Beruhigt euch bitte, Leute!",
  },
  {
    "key": "welcome_to_el_machino.conversation_31d0sd_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Eigentlich sind diese {format nervous}Erdbeben{format reset} etwas, worüber man sich Sorgen machen sollte.",
  },
  {
    "key": "welcome_to_el_machino.conversation_4njhbf_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich sagte ja bereits, mein Seismometer empfängt wirklich merkwürdige Messwerte!",
  },
  {
    "key": "welcome_to_el_machino.conversation_l4n0br_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Es gibt Wichtigeres, um das wir uns sorgen sollten, wie zum Beispiel den Erznachschub zu gewährleisten.",
  },
  {
    "key": "welcome_to_el_machino.conversation_dzl3uz_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Dummkopf! Warum hörst du nicht auf die Experten?",
  },
  {
    "key": "welcome_to_el_machino.conversation_7blj3t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Mutti, bitte! Diese "Experten" mit ihren "Fakten" ... Sie sehen den Gesamtzusammenhang doch gar nicht.",
  },
  {
    "key": "welcome_to_el_machino.conversation_lwjidu_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Und was ist mit dem {format emph}Minenarbeiter mit dem roten Schal{format reset}, der es nie nach oben zurückgeschafft hat?",
  },
  {
    "key": "welcome_to_el_machino.conversation_jije2r_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ich habe bereits eine Wache eingestellt, die verhindert, dass mehr unvorbereitete Bots verschwinden.",
  },
  {
    "key": "welcome_to_el_machino.conversation_jhc64p_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Also, jetzt behalten wir mal alle einen klaren Kopf, und erinnern uns daran, dass das Bürgermeisterbüro keine Schuld trifft.",
  },
  {
    "key": "welcome_to_el_machino.conversation_njlyi9_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Idiot!",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_xqrxw3_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hihihi! Bumm!{format reset} Lass uns das wiederholen.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_y6g3s7_text",
    "notes": "Speaker=Dorothy",
    "value": "Diese Bomben werden sich sicher als nützlich erweisen. Sie können Orte erreichen, an die meine Picke nicht herankommt.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_c5us81_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich schätze, ich sollte {format highlight}dem Bürgermeister davon erzählen{format reset}, dass der Durchgang wieder passierbar ist.",
  },
  {
    "key": "guard_open_hatch.conversation_ig8tga_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Wurde aber auch Zeit, dass in den Tunneln hier mal wieder jemand gräbt.",
  },
  {
    "key": "guard_open_hatch.conversation_3li9iu_text",
    "notes": "Speaker=Dorothy",
    "value": "Endlich bin ich auf der richtigen Spur, um Rusty zu finden.",
  },
  {
    "key": "guard_open_hatch.conversation_ti9ln5_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Ich schätze dein Kumpel musste irgendwann durch den Rotfelsgang hindurch.",
  },
  {
    "key": "guard_open_hatch.conversation_60et06_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normalerweise könntest du das pneumatische Röhrensystem benutzen, um dorthin- und zurückzukommen.",
  },
  {
    "key": "guard_open_hatch.conversation_cix8sl_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Es hat sich jedoch während eines Erdbebens verstopft. Es wäre klug, {format highlight}es vorher freizuräumen{format reset}.",
  },
  {
    "key": "guard_open_hatch.conversation_h47l73_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Nun, wie wär's, wenn ich einfach die Luken öffne, und dich runterlasse?",
  },
  {
    "key": "buddy_need_light.conversation_q6n8pp_text",
    "notes": "Speaker=Fen",
    "value": "Hey es wird dunkel. Ich kann kaum etwas sehen, und ich bestehe aus Licht.",
  },
  {
    "key": "buddy_need_light.conversation_1dc723_text",
    "notes": "Speaker=Fen Notes=The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    "value": "{format highlight}Gehe in die Stadt{format reset} zurück und fülle deine Lampe wieder auf, damit ich mich hier unten nicht verlaufe.",
  },
  {
    "key": "fen_cave_in.conversation_ytvst4_text",
    "notes": "Speaker=Dorothy",
    "value": "Das muss der Rotfelsgang sein. Ist ganz schön verschüttet.",
  },
  {
    "key": "fen_cave_in.conversation_ac4a61_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Wenn du Sprengstoff hättest, könntest du dieses Gestein einfach wegblasen.",
  },
  {
    "key": "fen_cave_in.conversation_f2qhr1_text",
    "notes": "Speaker=Dorothy",
    "value": "Das ist keine schlechte Idee! Ich sollte zurück in die Stadt und mich umhören.",
  },
  {
    "key": "fen_cave_in.conversation_8j9cex_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Oh ja, Sprengstoff!{format reset} Vielleicht bläst du dir sogar ein oder zwei deiner Teile weg ...",
  },
  {
    "key": "fen_cave_in.conversation_0g7tly_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Botverdammmich! Lass uns einfach diese pneumatische Röhre freimachen, okay?",
  },
  {
    "key": "fen_cave_in.conversation_n67xrl_text",
    "notes": "Speaker=Dorothy",
    "value": "Das muss der Rotfelsgang sein. Ist komplett eingestürzt.",
  },
  {
    "key": "fen_cave_in.conversation_1kwj0v_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Du könntest die Bomben verwenden, um den Weg freizumachen.",
  },
  {
    "key": "fen_cave_in.conversation_661ekz_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Ich sollte deine destruktive Ader wohl nicht noch verstärken, aber das ist keine schlechte Idee.",
  },
  {
    "key": "fen_cave_in.conversation_xdrduu_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Oh ja, Sprengstoff!{format reset} Vielleicht bläst du dir sogar ein oder zwei deiner Teile weg!",
  },
  {
    "key": "fen_cave_in.conversation_6c0vsm_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Botverdammmich! Lass uns einfach diese pneumatische Röhre ausprobieren, okay?",
  },
  {
    "key": "mechanic.conversation_h5wj1m_text",
    "notes": "Speaker=Turtle Bucket Notes=Very nervous person",
    "value": "Ich will nicht nerven ..., aber diese {format nervous}Erdbeben{format reset} machen mir angst.",
  },
  {
    "key": "mechanic.conversation_o86kfe_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Aber, eh ... Nun, wenn sie wirklich ein Problem wären, dann würde der Bürgermeister auch besorgter sein.",
  },
  {
    "key": "mechanic.conversation_o2oiou_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Der Bürgermeister sagt, dass man sich um diese {format nervous}Erdbeben{format reset} keine Sorgen machen müsse, also denke ich mal, ähm, dass das so stimmt.",
  },
  {
    "key": "mechanic.conversation_h7ppy6_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, hallo ...",
  },
  {
    "key": "mechanic.conversation_kg1mo1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* The light source is set in the middle of the chest.",
    "value": "Ich sehe, du hast deine Lichtquelle ramponiert.",
  },
  {
    "key": "mechanic.conversation_q3my9j_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ich würde, eh ... bei diesem {format nervous}Gerumpel{format reset} nicht im Dunkeln herumwandern.",
  },
  {
    "key": "mechanic.conversation_ltmso8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Also, eh ... bevor du dich in die Mine begibst, eh ... wäre es besser, wenn du zuerst {format highlight}deine Lampe reparierst{format reset}.",
  },
  {
    "key": "mechanic.conversation_9zjn4q_text",
    "notes": "Speaker=Turtle Bucket Notes=Workbench",
    "value": "Du kannst meine Werkbank hier benutzen ..., wenn du möchtest.",
  },
  {
    "key": "mechanic.conversation_izda31_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "An meiner Werkbank kannst du {format highlight}deine Lampe reparieren{format reset} ..., wenn du möchtest.",
  },
  {
    "key": "mechanic.conversation_649j7z_text",
    "notes": "Speaker=Turtle Bucket Notes=Dorothys speed boots.",
    "value": "Oh ... eh, ich mag deine Stiefel.",
  },
  {
    "key": "mechanic.conversation_fjqq9f_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja? Sie wurden von irgendeiner Maschine tief unter der Wüste verbessert.",
  },
  {
    "key": "mechanic.conversation_v3f2hn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Die extra, eh, Sprinthydraulik hat sie wohl richtig, richtig schnell gemacht.",
  },
  {
    "key": "mechanic.conversation_qnv8df_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Diese Ausrüstungsmaschinen unten in den Bergbaustationen sind ziemlich cool, was?",
  },
  {
    "key": "mechanic.conversation_f9qput_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh ... eh, alles klar. Nun, man kann sie überall in den Minen finden.",
  },
  {
    "key": "mechanic.conversation_ji4atj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, sie sind sehr, {format emph}sehr alt{format reset}. Wir wissen nicht, wer sie erbaut hat, aber für unsere Art funktionieren sie wunderbar.",
  },
  {
    "key": "mechanic.conversation_kn7n3g_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Über die Jahre hinweg haben Bergarbeiterbots in der nähe dieser Maschinen Bergbaustationen errichtet.",
  },
  {
    "key": "mechanic.conversation_w8uqp5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Wir wissen wo sich ein paar von ihnen befinden, eh, aber die Minen sind viel, viel, {format emph}viel größer{format reset}, als der Teil, in dem gearbeitet wird.",
  },
  {
    "key": "mechanic.conversation_m5pbwk_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Ich habe von verlorenen Stationen gelesen, mit cooler Ausrüstung, die in eh ... tiefer liegenden, unkartierten Bereichen der Mine liegen.",
  },
  {
    "key": "mechanic.conversation_wad1be_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh ... eh, aber natürlich.",
  },
  {
    "key": "mechanic.conversation_apkmkg_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Wow, du hast einen Druckbombenwerfer gefunden!",
  },
  {
    "key": "mechanic.conversation_qjmh35_text",
    "notes": "Speaker=Turtle Bucket Notes=This is techno jibberish, feel free to make up new stuff.",
    "value": "Der dreifache Pümpel sorgt für einen {format singsong}geschmeidigen{format reset} Fluss durch das Siphonrohr.",
  },
  {
    "key": "mechanic.conversation_ua28gp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Er verschießt ein selbsthaftendes Projektil, das an jeder Oberfläche kleben bleibt, bevor es explodiert.",
  },
  {
    "key": "mechanic.conversation_saczrj_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The pressure bomb works with water.",
    "value": "Ich wette das Ding spritzt wie verrückt! Hihi ...",
  },
  {
    "key": "mechanic.conversation_tz9y1l_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh ... entschuldige. Ich, eh, habe mich wohl etwas mitreißen lassen.",
  },
  {
    "key": "mechanic.conversation_yxae4k_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, eh ... du hast es bist zur Maurerstation geschafft wie ich sehe.",
  },
  {
    "key": "mechanic.conversation_rz6lrl_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The upgrade is a mechanical fist that works like a jack hammer.",
    "value": "Dieser Hammer besitzt richtig Power und bricht selbst durch die härtesten Bereiche von Gestein.",
  },
  {
    "key": "mechanic.conversation_art1sv_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Damit wird aus dem Erkunden der anderen Seite des Walls Kinderkram.",
  },
  {
    "key": "mechanic.conversation_1ghl26_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Und er lässt sich kinderleicht aufwerten, in Sachen Brennstoffversorgung und so weiter.",
  },
  {
    "key": "mechanic.conversation_a315z5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ein stärkerer pneumatischer Zylinder, würde eine erhöhte maximale Betriebsgeschwindigkeit erlauben ...",
  },
  {
    "key": "mechanic.conversation_lyy59m_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, ich meine, er hat eine Menge Potential, das ist alles.",
  },
  {
    "key": "mechanic.conversation_ornloo_text",
    "notes": "Speaker=Turtle Bucket Notes=See "Spelunker Station" in other document",
    "value": "{format singsong}Oh, wow!{format reset} Ich dachte die Höhlenforscherstation sei längst Geschichte!",
  },
  {
    "key": "mechanic.conversation_uo7wrd_text",
    "notes": "Speaker=Turtle Bucket Notes=The hook shot look like a grapling hook and is shot out of your arm",
    "value": "Du hast den alten Greifhaken trotzdem gefunden!",
  },
  {
    "key": "mechanic.conversation_4x94pz_text",
    "notes": "Speaker=Turtle Bucket Notes="zip" as in fly or move fast",
    "value": "Dieses Teil erlaubt dir, dich so rasant durch die Mine zu bewegen wie{format emph}nie{format reset} zuvor.",
  },
  {
    "key": "mechanic.conversation_wt4pay_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Damit kannst du jetzt fast jede Ecke und jeden Winkel erkunden!",
  },
  {
    "key": "mechanic.conversation_jc96m9_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "In diesen Minen warten unzählige Geheimnisse darauf, entdeckt zu werden.",
  },
  {
    "key": "mechanic.conversation_xxorzf_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "{format singsong}OH WOW!{format reset} Ist es das, was ich denke?",
  },
  {
    "key": "mechanic.conversation_h0sfna_text",
    "notes": "Speaker=Turtle Bucket Notes=It's a falaming Pick Axe",
    "value": "Wie bist du an eine Feueraxt herangekommen?",
  },
  {
    "key": "mechanic.conversation_4p03fk_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, ich wette sie war irgendwo im östlichen Tempel versteckt.",
  },
  {
    "key": "mechanic.conversation_7shcmp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ich habe in einem meiner Gerätemagazine über sie gelesen. Die Wahrscheinlichkeit, dass dieses Ding noch existiere ... Ich {format emph}kann es nicht glauben{format reset}!",
  },
  {
    "key": "mechanic.conversation_9e6rbj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh ... eh, sie ist wirklich toll.",
  },
  {
    "key": "mechanic.conversation_8x0zgn_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* see Aeronaut Station in the other document",
    "value": "Oh, komm schon! Sag mir nicht, du bist bis runter zur Luftfahrerstation gekommen!",
  },
  {
    "key": "mechanic.conversation_gqdbky_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Sie wurde angeblich weit unter den modernen Teilen der Mine begraben.",
  },
  {
    "key": "mechanic.conversation_34ele3_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Niemals hätte ich geglaubt, ich würde mal ein echtes Düsentriebwerk zu Gesicht bekommen!",
  },
  {
    "key": "mechanic.conversation_vr5wop_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ich flippe total aus!",
  },
  {
    "key": "mechanic.conversation_0czv1r_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* just hammering home that the world is more open at this point.",
    "value": "Mit dem Ding kannst du die ganze Mine durchqueren. Du kommst damit an Orte, die du vorher nie hättest erkunden können.",
  },
  {
    "key": "mechanic.conversation_2bpv40_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* as in the old saying "the world is your oyster"",
    "value": "Die Mine liegt dir wahrlich zu Füßen.",
  },
  {
    "key": "mechanic.conversation_6c8k38_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ich wette, ich kann sogar ein paar krasse Verbesserungen vornehmen ... eh, wenn du möchtest ...",
  },
  {
    "key": "mechanic.conversation_kddst5_text",
    "notes": "Speaker=Turtle Bucket Notes=This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    "value": "Eh, dieser Dschungel unten in der Mine ... ist in aller Munde.",
  },
  {
    "key": "mechanic.conversation_1ibifo_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Ich hoffe, er breitet sich nicht bis nach oben aus. Eh ... ich schaffe es ja nicht einmal in die Nähe dieser schrecklichen Kakteen zu kommen.",
  },
  {
    "key": "mechanic.conversation_qxg2dp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ich wette wenn du eine richtig tolle Motorsense hättest, eh ... würdest du dieses Gemüse einfach kleinschnibbeln.",
  },
  {
    "key": "mechanic.conversation_jn0ayb_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Zu schade, dass es keine alten Bergbaustationen mit so etwas gibt ...",
  },
  {
    "key": "mechanic.conversation_evptsm_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, ich hoffe diese {format nervous}komischen Pflanzen{format reset} schaffen es nicht bis hier hinauf in die Stadt.",
  },
  {
    "key": "mechanic.conversation_d2k8hv_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, ich will die Professorin nicht belästigen ...",
  },
  {
    "key": "mechanic.conversation_zfm1c4_text",
    "notes": "Speaker=Turtle Bucket Notes=The rocket is a space rocket.",
    "value": "Vielleicht sollte ich sie fragen, ob ich einen Blick in die Rakete werden darf, jetzt wo sie fertig ist?",
  },
  {
    "key": "mechanic.conversation_js74jz_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Sie ist wirklich, wirklich cool, findest du nicht auch?",
  },
  {
    "key": "mechanic.conversation_bufmli_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Eh, ich würde wirklich gerne einen Blick in das Raketenschiff werden ...",
  },
  {
    "key": "mechanic.conversation_yxbbjn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Raketen sind cool!",
  },
  {
    "key": "mechanic.conversation_1ovqzn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* rephrased this line to work in more situations.",
    "value": "Du kannst deine Ausrüstung bei meiner Werkbank reparieren oder verbessern, eh ... jederzeit.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_4dhtk4_text",
    "notes": "Speaker=Fen",
    "value": "Okay, lass uns das Ding in {format singsong}Stücke{format reset} sprengen!",
  },
  {
    "key": "fen_cave_in_bomb.conversation_eff23g_text",
    "notes": "Speaker=Dorothy",
    "value": "Du musst wirklich mal mit jemandem über diese ganze Mutwillige-Zerstörung-Sache reden.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_oxrw0l_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ich rede in diesem Moment mit dir darüber. Wann rede ich denn mal nicht über Zerstörung?",
  },
  {
    "key": "fen_cave_in_bomb.conversation_nmb2rq_text",
    "notes": "Speaker=Dorothy",
    "value": "Genau ...",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_t0dmfu_text",
    "notes": "Speaker=Fen Notes=*new* This message is shown when the player have unused upgrade-cogs.",
    "value": "Du schöpfst dein Potential nicht wirklich aus. Benutze ein paar Rädchen {image cogs_small} bei der Werkbank!",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_w2gq2j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Benutze ein paar Rädchen an der Werkbank, jetzt!",
  },
  {
    "key": "rosie.conversation_enxhfq_text",
    "notes": "Speaker=Dorothy Notes=*format* *new* rephrased this line",
    "value": "Wow! Dieser Ort ist fantastisch!",
  },
  {
    "key": "rosie.conversation_dsse8r_text",
    "notes": "Speaker=Rosie",
    "value": "Danke. Ich habe diese Oase geschaffen, um meinesgleichen zu versammeln. Um sie zu beschützen!",
  },
  {
    "key": "rosie.conversation_fu699v_text",
    "notes": "Speaker=Rosie",
    "value": "Solange ich sie beruhigen und zufriedenstellen kann, bleiben sie hier. Sicher im inneren.",
  },
  {
    "key": "rosie.conversation_hx3qqt_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Zumindest war es so, bis dein Freund uns diese Beben bescherte.",
  },
  {
    "key": "rosie.conversation_6o8eta_text",
    "notes": "Speaker=Dorothy",
    "value": "Warum würde Rusty so etwas tun? Er hat {format emph}sein Leben riskiert{format reset}, um uns alle vor Vectron zu beschützen.",
  },
  {
    "key": "rosie.conversation_x9aify_text",
    "notes": "Speaker=Rosie",
    "value": "Wie gut kanntest du ihn wirklich? Vielleicht hat ihn sein Kampf gegen dieses funkelnde Ungetüm verändert?",
  },
  {
    "key": "rosie.conversation_y8f4q2_text",
    "notes": "Speaker=Fen",
    "value": "Genau das ist es, was Vectron tut ... {format nervous}Es verändert dich.{format reset}",
  },
  {
    "key": "rosie.conversation_qjs5hn_text",
    "notes": "Speaker=Rosie",
    "value": "Er kam hier runter und behauptete, er würde die Mine über unseren Köpfen zum Einsturz bringen. Wir hatten Mühe, ihm Einhalt zu gebieten.",
  },
  {
    "key": "rosie.conversation_mbjnhf_text",
    "notes": "Speaker=Dorothy",
    "value": "Es tut mir leid, ich kann nicht ... Wenn ich ihn nur finden ... mit ihm reden könnte ...",
  },
  {
    "key": "rosie.conversation_7sza3z_text",
    "notes": "Speaker=Rosie",
    "value": "Du glaubst an ihn, das verstehe ich, aber wenn du die Quelle der Beben finden kannst, wirst du es selbst sehen.",
  },
  {
    "key": "rosie.conversation_hihmd6_text",
    "notes": "Speaker=Rosie Notes=*new* rephrasing and added an emphasis",
    "value": "Du kannst uns vielleicht helfen, diese Beben zu stoppen. Ich werde versuchen, dir bei deiner Suche zu helfen.",
  },
  {
    "key": "rosie.conversation_47pkq7_text",
    "notes": "Speaker=Rosie Notes=*new* added a bit at the end to this one.",
    "value": "{format highlight}Betritt die Bergbaustation{format reset}, die ich als Lager verwende. Die alte Gerätemaschine dort sollte noch funktionieren.",
  },
  {
    "key": "rosie.conversation_m6cj0e_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Betritt die Bergbaustation{format reset} und nimm dir, was immer du brauchst.",
  },
  {
    "key": "rosie.conversation_4vzxih_text",
    "notes": "Speaker=Rosie",
    "value": "Schön, dass du etwas Nützliches in meinem Lager finden konntest. Du siehst bereit aus.",
  },
  {
    "key": "rosie.conversation_f1jnf5_text",
    "notes": "Speaker=Rosie",
    "value": "Jetzt musst du für mich herausfinden, wo diese Erdbeben herkommen, und sie stoppen.",
  },
  {
    "key": "rosie.conversation_ln5j60_text",
    "notes": "Speaker=Rosie",
    "value": "Hilf mir, meine Sippe zu beschützen! Ich gebe schon alles, was ich kann, nur damit sie auf mich hören.",
  },
  {
    "key": "rosie.conversation_u5463y_text",
    "notes": "Speaker=Rosie",
    "value": "Ich weiß nichts weiter über die Beben, aber vielleicht kannst du ja an der Oberfläche {format highlight}einen schlauen Bot finden{format reset}?",
  },
  {
    "key": "rosie.conversation_dohwhw_text",
    "notes": "Speaker=Dorothy",
    "value": "Vielleicht werde ich dann herausfinden, wohin Rusty verschwunden ist ... endlich!",
  },
  {
    "key": "rosie.conversation_77fdqq_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Finde einen intelligenten Roboter{format reset} an der Oberfläche.",
  },
  {
    "key": "rosie.conversation_0jmccn_text",
    "notes": "Speaker=Rosie",
    "value": "Er kann dich vielleicht zum Ursprungsort lenken, von dem die Beben kommen.",
  },
  {
    "key": "rosie.conversation_xpdrbe_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich fand heraus, dass das letzte Erdbeben aus dem östlichen Tempel kam.",
  },
  {
    "key": "rosie.conversation_oqlaq7_text",
    "notes": "Speaker=Rosie",
    "value": "Dort gibt es einen Kult, der aus einem Haufen Zerstörung verehrender Dumpfbacken besteht.",
  },
  {
    "key": "rosie.conversation_1kkqf6_text",
    "notes": "Speaker=Fen",
    "value": "Ja, mit denen habe ich so meine Erfahrungen.",
  },
  {
    "key": "rosie.conversation_v0wzpo_text",
    "notes": "Speaker=Rosie",
    "value": "Sie werden wahrscheinlich alles verteidigen, was mit den Beben zu tun hat.",
  },
  {
    "key": "rosie.conversation_nytcr5_text",
    "notes": "Speaker=Rosie",
    "value": "Du musst den {format highlight}Tempel nach der Quelle der Beben durchsuchen{format reset}.",
  },
  {
    "key": "rosie.conversation_x2gmu8_text",
    "notes": "Speaker=Rosie",
    "value": "Du musst den {format highlight}Tempel nach der Quelle der Beben durchsuchen{format reset}.",
  },
  {
    "key": "rosie.conversation_ly3hpt_text",
    "notes": "Speaker=Dorothy",
    "value": "Du hattest recht, Rosie. {format highlight}Rusty steckt da mit drin{format reset}, in alledem.",
  },
  {
    "key": "rosie.conversation_mp86jk_text",
    "notes": "Speaker=Rosie",
    "value": "Jetzt weißt du es ... {format emph}Er ist böse!{format reset}",
  },
  {
    "key": "rosie.conversation_26ewef_text",
    "notes": "Speaker=Dorothy",
    "value": "Er hat diese Maschine des Jüngsten Gerichts gebaut, die die Beben erzeugt.",
  },
  {
    "key": "rosie.conversation_r154n3_text",
    "notes": "Speaker=Rosie",
    "value": "Du musst diese {format highlight}Maschine zerstören!{format reset} Ich möchte, dass meine Sippe sicher ist, aber das Ding ist eine Gefahr für alles und jeden.",
  },
  {
    "key": "rosie.conversation_mlv5kh_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Worauf warten wir? Es gibt Dinge zu demolieren!",
  },
  {
    "key": "rosie.conversation_607awg_text",
    "notes": "Speaker=Rosie",
    "value": "Du hast eine Chance, die Erdbeben zu stoppen. {format highlight}Zerstöre die Maschine des Jüngsten Gerichts!{format reset}",
  },
  {
    "key": "rosie.conversation_ck3lck_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Wir konnten das Ding außer Gefecht setzen, das für die Erdbeben verantwortlich war.",
  },
  {
    "key": "rosie.conversation_kd9cyi_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Fantastisch! Du hast es tatsächlich geschafft!",
  },
  {
    "key": "rosie.conversation_mw42bj_text",
    "notes": "Speaker=Fen",
    "value": "Ja, wir haben es geschafft!",
  },
  {
    "key": "rosie.conversation_3beotd_text",
    "notes": "Speaker=Dorothy",
    "value": "Und immer noch keine Spur von Rusty ...",
  },
  {
    "key": "rosie.conversation_akywya_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Hm ... Wenn das Ding, das du Vectron nennst, ihn verändert hat, ist er vielleicht dort unten? Unter den Überresten.",
  },
  {
    "key": "rosie.conversation_rwy0gr_text",
    "notes": "Speaker=Dorothy",
    "value": "Die Maschine des Jüngsten Gerichts {format emph}bestand{format reset} zum Teil aus Vectron-Technologie ...",
  },
  {
    "key": "rosie.conversation_ucjkci_text",
    "notes": "Speaker=Fen",
    "value": "Oh nein, ich weiß was du denkst! Ich will dort nicht {format nervous}wieder hin!{format reset}",
  },
  {
    "key": "rosie.conversation_7irted_text",
    "notes": "Speaker=Fen",
    "value": "Du weißt nicht wie es ist, dort drin zu sein. Wie es ist, keinen eignen Willen zu haben.",
  },
  {
    "key": "rosie.conversation_21ym6y_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich bin schon soweit gekommen ... Ich kann jetzt nicht aufhören. Wenn du mir den Eingang zeigen könntest, Fen ...",
  },
  {
    "key": "rosie.conversation_oredyt_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Warum? Warum können wir nicht einfach irgendwelche Sachen demolieren?",
  },
  {
    "key": "rosie.conversation_tc3nlv_text",
    "notes": "Speaker=Dorothy Notes=*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    "value": "Er hat Vectron zu Fall gebracht. Rusty hat uns gerettet ...",
  },
  {
    "key": "rosie.conversation_0xyfid_text",
    "notes": "Speaker=Fen",
    "value": "...",
  },
  {
    "key": "rosie.conversation_uvs1vb_text",
    "notes": "Speaker=Fen",
    "value": "Ich führe dich dorthin. Aber sobald du {format highlight}Vectron betrittst{format reset}, bist du auf dich allen gestellt.",
  },
  {
    "key": "rosie.conversation_pq0jjj_text",
    "notes": "Speaker=Rosie",
    "value": "Um Rusty zu finden, musst du {format highlight}Vectron betreten{format reset}.",
  },
  {
    "key": "rosie.conversation_vcgjsk_text",
    "notes": "Speaker=Fen",
    "value": "Oder wir gehen einfach ein paar Sachen wegsprengen?",
  },
  {
    "key": "rosie.conversation_3bw741_text",
    "notes": "Speaker=Rosie",
    "value": "Du bist {format emph}zurück{format reset} ...",
  },
  {
    "key": "rosie.conversation_6r8y8d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ja ... Ich konnte jedoch keine Spur von Rusty finden.",
  },
  {
    "key": "rosie.conversation_jdhos3_text",
    "notes": "Speaker=Fen",
    "value": "Aber wir konnten in Erfahrung bringen, dass da draußen noch mehr {format emph}Maschinen des Jüngsten Gerichts{format reset} sind.",
  },
  {
    "key": "rosie.conversation_hlfgz1_text",
    "notes": "Speaker=Rosie",
    "value": "Natürlich! Er ist zu gerissen, um alles auf eine Karte zu setzen.",
  },
  {
    "key": "rosie.conversation_kix6a6_text",
    "notes": "Speaker=Rosie",
    "value": "Etwas muss unternommen werden. Du musst sie{format emph}alle finden{format reset}! Niemand ist sicher, bis du sie alle gefunden hast.",
  },
  {
    "key": "rosie.conversation_58f8ga_text",
    "notes": "Speaker=Fen Notes=*new* added "Dorothy"",
    "value": "Dorothy ... Ich weiß, wo sie sind. Ich fühlte sie so deutlich. Die Energie, die zu ihnen floss.",
  },
  {
    "key": "rosie.conversation_diuokv_text",
    "notes": "Speaker=Fen",
    "value": "Eine ist in dem {format emph}Tempel, in dem du mich gefunden hast.{format reset}",
  },
  {
    "key": "rosie.conversation_5npqb6_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Die letzte ist in diesem merkwürdigen {format emph}unterirdischen Dschungel{format reset}, an dem wir auf dem Weg hier her vorbeigekommen sind.",
  },
  {
    "key": "rosie.conversation_3v2hek_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Und zuletzt befindet sich eine weitere im {format emph}östlichen Tempel{format reset}.",
  },
  {
    "key": "rosie.conversation_k5nk0l_text",
    "notes": "Speaker=Dorothy Notes=*new* added "then" moved the line",
    "value": "Alles klar, auf gehts! {format highlight}Machen wir diese Maschinen platt{format reset}!",
  },
  {
    "key": "rosie.conversation_1alf3v_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Die Minen sind riesig, mit vielen Geheimnissen und Gefahen. Der direkte Weg ist nicht unbedingt der beste.",
  },
  {
    "key": "rosie.conversation_b6r8b9_text",
    "notes": "Speaker=Dorothy Notes=*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    "value": "Dieser Düsenantrieb, den ich gefunden habe, wird uns das Erkunden erleichtern.",
  },
  {
    "key": "rosie.conversation_p2pe6o_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Jepp, wir können hier überall hindüsen, Geheimnisse ausbuddeln und uns für die totale Zerstörung ausrüsten. Na los, auf geht's!",
  },
  {
    "key": "rosie.conversation_jglhmm_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Du musst {format highlight}die letzten Maschinen finden und zerstören{format reset}.",
  },
  {
    "key": "rosie.conversation_mqmqfa_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Du warst bereits in den Tempeln und mit deiner ganzen neuen Ausrüstung, sollte es ein leichtes sein, sie zu erkunden.",
  },
  {
    "key": "rosie.conversation_v81wm2_text",
    "notes": "Speaker=Rosie",
    "value": "Ich weiß aber wirklich nicht viel über den mysteriösen Dschungel dort.",
  },
  {
    "key": "rosie.conversation_ckclse_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir haben eine weitere von Rustys Maschinen zerstört.",
  },
  {
    "key": "rosie.conversation_wzvouk_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ja, das war großartig!{format reset}",
  },
  {
    "key": "rosie.conversation_yb1vmx_text",
    "notes": "Speaker=Rosie",
    "value": "Er war ziemlich schlau, sie überall um die Mine herum zu verstecken.",
  },
  {
    "key": "rosie.conversation_hw5xmd_text",
    "notes": "Speaker=Rosie",
    "value": "Es dürfte nicht leicht werden, zu den restlichen zu gelangen, selbst wenn du weißt, wo sie sind.",
  },
  {
    "key": "rosie.conversation_oeqkzs_text",
    "notes": "Speaker=Rosie",
    "value": "Ich wünschte, ich könnte dir noch mehr helfen ..., aber ich muss mich um die Sicherheit der Meinen kümmern.",
  },
  {
    "key": "rosie.conversation_1wlu3i_text",
    "notes": "Speaker=Rosie",
    "value": "Ich glaube, einige von ihnen bereiten sich darauf vor, noch einmal in die Mine einzudringen.",
  },
  {
    "key": "rosie.conversation_y85nbk_text",
    "notes": "Speaker=Fen",
    "value": "Okay, wir sollten aufbrechen und uns {format highlight}um die restlichen Maschinen kümmern{format reset}!",
  },
  {
    "key": "rosie.conversation_o9wzoz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Ich hoffe du findest deinen Freund bald und stoppst ihn ein für alle Mal.",
  },
  {
    "key": "rosie.conversation_g8unqh_text",
    "notes": "Speaker=Rosie",
    "value": "Bitte {format highlight}zerstöre die übrigen Geräte{format reset}. Ich weiß nicht, wie lange wir hier noch durchhalten.",
  },
  {
    "key": "rosie.conversation_hinklt_text",
    "notes": "Speaker=Dorothy",
    "value": "Hast du das Beben gespürt, nachdem wir die Maschine zerstört hatten?",
  },
  {
    "key": "rosie.conversation_7bjdrx_text",
    "notes": "Speaker=Rosie",
    "value": "Ja, ich hatte ganz schön Probleme damit, die Meinen zu beruhigen. Sie wurden alle ziemlich durchgerüttelt.",
  },
  {
    "key": "rosie.conversation_ot1xb4_text",
    "notes": "Speaker=Rosie",
    "value": "Ich habe noch nicht durchgezählt. Ich hoffe einfach nur, dass alle da sind.",
  },
  {
    "key": "rosie.conversation_8vqdk5_text",
    "notes": "Speaker=Dorothy Notes=*new* removed a "yes"",
    "value": "Es gibt noch immer eine Maschine dort draußen, um die wir uns kümmern müssen.",
  },
  {
    "key": "rosie.conversation_1t4jq7_text",
    "notes": "Speaker=Rosie",
    "value": "Nachdem diese teuflische Maschine ausgeschaltet worden ist, werden wir alle hoffentlich endlich Frieden finden.",
  },
  {
    "key": "rosie.conversation_5hrt2a_text",
    "notes": "Speaker=Rosie",
    "value": "Bitte {format highlight}vernichte die letzte Maschine{format reset}, damit wir endlich in Frieden leben können!",
  },
  {
    "key": "rosie.conversation_2jw2v2_text",
    "notes": "Speaker=Rosie",
    "value": "Du scheinst irgendwie anders zu sein als der Rest deiner Art.",
  },
  {
    "key": "rosie.conversation_pf575r_text",
    "notes": "Speaker=Rosie",
    "value": "Ich hätte nie gedacht, dass ich je einen Dampfbot treffen würde, der mir einigermaßen sympathisch ist.",
  },
  {
    "key": "used_teleporter.conversation_tb8lha_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! Ich habe nie gestattet, diese Röhren erneut zu öffnen.",
  },
  {
    "key": "used_teleporter.conversation_c3vudp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Hau dir einen Bolzen in den Kiefer! Die Röhren sind der beste Weg, um sich in den Minen zu bewegen.",
  },
  {
    "key": "used_teleporter.conversation_of6kl3_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Der Rotfelsgang ist aufgrund all dieser Erdbeben eingestürzt und nicht passierbar.",
  },
  {
    "key": "used_teleporter.conversation_p4u169_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Du kannst nicht beweisen, dass das Erdbeben dafür verantwortlich ist! Dafür gibt es viele mögliche Ursachen.",
  },
  {
    "key": "used_teleporter.conversation_wr7t16_text",
    "notes": "Speaker=Dorothy",
    "value": "Wie auch immer, ich brauche Sprengstoff, um den Weg freizusprengen.",
  },
  {
    "key": "used_teleporter.conversation_ljkhuj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ich wette, dass du unten in der Sprengladungsstation {format highlight}etwas Sprengstoff finden{format reset} kannst.",
  },
  {
    "key": "used_teleporter.conversation_kf7hxd_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Halte einfach mehr Richtung Osten, wenn du wieder runter gehst, und du wirst es finden.",
  },
  {
    "key": "used_teleporter.conversation_fsgerc_text",
    "notes": "Speaker=Dorothy",
    "value": "Wie dem auch sei – ich spiele mit dem Gedanken, Sprengstoff zu verwenden, um den Weg freizuräumen.",
  },
  {
    "key": "used_teleporter.conversation_atnqc9_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ah, wie ich sehe, ist irgendjemand da unten bei der Sprengladungsstation. Du räumst {format highlight}den Weg frei{format reset}, Schatzi!",
  },
  {
    "key": "hub_guard_hurt.conversation_7mti7b_text",
    "notes": "Speaker=Schwifty Shawn",
    "value": "{format nervous}AUTSCH!{format reset}",
  },
  {
    "key": "hub_guard_woke.conversation_bg1gtj_text",
    "notes": "Speaker=Schwifty Shawn Notes=*new* changed a ) to a }",
    "value": "{format nervous}... was?{format reset}",
  },
  {
    "key": "welcome_to_the_hub.conversation_5yt2bx_text",
    "notes": "Speaker=Fen",
    "value": "Verstärkungen! Sie müssen schnell erledigt werden, bevor sie sich noch vermehren!",
  },
  {
    "key": "welcome_to_the_hub.conversation_0y97x7_text",
    "notes": "Speaker=Rosie",
    "value": "Ein weiteres Beben ... und ein weiterer gewaltätiger Bot. Immer wachsam bleiben, Shawn!",
  },
  {
    "key": "welcome_to_the_hub.conversation_swc23b_text",
    "notes": "Speaker=Dorothy",
    "value": "Du kannst sprechen?",
  },
  {
    "key": "welcome_to_the_hub.conversation_sa7wlq_text",
    "notes": "Speaker=Rosie",
    "value": "Warum sollte ich denn nicht sprechen können? Hast du schon mal {format emph}versucht{format reset}, mit einem von uns zu sprechen, Roboter?",
  },
  {
    "key": "welcome_to_the_hub.conversation_h9pnyw_text",
    "notes": "Speaker=Dorothy",
    "value": "Du hast recht, es tut mir leid. Ich bin nicht hier, um einen Streit anzufangen. Ich bin einfach nur auf der Suche nach meinem Freund.",
  },
  {
    "key": "welcome_to_the_hub.conversation_mkx6nq_text",
    "notes": "Speaker=Rosie",
    "value": "Sieht dein Freund zufällig wie eine bräunliche Schildkröte aus, die man mit einer Konservendose kreuzen wollte?",
  },
  {
    "key": "welcome_to_the_hub.conversation_jignph_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja! hast du ihn gesehen? Was ist mit ihm passiert? Wo ist er?",
  },
  {
    "key": "welcome_to_the_hub.conversation_ryszmg_text",
    "notes": "Speaker=Rosie",
    "value": "Hm ... Es ist wahrscheinlich nicht besonders ratsam, einen Dampfbot reinzulassen, aber du siehst mir nicht wie ein Lügner aus.",
  },
  {
    "key": "welcome_to_the_hub.conversation_2r5k9z_text",
    "notes": "Speaker=Rosie",
    "value": "Ich bin Rosie. Komm schon rein, wir {format highlight}unterhalten uns drinnen{format reset} und ich erzähle dir, was ich weiß.",
  },
  {
    "key": "floaty.conversation_ty7umo_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Schhh ... Du bist genauso laut wie die kleine Rosie.",
  },
  {
    "key": "floaty.conversation_35muig_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Schhh ...",
  },
  {
    "key": "floaty.conversation_trxx9s_text",
    "notes": "Speaker=Cleo Johnson Notes=She has a fishing pole",
    "value": "Schhh ... Du verscheuchst sie noch ...",
  },
  {
    "key": "floaty.conversation_bcfgsy_text",
    "notes": "Speaker=Dorothy",
    "value": "Das soll jetzt keine Kritik sein, aber: Ich glaube nicht, dass Fisch im Schlamm überleben kann-",
  },
  {
    "key": "floaty.conversation_ufdh71_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Fisch? Was für Fisch? Das sind meine Schuhe! Diese schlüpfrigen Dinger machen, was sie wollen!",
  },
  {
    "key": "floaty.conversation_x3mdff_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo braucht neue Schuhe, komm her Schühchen ...",
  },
  {
    "key": "floaty.conversation_6wq728_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* run offt is old 20's hillbilly-talk.",
    "value": "Schühchen ... schwimmt hierher und schützt die Füßies, damit Cleo richtig fett zutreten kann!",
  },
  {
    "key": "floaty.conversation_vrn5ho_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich bin mir sicher, dass sie nicht schwimmen können ...",
  },
  {
    "key": "floaty.conversation_syk9tk_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Cleo merkt, dass du nicht viel von Schuhen verstehst.",
  },
  {
    "key": "floaty.conversation_ejlda7_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Wie sind sie denn sonst hier runter in den Mondsaft gekommen, hm?",
  },
  {
    "key": "floaty.conversation_9ssddv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Schuhe können nicht schwimmen. Pah! Du hast doch keine Ahnung!",
  },
  {
    "key": "floaty.conversation_f5fe22_text",
    "notes": "Speaker=Dorothy",
    "value": "Schon Glück gehabt, beim Fangen deiner Schuhe?",
  },
  {
    "key": "floaty.conversation_uwbwbt_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* Speachimpediment: "Dry mouf"="dry mouth"",
    "value": "Ach, was soll's. Zum Teufel mit den Schühchen. Cleo hat jetzt Lust darauf, irgendwelche Dinge wegzukicken.",
  },
  {
    "key": "floaty.conversation_7dil67_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo hat 'nen Plan! Cleo wird diesen Ort hier hinter sich lassen und nie wieder an die Schuhe denken.",
  },
  {
    "key": "floaty.conversation_e7vvqa_text",
    "notes": "Speaker=Dorothy",
    "value": "Okay ...",
  },
  {
    "key": "floaty.conversation_mkd1g9_text",
    "notes": "Speaker=Cleo Johnson Notes=You dumb bucket thing, Cleo should kick you before say more stupid things.",
    "value": "Du dummes Kübelhaubendingsda. Cleo sollte dich wegkicken, bevor du noch mehr dumme Dinge sagst.",
  },
  {
    "key": "floaty.conversation_7c453w_text",
    "notes": "Speaker=Cleo Johnson Notes=Pay attention to the translation of "moon juice"",
    "value": "Cleo wird bald verschwinden ... uns geht der Mondsaft aus.",
  },
  {
    "key": "floaty.conversation_nny1i7_text",
    "notes": "Speaker=Cleo Johnson Notes=thursty",
    "value": "Cleo ist durstig.",
  },
  {
    "key": "floaty.conversation_atofqv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Hier, Schuhi, Schuhi, Schuhi!",
  },
  {
    "key": "gran.conversation_dk7b1d_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Meine große, weichherzig Tochter lässt einen Dampfbot herein? Sie ist wohl doch dümmer, als sie aussieht!",
  },
  {
    "key": "gran.conversation_0fdyik_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Was macht ihr dürren Metalldinger überhaupt hier?",
  },
  {
    "key": "gran.conversation_xx02dp_text",
    "notes": "Speaker=Dorothy",
    "value": "Rosie hat mich eingeladen, ein wenig zu reden.",
  },
  {
    "key": "gran.conversation_qvnh5f_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Typisch für meine weiche, mutierte Tochter. All ihre Muskeln würden nicht einmal ausreichen, um eine Dose zu zerquetschen.",
  },
  {
    "key": "gran.conversation_n9fykw_text",
    "notes": "Speaker=Dorothy",
    "value": "Das ist aber nicht sehr nett.",
  },
  {
    "key": "gran.conversation_mypcv4_text",
    "notes": "Speaker=Dynomyte Harriet Notes=*new* rephrased. Boom sticks here are sticks of dynamite",
    "value": "Was sollen wir sonst mit dem Dynamit machen!",
  },
  {
    "key": "gran.conversation_e6z5ja_text",
    "notes": "Speaker=Fen",
    "value": "Ich mag diesen fleischigen Fleischsack.",
  },
  {
    "key": "gran.conversation_3zke2l_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Was glaubt ihr Konservenbüchsen, wie viele Stangen man braucht, um einen von euch wegzublasen?",
  },
  {
    "key": "gran.conversation_a9cchj_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ich mag es nicht, wenn in unserer Oase überall Blechdosen herumhängen.",
  },
  {
    "key": "gran.conversation_9svalt_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Rosie hätte euch alle plattmachen sollen, anstatt euch reinzulassen.",
  },
  {
    "key": "gran.conversation_3su3ui_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "In den guten alten Tagen sind wir durch die Minen gestapft. Und wenn wir jemanden gefunden haben, dessen Blech uns nicht passte, haben wir ihn weggesprengt.",
  },
  {
    "key": "gran.conversation_oza28i_text",
    "notes": "Speaker=Fen",
    "value": "Dieser Fleischsack wird ja immer lustiger und unterhaltsamer.",
  },
  {
    "key": "gran.conversation_yrhik2_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Pass ja auf, du!",
  },
  {
    "key": "gran.conversation_ihr9we_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ich bin es leid, hier in meinen Pantoffeln herumzuschlurfen.",
  },
  {
    "key": "gran.conversation_agybew_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ich sollte dort raus gehen und die Erdbeben und die seltsamen Dschungelpflanzen einfach alle wegsprengen.",
  },
  {
    "key": "gran.conversation_nvv14n_text",
    "notes": "Speaker=Dynomyte Harriet Notes=Pay attention to translation of Moon Juice",
    "value": "Aber ich werde mir vorher noch einen köstlichen Schluck Mondsaft gönnen ... und danach bin ich weg.",
  },
  {
    "key": "gran.conversation_ezltzc_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Vielleicht, wenn ich ein paar Dynamitstangen zusammenbinde und in ein Loch stecke? Um diesen Erdbeben zu zeigen, wer hier der Boss ist?!",
  },
  {
    "key": "gran.conversation_2h242j_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Hau ab! Ich möchte mein Dynamit nicht an jemanden wie dich verschwenden.",
  },
  {
    "key": "helpfulhelen.conversation_146h2g_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_w42y9y_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Hau ab ... weg hier ... du ... du Getriebe Gustav!",
  },
  {
    "key": "helpfulhelen.conversation_lbsxjr_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich bin nicht gefährlich. Ich habe mich nur gefragt, ob ...",
  },
  {
    "key": "helpfulhelen.conversation_76kde3_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_nilvvh_text",
    "notes": "Speaker=Dorothy",
    "value": "Okay, okay. Ich bin schon weg.",
  },
  {
    "key": "helpfulhelen.conversation_nrvcc5_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed all-caps",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_na5ijp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Ich bin ziemlich gut darin, Roboter zu zerlegen, weißt du.",
  },
  {
    "key": "helpfulhelen.conversation_t4gyc9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Wenn ich nicht jede Woche mindestens einen auseinandernehme, werde ich ganz hibbelig.",
  },
  {
    "key": "helpfulhelen.conversation_8z4duw_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Und hab' mich so gut wie gar nicht verletzt. Einen meiner Arme musste ich nachwachsen lassen ... Ja, das war alles.",
  },
  {
    "key": "helpfulhelen.conversation_68xyfp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "War nicht mal mein Abstech-Arm. Was ein Glück!",
  },
  {
    "key": "helpfulhelen.conversation_4tb6xl_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_mfx4dl_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Ja, ich habe an einem Roboschrottkampf teilgenommen.",
  },
  {
    "key": "helpfulhelen.conversation_2z93th_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed "That"",
    "value": "Rosie mag es nicht, wenn ich in die Mine gehe und irgendwelche Dinge absteche.",
  },
  {
    "key": "helpfulhelen.conversation_2r5nu3_text",
    "notes": "Speaker=Dorothy",
    "value": "Klingt logisch.",
  },
  {
    "key": "helpfulhelen.conversation_10fkd9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Zurück mit dir! Bevor ich mich mit meinem Stecherino an deinem Getriebe zu schaffen mache!",
  },
  {
    "key": "helpfulhelen.conversation_sp7pdd_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_6iq52s_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Du weißt doch, ich stehe darauf, irgendwelche Dinge abzustechen.",
  },
  {
    "key": "helpfulhelen.conversation_1su49z_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed the last "left"",
    "value": "Ich träume davon, durch die Minen zu jagen und alle Bots abzustechen, links und rechts! Wir verstehen uns?",
  },
  {
    "key": "helpfulhelen.conversation_azc2px_text",
    "notes": "Speaker=Dorothy",
    "value": "Alles klar.",
  },
  {
    "key": "helpfulhelen.conversation_14e8qj_text",
    "notes": "Speaker=Stabby Helen Notes=*new* changed right to left",
    "value": "Und links!",
  },
  {
    "key": "helpfulhelen.conversation_cu3ase_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_5wwgu9_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "helpfulhelen.conversation_rnl3im_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Ich will einfach nur dort raus gehen und mein' Stecherino benutzen.",
  },
  {
    "key": "helpfulhelen.conversation_2kxxoa_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "sign_shiver.conversation_iyd9iu_text",
    "notes": "Speaker=Dorothy",
    "value": ""Achtung! Erdbeben! Kontaktiert den Bürgermeister von El Machino, um zusätzliche Informationen zu erhalten."",
  },
  {
    "key": "sign_miners_wanted.conversation_jn4gij_text",
    "notes": "Speaker=Dorothy",
    "value": ""Minenarbeiter gesucht! Macht im Osten von El Machino weiter und fördert eure eigene Zukunft zutage!"",
  },
  {
    "key": "fen_on_shiners.conversation_04wf3d_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe noch nie zuvor einen sprechenden Schnapsi getroffen. Normalerweise sind sie einfach nur verwirrt und gefährlich.",
  },
  {
    "key": "fen_on_shiners.conversation_mlu9ml_text",
    "notes": "Speaker=Fen",
    "value": "Ja ... was für eine Enttäuschung!",
  },
  {
    "key": "fen_on_shiners.conversation_mcuc1c_text",
    "notes": "Speaker=Dorothy Notes=*new* removed and, added this",
    "value": "Ich gehe los und werde {format highlight}mit dieser Rosie sprechen{format reset}. Sie könnte vielleicht wissen, wo Rusty steckt.",
  },
  {
    "key": "guarding_hub.conversation_z2w2u3_text",
    "notes": "Speaker=Schwifty Shawn Notes=*format* *new* also removed the line break (
}",
    "value": "H-h-h-heeeey! Wie is'n deine Meinung?",
  },
  {
    "key": "guarding_hub.conversation_n2ebi3_text",
    "notes": "Speaker=Fen",
    "value": "Iiihhh! Vernichte das Ding, sofort!",
  },
  {
    "key": "guarding_hub.conversation_kljpda_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Oha! Ein weiteres Erdbeben!{format reset}",
  },
  {
    "key": "dorothy_intro.conversation_t7sxdc_text",
    "notes": "Speaker=Dorothy",
    "value": "Oh Rusty, wo {format emph}bist du nur hin{format reset}?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_vmz2v5_text",
    "notes": "Speaker=Fen",
    "value": "Das ist er! Der Eingang zu Vectron.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_iupd4b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Okay, lass uns das Ding betreten?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_bbcmp1_text",
    "notes": "Speaker=Fen Notes=*format* *new*'",
    "value": "Ich habe dir doch gesagt, dass ich {format emph}dort{format reset} nicht reingehe. Ich will nicht ...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rh2uj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Selbst wenn ich es wöllte, es wäre mir nicht möglich. Nicht durch ein Portal wie {format emph}dieses{format reset}.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_pkxjfo_text",
    "notes": "Speaker=Fen",
    "value": "Aber ich habe dir versprochen, dass ich {format emph}dich{format reset} dort hineinbringen werde ...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_emqhdd_text",
    "notes": "Speaker=Dorothy",
    "value": "Wenn auch nur die geringste Chance besteht, dass Rusty irgendwo dort drinnen ist, muss ich gehen.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rkegt_text",
    "notes": "Speaker=Fen",
    "value": "Dann musst du aufbrechen, nehme ich an ...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_qrn9qn_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_bye",
    "value": "Du wirst dort drinnen allein und auf dich gestellt sein. Und du wirst auch keinen Zugriff mehr auf meine Karte haben.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_sfgslu_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_by",
    "value": "Du wirst also deinen eigenen Weg finden müssen.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_j9uqnv_text",
    "notes": "Speaker=Fen",
    "value": "Bist du wirklich sicher, dass du das tun willst?",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_69953l_text",
    "notes": "Speaker=Fen Notes=*format* *new*",
    "value": "Okay ...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_yjswup_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Dann mal los ...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_uwxfmo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ja, {format emph}Ich{format reset} werde dich ganz sicher nicht davon abbringen.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_91l718_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich werde für dich zurückkommen, sobald ich draußen bin.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vmzz9y_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_u6n77q_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Wenn du dort drin eine Bewegung erkennst, lauf. Lauf so schnell du kannst ...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vctaoa_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "exiting_vectron_firsttime_01.conversation_sp4sbx_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_rj6ww8_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "FEN?!",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_ad0u27_text",
    "notes": "Speaker=vectron_teleporter Notes=*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    "value": "Fen? Ich bin ... Ich bin Fen.",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_1ajm6u_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Dorothy?",
  },
  {
    "key": "run_away_with_rusty_1.conversation_wgoby1_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY!",
  },
  {
    "key": "rosie_boss_intro_01.conversation_r5a8b8_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY?!",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_pgjtz4_text",
    "notes": "Speaker=Dorothy",
    "value": "Komm schon Fen! Wir müssen uns beeilen!",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_uzk2jn_text",
    "notes": "Speaker=Fen",
    "value": "Auf diese Weise werden wir es nie {format nervous}zurück in die Stadt schaffen{format reset} ...",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_5rvneb_text",
    "notes": "Speaker=Fen Notes=*new* changed the format to affect more words",
    "value": "Aber ich kann {format emph}euch beide{format reset} rechtzeitig rausbringen.",
  },
  {
    "key": "sign_thehub.conversation_32yflg_text",
    "notes": "Speaker=Dorothy",
    "value": ""WIR HABEN GESCHLOSSEN! GEHEN SIE NACH HAUSE!"",
  },
  {
    "key": "fen_its_gonna_blow.conversation_ghi2wb_text",
    "notes": "Speaker=Fen",
    "value": "Hey, dieses Ding {format nervous}spielt verrückt!{format reset}",
  },
  {
    "key": "fen_its_gonna_blow.conversation_8xsftw_text",
    "notes": "Speaker=Fen Notes=*new* changed formated text from highlight to emph",
    "value": "Los, verschwinden wir von hier! {format emph}Jetzt!{format reset}",
  },
  {
    "key": "run_away_with_rusty_3.conversation_4v2csa_text",
    "notes": "Speaker=Dorothy",
    "value": "Professorin Shermans Rakete!",
  },
  {
    "key": "run_away_with_rusty_3.conversation_izxx5d_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir müssen jetzt zurück zur Stadt!",
  },
  {
    "key": "easteregg_ending.conversation_x1pswz_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Los jetzt! {format emph}Die Zeit rennt uns davon!{format reset}",
  },
  {
    "key": "easteregg_ending.conversation_bfup2f_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Wir haben keine Zeit, um zu überlegen!",
  },
  {
    "key": "easteregg_ending.conversation_2ez9yy_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Los!",
  },
  {
    "key": "easteregg_ending.conversation_kuytvd_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Du hast lange genug den Helden gespielt.",
  },
  {
    "key": "fen_ending_goodbye.conversation_qsa1um_text",
    "value": "Wir sehen uns, Dot ...",
  },
  {
    "key": "rocketeer.conversation_hwmfh6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich würde mir wünschen, dass Bürgermeister Yonker der Vernunft zugänglich wäre.",
  },
  {
    "key": "rocketeer.conversation_d0ozct_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Es hat keinen Sinn, Personen überzeugen zu wollen, für die zu viel auf dem Spiel steht, wenn ihre Lügen in sich zusammenfallen, – und die sich selbst betrogen haben.",
  },
  {
    "key": "rocketeer.conversation_bdyzc2_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Irgendetwas an diesen Erbeben ist irgendwie seltsam.",
  },
  {
    "key": "rocketeer.conversation_tjv7fp_text",
    "notes": "Speaker=Dorothy Notes=*new* changes since earlier version could be off in some instances.",
    "value": "Wow! Die Rakete sieht echt hammermäßig aus!",
  },
  {
    "key": "rocketeer.conversation_t09utv_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased to work with new version of above line",
    "value": "Nun ja, da sich der Bürgermeister momentan ziemlich unlogisch verhält, muss ich auf Eventualitäten vorbereitet sein.",
  },
  {
    "key": "rocketeer.conversation_f7plgb_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Mein Seismometer sagt mir, dass mit diesen Erdbeben irgendetwas nicht in Ordnung ist, weißt du.",
  },
  {
    "key": "rocketeer.conversation_yhfxkq_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Unsere Mine befindet sich direkt an der Grenze einer Verwerfungslinie. Ein größeres Erdbeben, und bye-bye Mr. Mine!",
  },
  {
    "key": "rocketeer.conversation_k00t1f_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich hoffe, dass ich diese Rakete voll funktionsfähig bekomme, bevor es zu spät ist.",
  },
  {
    "key": "rocketeer.conversation_220si9_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Diese neuen Erdbeben bitten förmlich darum, untersucht zu werden. Hier steht eine Menge auf dem Spiel.",
  },
  {
    "key": "rocketeer.conversation_yd21lh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Nun, genau genommen treffen zwei riesige Kontinentalplatten direkt unter unseren Füßen aufeinander.",
  },
  {
    "key": "rocketeer.conversation_yhhdlm_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Die Stadt wurde auf einer Felsensäule errichtet, die dadurch entstand, dass diese beiden Platten vor Millionen von Jahren miteinander kollidierten.",
  },
  {
    "key": "rocketeer.conversation_jd18od_text",
    "notes": "Speaker=Dorothy",
    "value": "Wow ...",
  },
  {
    "key": "rocketeer.conversation_ma515w_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich bin aufgrund dieser seismischen Muster ein wenig besorgt.",
  },
  {
    "key": "rocketeer.conversation_rh627j_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Sie basieren definitiv nicht auf normalen Bewegungen der Erdkruste.",
  },
  {
    "key": "rocketeer.conversation_8vxt9k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Wenn das Große Beben eintreffen sollte, würde dies die gesamte Stadt vernichten. Oder noch schlimmer: den gesamten Planeten!",
  },
  {
    "key": "rocketeer.conversation_nid8rc_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Oha!{format reset} Dann wäre es wohl besser, meine Sensoren nach unten anzupassen.",
  },
  {
    "key": "rocketeer.conversation_gqcn63_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Das ist die richtige Einstellung!",
  },
  {
    "key": "rocketeer.conversation_q2vvjy_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich bin dennoch noch immer ein wenig beunruhigt, was die seismischen Muster angeht.",
  },
  {
    "key": "rocketeer.conversation_46mop5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Der Schutzwall ganz unten in der Mine ist in der Tat sonderbar.",
  },
  {
    "key": "rocketeer.conversation_k6sl9a_text",
    "notes": "Speaker=Dorothy",
    "value": "Auch unterhalb meiner kleinen Heimatstadt, Tumbleton, gab es eine einen Wall.",
  },
  {
    "key": "rocketeer.conversation_wb49hd_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Genau genommen handelt es sich um denselben Wall. Er verläuft durchgängig und erstreckt sich über mehrere Kilometer!",
  },
  {
    "key": "rocketeer.conversation_prdn7m_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Sie ist das größte Konstrukt, das je von Bot-Hand geschaffen wurde. Wäre sie hier oben, würdest du sie vom All aus sehen können.",
  },
  {
    "key": "rocketeer.conversation_0b17qr_text",
    "notes": "Speaker=Dorothy",
    "value": "Das Aneinandereihen all dieser Steine ... nur damit die Schnapsis nicht nach oben kommen ...",
  },
  {
    "key": "rocketeer.conversation_4s3zz6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Nun, die Schnapsis oder auch {format emph}homo cervisia{format reset} können ziemlich einfallsreich und geschickt sein, wenn es um das Anfertigen einiger ganz besonderer Gegenstände geht.",
  },
  {
    "key": "rocketeer.conversation_29dn85_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "So ist beispielsweise der von ihnen gebraute Mondsaft, der es ihnen erlaubt, den unterirdischen Alltag erträglicher zu machen, etwas ganz Besonderes ...",
  },
  {
    "key": "rocketeer.conversation_8na87z_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added a comma after mutagenic",
    "value": "Oblgeich mutagen, also erbgutverändernd, und süchtigmachend, ist er eine nicht zu unterschätzende Energiequelle.",
  },
  {
    "key": "rocketeer.conversation_auy7u5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Um die Wahrheit zu sagen, habe ich mal versucht, das Zeug zu verbrennen, um es als Raketentreibstoff zu verwenden, aber ... es erwies sich als viel zu explosiv.",
  },
  {
    "key": "rocketeer.conversation_0144bl_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Der Schutzwall ist wahrlich ein ehrfurchtgebietendes Wunder, das man gesehen haben muss.",
  },
  {
    "key": "rocketeer.conversation_vfvf68_text",
    "notes": "Speaker=Dorothy",
    "value": "Weißt du etwas über höhlenbewohnende Pflanzen?",
  },
  {
    "key": "rocketeer.conversation_n56yib_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Nun, ich bin natürlich kein Biologie, aber ... ich würde auf irgendeine Art von Pilz tippen. Pilze sind wahre Überlebenskünstler und gedeihen nahezu überall.",
  },
  {
    "key": "rocketeer.conversation_6u259t_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe eine Höhle entdeckt, die überall damit bedeckt ist.",
  },
  {
    "key": "rocketeer.conversation_4luy17_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Eigenartig! Nun, wenn es eine Pflanze ist, dann kann sie ihre Energie jedenfalls nicht durch Fotosynthese gewinnen; das dürfte klar sein.",
  },
  {
    "key": "rocketeer.conversation_vq8bcq_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe die Schnapsis gefunden. Ich habe sogar mit ihnen gesprochen! Sie haben unterhalb des Walls ein kleines Dorf errichtet.",
  },
  {
    "key": "rocketeer.conversation_qbphbv_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Faszinierend! Ich habe schon seit Ewigkeiten nichts mehr von sprechenden Schnapsis gehört.",
  },
  {
    "key": "rocketeer.conversation_d8arjf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Diejenigen, die ich mit meinen eigenen Augen gesehen habe, haben nur mithilfe von kehligen Lauten kommuniziert. Vollkommen unverständlich!",
  },
  {
    "key": "rocketeer.conversation_m0q6cs_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich habe einige Dateien durchgearbeitet, die die Hypothese vertreten, dass es sich bei den Schnapsis einst um die dominierende Spezies des Planeten gehandelt habe ...",
  },
  {
    "key": "rocketeer.conversation_n96czx_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Wir können heute natürlich nur spekulieren, wenn es darum geht, die Vergangenheit des homo cervisia korrekt zu verorten ...",
  },
  {
    "key": "rocketeer.conversation_9axbnb_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new* merged two lines into one.",
    "value": "Es ist beinahe unmöglich, einige Testsubjekte dieser Spezies in Ruhe zu studieren, ohne diese ernsthaft zu beschädigen ... oder selbst einen Schaden davonzutragen.",
  },
  {
    "key": "rocketeer.conversation_6qfwjp_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Die Schnapsis sind eine faszinierende Spezies. Hinter ihren schlafen Augenlidern gibt es einen Funken von Individualität.",
  },
  {
    "key": "rocketeer.conversation_wlfozb_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased",
    "value": "Professor, du bist ein schlauer Bot. Denkst du, diese Erdbeben könnten botgemacht sein?",
  },
  {
    "key": "rocketeer.conversation_ylnbuf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Du meinst, ob jemand diese Erdbeben künstlich erzeugt?",
  },
  {
    "key": "rocketeer.conversation_x4pgec_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Das könnte natürlich das äußerst merkwürdige Epizentrum der letzten seismischen Aktivität erklären.",
  },
  {
    "key": "rocketeer.conversation_934xqz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Laut meinen Daten lag es direkt im Zentrum dieses verrückten Kults von Kleptomanen und Weltuntergangspanikern.",
  },
  {
    "key": "rocketeer.conversation_72gm7a_text",
    "notes": "Speaker=Dorothy",
    "value": "Also {format emph}ist es{format reset} möglich?",
  },
  {
    "key": "rocketeer.conversation_w0qkeb_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Nun, um diese Hypothese zu testen, musst du {format highlight}die Windigen Ebenen durchqueren{format reset}, und der Sache im Tempel im Osten auf den Grund gehen.",
  },
  {
    "key": "rocketeer.conversation_7xmo4l_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Diese Hypothese von botgemachten Erdbeben ist in der Tat ... Faszinierend.",
  },
  {
    "key": "rocketeer.conversation_p7mpft_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added the part about taking the ladder",
    "value": "{format highlight}Durchquere die Windigen Ebenen{format reset}, um mehr zu erfahren. Klettere einfach die Leiter im Osten der Stadt hinunter.",
  },
  {
    "key": "rocketeer.conversation_9zagcy_text",
    "notes": "Speaker=Dorothy",
    "value": "Der Kult beschützt eine Art von Maschine, die für die Erdbeben verantwortlich sein könnte.",
  },
  {
    "key": "rocketeer.conversation_d8olb4_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Dein nächster Schritt würde dann darin bestehen, die Maschine zu demontieren. Dies könnte die Erdbeben ein für alle Mal beenden.",
  },
  {
    "key": "rocketeer.conversation_vts8e3_text",
    "notes": "Speaker=Fen",
    "value": "{format emph}Oh ja!{format reset} Demontieren hört sich lustig an! Ich bin dabei!",
  },
  {
    "key": "rocketeer.conversation_ly2vhz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Vielleicht kann ich mir dann sogar den Bau dieser Rakete sparen.",
  },
  {
    "key": "rocketeer.conversation_ypryh5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Es ist immerhin keine leichte Aufgabe, ein Objekt zu konstruieren, mit dem man das All erforschen kann.",
  },
  {
    "key": "rocketeer.conversation_qq0n6k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Wenn du den {format highlight}Erdbebengenerator demontieren{format reset} würdest, wäre ich davon verschont.",
  },
  {
    "key": "rocketeer.conversation_hbhl5o_text",
    "notes": "Speaker=Dorothy",
    "value": "Wie bringt es ein Dampfbot zu Wege, eine Maschine herzustellen, die Erdbeben erzeugt?",
  },
  {
    "key": "rocketeer.conversation_dpkudw_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Sie müssen über eine Menge Wissen oder zumindest eine fortgeschrittene Technologie verfügen.",
  },
  {
    "key": "rocketeer.conversation_irqx6c_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Futuristische Technologie, die alles übersteigt, was ich bisher gesehen habe ...",
  },
  {
    "key": "rocketeer.conversation_gljg9h_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich habe mir einige meiner alten Aufzeichnungen angesehen, um möglicherweise ein Muster zu erkennen ..., aber ohne Erfolg.",
  },
  {
    "key": "rocketeer.conversation_j3paiq_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new*",
    "value": "Die erratischen Bewegungen dieser Erschütterungen deuten darauf hin, dass wir noch nicht aus dem Schneider sind.",
  },
  {
    "key": "rocketeer.conversation_w8nhom_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich fühle mich definitiv noch nicht bereit, mein Herumexperimentieren mit der Rakete einzustellen.",
  },
  {
    "key": "rocketeer.conversation_ihi6uu_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ich fühle mich noch nicht bereit, mein Herumexperimentieren mit der Rakete einzustellen.",
  },
  {
    "key": "rocketeer.conversation_j6jtna_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Einem Kollegen von mir ist es gelungen, einige Proben des unterirdischen Dschungels zu sammeln.",
  },
  {
    "key": "rocketeer.conversation_oepnn1_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Seltsam, nicht wahr? Und sehr gefährlich.",
  },
  {
    "key": "rocketeer.conversation_kul85z_text",
    "notes": "Speaker=Fen",
    "value": "Ja, ziemlich cool.",
  },
  {
    "key": "rocketeer.conversation_b4ld5b_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Wie dem auch sein – er meint, er sei auf mutagene Spuren gestoßen, die die Biologie der Pflanzen negativ beeinträchtigten.",
  },
  {
    "key": "rocketeer.conversation_h8rkzh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Es scheint, als erhielten sie ihre Energie durch das Trinken mutagenen {format emph}Mondsaftes{format reset}, nach dem die Schnapsis so verrückt sind.",
  },
  {
    "key": "rocketeer.conversation_bthpa5_text",
    "notes": "Speaker=Dorothy",
    "value": "Es {format emph}gibt{format reset} in diesem Gebiet eine Menge Röhren.",
  },
  {
    "key": "rocketeer.conversation_wvpx34_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Dieses Röhrensystem könnte die Ursache für die Verschmutzung sein.",
  },
  {
    "key": "rocketeer.conversation_ll0rrj_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Der Dschungel ist nur ein weiteres Mysterium unter all den anderen seltsamen Ereignissen.",
  },
  {
    "key": "rocketeer.conversation_gcue08_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir haben alle Erdbebengeneratoren deaktiviert.",
  },
  {
    "key": "rocketeer.conversation_rhj5jo_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Meine seismischen Daten weisen nicht mehr auf viele verschiedene, sondern nur noch auf einen einzigen Ort hin.",
  },
  {
    "key": "rocketeer.conversation_pgv6y7_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Der Ursprung des letzten Bebens scheint eindeutig Schnapsbergen gewesen zu sein.",
  },
  {
    "key": "rocketeer.conversation_j878i8_text",
    "notes": "Speaker=Dorothy Notes=*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    "value": "Wir müssen unbedingt zurück nach unten und {format highlight}mit Rosie sprechen.{format reset}",
  },
  {
    "key": "rocketeer.conversation_lv5xcl_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased the ending of the line.",
    "value": "Bloß gut, dass meine Rakete einsatzbereit ist. Nur noch einige letzte Vorbereitungen und ich kann von hier verschwinden, wenn es sein muss.",
  },
  {
    "key": "rocketeer.conversation_9rxm14_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Nur noch einige letzte Vorbereitungen und dann können wir den Planeten verlassen, falls uns das Große Beben mit seiner Anwesenheit beehrt.",
  },
  {
    "key": "rocketeer.conversation_tnyv5r_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Sobald mein Forschungsschiff fertig ist, werde ich diesen Planeten hier hinter mir lassen.",
  },
  {
    "key": "rocketeer.conversation_7an1z5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Und jeder, der mich begleiten will, darf dies gerne tun. Ich habe sie extra groß genug gebaut. Es gibt genug Platz für alle.",
  },
  {
    "key": "workbench_conversation.conversation_f5xes1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Oh, oh, oh!",
  },
  {
    "key": "workbench_conversation.conversation_vwbtbo_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ich habe ein paar spitzenmäßige Verbesserungen für dich! Alles Technik vom Feinsten!",
  },
  {
    "key": "workbench_conversation.conversation_d17hfn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Also, eh, tut mir leid, dich zu stören ... schon wieder.",
  },
  {
    "key": "workbench_conversation.conversation_2hj8xd_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Aber ich habe gerade eine Lieferung neuer Teile bekommen! Damit kannst du deine Werkzeuge noch weiter verbessern.",
  },
  {
    "key": "workbench_conversation.conversation_dnpk79_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Eh ... dachte nur, du solltest das wissen.",
  },
  {
    "key": "workbench_conversation.conversation_cq63md_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Hi ...?",
  },
  {
    "key": "workbench_conversation.conversation_eb2wqf_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}Aaah{format reset}, Ich meine ... Hallo!",
  },
  {
    "key": "workbench_conversation.conversation_6hj11o_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Eh ... ich habe eine neue Lieferung erhalten!",
  },
  {
    "key": "workbench_conversation.conversation_ozu5go_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Damit kannst du so ziemlich alle deine Werkzeuge verbessern ... Ich meine, noch weiter verbessern. Toll, oder?",
  },
  {
    "key": "workbench_conversation.conversation_rkault_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Mir, eh, war aufgefallen, dass deine Panzerung ein paar Dellen hatte ...",
  },
  {
    "key": "workbench_conversation.conversation_8lfpm2_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Du kannst sie mit meiner neue Lieferung dicker Panzerplatten verbessern.",
  },
  {
    "key": "workbench_conversation.conversation_kpzosz_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Damit du dich dort unten besser, du weißt schon ... behaupten kannst.",
  },
  {
    "key": "workbench_conversation.conversation_vk0in8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ähm ... Was möchtest du tun?",
  },
  {
    "key": "workbench_conversation.conversation_xbec1d_text",
    "notes": "Speaker=Turtle Bucket Notes=This is the introductary phrase from the mechanich",
    "value": "Ähm ... Was möchtest du tun?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_4nh80e_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ähm ... Ich stehe voll auf dein Getriebe.",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_zb6ryl_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Du ... du könntest es verbessern, indem du ein paar Rädchen verwenden würdest. Möchtest ... möchtest du wissen, wie?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_k47xd0_text",
    "notes": "Speaker=Turtle Bucket Notes=This person is very nervous",
    "value": "Tut mir leid ... Ich werde ruhig sein – wie?!",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_xsq7ao_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Du möchtest es wirklich wissen? Oh, okay, okay!",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_9iwqjw_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Okay, es ... es tut mir leid. Ich werde mal besser hierüber gehen ...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e2sw99_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Du kannst ... ähm ... mit ein paar Rädchen {image cogs_small} deine {format highlight}Werkzeuge verbessern{format reset}.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_qsonke_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Du hast sie möglicherweise hier und da bereits herumliegen sehen.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_9chqoj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Verwende die Werkbank, um den Rädchen-Platz eines Werkzeugs auszuwählen, und platziere deine Rädchen {image cogs_small} darin.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_0dnnax_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Und mache dir keine Sorgen ... Du kannst {format highlight}eingesetzte Rädchen {image cogs_small} ganz einfach wieder entfernen{format reset}.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_90zfu2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Während du deine Instrumente aufwertest, wirst du Zugang zu noch cooleren Verbesserungen erhalten.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_a5snuc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "So, es gäbe zwar noch einige Dinge, die dich dir erzählen könnte, aber wenn du nicht willst ...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_b1szsc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Für einige Verbesserungen existieren Blaupausen, die du zunächst finden musst.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_f0xxtp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Davy Dumpfbacke, unser ... ähm ... Kartograf, hat einige davon zur Hand, glaube ich.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_1q2dd2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Blaupausenverbesserungen sind normalerweise richtig cool. Zumindest glaube ich das ...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_i2a540_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, und da du, wie bereits gesagt, alle Rädchen {image cogs_small} problemlos wieder entfernen kannst, möchtest du vielleicht ein wenig experimentieren.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_5p4bi7_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ändere doch einfach ab und zu deine Rädchen. Das heißt, wenn du das möchtest.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_iq6h9b_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ähm ... Du hast dir wirklich alles angehört! Das tun nicht viele ...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e4vdfi_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Okay, ich werde hier sein, denke ich.",
  },
  {
    "key": "fen_wall_found.conversation_9lkkka_text",
    "notes": "Speaker=Fen",
    "value": "Diese Ort kommt mir irgendwie vertraut vor. Vielleicht hat mich der Kult irgendwann mal hierher geführt.",
  },
  {
    "key": "fen_wall_found.conversation_qsa4d1_text",
    "notes": "Speaker=Fen",
    "value": "Was glaubst du, in welcher Tiefe befinden sich {format nervous}die Überreste von Vectron{format reset}?",
  },
  {
    "key": "fen_wall_found.conversation_3rahmd_text",
    "notes": "Speaker=Dorothy",
    "value": "Es ist noch ein langer Weg bis runter. Wir befinden uns noch immer in den erkundeten Minenbereichen.",
  },
  {
    "key": "fen_wall_found.conversation_xecqeg_text",
    "notes": "Speaker=Fen",
    "value": "Ah, okay. Ich begann bereits, mich zu wundern.",
  },
  {
    "key": "fen_wall_found.conversation_mx4ktk_text",
    "notes": "Speaker=Dorothy",
    "value": "Nun muss ich nur noch einen Weg durch diesen vermaledeiten Wall finden.",
  },
  {
    "key": "fen_wall_found.conversation_cat8cu_text",
    "notes": "Speaker=Fen",
    "value": "Oh jaa! {format singsong}Zeit für Explosionen!{format reset}",
  },
  {
    "key": "fen_wall_found.conversation_nq5gxh_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Das wird nicht genügen. Dieser Wall wurde nach den Alkkriegen errichtet, um diese Spinner am Hochkommen zu hindern.",
  },
  {
    "key": "fen_wall_found.conversation_gu7tji_text",
    "notes": "Speaker=Dorothy",
    "value": "Und da Schnapsis Experten darin sind, Dinge in die Luft zu jagen, hält der Wall sogar starken Explosionen stand.",
  },
  {
    "key": "fen_below_wall.conversation_mbv8tf_text",
    "notes": "Speaker=Fen Notes=Place, refering to the underground jungle that they just passed thruogh.",
    "value": "Der Ort war {format nervous}ziemlich seltsam!{format reset}",
  },
  {
    "key": "fen_below_wall.conversation_cj1k6o_text",
    "notes": "Speaker=Dorothy",
    "value": "Offenbar hat es mich durch die erste Schicht des Walls gebracht.",
  },
  {
    "key": "fen_below_wall.conversation_5mo9pe_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich hoffe, dass die Bergbaustation hier irgendwo in der Nähe ist.",
  },
  {
    "key": "fen_below_wall.conversation_vizvqs_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Und ich hoffe, dass wir dort irgendwas Cooles und Zerstörerisches finden.",
  },
  {
    "key": "fen_on_yarrow.conversation_rswyd0_text",
    "notes": "Speaker=Fen",
    "value": "Was {format emph}ist{format reset} das hier eigentlich für ein Ort? So düster und gefährlich. Erkunden wir hier alles!",
  },
  {
    "key": "fen_on_yarrow.conversation_vqbkn5_text",
    "notes": "Speaker=Dorothy Notes=*new* shortened by removing description of place. Was a bit misrepresentative",
    "value": "Hier dürfte es wirklich keine Vegetation geben ...",
  },
  {
    "key": "fen_on_yarrow.conversation_jk4t0s_text",
    "notes": "Speaker=Dorothy",
    "value": "Uns könnten allerlei Gefahren erwarten.",
  },
  {
    "key": "fen_on_yarrow.conversation_i4oq3o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Jaah!{format reset}",
  },
  {
    "key": "fen_on_yarrow.conversation_qaywwl_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich muss sichergehen, dass wir genug Licht haben, bevor wir hineinstürmen.",
  },
  {
    "key": "fen_on_yarrow.conversation_sf4uwk_text",
    "notes": "Speaker=Fen",
    "value": "Mit dir herumzureisen macht einfach keinen Spaß. Los jetzt!",
  },
  {
    "key": "blueprint_vendor_01.conversation_1135rj_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Diese Mine verfügt über solch eine interesante Geschichte! Ich versuche schon lange, dieses Gebiet hier zu kartografieren.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dq65oq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Wenn man es darauf anlegt, kann man hier unten allerlei Schätze finden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_3fn5w0_text",
    "notes": "Speaker=Dorothy",
    "value": "Nun, es ist eine Mine. Also hoffe ich, dass sie bis zum Bersten mit wertvollen Steinen gefüllt ist.",
  },
  {
    "key": "blueprint_vendor_01.conversation_npebbg_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Nein, nein, nein! Ich spreche von {format emph}tatsächlichen{format reset} Kostbarkeiten. Faszinierende und zugleich seltsame Artefakte {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_a7uvtg_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Dinge, die ihre eigene fantastische Geschichte erzählen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mjgdjr_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    "value": "Falls du irgendwelche solcher Artefakte {image artifacts_small} finden solltest, würde ich gerne mal einen Blick drauf werfen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_uwhgx6_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich habe etwas gefunden, das dich interessieren könnte.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iqy08o_text",
    "notes": "Speaker=Dorothy",
    "value": "Verstanden, ich halte ein Auge offen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rppjea_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Traumhaft!{format reset} Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "blueprint_vendor_01.conversation_br857t_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Meine Güte!{format reset} Da pack mich einer am Gewinde! Ist das zu fassen?",
  },
  {
    "key": "blueprint_vendor_01.conversation_iptdw9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Es ist dir tatsächlich gelungen, das mystische 43. kostbare Artefakt {image artifacts_small} zu finden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_lu65ll_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Davon habe ich mein Leben lang geträumt. Für Generationen hat meine Familie danach gesucht. Ich kann es kaum abwarten, mich daran sattzusehen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wu0y6m_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "...",
  },
  {
    "key": "blueprint_vendor_01.conversation_vyiiiz_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Warte ...",
  },
  {
    "key": "blueprint_vendor_01.conversation_ds3fs3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Das ist es?",
  },
  {
    "key": "blueprint_vendor_01.conversation_kheln9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Es ist so ... so ...",
  },
  {
    "key": "blueprint_vendor_01.conversation_axft9i_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Enttäuschend.",
  },
  {
    "key": "blueprint_vendor_01.conversation_66l4aw_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Na ja, ich danke dir, trotzdem.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6ybt0n_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Jetzt fühlt sich mein Leben so leer an.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rlfp8l_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Traumhaft!{format reset} Du hast bereits einige {var num_artifacts_current} faszinierende Artefakte {image artifacts_small} gefunden!",
  },
  {
    "key": "blueprint_vendor_01.conversation_as6lw7_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Traumhaft!{format reset} Du hast bereits {var num_artifacts_current} faszinierendes Artefakt {image artifacts_small} gefunden!",
  },
  {
    "key": "blueprint_vendor_01.conversation_p7vtak_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format* removed emph from appreciation",
    "value": "Als Zeichen meiner Dankbarkeit überreiche ich dir eine meiner {format highlight}Blaupausen{format reset}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dcphb9_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* "it" refering to the blueprint",
    "value": "Schaff es einfach zur Werkbank und verwende die Rädchenmods, um davon Gebrauch zu machen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8lzbu_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* gives the player som info on how many artefacts until next blueprint",
    "value": "Ich werde dir eine weitere Blaupause aushändigen, wenn du mir insgesamt {var num_artifacts_threshold} Artefakte {image artifacts_small} vorzeigen kannst.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pwaqqk_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Nun, wie ich sehe, hast du bisher noch {format emph}keine{format reset} faszinierenden Artefakte {image artifacts_small} gefunden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tm2fum_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "blueprint_vendor_01.conversation_31n97u_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Oh, wie ich sehe, hast du {var num_artifacts_current} nettes Artefakt {image artifacts_small} ausfindig gemacht.",
  },
  {
    "key": "blueprint_vendor_01.conversation_xkdvzp_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "blueprint_vendor_01.conversation_vj87ok_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Oh sehr gut! Du hast {var num_artifacts_current} faszinierende Artefakte {image artifacts_small} gefunden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_c12v5z_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Diese kostbaren Dinge können überall versteckt sein.",
  },
  {
    "key": "blueprint_vendor_01.conversation_r70wn4_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Aber du hast jetzt diese ganze ausgefallene Ausrüstung, um herumzukommen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ozgox8_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Sieh dich immer gründlich um, ok?",
  },
  {
    "key": "blueprint_vendor_01.conversation_crg8xl_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    "value": "Ich werde dir eine weitere Blaupause aushändigen, wenn du mir insgesamt {var num_artifacts_threshold} Artefakte {image artifacts_small} vorzeigen kannst.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rkqt88_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* removed "wonderful" as it conflicted with previous lines in some cases",
    "value": "Du warst wirklich fleißig. Es kommt mir so vor, als hättest du mir alle spannenden Artefakte dieses Planeten gezeigt.",
  },
  {
    "key": "blueprint_vendor_01.conversation_4ngqs0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Und das ist auch gut so, ich habe nämliche keine Blaupausen mehr!",
  },
  {
    "key": "blueprint_vendor_01.conversation_75th6d_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Früher, als ich noch ein agiler, herumspringender Bot, so wie du, gewesen bin, bin ich in dieser Mine überall herumgerannt und habe erstaunliche Karten angefertigt.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wvg349_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ich hatte den Schutzwall bereits vollständig kartografiert, bevor meine Knie mehr und mehr nachgaben.",
  },
  {
    "key": "blueprint_vendor_01.conversation_90qcuc_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ich habe mit den unteren Ebenen begonnen. Allerdings waren diese unlogisch agierenden Schnapsis eine echte Plage.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pffrd2_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Diese Kreaturen haben einfach keinen Respekt vor makelloser Handwerksarbeit. Verwenden unpräzisen Sprengstoff gegen solch ein erhabenes Monument! Absurd!",
  },
  {
    "key": "blueprint_vendor_01.conversation_fc5nyv_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Der Wall absorbiert die Mehrheit physikalischen Krafteinwirkens ... Allerdings ist es ihnen irgendwann doch geglückt, sich ihren Weg zu bahnen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_219b44_text",
    "notes": "Speaker=Dorothy",
    "value": "Warst du schon mal beim Tempel auf der anderen Seite der Windigen Ebenen?",
  },
  {
    "key": "blueprint_vendor_01.conversation_0anv7h_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Die Ruinen dort sind größtenteils unkartografiert. Und der Tempel war schon immer... trügerisch.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tv8uil_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Mein alter Kollege Ronald Hubot war der Einzige, der {format emph}den Mut hatte{format reset}, sich hineinzubegeben.",
  },
  {
    "key": "blueprint_vendor_01.conversation_u57vpi_text",
    "notes": "Speaker=Dorothy",
    "value": "Was ist mit ihm passiert?",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8rvft_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Nun, offensichtlich hatte er eine entsetzliche Vision, die vom Ende der Welt kündete.",
  },
  {
    "key": "blueprint_vendor_01.conversation_02chim_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Er hat sich im Tempel verkrochen und verbarrikadiert. Und hat sich mit allen möglichen Wahnbots umgeben.",
  },
  {
    "key": "blueprint_vendor_01.conversation_i026up_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ich kann nur vermuten, welch wundervollen Artefakte {image artifacts_small} sich in diesen Ruinen befinden mögen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tvge9q_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "In den Tiefen der Mine müssen sich {format emph}Schatzfunde{format reset} längt vergessener Artefakte {image artifacts_small} befinden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iyk7r0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Stelle dir doch nur mal die Relikte vor, die längst vergessene Kulturen hier zurückgelassen haben müssen. Relikte, dir nur darauf warten, gefunden zu werden.",
  },
  {
    "key": "blueprint_vendor_01.conversation_hp4wcb_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "In was für einer faszinierenden Epoche du lebst! Es ist Ewigkeiten her, dass Bots so weit wie du vorgedrungen sind.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ekx3en_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Du solltest sogar noch tiefer vordringen. Die Geschichte belohnt die Mutigen, weißt du.",
  },
  {
    "key": "blueprint_vendor_01.conversation_bb807w_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Die westliche Wüste ist ein rauer und trockener Ort, und dennoch leben Bots hier schon seit Jahrhunderten.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6e53tq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ich bin mir absolut sicher, dass etwas Spannendes unter den Felsen und dem Sand versteckt liegen muss.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ja68cp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ich weiß großartige Artefakte wirklich zu schätzen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_9w2c24_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Normalerweise dauert es {format emph}Äonen{format reset}, damit sich die geologische Sturktur der Erde signifikant ändert.",
  },
  {
    "key": "blueprint_vendor_01.conversation_aactqp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Diese Erbeben scheinen in der Lage zu sein, die Erdschichten innerhalb nur weniger Dekaden verändern zu können.",
  },
  {
    "key": "blueprint_vendor_01.conversation_fn5brp_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir werden diese Beben bald ausgemerzt haben.",
  },
  {
    "key": "blueprint_vendor_01.conversation_d0c0zs_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Was, wenn der Boden komplett aufbricht? Dann wären meine Karten komplett sinnlos. Was für ein Frevel!",
  },
  {
    "key": "blueprint_vendor_01.conversation_w56u9v_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Das letzte Beben war erstaunlich problematisch.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mcnumi_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Vielleicht hat Professorin Sherman recht ... möglicherweise sind wir alle gezwungen, den Planeten zu verlassen.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mq34gi_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir versuchen unser Bestes, das zu verhindern.",
  },
  {
    "key": "blueprint_vendor_01.conversation_h0mzw3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Zu lernen, wie man die Sterne kartografiert, hört sich nach einer spannenden Herausforderung an.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uyr4r4_text",
    "notes": "Speaker=Clifford Heisenberg Notes=This person id located upp on a trellis with a fantastic view.",
    "value": "Ah, {format singsong}hallo Freund!{format reset} Die Aussicht ist hier oben wirklich klasse! Unser Bürgermeister ist wirklich ein Glückspilz.",
  },
  {
    "key": "blueprint_vendor_02.conversation_w3sayh_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Allerdings sollte er mehr auf die Professorin hören. Diese Erschütterungen werden sich nicht einfach so in Luft auflösen!",
  },
  {
    "key": "blueprint_vendor_02.conversation_cww3zx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Der Bürgermeister ist gerade nicht da. Ich frage mich, wann er wiederkommt.",
  },
  {
    "key": "blueprint_vendor_02.conversation_0g6nsc_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Hältst du da etwa eine Bombe in der Hand?",
  },
  {
    "key": "blueprint_vendor_02.conversation_474v8c_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Bitte sag mir, dass du hier bist, um dieses schreckliche Gebäude hier in Stücke zu sprengen?",
  },
  {
    "key": "blueprint_vendor_02.conversation_o24esm_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format laugh}Ja, klar!{format reset} Ich meine, nein!",
  },
  {
    "key": "blueprint_vendor_02.conversation_yi4qcu_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed water bomb to pressure bomb",
    "value": "Ich wollte Bürgermeister Yonker meine neue, verbesserte Druckbombe präsentieren. Sie ist genau das, was diese Stadt gerade braucht.",
  },
  {
    "key": "blueprint_vendor_02.conversation_bqmi7g_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Aber er ... hielt mich auf Abstand und verwies mich einfach nur an sein Büro. Allerdings ist niemand hier.",
  },
  {
    "key": "blueprint_vendor_02.conversation_5kay5a_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Aber ich habe kein Problem damit, zu warten. Ich bin sicher, dass der Bürgermeister bald wieder da ist. Wahrscheinlich. Möglicherweise. Vielleicht ... irgendwann.",
  },
  {
    "key": "blueprint_vendor_02.conversation_73lt57_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Bomben besitzen viele verschiedene Anwendungsmöglichkeiten. Du kannst sie eigentlich für {format emph}alles{format reset} verwenden – mehr oder weniger.",
  },
  {
    "key": "blueprint_vendor_02.conversation_2t4ktx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Du kannst mit ihnen Tunnel anlegen, harte mineralienreiche Steine aufsprengen, Schutt und Trümmer beseitigen ...",
  },
  {
    "key": "blueprint_vendor_02.conversation_tkp0i2_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Und vergiss nicht die blinde, unbegründete Zerstörung!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2ynw9y_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Früher haben sie unten in den Minen Tag und Nacht das Dynamit hochgehen lassen. Mann, war das Musik für die Ohren!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2vgr7k_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Süße, tödliche Detonationen!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nhr7x_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed pressurized water bomb to pressure bomb",
    "value": "Ich hoffe, dass ich den Bürgermeister vom Design meiner Druckbombe überzeugen kann. Das Ding ist die Zukunft!",
  },
  {
    "key": "blueprint_vendor_02.conversation_gbuars_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Dieser Kerl versteht, worum es geht!",
  },
  {
    "key": "blueprint_vendor_02.conversation_h4evh3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Ich freue mich, dass du endlich jemanden gefunden hast, mit dem du dich verstehst. Allerdings wäre es mir lieber, wenn es nicht um Bomben ginge.",
  },
  {
    "key": "blueprint_vendor_02.conversation_v0gx3y_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich bin sicher, dass ich den Bürgermeister davon überzeugen kann, dass die Zukunft meinen Bomben gehört.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hwchba_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Mr. Dumpfbacke hat mir mal ein zusammengedrücktes Bombengehäuse gebracht. Meinte, er habe es unten im Territorium der Schnapsis gefunden.",
  },
  {
    "key": "blueprint_vendor_02.conversation_q0vd7o_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Mir wurde allein vom Ansehen speiübel! Wusstest du, dass die Schnapsis ihre Bomben aus {format nervous}Stoffwechselendprodukten und Mondsaft{format reset} herstellen?",
  },
  {
    "key": "blueprint_vendor_02.conversation_shtyfr_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Was soll so falsch daran sein? Es macht doch bumm, oder?",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nsm4v_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ja, das tut es. Und es reißt deine Finger mit weg, wenn du Glück hast!",
  },
  {
    "key": "blueprint_vendor_02.conversation_s7nbis_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed pressurized water bomb to pressure bomb",
    "value": "Nein, danke! Da bleibe ich doch lieber bei meinen sicheren Druckbomben. Da weiß man, was man hat, und es macht trotzdem schön bumm!",
  },
  {
    "key": "blueprint_vendor_02.conversation_p2i5l7_text",
    "notes": "Speaker=Fen Notes=*format* *new* removed "..."",
    "value": "Langweilig.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ptgzep_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Nimm dich hier unten in Acht. Diese Schnapsis bedeuten für gewöhnlich Ärger.",
  },
  {
    "key": "blueprint_vendor_02.conversation_l8kkmb_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Hast du schon Professorin Shermans neue Rakete gesehen? Ein Traum!",
  },
  {
    "key": "blueprint_vendor_02.conversation_9yditf_text",
    "notes": "Speaker=Dorothy Notes=This is Dororthy talking",
    "value": "Ja, sie sieht wirklich beeindruckend aus.",
  },
  {
    "key": "blueprint_vendor_02.conversation_b8svck_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Und sie ist wirklich sicher. Ich habe bei den Kalkulationen geholfen.",
  },
  {
    "key": "blueprint_vendor_02.conversation_wz8w9f_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Es bedarf einigen Drucks, um solch ein riesiges Objekt in Richtung All zu befördern, weißt du. Alles muss präzise kalibriert werden, auf die Dezimalstelle genau.",
  },
  {
    "key": "blueprint_vendor_02.conversation_516qkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Nun, eigentlich ist eine Rakete doch ohnehin nichts anderes als eine große, instabile Bombe, nicht wahr?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8ly6iv_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Mir gefällt, wie sich das entwickelt. Warum gehen wir nicht zur Professorin und fragen sie nach einer Spritztour?",
  },
  {
    "key": "blueprint_vendor_02.conversation_pawve3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Vielleicht später, Fen.",
  },
  {
    "key": "blueprint_vendor_02.conversation_sqkxyn_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Keine Sorge. Ich würde nie einen Fehler machen, wenn es um Bomben geht.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ha9646_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich habe über diese Erdbeben nachgedacht. Ein Beben ist doch nichts anderes als eine große, heftige Vibration, oder?",
  },
  {
    "key": "blueprint_vendor_02.conversation_fs869d_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format singsong}Das heißt, ...{format reset} wenn es uns gelänge, eine gleichgroße, aber {format emph}entgegenwirkende{format reset} Vibration zu erzeugen, würden sich die beiden aufheben!",
  },
  {
    "key": "blueprint_vendor_02.conversation_1frwlw_text",
    "notes": "Speaker=Dorothy",
    "value": "Ähm ... schlägst du tatsächlich vor ...?",
  },
  {
    "key": "blueprint_vendor_02.conversation_qd7crv_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Ja genau! Bomben! Alles, was wir brauchen, ist ein Netzwerk gut platzierter Bomben, die wir synchron zünden müssen!",
  },
  {
    "key": "blueprint_vendor_02.conversation_t8xdab_text",
    "notes": "Speaker=Fen",
    "value": "Ein toller Plan, bei dem gar nichts schiefgehen kann!",
  },
  {
    "key": "blueprint_vendor_02.conversation_50z3oe_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich bin so froh, dass du zustimmst! Allerdings benötige ich ein paar Jahre für die entsprechenden Kalkulationen – die Sicherheit kommt schließlich zuerst!",
  },
  {
    "key": "blueprint_vendor_02.conversation_wdv8yf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Menno ...",
  },
  {
    "key": "blueprint_vendor_02.conversation_dx83ih_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich kann es kaum erwarten, dem Bürgermeister von dem Plan zu berichten. Ich bin sicher, dass er Feuer und Flamme sein wird. Er ist ja nun schon seit einiger Zeit abwesend.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hu5cr9_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich mag dieses ganze Gerede über das Große Beben nicht besonders; es gibt einfach zu viele Variablen: Wie groß? Wann wird es kommen? Wo? Werden die Gärtner arbeitslos?",
  },
  {
    "key": "blueprint_vendor_02.conversation_achdi1_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Seit der Fahrstuhl abgestüzt ist, habe ich mir Gedanken darüber gemacht, was passieren wird, wenn sich ein {format emph}wirklich{format reset} großes Beben ereignet.",
  },
  {
    "key": "blueprint_vendor_02.conversation_k2l3ob_text",
    "notes": "Speaker=Dorothy",
    "value": "Professorin Sherman meint, dass es erst schlimmer werden müsse, bevor es besser wird.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ioi3ht_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Es wäre weise, ihr zuzuhören. Sie ist der cleverste Bot der gesamten Stadt.",
  },
  {
    "key": "blueprint_vendor_02.conversation_5oey6i_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich beginne langsam zu glauben, dass der Bürgermeister nicht zurückkehren wird.",
  },
  {
    "key": "blueprint_vendor_02.conversation_xoknkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed format from laugh to singsong",
    "value": "{format singsong}Oh!{format reset} Ist das ein Druckgranatwerfer? Oh jaa, auch noch das Premium-Modell!",
  },
  {
    "key": "blueprint_vendor_02.conversation_uhq93q_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Bist du ein ... Bombenfetischist, so wie ich, mein Freund?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8o8ba8_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich muss dir unbedingt mein Geheimprojekt zeigen. Ich kann's {format nervous}kaum erwarten{format reset}, das einem Bummkopf wie dir zu zeigen!",
  },
  {
    "key": "blueprint_vendor_02.conversation_ux8mwy_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed format from highligh to emph",
    "value": "Mit meiner als Patent angemeldeter Erweiterung kann dein Granatwerfer das Ziel mit {format emph}drei Mal mehr Zerstörung{format reset} als bisher überziehen!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4urlt2_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich würde es dir ja zum Testen eine Weile leihen, aber ... {format singsong}nun ja{format reset}, mein Forschungs- und Entwicklungsbudget ist in letzter Zeit relativ knapp bemessen.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uxln27_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Wenn du, sagen wir mal, \${var pricelist_next:blueprint_vendor_02}{image money_small} beitragen würdest, könnte ich dir eine exklusive {format highlight}Blaupause{format reset} meiner Erfindung anvertrauen, die es so nur für Spendende gibt. Was denkst du?",
  },
  {
    "key": "blueprint_vendor_02.conversation_dgw94e_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Übrigens, hast du dir die Spende noch einmal durch das Getriebe gehen lassen? Nur \${var pricelist_next:blueprint_vendor_02}{image money_small} und du erhältst diese exklusive {format highlight}Blaupause{format reset}!",
  },
  {
    "key": "blueprint_vendor_02.conversation_20o2j5_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* split this line up",
    "value": "Wunderbar, mein Freund! Und hier ist die Ware. ",
  },
  {
    "key": "blueprint_vendor_02.conversation_52n8bq_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Du musst sie bei der Werkbank verwenden, um diese deine Kanone da zu modifizieren.",
  },
  {
    "key": "blueprint_vendor_02.conversation_9p7l5p_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Worauf wartest du? Geh los und blase irgendwas in tausend Stücke!",
  },
  {
    "key": "blueprint_vendor_02.conversation_gui6im_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Sieht aus, als ob auch deine finanziellen Mittel momentan ein wenig begrenzt sind. Aber keine Sorge! Ich warte hier auf dich, bis du genug Geld hast.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ijkhew_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ich verstehe, mein Freund. Komm doch einfach wieder, wenn du deine Meinung geändert hast.",
  },
  {
    "key": "blueprint_vendor_02.conversation_02qawb_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Sagen dir die Blaupausen zu? Schon irgendetwas Spannendes zum Wegsprengen gefunden?",
  },
  {
    "key": "blueprint_vendor_03.conversation_1hq43e_text",
    "notes": "Speaker=Ty Nuzak Notes=This Character is a mail man/pony express person.",
    "value": "Howdy, Partner. Es ist ziemlich gefährlich geworden, bei diesen Beben zu versuchen, rechtzeitig Nachrichten zu überbringen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_k6q6hf_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Ich habe gehört, dass sich überall in der Wüste mehrere Schlucklöcher auftun sollen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_ple2sp_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Die Wüste ist daher kein sicherer Ort mehr für die Postmannbotreiter.",
  },
  {
    "key": "blueprint_vendor_03.conversation_dum6i9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Daher kann ich dir aktuell nicht weiterhelfen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qy63x4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Alle unsere Postmannbotreiter befinden sich aktuell auf Botengängen. Wir haben nur noch einige Postbotenboybots hier.",
  },
  {
    "key": "blueprint_vendor_03.conversation_4nc6nw_text",
    "notes": "Speaker=Dorothy",
    "value": "Warum bist du nicht ebenfalls dort draußen bei all den anderen?",
  },
  {
    "key": "blueprint_vendor_03.conversation_aozfk3_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Es gibt nichts, dass ein stärkeres Gefühl von {format nervous}Klaustrophobie{format reset} aufkommen lässt als die weiten Ebenen. Kilometerlang nur Leere.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opkpi5_text",
    "notes": "Speaker=Ty Nuzak Notes=*format*",
    "value": "Ich fühle mich schon beengt, wenn ich nur daran denke!",
  },
  {
    "key": "blueprint_vendor_03.conversation_opmgdu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Es gibt wirklich nichts Grauen erregenderes als die endlosen, weiten Ebenen, Partner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_384qc9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Unsere Pferdchen sind über die ganze Wüste verstreut. Man kann die Beben überall spüren, Partner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_c3vack_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Diese verdammten Erschütterungen bedeuten eine Menge Ärger für all die kleine Dörfer, die sich hinter den alten Tempeln befinden.",
  },
  {
    "key": "blueprint_vendor_03.conversation_alusmw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Wir haben selbst Problem, importiertes Erz sicher hier her zu transportieren.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5nkkkg_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Die Wirtschaft dieser kleinen Stadt baut auf importierte Waren aus der ganzen Region auf.",
  },
  {
    "key": "blueprint_vendor_03.conversation_1u0u2r_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Der Dampfponyexpress ist normalerweise der beste Weg, alles hier her zu holen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ufqac_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Der Dampfponyexpress hat einen Ruf zu verteidigen. Ich will nicht, dass er von diesen Erdbeben beschädigt wird.",
  },
  {
    "key": "blueprint_vendor_03.conversation_7idj7v_text",
    "notes": "Speaker=Dorothy",
    "value": "Waren einige von deinen Ponies schon einmal bei den Tempeln?",
  },
  {
    "key": "blueprint_vendor_03.conversation_vfl4c6_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to Ron",
    "value": "Witzig, dass du fragst. Dieser Typ hat sich vor einem Monat nach einer Lieferung der höchsten Dringlichkeitsstufe erkundigt.",
  },
  {
    "key": "blueprint_vendor_03.conversation_51nddn_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* changes to phrasing",
    "value": "Wir mussten ein paar quer über die Windigen Ebenen schicken.",
  },
  {
    "key": "blueprint_vendor_03.conversation_hsitea_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed "pardner".",
    "value": "Man braucht schon richtig kräftige Beine, um dem Gegenwind gewachsen zu sein, das kann ich dir sagen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_g6i2qw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    "value": "Sie haben ein paar Kohlenpfannen bestellt und wollten, dass sie so schnell wie möglich geliefert werden.",
  },
  {
    "key": "blueprint_vendor_03.conversation_j223bu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Wahrscheinlich ging's da um irgendwelche schwachsinnigen Kultaktivitäten.",
  },
  {
    "key": "blueprint_vendor_03.conversation_p4ogy4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Jeder der sich durch die Windigen Ebenen im Osten schlagen will, muss sich Gedanken darüber machen, wie er mit dem Gegenwind fertig wird, Partner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_pgpn5x_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Ich habe gehört, dass du inzwischen eine anständige Tiefe erreicht hättest, Partner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ir3fn_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja, wir suchen nach meinem Freund. Und der könnte irgendwo da unten sein.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0q9lw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* doggone to coggone",
    "value": "Manchmal wünsche ich mir, ich würde diese gottverdammte Stadt einfach hinter mir lassen und an neue Orte reisen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0wgkw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Und dann denke ich an die Gerüchte, dass es einen gefährlichen Dschungel geben soll, der im Untergrund zu finden sein soll.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qgwwxu_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Ich fange an, mir über all die Geheimnisse und Gefahren, die dort unten lauern, Gedanken zu machen.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5phwat_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Mein Herz beginnt {format nervous}zu flattern{format reset} und ich spüre, wie meine Knie weich werden.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cp57ox_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Leck mir die Sporen, bin ich nicht das gelbbäuchigste Pony, das du je gesehen hast?",
  },
  {
    "key": "blueprint_vendor_03.conversation_x5lp6f_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Manchmal wünschte ich mir, ich wäre nicht so eine Memme. Die Welt ist voller spannender Dinge, und ich bin hier und verpasse alles.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w4by19_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Die Erschütterungen werden immer schlimmer. Ich spüre, dass meine 4 Knie langsam nachgeben.",
  },
  {
    "key": "blueprint_vendor_03.conversation_d4gln9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Wir sollten uns langsam in Richtung Rakete aufmachen. Die Zeit rennt uns davon.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w15szm_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Irgendwie kann ich mich mit dem Gedanken eines großen, weiten, mich umgebenden Weltraums nicht so richtig anfreunden.",
  },
  {
    "key": "blueprint_vendor_03.conversation_jnag7u_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Aber andererseits, wenn der Planet ohnehin in die Binsen geht ..., habe ich natürlich keine andere Wahl.",
  },
  {
    "key": "blueprint_vendor_03.conversation_oawrk7_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Es wird also endlich Zeit, meine Komfortzone zu verlassen, wie spannend!",
  },
  {
    "key": "blueprint_vendor_03.conversation_e1e8ry_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Wenn dieser gesamte Planet draufgehen sollte, ist es jetzt vielleicht an der Zeit, mich auf ein Abenteuer zu begeben.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cqe4nv_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Tut mir leid, Partner. Aber meine Blaupausen sind leider alle.",
  },
  {
    "key": "cultist_worship_rusty.conversation_jm66o2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "cultist_worship_rusty.conversation_igsxan_text",
    "notes": "Speaker=Dorothy",
    "value": "Ist das eine {format emph}Statue von Rusty{format reset}, vor der du dich da verneigst?",
  },
  {
    "key": "cultist_worship_rusty.conversation_1voalp_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Ja ... Der Große Rusty ist der Zerstörer der Legende.",
  },
  {
    "key": "cultist_worship_rusty.conversation_pd5hzj_text",
    "notes": "Speaker=Cultist Notes=*new* removed reference to Ron and expanded the text format",
    "value": "Der Großer Prophet hat es vorhergesagt. Und der lügt nie und hat immer recht! Er hat die Ankunft des {format singsong}gesegneten Endes vorausgesehen.{format reset}",
  },
  {
    "key": "cultist_worship_rusty.conversation_y6xyie_text",
    "notes": "Speaker=Fen",
    "value": "Ihr Typen findet wirklich überall Zeug, das ihr anbeten könnt, nicht wahr?",
  },
  {
    "key": "cultist_worship_rusty.conversation_e76l4q_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Licht der Führung! Dieser Ungläubige hat dich aus dem Tempel der Führung entfernt!",
  },
  {
    "key": "cultist_worship_rusty.conversation_qo16zi_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Ich werde ihr Getriebe dem reinigenden Feuer übergeben!",
  },
  {
    "key": "yonker_01.conversation_mdyvq0_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Guten Tag auch! Ich habe wirklich gedacht, {format nervous}dass mich niemand finden würde{format reset}.",
  },
  {
    "key": "yonker_01.conversation_zcgves_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Nicht, dass ich mich verlaufen hätte, oder so. Aber es war wirklich anstrengend, hierher zu kommen, weißt du!",
  },
  {
    "key": "yonker_01.conversation_ara3qe_text",
    "notes": "Speaker=Zebulon Yonker Notes="Feels like Ah should give..." is "Feels like I should give..."",
    "value": "Ich sollte dich für deine Mühe belohnen. Aber alles, was ich habe, ist diese Blaupause.",
  },
  {
    "key": "yonker_01.conversation_2ebftt_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Merk dir einfach, dass deine Reise um {format danger}einiges schwerer{format reset} wird, wenn du das hier aktivierst.",
  },
  {
    "key": "yonker_01.conversation_6jeiwp_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Du solltest es nur verwenden, wenn du dich mal richtig was erleben möchtest!",
  },
  {
    "key": "yonker_01.conversation_pvpsai_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Mach dir keine Sorgen, ich habe mich nicht verirrt. Ich ruhe mich hier nur aus.",
  },
  {
    "key": "yonker_01.conversation_jbfsb5_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Mein kleiner Bruder ist nicht besonders clever. Er hat das alte Transportsystem versiegelt.",
  },
  {
    "key": "yonker_01.conversation_rq43xc_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Er meinte, es sei nicht sicher, oder so. Ich hätte wohl aufmerksamer sein sollen.",
  },
  {
    "key": "yonker_01.conversation_v4t07d_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Manchmal glaube ich, dass die "Hauptaufgabe" meines Bruders darin besteht, den Dampf zu limitieren, der in seinen Kopf gelangt.",
  },
  {
    "key": "yonker_01.conversation_y4mgz6_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ich vermisse diese praktischen Röhren jetzt schon ... Nun muss ich den ganzen Weg nach Hause laufen.",
  },
  {
    "key": "yonker_01.conversation_9kai6i_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Diese Wüsten stehen mit einigen seltsamen Dingen in Verbindung, das kann ich dir sagen.",
  },
  {
    "key": "yonker_01.conversation_1hh5hs_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ich habe sie genau gesehen: Wahnsinnige Kultisten, die den Eingang des alten Tempels unsicher machen.",
  },
  {
    "key": "yonker_01.conversation_vpsiim_text",
    "notes": "Speaker=Zebulon Yonker Notes=*format*",
    "value": "Wirres Gerede, das Abhalten seltsamer Messen und noch viele andere Dinge gehen da unten vor sich.",
  },
  {
    "key": "yonker_01.conversation_efhbif_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Die Minen können die meisten Bots in den Wahnsinn treiben. Wenn sie sich dort zu lange aufhalten.",
  },
  {
    "key": "yonker_01.conversation_914qie_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ich denke, ich werde noch eine Weile hier bleiben. Die harte Arbeit ist ganz schön ermüdend.",
  },
  {
    "key": "yonker_02.conversation_ppa3hq_text",
    "notes": "Speaker=Luke Yonker",
    "value": "{format emph}Verdammt!{format reset} Ich dachte schon, du seist einer von den {format nervous}verrückten Schnapsis!{format reset}",
  },
  {
    "key": "yonker_02.conversation_rtaarn_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ich weiß nicht, wie ich diesen Ort einordnen soll. Er ist keinem der Orte ähnlich, die ich bisher gesehen habe.",
  },
  {
    "key": "yonker_02.conversation_rqui5d_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Man trifft nicht alle Tage einen gleichgesinnten Bot an solch einem seltsamen Ort.",
  },
  {
    "key": "yonker_02.conversation_xpaj1a_text",
    "notes": "Speaker=Luke Yonker Notes=Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    "value": "Hier, nimm diese Blaupause. Meine Art, dir für deine Gesellschaft zu danken.",
  },
  {
    "key": "yonker_02.conversation_5zxme4_text",
    "notes": "Speaker=Luke Yonker Notes=*NEW*",
    "value": "Doch ich muss dich warnen. Wenn du es aktivierst, wird deine Quest {format danger}um einiges schwieriger{format reset}.",
  },
  {
    "key": "yonker_02.conversation_ncsd4z_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Verwende es lieber nicht, wenn du der Gefahr nicht gewachsen bist!",
  },
  {
    "key": "yonker_02.conversation_yp736j_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Sei mir erneut gegrüßt, mein Bot-Kollege.",
  },
  {
    "key": "yonker_02.conversation_g21tdm_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Meine Brüder behaupten, die meisten dieser neuen Wallwände stammten von ihnen. Aber ich weiß, dass das nicht stimmt.",
  },
  {
    "key": "yonker_02.conversation_iehmo4_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Es stimmt zwar, dass sie hier und da ein wenig geflickt haben, aber im Grunde genommen stehen diese Wände schon seit Ewigkeiten hier.",
  },
  {
    "key": "yonker_02.conversation_aytv9n_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Diese Jungs überschätzen einfach ihre Bedeutung, wenn es um den Bau der Wand geht.",
  },
  {
    "key": "yonker_02.conversation_8srkg6_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Wenn es Etwas gibt, was ich weiß, dann ist das, dass es immer einen Weg gibt, diese Wände zu umgehen.",
  },
  {
    "key": "yonker_02.conversation_vb6b0a_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ich schwöre dir, dass ich vor gar nicht so langer Zeit einige Pilze gesehen habe, die sich in Bewegung gesetzt haben.",
  },
  {
    "key": "yonker_02.conversation_0yu226_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Was glaubst du, wie lange werden sie brauchen, um bis zur Stadt zu gelangen?",
  },
  {
    "key": "yonker_02.conversation_onpk10_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ich möchte noch ein wenig die hiesige Wildnis genießen, bevor ich mich auf den Rückweg begebe.",
  },
  {
    "key": "yonker_03.conversation_xfyeov_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Nun, ich war am Bauen und Reparieren, bis mir plötzlich einfiel, dass ich mein Werkzeug gar nicht hatte.",
  },
  {
    "key": "yonker_03.conversation_t1bq4v_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Wenn du mir versprichst, deine Kinnlade geschlossen zu halten, gebe ich dir dieses wichtig aussehende Papier hier.",
  },
  {
    "key": "yonker_03.conversation_odkj11_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Dadurch werden deine Abenteuer ein bisschen ... {format danger}herausfordernder{format reset}.",
  },
  {
    "key": "yonker_03.conversation_nvlvnn_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Verwende es nur, wenn du drauf stehst, dem Tod ins Gesicht zu lachen!",
  },
  {
    "key": "yonker_03.conversation_ajyl7v_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Oh und ... Gibt doch keinen Grund, dass meinen Bros zu erzählen, oder?",
  },
  {
    "key": "yonker_03.conversation_zdkcdy_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Ich freue mich, dass wir uns verstehen.",
  },
  {
    "key": "yonker_03.conversation_wpy2vc_text",
    "notes": "Speaker=Josh Yonker",
    "value": "s gibt keinen Grund meinen Jungs zu sagen, dass du mich hier gefunden hast.",
  },
  {
    "key": "yonker_03.conversation_0fsp3k_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Ich bin eine Korifää..., Konifär..., ein richtiger {format emph}Experte{format reset}, wenn es um das Errichten von Wällen und solchen Dingen geht, musst du wissen.",
  },
  {
    "key": "yonker_03.conversation_l2xfyd_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Wenn diese verfluchten Schnapsis doch einfach nur mal auf ihrer Seite bleiben würden!",
  },
  {
    "key": "yonker_03.conversation_a09h0a_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Ich habe nicht die Zeit, herumzurennen und zu überprüfen, ob alles in Ordnung ist.",
  },
  {
    "key": "yonker_03.conversation_sy2ct5_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Ich habe schon lange keinen Schnapsi mehr gesehen. Vor den Beben sah das allerdings anders aus – jeden Tag nichts als Ärger!",
  },
  {
    "key": "yonker_03.conversation_w8p7tf_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Wenn meine Bros mitbekommen, dass ich mich selbst eingemauert habe, werde ich meines Lebens nicht mehr froh!",
  },
  {
    "key": "sign_red_rock.conversation_rbdoyh_text",
    "notes": "Speaker=Dorothy",
    "value": ""Rotfelsgang"",
  },
  {
    "key": "fen_on_rocket.conversation_jofluh_text",
    "notes": "Speaker=Fen",
    "value": "Oha! Sieh dir nur mal die Absturzstelle an. {format singsong}Was für eine Zerstörung!{format reset}",
  },
  {
    "key": "fen_on_rocket.conversation_rgfncb_text",
    "notes": "Speaker=Dorothy",
    "value": "Hoffen wir einfach mal, dass die Professorin der Rakete in der Stadt einige richtig gute Verbesserungen verpasst hat.",
  },
  {
    "key": "fen_on_rocket.conversation_1mx9ap_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Wie zum Beispiel ein paar coole Laser und solche Sachen!",
  },
  {
    "key": "firetemple_boss_intro.conversation_z6izd0_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Wer wagt es, vor den Großen Propheten des Vernichters zu treten?",
  },
  {
    "key": "firetemple_boss_intro.conversation_cu9az7_text",
    "notes": "Speaker=Fen",
    "value": "Hey, den Typen kenn' ich! Das ist der Kerl, der mich zu dem anderen Tempel gebracht hat.",
  },
  {
    "key": "firetemple_boss_intro.conversation_4ljao8_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Licht der Führung! Ein unwürdiger Bot ... in meinem Tempel?!",
  },
  {
    "key": "firetemple_boss_intro.conversation_m8bbt4_text",
    "notes": "Speaker=Dorothy",
    "value": "Wo ist Rusty? Was ist mit {format emph}ihm passiert?{format reset}",
  },
  {
    "key": "firetemple_boss_intro.conversation_6jm46x_text",
    "notes": "Speaker=Great Prophet Notes=*new* moved text format to other words.",
    "value": "Wie von mir vorhergesagt, wird Rusty der Zerstörer das {format laugh}Große Beben{format reset} hervorrufen, auf dass wir diese sterblichen Hüllen ablegen und Erleuchtung finden können.",
  },
  {
    "key": "firetemple_boss_intro.conversation_mhn5s6_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "In seiner unendlichen Gnade gewährte er uns eine Vorrichtung des Jüngsten Gerichts. Und dann ... verließ er uns. Seine Wege sind wahrlich unergründlich.",
  },
  {
    "key": "firetemple_boss_intro.conversation_davhio_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "firetemple_boss_intro.conversation_39dqwa_text",
    "notes": "Speaker=Dorothy",
    "value": "Dann muss ich die Gerätschaft deaktivieren!",
  },
  {
    "key": "firetemple_boss_intro.conversation_f5igne_text",
    "notes": "Speaker=Fen Notes=*format* removed one of the text formats",
    "value": "Jaah! Sag uns, wo du diese Maschine versteckt hast, damit wir sie {format laugh}wegbomben können{format reset}.",
  },
  {
    "key": "firetemple_boss_intro.conversation_t03c7h_text",
    "notes": "Speaker=Great Prophet",
    "value": "Oh, Licht der Führung, diese ungläubigen Narren! Ihr werdet unserer Maschine kein Leid zufügen!",
  },
  {
    "key": "firetemple_boss_outro.conversation_5ppdcr_text",
    "notes": "Speaker=Great Prophet",
    "value": "{format nervous}Aaargh!{format reset} Ihr könnt die Ankunft des {format laugh}Großen Bebens{format reset} nicht verzögern, geschweige denn verhindern!",
  },
  {
    "key": "firetemple_boss_outro.conversation_veu3hm_text",
    "notes": "Speaker=Great Prophet",
    "value": "Die Maschine des Jüngsten Gerichts ist noch immer sicher und unversehrt. Das Ende ist {format singsong}nah!{format reset}",
  },
  {
    "key": "sign_maze_01.conversation_1l6ojp_text",
    "notes": "Speaker=Dorothy Notes=There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    "value": ""Illusionäre Wand voraus!"",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_cp9bbp_text",
    "notes": "Speaker=Fen Notes=*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    "value": "Komm schon, noch immer nichts?!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_p1i3bn_text",
    "notes": "Speaker=Dorothy Notes=*new* changed an I to a We.",
    "value": "Wir müssen einfach {format highlight}all diese Kohlenpfannen entzünden{format reset}, um die Kristalle zu aktivieren.",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_xqev6z_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    "value": "Sie müssen irgendwo hier in der Nähe sein!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_kk5j23_text",
    "notes": "Speaker=Fen Notes=*new* changed the phrasing to be more Fen-like",
    "value": "Alles klar, dann los. Lass sie uns in Brand stecken!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_4dihd5_text",
    "notes": "Speaker=Fen Notes=*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    "value": "Ja, du hast immer noch nicht alle Kohlenpfannen in Brand gesteckt.",
  },
  {
    "key": "sign_vectron2_1.conversation_7gz2cu_text",
    "notes": "Speaker=Dorothy",
    "value": ""TOD VORAUS!"",
  },
  {
    "key": "cultist_worship_rusty_intro.conversation_8fufl9_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Oh Großer Zerstörer, das Ende ist nah! Es muss einfach nah sein!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_bj94jz_text",
    "notes": "Speaker=Fen",
    "value": "Was hält dich auf? Komm schon!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_i7wge8_text",
    "notes": "Speaker=Dorothy Notes=*new* made it clear that it's only the pipe to the oasis that is closed",
    "value": "Seltsam ... Die Röhre zurück zur Oase funktioniert nicht!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_t6jhkm_text",
    "notes": "Speaker=Fen Notes=*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    "value": "Es wird immer merkwürdiger ... Vielleicht ist die Öffnung auf der Seite irgendwie blockiert?",
  },
  {
    "key": "hub_teleporter_blocked.conversation_kbmx5q_text",
    "notes": "Speaker=Dorothy Notes=*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    "value": "Wir müssen uns wohl einfach durchgraben, um dort anzukommen.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_dhpyma_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to not refert to whole tube system",
    "value": "Das Röhre zurück zur Oase ist immer noch außer Betrieb!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_xdvi4z_text",
    "notes": "Speaker=Fen Notes=*new* added a "come on then,"",
    "value": "Auf geht's, {format highlight}suchen wir einen anderen Weg Richtung Oase.{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_efpvk6_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Du ... du bist zurückgekommen!",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xs0zex_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja. Ich weiß zwar nicht, wie ich rausgekommen bin, aber ich bin wieder da.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_2gp05g_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ich war ... schon wieder allein und steckte fest. Ich muss ... wohl einen Moment eingedöst sein.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_v8dyjq_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Und ich hatte seinen seltsamen Traum ... Ich träumte von etwas, was ich dir mitteilen wollte.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xvqfeq_text",
    "notes": "Speaker=Fen",
    "value": "Es hatte irgendwas mit Erdbeben, fließender Energie und ... und Maschinen zu tun ...",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_6uvdlp_text",
    "notes": "Speaker=Fen Notes=*new* changed format from nervous to emph",
    "value": "{format emph}Dorothy!{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_x1cve3_text",
    "notes": "Speaker=Dorothy",
    "value": "Was, Fen? Was hast du gesehen?",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_c268na_text",
    "notes": "Speaker=Fen",
    "value": "Ich sah ... nein, ich fühlte ... ich fühlte die Präsenz der Maschine des Jüngsten Gerichts.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_glw2u1_text",
    "notes": "Speaker=Dorothy Notes=*new* added the phrase "come on" at the start of the line.",
    "value": "Los, wir müssen unbedingt {format highlight}Rosie davon erzählen{format reset}. Diese Beben sind noch nicht vorbei.",
  },
  {
    "key": "temple_generator_destroyed.conversation_vduxpt_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ahahaha...{format reset}, Gott war das cool!",
  },
  {
    "key": "temple_generator_destroyed.conversation_bez5tc_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja, sieht ziemlich harmlos aus, nicht wahr?",
  },
  {
    "key": "temple_generator_destroyed.conversation_02t7hw_text",
    "notes": "Speaker=Dorothy",
    "value": "Dieses Ding besteht aus lauter Dampfbot- und Vectronteilen.",
  },
  {
    "key": "temple_generator_destroyed.conversation_nloh4y_text",
    "notes": "Speaker=Dorothy",
    "value": "Warum sollte Rusty auf die Idee kommen, so etwas zu bauen?",
  },
  {
    "key": "temple_generator_destroyed.conversation_uo5vst_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Du machst dir zu viele Sorgen. Weniger denken und mehr Zerstörung anrichten!",
  },
  {
    "key": "temple_generator_destroyed.conversation_cqegx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir sollten {format highlight} zur Oase zurückkehren{format reset} und Rosie davon berichten, dass die Maschine deaktiviert ist.",
  },
  {
    "key": "last_generator_destroyed.conversation_o7pn77_text",
    "notes": "Speaker=Dorothy",
    "value": "Das hat sich seltsam zufriedenstellend angefühlt.",
  },
  {
    "key": "last_generator_destroyed.conversation_fhtom3_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Jetzt verstehen wir uns!",
  },
  {
    "key": "last_generator_destroyed.conversation_0j9ty2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "last_generator_destroyed.conversation_j80dt5_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Hast du das gespürt, Fen?",
  },
  {
    "key": "last_generator_destroyed.conversation_4ctogi_text",
    "notes": "Speaker=Fen",
    "value": "Vielleicht, keine Ahnung.",
  },
  {
    "key": "last_generator_destroyed.conversation_5r8xoq_text",
    "notes": "Speaker=Dorothy",
    "value": "Fühlte sich nach einem kleinen, feinen Bebchen an.",
  },
  {
    "key": "last_generator_destroyed.conversation_ue7igm_text",
    "notes": "Speaker=Fen",
    "value": "Brechen wir auf und {format highlight}demolieren wir die anderen Generatoren{format reset}!",
  },
  {
    "key": "last_generator_destroyed.conversation_kx4acl_text",
    "notes": "Speaker=Dorothy",
    "value": "Und ein weiterer gibt klein bei.",
  },
  {
    "key": "last_generator_destroyed.conversation_7knnev_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Jaa!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_7xkz1w_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Es ist echt toll, das ganze hier mit jemanden zusammen zu machen ... nicht allein zu sein, wenn ...",
  },
  {
    "key": "last_generator_destroyed.conversation_orn1ay_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Hey, das war definitiv ein Erdbeben!",
  },
  {
    "key": "last_generator_destroyed.conversation_b59rnh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Muss wohl eine Reaktion darauf sein, dass wir das Ding demoliert haben.",
  },
  {
    "key": "last_generator_destroyed.conversation_s51o2b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "{format emph}Wenn{format reset} wir Rusty finden, werde für alles zur Rede stellen!",
  },
  {
    "key": "last_generator_destroyed.conversation_lxj451_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Keine Sorge, ich stehe hinter dir.",
  },
  {
    "key": "last_generator_destroyed.conversation_mk9qpq_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Oha!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_p2ot9u_text",
    "notes": "Speaker=Dorothy",
    "value": "Holerö, das ist der Letzte!",
  },
  {
    "key": "last_generator_destroyed.conversation_xxw7zr_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Oje, das war aber ein großes Beben!",
  },
  {
    "key": "last_generator_destroyed.conversation_p4nitu_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Das ergibt keinen Sinn. Ich dachte, wir wären die Erdbeben endlich losgeworden.",
  },
  {
    "key": "last_generator_destroyed.conversation_48h46n_text",
    "notes": "Speaker=Fen",
    "value": "Ja, ich bin sicher, dass das die letzte dieser Maschinen war.",
  },
  {
    "key": "last_generator_destroyed.conversation_vkntr1_text",
    "notes": "Speaker=Dorothy Notes=*format* *new*",
    "value": "Ich habe da ein ganz mieses Gefühl. Es gibt zu viele offene Fragen.",
  },
  {
    "key": "last_generator_destroyed.conversation_nzra7p_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Durchgeknallte Kultisten und giftige Dschungel! Und wo ist Rusty?!",
  },
  {
    "key": "last_generator_destroyed.conversation_3r7w00_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Klingt verdammt faul ...",
  },
  {
    "key": "last_generator_destroyed.conversation_mboiam_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Vielleicht ist es gar nicht Rusty? Vielleicht hat sich Rosie geirrt ...",
  },
  {
    "key": "last_generator_destroyed.conversation_iz5s2x_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Oder sie hält etwas vor uns geheim.",
  },
  {
    "key": "last_generator_destroyed.conversation_xd4lj1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Wir müssen zur Oase zurückkehren und {format highlight}ein Wörtchen mit Rosie sprechen{format reset}.",
  },
  {
    "key": "fen_0_brazier_lit.conversation_7k0m7s_text",
    "notes": "Speaker=Fen Notes=*new* changed this since we now have the old version of it triggered up by the first lever at the entrance to this temple",
    "value": "Noch so ein nutzloser Hebel ...",
  },
  {
    "key": "fen_0_brazier_lit.conversation_bqsv37_text",
    "notes": "Speaker=Dorothy Notes=*new* same as above",
    "value": "Ich schätze den muss ich auch einfach irgendwie {format highlight}verstärken{format reset}?",
  },
  {
    "key": "fen_0_brazier_lit.conversation_rzhlfx_text",
    "notes": "Speaker=Dorothy",
    "value": "Noch immer nichts!",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_1l90nu_text",
    "notes": "Speaker=Fen",
    "value": "Diese Kohlenpfanne könnte vielleicht etwas bringen.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_q9t7dt_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased it.",
    "value": "Ja, ich muss nur einen Weg finden, sie anzuzünden.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_sb7zou_text",
    "notes": "Speaker=Fen",
    "value": "Komm schon, {format laugh}zünden wird das Ding endlich an{format reset}!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_utqc5b_text",
    "notes": "Speaker=Rosie",
    "value": "Du hättest wirklich nicht hierher zurückkehren sollen.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8jri1u_text",
    "notes": "Speaker=Dorothy",
    "value": "Was machst du da? Lass ihn sofort gehen, Rosie!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_q1eysc_text",
    "notes": "Speaker=Rosie Notes=*format* *new* changed "he was" to "he's"",
    "value": "Ist dir eigentlich klar, wie viele Schnapsis bei der Jagd nach ihm verletzt wurden? Er ist eine Bestie!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_0g9r4c_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Nun ist er nichts weiter als eine Batterie in meinem Mech-Anzug ... und ich bin ... endlich mächtig genug, um deinesgleichen von hier zu vertreiben und fernzuhalten!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_icw8pm_text",
    "notes": "Speaker=Dorothy Notes=*new* changed format from nervous to emph",
    "value": "Du hast micht {format emph}betrogen{format reset}!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_ir71cz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Ich habe dich {format emph}benutzt{format reset}! Du bist ein Werkzeug! Ich brauchte jemanden, der sich um diese lästigen Maschinen kümmert.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_d3ola6_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Er hat sie gebaut, um meiner Fusionsbrennerei die gesamte Energie abzusaugen ..., aber das war einmal!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_pdqri5_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Der Reaktor versorgt mich jetzt mit allem, was ich brauche, um meine Art zu kontrollieren – einem endlosen Nachschub an Mondsaft!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_rdwldu_text",
    "notes": "Speaker=Rosie",
    "value": "Sie werden nicht mehr länger umherwandern. Sie werden sicher sein ... und mir {format emph}den Respekt zollen, den ich verdiene.{format reset}",
  },
  {
    "key": "rosie_boss_intro_03.conversation_03yhdy_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ich verstehe. Das hast du also gemeint, als du sagtest, Schnapsis seien verwirrt und gefährlich.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_hj0t32_text",
    "notes": "Speaker=invisible_dummy_01 Notes=*new* removed a couple of format tags and just enclosed the whole line",
    "value": "{format nervous}Die Erdbeben ... der Reaktor basiert auf instabiler Vectron-Technologie{format reset} ...",
  },
  {
    "key": "rosie_boss_intro_03.conversation_jndfz3_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}NEIN, DU BIST INSTABIL! ICH HABE ENDLICH DIE KONTROLLE!{format reset}",
  },
  {
    "key": "rosie_boss_intro_03.conversation_18qzvo_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Du bist verrückt! Komplett wahnsinnig.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8q2tds_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}GENUG!{format reset}",
  },
  {
    "key": "rosie_boss_intro_02.conversation_iot2uu_text",
    "notes": "Speaker=invisible_dummy_01",
    "value": "{format nervous}D... Dot?{format reset}",
  },
  {
    "key": "hub_guard_2.conversation_rtuuk8_text",
    "notes": "Speaker=hub_guard_2",
    "value": "Was?",
  },
  {
    "key": "hub_guard_2.conversation_4hbzdf_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hi, was machst du hier?",
  },
  {
    "key": "hub_guard_2.conversation_n15uxu_text",
    "notes": "Speaker=hub_guard_2",
    "value": "Ause bautz scheppo! Verschwinde!",
  },
  {
    "key": "run_away_with_rusty_2.conversation_ciyvzv_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Der Reaktor ... er wird gleich explodieren!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_8qc79q_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Die Erdbeben werden alles vernichten ...{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_118c4u_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}Du musst hier weg!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_qm6zc7_text",
    "notes": "Speaker=Dorothy",
    "value": "Niemals! Wir werden {format emph}gemeinsam von hier verschwinden!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_7421mi_text",
    "notes": "Speaker=Dorothy",
    "value": "Niemals! Wir gehen alle zusammen!",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_90knk7_text",
    "notes": "Speaker=Dorothy",
    "value": "Wenn du uns auf diese Weise hilft, kannst du nicht mitkommen ...",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_0kxcna_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Wir haben keine Zeit! Es gibt keinen anderen Weg. Ihr beiden, rein hier!",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_cd5m29_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Jetzt!",
  },
  {
    "key": "buddy_everyone_left.conversation_ebuimt_text",
    "notes": "Speaker=Dorothy Notes=*new* changed phrasing",
    "value": "Wo sind denn alle hin?",
  },
  {
    "key": "buddy_everyone_left.conversation_nr0trv_text",
    "notes": "Speaker=Fen",
    "value": "Hm, das {format nervous}macht mir Angst.{format reset}",
  },
  {
    "key": "buddy_everyone_left.conversation_5r1v5j_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Wir müssen {format highlight}Rosie finden{format reset} und herausfinden, was sie bis jetzt getrieben hat.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_17f2xe_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Oh Mann! Das muss die Maschine des Jüngsten Gerichts sein.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_jiz6v8_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich wollte mir einfach nicht eingestehen, dass Rusty eine Sache wie diese hervorbringen könnte ...",
  },
  {
    "key": "buddy_first_generator_seen.conversation_nkppty_text",
    "notes": "Speaker=Fen",
    "value": "Das Ding scheint eine Menge Vectron-Teile zu beinhalten.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_5mvh1h_text",
    "notes": "Speaker=Fen",
    "value": "Schrotten wir das Teil! {format laugh}Woah!{format reset}",
  },
  {
    "key": "buddy_first_generator_seen.conversation_t5tmkl_text",
    "notes": "Speaker=Dorothy",
    "value": "Wow! Was ist das für ein Ding?",
  },
  {
    "key": "buddy_first_generator_seen.conversation_96wcqq_text",
    "notes": "Speaker=Fen",
    "value": "Sieht für mich nach Vectron-Technologie aus.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_3ss3dz_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Wir sollten es schnell in seine Einzelteile zerlegen!",
  },
  {
    "key": "player_oasis_locked.conversation_4kheve_text",
    "notes": "Speaker=Dorothy",
    "value": "Der Eingang ist blockiert!",
  },
  {
    "key": "player_oasis_locked.conversation_ruxx9o_text",
    "notes": "Speaker=Fen",
    "value": "Glaubst du, dass die Erdbeben dafür verantwortlich sind?",
  },
  {
    "key": "player_oasis_locked.conversation_cct3lh_text",
    "notes": "Speaker=Dorothy",
    "value": "Wir müssen {format highlight}einen anderen Weg dort hinein finden{format reset} und mit Rosie sprechen.",
  },
  {
    "key": "cutscene_fen_04.conversation_s6wiy7_text",
    "notes": "Speaker=Fen",
    "value": "Und was, hier total gelangweilt und einsam herumschweben?",
  },
  {
    "key": "cutscene_fen_04.conversation_qzc1ay_text",
    "notes": "Speaker=Fen",
    "value": "Dein Ofen ist so schön warm und behaglich. Und es macht Spaß, dich zu nerven. {format laugh}Hehehe!{format reset}",
  },
  {
    "key": "cutscene_fen_04.conversation_ruux6m_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Verdammt!{format reset} Für so etwas habe ich keine Zeit! Ich muss hier {format highlight}raus{format reset}!",
  },
  {
    "key": "cutscene_fen_04.conversation_34h62o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hehehe!{format reset} Hört sich an, als könntest du doch ein wenig Hilfe gebrauchen ...",
  },
  {
    "key": "cutscene_fen_04.conversation_de9yap_text",
    "notes": "Speaker=Fen",
    "value": "Ich habe dieses Gebiet bereits gescannt und, ich {format emph}glaube{format reset}, ich kann dich meine Karte verwenden lassen.",
  },
  {
    "key": "cutscene_fen_04.conversation_wk05yo_text",
    "notes": "Speaker=Fen",
    "value": "Verschwinden wir von hier!",
  },
  {
    "key": "cutscene_fen_04.conversation_h6d5t0_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Herrje! Na gut, dann komm.",
  },
  {
    "key": "fen_haspants.conversation_a9gtqb_text",
    "notes": "Speaker=Fen",
    "value": "Hey! Was macht denn so ein verfluchtes Mutantendings hier?!",
  },
  {
    "key": "fen_haspants.conversation_hsioxg_text",
    "notes": "Speaker=Dorothy",
    "value": "Das ist ein Schnapsi, Fen. Und nun sei leise, er schläft.",
  },
  {
    "key": "crab.conversation_cl8j2w_text",
    "notes": "Speaker=Handy Gabby Notes=*new*",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_erniqz_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Crab is a hideously mutated Shiner. Look like Crab. Talk like people.",
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "crab.conversation_hgy6ga_text",
    "notes": "Speaker=Dorothy",
    "value": "Entschuldige, ich wollte nur ...",
  },
  {
    "key": "crab.conversation_xsba9s_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Speaks jibberish and half sentences.",
    "value": "Meine Steine, baglurb!",
  },
  {
    "key": "crab.conversation_eottc5_text",
    "notes": "Speaker=Dorothy",
    "value": "Ähm ... okay ...",
  },
  {
    "key": "crab.conversation_tolx3y_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_cmj0mp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_kqftzz_text",
    "notes": "Speaker=Dorothy Notes=*new* added a introductory line for dorothy",
    "value": "Hey, wie bist du hier runter gekommen?",
  },
  {
    "key": "crab.conversation_x2c4hn_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "crab.conversation_1d144p_text",
    "notes": "Speaker=Dorothy",
    "value": "Tut mir leid, aber ...",
  },
  {
    "key": "crab.conversation_opes3o_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Meine Röhren, baglurb!",
  },
  {
    "key": "crab.conversation_kzffu7_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Okay, aber hier unten ist es nicht sicher. Du solltest einen besseren Ort zum abhängen finden.",
  },
  {
    "key": "crab.conversation_514n8o_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb!",
  },
  {
    "key": "crab.conversation_rjibkc_text",
    "notes": "Speaker=Dorothy",
    "value": "Schon gut, schon gut!",
  },
  {
    "key": "crab.conversation_q4yhzp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "swimmer.conversation_mo6w8t_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Ich werde erstmal ein Bad nehmen. Wird höchste Zeit, ich fange schon an zu müffeln.",
  },
  {
    "key": "swimmer.conversation_i5u7gc_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Un' ich mache gerne {format singsong}Blubberblassen.{format reset}",
  },
  {
    "key": "swimmer.conversation_h9b611_text",
    "notes": "Speaker=Dorothy",
    "value": "Dieser Ort hier ist wirklich ein Hit.",
  },
  {
    "key": "swimmer.conversation_7u1oej_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Rosie hat ihn errichtet. Als wir jünger waren, war sie 'ne ganz schöne Heulsuse.",
  },
  {
    "key": "swimmer.conversation_d9pcrg_text",
    "notes": "Speaker=Wet Willy",
    "value": "Aber jetzt ist sie groß und stark und sorgt für unseren Nachschub an Mondsaft.",
  },
  {
    "key": "swimmer.conversation_5hc8jc_text",
    "notes": "Speaker=Wet Willy Notes=*format* *new* broke this up into two lines",
    "value": "Ich würde am liebsten direkt hineinspringen! Er wird {format emph}mir{format reset} auch Kraft verleihen.",
  },
  {
    "key": "swimmer.conversation_dqkik7_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Aber Rosie rührt das Zeug niemals an. Sie hebt stattdessen einfach schwere Sachen. Blöd, wenn ihr mich fragt!",
  },
  {
    "key": "swimmer.conversation_jra7p9_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Ich könnte jetzt etwas Mondsaft vertragen!",
  },
  {
    "key": "swimmer.conversation_0ga9xz_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "Ich mag diesen Ort hier zwar sehr, aber ... ich kann dem Ruf der Tunnel dort draußen einfach nicht widerstehen.",
  },
  {
    "key": "swimmer.conversation_6i3ly8_text",
    "notes": "Speaker=Wet Willy",
    "value": "Brüllen regelrecht mit ihrem Getöse.",
  },
  {
    "key": "swimmer.conversation_l4t4ta_text",
    "notes": "Speaker=Wet Willy",
    "value": "Ich vermisse das Schwimmen meiner täglichen Bahnen im Mondsaft.",
  },
  {
    "key": "swimmer.conversation_brmgbs_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "Es ist zwar matschig und dickflüssig, aber mir geht es ohnehin nur darum, ein paar Blasen zu erzeugen.",
  },
  {
    "key": "swimmer.conversation_iyntgs_text",
    "notes": "Speaker=Wet Willy",
    "value": "Die Tunnel, sie rufen nach mir!",
  },
  {
    "key": "swimmer.conversation_rb7d43_text",
    "notes": "Speaker=Wet Willy",
    "value": "Hast du die diese kleinen Kriechtiere in den Tunneln gesehen?",
  },
  {
    "key": "swimmer.conversation_s21hym_text",
    "notes": "Speaker=Wet Willy",
    "value": "Diese Viecher kann man zu schmackhaften Krapfen verwursten.",
  },
  {
    "key": "swimmer.conversation_ky29gq_text",
    "notes": "Speaker=Wet Willy",
    "value": "Frittiert und mit ein wenig {format singsong}Mondsaft übergossen{format reset} – das schmeckt, als ob der Sommer nie zu Ende geht.",
  },
  {
    "key": "swimmer.conversation_7w4sjb_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Wir bereiten uns ein richtig schönes, leckeres Grillfest!",
  },
  {
    "key": "swimmer.conversation_4b9cj5_text",
    "notes": "Speaker=Wet Willy",
    "value": "Lecker. Ich mag frittiertes Kriechzeugs.",
  },
  {
    "key": "swimmer.conversation_ofc7fu_text",
    "notes": "Speaker=Wet Willy",
    "value": "Mondsaft ist nicht nur gesund, er macht mich auch stärker.",
  },
  {
    "key": "swimmer.conversation_l41o8r_text",
    "notes": "Speaker=Wet Willy",
    "value": "Ich könnte ein drittes Bein ganz gut gebrauchen.",
  },
  {
    "key": "generator_sequence_break.conversation_hu136t_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Oh jaah!{format reset} {format singsong}Blinde, unbegründete Gewalt und Zerstörung!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_sfe0sl_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_fjpwyo_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen ... Ich komme wieder, um dich zu holen.",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_va1y6u_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Ja ... Ich weiß.",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_5idlry_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Geh jetzt!",
  },
  {
    "key": "sign_vectron2_2.conversation_x36dp8_text",
    "notes": "Speaker=Dorothy",
    "value": ""ACHTUNG: BITTE NICHT WEITERGEHEN!"",
  },
  {
    "key": "golden_hatch_open.conversation_p6icsu_text",
    "notes": "Speaker=Fen Notes=*new* chenged this to not be a quesetion",
    "value": "Diese Kultisten sind doch allesamt durchgedreht.",
  },
  {
    "key": "golden_hatch_open.conversation_rm0amb_text",
    "notes": "Speaker=Dorothy",
    "value": "Ja, so ziemlich.",
  },
  {
    "key": "golden_hatch_open.conversation_4rm6n6_text",
    "notes": "Speaker=Fen",
    "value": "Irgendwie vermisse ich es, sie alle abzuknallen. Gehen wir hinein und sehen nach, ob wir noch mehr finden.",
  },
  {
    "key": "golden_hatch_open.conversation_5q7isk_text",
    "notes": "Speaker=Dorothy",
    "value": "Ich würde gerne diesen {format highlight}Propheten von ihnen in die Finger bekommen{format reset}. Vielleicht weiß er, wo Rusty gerade steckt.",
  },
  {
    "key": "player_oasis_locked_2.conversation_jd7aed_text",
    "notes": "Speaker=Fen",
    "value": "Hier gibt es viele Röhren ... Möglicherweise gelangen wir hindurch, indem wir das Röhrensystem benutzen?",
  },
  {
    "key": "player_oasis_locked_2.conversation_5wy6ob_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Mich überkommt das dumpfe Gefühl, dass das andere Ende dieser Röhren in den unterirdischen Dschungel mündet.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_444mtr_text",
    "notes": "Speaker=Fen",
    "value": "Hey, sieh dir mal diesen durchsickernden Schlamm an! Wofür ist der wohl gut, was glaubst du?",
  },
  {
    "key": "fen_entering_yarrow2.conversation_9gicpx_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Ehrlich gesagt – ich habe keine Ahnung. Er sieht aber nicht sehr nett aus.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_h3f7cn_text",
    "notes": "Speaker=Fen",
    "value": "Vielleicht ist es eine Art Abfallentsorgungssystem für die Erdbebenmaschine.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_jf4lyk_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Was auch immer hier vor sich geht ... dieser Dschungel scheint sich auszubreiten.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_tkhd41_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Komm jetzt. Lass uns endlich diese Maschine finden, und sie zerstören.",
  },
  {
    "key": "fen_treasure_brazier.conversation_uo28un_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "Hm, noch mehr Kristalle. Ich habe keine Kohlenpfannen in der Nähe gesehen.",
  },
  {
    "key": "fen_treasure_brazier.conversation_orh8x3_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "Sie müssen irgendwo in diesem verflixten Tempel sein!",
  },
  {
    "key": "fen_treasure_brazier.conversation_fytrwl_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "Aber die Maschine des Jüngsten Gerichts ist da nicht drin. Ich will das Ding in seine Einzelteile zerlegen, {format emph}jetzt!{format reset}",
  },
  {
    "key": "fen_treasure_brazier.conversation_w7ohum_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "Jupp, du hast immer noch nicht alle Kohlenpfannen gefunden.",
  },
  {
    "key": "fen_treasure_brazier.conversation_r9v53t_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "Und ich will die Maschine des Jüngsten Gerichts jetzt zerstören.",
  },
  {
    "key": "sign_rons_chamber.conversation_ubahwy_text",
    "notes": "Speaker=Dorothy Notes=*new* added new sign. Operating Acolytes is a referenece to Operating Thetan from Scientology",
    "value": ""Ronalds Schatzkammer. Das Betreten ist nur Akolythen mit Sicherheitsstufe VI oder höher gestattet."",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_y2rvga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Die Luke bewegt sich nicht. Der Hebel ist vollkommen nutzlos.",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_voevwm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Vielleicht muss ich ihn einfach nur irgendwie {format highlight}verstärken{format reset}?",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_29icwu_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Das hat nichts gebracht!",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_86fd8m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich bin mir sicher, dass ich sie einfach nur irgendwie {format highlight}verstärken{format reset} muss.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_one4s1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey, diese neue Panzerung ist ja abgefahren. Jetzt musst du dich nicht mehr beschweren, von Zeugs zerquetscht zu werden und so.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_i2p8ul_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Wir sollten schon noch auf der Hut sein, aber du hast recht, sie sieht ziemlich cool aus, nicht wahr?",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_6i6u7w_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Weißt du, was sie noch cooler machen würde ...?",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_716uhd_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "{format singsong}Flammen!{format reset}",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_mg2reo_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "WOW! Ich glaube, diese Maschine hat meinen Düsenantrieb gerade in eine Waffe verwandelt.",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_3ldyrw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Spitze! Dann fackeln wir jetzt diese mutierte Pflanzenwelt ab!",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_gbh1g1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hoffentlich ist er auch effektiv gegen Dreck. Wir stecken hier unten wohl fest!",
  },
  {
    "key": "fen_on_death_pit.conversation_tvs6ch_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey, dort unten lauern doch wohl keine Gefahren, meinst du nicht? Sieht eigentlich ganz sicher aus.",
  },
  {
    "key": "fen_on_death_pit.conversation_5oflga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Warum machen wir die Wand nicht einfach platt und sehen nach, was sich dort unten befindet? {format laugh}Hihihi!{format reset}",
  },
  {
    "key": "fen_on_death_pit.conversation_6nymg5_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich denke, man hat diese Wand aus gutem Grund gebaut.",
  },
  {
    "key": "fen_on_death_pit.conversation_a8vok3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Und du bist nicht diejenige, die es total zerlegen wird, wenn wir unten aufschlagen.",
  },
  {
    "key": "fen_on_death_pit.conversation_pi5rzp_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Mann, wo bleibt dein Abenteuerdrang?",
  },
  {
    "key": "fen_on_lava_sea.conversation_2h7zkh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Das nenne ich mal 'nen {format emph}riesigen Teich{format reset} voller geschmolzener Mineralien!",
  },
  {
    "key": "fen_on_lava_sea.conversation_tw04k8_text",
    "notes": "Speaker=Dorothy Notes=*new* These -> This",
    "value": "Dieser Kult fährt echt total auf das ganze Feuer- und Verdammniszeugs ab. Ich komme nicht auf die andere Seite, ohne selber zu schmelzen.",
  },
  {
    "key": "fen_on_lava_sea.conversation_c0o17p_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Tauch doch mal deinen Fuß rein. Vielleicht ist es ja gar nicht {format emph}so{format reset} heiß.",
  },
  {
    "key": "fen_on_lava_sea.conversation_651wxm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich müsste feuerresistent sein!",
  },
  {
    "key": "fen_on_lava_sea.conversation_1hn8s0_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Oder du wärst so cool wie ich, dann könntest du einfach rüber fliegen.",
  },
  {
    "key": "fen_on_hubtube.conversation_8yyuh8_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich habe immer noch ein mulmiges Gefühl. Irgendetwas stimmt hier definitiv nicht.",
  },
  {
    "key": "fen_on_hubtube.conversation_jytjex_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Rosie hat eine Menge zu erklären, sobald wir zur Oase zurückgekehrt sind.",
  },
  {
    "key": "fen_on_hubtube.conversation_g4kaqx_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich hätte von Anfang an misstrauischer sein sollen!",
  },
  {
    "key": "fen_on_hubtube.conversation_vigvfw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Wärst du misstrauischer, dann würde ich warscheinlich noch allein in dem Tempel sein.",
  },
  {
    "key": "fen_on_hubtube.conversation_2h3jtj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Jetzt lass uns aus diesem Kanal abhauen und nachsehen, was da vor sich geht.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_w0gsxo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey! Diese Raketen sehen genau so wie die aus, die wir auf unserem Weg hier her gesehen haben.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_n0y3vf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Versuch sie mal mit deiner Picke zu schlagen!",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_nctmv1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hätte nicht gedacht, dass ich mal zu diesem Tempel zurückkehren würde.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_77tocr_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Dieser Ort ist viel größer als nur der Teil dort oben.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_jpag4c_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ich habe nur in dem Totem rumgehangen und bin nie in diesen Bereich gekommen.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_rzcgxv_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hier sollte es einen Haufen absolut tödlicher Fallen und solche coolen Sachen geben.",
  },
  {
    "key": "aftermath_elmachino.conversation_hbejz0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "{format nervous}Mist!{format reset} Aus dem Weg! Bürgermeister und Kleinbots zuerst!",
  },
  {
    "key": "aftermath_elmachino.conversation_ma479g_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}Entschuldigt! Eh ... Ich gehe, so schnell ich kann!{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_fudqd9_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Immer mit der Ruhe Leute! Einer nach dem anderen! Stellt euch in einer geordneten Schlange auf!",
  },
  {
    "key": "aftermath_elmachino.conversation_pox4ng_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Hey! Für Schlangen haben wir keine Zeit! Jetzt steigt endlich in die Rakete einsteigen, bevor hier alles einstürzt!",
  },
  {
    "key": "aftermath_elmachino.conversation_ewm51b_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Hau dir einen Bolzen in den Kiefer! Da sind immer noch Bots in der verdammten Mine. Wir können unsere Leute nicht einfach zurücklassen!",
  },
  {
    "key": "aftermath_elmachino.conversation_tdyz6x_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Mr. Heisenberg ist bereit, die Rakete zu zünden, aber ich kann den Start um ein paar Minuten verzögern ... Dann müssen wir {format emph}durchstarten{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_vtsrcc_text",
    "notes": "Speaker=Barnacle Jones? Notes=*new*",
    "value": "{format nervous}Ziep-Piep{format reset} baglarb!",
  },
  {
    "key": "aftermath_elmachino.conversation_9s60lp_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ja! Du sagst es, Mr. Krabbenbein!",
  },
  {
    "key": "aftermath_elmachino.conversation_qo44wn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Was? Ich habe keinen Mucks gemacht.",
  },
  {
    "key": "aftermath_elmachino.conversation_353gqh_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "{format nervous}Was zum Henker?!{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_1engeq_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Oh, da bist du ja, Herzchen! Dem Erbauer sei Dank, es geht dir gut!",
  },
  {
    "key": "aftermath_elmachino.conversation_ch1z21_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Tolle Darbietung! Ich befürchtete schon, dass du dich verirrt hast.",
  },
  {
    "key": "aftermath_elmachino.conversation_tb8wpb_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Du hast deinen Freund mit dem roten Schal gefunden. Aber wo ist deine kleine leuchtende Freundin abgeblieben?",
  },
  {
    "key": "aftermath_elmachino.conversation_pbnvye_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Das ... Das ist eine lange Geschichte. Ich muss ...",
  },
  {
    "key": "aftermath_elmachino.conversation_u2fefz_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Nun, es freut mich, dass dir nichts fehlt, aber ich kann nicht genug betonen, dass wir {format emph}keine Zeit mehr haben{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_hi1tn7_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Alle in die Rakete einsteigen!",
  },
  {
    "key": "aftermath_elmachino.conversation_t4edhq_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Zeit für uns Bots, ein paar Weltraumabenteuer zu erleben! {format singsong}Yippie!{format reset}",
  },
  {
    "key": "guard_open_hatch_post.conversation_as8gn2_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Eine letzte Sache noch, Fräulein.",
  },
  {
    "key": "guard_open_hatch_post.conversation_3qlskx_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Du stehst davor, dort unten eine riesige und gefährliche Welt zu erkunden ...",
  },
  {
    "key": "guard_open_hatch_post.conversation_24mz6s_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Wenn du verfolgen möchtest, in welche Richtung du dich begibst, kannst du diese Markierungen auf deiner Karte ({image quest_pointer_arrow} und {image quest_pointer_crosshair}) verwenden.",
  },
  {
    "key": "guard_open_hatch_post.conversation_4j1s12_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Ich schätze, du bist ein weiser Bot.",
  },
  {
    "key": "guard_open_hatch_post.conversation_mdsij3_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Ich schätze, du bist ziemlich draufgängerisch.",
  },
  {
    "key": "guard_open_hatch_post.conversation_vaf0gm_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Du hast vielleicht die blauen Pfeile ({image quest_pointer_arrow}) und Fadenkreuze ({image quest_pointer_crosshair}) auf deiner Karte bemerkt.",
  },
  {
    "key": "guard_open_hatch_post.conversation_4zvbgq_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Man könnte sagen, ohne Markierungen bietet das Spiel eher eine "klassische" Erfahrung. Ob das eine gute Sache ist oder nicht ...",
  },
  {
    "key": "guard_open_hatch_post.conversation_9ah4fv_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Aber sei unbesorgt. Du kannst die Markierungen bei der Werkbank in der Stadt jederzeit an- oder abschalten.",
  },
  {
    "key": "guard_open_hatch_post.conversation_rkswy7_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Also, was sagst du? Möchtest du die Markierungen ({image quest_pointer_arrow} und {image quest_pointer_crosshair}) auf dem Weg anzeigen lassen?",
  },
  {
    "key": "guard_open_hatch_post.conversation_w3uj01_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Wie ich schon sagte ...",
  },
  {
    "key": "guard_open_hatch_post.conversation_bw07t1_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Du kannst die Markierungen bei der Werkbank in der Stadt jederzeit an- oder abschalten.",
  },
  {
    "key": "guard_open_hatch_post.conversation_dvacv4_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Also, ich will dich nicht länger aufhalten. Viel Glück dabei, im Rotfelsgang {format highlight}die Röhren freizuräumen{format reset}.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_wamta4_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hey, diese Technologie stammt aus Vectron!",
  },
  {
    "key": "fen_on_teleporter_2.conversation_lkvb6m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Scheint jedoch nicht zu funktionieren.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_ocl1pj_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_llzd7n_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Fen?",
  },
  {
    "key": "fen_on_teleporter_2.conversation_74v2pp_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_hi83wt_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Scheint jedenfalls eine Sackgasse zu sein. Lass uns hier verschiwnden.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_u4cd0d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Was ist los, Fen?",
  },
  {
    "key": "fen_on_teleporter_1.conversation_3rpf0f_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ich will {format emph}da{format reset} nicht rein. Lass uns umdrehen.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_supvbe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Dort draußen in den Minen gibt es 'ne Menge anderer Dinge zu tun.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_tm3xhy_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Schon wieder dieser Teich voller geschmolzener Mineralien, hm?",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_35yo2u_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Ich glaube diesmal {format emph}müssen{format reset} wir ihn überqueren.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_mhir26_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Blos gut, dass du jetzt fast so cool bist wie ich ...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_fnd2g3_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Fast.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b0opbb_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Das nenne ich mal 'nen {format emph}riesigen Teich{format reset} voller geschmolzener Mineralien!",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_17hzlg_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Dieser Kult fährt echt total auf das ganze Feuer- und Verdammniszeugs ab.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b7hr8v_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Lass ihn uns endlich überqueren.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_alk15j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Jepp! Weißt du, mit dieser ganzen neuen Ausrüstung bist du fast so cool wie ich ...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_qa992m_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Fast.",
  },
  {
    "key": "fen_on_totem.conversation_2ou9oe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey sieh mal! Das sind die überreste meines alten Totems.",
  },
  {
    "key": "fen_on_totem.conversation_wz87u3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Fühlt sich wie eine Ewigkeit an, seit wir uns hier begegnet sind, oder?",
  },
  {
    "key": "fen_on_totem.conversation_qxncbz_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ja ... Ich kann nicht wirklich sagen, dass ich es vermisse, {format emph}da drin{format reset} gefangen zu sein.",
  },
  {
    "key": "fen_on_totem.conversation_rvd9qx_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Kultisten abzuknallen hat echt Spass gemacht uns so, aber ich war die ganze Zeit allein.",
  },
  {
    "key": "fen_on_distillery_door.conversation_flred4_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Dieses Ding sieht echt bedrohlich aus, wenn es offen ist.",
  },
  {
    "key": "fen_on_distillery_door.conversation_z5ls33_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Müssen wir da wirklich reingehen?",
  },
  {
    "key": "fen_on_distillery_door.conversation_n7df2r_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Okay. Sehen wir mal nach, was der dicke Schnapsi hier so treibt.",
  },
  {
    "key": "fen_on_distillery_door.conversation_viru7l_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Wir wissen nicht, was Rosie da drin alles gemacht hat. Vielleicht sollten wir uns etwas vorbereiten, bevor wir reingehen?",
  },
  {
    "key": "sign_trials_all_upgrades.conversation_tkltgz_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Alle Verbesserungen erlaubt."",
  },
  {
    "key": "sign_trials_bedrock.conversation_40ih51_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Fassaden und Illusionen."",
  },
  {
    "key": "sign_trials_no_hook.conversation_m31axp_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Kein Greifhaken erlaubt."",
  },
  {
    "key": "sign_trials_no_hook_jetpack.conversation_cbb9jh_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Kein Düsenantrieb, 
kein Greifhaken erlaubt."",
  },
  {
    "key": "sign_trials_no_jetpack.conversation_0tzxsw_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Kein Düsenantrieb erlaubt."",
  },
  {
    "key": "sign_trials_no_upgrades.conversation_3k7mx1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Keine Verbesserungen erlaubt."",
  },
  {
    "key": "sign_trials_only_hook.conversation_mrg3os_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Nur Greifhaken erlaubt."",
  },
  {
    "key": "sign_trials_only_jetpack.conversation_ytjucx_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Nur Düsenantrieb erlaubt."",
  },
  {
    "key": "sign_floor_is_lava.conversation_nol9uu_text",
    "notes": "Speaker=Dorothy Notes=*TEMP* *NEW*",
    "value": ""Bleibt die Tür verschlossen
War die Lava dir nicht wohlgesonnen
Selbst die kleinste Berührung
Komme herein von Neuem"",
  },
]
`;

