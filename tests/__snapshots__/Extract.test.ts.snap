  {
    "key": "upgrade_jackhammer_02_desc",
    "metadata": {
      "raw": "Removed MC Hammer reference",
    },
    "value": ""Améliore l'efficacité de la consommation, plus de puissance pour le même prix."",
  },
  {
    "key": "upgrade_jackhammer_03",
    "metadata": {
      "raw": "From Rocky 4 - Character Ivan Drago",
    },
    "value": "Modèle "Ivan Drago" Mk IV",
  },
  {
    "key": "upgrade_jackhammer_03_desc",
    "metadata": {
      "raw": "His signature phrase "I must break you"",
    },
    "value": ""La pointe a été renforcée avec une carbure de tungstène pour cette sensation de "Je vais te briser"."",
