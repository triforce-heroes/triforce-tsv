  },
  {
    "key": "menu_options_input_jump",
    "value": "Sauter",
  },
  {
    "key": "menu_options_input_jump_desc",
    "value": "Saute ! Maintiens pour sauter plus haut.",
  },
  {
    "key": "menu_options_input_run",
    "value": "Courir",
  },
  {
    "key": "menu_options_input_run_desc",
    "value": "Maintiens pour courir plus vite, nécessite une amélioration au préalable.",
  },
  {
    "key": "menu_options_input_interact",
