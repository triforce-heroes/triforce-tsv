    "value": "Plein écran",
  },
  {
    "key": "menu_options_fullscreen_desc",
    "metadata": {
      "raw": "Computer monitor.",
    },
    "value": "Bascule entre mode plein écran et mode fenêtré.",
  },
  {
    "key": "menu_options_vsync",
    "value": "Synchronisation verticale",
  },
  {
    "key": "menu_options_vsync_desc",
    "value": "Active la synchronisation verticale. Peut réduire la consommation et l'étirement de l'écran. Peut augmenter la latence du taux d'images.",
  },
  {
    "key": "menu_options_enable_ao",
    "value": "Occlusion ambiante",
  },
  {
    "key": "menu_options_enable_ao_desc",
    "value": "Active l'occlusion ambiante, donne aux objets un aspect ombragé. Très demandant en ressources.",
  },
  {
    "key": "menu_options_enable_bloom",
    "value": "Flou lumineux",
  },
  {
    "key": "menu_options_enable_bloom_desc",
    "value": "Active le flou lumineux. Moyennement demandant en ressources.",
  },
  {
    "key": "menu_options_gamma",
    "value": "Luminosité",
  },
  {
    "key": "menu_options_gamma_desc",
    "value": "Ajuste la luminosité (gamma).",
  },
  {
    "key": "menu_options_res_scale",
    "value": "Résolution d'échelle.",
  },
  {
    "key": "menu_options_res_scale_desc",
    "value": "Ajuste la résolution d'échelle du monde. Pour améliorer les performances, utilise le réglage bas.",
  },
  {
    "key": "menu_options_safe_area_resize",
    "metadata": {
      "raw": "HD",
    },
    "value": "Ajustement du surbalayage",
  },
  {
    "key": "menu_options_safe_area_resize_desc",
    "metadata": {
      "raw": "HD",
    },
    "value": "Ajuste la taille d'affichage dans la zone de l'écran dans le cas où l'affichage a le surbalayage et ne peut pas être réglé pour obtenir un rendu de pixels 1:1.",
  },
  {
    "key": "menu_options_screen_custom_scale",
    "metadata": {
      "raw": "HD",
    },
    "value": "Échelle de l'interface utilisateur du menu pause.",
  },
  {
    "key": "menu_options_screen_custom_scale_desc",
    "metadata": {
      "raw": "HD",
    },
    "value": "Change la taille du menu pause en fonction de la taille d'affichage.",
  },
  {
    "key": "menu_options_blackbars",
    "metadata": {
      "raw": "HD",
    },
    "value": "Bordures noires d'écran ultra-panoramique.",
  },
  {
    "key": "menu_options_blackbars_desc",
    "metadata": {
      "raw": "HD",
    },
    "value": "Place les bordures sur les côtés en utilisant un écran ultra-panoramique au lieu de réduire la zone visible en haut et en bas de l'écran.",
  },
  {
    "key": "menu_options_hiqualitylight",
    "metadata": {
      "raw": "HD ",
    },
    "value": "Texture lumière haute qualité",
  },
  {
    "key": "menu_options_hiqualitylight_desc",
    "metadata": {
      "raw": "HD ",
    },
    "value": "Utilise une texture lumière 16 bits réduisant le banding pour un faible coût en performance.",
  },
