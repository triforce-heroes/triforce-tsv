  {
    "key": "upgrades.upgrade_jackhammer_push",
    "value": "Staubstrudel",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push_desc",
    "value": "Zieht dich vorwärts, wann immer der Presslufthammer einen Durchbruch erzielt.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push_flavor",
    "notes": "Pun on Dolly Parton and Kenny Rodgers song Islands in the stream lyrics",
    "value": ""Von hinten erkennt man nur einen Wirbel aus Staub."",
