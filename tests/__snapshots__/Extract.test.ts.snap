  {
    "key": "upgrades.upgrade_lamp",
    "value": "Lamp",
  },
  {
    "key": "upgrades.upgrade_broken_lamp",
    "value": "Broken Lamp",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_desc",
    "notes": "Dorothy fell and broke her lamp.",
    "value": ""Broken after a rough landing, and in dire need of repair or replacement."",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_next_level_desc",
    "value": "Repair the lamp to be granted entrance into the mine.",
  },
  {
    "key": "upgrades.upgrade_lamp_desc",
    "value": "Lights up your surroundings. Consumes fuel over time, which is replenished in town.",
  },
  {
    "key": "upgrades.upgrade_lamp_next_level_desc",
    "value": "Upgrade the lamp to reduce fuel consumption.",
  },
  {
    "key": "upgrades.upgrade_lamp_01",
    "notes": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    "value": "Rock-Bottom Lamp",
  },
  {
    "key": "upgrades.upgrade_lamp_01_desc",
    "value": ""No longer broken, but that's pretty much it."",
  },
  {
    "key": "upgrades.upgrade_lamp_02",
    "value": "Miner's Brite",
  },
  {
    "key": "upgrades.upgrade_lamp_02_desc",
    "value": ""More economic when it comes to burn-time."",
  },
  {
    "key": "upgrades.upgrade_lamp_03",
    "value": "Modified Carbide Lamp",
  },
  {
    "key": "upgrades.upgrade_lamp_03_desc",
    "value": ""Better flow rate control provides a better burn."",
  },
  {
    "key": "upgrades.upgrade_lamp_04",
    "value": "Lodestar",
  },
  {
    "key": "upgrades.upgrade_lamp_04_desc",
    "notes": "Rudolf the Red nose reindeer – lyrics pun.",
    "value": ""Lodestar with your lode so bright, won't you guide my sway tonight?"",
  },
  {
    "key": "upgrades.upgrade_lamp_05",
    "value": "Lantern",
  },
  {
    "key": "upgrades.upgrade_lamp_05_desc",
    "notes": "Green Lantern pun – Green lantern inaguration text.",
    "value": ""In brightest day, in blackest night, no ore shall escape my sight."",
  },
  {
    "key": "upgrades.upgrade_lamp_06",
    "notes": "The Alexandrian Lighthouse",
    "value": "Pharos Light",
  },
  {
    "key": "upgrades.upgrade_lamp_06_desc",
    "value": ""Reinforced with molten lead to better stand the test of time."",
  },
  {
    "key": "upgrades.upgrade_lamp_07",
    "notes": "*NEW* Name meaning "Unconquered Sun", Official sun god of the later Roman Empire and also reference to Emperor Constantines old roman coins with inscription SOL INVICTO COMITI = Commited to the Invincible Sun",
    "value": "Sol Invictus",
  },
  {
    "key": "upgrades.upgrade_lamp_07_desc",
    "value": ""Commit yourself to the Invincible Sun, or at least enjoy a greater light radius."",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01",
    "notes": "Backstreet Boys pun, lyrics from """Larger than Life""" too for flare.",
    "value": "Larger Than Light",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01_desc",
    "value": "Increases your lamp light radius.",
  },
  {
    "key": "upgrades.upgrade_lamp_increased_area_01_flavor",
    "notes": "Backstreet Boys pun, lyrics from "Larger than Life" too for flare.",
    "value": ""More of your time spent in flashes of light."",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01",
    "value": "Summoner",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01_desc",
    "notes": " new: minor rephrasing",
    "value": "Adds a chance of spawning an extra light orb from defeated enemies.",
  },
  {
    "key": "upgrades.upgrade_lamp_light_pickup_01_flavor",
    "value": ""Release their inner sun."",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01",
    "notes": "Movie Eternal Sunshine on the spotless mind.",
    "value": "Spotless Mind",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01_desc",
    "value": "Prevents your light from dropping below 50%%.",
  },
  {
    "key": "upgrades.upgrade_lamp_infinite_light_01_flavor",
    "value": ""You'll never walk alone in the shadows."",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01",
    "notes": "Song: I am the God of hellfire by Arthur Brown*NOT CURRENTLY USED*",
    "value": "Cog of Hellfire",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Deals damage to enemies within your light radius.",
  },
  {
    "key": "upgrades.upgrade_lamp_damaging_light_01_flavor",
    "notes": "*NOT CURRENTLY USED*",
    "value": ""You gonna burn!"",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01",
    "notes": " Kubera – Hindu Mythology Lord of Wealth, Quote is from Thomas Aquinas",
    "value": "Flame of Kubera",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01_desc",
    "value": "Causes pickups to emit light, which in turn makes them easier to discover.",
  },
  {
    "key": "upgrades.upgrade_lamp_lit_pickups_01_flavor",
    "value": ""Better to illuminate, than merely to shine."",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes",
    "notes": " Gordon is a reference to character Flash Gordon and particularily important is the ""Flash"" part which is referencing this upgrade being for the light."",
    "value": "Gordon Reflexes",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes_desc",
    "value": "Increases the chance of you automatically dodging falling rocks and similar death traps.",
  },
  {
    "key": "upgrades.upgrade_lamp_lightning_reflexes_flavor",
    "notes": "*NEW* Quote is a reference to Queen Song "Flash" and the lyrics- He save with a mighty hand every man, every woman every child, with a mighty Flash",
    "value": ""Save yourself with a mighty flash!"",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness",
    "notes": " Text from Pink Floyd's song Another brick in the wall: We don't need no education ,We don't need no thought control, All in all you're just another brick in the wall . Quote by Joseph Ford Newton regarding intolerans, hate and not enough love in the world.",
    "value": "Eye for Weakness",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness_desc",
    "value": "Lets you see the weak parts of walls when shining on them. You don't need no education and no thought control, just look at the wall.",
  },
  {
    "key": "upgrades.upgrade_lamp_eye_for_weakness_flavor",
    "value": ""Men build too many walls and not enough bridges."",
  },
  {
    "key": "upgrades.upgrade_pickaxe",
    "value": "Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_desc",
    "value": "Dorothy's main digging tool.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_next_level_desc",
    "notes": " This means that whatever you hit, you'll need to hit it two times less when you equip this cog in your Pickaxe",
    "value": "Upgrade the Pickaxe to increase it's digging efficiency.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_01",
    "notes": "it's rusty",
    "value": "Rusty Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_01_desc",
    "value": ""Has seen its share of digging, that's for sure."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_02",
    "value": "Iron Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_02_desc",
    "value": ""A miner's basic tool."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_03",
    "notes": " Bardur is an Icelandic half-troll half-man from their mythology.",
    "value": "Bardur-Grip Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_03_desc",
    "value": ""A modest but sturdy companion."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_04",
    "notes": "Pun on Pikachu",
    "value": "Pickaxe Chu",
  },
  {
    "key": "upgrades.upgrade_pickaxe_04_desc",
    "notes": "Based on the old Japanese Cho measuring system, cho, an ancient Japanese unit of length approximately equal to 109.1 meters",
    "value": ""Delicately measured using a traditional Japanese system."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_05",
    "notes": " Reordered some names",
    "value": "Alloy Steel Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_05_desc",
    "notes": " Reordered some names",
    "value": ""This proprietary carbon treatment brings that exquisite balance to your swing."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_06",
    "notes": " Reordered some names",
    "value": "Tungsten Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_06_desc",
    "notes": " Reordered some names",
    "value": ""Has just the right density and toughness for that premium digging experience."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_07",
    "notes": " Reordered some names",
    "value": "Barren North Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_07_desc",
    "notes": " Reordered some names",
    "value": ""More durable and efficient. Just what the barren North requires."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_08",
    "notes": " Reordered some names",
    "value": "Templar Pickaxe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_08_desc",
    "notes": " Reordered some names",
    "value": ""Perfectly weighted. Feels like it does the digging for you."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01",
    "notes": "This is an upgrade for the pickaxe",
    "value": "Sharpened Edge",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01_desc",
    "value": "Deals extra damage to enemies.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_enemy_damage_01_flavor",
    "notes": "From song The first cut is the deepest.",
    "value": ""The first cut is the deepest."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01",
    "notes": "Pun on movie title Midnight Express",
    "value": "Mid-tile Express",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01_desc",
    "notes": " new: minor rephasing",
    "value": "Refines aerodynamics to speed up the ol' swing.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_speed_01_flavor",
    "notes": "Old Duke Ellington song.",
    "value": ""It don't mean a thing if it ain't got that swing!"",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01",
    "value": "Resource Roughhouse",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01_desc",
    "value": "Deals extra damage to resource tiles.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_resource_damage_01_flavor",
    "notes": "Spoof on Patrik Swayzee line from Roadhouse: My way or the highway",
    "value": ""It's either my way or the tileway."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_knockback_01",
    "notes": "Movie Total Recall",
    "value": "Total Recoil",
  },
  {
    "key": "upgrades.upgrade_pickaxe_knockback_01_desc",
    "value": "Pushes enemies further back on impact.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_knockback_01_flavor",
    "notes": "Arnold Schwartzenegger quote from T2",
    "value": ""Hasta la vista, baby."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01",
    "value": "Return to Sender",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01_desc",
    "notes": " new: minor rephrasing.",
    "value": "Allows you to hit projectiles in mid-air to flip their direction.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01_flavor",
    "value": ""A hands-on twist of fate."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire",
    "value": "Ignition Axe",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire_desc",
    "value": "Adds fire and range to your trusty Pickaxe, and makes it deal more damage. May also have other uses...",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire_flavor",
    "value": ""Turn up the heat!"",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp",
    "value": "Hunter's Edge",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp_desc",
    "value": "Gives +5 extra XP from enemies defeated with the Pickaxe.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp_flavor",
    "notes": " Old Ghanaian proverb meaning that the hunter didn't get anything that he hunted so instead he picked mushrooms, but telling him that might hurt his feelings",
    "value": ""If the hunter comes back with mushrooms, don't ask him how his hunt was."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty",
    "value": "Bounty Hunter",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty_desc",
    "value": "Nets you a cash prize for taking out enemies with the Pickaxe.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty_flavor",
    "value": ""Some are in it for the money, some for the hunt."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup",
    "value": "Healer",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup_desc",
    "value": "Adds a chance of spawning an extra health orb from enemies defeated with the Pickaxe.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup_flavor",
    "notes": "*NEW* Marvin Gaye song "sexual healing"",
    "value": ""When I get this feeling, I need sectional healing."",
  },
  {
    "key": "upgrades.upgrade_backpack",
    "value": "Backpack",
  },
  {
    "key": "upgrades.upgrade_backpack_desc",
    "value": "Holds the ores and gems you find.",
  },
  {
    "key": "upgrades.upgrade_backpack_next_level_desc",
    "value": "Upgrade the backpack to get one extra slot for ores and gems.",
  },
  {
    "key": "upgrades.upgrade_backpack_01",
    "value": "Miner's Pack",
  },
  {
    "key": "upgrades.upgrade_backpack_01_desc",
    "value": ""Not very big, but can hold many different kinds of ores and gems."",
  },
  {
    "key": "upgrades.upgrade_backpack_02",
    "value": "Shrewhide Pack",
  },
  {
    "key": "upgrades.upgrade_backpack_02_desc",
    "notes": "Pun on Shakespeare play "Taming of the shrew"",
    "value": ""The maiming of the shrew is a delicate operation, so there aren't many of them around anymore."",
  },
  {
    "key": "upgrades.upgrade_backpack_03",
    "value": "Bag of Holding",
  },
  {
    "key": "upgrades.upgrade_backpack_03_desc",
    "value": ""It's in the name. Really."",
  },
  {
    "key": "upgrades.upgrade_backpack_04",
    "notes": " Pun on the lost epic of ancient Greek litterature, The Sack of Troy",
    "value": "Trojan Sack",
  },
  {
    "key": "upgrades.upgrade_backpack_04_desc",
    "notes": " Pun on Achillean heel,expression meaning where your weakness is",
    "value": ""Let yourself fall head over heels in love with Achillean quality."",
  },
  {
    "key": "upgrades.upgrade_backpack_05",
    "notes": "Pun on the old "I can't believe it's not butter" https://en.wikipedia.org/wiki/I_Can%27t_Believe_It%27s_Not_Butter!",
    "value": "I-Can't-Believe-It's-Just-a-Bag",
  },
  {
    "key": "upgrades.upgrade_backpack_05_desc",
    "notes": "When re-released the product had an additional line on the package - Good on everything.",
    "value": ""Roomy enough for everything!"",
  },
  {
    "key": "upgrades.upgrade_backpack_06",
    "value": "Gremlin Carry",
  },
  {
    "key": "upgrades.upgrade_backpack_06_desc",
    "notes": " A pun on the creatures Gremlins from movie Gremlins. They get evil if they eat after midnight.",
    "value": ""Don't feed it after midnight!"",
  },
  {
    "key": "upgrades.upgrade_backpack_07",
    "notes": "Elves like Legolas from Lord of The rings",
    "value": "Elven Tote",
  },
  {
    "key": "upgrades.upgrade_backpack_07_desc",
    "notes": "Pun on Legolas quote: let a ploughman plough, but choose an otter for swimming, and for running light over grass and leaf, or over snow--an Elf.",
    "value": ""Let a ploughman plough, but choose an otter for swimming, and for running light over grass and leaf, or over snow -- a bag."",
  },
  {
    "key": "upgrades.upgrade_backpack_08",
    "notes": "Lord of the Rings pun - One ring to tame them all.",
    "value": "One Bag to Hold Them All",
  },
  {
    "key": "upgrades.upgrade_backpack_08_desc",
    "value": ""Don't you just love when old puns are reused? You'll love the bag though. Seriously."",
  },
  {
    "key": "upgrades.upgrade_backpack_09",
    "notes": " The big and extinct Elephant-like creature.",
    "value": "Mammoth Pack",
  },
  {
    "key": "upgrades.upgrade_backpack_09_desc",
    "value": ""Woolly and spacious."",
  },
  {
    "key": "upgrades.upgrade_backpack_10",
    "notes": "Pun on the Hindu Scripture Bhagavad Gita https://en.wikipedia.org/wiki/Bhagavad_Gita",
    "value": "Bag-Avad Get'a",
  },
  {
    "key": "upgrades.upgrade_backpack_10_desc",
    "notes": "sanskrit vedanta – vedan't ya? Hinduism - Hindsight",
    "value": ""A bag of mythological proportions. No need for hindsight, just fill it with the riches of life, Vedan't ya?"",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01",
    "value": "Magnetic Separator",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01_desc",
    "notes": " new: minor rephrasing",
    "value": "Pulls exposed resources towards you.",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01_flavor",
    "notes": "Harry Potter pun on spell accio = fetch",
    "value": ""Accio stuff!"",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01",
    "notes": " Norse God Freyr owned a ship that he could fold into his pocket when not needed",
    "value": "Pocket of Freyr",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01_desc",
    "value": "Lets you store one extra chunk of ore per regular slot.",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01_flavor",
    "notes": " Taken from norse mythology, The books of Snorri, The prose Edda, The poetic Edda.",
    "value": ""Prosaic, poetic, pretty."",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01",
    "value": "Dual Depot",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01_desc",
    "notes": " new: rephrasing",
    "value": "Lets you store two gems per slot.",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01_flavor",
    "value": ""A small space with big benefits."",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01",
    "value": "Cash on Disposal",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01_desc",
    "value": "Discarding a resource grants you a share of its monetized value.",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01_flavor",
    "notes": "Lyrics From Sades song Smooth Operator",
    "value": ""No place to be ending but somewhere to start."",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_health",
    "notes": " Pun on Elton john song circle of life meaning that everything goes around and comes back to life – from song circle of life, Recycle the present is just a quote on how recycling today will make the future a better place.",
    "value": "Re-Circle of Life",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_health_desc",
    "value": "Lets you restore a bit of health by discarding resources. Discarding gems restores more health than ore.",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_health_flavor",
    "value": ""Recycle the present, save your future."",
  },
  {
    "key": "upgrades.upgrade_backpack_lower_death_penalty_01",
    "value": "Reaper's Discount",
  },
  {
    "key": "upgrades.upgrade_backpack_lower_death_penalty_01_desc",
    "notes": " new: minor rephrasing",
    "value": "Makes you lose less resources when you die.",
  },
  {
    "key": "upgrades.upgrade_backpack_lower_death_penalty_01_flavor",
    "notes": "Blue Öyster Cult cult classic song Don't fear the reaper",
    "value": ""Don't fear the reaper."",
  },
  {
    "key": "upgrades.upgrade_backpack_town_portal",
    "value": "Portal of Pardon",
  },
  {
    "key": "upgrades.upgrade_backpack_town_portal_desc",
    "notes": "El Machino is the name of the city",
    "value": "Lets you return to El Machino instantly without losing any resources. Activate this ability in the System tab.

{format bold}Disabled in caves and when you are in danger. The ability icon {image town_portal_small} shows you when it can be used.{format reset}",
  },
  {
    "key": "upgrades.upgrade_backpack_town_portal_flavor",
    "value": ""You can keep what's yours."",
  },
  {
    "key": "upgrades.upgrade_backpack_double_resources",
    "notes": "Famous Internet meme Double Rainbow https://www.youtube.com/watch?v=OQSNhk5ICTI",
    "value": "Double Rainbow",
  },
  {
    "key": "upgrades.upgrade_backpack_double_resources_desc",
    "notes": "new: minor rephrasing",
    "value": "Adds a chance to get two resources out of one single resource tile.",
  },
  {
    "key": "upgrades.upgrade_backpack_double_resources_flavor",
    "notes": "From meme double rainbow",
    "value": ""That's so intense!"",
  },
  {
    "key": "upgrades.upgrade_backpack_pickup_money",
    "value": "Hobo King",
  },
  {
    "key": "upgrades.upgrade_backpack_pickup_money_desc",
    "value": "Gives instant cash when you collect low-value resources. The lower the value, the more money you gain. Does nothing for resources above $7.",
  },
  {
    "key": "upgrades.upgrade_backpack_pickup_money_flavor",
    "notes": " Quote from Tolkiens books, character Samwise Gamgee's line: It's like in the great stories, Mr. Frodo, the ones that really mattered.",
    "value": ""It's like in the great stories, Mr. Hobo, the ones that're really tattered."",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_value",
    "notes": "Pun on Bruce Willis Line in Die Hard, yippie ki-yay combined with yuppie as in newly rich person that makes money",
    "value": "Yuppie ki-yay",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_value_desc",
    "value": "Get 30%% more cash when selling resources.",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_value_flavor",
    "notes": "From Internet meme: http://knowyourmeme.com/memes/it-prints-money",
    "value": ""It prints money!"",
  },
  {
    "key": "upgrades.upgrade_armor",
    "value": "Body Armor",
  },
  {
    "key": "upgrades.upgrade_armor_desc",
    "value": "The armor protects you from the dangers of the depths.",
  },
  {
    "key": "upgrades.upgrade_armor_next_level_desc",
    "value": "Upgrade the armor to increase your total health.",
  },
  {
    "key": "upgrades.upgrade_armor_01",
    "value": "Plate Armor",
  },
  {
    "key": "upgrades.upgrade_armor_01_desc",
    "value": ""Basic protective armor. Nothing fancy."",
  },
  {
    "key": "upgrades.upgrade_armor_02",
    "value": "Sturdy Armor",
  },
  {
    "key": "upgrades.upgrade_armor_02_desc",
    "value": ""Sturdier than the basic tier, but still pretty basic stuff."",
  },
  {
    "key": "upgrades.upgrade_armor_03",
    "value": "Hard Armor",
  },
  {
    "key": "upgrades.upgrade_armor_03_desc",
    "value": ""Provides great protection in dangerous environments."",
  },
  {
    "key": "upgrades.upgrade_armor_04",
    "value": "Tempered Armor",
  },
  {
    "key": "upgrades.upgrade_armor_04_desc",
    "value": ""Differential tempering from a European traditional technique."",
  },
  {
    "key": "upgrades.upgrade_armor_05",
    "value": "Famed Armor",
  },
  {
    "key": "upgrades.upgrade_armor_05_desc",
    "notes": "From lyrics to song Fame from movie Fame",
    "value": ""It wants to live forever, it wants to learn how to fly (high)."",
  },
  {
    "key": "upgrades.upgrade_armor_06",
    "value": "Doom Armor",
  },
  {
    "key": "upgrades.upgrade_armor_06_desc",
    "notes": "From Doom game manual description of their armor and pun on title "knee-deep in the dead" – the first level from original Doom",
    "value": ""A standard security armor designed for getting knee-deep into trouble."",
  },
  {
    "key": "upgrades.upgrade_armor_07",
    "value": "Full Moon Armor",
  },
  {
    "key": "upgrades.upgrade_armor_07_desc",
    "notes": "Reference to Tom Petty's song "Won't back down" from album "Full Moon Fever"",
    "value": ""When standing in front of the gates of Hell, it won't back down."",
  },
  {
    "key": "upgrades.upgrade_armor_08",
    "value": "Phoenix Armor",
  },
  {
    "key": "upgrades.upgrade_armor_08_desc",
    "notes": "Thou – old english",
    "value": ""Rise, brush the ashes off your shoulder and be thou a new star."",
  },
  {
    "key": "upgrades.upgrade_armor_reduce_falldamage_01",
    "notes": " Landing soft like the cougar feline",
    "value": "Cougar Paws",
  },
  {
    "key": "upgrades.upgrade_armor_reduce_falldamage_01_desc",
    "value": "Reduces your fall damage.",
  },
  {
    "key": "upgrades.upgrade_armor_reduce_falldamage_01_flavor",
    "value": ""Catch me when I fall."",
  },
  {
    "key": "upgrades.upgrade_armor_thorns",
    "value": "Karma Plates",
  },
  {
    "key": "upgrades.upgrade_armor_thorns_desc",
    "value": "Deals damage to anyone that injures you by touch.",
  },
  {
    "key": "upgrades.upgrade_armor_thorns_flavor",
    "notes": "A power ballad song by band Poison",
    "value": ""Every rose has its thorn."",
  },
  {
    "key": "upgrades.upgrade_armor_guts",
    "notes": "A spoof on Hasselhoff's song True Survivor for short film Kung Fury",
    "value": "True Survivor",
  },
  {
    "key": "upgrades.upgrade_armor_guts_desc",
    "value": "When you first take lethal damage, instead regain full HP. Ability resets in town.",
  },
  {
    "key": "upgrades.upgrade_armor_guts_flavor",
    "value": ""Calling from the ashes, make it like a true survivor."",
  },
  {
    "key": "upgrades.upgrade_armor_resistliquids",
    "notes": "Vidar = The Norse God that slayed the Fenrir Wolf",
    "value": "Vidar Boots",
  },
  {
    "key": "upgrades.upgrade_armor_resistliquids_desc",
    "value": "Makes you acid and lava resistant for a short while.",
  },
  {
    "key": "upgrades.upgrade_armor_resistliquids_flavor",
    "value": ""These boots are made for walking. In acid and lava."",
  },
  {
    "key": "upgrades.upgrade_armor_damage_reduction",
    "value": "Ultra Composite Armor",
  },
  {
    "key": "upgrades.upgrade_armor_damage_reduction_desc",
    "value": "Reduces damage taken.",
  },
  {
    "key": "upgrades.upgrade_armor_damage_reduction_flavor",
    "value": ""A gauge of the sturdiest protection ever made."",
  },
  {
    "key": "upgrades.upgrade_armor_rainbow_orbs",
    "notes": "*NEW* Song "As long as you love me" by Backstreet Boys. I don't care who you are, Where you're from, What you did, As long as you love me. The terms diversity, fluid and rainbow are used as an hommage to tolerance and the LGBTQ community.",
    "value": "Core Diversity",
  },
  {
    "key": "upgrades.upgrade_armor_rainbow_orbs_desc",
    "value": "A fluid, polychromatic armor that provides a small chance of getting 3 Rainbow Orbs every time an enemy is defeated.",
  },
  {
    "key": "upgrades.upgrade_armor_rainbow_orbs_flavor",
    "value": ""It doesn't care who you are, where you're from or what you dig – as long as you wear it."",
  },
  {
    "key": "upgrades.upgrade_armor_deflect",
    "value": "Aramid Armor",
  },
  {
    "key": "upgrades.upgrade_armor_deflect_desc",
    "value": "Deflects the first projectile that hits you. Takes 30 seconds to recharge.",
  },
  {
    "key": "upgrades.upgrade_armor_deflect_flavor",
    "notes": "A riposte used when someone calls you a name. Indicates that whatever ... I'm rubber you're glue, your words bounce off me and stick to you. Also a nod to its usage in Monkey Island game series.",
    "value": ""I am rubber, you are glue."",
  },
  {
    "key": "upgrades.upgrade_watertank",
    "value": "Water Tank",
  },
  {
    "key": "upgrades.upgrade_watertank_desc",
    "value": "Many of your tools use water, which is replenished in pockets of water throughout the mine.",
  },
  {
    "key": "upgrades.upgrade_watertank_next_level_desc",
    "value": "Upgrade the water tank to expand your total water reserve.",
  },
  {
    "key": "upgrades.upgrade_watertank_01",
    "value": "Plain Jar",
  },
  {
    "key": "upgrades.upgrade_watertank_01_desc",
    "value": ""The cornerstone of steam-driven technology."",
  },
  {
    "key": "upgrades.upgrade_watertank_02",
    "notes": "Herman Melville - author of Moby Dick",
    "value": "Melville Regulator",
  },
  {
    "key": "upgrades.upgrade_watertank_02_desc",
    "value": ""Brings a classic touch to aquatic technology."",
  },
  {
    "key": "upgrades.upgrade_watertank_03",
    "notes": "The Notourious B.I.G. and his song Mo money Mo problems",
    "value": "The Notorious W.E.T.",
  },
  {
    "key": "upgrades.upgrade_watertank_03_desc",
    "value": ""Mo water Mo power."",
  },
  {
    "key": "upgrades.upgrade_watertank_04",
    "notes": "Old band The Sisters of Mercy",
    "value": "The Cisterns of Mercy",
  },
  {
    "key": "upgrades.upgrade_watertank_04_desc",
    "notes": "One of their songs",
    "value": ""Dream of the flood."",
  },
  {
    "key": "upgrades.upgrade_watertank_05",
    "notes": "From Captain Nemo's submarine Nautilus",
    "value": "Nautilus II",
  },
  {
    "key": "upgrades.upgrade_watertank_05_desc",
    "notes": "Spoof on Jules Verne's book Twenty Thousand Leagues under the sea",
    "value": ""Twenty thousand leagues of water."",
  },
  {
    "key": "upgrades.upgrade_watertank_water_pickup_01",
    "value": "Rainmaker",
  },
  {
    "key": "upgrades.upgrade_watertank_water_pickup_01_desc",
    "notes": " new: minor rephrasing.",
    "value": "Adds a chance of spawning an extra water orb from defeated enemies.",
  },
  {
    "key": "upgrades.upgrade_watertank_water_pickup_01_flavor",
    "notes": "BJ Thomas song Raindrops Keep falling on my head",
    "value": ""Raindrops keep falling on your head."",
  },
  {
    "key": "upgrades.upgrade_watertank_improved_water_pump",
    "notes": "Technotronics old song",
    "value": "Pump up the Jam",
  },
  {
    "key": "upgrades.upgrade_watertank_improved_water_pump_desc",
    "value": "Absorbs water faster from pools.",
  },
  {
    "key": "upgrades.upgrade_watertank_improved_water_pump_flavor",
    "notes": "From the song Pump up the Jam",
    "value": ""Pump it up while your feet are stompin'."",
  },
  {
    "key": "upgrades.upgrade_watertank_water_condenser",
    "value": "Moisture Vaporator",
  },
  {
    "key": "upgrades.upgrade_watertank_water_condenser_desc",
    "value": "Transforms moisture into flowing water, constantly replenishing your water supply.",
  },
  {
    "key": "upgrades.upgrade_watertank_water_condenser_flavor",
    "notes": "Jimmy cliff song lyrics: I can see clearly now the rain is gone",
    "value": ""I can see clearly now the rain is gone."",
  },
  {
    "key": "upgrades.upgrade_watertank_light_orbs_to_water",
    "value": "Storm Chaser",
  },
  {
    "key": "upgrades.upgrade_watertank_light_orbs_to_water_desc",
    "value": "This condenser contrapment turns Light Orbs into Water Orbs. Does not affect Rainbow Orbs.",
  },
  {
    "key": "upgrades.upgrade_watertank_light_orbs_to_water_flavor",
    "notes": "Reference to the Bible where Jesus turned water into wine",
    "value": ""Light to water, water to wine - oldest trick in the book."",
  },
  {
    "key": "upgrades.upgrade_watertank_regeneration",
    "value": "Aquatic Regenesis",
  },
  {
    "key": "upgrades.upgrade_watertank_regeneration_desc",
    "notes": " new: minor rephrasing",
    "value": "Regenerates life when in water pools.",
  },
  {
    "key": "upgrades.upgrade_watertank_regeneration_flavor",
    "value": ""Nurse me back to health."",
  },
  {
    "key": "upgrades.upgrade_minimap",
    "value": "Map",
  },
  {
    "key": "upgrades.upgrade_minimap_desc",
    "value": "Keeps track of where you've been and where you're going.",
  },
  {
    "key": "upgrades.upgrade_minimap_01",
    "value": "Map",
  },
  {
    "key": "upgrades.upgrade_minimap_01_desc",
    "notes": "Quote from Earl Nightingale, american writer",
    "value": ""All you need is the plan, the road map, and the courage to press on to your destination."",
  },
  {
    "key": "upgrades.upgrade_minimap_quest_pointer",
    "notes": " (Renamed)",
    "value": "Map Markers",
  },
  {
    "key": "upgrades.upgrade_minimap_quest_pointer_desc",
    "notes": " Text within { } should not be translated.",
    "value": "Shows markers ({image quest_pointer_arrow} and {image quest_pointer_crosshair}) on your map to your quest destinations. 

{format bold}If you prefer exploration without guidance, disable this Cog Mod.{format reset}",
  },
  {
    "key": "upgrades.upgrade_minimap_quest_pointer_flavor",
    "notes": "A nod to Lemmy's Show and the character Falconhoof. https://www.youtube.com/watch?v=oWmiShFb0go",
    "value": ""Like a falcon follows its hoofs, it will guide you on your quest."",
  },
  {
    "key": "upgrades.upgrade_minimap_mineral_detector",
    "notes": "Nod to the Harry Potter Marauder's Map",
    "value": "More-Hoarder's Map",
  },
  {
    "key": "upgrades.upgrade_minimap_mineral_detector_desc",
    "value": "Reveals all resources on the mini-map.",
  },
  {
    "key": "upgrades.upgrade_minimap_mineral_detector_flavor",
    "notes": "Small pun on actor Roger Moore",
    "value": ""Roger, more ore."",
  },
  {
    "key": "upgrades.upgrade_minimap_hp_bar",
    "notes": " Odin – all-seeing father of norse mythology, quote is merely a question without reference, feel free to make it into your own languages equivalent",
    "value": "Gaze of Odin",
  },
  {
    "key": "upgrades.upgrade_minimap_hp_bar_desc",
    "value": "Displays your enemies' health once you've damaged them.",
  },
  {
    "key": "upgrades.upgrade_minimap_hp_bar_flavor",
    "value": ""What lies beyond the mind's eye?"",
  },
  {
    "key": "upgrades.upgrade_run_boots",
    "notes": "*DEMO*",
    "value": "Sprint Hydraulics",
  },
  {
    "key": "upgrades.upgrade_run_boots_desc",
    "value": "To run, hold {indicator run} while moving.
Running makes you move faster and jump higher.",
  },
  {
    "key": "upgrades.upgrade_run_boots_flavor",
    "notes": "I Blame Coco lyrics from song Quicker",
    "value": ""If we could only be faster, then we could outsmart time."",
  },
  {
    "key": "upgrades.upgrade_buddy",
    "notes": "Name",
    "value": "Fen",
  },
  {
    "key": "upgrades.upgrade_buddy_desc",
    "value": "A mysterious ghost-like entity that now calls your steam furnace its home.",
  },
  {
    "key": "upgrades.upgrade_fate",
    "value": "Fate Engine",
  },
  {
    "key": "upgrades.upgrade_fate_desc",
    "value": "Mysterious upgrades that shift the gears powering the universe.",
  },
  {
    "key": "upgrades.upgrade_fate_flavor",
    "notes": "Black Sabbath lyrics from song Symptom of the universe",
    "value": ""The symptom of the universe is written in your eyes."",
  },
  {
    "key": "upgrades.upgrade_fate_bloodquest",
    "value": "{image danger}Blood Quest{image danger}",
  },
  {
    "key": "upgrades.upgrade_fate_bloodquest_desc",
    "notes": "Blood Stone is a resource in the game. Text within { } should not be translated. ",
    "value": "Gain bounty at the price of blood!
Doubles the chance to get blood stones when enemies die, but also increases the damage they do to you.

{format bold}Activating this Cog Mod will make your quest much harder. It is only recommended for veterans.{format reset}",
  },
  {
    "key": "upgrades.upgrade_fate_bloodquest_flavor",
    "value": ""A double-edged sword indeed."",
  },
  {
    "key": "upgrades.upgrade_fate_xpx2",
    "value": "{image danger}Thrillseeker's Tale{image danger}",
  },
  {
    "key": "upgrades.upgrade_fate_xpx2_desc",
    "notes": "Text within { } should not be translated. ",
    "value": "Doubles XP from kills, but enemies only drop orbs from creative kills or bonuses.

{format bold}Activating this Cog Mod will make your quest much harder. It is only recommended for veterans.{format reset}",
  },
  {
    "key": "upgrades.upgrade_fate_xpx2_flavor",
    "notes": "Made up proverb",
    "value": ""More gain, more pain."",
  },
  {
    "key": "upgrades.upgrade_fate_explosions",
    "value": "{image danger}Deathplosions{image danger}",
  },
  {
    "key": "upgrades.upgrade_fate_explosions_desc",
    "notes": "Text within { } should not be translated. ",
    "value": "Enemies explode upon dying.

{format bold}Activating this Cog Mod will make your quest much harder.{format reset}",
  },
  {
    "key": "upgrades.upgrade_fate_explosions_flavor",
    "notes": "Let there be light, from the bible",
    "value": ""Let there be explosions."",
  },
  {
    "key": "upgrades.upgrade_fate_resource_exploder",
    "notes": " Criss-Cross is refering to that the adjacent tiles will break in a cross pattern. Totally krossed out is Rap duo Kriss-Kross debut album, so it's a pun on that, but with correct spelling with c, not k.",
    "value": "Criss-Cross Combustion",
  },
  {
    "key": "upgrades.upgrade_fate_resource_exploder_desc",
    "value": "Breaking resource tiles creates a small burst that damages adjacent tiles.",
  },
  {
    "key": "upgrades.upgrade_fate_resource_exploder_flavor",
    "value": ""Totally crossed out."",
  },
  {
    "key": "upgrades.upgrade_fate_hell_cave_sigil",
    "notes": " Latin for Seal of Heaven and Hell",
    "value": "Sigillum Caelum et Infernum",
  },
  {
    "key": "upgrades.upgrade_fate_hell_cave_sigil_desc",
    "value": "Close to the peak of solitude
A howling desert embrace
Take to the skies to seal your fate
In a strange and wonderful place",
  },
  {
    "key": "upgrades.upgrade_fate_hell_cave_sigil_flavor",
    "notes": " Nod to Twin Peaks: Fire Walk With Me, meaning that you invite the devil to join you. Fate walk with me implies that you invite fate into your life.",
    "value": ""Fate walk with me."",
  },
  {
    "key": "upgrades.upgrade_steampack",
    "value": "Jet Engine",
  },
  {
    "key": "upgrades.upgrade_steampack_desc",
    "value": "To fly, hold {indicator jump}.
This experimental diesel combustion engine uses no water, but overheats quickly.",
  },
  {
    "key": "upgrades.upgrade_steampack_next_level_desc",
    "value": "Upgrade the Jet Engine to last longer.",
  },
  {
    "key": "upgrades.upgrade_steampack_01",
    "notes": "From Rocketeer comic origin 1939, character Cliff Secord",
    "value": "Secord Mod 38",
  },
  {
    "key": "upgrades.upgrade_steampack_01_desc",
    "value": ""A basic inline-four engine."",
  },
  {
    "key": "upgrades.upgrade_steampack_02",
    "value": "Double Cyclone",
  },
  {
    "key": "upgrades.upgrade_steampack_02_desc",
    "value": ""Air-cooled and inverted."",
  },
  {
    "key": "upgrades.upgrade_steampack_03",
    "notes": "Reference to a French WW1 engine.",
    "value": "Le Rhône 69",
  },
  {
    "key": "upgrades.upgrade_steampack_03_desc",
    "value": ""Combined air-water cooling system. All or nothing, baby, all or nothing."",
  },
  {
    "key": "upgrades.upgrade_steampack_slayer",
    "value": "Ramjet Vigor",
  },
  {
    "key": "upgrades.upgrade_steampack_slayer_desc",
    "value": "While using your Jet Engine burst, enemies and weak tiles that come into contact with you are destroyed.",
  },
  {
    "key": "upgrades.upgrade_steampack_slayer_flavor",
    "notes": "Reference to Eric Clapton song Grand Illusion",
    "value": ""Caught between the madness and the fire."",
  },
  {
    "key": "upgrades.upgrade_steampack_feather_fall",
    "notes": " References is to song Falling by Julee Cruise, and song line Don't let yourself be hurt this time.",
    "value": "Cruise Control",
  },
  {
    "key": "upgrades.upgrade_steampack_feather_fall_desc",
    "value": "When the Jet Engine overheats, keep holding {indicator jump} to reduce your fall speed.",
  },
  {
    "key": "upgrades.upgrade_steampack_feather_fall_flavor",
    "value": ""Don't let yourself be hurt this time."",
  },
  {
    "key": "upgrades.upgrade_steampack_boost",
    "notes": " Quote from character Maverick from movie Top Gun. Maverick Afterburner is also a reference to the character played by Tom Cruise.",
    "value": "Maverick Afterburner",
  },
  {
    "key": "upgrades.upgrade_steampack_boost_desc",
    "value": "Increases your Jet Engine speed, so just rev up your engine and listen to her howlin' roar.",
  },
  {
    "key": "upgrades.upgrade_steampack_boost_flavor",
    "value": ""I feel the need, the need for speed."",
  },
  {
    "key": "upgrades.upgrade_steampack_in_air_cooling",
    "notes": "*NEW* Eastbound and down is a song from the movie "Smokey and the Bandit" Cletus Snow is a character from the movie, and his dog's name is Fred.",
    "value": "Air Cooling",
  },
  {
    "key": "upgrades.upgrade_steampack_in_air_cooling_desc",
    "value": "Release {indicator jump} mid-air to cool down the Jet Engine. Manufactured by Snow & Fred Ltd.",
  },
  {
    "key": "upgrades.upgrade_steampack_in_air_cooling_flavor",
    "value": ""Get eastbound and down without overheating!"",
  },
  {
    "key": "upgrades.upgrade_pressurebomb",
    "value": "Pressure Bomb",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_desc",
    "value": "Can be thrown forward, up or down. Consumes water.
Press {indicator tool_pressurebomb} to throw!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_next_level_desc",
    "value": "Upgrade the Pressure Bombs to be able to throw them farther.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_01",
    "notes": "Osmotic= water pressure terminology",
    "value": "Osmotic Ticker",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_01_desc",
    "notes": "A small refernence, mid-range migraine, to song The Message by Grandmaster Flash and the Furious Five",
    "value": ""High pressure equals great force and a mid-range migraine."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_02",
    "notes": "Per Scholander= physiologist renowned for pressure bomb technology",
    "value": "Scholander Hydrostatic",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_02_desc",
    "value": ""Throw that pressurized destruction even further!"",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_03",
    "value": "Acid Bomb",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_03_desc",
    "notes": "Reference to Scooter song Acid Bomb",
    "value": ""Hey you bomb-bomb, let's go to the wild side."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_04",
    "notes": "*NEW* Reference: Song Who Put The Bomp by Barry Mann: "Who put the bomp in the bomp bah bomp bah bomp / Who put the ram in the rama lama ding dong / Who put the bop in the bop shoo bop shoo bop / Who put the dip in the dip da dip da dip." =So now you can throw the bomb further = bomb bah LONGA' =longer",
    "value": "Bomp Bah Bomb",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_04_desc",
    "value": ""Who put the long in the bomb bah longa' bomb? Beats me, but now your bombs fly even further!"",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_brickbreaker",
    "value": "Buster Shells",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_brickbreaker_desc",
    "value": "Makes your Pressure Bombs shatter even harder rocks than before!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_brickbreaker_flavor",
    "notes": "Ghostbusters pun - When there's something strange in the neighbourhood, who ya gonna call",
    "value": ""Who you gonna call?"",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher",
    "value": "Grenade Launcher",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_desc",
    "value": "Hold {indicator tool_pressurebomb} to launch a grenade in an arc for mass destruction.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_flavor",
    "notes": "Billy Ray Cyrus song Achy breaky heart",
    "value": ""Don't break my arc, my achy breaky arc."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_improved_water",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Tax Reduction",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_improved_water_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Cuts water consumption in half.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_improved_water_flavor",
    "notes": "*NOT CURRENTLY USED* Biblical referense to Moses",
    "value": ""A split worthy of Moses."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup",
    "value": "Wet Wet Wet Bomb",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup_desc",
    "value": "Spawns an extra water orb from tiles destroyed by Pressure Bombs.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_water_pickup_flavor",
    "notes": "Reference to band Wet Wet Wet and their song Love is all around",
    "value": ""Water is all around."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Pressure Amplifier",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "The blast wave of the Pressure Bomb damages enemies further away.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius_flavor",
    "notes": "*NOT CURRENTLY USED* Chris Cornell song wave Goodbye",
    "value": ""Give it one more try, to wave goodbye, wave goodbye."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity",
    "notes": "Pun on Molotov Cocktail",
    "value": "Molotov Vaccination",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity_desc",
    "value": "Stops Pressure Bombs from hurting you.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_self_immunity_flavor",
    "value": ""How to stay out of harm's way? Never stop vaccinating."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple",
    "notes": " ThreeForce is a reference to the Legend of Zelda TriForce, The quote is just a rhyme and not important.",
    "value": "ThreeForce Grenade",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple_desc",
    "value": "When charging to fire a pressure grenade, this trippy thing lets you shoot three Pressure Grenades instead!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_launcher_triple_flavor",
    "value": ""A thrice as nice surprise."",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb",
    "notes": " Norman Greenbaum song lyrics Spirit in the sky, pun on somebody being a mean spirit = bad and mean to people.",
    "value": "Sky Assailant",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_desc",
    "value": "Lets you shoot Pressure Bombs mid-air, so take to the skies and release your bombs from a safe distance!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_flavor",
    "value": ""Gonna recommend you to the mean spirit in the sky."",
  },
  {
    "key": "upgrades.upgrade_jackhammer",
    "value": "Jackhammer",
  },
  {
    "key": "upgrades.upgrade_jackhammer_desc",
    "value": "An exceptional digging tool for destroying hard materials but ineffective against enemies. Runs on water. Hold {indicator tool_jackhammer} for more power!",
  },
  {
    "key": "upgrades.upgrade_jackhammer_next_level_desc",
    "value": "Upgrade the Jackhammer to greatly increase it's digging efficiency.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_01",
    "notes": "Pun on Peter Gabriels song Sledgehammer",
    "value": "Gabriel's Sledge",
  },
  {
    "key": "upgrades.upgrade_jackhammer_01_desc",
    "notes": "Pun on Peter Gabriels song Sledgehammer - I want to be your sledgehammer",
    "value": ""It wants to be your Jackhammer!"",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02",
    "notes": "Titans=Mythological adversaries to the gods",
    "value": "Titan's Auger",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02_desc",
    "notes": "Removed MC Hammer reference",
    "value": ""Improved fuel efficiency means more bang for the same bucket of water."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03",
    "notes": "From Rocky 4 - Character Ivan Drago",
    "value": "The "Ivan Drago" Mark IV",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03_desc",
    "notes": "His signature phrase "I must break you"",
    "value": ""The tip has been reinforced with tungsten carbide for that I-must-break-you power."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04",
    "notes": "In norse mythology Mjölnir is the hammer of the mighty Thor",
    "value": "Mjölnir Drive",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04_desc",
    "value": ""Cosmos and chaos are calling."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water",
    "notes": "Jab - to punch NOT CURRENTLY USED",
    "value": "Dry Jabber",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_desc",
    "notes": "NOT CURRENTLY USED",
    "value": "Cuts water consumption in half.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_flavor",
    "notes": "NOT CURRENTLY USED",
    "value": ""Pretty hot, but it's a dry heat."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_windup",
    "value": "Synthetic Lubricant",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_windup_desc",
    "value": "Improves the Jackhammer's windup speed.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_windup_flavor",
    "notes": "Frankie goes to Hollywood song Relax",
    "value": ""Jacked up and ready to roll."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed",
    "notes": "Tribute to band KLF - also known as the Justified Ancients of Mu Mu",
    "value": "Ancient Justified Cylinder",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed_desc",
    "value": "Enhanced pneumatic cylinder. Allows for increased maximum operating speed, but at the cost of increased water usage.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_faster_maxspeed_flavor",
    "notes": "Their tune Last train to Trancentral",
    "value": ""Like riding the last train to Trancentral!"",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push",
    "value": "Slipstream Jet",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push_desc",
    "value": "Pulls you forward whenever the Jackhammer breaks through.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_push_flavor",
    "notes": "Pun on Dolly Parton and Kenny Rodgers song Islands in the stream lyrics",
    "value": ""Islands in the slipstream, that is what we are."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_shockwave",
    "notes": "DO NOT TRANSLATE, NOT CURRENTLY USED",
    "value": "Seismic Boom",
  },
  {
    "key": "upgrades.upgrade_jackhammer_shockwave_desc",
    "notes": "DO NOT TRANSLATE, NOT CURRENTLY USED",
    "value": "Makes your Jackhammer damage multiple tiles in a row.",
  },
  {
