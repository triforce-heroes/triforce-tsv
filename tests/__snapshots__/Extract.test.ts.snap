  {
    "key": "upgrades.upgrade_lamp",
    "value": "Linterna",
  },
  {
    "key": "upgrades.upgrade_broken_lamp",
    "value": "Linterna rota",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_desc",
    "notes": "Dorothy fell and broke her lamp.",
    "value": ""Alguien la ha roto al tropezarse. Necesita ser reparada o remplazada."",
  },
  {
    "key": "upgrades.upgrade_broken_lamp_next_level_desc",
    "value": "Repara la linterna para poder entrar en la mina.",
  },
  {
    "key": "upgrades.upgrade_lamp_desc",
    "value": "Ilumina tus alrededores. Consume combustible, el cual puedes repostar en el pueblo.",
  },
  {
    "key": "upgrades.upgrade_lamp_next_level_desc",
    "value": "Mejora tu linterna para reducir el consumo de combustible.",
  },
  {
    "key": "upgrades.upgrade_lamp_01",
    "notes": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    "value": "Linterna demacrada",
  },
  {
    "key": "upgrades.upgrade_lamp_01_desc",
    "value": ""Ya no está rota, pero poco más."",
  },
  {
    "key": "upgrades.upgrade_lamp_02",
    "value": "Linterna de principiante",
  },
  {
    "key": "upgrades.upgrade_lamp_02_desc",
    "value": ""Más económica en cuanto a consumo de combustible se refiere."",
  },
  {
    "key": "upgrades.upgrade_lamp_03",
    "value": "Linterna de carburo modificado",
  },
  {
    "key": "upgrades.upgrade_lamp_03_desc",
    "value": ""Tiene un mejor control de flujo de combustible, por lo que es más eficiente."",
  },
  {
    "key": "upgrades.upgrade_lamp_04",
    "value": "Polaris",
  },
  {
    "key": "upgrades.upgrade_lamp_04_desc",
    "notes": "Rudolf the Red nose reindeer – lyrics pun.",
    "value": ""Pero Navidad llegó, Santa Claus bajó y a Polaris eligió, por su singular brillo."",
  },
  {
    "key": "upgrades.upgrade_lamp_05",
    "value": "Farol",
  },
  {
    "key": "upgrades.upgrade_lamp_05_desc",
    "notes": "Green Lantern pun – Green lantern inaguration text.",
    "value": ""En el día más brillante, en la noche más oscura, ningún mineral escapará de mi vista."",
  },
  {
    "key": "upgrades.upgrade_lamp_06",
    "notes": "The Alexandrian Lighthouse",
    "value": "Luz de Faros",
  },
  {
    "key": "upgrades.upgrade_lamp_06_desc",
    "value": ""Reforzada con plomo fundido para soportar el paso del tiempo."",
  },
  {
    "key": "upgrades.upgrade_lamp_07",
