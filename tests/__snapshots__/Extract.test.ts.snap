  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius",
    "notes": "*NOT CURRENTLY USED*",
    "value": "Amplificador de presión",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius_desc",
    "notes": "*NOT CURRENTLY USED*",
    "value": "La onda explosiva de la bomba de presión daña a enemigos aún más lejos.",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_increased_radius_flavor",
    "notes": "*NOT CURRENTLY USED* Chris Cornell song wave Goodbye",
    "value": ""No quiero estar solo corriendo, todos directo al infierno, todos directo al infierno."",
