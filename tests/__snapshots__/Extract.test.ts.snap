exports[`extract(tests\\fixtures\\de_conversations.csv) function > matches snapshot > tests\\fixtures\\de_conversations.csv 1`] = `
[
  {
    "key": "conversation_yjp8nk_text",
    "metadata": {
      "notes": "Comes up when your inventory is full anyou try to pick up more ores.",
    },
    "value": "Hey, deine {format highlight}Tasche ist randvoll{format reset}, Doofy.",
  },
  {
    "key": "conversation_yjp8nk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hxfr0f_text",
    "metadata": {
      "notes": "*new* added "there"",
    },
    "value": "Na, hast du was tolles für mich?",
  },
  {
    "key": "conversation_hxfr0f_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_jh3i2m_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Hast du ein paar Steine gefunden, die du gegen ein bisschen Knete eintauschen möchtest?",
  },
  {
    "key": "conversation_jh3i2m_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_69vpc2_text",
    "metadata": {
      "notes": "*new* changed doll to kiddo. Moved this node",
    },
    "value": "Nun, hast du etwas nützliches, das du mit mir Handeln möchtest.",
  },
  {
    "key": "conversation_69vpc2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mi3myw_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Na los! Lass uns ein paar Geschäfte machen, du und ich.",
  },
  {
    "key": "conversation_mi3myw_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_2l670i_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Nun, was hast du diesmal für mich?",
  },
  {
    "key": "conversation_2l670i_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_89hare_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Jetzt zeig mal her, was du da unten gefunden hast.",
  },
  {
    "key": "conversation_89hare_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dfflv5_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Nun, ich nehme dir trotzdem jedes Erz aus den Klemmen.",
  },
  {
    "key": "conversation_dfflv5_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dvsj68_text",
    "value": "Bürgermeister Yonker mag ein Trottel sein, aber diesmal hat er recht. Das Erz muss fließen!",
  },
  {
    "key": "conversation_dvsj68_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gk3axq_text",
    "metadata": {
      "notes": "*format* Hair on steambots is made of metal.",
    },
    "value": "Er schwitzt wohl so sehr wegen der Sache, sein Haar rostet schon, weißt du?",
  },
  {
    "key": "conversation_gk3axq_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mosq62_text",
    "metadata": {
      "notes": "" clamps" is the equivavlent of hands, since they are robots.",
    },
    "value": "Und ich, ich nehme jedes Erz aus den Klemmen eines Minenarbeiters – egal wie, wo und wann.",
  },
  {
    "key": "conversation_mosq62_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_fnygz1_text",
    "metadata": {
      "notes": "*new* changed doll-face to kiddo.",
    },
    "value": "Gibt nichts Wichtigeres, als den Erznachschub am Fließen zu halten, Schätzelein.",
  },
  {
    "key": "conversation_fnygz1_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_7dsj17_text",
    "value": "Ich hörte, dass wir einen neuen Bot für die Arbeit in den Minen gefunden haben.",
  },
  {
    "key": "conversation_7dsj17_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mh0ja0_text",
    "value": "Ich bin auf der Suche nach einem Freund. Ruhiger Typ, trägt einen roten Schal.",
  },
  {
    "key": "conversation_mh0ja0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y6ys6p_text",
    "metadata": {
      "notes": "Real McCoy= the real deal.",
    },
    "value": "Den Bot kenne ich! Sah vielversprechend aus, aber verdammt war der eine Enttäuschung.",
  },
  {
    "key": "conversation_y6ys6p_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_0lzsu6_text",
    "value": "Ist nicht einmal zurück nach oben gekommen, weißt du?",
  },
  {
    "key": "conversation_0lzsu6_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_bhqgnn_text",
    "metadata": {
      "notes": "*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    },
    "value": "Ich Hoffe, du machst einen besseren Job, Schätzchen.",
  },
  {
    "key": "conversation_bhqgnn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_21a760_text",
    "metadata": {
      "notes": "Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    },
    "value": "Ich nehme mal an, du hast von den verstopften Röhren gehört.",
  },
  {
    "key": "conversation_21a760_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_oxkxen_text",
    "value": "Nun, ich tratsche ja nicht gern, aber ich hörte, der Bürgermeister hat sie geschlossen, um es seinen Bergarbeiterbot-Brüdern heimzuzahlen.",
  },
  {
    "key": "conversation_oxkxen_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_2zloko_text",
    "value": "Und apropos, Ich habe diese Trottel seit einer Weile nicht mehr gesehen.",
  },
  {
    "key": "conversation_2zloko_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xwxxg4_text",
    "value": "Ich war der Hoffnung, sie würden mal ein bisschen Gas geben, jetzt wo es durch dich Konkurrenz gibt.",
  },
  {
    "key": "conversation_xwxxg4_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gmenrv_text",
    "value": "Hätte es besser wissen sollen, als von diesen Spätzündern harte Arbeit zu erwarten.",
  },
  {
    "key": "conversation_gmenrv_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xkngbf_text",
    "metadata": {
      "notes": "mazumas= slang for money, please do translate.",
    },
    "value": "Wie auch immer, durch die Schließung der Röhren verliere ich einen Haufen Knete, weißt du?",
  },
  {
    "key": "conversation_xkngbf_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xfxkz8_text",
    "value": "Viele Reichtümer warten nur darauf, unter diesen Schichten aus Ziegeln und Mörtel gefunden zu werden.",
  },
  {
    "key": "conversation_xfxkz8_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_op5xlx_text",
    "value": "Wenn du auf irgendwelche Schnapsis treffen solltest, hau sie um, bevor sie das Gleiche mit dir machen.",
  },
  {
    "key": "conversation_op5xlx_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_whma58_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Von dem, was ich gehört habe, sollen sie die ganze Zeit vom Mondsaft benebelt ... und auf der Suche nach Streit sein.",
  },
  {
    "key": "conversation_whma58_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_t5mwlu_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Von der Brühe kriegen sie nicht genug. Sie macht sie stärker, aber sie lässt sie auch vertrotteln.",
  },
  {
    "key": "conversation_t5mwlu_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_649tjr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Er ist außerdem hoch ätzend, also wirst du wohl kaum darin baden wollen.",
  },
  {
    "key": "conversation_649tjr_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_03e7vh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Vielleicht hast du es ja gehört, aber die reiche Professorin da oben ist total verrückt geworden.",
  },
  {
    "key": "conversation_03e7vh_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_u2ersk_text",
    "value": "Seitdem ihr Haus während eines der ersten Erdbeben eingestürzt ist, hat sie den Verstand verloren.",
  },
  {
    "key": "conversation_u2ersk_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_h9iaiy_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Jetzt ist sie dabei, mit ihren ganzen geerbten Moneten {format emph}eine Rakete zu bauen{format reset}.",
  },
  {
    "key": "conversation_h9iaiy_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3jgp0a_text",
    "value": "Ich habe gehört, dass sie sogar mit einem Netzwerk von Raketenexperten in Kontakt stehe.",
  },
  {
    "key": "conversation_3jgp0a_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_9mc50k_text",
    "value": "Sie bauen die Dinger überall auf dem Planeten.",
  },
  {
    "key": "conversation_9mc50k_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_bsxzro_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Sag mal, hast du dir die Zeit genommen, alle Höhlen zu durchforsten, an denen du vorbeigekommen bist, Schätzchen?",
  },
  {
    "key": "conversation_bsxzro_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dz2y8u_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Sie sind oft um einiges hartgesottener, als der Rest der Mine.",
  },
  {
    "key": "conversation_dz2y8u_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3g80ch_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Aber mit hoher Wahrscheinlichkeit findest du in ihnen ein paar wertvolle Schätze.",
  },
  {
    "key": "conversation_3g80ch_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_nmjdda_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Sobald du etwas in einer Höhle gefunden hast, wird es auf deiner Karte {image cave_small} markiert. Dann musst du nicht blind herumgraben.",
  },
  {
    "key": "conversation_nmjdda_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_u3ck3c_text",
    "value": "Wer hätte geglaubt, dass diese durchgeknallten Kultisten so viele Reichtümer unter der alten Ruine hatten.",
  },
  {
    "key": "conversation_u3ck3c_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_zh09qm_text",
    "value": "Wir hätten dort schon vor Jahren graben sollen!",
  },
  {
    "key": "conversation_zh09qm_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_g3jyqr_text",
    "metadata": {
      "notes": "*format*'",
    },
    "value": "Klar, ich hörte, dass die Ruinen von einem verrückten Kult besetzt sind, der dem Weltende huldigt.",
  },
  {
    "key": "conversation_g3jyqr_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_m4g0mn_text",
    "value": "Das geht mich nichts an, und ich stecke meine Nase nicht gerne in die Angelegenheiten anderer Bots, weißt du?",
  },
  {
    "key": "conversation_m4g0mn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_figdnq_text",
    "value": "Schau dir diese Stadt an. In meiner Jugend kam ich hier her. Ich versuchte, dem Hafenarbeiterleben zu entkommen.",
  },
  {
    "key": "conversation_figdnq_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_saxa80_text",
    "value": "Die Stadt war damals viel kleiner, aber randvoll mit Potential, weißt du?",
  },
  {
    "key": "conversation_saxa80_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_c0haij_text",
    "value": "Ich konnte hier ein blühendes Geschäft aufbauen, und dazu brauchte ich nur den richtigen Mumm.",
  },
  {
    "key": "conversation_c0haij_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3qiyya_text",
    "metadata": {
      "notes": "*new* changed doll to kid",
    },
    "value": "Du musst dich in die unerforschten Teile dieser Welt wagen, Schätzchen.",
  },
  {
    "key": "conversation_3qiyya_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_281tok_text",
    "value": "Das mag riskant sein, aber so kommst du an den dicken Gewinn.",
  },
  {
    "key": "conversation_281tok_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_ef7tr2_text",
    "value": "Ich habe von diesem merkwürdigen, unnatürlichen Dschungel gehört, der in der Mine wuchert.",
  },
  {
    "key": "conversation_ef7tr2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_amxf2l_text",
    "value": "Natürlich hält dich so etwas nicht auf.",
  },
  {
    "key": "conversation_amxf2l_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mp7r9y_text",
    "value": "Ich mache mir nur Sorgen, dass er die Bergarbeiter, die immer gleich die Hose voll haben, davonjagt.",
  },
  {
    "key": "conversation_mp7r9y_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_fmy8mc_text",
    "value": "Professorin Sherman macht ihre Rakete klar zum Abschuss.",
  },
  {
    "key": "conversation_fmy8mc_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mxjgvx_text",
    "value": "Ich hielt sie zuerst für einen Wirrkopf, aber jetzt glaube ich, dass sie die richte Idee hat, weißt du?",
  },
  {
    "key": "conversation_mxjgvx_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gd4ef6_text",
    "value": "Der Weltraum ist gänzlich unerforscht und voll mit neuen Geschäftsmöglichkeiten.",
  },
  {
    "key": "conversation_gd4ef6_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_wr4wq2_text",
    "metadata": {
      "notes": "*new* changed doll to kiddo",
    },
    "value": "Ich habe es schon mal geschafft, ein Leben aus dem Nichts aufzubauen, Schätzchen.",
  },
  {
    "key": "conversation_wr4wq2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mkud7m_text",
    "value": "Wenn überhaupt bin ich jetzt vorbereiteter, als ich es in meiner Jugend war.",
  },
  {
    "key": "conversation_mkud7m_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_08cc91_text",
    "metadata": {
      "notes": "*new* moved it to the bottom",
    },
    "value": "Komm einfach vorbei, wenn du Erz zu verkaufen hast, okay?",
  },
  {
    "key": "conversation_08cc91_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_07qv1j_text",
    "value": "Mein nichtsnutziger Sohn hat keine Ahnung, was er da tut.",
  },
  {
    "key": "conversation_07qv1j_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vx6mcl_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wir brauchen fähige Leute da unten, die herausfinden, was diese verflixten Erdbeben verursacht!",
  },
  {
    "key": "conversation_vx6mcl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hlqiyo_text",
    "value": "Ich weiß, wie sich eine tektonische Platte anfühlt, wenn sie sich bewegt. Potz Blitz! So sicher nicht, Herzchen!",
  },
  {
    "key": "conversation_hlqiyo_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_q4ltpg_text",
    "value": "Wir brauchen jemanden mit Verstand und Schmackes, der in die Mine herabsteigt.",
  },
  {
    "key": "conversation_q4ltpg_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8w93yl_text",
    "value": "Ich arbeite in den Minen seit einer Ewigkeit, Herzchen ..., aber ich habe noch nie etwas wie diese Erdbeben gespürt.",
  },
  {
    "key": "conversation_8w93yl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ibhbb2_text",
    "value": "Ich würde ja selber nachsehen, wenn ich könnte, aber du siehst ja ... Da ist nicht viel Minenarbeiter übrig.",
  },
  {
    "key": "conversation_ibhbb2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ffq3ty_text",
    "value": "Was ist dir zugestoßen?",
  },
  {
    "key": "conversation_ffq3ty_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_9hmzci_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Oh! War es ein schrecklicher Minenunfall?",
  },
  {
    "key": "conversation_9hmzci_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uy4syk_text",
    "value": "Nee! Ich habe eine Menge Teile aufgegeben, um meine verdammten Jungs zu machen. Der Größte Fehler meines Lebens ...",
  },
  {
    "key": "conversation_uy4syk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_g3ij4k_text",
    "metadata": {
      "notes": "*new* changed format from emph to singsong",
    },
    "value": "{format singsong}Laaangweilig!{format reset}",
  },
  {
    "key": "conversation_g3ij4k_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xxgpup_text",
    "value": "Wenn ich könnte, wäre ich ratzfatz in diesen vermaledetein Tunneln!",
  },
  {
    "key": "conversation_xxgpup_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dgq9o3_text",
    "value": "Wenn du vor hast, tief nach unten zu gehen, solltest du besser {format highlight}das Licht reparieren{format reset}.",
  },
  {
    "key": "conversation_dgq9o3_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_o8vje6_text",
    "value": "Ist die Mine wirklich so gefährlich?",
  },
  {
    "key": "conversation_o8vje6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0c28a8_text",
    "value": "Naja, da gibt es ein paar fiese Kriecher, aber wenigstens habe ich lange keine verfluchten Schnapsis gesehen.",
  },
  {
    "key": "conversation_0c28a8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tt1za6_text",
    "value": "Meine Jungs waren damit beschäftigt, den Wall zu flicken, um diese fleischlichen Zweibeiner fernzuhalten.",
  },
  {
    "key": "conversation_tt1za6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_n71xfs_text",
    "value": "Ich war noch ein junger Mädchenbot als die Alkkriege endeten, aber ich erinnere mich noch gut an die schlechten Teile.",
  },
  {
    "key": "conversation_n71xfs_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u3tho1_text",
    "value": "Jedenfalls ist es immer gut, dort unten vorbereitet zu sein, Herzchen.",
  },
  {
    "key": "conversation_u3tho1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8xtyi1_text",
    "value": "{format highlight}Benutze die Werkbank{format reset} neben der Mine, um das Licht zu reparieren. Das heißt, wenn du dir die Teile leisten kannst ...",
  },
  {
    "key": "conversation_8xtyi1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_y2vq9y_text",
    "value": "Potz Blitz! So bist du definitiv bereit, {format highlight}die Mine zu betreten{format reset}, Herzchen.",
  },
  {
    "key": "conversation_y2vq9y_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_st3zju_text",
    "value": "War in letzter Zeit jemand im Rotfelsgang?",
  },
  {
    "key": "conversation_st3zju_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0zamqc_text",
    "value": "Nicht seit diese verfluchten Röhren nicht mehr funktionieren, Herzchen.",
  },
  {
    "key": "conversation_0zamqc_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_5atg04_text",
    "value": "Du wirst dort hindurch müssen, wenn du darüber nachdenkst, die ganze Mine zu erkunden.",
  },
  {
    "key": "conversation_5atg04_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_caroq1_text",
    "value": "Ich sollte wohl zuerst {format highlight}die Röhre freimachen{format reset}.",
  },
  {
    "key": "conversation_caroq1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kq5k2e_text",
    "value": "Denke daran, dass der Dreck weiter unten immer zäher wird, du wirst also eine Ausrüstung in Schuss halten müssen.",
  },
  {
    "key": "conversation_kq5k2e_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_yo8vom_text",
    "value": "Rotfels ist der einzige Weg, tiefer in die Mine zu gelangen, zumindest solange das verdammte Röhrensystem außer Betrieb ist.",
  },
  {
    "key": "conversation_yo8vom_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_sxlsip_text",
    "value": "Ich hoffe doch, dass ich den Rotfelsgang mit Sprengstoff freimachen kann.",
  },
  {
    "key": "conversation_sxlsip_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2e9pz1_text",
    "value": "Sollte klappen. Ich musste das schon mehr als ein paar verdammte Male selbst tun.",
  },
  {
    "key": "conversation_2e9pz1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_wkl33e_text",
    "value": "Begib dich erstmal runter zur Sprengladungsstation und {format highlight}hole den Sprengstoff{format reset}.",
  },
  {
    "key": "conversation_wkl33e_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_xtf9h2_text",
    "value": "Sollten wir nicht froh sein, dass der Gang überhaupt noch existiert? Ich glaube nicht, dass Sprengstoffe in unserer Versicherungspolice stehen.",
  },
  {
    "key": "conversation_xtf9h2_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_5jzc1m_text",
    "value": "Der Rotfelsgang ist der einzige Weg, tiefer in die Mine zu gelangen, jetzt wo das Röhrensystem außer Betrieb ist.",
  },
  {
    "key": "conversation_5jzc1m_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3vmqnk_text",
    "value": "Ich hoffe, du kommst da unten gut voran, Herzchen.",
  },
  {
    "key": "conversation_3vmqnk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u6rmdw_text",
    "value": "Professorin Sherman hat mir mit diesen schrecklichen Erdbeben Angst gemacht.",
  },
  {
    "key": "conversation_u6rmdw_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_nxlgy6_text",
    "value": "Sie ist da oben und gibt all ihr Geld für den Bau dieser Rakete aus.",
  },
  {
    "key": "conversation_nxlgy6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ginz3u_text",
    "value": "Sie ist verdammt schlau, und ich ziehe daraus, dass sie an einem Ausstiegsplan arbeitet.",
  },
  {
    "key": "conversation_ginz3u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jkfreb_text",
    "value": "Ich wünschte, mein dämlicher Sohn hätte so viel Verstand, ihr wenigstens für zwei Sekunden zuzuhören.",
  },
  {
    "key": "conversation_jkfreb_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3pntbk_text",
    "value": "Sieh an! Du bist einfach ein echter Minenarbeiter!",
  },
  {
    "key": "conversation_3pntbk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ebwh66_text",
    "value": "Jetzt geh einfach zurück zum Rotfelsgang, und verpasse diesem Gestein die volle Ladung.",
  },
  {
    "key": "conversation_ebwh66_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dayt2l_text",
    "value": "Rotfels hat es mit einer gut platzierten Sprengladung richtig freigeblasen.",
  },
  {
    "key": "conversation_dayt2l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_5ji97r_text",
    "value": "Ja, abgesehen von all den Niederbrüchen, ist es wirkliche eine stabile Konstruktion.",
  },
  {
    "key": "conversation_5ji97r_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_m6zdrd_text",
    "value": "Ich bin nur froh, dass er noch steht.",
  },
  {
    "key": "conversation_m6zdrd_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_k7klvq_text",
    "value": "Du wirst deine Ausrüstung auf der Höhe halten müssen, um mit dem Dreck in diesen Tiefen klarzukommen.",
  },
  {
    "key": "conversation_k7klvq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dspvhm_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Und hey, vergiss nicht, mehr von diesen kostbaren Steinen zurückzubringen.",
  },
  {
    "key": "conversation_dspvhm_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_sl7olj_text",
    "value": "Verwende etwas von dem Geld, um deine Ausrüstung aufzuwerten. Weiter unten macht sich das bezahlt.",
  },
  {
    "key": "conversation_sl7olj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x0wxp1_text",
    "value": "I muss einen Weg finden, zur Maurerstation zu kommen.",
  },
  {
    "key": "conversation_x0wxp1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_63gsgh_text",
    "value": "Dort unten gibt es Spalten und Gänge aller Art, glaube mir!",
  },
  {
    "key": "conversation_63gsgh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_qp9quj_text",
    "value": "Meine Brüder sind talentiert darin, sie zu finden ... und sich tagelang zu verlaufen.",
  },
  {
    "key": "conversation_qp9quj_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_x7yuib_text",
    "value": "Diese Fleischsack-Schnapsis sind auch dafür bekannt, durchzubrechen und Chaos anzurichten.",
  },
  {
    "key": "conversation_x7yuib_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hc3b2x_text",
    "value": "Erkunde die Mine in der Nähe des Schnapsiwalls. Ich bin mir sicher, {format highlight}du findest die Bergbaustation{format reset}, Herzchen.",
  },
  {
    "key": "conversation_hc3b2x_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_gducoe_text",
    "value": "Schon so einem verfluchten Schnapsi begegnet, Herzchen? Sie haben lange keinen Ärger gemacht.",
  },
  {
    "key": "conversation_gducoe_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_yr3kie_text",
    "value": "Mir ist aufgefallen, dass sie auch unter Tumbleton, meiner Heimatstadt, verschwunden sind.",
  },
  {
    "key": "conversation_yr3kie_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_owuynx_text",
    "value": "Also ist das überall so? Ich habe mindestens seit ein paar Monaten keinen mehr gesehen.",
  },
  {
    "key": "conversation_owuynx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3h8ujv_text",
    "value": "Bald nachdem Rusty das technologische Ungetüm, Vectron, zerstörte, sind sie nur noch selten in Erscheinung getreten.",
  },
  {
    "key": "conversation_3h8ujv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ezzezr_text",
    "value": "Darüber weiß ich wahrlich nicht viel, aber mit Schnapsis kenne ich mich aus.",
  },
  {
    "key": "conversation_ezzezr_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dpbib8_text",
    "value": "Gewöhnlich fanden sie immer einen Weg, durch den Wall zu kommen, und uns Minenarbeitern Ärger zu bereiten.",
  },
  {
    "key": "conversation_dpbib8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3c3lpm_text",
    "value": "Vielleicht bereiten ihnen diese Beben auch Sorgen? Verlassen das sinkende Schiff, wie die Ratten!",
  },
  {
    "key": "conversation_3c3lpm_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tcvt6a_text",
    "value": "Ich weiß nicht, ob es ein gutes oder ein schlechtes Zeichen ist, dass die Schnapsis so ruhig sind.",
  },
  {
    "key": "conversation_tcvt6a_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_67vh5i_text",
    "value": "Hey, ich habe die Schnapsis gefunden! Sie haben eine kleine, versteckte Stadt in der Mine errichtet.",
  },
  {
    "key": "conversation_67vh5i_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_iu5kqd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Zum Kuckuck! Da würde ich keinen Fuß hineinsetzen. Viel zu unsicher!",
  },
  {
    "key": "conversation_iu5kqd_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vhdww6_text",
    "value": "So böse sahen sie eigentlich nicht aus. Nicht so wie die, denen ich zuvor begegnet bin.",
  },
  {
    "key": "conversation_vhdww6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cbcmjx_text",
    "value": "Einer Sache bin ich mir verdammt sicher: Traue niemals einem Schnapsi!",
  },
  {
    "key": "conversation_cbcmjx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_0glm7l_text",
    "value": "Wenn du weißt, was gut für dich ist, hältst du dich lieber von dieser Schnapsi-Stadt fern!",
  },
  {
    "key": "conversation_0glm7l_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_umbt7u_text",
    "value": "Beim Tempel herumzugraben, kann verdammt gefährlich sein, aber dort befinden sich noch viele Kostbarkeiten.",
  },
  {
    "key": "conversation_umbt7u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_c5baff_text",
    "value": "Hey, das klingt vielversprechend! Du solltest auf jeden Fall dorthin und ein paar davon einsammeln.",
  },
  {
    "key": "conversation_c5baff_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_r8rlnp_text",
    "value": "Zum Henker! Du bräuchtest schon ein wenig Schmackes, um diese Ruinen zu betreten.",
  },
  {
    "key": "conversation_r8rlnp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_m8hqwy_text",
    "value": "Nicht einmal seine Brüder sind verrückt genug, {format highlight}den Tempel zu betreten{format reset}, der sich hinter den Windigen Ebenen befindet.",
  },
  {
    "key": "conversation_m8hqwy_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_bvz9xj_text",
    "value": "Da gibt es so einen verrückten Kult von Weltuntergangspredigern, die ihn für sich beansprucht haben.",
  },
  {
    "key": "conversation_bvz9xj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_fj6bw8_text",
    "value": "Sie haben selbst die Ruinen in der Westwüste eingenommen.",
  },
  {
    "key": "conversation_fj6bw8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u26tuh_text",
    "value": "Ich wette dieser durchgeknallte alte Ronald gibt immer noch den Ton an. War mal ein netter Kerl, aber dieser religiöse Quatsch hat ihm das Hirn vernebelt.",
  },
  {
    "key": "conversation_u26tuh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_gr738j_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Der Tempel hinter den Windigen Ebenen mag voller Reichtümer sein, aber er ist auch ein verdammt gefährlicher Ort zum Graben.",
  },
  {
    "key": "conversation_gr738j_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_grrmq6_text",
    "value": "Sieht so aus, als würdest du dich richtig reinknien müssen, Herzchen!",
  },
  {
    "key": "conversation_grrmq6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_335kyr_text",
    "value": "Du findest vielleicht Spuren alter Zivilisationen dort unten. So wie diese alten Maschinen in den Bergbaustationen.",
  },
  {
    "key": "conversation_335kyr_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_2jepw2_text",
    "value": "Sie waren schon dort unten, bevor es mich überhaupt gegeben hat.",
  },
  {
    "key": "conversation_2jepw2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_mv0s6q_text",
    "value": "Ein paar schlaue Bots sind der Meinung, die Schnapsis hätten sie gebaut.",
  },
  {
    "key": "conversation_mv0s6q_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vxki0p_text",
    "value": "Diese Bots klingen für mich nicht besonders schlau. Nennen sich bestimmt auch noch "Experten".",
  },
  {
    "key": "conversation_vxki0p_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ysj9vo_text",
    "value": "Ich bin mir unsicher, ob es das Risiko wert ist, so tief unter Schnapsbergen zu graben. Wer weiß, was du dort finden wirst!",
  },
  {
    "key": "conversation_ysj9vo_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_uj1muo_text",
    "value": "Für mich gibt es eine Menge zu graben, wenn ich diese Erdbeben stoppen will.",
  },
  {
    "key": "conversation_uj1muo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ykczsp_text",
    "value": "Die Professorin hat etwas von einem Dschungel erzählt, der sich überall in der Mine ausbreitet.",
  },
  {
    "key": "conversation_ykczsp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_z8gocf_text",
    "value": "Zum Henker! Das klingt gar nicht gut.",
  },
  {
    "key": "conversation_z8gocf_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dzwjvq_text",
    "value": "Wie soll ein Bot umgeben von solchen Gefahren graben ... Wie werden meine verdammten Söhne damit klarkommen?",
  },
  {
    "key": "conversation_dzwjvq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x3v93r_text",
    "value": "Ich weiß nicht, ob du es gemerkt hast, aber die sind wirklich verdammt dämlich.",
  },
  {
    "key": "conversation_x3v93r_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jmwahi_text",
    "value": "Ich schätze, wir werden uns einfach um einen Platz an Bord der Rakete kümmern müssen.",
  },
  {
    "key": "conversation_jmwahi_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8augkl_text",
    "value": "Meine Jungs sind absolute Taugenichtse, das ist mir klar, aber sie sind noch immer meine Teile und Rädchen.",
  },
  {
    "key": "conversation_8augkl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_9v0sjx_text",
    "value": "Ich schätze, ich werde einfach 5 Tickets für den Flug in den Weltraum besorgen müssen?",
  },
  {
    "key": "conversation_9v0sjx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_p75xau_text",
    "value": "Nett von dir, dem Geschwafel eines alten Bots zuzuhören. Deine Eltern müssen stolz auf dich sein!",
  },
  {
    "key": "conversation_p75xau_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8hjn65_text",
    "value": "Nicht so wie meine Söhne. Verdammt nutzlos, das ganze Pack.",
  },
  {
    "key": "conversation_8hjn65_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x6q3po_text",
    "value": "Die meisten sind damit beschäftigt, in der Mine zu "arbeiten". Und dann gibt es den verdammten Politiker dort.",
  },
  {
    "key": "conversation_x6q3po_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8tssip_text",
    "value": "Schön, jemanden in den Tunneln zu haben, der weiß, was er tut!",
  },
  {
    "key": "conversation_8tssip_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_royiqq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oh je, oh je! Das war ein ziemlich großes {format nervous}Erdbeben{format reset}.",
  },
  {
    "key": "conversation_royiqq_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_0z0jlu_text",
    "value": "Meine Güte! Du siehst mir aus wie ein Kleinstadtbot, genau wie ich! {format singsong}Wie wunderbar!{format reset}",
  },
  {
    "key": "conversation_0z0jlu_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_i3c2ki_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich habe mich in letzter Zeit so einsam gefühlt. Wie ein echter Außenseiter.",
  },
  {
    "key": "conversation_i3c2ki_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_fnv0dz_text",
    "value": "Ich dachte, es wäre nur ein Lüftchen vom Plumpsklo, aber es ist dieser Außenseitergeruch ...",
  },
  {
    "key": "conversation_fnv0dz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_q58pva_text",
    "value": "Das leuchtend-glitzernde Ding hat recht. Ich bin für das Großstadtleben nicht gemacht.",
  },
  {
    "key": "conversation_q58pva_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_r68qcd_text",
    "value": "Könntest du zur Abwechslung mal versuchen, nett zu sein Fen? Vielleicht gefällt es dir!",
  },
  {
    "key": "conversation_r68qcd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6c81lb_text",
    "value": "Das bezweifle ich.",
  },
  {
    "key": "conversation_6c81lb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qy4k1b_text",
    "value": "Ich sollte wohl einfach zur Farm zurückkehren.",
  },
  {
    "key": "conversation_qy4k1b_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_q27f56_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Nochmals hallo, Kleinstadtbot-Kollegin!",
  },
  {
    "key": "conversation_q27f56_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_bfqhtj_text",
    "value": "Es gibt viele Beschwerden über unseren armen Bürgermeister.",
  },
  {
    "key": "conversation_bfqhtj_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_xpriw7_text",
    "value": "Für mich sieht es so aus, als wüsste er, wovon er spricht.",
  },
  {
    "key": "conversation_xpriw7_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_kqxpuz_text",
    "value": "Immerhin ist er in der Großstadt aufgewachsen ... er muss es ja gewohnt sein, wie die Dinge hier laufen.",
  },
  {
    "key": "conversation_kqxpuz_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_tdhokx_text",
    "value": "Wenn ich mich an so einem vollgestopften Ort um Dinge kümmern müsste, wäre ich aufgeschmissen.",
  },
  {
    "key": "conversation_tdhokx_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_0k5x6v_text",
    "value": "Ich bin mir sicher, der Bürgermeister weiß, was er tut.",
  },
  {
    "key": "conversation_0k5x6v_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_unbiry_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hallo nochmal, Freundin!",
  },
  {
    "key": "conversation_unbiry_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_fdlynd_text",
    "value": "Es ist nicht einfach, hier jemanden kennenzulernen.",
  },
  {
    "key": "conversation_fdlynd_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_7ymnmr_text",
    "value": "Nicht so wie zu Hause, wo man einfach jeden vom Tag seiner Montage an kennt.",
  },
  {
    "key": "conversation_7ymnmr_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_enl4xa_text",
    "value": "Diese Stadt folgt ihrem eigenen Takt. Die Leute sind einfach zu beschäftigt, um zu plaudern. Selbst zu beschäftigt, nett zueinander zu sein!",
  },
  {
    "key": "conversation_enl4xa_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_aptgjz_text",
    "value": "Oder es liegt einfach an dir.",
  },
  {
    "key": "conversation_aptgjz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cqddcg_text",
    "value": "Komm schon Fen, sei nett!",
  },
  {
    "key": "conversation_cqddcg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3avufg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hm, manchmal frage ich mich, ob sie es überhaupt merken würden, wenn jemand verschwindet.",
  },
  {
    "key": "conversation_3avufg_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_bibnd6_text",
    "value": "So wie ich es mitbekommen habe, verirrt sich hier ständig jemand.",
  },
  {
    "key": "conversation_bibnd6_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_l5r7sq_text",
    "value": "Zumindest schätzen wir auf dem Land Freundschaft und Loyalität.",
  },
  {
    "key": "conversation_l5r7sq_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_axrc0a_text",
    "value": "Ich wusste, dass du ein Kleinstadtbot bist, als ich dich das erste mal traf!",
  },
  {
    "key": "conversation_axrc0a_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_4ure1i_text",
    "value": "Hast du mit der verrückten Professorin gesprochen? Sie baut diese Rakete etwas oberhalb der Stadt.",
  },
  {
    "key": "conversation_4ure1i_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_qahysn_text",
    "value": "Sie hat wohl eine Menge Geld geerbt, aber gibt jetzt alles für dieses Raumschiff aus.",
  },
  {
    "key": "conversation_qahysn_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_5923lp_text",
    "value": "So eine Verschwendung!",
  },
  {
    "key": "conversation_5923lp_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_t94xdc_text",
    "value": "In meinem Dorf hatten wir auch so jemanden, der eine Rakete baute.",
  },
  {
    "key": "conversation_t94xdc_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_x71xpu_text",
    "value": "Muss wohl in Mode sein, denkst du nicht auch?",
  },
  {
    "key": "conversation_x71xpu_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_q3y399_text",
    "value": "Ich wette die hier ist die raffinierteste. Die aus meinem Dorf war nur ein umgebautes Silo.",
  },
  {
    "key": "conversation_q3y399_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_12pu8k_text",
    "value": "Stell dir nur vor, wie diese verrückten, schlauen Bots überall auf dem Globus ihre eigenen Raketen bauen. Wenn ich drüber nachdenke, muss ich {format laugh}schmunzeln{format reset}.",
  },
  {
    "key": "conversation_12pu8k_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_e4onuf_text",
    "value": "Du siehst müde aus.",
  },
  {
    "key": "conversation_e4onuf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ob0wy7_text",
    "value": "Hier ist einfach zu viel los. Ich kann da nicht mithalten!",
  },
  {
    "key": "conversation_ob0wy7_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_54qfjg_text",
    "value": "Ich habe mich entschieden. Ich werde in mein Dorf zurückkehren.",
  },
  {
    "key": "conversation_54qfjg_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_i33o07_text",
    "metadata": {
      "notes": "Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    },
    "value": "Am spannendsten wird es da noch, wenn Papi Pumpe das Wasser aus dem Brunnen holt.",
  },
  {
    "key": "conversation_i33o07_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_7bo632_text",
    "value": "Ich bin für diesen Stress nicht geschaffen. Vielleicht lasse ich mich irgendwo mit einem Dutzend Dampfkatzen nieder.",
  },
  {
    "key": "conversation_7bo632_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_jcodma_text",
    "value": "Vielleicht werde ich ja sogar eine ernsthafte Konkurrenz für Schraubenschlüssel Susi während des Rädchen-schmieren-Wettkampfs sein.",
  },
  {
    "key": "conversation_jcodma_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_rjax07_text",
    "value": "Es wäre einfach {format singsong}großartig{format reset}, diesen pedantischen Bot, Schraubenschlüssel Susi zu besiegen.",
  },
  {
    "key": "conversation_rjax07_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_kzt23q_text",
    "value": "Ich sollte wohl einfach zur Farm zurückkehren.",
  },
  {
    "key": "conversation_kzt23q_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_vyjpoj_text",
    "metadata": {
      "notes": "*format* There is a crashed elevator just next to them.",
    },
    "value": "Durch das Erdbeben ist der Lift abgestürzt!",
  },
  {
    "key": "conversation_vyjpoj_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ctbic6_text",
    "metadata": {
      "notes": "*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    },
    "value": "{format singsong}Ooh!{format reset} Wurde jemand ekelhaft zerquetscht?",
  },
  {
    "key": "conversation_ctbic6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_m9r7tc_text",
    "metadata": {
      "notes": "*new* changed horrible to terrible and emphasised "thing"",
    },
    "value": "Um {format nervous}Himmels willen!{format reset} Was für ein grausames {format emph}Ding{format reset} bist du?",
  },
  {
    "key": "conversation_m9r7tc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_045qay_text",
    "metadata": {
      "notes": "She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    },
    "value": "Hey, ich bin {format emph}kein{format reset} Ding! Wenn ich noch mein Totem hätte, würde ich dich jetzt abknallen!",
  },
  {
    "key": "conversation_045qay_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fccwnq_text",
    "value": "Nun, was auch immer du bist, du solltest auf dein Benehmen achten.",
  },
  {
    "key": "conversation_fccwnq_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_8oqmau_text",
    "value": "Entschuldigen Sie bitte, Fen hat noch keine soziale Kompetenz entwickelt.",
  },
  {
    "key": "conversation_8oqmau_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_acx7g7_text",
    "value": "Wie lange soll ich hier noch auf jemanden warten, der endlich diesen Lift repariert?",
  },
  {
    "key": "conversation_acx7g7_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_matp87_text",
    "value": "Hier unten in der Wüste herumzustehen, ist einem Bot meines Formats nicht würdig.",
  },
  {
    "key": "conversation_matp87_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_eb6uiw_text",
    "value": "Hier unten in der Wüste herumzustehen, ist einem Bot meines Formats nicht würdig.",
  },
  {
    "key": "conversation_eb6uiw_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_c7c7g6_text",
    "value": "Unser Bürgermeister mag nicht von bester Fertigungsqualität sein, aber es fehlt ihm nicht gänzlich an Finesse.",
  },
  {
    "key": "conversation_c7c7g6_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_mdqfxx_text",
    "metadata": {
      "notes": "This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    },
    "value": "Es kommt nicht selten vor, dass man die schlichte Summe seiner Teile übertrifft.",
  },
  {
    "key": "conversation_mdqfxx_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_uynh2z_text",
    "value": "Ich muss ihm in seinen Entscheidungen vertrauen, und das Gleiche gilt für alle anderen auch.",
  },
  {
    "key": "conversation_uynh2z_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_if7w3g_text",
    "value": "Offensichtlich muss man sich um diese Erdbeben keine Sorgen machen. Die Wartung des Lifts war mit Sicherheit so oder so überfällig.",
  },
  {
    "key": "conversation_if7w3g_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_540zgf_text",
    "value": "Ich hoffe doch, dass sie bald jemanden schicken, der diese Vorrichtung repariert. Ich habe {format emph}Besseres{format reset} zu tun, als hier meine Zeit zu vergeuden.",
  },
  {
    "key": "conversation_540zgf_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_t8w29c_text",
    "value": "Also ... der Lift ist immer noch nicht repariert, hm?",
  },
  {
    "key": "conversation_t8w29c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2y8m3i_text",
    "value": "Offensichtlich nicht.",
  },
  {
    "key": "conversation_2y8m3i_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_sbn8ap_text",
    "value": "Zwar schickt sich dieses Fleckchen nicht für einen Ladybot wie mich, aber wenigstens ist es hier ruhig.",
  },
  {
    "key": "conversation_sbn8ap_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_x0xmdc_text",
    "value": "Diese absurde Professorin nebenan hämmert Tag und Nacht an ihrer Raketen herum!",
  },
  {
    "key": "conversation_x0xmdc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_9hvgg5_text",
    "metadata": {
      "notes": ""Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    },
    "value": "Warum marschierst du nicht einfach die Klippe hinauf?",
  },
  {
    "key": "conversation_9hvgg5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b63bbp_text",
    "value": "Pfft! Eine Lady klettert nicht.",
  },
  {
    "key": "conversation_b63bbp_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ff5hlh_text",
    "value": "Eine Lady klettert nicht. Ich werde hier warten bis der Lift repariert ist oder mich jemand trägt. Nur das ziemt sich mir.",
  },
  {
    "key": "conversation_ff5hlh_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_3lbfex_text",
    "value": "Immer noch hier, hm?",
  },
  {
    "key": "conversation_3lbfex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ykf245_text",
    "value": "Ja, ich bin {format emph}immer noch hier{format reset}. Und ja, der Lift ist {format emph}immer noch kaputt{format reset}. Kein Grund schnippisch zu werden.",
  },
  {
    "key": "conversation_ykf245_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_c50t6h_text",
    "value": "Aber das ist ziemlich lächerlich! Jemand so wichtiges wie ich muss doch unter den High-Society-Bots vermisst werden.",
  },
  {
    "key": "conversation_c50t6h_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_8rvp8u_text",
    "value": "Der Bürgermeister hat dafür besser eine sehr gute Erklärung.",
  },
  {
    "key": "conversation_8rvp8u_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_wpxim7_text",
    "value": "Ich bin mir sicher, dass ich zutiefst vermisst werde. Ich bin ziemlich wichtig, weißt du.",
  },
  {
    "key": "conversation_wpxim7_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_gtukg8_text",
    "value": "Du gehst irgendwie nirgendwo hin, oder?",
  },
  {
    "key": "conversation_gtukg8_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cudej5_text",
    "value": "Nun, ich musste einem neuen Hobby frönen.",
  },
  {
    "key": "conversation_cudej5_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_h438q0_text",
    "value": "Ich zähle alle Pilger, die auf ihrem Weg zu diesem unflätigen Tempel im Westen hier hindurchkommen.",
  },
  {
    "key": "conversation_h438q0_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_e0mg3i_text",
    "value": "Unter normalen Bedingungen, würde ich sie selbstverständlich völlig ignorieren, aber ich bin mehr als gelangweilt.",
  },
  {
    "key": "conversation_e0mg3i_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_x9lbaf_text",
    "value": "Diese Pilger scheinen etwas vorzuhaben. Ich sollte wirklich nicht an solchen belanglosen Angelegenheiten interessiert sein müssen.",
  },
  {
    "key": "conversation_x9lbaf_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ef66r2_text",
    "value": "Ihr schon wieder? Habt ihr nichts besseres zu tun, als mich zu belästigen?",
  },
  {
    "key": "conversation_ef66r2_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_4ay3w5_text",
    "value": "Doch schon, aber es macht einfach Spaß!",
  },
  {
    "key": "conversation_4ay3w5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b1t04s_text",
    "value": "Als wären die Erdbeben nicht schon genug.",
  },
  {
    "key": "conversation_b1t04s_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_6ntyzc_text",
    "value": "Wie auch immer. Ich bin zu dem Schluss gekommen, dass unser Bürgermeister ein Idiot sein muss.",
  },
  {
    "key": "conversation_6ntyzc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_9sm12u_text",
    "value": "Sicher ist es schwer zu glauben, aber selbst ich kann manchmal etwas weniger als absolut richtig liegen.",
  },
  {
    "key": "conversation_9sm12u_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ce5r53_text",
    "value": "Echt jetzt?",
  },
  {
    "key": "conversation_ce5r53_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1zdfzx_text",
    "value": "Ich frage mich, wie viel wohl ein Ticket für diese Rakete kostet ...",
  },
  {
    "key": "conversation_1zdfzx_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_4y3t9l_text",
    "value": "Ich frage mich, wie viel wohl ein Ticket für diese Rakete kostet ...",
  },
  {
    "key": "conversation_4y3t9l_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_bfqth1_text",
    "value": "Hier unten in der Wüste herumzustehen, ist meiner ganz einfach nicht würdig, ich habe Format!",
  },
  {
    "key": "conversation_bfqth1_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_kohvbb_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "{format emph}Autsch!{format reset}",
  },
  {
    "key": "conversation_kohvbb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1a5f80_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "Mist, zum Henker! Meine Lampe ist kaputt.",
  },
  {
    "key": "conversation_1a5f80_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_9rx08a_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Wow! Was {format emph}ist{format reset} das für ein Ort?",
  },
  {
    "key": "conversation_9rx08a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ojjbl5_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Ich muss ihn erkunden, um {format highlight}einen anderen Weg herauszufinden{format reset}.",
  },
  {
    "key": "conversation_ojjbl5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y5enud_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Oh, {format singsong}prächtiges Licht der Führung!{format reset} Badet mich in Eurem Licht.",
  },
  {
    "key": "conversation_y5enud_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_hnsad0_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "JA, HABE DIE EHRE, DICH IN MEINER VERNICHTENDEN GLUT ZU SONNEN.",
  },
  {
    "key": "conversation_hnsad0_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_a1al3q_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "{format singsong}Oh, seid gesegnet!{format reset} Die Glückseligkeit erwartet mich!",
  },
  {
    "key": "conversation_a1al3q_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_2ln8fi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hey! Ich war gerade drauf und dran, dich abzufackeln, du irrer Kultist.",
  },
  {
    "key": "conversation_2ln8fi_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qzp3tz_text",
    "value": "Ich habe es ja versucht, dir klarzumachen: Ich bin {format emph}kein Kultist.{format reset}",
  },
  {
    "key": "conversation_qzp3tz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ksn1s4_text",
    "value": "Echt? Ihr Bots seht für mich alle gleich aus.",
  },
  {
    "key": "conversation_ksn1s4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_g22jzu_text",
    "value": "{format emph}Du{format reset} siehst wie ein Waldgeist aus Vectron aus. Wie ist das {format emph}möglich?{format reset}",
  },
  {
    "key": "conversation_g22jzu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_01a075_text",
    "value": "Mein Freund Rusty hat Vectron zerstört, bevor er verschwand.",
  },
  {
    "key": "conversation_01a075_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_w28at6_text",
    "value": "Dieser Kult stahl mich und steckte mich hier rein, um mich anzubeten. Sie wollten, dass ich sie abknalle, {format laugh}hihihi!{format reset}",
  },
  {
    "key": "conversation_w28at6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_krzwlf_text",
    "value": "Hm ... Das kann ich aber nicht ohne mein cooles Totem. Also, was werden wir jetzt tun?",
  },
  {
    "key": "conversation_krzwlf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wfa9i6_text",
    "value": "Nun, {format emph}Ich{format reset} gehe hoch zur großen Stadt. Man sagte mir, dass Rusty dort gesehen wurde.",
  },
  {
    "key": "conversation_wfa9i6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qhu4n0_text",
    "value": "Zur Stadt sagst du? Okay, wenn du darauf bestehst, kann ich natürlich mit dir mitgehen.",
  },
  {
    "key": "conversation_qhu4n0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_e2v16f_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "EIN SCHUSS! {format laugh}HIHIHI!{format reset}",
  },
  {
    "key": "conversation_e2v16f_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_z0997i_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Mal Langsam! Was zum Henker {format emph}geht hier vor sich{format reset}?",
  },
  {
    "key": "conversation_z0997i_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0dz6we_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "SPITZE! NOCH EIN PILGER!",
  },
  {
    "key": "conversation_0dz6we_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_mzljgp_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Aber ich bin k...",
  },
  {
    "key": "conversation_mzljgp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_yadt78_text",
    "metadata": {
      "notes": "*new* *DEMO* moved the pew-pew line from below into this line.",
    },
    "value": "MACH DICH BEREIT, ABGEKNALLT ZU WERDEN! {format laugh}PEW-PEW!{format reset}",
  },
  {
    "key": "conversation_yadt78_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_cukwql_text",
    "value": "Wow, was für ein Anblick! Warum schaust du nicht mal genauer hin?",
  },
  {
    "key": "conversation_cukwql_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_aszmw4_text",
    "value": "Du musst näher rankommen!",
  },
  {
    "key": "conversation_aszmw4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_skvrgn_text",
    "value": "{format singsong}Nääääheeer ...{format reset} {format laugh}hihihi!{format reset}",
  },
  {
    "key": "conversation_skvrgn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x6t79e_text",
    "value": "Na wenn das nicht die kleine Dorothy McCrank ist!",
  },
  {
    "key": "conversation_x6t79e_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yu1bwf_text",
    "value": "Händler Carson! Ich hätte nicht gedacht, so weit von zu Hause einem Bekannten zu begegnen.",
  },
  {
    "key": "conversation_yu1bwf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0hioym_text",
    "value": "Erzähl mir von deiner kleinen Stadt, Tumbleton. Ich habe viele verschiedene Gerüchte gehört!",
  },
  {
    "key": "conversation_0hioym_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_dslq5p_text",
    "value": "Es begann alles mit Rustys Ankunft. Er hat nach allen möglichen Schätzen gegraben und unserer Stadt geholfen, zu wachsen.",
  },
  {
    "key": "conversation_dslq5p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8tr70j_text",
    "value": "Aber dann hat er tief unten eine merkwürdige Technologie entdeckt. Er ist mit ihr verschmolzen und wurde durch sie sehr mächtig.",
  },
  {
    "key": "conversation_8tr70j_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_70kkpo_text",
    "value": "Na los, komm endlich zum spannenden Teil!",
  },
  {
    "key": "conversation_70kkpo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xfpxnh_text",
    "value": "Nun, es stellte sich heraus, dass die Quelle dieser mysteriösen Macht für uns alle eine Gefahr war.",
  },
  {
    "key": "conversation_xfpxnh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_epbknd_text",
    "value": "Er hat gegen sie gekämpft und uns alle gerettet, aber nach dem Kampf verschwand er. Seitdem versuche ich ihn zu finden.",
  },
  {
    "key": "conversation_epbknd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c5qvu8_text",
    "value": "Ein Reisender sah meine Vermisstenplakate und erzählte mir, dass er gesehen wurde, wie er die Mine von El Machino betrat.",
  },
  {
    "key": "conversation_c5qvu8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i625og_text",
    "value": "Jepp, was für eine Geschichte!",
  },
  {
    "key": "conversation_i625og_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_umknih_text",
    "value": "Kurz gesagt, mein Freund ist verschwunden.",
  },
  {
    "key": "conversation_umknih_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_hp7xc3_text",
    "value": "Ein Reisender sah meine Vermisstenplakate und erzählte mir, dass er gesehen wurde, wie er die Mine von El Machino betrat.",
  },
  {
    "key": "conversation_hp7xc3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nfwjrx_text",
    "metadata": {
      "notes": "*new* changed "well", to "now"",
    },
    "value": "Nun, der Weg nach oben ist blockiert, du wirst {format highlight}die Klippen erklimmen{format reset} müssen, um hinaufzukommen.",
  },
  {
    "key": "conversation_nfwjrx_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_c1qqn0_text",
    "value": "Ich bin in Kürze selbst dort oben. Komm vorbei, wenn du ein paar Verbesserungsrädchen {image cogs_small} kaufen willst, um in der Mine besser klarzukommen.",
  },
  {
    "key": "conversation_c1qqn0_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_m6jpam_text",
    "value": "Ich hoffe, du hast bei deiner Suche hier mehr Glück.",
  },
  {
    "key": "conversation_m6jpam_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_q4eiud_text",
    "value": "Also gut, ich werde nur meine alten Gelenke etwas ausruhen, bevor ich zur Stadt hinaufklettere.",
  },
  {
    "key": "conversation_q4eiud_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yx3y9m_text",
    "value": "Warum erzählst du mir nicht, was in Tumbleton passiert ist, während ich warte?",
  },
  {
    "key": "conversation_yx3y9m_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_x7qfv2_text",
    "value": "Gut, dann eben ein anderes Mal.",
  },
  {
    "key": "conversation_x7qfv2_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_5nktdz_text",
    "value": "Ah! Ich liebe es einfach hier oben in dem hoch polierten Viertel der Stadt zu sein.",
  },
  {
    "key": "conversation_5nktdz_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_tj5uh7_text",
    "value": "Diese Hipsterbots hier zahlen jeden Preis für meine authentischen Verbesserungsrädchen {image cogs_small}.",
  },
  {
    "key": "conversation_tj5uh7_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_nqd450_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich habe ein gutes Geschäft damit gemacht, durch die Gegend zu ziehen und diese kleinen Rädchen hier zu verkaufen.",
  },
  {
    "key": "conversation_nqd450_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_ny6f1a_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Meist kaufe ich sie auf Flohmärkten oder in Gebrauchtläden, aber manchmal findet man sie auch draußen in der Wildnis.",
  },
  {
    "key": "conversation_ny6f1a_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_smo857_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sie machen dieses typische, schleifende Klick-Klack-Geräusch.",
  },
  {
    "key": "conversation_smo857_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_gq1rfi_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Es braucht schon ein geschultes Ohr, um sie herauszuhören, aber wenn du genau hinhörst, kannst du sie identifizieren.",
  },
  {
    "key": "conversation_gq1rfi_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_dm175r_text",
    "value": "Ist eine Weile her, seit ich deinen Vati das letzte mal sah. Wie geht's ihm?",
  },
  {
    "key": "conversation_dm175r_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_w6hv5b_text",
    "value": "Er starb leider schon vor einer Weile.",
  },
  {
    "key": "conversation_w6hv5b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_by4nym_text",
    "value": "Verdammt, das sind traurige Neuigkeiten! Ich dachte immer er würde uns alle überleben ...",
  },
  {
    "key": "conversation_by4nym_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_1g9zr8_text",
    "value": "... schon alleine, um es uns heimzuzahlen.",
  },
  {
    "key": "conversation_1g9zr8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_cgmjf4_text",
    "value": "Dachte ich auch ...",
  },
  {
    "key": "conversation_cgmjf4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i5igy1_text",
    "value": "Also, was ist aus deinem kleinen Laden geworden, jetzt wo du hier mit dem Graben beschäftigt bist?",
  },
  {
    "key": "conversation_i5igy1_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_lp4kx4_text",
    "value": "Oh, Tumbleton floriert. Es gab viele Bots, die gewillt waren, den Handel dort aufzunehmen.",
  },
  {
    "key": "conversation_lp4kx4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a7uh25_text",
    "value": "Ich wollte stattdessen immer in der Mine arbeiten, aber mein Vater hielt das für zu gefährlich.",
  },
  {
    "key": "conversation_a7uh25_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kyijyo_text",
    "value": "Also gut. Ich bin froh, dass du nun das tust, was dich glücklich macht.",
  },
  {
    "key": "conversation_kyijyo_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_s5417g_text",
    "value": "Hab den Burschen ja nie getroffen, der deine Stadt gerettet hat.",
  },
  {
    "key": "conversation_s5417g_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_tgpso6_text",
    "value": "Hatte wirklich keine dringlichen Geschäfte dort, als das alles passierte.",
  },
  {
    "key": "conversation_tgpso6_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_10nfc4_text",
    "value": "Wie war sein Name gleich? Crusty ... nein ... Trusty! So hieß der doch, richtig?",
  },
  {
    "key": "conversation_10nfc4_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_vzg8gx_text",
    "value": "Rusty ...",
  },
  {
    "key": "conversation_vzg8gx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ymzbde_text",
    "value": "Ah, Genau so! Wie ich es verstanden habe, hat er ein gigantisches Monster dort in der Mine ausgeschaltet.",
  },
  {
    "key": "conversation_ymzbde_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_la8vr6_text",
    "value": "Und dann ist er einfach so verschwunden!",
  },
  {
    "key": "conversation_la8vr6_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_k59dwv_text",
    "value": "Viel Glück bei deiner Suche, kleine Dot. Ich hoffe, du findest ihn in einem Stück.",
  },
  {
    "key": "conversation_k59dwv_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_bzq0aw_text",
    "metadata": {
      "notes": "*new* removed "nothing"",
    },
    "value": "Die Welt hat sich ganz schön verändert, seit ich ein junger Bot war.",
  },
  {
    "key": "conversation_bzq0aw_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_zc6l96_text",
    "value": "Dieses Felskraut, das da unten in der Mine wuchert, und Bots, die Raketen bauen, um den Planeten zu fliehen.",
  },
  {
    "key": "conversation_zc6l96_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_jnptai_text",
    "value": "Ich verkaufe einfach meine Verbesserungsrädchen {image cogs_small}, wie ich es schon immer getan habe.",
  },
  {
    "key": "conversation_jnptai_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_rk0bii_text",
    "value": "Schätze, es liegt jetzt an euch Kindern, die Zukunft zu erschaffen.",
  },
  {
    "key": "conversation_rk0bii_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_r74j24_text",
    "metadata": {
      "notes": "Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    },
    "value": "Hey, ich habe eine Handvoll Verbesserungsrädchen {image cogs_small} abzuladen. Es ist mir eine Freude, dir einen fairen Preis zu machen!",
  },
  {
    "key": "conversation_r74j24_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_0qym9q_text",
    "value": "Schätze, du bist hier wegen meinen Verbesserungsrädchen? {image cogs_small}",
  },
  {
    "key": "conversation_0qym9q_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yx06g0_text",
    "value": "Also, wie wäre es? Du bekommst ein funkelndes, neues Verbesserungsrädchen {image cogs_small} für nur \${var pricelist_next:carson_cogs}{image money_small}.",
  },
  {
    "key": "conversation_yx06g0_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_x4iaao_text",
    "value": "Es ist immer wieder eine Freude, mit dir Geschäfte zu machen!",
  },
  {
    "key": "conversation_x4iaao_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_zfed36_text",
    "value": "Du bist eine echt gute Kundin, kleine Dot! Das war das letzte. Prima, dass sie dir von Nutzen waren!",
  },
  {
    "key": "conversation_zfed36_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_koo3mt_text",
    "value": "Nun, ich wünschte, ich könnte dir umsonst helfen Dot, aber auch ein Händler muss seine Brötchen verdienen.",
  },
  {
    "key": "conversation_koo3mt_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_1yrec8_text",
    "value": "Alles klar, komm jederzeit wieder, wenn du Verbesserungsrädchen brauchst! {image cogs_small}",
  },
  {
    "key": "conversation_1yrec8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_27y4o8_text",
    "value": "Du hast den Mut deines Vatis, so viel ist sicher.",
  },
  {
    "key": "conversation_27y4o8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_c3lb0g_text",
    "value": "Hey, was machst du da? {format emph}Raus{format reset} aus meinem Ofen!",
  },
  {
    "key": "conversation_c3lb0g_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_f2k0wg_text",
    "value": "So sieht es also an der Oberfläche aus. Ganz schön hell!",
  },
  {
    "key": "conversation_f2k0wg_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x8lfrw_text",
    "value": "Hey, eine tolle Karte hast du da! Könntest du damit jemanden lokalisieren?",
  },
  {
    "key": "conversation_x8lfrw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_02breo_text",
    "value": "Keine Chance.",
  },
  {
    "key": "conversation_02breo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fek90f_text",
    "metadata": {
      "notes": "Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    },
    "value": "Du erinnerst mich an diese fiesen Waldgeister aus den Geschichten meines Vaters über das alte Land.",
  },
  {
    "key": "conversation_fek90f_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_duq0rd_text",
    "value": "Ich werde dich einfach Fen nennen.",
  },
  {
    "key": "conversation_duq0rd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uostgv_text",
    "metadata": {
      "notes": "*new* split from line above",
    },
    "value": "Ich bin Dorothy, aber meine Freunde nennen mich Dot.",
  },
  {
    "key": "conversation_uostgv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_em0ovz_text",
    "value": "Meinetwegen, ich verzeihe mich wieder in deinen Ofen.",
  },
  {
    "key": "conversation_em0ovz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tats2u_text",
    "value": "Weck mich , wenn etwas Spannendes passiert.",
  },
  {
    "key": "conversation_tats2u_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_szoc5w_text",
    "value": "Hey, ich komme zu spät zu meiner Politur. Wenn du eine Beschwerde einreichen möchtest, an meinem Büro hängt ein Briefkasten.",
  },
  {
    "key": "conversation_szoc5w_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_r6bmk4_text",
    "value": "Und wenn es um die Beben geht, verschone mich bitte. In diesen Teilen ist das bisschen Rüttelei ganz normal.",
  },
  {
    "key": "conversation_r6bmk4_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_orgrlo_text",
    "value": "Ich will mich nicht beschweren. Ich brauche nur Zugang zur Mine, um nach einem vermissten Bot zu suchen.",
  },
  {
    "key": "conversation_orgrlo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2k8w6x_text",
    "value": "{format laugh}Pah!{format reset} Was ich brauche, ist die Mine wieder in Gang zu kriegen. Du hast nicht mal eine vernünftige Lampe!",
  },
  {
    "key": "conversation_2k8w6x_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_o8zw9i_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "So verirrst du dich nur selber, und das kann ich mir nicht leisten. Nicht so kurz vor einer Wahl.",
  },
  {
    "key": "conversation_o8zw9i_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2ok5e8_text",
    "value": "Weißt du was, es gibt einen {format emph}sichereren Ort{format reset}, an dem du graben kannst. Gleich links neben der Leiter unten in der Mine.",
  },
  {
    "key": "conversation_2ok5e8_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_kbljxa_text",
    "value": "Wenn du dein eigenes {format highlight}Erz abbaust{format reset}, um dir eine neue Lampe zu kaufen, wird dich die Wache in die richtige Mine lassen.",
  },
  {
    "key": "conversation_kbljxa_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_dgln8s_text",
    "value": "Hey! Ich kann es mir nicht leisten, dass du in der Mine hopsgehst. {format highlight}Grabe nach Ressourcen{format reset}, um die Lampe zu reparieren!",
  },
  {
    "key": "conversation_dgln8s_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wdf2e3_text",
    "value": "Hey, du hast genug abgebaut, wunderbar! Ich dachte nicht, dass du das Zeug dazu hättest. Jetzt geh und statte Jones Vierfuß einen Besuch ab!",
  },
  {
    "key": "conversation_wdf2e3_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_y8rutk_text",
    "value": "Er ist der grüne Typ mit den Klemmen dort oben. {format highlight}Tausche das Erz{format reset} bei ihm gegen echte Moneten.",
  },
  {
    "key": "conversation_y8rutk_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_35uglo_text",
    "value": "{format highlight}Tausche dein Erz{format reset} dort drüben bei Jones Vierfuß.",
  },
  {
    "key": "conversation_35uglo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_p2p0j1_text",
    "value": "Alles klar! Das Geld ist dir aber nur von Nutzen, wenn du es auch ausgibst.",
  },
  {
    "key": "conversation_p2p0j1_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_hd3efw_text",
    "value": "Jetzt geh deine {format highlight}Lampe reparieren{format reset}, dort drüben in der Werkstatt.",
  },
  {
    "key": "conversation_hd3efw_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_z86wxp_text",
    "value": "Der schüchterne, eckig-aussehende Kerl dort wird dir helfen.",
  },
  {
    "key": "conversation_z86wxp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_w5r2nd_text",
    "value": "Geh deine {format highlight}Lampe reparieren{format reset}, dort drüben in der Werkstatt.",
  },
  {
    "key": "conversation_w5r2nd_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ujjfnb_text",
    "value": "Hey, das sieht schon besser aus! Jetzt bist du bereit, {format highlight}die Mine zu betreten{format reset}.",
  },
  {
    "key": "conversation_ujjfnb_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_woghf0_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Und hey, vergiss nicht: Das süße, süße Erz muss fließen!",
  },
  {
    "key": "conversation_woghf0_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_5r6n65_text",
    "value": "Hey! Es ist toll, wieder jemanden zu haben, der in regelmäßigen Abständen Erz zu Tage fördert.",
  },
  {
    "key": "conversation_5r6n65_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_x2jdkd_text",
    "value": "Nun, abgesehen von ein paar Begegnungen mit fiesen Kriechtieren, komme ich gut voran.",
  },
  {
    "key": "conversation_x2jdkd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b8dzdr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Genau so, wie ich es allen gesagt habe! Sie regen sich alle auf, dabei ist es halb so wild.",
  },
  {
    "key": "conversation_b8dzdr_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_cjntod_text",
    "value": "Ich werde mich zum Rotfelsgang begeben, und versuchen, {format highlight}die Röhre wieder in Gang zu bringen{format reset}.",
  },
  {
    "key": "conversation_cjntod_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pnbpzi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Vergiss nur nicht, das kostbare Erz an die Oberfläche zu bringen!",
  },
  {
    "key": "conversation_pnbpzi_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2pgjla_text",
    "value": "Und zögere nicht, deine Einnahmen in den Geschäften der Stadt auszugeben.",
  },
  {
    "key": "conversation_2pgjla_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_j881iu_text",
    "value": "Aber, aber! Viele Reichtümer warten nur darauf, ausgegraben zu werden. Es gibt keinen Grund, sich mit Rotfels so zu beeilen.",
  },
  {
    "key": "conversation_j881iu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_827vm7_text",
    "value": "Hey, ich verstehe nicht, wieso du die Sprengladungsstation nicht einfach ignorieren kannst.",
  },
  {
    "key": "conversation_827vm7_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_850lak_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Müssen wir wirklich auf Sprengstoff zurückgreifen, wie solche durchgeknallten Schnapsis?",
  },
  {
    "key": "conversation_850lak_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ebyo6x_text",
    "value": "Hast du einen bessere Plan, wie wir den Rotfelsgang freilegen können, Söhnchen?",
  },
  {
    "key": "conversation_ebyo6x_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hkla2t_text",
    "value": "Nun, ich verstehe nicht, wieso sie überhaupt so tief vordringen muss.",
  },
  {
    "key": "conversation_hkla2t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_s2zuik_text",
    "value": "Glaub mir, das Erz da unten ist viel mehr wert, als das Zeugs hier oben.",
  },
  {
    "key": "conversation_s2zuik_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_o84rmq_text",
    "metadata": {
      "notes": "*new* changed format from laugh to emph",
    },
    "value": "Hey, da wäre {format emph}dieser{format reset} Grund natürlich ...",
  },
  {
    "key": "conversation_o84rmq_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wray1t_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wo ist das Problem, einfach eine gute alte Picke zu verwenden? Müssen wir wirklich auf Bomben zurückgreifen?",
  },
  {
    "key": "conversation_wray1t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_b6rus0_text",
    "value": "Ich begebe mich besser wieder nach unten und räume den eingestürzten Durchgang beim Rotfels frei.",
  },
  {
    "key": "conversation_b6rus0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_j39zeq_text",
    "value": "Wäre wirklich eine super Sache für jeden, wenn ihn jemand freiräumen würde.",
  },
  {
    "key": "conversation_j39zeq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vxn818_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hey, ich {format emph}mag{format reset} den Gedanken wirklich, an diese kostbaren Steine da unten heranzukommen.",
  },
  {
    "key": "conversation_vxn818_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_7zj949_text",
    "value": "Hoffen wir, dass du den Rotfels freiräumen kannst, ohne dabei alles schlimmer zu machen.",
  },
  {
    "key": "conversation_7zj949_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_f7egkh_text",
    "value": "Jetzt wo der Rotfelsgang passierbar ist, kannst du weiter unten nach Rusty suchen.",
  },
  {
    "key": "conversation_f7egkh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ksg9fp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hey, wird der Bot immer noch vermisst? Nun, vergiss nur nicht, ein bisschen von dem wertvollen Erz mit nach oben zu bringen.",
  },
  {
    "key": "conversation_ksg9fp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_gu106f_text",
    "value": "Du solltest ohne Probleme bist runter zum Schutzwall graben können, Herzchen.",
  },
  {
    "key": "conversation_gu106f_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_56ijq0_text",
    "value": "Es ist möglich, dass dein Freund durch einen der verdammten Risse in ihm geschlüpft ist.",
  },
  {
    "key": "conversation_56ijq0_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ynbcdq_text",
    "value": "Wenn ich du wäre, würde ich mich runter zur Maurerstation begeben.",
  },
  {
    "key": "conversation_ynbcdq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_twgnbe_text",
    "value": "Da unten sollte irgendwo noch eine alte Ausrüstungsmaschine sein, die dir deine Arbeit erheblich leichter machen wird.",
  },
  {
    "key": "conversation_twgnbe_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_51emyp_text",
    "value": "Du meinst die, die meine dumpfbackigen Brüder letztes Jahr beim Ziegellegen eingemauert haben?",
  },
  {
    "key": "conversation_51emyp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_8gee3i_text",
    "value": "Ach, zum Henker! Ich wette, du {format highlight}findest einen Weg um die Ziegel herum{format reset}, wenn du dich richtig umsiehst.",
  },
  {
    "key": "conversation_8gee3i_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_4sh4u4_text",
    "metadata": {
      "notes": "*new* removed the line beneath this.",
    },
    "value": "Hey! Berichte mir alle Öffnungen, die du findest, damit ich später jemanden losschicken kann, der den Wall zusammenflickt.",
  },
  {
    "key": "conversation_4sh4u4_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_gbjzn6_text",
    "metadata": {
      "notes": "*new* changed cave to passage",
    },
    "value": "Ich habe da unten beim Wall einen ultra-merkwürdigen Gang gefunden. Er ist komplett mit komischen Pflanzen überwuchert.",
  },
  {
    "key": "conversation_gbjzn6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jsqibo_text",
    "value": "Hey, die meisten Sachen in dieser Tiefe sind komisch, wenn du mich fragst. Immerhin befindet sich Schnapsbergen in der Nähe.",
  },
  {
    "key": "conversation_jsqibo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2xq01z_text",
    "value": "Meine anderen nichtsnutzigen Söhne erzählten etwas davon, über eine merkwürdigen, durchwucherte Höhle gestolpert zu sein.",
  },
  {
    "key": "conversation_2xq01z_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_aukq83_text",
    "value": "Ich dachte, sie litten unter dieser verdammten Druckkrankheit.",
  },
  {
    "key": "conversation_aukq83_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8rttb6_text",
    "value": "Meine Brüder haben die Maurerstation ordentlich eingemauert.",
  },
  {
    "key": "conversation_8rttb6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6scmnj_text",
    "value": "Sie sind nicht wirklich die besten Geräte im Schuppen, keiner meiner Jungs.",
  },
  {
    "key": "conversation_6scmnj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jseqve_text",
    "value": "Ich habe es durch den Wall geschafft und die Maurerstation gefunden ..., aber kein Zeichen von Rusty.",
  },
  {
    "key": "conversation_jseqve_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_saqvas_text",
    "value": "Hey, kein Bot bei klarem Verstand würde so tief graben wollen! Du willst doch nicht {format highlight} Schnapsbergen betreten{format reset}, oder?",
  },
  {
    "key": "conversation_saqvas_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_41t2gq_text",
    "value": "Dieser Presslufthammer knackt das Gestein, und bringt dich in einem Augenblick bis ganz nach unten.",
  },
  {
    "key": "conversation_41t2gq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_nlrzra_text",
    "value": "Aber achte auf deinen Wasserstand. Dieses Gerät schluckt es runter wie ein Seemannsbot in der Wüste.",
  },
  {
    "key": "conversation_nlrzra_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x4aowp_text",
    "value": "Hey, bring bloß keine von diesen irren Schnapsis mit hier hoch. Das ist das Letzte, was ich gebrauchen kann.",
  },
  {
    "key": "conversation_x4aowp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_acygrc_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sei vorsichtig, wenn du Löcher in den Wall bohrst, und passe auf diese verwirrten Schnapsis auf.",
  },
  {
    "key": "conversation_acygrc_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_mo33pi_text",
    "metadata": {
      "notes": "*new* removed fake news to tone down Trumpism",
    },
    "value": "Diese Exzentrikerin, Professorin Sherman, verbreitet immer noch Angst mit ihren Messwerten zu den Erdbeben.",
  },
  {
    "key": "conversation_mo33pi_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_27gaig_text",
    "value": "Hey, das letzte Rumpeln hat nicht mal etwas umgeworfen.",
  },
  {
    "key": "conversation_27gaig_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ydzkaa_text",
    "value": "Sie sieht von ihrer Raketenstartrampe auf uns herab, nur weil sie ein Diplom hat.",
  },
  {
    "key": "conversation_ydzkaa_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_667vwu_text",
    "value": "Sherman denkt, sie sei so schlau mit ihrem Diplom. {format laugh}Pah!{format reset} Das einzige Papier das zählt, ist grün ...",
  },
  {
    "key": "conversation_667vwu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jx90fz_text",
    "value": "Dieser irre Tempelkult beschützt wohl eine Art {format emph}Maschine des Jüngsten Gerichts{format reset}.",
  },
  {
    "key": "conversation_jx90fz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jw27fp_text",
    "value": "Diese Maschiene hat diese verdammten, unnatürlichen Erschütterungen verursacht?",
  },
  {
    "key": "conversation_jw27fp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_9baw7n_text",
    "value": "Hey, das ist offensichtlich nicht unser Problem!",
  },
  {
    "key": "conversation_9baw7n_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_7m1f5t_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Man kann vom Büro des Bürgermeister nicht verlangen, sich auch noch um Ende-der-Welt-Szenarien zu kümmern.",
  },
  {
    "key": "conversation_7m1f5t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qbl22o_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Meine Hauptaufgabe besteht darin, Bots dazu zu bringen, kostbare Steine aus der Mine zu holen. Und sie zu besteuern.",
  },
  {
    "key": "conversation_qbl22o_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_v4im3u_text",
    "value": "Du hast hier das Sagen, Idiot. Du hast dich um dieses Amt bemüht, jetzt komm damit klar!",
  },
  {
    "key": "conversation_v4im3u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_v6x25f_text",
    "value": "Hey, der Mädchenbot war bereits im Tempel. Sie kann doch einfach noch einmal runtergehen und die Maschine abschalten!",
  },
  {
    "key": "conversation_v6x25f_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6dx6ev_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Na also, Problem gelöst! Und vergiss nicht, mehr von diesen kostbaren Steinen zurückzubringen.",
  },
  {
    "key": "conversation_6dx6ev_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6aje4l_text",
    "value": "Hey, bist du schon dazu gekommen, {format highlight} die Maschine des Jüngsten Gerichts abzuschalten{format reset}?",
  },
  {
    "key": "conversation_6aje4l_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_3lxi6c_text",
    "value": "Wir haben es geschafft, die Maschine des Jüngsten Gerichts zu zerstören.",
  },
  {
    "key": "conversation_3lxi6c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rv004f_text",
    "value": "Und wie wir das haben! Du hättest sie explodieren sehen sollen!",
  },
  {
    "key": "conversation_rv004f_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7nmsnx_text",
    "value": "Seht ihr? Das Bürgermeisterbüro hatte die ganze Zeit alles unter Kontrolle!",
  },
  {
    "key": "conversation_7nmsnx_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qpbmn2_text",
    "value": "{format emph}Dummkopf!{format reset}",
  },
  {
    "key": "conversation_qpbmn2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_j8m71m_text",
    "value": "Hey, {format emph}Ich{format reset} war es, der sie ursprünglich runter in die Mine geschickt hat.",
  },
  {
    "key": "conversation_j8m71m_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_sptgv3_text",
    "value": "Ich verlange etwas Anerkennung. Ich war es, der dich ursprünglich runter in die Mine geschickt hat.",
  },
  {
    "key": "conversation_sptgv3_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2h1yth_text",
    "value": "Wir haben noch mehr Erdbebenmaschinen unten in den Minen gefunden.",
  },
  {
    "key": "conversation_2h1yth_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xbnodu_text",
    "metadata": {
      "notes": "*new* enclosed "come" into the format",
    },
    "value": "Ach, {format emph}komm schon{format reset}! Kann ich hier nicht einmal eine Minute verschnaufen?",
  },
  {
    "key": "conversation_xbnodu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6c2elx_text",
    "value": "Hey, alles was ich wollte, war ein bequemer Job, der nichts mit dem Graben in dieser dreckigen Mine zu tun hatte.",
  },
  {
    "key": "conversation_6c2elx_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_kk8x0s_text",
    "value": "Wenn du es nicht schaffst, {format highlight}diese Maschinen abzuschalten{format reset}, muss ich vielleicht die gesamte Stadt evakuieren!",
  },
  {
    "key": "conversation_kk8x0s_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_hmjz7t_text",
    "value": "Hast du überhaupt eine Idee, wie viel das kosten wird?",
  },
  {
    "key": "conversation_hmjz7t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qzd676_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hey, sammle wenigstens ein paar Kostbarkeiten ein, während du dich dort unten herumtreibst, abgemacht?",
  },
  {
    "key": "conversation_qzd676_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ocz2bm_text",
    "value": "Hast du schon den Rest dieser Maschinen abgeschaltet?",
  },
  {
    "key": "conversation_ocz2bm_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wihfk8_text",
    "value": "Ein wild wuchernder Dschungel in den Minen, kultische Untergangtheoretiker ...",
  },
  {
    "key": "conversation_wihfk8_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jcggy6_text",
    "value": "Ich wette, der letzte Bürgermeister musste sich nicht mit solchen Dingen herumschlagen ...",
  },
  {
    "key": "conversation_jcggy6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_8d282i_text",
    "value": "Irgendwie wünschte ich mir, ich wäre stattdessen ins Familiengeschäft eingestiegen. Meine Brüder sehen irgendwie glücklich aus.",
  },
  {
    "key": "conversation_8d282i_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_w4v0m6_text",
    "value": "Ich sollte einfach anfangen, meine Taschen zu packen, so wie der Rest der Wählerschaft.",
  },
  {
    "key": "conversation_w4v0m6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_mm9lt2_text",
    "value": "Hey, ohne eine Stadt zum regieren kann ich kein Bürgermeister sein, oder nicht? Hm, der Gedanke ist eigentlich ganz tröstlich ...",
  },
  {
    "key": "conversation_mm9lt2_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_e4p6yr_text",
    "value": "Hey, vielleicht sollte ich dem Familienunternehmen beitreten, und ein neues Leben als Asteroidenminenarbeiter starten.",
  },
  {
    "key": "conversation_e4p6yr_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_yzrylo_text",
    "value": "Hey! Was hälst du von diesem Slogan? "Alles bleibt, wie gehabt!" Ziemlich gut, oder?",
  },
  {
    "key": "conversation_yzrylo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_pap70a_text",
    "value": "Ein Bergarbeiter mit einem roten Schal? Das {format emph}muss{format reset} Rusty sein! Endlich eine aussichtsvolle Spur!",
  },
  {
    "key": "conversation_pap70a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n0lq8o_text",
    "value": "Diese Erdbeben klingen echt vielversprechend.",
  },
  {
    "key": "conversation_n0lq8o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3nu9ex_text",
    "value": "Nichts geht über ein wenig Chaos, um ein Abenteuer aufzupeppen.",
  },
  {
    "key": "conversation_3nu9ex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_elfbhm_text",
    "value": "Ich muss {format highlight}mit dem Bürgermeister darüber sprechen{format reset}, wie ich in die Mine gelange.",
  },
  {
    "key": "conversation_elfbhm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lty8j0_text",
    "value": "Junge Dame, es ist dir nicht gestattet, hier unten zu graben!",
  },
  {
    "key": "conversation_lty8j0_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ml6q7x_text",
    "value": "Wir können nicht zulassen, dass sich noch mehr Bergarbeiter verirren, verstehst du?",
  },
  {
    "key": "conversation_ml6q7x_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_cmr7ae_text",
    "value": "Ich schlage vor, du sprichst mit dem Bürgermeister, und holst die entsprechende Genehmigung ein.",
  },
  {
    "key": "conversation_cmr7ae_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jqyolm_text",
    "metadata": {
      "notes": "Her chest lamp is busted",
    },
    "value": "Stehen geblieben, junge Dame! Ich kann dir das Graben hier ohne geeignete Lichtquelle nicht gestatten.",
  },
  {
    "key": "conversation_jqyolm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jmhinb_text",
    "value": "Ich möchte hier unten nur nach meinem Freund suchen! Wie wäre es, wenn ich nur einmal kurz gucken gehe?",
  },
  {
    "key": "conversation_jmhinb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_97lht6_text",
    "value": "Ja, lass sie nachsehen. Sie wird es {format emph}sicher{format reset} zurück nach oben schaffen.",
  },
  {
    "key": "conversation_97lht6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_naakhs_text",
    "value": "Ich schätze, wir haben schon {format emph}einen{format reset} Minenarbeiter zu viel hier unten verloren.",
  },
  {
    "key": "conversation_naakhs_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wjso4t_text",
    "value": "Es ist zu gefährlich, den Weg im Dunkeln zu suchen. Wie wäre es, wenn du stattdessen an dem gut beleuchteten Ort dort drüben {format highlight}Erz abbaust{format reset}?",
  },
  {
    "key": "conversation_wjso4t_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_iom5do_text",
    "value": "Es ist zu gefährlich, den Weg im Dunkeln zu suchen. Wie wäre es, wenn du zuerst in der Stadt deine {format highlight}Lampe reparierst{format reset}?",
  },
  {
    "key": "conversation_iom5do_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_c5cn1e_text",
    "value": "Du musst {format highlight}nach Erz graben{format reset}, um dir eine vernünftige Lampe leisten zu können.",
  },
  {
    "key": "conversation_c5cn1e_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_6b9sev_text",
    "value": "Wie wäre es, wenn du {format highlight}alle Erze in deinem Besitz eintauschst{format reset}, und dann deine Lampe in der Werkstatt reparierst?",
  },
  {
    "key": "conversation_6b9sev_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_66rd82_text",
    "value": "Ich schätze, du kannst oben in der Werkstatt{format highlight} deine Lampe reparieren{format reset}.",
  },
  {
    "key": "conversation_66rd82_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_94r9zk_text",
    "value": "Ah! Sieht so aus, als wärst du bereit zu graben!",
  },
  {
    "key": "conversation_94r9zk_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_n9j9h3_text",
    "value": "Du lässt mich jetzt also {format highlight}tiefer{format reset} in die Mine hinein?",
  },
  {
    "key": "conversation_n9j9h3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p0ntw5_text",
    "value": "Sicher! Zeig mir einfach, dass du die {format highlight}Laterne dort drüben anzünden{format reset} kannst, und ich öffne die Luken.",
  },
  {
    "key": "conversation_p0ntw5_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wphcux_text",
    "value": "Wie wäre es, wenn du zuerst die {format highlight}Laterne dort drüben anzündest{format reset}, dann lasse ich dich in die Mine.",
  },
  {
    "key": "conversation_wphcux_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_f36o1k_text",
    "metadata": {
      "notes": "*new* expanded this as I removed the full text that was used before. It was repatative.",
    },
    "value": "Ich schätze, das Röhrensystem wird dich weitaus schneller in die Stadt bringen, als du zu Fuß dazu in der Lage wärst.",
  },
  {
    "key": "conversation_f36o1k_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ih3zjl_text",
    "value": "Du hattest recht, der Rotfelsgang ist verschlossen.",
  },
  {
    "key": "conversation_ih3zjl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lynw1k_text",
    "value": "Dachte ich es mir.",
  },
  {
    "key": "conversation_lynw1k_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_arg7cq_text",
    "value": "Ich schätze, du wirst ihn sehr einfach mit einem Satz Sprengstoff freisprengen können.",
  },
  {
    "key": "conversation_arg7cq_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_94selp_text",
    "value": "Ich schätze, mit einem gut platzierten Satz Sprengstoff fegt es Rotfels so richtig frei.",
  },
  {
    "key": "conversation_94selp_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pl5kjt_text",
    "value": "Ich schätze, der Bürgermeister wüsste gerne Bescheid, sobald Rotfels wieder passierbar ist.",
  },
  {
    "key": "conversation_pl5kjt_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_d3sb26_text",
    "metadata": {
      "notes": "Shiners are cave dwelling human decendants.",
    },
    "value": "Ich bin in den Minen vielen Kreaturen begegnet, aber keine sind so wankelmütig und gefährlich wie Schnapsis.",
  },
  {
    "key": "conversation_d3sb26_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_a458ae_text",
    "metadata": {
      "notes": "A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    },
    "value": "Der Krieg war zwar lange vor meine Zeit, aber ich bin diesen Landeiern schon ein ums andere Mal begegnet.",
  },
  {
    "key": "conversation_a458ae_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_t6mrk7_text",
    "value": "Mit ihnen reden ist zwecklos, hau einfach so schnell und so oft drauf, wie du kannst.",
  },
  {
    "key": "conversation_t6mrk7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pygh76_text",
    "value": "Das macht vielleicht einen etwas brutalen Eindruck, aber ich würde es nicht darauf ankommen lassen.",
  },
  {
    "key": "conversation_pygh76_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_xgdjhu_text",
    "value": "Zum Glück hat man diesen Wall nach dem Krieg gebaut.",
  },
  {
    "key": "conversation_xgdjhu_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ujn89n_text",
    "value": "Diese verwirrten Schnapsis waren früher vielleicht ganz anders.",
  },
  {
    "key": "conversation_ujn89n_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_nd5hoz_text",
    "metadata": {
      "notes": "Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    },
    "value": "Jetzt sind sie einfach nur mutierte Bebenmacher.",
  },
  {
    "key": "conversation_nd5hoz_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_5xd7xt_text",
    "value": "Ich schätze, du wirst einem Mutanten nie wirklich trauen können.",
  },
  {
    "key": "conversation_5xd7xt_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_y6jyvf_text",
    "value": "Bist du diesen irren Kultisten auf ihrer Pilgerreise des Wahnsinns begegnet?",
  },
  {
    "key": "conversation_y6jyvf_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_1tzeuc_text",
    "value": "Manchmal nehmen sie den Weg durch die Minen, wenn sie zwischen den Tempeln wandern.",
  },
  {
    "key": "conversation_1tzeuc_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_147ntm_text",
    "value": "Normalerweise würden sie einfach den Wüstenpfad durch die Windigen Ebenen nehmen.",
  },
  {
    "key": "conversation_147ntm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_f34oeg_text",
    "value": "Ich hab eigentlich nichts gegen Kultisten. Man fühlt sich auch weniger einsam, wenn sie hier hindurchkommen.",
  },
  {
    "key": "conversation_f34oeg_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_l509g4_text",
    "value": "Ich bin wirklich beeindruckt, wie weit du es nach unten geschafft hast.",
  },
  {
    "key": "conversation_l509g4_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_lbobkd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sei trotzdem vorsichtig, ich habe Geschichten von Gefahren gehört, die normale Bürger nicht kennen.",
  },
  {
    "key": "conversation_lbobkd_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_alemgw_text",
    "value": "Stelle sicher, dass es immer einen Weg zurück gibt. Ein Tunnel ohne Ausgang ist nichts weiter als ein langer Sarg.",
  },
  {
    "key": "conversation_alemgw_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_51bz8w_text",
    "value": "Würde nicht schaden, {format emph}das{format reset} im Hinterköpfchen zu behalten, und stelle sicher, dass du genügend Panzerung hast.",
  },
  {
    "key": "conversation_51bz8w_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_e9lgr6_text",
    "value": "Bleib wachsam und halte deine Ausrüstung auf dem neuesten Stand, besseren Rat kann ich dir nicht geben.",
  },
  {
    "key": "conversation_e9lgr6_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_19pnkh_text",
    "value": "Anscheinend haben diese Yonker-Brüder einen merkwürdig wuchernden Dschungel in der Mine gesehen.",
  },
  {
    "key": "conversation_19pnkh_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_205qqo_text",
    "value": "Habe auch gehört, dass er sich ausbreitet, aber ich würde ihn nie an die Stadt herankommen lassen.",
  },
  {
    "key": "conversation_205qqo_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_59fokz_text",
    "value": "Vielleicht investiere ich einfach in eine richtige Axt, nur für den Fall. Immerhin ist sie ein Mehrzweckgerät.",
  },
  {
    "key": "conversation_59fokz_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_vwt53j_text",
    "value": "Schon beängstigend, das da einfach irgendwo urplötzlich ein Dschungel herausschießen könnte.",
  },
  {
    "key": "conversation_vwt53j_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_1re540_text",
    "value": "Ich gebe zu, dass ich nach diesem letzten Erdbeben ein bisschen besorgt war.",
  },
  {
    "key": "conversation_1re540_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_25kyco_text",
    "value": "Scheint, als würden die Beben in letzter Zeit stärker werden. Aber keine Sorge, ich bleibe auf meinem Posten.",
  },
  {
    "key": "conversation_25kyco_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_e0zgh7_text",
    "value": "Möglicherweise verletzen sich Leute hier unten, wenn niemand sie vor den Gefahren bewahrt.",
  },
  {
    "key": "conversation_e0zgh7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jkptm2_text",
    "value": "Für Angst gibt es keinen Platz unter dieser Brustplatte, ganz allein Pflichtbewusstsein. Das ist alles, was mich erfüllt.",
  },
  {
    "key": "conversation_jkptm2_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4niz25_text",
    "value": "{format highlight}Behalte dein Licht im Auge{format reset}, sodass du dort unten nicht plötzlich im Dunkeln sitzt.",
  },
  {
    "key": "conversation_4niz25_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_aex9as_text",
    "value": "Geh einfach zurück und {format highlight}fülle es oben wieder auf{format reset}, wenn es langsam abnimmt.",
  },
  {
    "key": "conversation_aex9as_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_dmvx8z_text",
    "value": "Die Mine ist nicht gerade der sicherste Ort, also halte deine Ausrüstung in tipptopper Form.",
  },
  {
    "key": "conversation_dmvx8z_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_uimryl_text",
    "value": "Hallo! Beruhigt euch bitte, Leute!",
  },
  {
    "key": "conversation_uimryl_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_31d0sd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eigentlich sind diese {format nervous}Erdbeben{format reset} etwas, worüber man sich Sorgen machen sollte.",
  },
  {
    "key": "conversation_31d0sd_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_4njhbf_text",
    "value": "Ich sagte ja bereits, mein Seismometer empfängt wirklich merkwürdige Messwerte!",
  },
  {
    "key": "conversation_4njhbf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_l4n0br_text",
    "value": "Es gibt Wichtigeres, um das wir uns sorgen sollten, wie zum Beispiel den Erznachschub zu gewährleisten.",
  },
  {
    "key": "conversation_l4n0br_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_dzl3uz_text",
    "value": "Dummkopf! Warum hörst du nicht auf die Experten?",
  },
  {
    "key": "conversation_dzl3uz_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_7blj3t_text",
    "value": "Mutti, bitte! Diese "Experten" mit ihren "Fakten" ... Sie sehen den Gesamtzusammenhang doch gar nicht.",
  },
  {
    "key": "conversation_7blj3t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_lwjidu_text",
    "value": "Und was ist mit dem {format emph}Minenarbeiter mit dem roten Schal{format reset}, der es nie nach oben zurückgeschafft hat?",
  },
  {
    "key": "conversation_lwjidu_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jije2r_text",
    "value": "Ich habe bereits eine Wache eingestellt, die verhindert, dass mehr unvorbereitete Bots verschwinden.",
  },
  {
    "key": "conversation_jije2r_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jhc64p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Also, jetzt behalten wir mal alle einen klaren Kopf, und erinnern uns daran, dass das Bürgermeisterbüro keine Schuld trifft.",
  },
  {
    "key": "conversation_jhc64p_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_njlyi9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Idiot!",
  },
  {
    "key": "conversation_njlyi9_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_xqrxw3_text",
    "value": "{format laugh}Hihihi! Bumm!{format reset} Lass uns das wiederholen.",
  },
  {
    "key": "conversation_xqrxw3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_y6g3s7_text",
    "value": "Diese Bomben werden sich sicher als nützlich erweisen. Sie können Orte erreichen, an die meine Picke nicht herankommt.",
  },
  {
    "key": "conversation_y6g3s7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c5us81_text",
    "value": "Ich schätze, ich sollte {format highlight}dem Bürgermeister davon erzählen{format reset}, dass der Durchgang wieder passierbar ist.",
  },
  {
    "key": "conversation_c5us81_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ig8tga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wurde aber auch Zeit, dass in den Tunneln hier mal wieder jemand gräbt.",
  },
  {
    "key": "conversation_ig8tga_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_3li9iu_text",
    "value": "Endlich bin ich auf der richtigen Spur, um Rusty zu finden.",
  },
  {
    "key": "conversation_3li9iu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ti9ln5_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich schätze dein Kumpel musste irgendwann durch den Rotfelsgang hindurch.",
  },
  {
    "key": "conversation_ti9ln5_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_60et06_text",
    "value": "Normalerweise könntest du das pneumatische Röhrensystem benutzen, um dorthin- und zurückzukommen.",
  },
  {
    "key": "conversation_60et06_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_cix8sl_text",
    "value": "Es hat sich jedoch während eines Erdbebens verstopft. Es wäre klug, {format highlight}es vorher freizuräumen{format reset}.",
  },
  {
    "key": "conversation_cix8sl_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_h47l73_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Nun, wie wär's, wenn ich einfach die Luken öffne, und dich runterlasse?",
  },
  {
    "key": "conversation_h47l73_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_q6n8pp_text",
    "value": "Hey es wird dunkel. Ich kann kaum etwas sehen, und ich bestehe aus Licht.",
  },
  {
    "key": "conversation_q6n8pp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1dc723_text",
    "metadata": {
      "notes": "The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    },
    "value": "{format highlight}Gehe in die Stadt{format reset} zurück und fülle deine Lampe wieder auf, damit ich mich hier unten nicht verlaufe.",
  },
  {
    "key": "conversation_1dc723_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ytvst4_text",
    "value": "Das muss der Rotfelsgang sein. Ist ganz schön verschüttet.",
  },
  {
    "key": "conversation_ytvst4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ac4a61_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wenn du Sprengstoff hättest, könntest du dieses Gestein einfach wegblasen.",
  },
  {
    "key": "conversation_ac4a61_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_f2qhr1_text",
    "value": "Das ist keine schlechte Idee! Ich sollte zurück in die Stadt und mich umhören.",
  },
  {
    "key": "conversation_f2qhr1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8j9cex_text",
    "value": "{format laugh}Oh ja, Sprengstoff!{format reset} Vielleicht bläst du dir sogar ein oder zwei deiner Teile weg ...",
  },
  {
    "key": "conversation_8j9cex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0g7tly_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Botverdammmich! Lass uns einfach diese pneumatische Röhre freimachen, okay?",
  },
  {
    "key": "conversation_0g7tly_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n67xrl_text",
    "value": "Das muss der Rotfelsgang sein. Ist komplett eingestürzt.",
  },
  {
    "key": "conversation_n67xrl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1kwj0v_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Du könntest die Bomben verwenden, um den Weg freizumachen.",
  },
  {
    "key": "conversation_1kwj0v_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_661ekz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich sollte deine destruktive Ader wohl nicht noch verstärken, aber das ist keine schlechte Idee.",
  },
  {
    "key": "conversation_661ekz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xdrduu_text",
    "value": "{format laugh}Oh ja, Sprengstoff!{format reset} Vielleicht bläst du dir sogar ein oder zwei deiner Teile weg!",
  },
  {
    "key": "conversation_xdrduu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6c0vsm_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Botverdammmich! Lass uns einfach diese pneumatische Röhre ausprobieren, okay?",
  },
  {
    "key": "conversation_6c0vsm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h5wj1m_text",
    "metadata": {
      "notes": "Very nervous person",
    },
    "value": "Ich will nicht nerven ..., aber diese {format nervous}Erdbeben{format reset} machen mir angst.",
  },
  {
    "key": "conversation_h5wj1m_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_o86kfe_text",
    "value": "Aber, eh ... Nun, wenn sie wirklich ein Problem wären, dann würde der Bürgermeister auch besorgter sein.",
  },
  {
    "key": "conversation_o86kfe_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_o2oiou_text",
    "value": "Der Bürgermeister sagt, dass man sich um diese {format nervous}Erdbeben{format reset} keine Sorgen machen müsse, also denke ich mal, ähm, dass das so stimmt.",
  },
  {
    "key": "conversation_o2oiou_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_h7ppy6_text",
    "value": "Eh, hallo ...",
  },
  {
    "key": "conversation_h7ppy6_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kg1mo1_text",
    "metadata": {
      "notes": "*new* The light source is set in the middle of the chest.",
    },
    "value": "Ich sehe, du hast deine Lichtquelle ramponiert.",
  },
  {
    "key": "conversation_kg1mo1_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_q3my9j_text",
    "value": "Ich würde, eh ... bei diesem {format nervous}Gerumpel{format reset} nicht im Dunkeln herumwandern.",
  },
  {
    "key": "conversation_q3my9j_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ltmso8_text",
    "value": "Also, eh ... bevor du dich in die Mine begibst, eh ... wäre es besser, wenn du zuerst {format highlight}deine Lampe reparierst{format reset}.",
  },
  {
    "key": "conversation_ltmso8_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9zjn4q_text",
    "metadata": {
      "notes": "Workbench",
    },
    "value": "Du kannst meine Werkbank hier benutzen ..., wenn du möchtest.",
  },
  {
    "key": "conversation_9zjn4q_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_izda31_text",
    "value": "An meiner Werkbank kannst du {format highlight}deine Lampe reparieren{format reset} ..., wenn du möchtest.",
  },
  {
    "key": "conversation_izda31_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_649j7z_text",
    "metadata": {
      "notes": "Dorothys speed boots.",
    },
    "value": "Oh ... eh, ich mag deine Stiefel.",
  },
  {
    "key": "conversation_649j7z_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_fjqq9f_text",
    "value": "Ja? Sie wurden von irgendeiner Maschine tief unter der Wüste verbessert.",
  },
  {
    "key": "conversation_fjqq9f_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_v3f2hn_text",
    "value": "Die extra, eh, Sprinthydraulik hat sie wohl richtig, richtig schnell gemacht.",
  },
  {
    "key": "conversation_v3f2hn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qnv8df_text",
    "value": "Diese Ausrüstungsmaschinen unten in den Bergbaustationen sind ziemlich cool, was?",
  },
  {
    "key": "conversation_qnv8df_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_f9qput_text",
    "value": "Oh ... eh, alles klar. Nun, man kann sie überall in den Minen finden.",
  },
  {
    "key": "conversation_f9qput_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ji4atj_text",
    "value": "Eh, sie sind sehr, {format emph}sehr alt{format reset}. Wir wissen nicht, wer sie erbaut hat, aber für unsere Art funktionieren sie wunderbar.",
  },
  {
    "key": "conversation_ji4atj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kn7n3g_text",
    "value": "Über die Jahre hinweg haben Bergarbeiterbots in der nähe dieser Maschinen Bergbaustationen errichtet.",
  },
  {
    "key": "conversation_kn7n3g_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_w8uqp5_text",
    "value": "Wir wissen wo sich ein paar von ihnen befinden, eh, aber die Minen sind viel, viel, {format emph}viel größer{format reset}, als der Teil, in dem gearbeitet wird.",
  },
  {
    "key": "conversation_w8uqp5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_m5pbwk_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich habe von verlorenen Stationen gelesen, mit cooler Ausrüstung, die in eh ... tiefer liegenden, unkartierten Bereichen der Mine liegen.",
  },
  {
    "key": "conversation_m5pbwk_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_wad1be_text",
    "value": "Oh ... eh, aber natürlich.",
  },
  {
    "key": "conversation_wad1be_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_apkmkg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wow, du hast einen Druckbombenwerfer gefunden!",
  },
  {
    "key": "conversation_apkmkg_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qjmh35_text",
    "metadata": {
      "notes": "This is techno jibberish, feel free to make up new stuff.",
    },
    "value": "Der dreifache Pümpel sorgt für einen {format singsong}geschmeidigen{format reset} Fluss durch das Siphonrohr.",
  },
  {
    "key": "conversation_qjmh35_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ua28gp_text",
    "value": "Er verschießt ein selbsthaftendes Projektil, das an jeder Oberfläche kleben bleibt, bevor es explodiert.",
  },
  {
    "key": "conversation_ua28gp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_saczrj_text",
    "metadata": {
      "notes": "*format* The pressure bomb works with water.",
    },
    "value": "Ich wette das Ding spritzt wie verrückt! Hihi ...",
  },
  {
    "key": "conversation_saczrj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_tz9y1l_text",
    "value": "Eh ... entschuldige. Ich, eh, habe mich wohl etwas mitreißen lassen.",
  },
  {
    "key": "conversation_tz9y1l_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_yxae4k_text",
    "value": "Oh, eh ... du hast es bist zur Maurerstation geschafft wie ich sehe.",
  },
  {
    "key": "conversation_yxae4k_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_rz6lrl_text",
    "metadata": {
      "notes": "*format* The upgrade is a mechanical fist that works like a jack hammer.",
    },
    "value": "Dieser Hammer besitzt richtig Power und bricht selbst durch die härtesten Bereiche von Gestein.",
  },
  {
    "key": "conversation_rz6lrl_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_art1sv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Damit wird aus dem Erkunden der anderen Seite des Walls Kinderkram.",
  },
  {
    "key": "conversation_art1sv_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ghl26_text",
    "value": "Und er lässt sich kinderleicht aufwerten, in Sachen Brennstoffversorgung und so weiter.",
  },
  {
    "key": "conversation_1ghl26_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_a315z5_text",
    "value": "Ein stärkerer pneumatischer Zylinder, würde eine erhöhte maximale Betriebsgeschwindigkeit erlauben ...",
  },
  {
    "key": "conversation_a315z5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_lyy59m_text",
    "value": "Eh, ich meine, er hat eine Menge Potential, das ist alles.",
  },
  {
    "key": "conversation_lyy59m_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ornloo_text",
    "metadata": {
      "notes": "See "Spelunker Station" in other document",
    },
    "value": "{format singsong}Oh, wow!{format reset} Ich dachte die Höhlenforscherstation sei längst Geschichte!",
  },
  {
    "key": "conversation_ornloo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_uo7wrd_text",
    "metadata": {
      "notes": "The hook shot look like a grapling hook and is shot out of your arm",
    },
    "value": "Du hast den alten Greifhaken trotzdem gefunden!",
  },
  {
    "key": "conversation_uo7wrd_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4x94pz_text",
    "metadata": {
      "notes": ""zip" as in fly or move fast",
    },
    "value": "Dieses Teil erlaubt dir, dich so rasant durch die Mine zu bewegen wie{format emph}nie{format reset} zuvor.",
  },
  {
    "key": "conversation_4x94pz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_wt4pay_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Damit kannst du jetzt fast jede Ecke und jeden Winkel erkunden!",
  },
  {
    "key": "conversation_wt4pay_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_jc96m9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "In diesen Minen warten unzählige Geheimnisse darauf, entdeckt zu werden.",
  },
  {
    "key": "conversation_jc96m9_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xxorzf_text",
    "value": "{format singsong}OH WOW!{format reset} Ist es das, was ich denke?",
  },
  {
    "key": "conversation_xxorzf_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_h0sfna_text",
    "metadata": {
      "notes": "It's a falaming Pick Axe",
    },
    "value": "Wie bist du an eine Feueraxt herangekommen?",
  },
  {
    "key": "conversation_h0sfna_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4p03fk_text",
    "value": "Oh, ich wette sie war irgendwo im östlichen Tempel versteckt.",
  },
  {
    "key": "conversation_4p03fk_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_7shcmp_text",
    "value": "Ich habe in einem meiner Gerätemagazine über sie gelesen. Die Wahrscheinlichkeit, dass dieses Ding noch existiere ... Ich {format emph}kann es nicht glauben{format reset}!",
  },
  {
    "key": "conversation_7shcmp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9e6rbj_text",
    "value": "Oh ... eh, sie ist wirklich toll.",
  },
  {
    "key": "conversation_9e6rbj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_8x0zgn_text",
    "metadata": {
      "notes": "*format* see Aeronaut Station in the other document",
    },
    "value": "Oh, komm schon! Sag mir nicht, du bist bis runter zur Luftfahrerstation gekommen!",
  },
  {
    "key": "conversation_8x0zgn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_gqdbky_text",
    "value": "Sie wurde angeblich weit unter den modernen Teilen der Mine begraben.",
  },
  {
    "key": "conversation_gqdbky_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_34ele3_text",
    "value": "Niemals hätte ich geglaubt, ich würde mal ein echtes Düsentriebwerk zu Gesicht bekommen!",
  },
  {
    "key": "conversation_34ele3_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vr5wop_text",
    "value": "Ich flippe total aus!",
  },
  {
    "key": "conversation_vr5wop_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_0czv1r_text",
    "metadata": {
      "notes": "*new* just hammering home that the world is more open at this point.",
    },
    "value": "Mit dem Ding kannst du die ganze Mine durchqueren. Du kommst damit an Orte, die du vorher nie hättest erkunden können.",
  },
  {
    "key": "conversation_0czv1r_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_2bpv40_text",
    "metadata": {
      "notes": "*new* as in the old saying "the world is your oyster"",
    },
    "value": "Die Mine liegt dir wahrlich zu Füßen.",
  },
  {
    "key": "conversation_2bpv40_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_6c8k38_text",
    "value": "Ich wette, ich kann sogar ein paar krasse Verbesserungen vornehmen ... eh, wenn du möchtest ...",
  },
  {
    "key": "conversation_6c8k38_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kddst5_text",
    "metadata": {
      "notes": "This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    },
    "value": "Eh, dieser Dschungel unten in der Mine ... ist in aller Munde.",
  },
  {
    "key": "conversation_kddst5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ibifo_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich hoffe, er breitet sich nicht bis nach oben aus. Eh ... ich schaffe es ja nicht einmal in die Nähe dieser schrecklichen Kakteen zu kommen.",
  },
  {
    "key": "conversation_1ibifo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qxg2dp_text",
    "value": "Ich wette wenn du eine richtig tolle Motorsense hättest, eh ... würdest du dieses Gemüse einfach kleinschnibbeln.",
  },
  {
    "key": "conversation_qxg2dp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_jn0ayb_text",
    "value": "Zu schade, dass es keine alten Bergbaustationen mit so etwas gibt ...",
  },
  {
    "key": "conversation_jn0ayb_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_evptsm_text",
    "value": "Eh, ich hoffe diese {format nervous}komischen Pflanzen{format reset} schaffen es nicht bis hier hinauf in die Stadt.",
  },
  {
    "key": "conversation_evptsm_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_d2k8hv_text",
    "value": "Eh, ich will die Professorin nicht belästigen ...",
  },
  {
    "key": "conversation_d2k8hv_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_zfm1c4_text",
    "metadata": {
      "notes": "The rocket is a space rocket.",
    },
    "value": "Vielleicht sollte ich sie fragen, ob ich einen Blick in die Rakete werden darf, jetzt wo sie fertig ist?",
  },
  {
    "key": "conversation_zfm1c4_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_js74jz_text",
    "value": "Sie ist wirklich, wirklich cool, findest du nicht auch?",
  },
  {
    "key": "conversation_js74jz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_bufmli_text",
    "value": "Eh, ich würde wirklich gerne einen Blick in das Raketenschiff werden ...",
  },
  {
    "key": "conversation_bufmli_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_yxbbjn_text",
    "value": "Raketen sind cool!",
  },
  {
    "key": "conversation_yxbbjn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ovqzn_text",
    "metadata": {
      "notes": "*new* rephrased this line to work in more situations.",
    },
    "value": "Du kannst deine Ausrüstung bei meiner Werkbank reparieren oder verbessern, eh ... jederzeit.",
  },
  {
    "key": "conversation_1ovqzn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4dhtk4_text",
    "value": "Okay, lass uns das Ding in {format singsong}Stücke{format reset} sprengen!",
  },
  {
    "key": "conversation_4dhtk4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_eff23g_text",
    "value": "Du musst wirklich mal mit jemandem über diese ganze Mutwillige-Zerstörung-Sache reden.",
  },
  {
    "key": "conversation_eff23g_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oxrw0l_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich rede in diesem Moment mit dir darüber. Wann rede ich denn mal nicht über Zerstörung?",
  },
  {
    "key": "conversation_oxrw0l_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nmb2rq_text",
    "value": "Genau ...",
  },
  {
    "key": "conversation_nmb2rq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t0dmfu_text",
    "metadata": {
      "notes": "*new* This message is shown when the player have unused upgrade-cogs.",
    },
    "value": "Du schöpfst dein Potential nicht wirklich aus. Benutze ein paar Rädchen {image cogs_small} bei der Werkbank!",
  },
  {
    "key": "conversation_t0dmfu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w2gq2j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Benutze ein paar Rädchen an der Werkbank, jetzt!",
  },
  {
    "key": "conversation_w2gq2j_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_enxhfq_text",
    "metadata": {
      "notes": "*format* *new* rephrased this line",
    },
    "value": "Wow! Dieser Ort ist fantastisch!",
  },
  {
    "key": "conversation_enxhfq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dsse8r_text",
    "value": "Danke. Ich habe diese Oase geschaffen, um meinesgleichen zu versammeln. Um sie zu beschützen!",
  },
  {
    "key": "conversation_dsse8r_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_fu699v_text",
    "value": "Solange ich sie beruhigen und zufriedenstellen kann, bleiben sie hier. Sicher im inneren.",
  },
  {
    "key": "conversation_fu699v_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hx3qqt_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Zumindest war es so, bis dein Freund uns diese Beben bescherte.",
  },
  {
    "key": "conversation_hx3qqt_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_6o8eta_text",
    "value": "Warum würde Rusty so etwas tun? Er hat {format emph}sein Leben riskiert{format reset}, um uns alle vor Vectron zu beschützen.",
  },
  {
    "key": "conversation_6o8eta_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x9aify_text",
    "value": "Wie gut kanntest du ihn wirklich? Vielleicht hat ihn sein Kampf gegen dieses funkelnde Ungetüm verändert?",
  },
  {
    "key": "conversation_x9aify_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_y8f4q2_text",
    "value": "Genau das ist es, was Vectron tut ... {format nervous}Es verändert dich.{format reset}",
  },
  {
    "key": "conversation_y8f4q2_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qjs5hn_text",
    "value": "Er kam hier runter und behauptete, er würde die Mine über unseren Köpfen zum Einsturz bringen. Wir hatten Mühe, ihm Einhalt zu gebieten.",
  },
  {
    "key": "conversation_qjs5hn_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mbjnhf_text",
    "value": "Es tut mir leid, ich kann nicht ... Wenn ich ihn nur finden ... mit ihm reden könnte ...",
  },
  {
    "key": "conversation_mbjnhf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7sza3z_text",
    "value": "Du glaubst an ihn, das verstehe ich, aber wenn du die Quelle der Beben finden kannst, wirst du es selbst sehen.",
  },
  {
    "key": "conversation_7sza3z_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hihmd6_text",
    "metadata": {
      "notes": "*new* rephrasing and added an emphasis",
    },
    "value": "Du kannst uns vielleicht helfen, diese Beben zu stoppen. Ich werde versuchen, dir bei deiner Suche zu helfen.",
  },
  {
    "key": "conversation_hihmd6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_47pkq7_text",
    "metadata": {
      "notes": "*new* added a bit at the end to this one.",
    },
    "value": "{format highlight}Betritt die Bergbaustation{format reset}, die ich als Lager verwende. Die alte Gerätemaschine dort sollte noch funktionieren.",
  },
  {
    "key": "conversation_47pkq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_m6cj0e_text",
    "value": "{format highlight}Betritt die Bergbaustation{format reset} und nimm dir, was immer du brauchst.",
  },
  {
    "key": "conversation_m6cj0e_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_4vzxih_text",
    "value": "Schön, dass du etwas Nützliches in meinem Lager finden konntest. Du siehst bereit aus.",
  },
  {
    "key": "conversation_4vzxih_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_f1jnf5_text",
    "value": "Jetzt musst du für mich herausfinden, wo diese Erdbeben herkommen, und sie stoppen.",
  },
  {
    "key": "conversation_f1jnf5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ln5j60_text",
    "value": "Hilf mir, meine Sippe zu beschützen! Ich gebe schon alles, was ich kann, nur damit sie auf mich hören.",
  },
  {
    "key": "conversation_ln5j60_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_u5463y_text",
    "value": "Ich weiß nichts weiter über die Beben, aber vielleicht kannst du ja an der Oberfläche {format highlight}einen schlauen Bot finden{format reset}?",
  },
  {
    "key": "conversation_u5463y_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_dohwhw_text",
    "value": "Vielleicht werde ich dann herausfinden, wohin Rusty verschwunden ist ... endlich!",
  },
  {
    "key": "conversation_dohwhw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_77fdqq_text",
    "value": "{format highlight}Finde einen intelligenten Roboter{format reset} an der Oberfläche.",
  },
  {
    "key": "conversation_77fdqq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_0jmccn_text",
    "value": "Er kann dich vielleicht zum Ursprungsort lenken, von dem die Beben kommen.",
  },
  {
    "key": "conversation_0jmccn_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_xpdrbe_text",
    "value": "Ich fand heraus, dass das letzte Erdbeben aus dem östlichen Tempel kam.",
  },
  {
    "key": "conversation_xpdrbe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oqlaq7_text",
    "value": "Dort gibt es einen Kult, der aus einem Haufen Zerstörung verehrender Dumpfbacken besteht.",
  },
  {
    "key": "conversation_oqlaq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_1kkqf6_text",
    "value": "Ja, mit denen habe ich so meine Erfahrungen.",
  },
  {
    "key": "conversation_1kkqf6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_v0wzpo_text",
    "value": "Sie werden wahrscheinlich alles verteidigen, was mit den Beben zu tun hat.",
  },
  {
    "key": "conversation_v0wzpo_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_nytcr5_text",
    "value": "Du musst den {format highlight}Tempel nach der Quelle der Beben durchsuchen{format reset}.",
  },
  {
    "key": "conversation_nytcr5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_x2gmu8_text",
    "value": "Du musst den {format highlight}Tempel nach der Quelle der Beben durchsuchen{format reset}.",
  },
  {
    "key": "conversation_x2gmu8_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ly3hpt_text",
    "value": "Du hattest recht, Rosie. {format highlight}Rusty steckt da mit drin{format reset}, in alledem.",
  },
  {
    "key": "conversation_ly3hpt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mp86jk_text",
    "value": "Jetzt weißt du es ... {format emph}Er ist böse!{format reset}",
  },
  {
    "key": "conversation_mp86jk_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_26ewef_text",
    "value": "Er hat diese Maschine des Jüngsten Gerichts gebaut, die die Beben erzeugt.",
  },
  {
    "key": "conversation_26ewef_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_r154n3_text",
    "value": "Du musst diese {format highlight}Maschine zerstören!{format reset} Ich möchte, dass meine Sippe sicher ist, aber das Ding ist eine Gefahr für alles und jeden.",
  },
  {
    "key": "conversation_r154n3_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mlv5kh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Worauf warten wir? Es gibt Dinge zu demolieren!",
  },
  {
    "key": "conversation_mlv5kh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_607awg_text",
    "value": "Du hast eine Chance, die Erdbeben zu stoppen. {format highlight}Zerstöre die Maschine des Jüngsten Gerichts!{format reset}",
  },
  {
    "key": "conversation_607awg_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ck3lck_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir konnten das Ding außer Gefecht setzen, das für die Erdbeben verantwortlich war.",
  },
  {
    "key": "conversation_ck3lck_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kd9cyi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Fantastisch! Du hast es tatsächlich geschafft!",
  },
  {
    "key": "conversation_kd9cyi_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mw42bj_text",
    "value": "Ja, wir haben es geschafft!",
  },
  {
    "key": "conversation_mw42bj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3beotd_text",
    "value": "Und immer noch keine Spur von Rusty ...",
  },
  {
    "key": "conversation_3beotd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_akywya_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hm ... Wenn das Ding, das du Vectron nennst, ihn verändert hat, ist er vielleicht dort unten? Unter den Überresten.",
  },
  {
    "key": "conversation_akywya_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_rwy0gr_text",
    "value": "Die Maschine des Jüngsten Gerichts {format emph}bestand{format reset} zum Teil aus Vectron-Technologie ...",
  },
  {
    "key": "conversation_rwy0gr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ucjkci_text",
    "value": "Oh nein, ich weiß was du denkst! Ich will dort nicht {format nervous}wieder hin!{format reset}",
  },
  {
    "key": "conversation_ucjkci_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7irted_text",
    "value": "Du weißt nicht wie es ist, dort drin zu sein. Wie es ist, keinen eignen Willen zu haben.",
  },
  {
    "key": "conversation_7irted_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_21ym6y_text",
    "value": "Ich bin schon soweit gekommen ... Ich kann jetzt nicht aufhören. Wenn du mir den Eingang zeigen könntest, Fen ...",
  },
  {
    "key": "conversation_21ym6y_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oredyt_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Warum? Warum können wir nicht einfach irgendwelche Sachen demolieren?",
  },
  {
    "key": "conversation_oredyt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tc3nlv_text",
    "metadata": {
      "notes": "*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    },
    "value": "Er hat Vectron zu Fall gebracht. Rusty hat uns gerettet ...",
  },
  {
    "key": "conversation_tc3nlv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0xyfid_text",
    "value": "...",
  },
  {
    "key": "conversation_0xyfid_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uvs1vb_text",
    "value": "Ich führe dich dorthin. Aber sobald du {format highlight}Vectron betrittst{format reset}, bist du auf dich allen gestellt.",
  },
  {
    "key": "conversation_uvs1vb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pq0jjj_text",
    "value": "Um Rusty zu finden, musst du {format highlight}Vectron betreten{format reset}.",
  },
  {
    "key": "conversation_pq0jjj_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_vcgjsk_text",
    "value": "Oder wir gehen einfach ein paar Sachen wegsprengen?",
  },
  {
    "key": "conversation_vcgjsk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3bw741_text",
    "value": "Du bist {format emph}zurück{format reset} ...",
  },
  {
    "key": "conversation_3bw741_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_6r8y8d_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ja ... Ich konnte jedoch keine Spur von Rusty finden.",
  },
  {
    "key": "conversation_6r8y8d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jdhos3_text",
    "value": "Aber wir konnten in Erfahrung bringen, dass da draußen noch mehr {format emph}Maschinen des Jüngsten Gerichts{format reset} sind.",
  },
  {
    "key": "conversation_jdhos3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hlfgz1_text",
    "value": "Natürlich! Er ist zu gerissen, um alles auf eine Karte zu setzen.",
  },
  {
    "key": "conversation_hlfgz1_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_kix6a6_text",
    "value": "Etwas muss unternommen werden. Du musst sie{format emph}alle finden{format reset}! Niemand ist sicher, bis du sie alle gefunden hast.",
  },
  {
    "key": "conversation_kix6a6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_58f8ga_text",
    "metadata": {
      "notes": "*new* added "Dorothy"",
    },
    "value": "Dorothy ... Ich weiß, wo sie sind. Ich fühlte sie so deutlich. Die Energie, die zu ihnen floss.",
  },
  {
    "key": "conversation_58f8ga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_diuokv_text",
    "value": "Eine ist in dem {format emph}Tempel, in dem du mich gefunden hast.{format reset}",
  },
  {
    "key": "conversation_diuokv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5npqb6_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Die letzte ist in diesem merkwürdigen {format emph}unterirdischen Dschungel{format reset}, an dem wir auf dem Weg hier her vorbeigekommen sind.",
  },
  {
    "key": "conversation_5npqb6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3v2hek_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Und zuletzt befindet sich eine weitere im {format emph}östlichen Tempel{format reset}.",
  },
  {
    "key": "conversation_3v2hek_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_k5nk0l_text",
    "metadata": {
      "notes": "*new* added "then" moved the line",
    },
    "value": "Alles klar, auf gehts! {format highlight}Machen wir diese Maschinen platt{format reset}!",
  },
  {
    "key": "conversation_k5nk0l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1alf3v_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Die Minen sind riesig, mit vielen Geheimnissen und Gefahen. Der direkte Weg ist nicht unbedingt der beste.",
  },
  {
    "key": "conversation_1alf3v_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_b6r8b9_text",
    "metadata": {
      "notes": "*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    },
    "value": "Dieser Düsenantrieb, den ich gefunden habe, wird uns das Erkunden erleichtern.",
  },
  {
    "key": "conversation_b6r8b9_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p2pe6o_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Jepp, wir können hier überall hindüsen, Geheimnisse ausbuddeln und uns für die totale Zerstörung ausrüsten. Na los, auf geht's!",
  },
  {
    "key": "conversation_p2pe6o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jglhmm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du musst {format highlight}die letzten Maschinen finden und zerstören{format reset}.",
  },
  {
    "key": "conversation_jglhmm_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mqmqfa_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du warst bereits in den Tempeln und mit deiner ganzen neuen Ausrüstung, sollte es ein leichtes sein, sie zu erkunden.",
  },
  {
    "key": "conversation_mqmqfa_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_v81wm2_text",
    "value": "Ich weiß aber wirklich nicht viel über den mysteriösen Dschungel dort.",
  },
  {
    "key": "conversation_v81wm2_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ckclse_text",
    "value": "Wir haben eine weitere von Rustys Maschinen zerstört.",
  },
  {
    "key": "conversation_ckclse_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wzvouk_text",
    "value": "{format laugh}Ja, das war großartig!{format reset}",
  },
  {
    "key": "conversation_wzvouk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yb1vmx_text",
    "value": "Er war ziemlich schlau, sie überall um die Mine herum zu verstecken.",
  },
  {
    "key": "conversation_yb1vmx_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hw5xmd_text",
    "value": "Es dürfte nicht leicht werden, zu den restlichen zu gelangen, selbst wenn du weißt, wo sie sind.",
  },
  {
    "key": "conversation_hw5xmd_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_oeqkzs_text",
    "value": "Ich wünschte, ich könnte dir noch mehr helfen ..., aber ich muss mich um die Sicherheit der Meinen kümmern.",
  },
  {
    "key": "conversation_oeqkzs_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_1wlu3i_text",
    "value": "Ich glaube, einige von ihnen bereiten sich darauf vor, noch einmal in die Mine einzudringen.",
  },
  {
    "key": "conversation_1wlu3i_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_y85nbk_text",
    "value": "Okay, wir sollten aufbrechen und uns {format highlight}um die restlichen Maschinen kümmern{format reset}!",
  },
  {
    "key": "conversation_y85nbk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_o9wzoz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich hoffe du findest deinen Freund bald und stoppst ihn ein für alle Mal.",
  },
  {
    "key": "conversation_o9wzoz_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_g8unqh_text",
    "value": "Bitte {format highlight}zerstöre die übrigen Geräte{format reset}. Ich weiß nicht, wie lange wir hier noch durchhalten.",
  },
  {
    "key": "conversation_g8unqh_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hinklt_text",
    "value": "Hast du das Beben gespürt, nachdem wir die Maschine zerstört hatten?",
  },
  {
    "key": "conversation_hinklt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7bjdrx_text",
    "value": "Ja, ich hatte ganz schön Probleme damit, die Meinen zu beruhigen. Sie wurden alle ziemlich durchgerüttelt.",
  },
  {
    "key": "conversation_7bjdrx_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ot1xb4_text",
    "value": "Ich habe noch nicht durchgezählt. Ich hoffe einfach nur, dass alle da sind.",
  },
  {
    "key": "conversation_ot1xb4_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_8vqdk5_text",
    "metadata": {
      "notes": "*new* removed a "yes"",
    },
    "value": "Es gibt noch immer eine Maschine dort draußen, um die wir uns kümmern müssen.",
  },
  {
    "key": "conversation_8vqdk5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1t4jq7_text",
    "value": "Nachdem diese teuflische Maschine ausgeschaltet worden ist, werden wir alle hoffentlich endlich Frieden finden.",
  },
  {
    "key": "conversation_1t4jq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_5hrt2a_text",
    "value": "Bitte {format highlight}vernichte die letzte Maschine{format reset}, damit wir endlich in Frieden leben können!",
  },
  {
    "key": "conversation_5hrt2a_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_2jw2v2_text",
    "value": "Du scheinst irgendwie anders zu sein als der Rest deiner Art.",
  },
  {
    "key": "conversation_2jw2v2_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_pf575r_text",
    "value": "Ich hätte nie gedacht, dass ich je einen Dampfbot treffen würde, der mir einigermaßen sympathisch ist.",
  },
  {
    "key": "conversation_pf575r_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_tb8lha_text",
    "value": "Hey! Ich habe nie gestattet, diese Röhren erneut zu öffnen.",
  },
  {
    "key": "conversation_tb8lha_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_c3vudp_text",
    "value": "Hau dir einen Bolzen in den Kiefer! Die Röhren sind der beste Weg, um sich in den Minen zu bewegen.",
  },
  {
    "key": "conversation_c3vudp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_of6kl3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Der Rotfelsgang ist aufgrund all dieser Erdbeben eingestürzt und nicht passierbar.",
  },
  {
    "key": "conversation_of6kl3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p4u169_text",
    "value": "Du kannst nicht beweisen, dass das Erdbeben dafür verantwortlich ist! Dafür gibt es viele mögliche Ursachen.",
  },
  {
    "key": "conversation_p4u169_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wr7t16_text",
    "value": "Wie auch immer, ich brauche Sprengstoff, um den Weg freizusprengen.",
  },
  {
    "key": "conversation_wr7t16_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ljkhuj_text",
    "value": "Ich wette, dass du unten in der Sprengladungsstation {format highlight}etwas Sprengstoff finden{format reset} kannst.",
  },
  {
    "key": "conversation_ljkhuj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_kf7hxd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Halte einfach mehr Richtung Osten, wenn du wieder runter gehst, und du wirst es finden.",
  },
  {
    "key": "conversation_kf7hxd_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_fsgerc_text",
    "value": "Wie dem auch sei – ich spiele mit dem Gedanken, Sprengstoff zu verwenden, um den Weg freizuräumen.",
  },
  {
    "key": "conversation_fsgerc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_atnqc9_text",
    "value": "Ah, wie ich sehe, ist irgendjemand da unten bei der Sprengladungsstation. Du räumst {format highlight}den Weg frei{format reset}, Schatzi!",
  },
  {
    "key": "conversation_atnqc9_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_7mti7b_text",
    "value": "{format nervous}AUTSCH!{format reset}",
  },
  {
    "key": "conversation_7mti7b_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_bg1gtj_text",
    "metadata": {
      "notes": "*new* changed a ) to a }",
    },
    "value": "{format nervous}... was?{format reset}",
  },
  {
    "key": "conversation_bg1gtj_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_5yt2bx_text",
    "value": "Verstärkungen! Sie müssen schnell erledigt werden, bevor sie sich noch vermehren!",
  },
  {
    "key": "conversation_5yt2bx_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0y97x7_text",
    "value": "Ein weiteres Beben ... und ein weiterer gewaltätiger Bot. Immer wachsam bleiben, Shawn!",
  },
  {
    "key": "conversation_0y97x7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_swc23b_text",
    "value": "Du kannst sprechen?",
  },
  {
    "key": "conversation_swc23b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sa7wlq_text",
    "value": "Warum sollte ich denn nicht sprechen können? Hast du schon mal {format emph}versucht{format reset}, mit einem von uns zu sprechen, Roboter?",
  },
  {
    "key": "conversation_sa7wlq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_h9pnyw_text",
    "value": "Du hast recht, es tut mir leid. Ich bin nicht hier, um einen Streit anzufangen. Ich bin einfach nur auf der Suche nach meinem Freund.",
  },
  {
    "key": "conversation_h9pnyw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mkx6nq_text",
    "value": "Sieht dein Freund zufällig wie eine bräunliche Schildkröte aus, die man mit einer Konservendose kreuzen wollte?",
  },
  {
    "key": "conversation_mkx6nq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_jignph_text",
    "value": "Ja! hast du ihn gesehen? Was ist mit ihm passiert? Wo ist er?",
  },
  {
    "key": "conversation_jignph_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ryszmg_text",
    "value": "Hm ... Es ist wahrscheinlich nicht besonders ratsam, einen Dampfbot reinzulassen, aber du siehst mir nicht wie ein Lügner aus.",
  },
  {
    "key": "conversation_ryszmg_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_2r5k9z_text",
    "value": "Ich bin Rosie. Komm schon rein, wir {format highlight}unterhalten uns drinnen{format reset} und ich erzähle dir, was ich weiß.",
  },
  {
    "key": "conversation_2r5k9z_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ty7umo_text",
    "value": "Schhh ... Du bist genauso laut wie die kleine Rosie.",
  },
  {
    "key": "conversation_ty7umo_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_35muig_text",
    "value": "Schhh ...",
  },
  {
    "key": "conversation_35muig_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_trxx9s_text",
    "metadata": {
      "notes": "She has a fishing pole",
    },
    "value": "Schhh ... Du verscheuchst sie noch ...",
  },
  {
    "key": "conversation_trxx9s_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_bcfgsy_text",
    "value": "Das soll jetzt keine Kritik sein, aber: Ich glaube nicht, dass Fisch im Schlamm überleben kann-",
  },
  {
    "key": "conversation_bcfgsy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ufdh71_text",
    "value": "Fisch? Was für Fisch? Das sind meine Schuhe! Diese schlüpfrigen Dinger machen, was sie wollen!",
  },
  {
    "key": "conversation_ufdh71_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_x3mdff_text",
    "value": "Cleo braucht neue Schuhe, komm her Schühchen ...",
  },
  {
    "key": "conversation_x3mdff_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_6wq728_text",
    "metadata": {
      "notes": "*new* run offt is old 20's hillbilly-talk.",
    },
    "value": "Schühchen ... schwimmt hierher und schützt die Füßies, damit Cleo richtig fett zutreten kann!",
  },
  {
    "key": "conversation_6wq728_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_vrn5ho_text",
    "value": "Ich bin mir sicher, dass sie nicht schwimmen können ...",
  },
  {
    "key": "conversation_vrn5ho_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_syk9tk_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Cleo merkt, dass du nicht viel von Schuhen verstehst.",
  },
  {
    "key": "conversation_syk9tk_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_ejlda7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wie sind sie denn sonst hier runter in den Mondsaft gekommen, hm?",
  },
  {
    "key": "conversation_ejlda7_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_9ssddv_text",
    "value": "Schuhe können nicht schwimmen. Pah! Du hast doch keine Ahnung!",
  },
  {
    "key": "conversation_9ssddv_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_f5fe22_text",
    "value": "Schon Glück gehabt, beim Fangen deiner Schuhe?",
  },
  {
    "key": "conversation_f5fe22_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uwbwbt_text",
    "metadata": {
      "notes": "*new* Speachimpediment: "Dry mouf"="dry mouth"",
    },
    "value": "Ach, was soll's. Zum Teufel mit den Schühchen. Cleo hat jetzt Lust darauf, irgendwelche Dinge wegzukicken.",
  },
  {
    "key": "conversation_uwbwbt_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_7dil67_text",
    "value": "Cleo hat 'nen Plan! Cleo wird diesen Ort hier hinter sich lassen und nie wieder an die Schuhe denken.",
  },
  {
    "key": "conversation_7dil67_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_e7vvqa_text",
    "value": "Okay ...",
  },
  {
    "key": "conversation_e7vvqa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mkd1g9_text",
    "metadata": {
      "notes": "You dumb bucket thing, Cleo should kick you before say more stupid things.",
    },
    "value": "Du dummes Kübelhaubendingsda. Cleo sollte dich wegkicken, bevor du noch mehr dumme Dinge sagst.",
  },
  {
    "key": "conversation_mkd1g9_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_7c453w_text",
    "metadata": {
      "notes": "Pay attention to the translation of "moon juice"",
    },
    "value": "Cleo wird bald verschwinden ... uns geht der Mondsaft aus.",
  },
  {
    "key": "conversation_7c453w_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_nny1i7_text",
    "metadata": {
      "notes": "thursty",
    },
    "value": "Cleo ist durstig.",
  },
  {
    "key": "conversation_nny1i7_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_atofqv_text",
    "value": "Hier, Schuhi, Schuhi, Schuhi!",
  },
  {
    "key": "conversation_atofqv_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_dk7b1d_text",
    "value": "Meine große, weichherzig Tochter lässt einen Dampfbot herein? Sie ist wohl doch dümmer, als sie aussieht!",
  },
  {
    "key": "conversation_dk7b1d_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_0fdyik_text",
    "value": "Was macht ihr dürren Metalldinger überhaupt hier?",
  },
  {
    "key": "conversation_0fdyik_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_xx02dp_text",
    "value": "Rosie hat mich eingeladen, ein wenig zu reden.",
  },
  {
    "key": "conversation_xx02dp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qvnh5f_text",
    "value": "Typisch für meine weiche, mutierte Tochter. All ihre Muskeln würden nicht einmal ausreichen, um eine Dose zu zerquetschen.",
  },
  {
    "key": "conversation_qvnh5f_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_n9fykw_text",
    "value": "Das ist aber nicht sehr nett.",
  },
  {
    "key": "conversation_n9fykw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mypcv4_text",
    "metadata": {
      "notes": "*new* rephrased. Boom sticks here are sticks of dynamite",
    },
    "value": "Was sollen wir sonst mit dem Dynamit machen!",
  },
  {
    "key": "conversation_mypcv4_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_e6z5ja_text",
    "value": "Ich mag diesen fleischigen Fleischsack.",
  },
  {
    "key": "conversation_e6z5ja_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3zke2l_text",
    "value": "Was glaubt ihr Konservenbüchsen, wie viele Stangen man braucht, um einen von euch wegzublasen?",
  },
  {
    "key": "conversation_3zke2l_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_a9cchj_text",
    "value": "Ich mag es nicht, wenn in unserer Oase überall Blechdosen herumhängen.",
  },
  {
    "key": "conversation_a9cchj_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_9svalt_text",
    "value": "Rosie hätte euch alle plattmachen sollen, anstatt euch reinzulassen.",
  },
  {
    "key": "conversation_9svalt_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_3su3ui_text",
    "value": "In den guten alten Tagen sind wir durch die Minen gestapft. Und wenn wir jemanden gefunden haben, dessen Blech uns nicht passte, haben wir ihn weggesprengt.",
  },
  {
    "key": "conversation_3su3ui_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_oza28i_text",
    "value": "Dieser Fleischsack wird ja immer lustiger und unterhaltsamer.",
  },
  {
    "key": "conversation_oza28i_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yrhik2_text",
    "value": "Pass ja auf, du!",
  },
  {
    "key": "conversation_yrhik2_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_ihr9we_text",
    "value": "Ich bin es leid, hier in meinen Pantoffeln herumzuschlurfen.",
  },
  {
    "key": "conversation_ihr9we_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_agybew_text",
    "value": "Ich sollte dort raus gehen und die Erdbeben und die seltsamen Dschungelpflanzen einfach alle wegsprengen.",
  },
  {
    "key": "conversation_agybew_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_nvv14n_text",
    "metadata": {
      "notes": "Pay attention to translation of Moon Juice",
    },
    "value": "Aber ich werde mir vorher noch einen köstlichen Schluck Mondsaft gönnen ... und danach bin ich weg.",
  },
  {
    "key": "conversation_nvv14n_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_ezltzc_text",
    "value": "Vielleicht, wenn ich ein paar Dynamitstangen zusammenbinde und in ein Loch stecke? Um diesen Erdbeben zu zeigen, wer hier der Boss ist?!",
  },
  {
    "key": "conversation_ezltzc_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_2h242j_text",
    "value": "Hau ab! Ich möchte mein Dynamit nicht an jemanden wie dich verschwenden.",
  },
  {
    "key": "conversation_2h242j_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_146h2g_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_146h2g_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_w42y9y_text",
    "value": "Hau ab ... weg hier ... du ... du Getriebe Gustav!",
  },
  {
    "key": "conversation_w42y9y_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_lbsxjr_text",
    "value": "Ich bin nicht gefährlich. Ich habe mich nur gefragt, ob ...",
  },
  {
    "key": "conversation_lbsxjr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_76kde3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_76kde3_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_nilvvh_text",
    "value": "Okay, okay. Ich bin schon weg.",
  },
  {
    "key": "conversation_nilvvh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nrvcc5_text",
    "metadata": {
      "notes": "*new* removed all-caps",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_nrvcc5_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_na5ijp_text",
    "value": "Ich bin ziemlich gut darin, Roboter zu zerlegen, weißt du.",
  },
  {
    "key": "conversation_na5ijp_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_t4gyc9_text",
    "value": "Wenn ich nicht jede Woche mindestens einen auseinandernehme, werde ich ganz hibbelig.",
  },
  {
    "key": "conversation_t4gyc9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_8z4duw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Und hab' mich so gut wie gar nicht verletzt. Einen meiner Arme musste ich nachwachsen lassen ... Ja, das war alles.",
  },
  {
    "key": "conversation_8z4duw_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_68xyfp_text",
    "value": "War nicht mal mein Abstech-Arm. Was ein Glück!",
  },
  {
    "key": "conversation_68xyfp_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_4tb6xl_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_4tb6xl_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_mfx4dl_text",
    "value": "Ja, ich habe an einem Roboschrottkampf teilgenommen.",
  },
  {
    "key": "conversation_mfx4dl_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2z93th_text",
    "metadata": {
      "notes": "*new* removed "That"",
    },
    "value": "Rosie mag es nicht, wenn ich in die Mine gehe und irgendwelche Dinge absteche.",
  },
  {
    "key": "conversation_2z93th_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2r5nu3_text",
    "value": "Klingt logisch.",
  },
  {
    "key": "conversation_2r5nu3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_10fkd9_text",
    "value": "Zurück mit dir! Bevor ich mich mit meinem Stecherino an deinem Getriebe zu schaffen mache!",
  },
  {
    "key": "conversation_10fkd9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_sp7pdd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_sp7pdd_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_6iq52s_text",
    "value": "Du weißt doch, ich stehe darauf, irgendwelche Dinge abzustechen.",
  },
  {
    "key": "conversation_6iq52s_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_1su49z_text",
    "metadata": {
      "notes": "*new* removed the last "left"",
    },
    "value": "Ich träume davon, durch die Minen zu jagen und alle Bots abzustechen, links und rechts! Wir verstehen uns?",
  },
  {
    "key": "conversation_1su49z_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_azc2px_text",
    "value": "Alles klar.",
  },
  {
    "key": "conversation_azc2px_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_14e8qj_text",
    "metadata": {
      "notes": "*new* changed right to left",
    },
    "value": "Und links!",
  },
  {
    "key": "conversation_14e8qj_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_cu3ase_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_cu3ase_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_5wwgu9_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_5wwgu9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_rnl3im_text",
    "value": "Ich will einfach nur dort raus gehen und mein' Stecherino benutzen.",
  },
  {
    "key": "conversation_rnl3im_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2kxxoa_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Stich, Stich, Messerstecherino!",
  },
  {
    "key": "conversation_2kxxoa_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_iyd9iu_text",
    "value": ""Achtung! Erdbeben! Kontaktiert den Bürgermeister von El Machino, um zusätzliche Informationen zu erhalten."",
  },
  {
    "key": "conversation_iyd9iu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jn4gij_text",
    "value": ""Minenarbeiter gesucht! Macht im Osten von El Machino weiter und fördert eure eigene Zukunft zutage!"",
  },
  {
    "key": "conversation_jn4gij_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_04wf3d_text",
    "value": "Ich habe noch nie zuvor einen sprechenden Schnapsi getroffen. Normalerweise sind sie einfach nur verwirrt und gefährlich.",
  },
  {
    "key": "conversation_04wf3d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mlu9ml_text",
    "value": "Ja ... was für eine Enttäuschung!",
  },
  {
    "key": "conversation_mlu9ml_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mcuc1c_text",
    "metadata": {
      "notes": "*new* removed and, added this",
    },
    "value": "Ich gehe los und werde {format highlight}mit dieser Rosie sprechen{format reset}. Sie könnte vielleicht wissen, wo Rusty steckt.",
  },
  {
    "key": "conversation_mcuc1c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_z2w2u3_text",
    "metadata": {
      "notes": "*format* *new* also removed the line break (\\n}",
    },
    "value": "H-h-h-heeeey! Wie is'n deine Meinung?",
  },
  {
    "key": "conversation_z2w2u3_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_n2ebi3_text",
    "value": "Iiihhh! Vernichte das Ding, sofort!",
  },
  {
    "key": "conversation_n2ebi3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kljpda_text",
    "value": "{format nervous}Oha! Ein weiteres Erdbeben!{format reset}",
  },
  {
    "key": "conversation_kljpda_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t7sxdc_text",
    "value": "Oh Rusty, wo {format emph}bist du nur hin{format reset}?",
  },
  {
    "key": "conversation_t7sxdc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vmz2v5_text",
    "value": "Das ist er! Der Eingang zu Vectron.",
  },
  {
    "key": "conversation_vmz2v5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_iupd4b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Okay, lass uns das Ding betreten?",
  },
  {
    "key": "conversation_iupd4b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_bbcmp1_text",
    "metadata": {
      "notes": "*format* *new*'",
    },
    "value": "Ich habe dir doch gesagt, dass ich {format emph}dort{format reset} nicht reingehe. Ich will nicht ...",
  },
  {
    "key": "conversation_bbcmp1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1rh2uj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Selbst wenn ich es wöllte, es wäre mir nicht möglich. Nicht durch ein Portal wie {format emph}dieses{format reset}.",
  },
  {
    "key": "conversation_1rh2uj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pkxjfo_text",
    "value": "Aber ich habe dir versprochen, dass ich {format emph}dich{format reset} dort hineinbringen werde ...",
  },
  {
    "key": "conversation_pkxjfo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_emqhdd_text",
    "value": "Wenn auch nur die geringste Chance besteht, dass Rusty irgendwo dort drinnen ist, muss ich gehen.",
  },
  {
    "key": "conversation_emqhdd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1rkegt_text",
    "value": "Dann musst du aufbrechen, nehme ich an ...",
  },
  {
    "key": "conversation_1rkegt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qrn9qn_text",
    "metadata": {
      "notes": "*new* moved here from fen_vectron_teleporter_bye",
    },
    "value": "Du wirst dort drinnen allein und auf dich gestellt sein. Und du wirst auch keinen Zugriff mehr auf meine Karte haben.",
  },
  {
    "key": "conversation_qrn9qn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_sfgslu_text",
    "metadata": {
      "notes": "*new* moved here from fen_vectron_teleporter_by",
    },
    "value": "Du wirst also deinen eigenen Weg finden müssen.",
  },
  {
    "key": "conversation_sfgslu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_j9uqnv_text",
    "value": "Bist du wirklich sicher, dass du das tun willst?",
  },
  {
    "key": "conversation_j9uqnv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_69953l_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "Okay ...",
  },
  {
    "key": "conversation_69953l_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yjswup_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dann mal los ...",
  },
  {
    "key": "conversation_yjswup_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uwxfmo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ja, {format emph}Ich{format reset} werde dich ganz sicher nicht davon abbringen.",
  },
  {
    "key": "conversation_uwxfmo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_91l718_text",
    "value": "Ich werde für dich zurückkommen, sobald ich draußen bin.",
  },
  {
    "key": "conversation_91l718_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vmzz9y_text",
    "value": "...",
  },
  {
    "key": "conversation_vmzz9y_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_u6n77q_text",
    "value": "Wenn du dort drin eine Bewegung erkennst, lauf. Lauf so schnell du kannst ...",
  },
  {
    "key": "conversation_u6n77q_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_vctaoa_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_vctaoa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sp4sbx_text",
    "value": "Fen?",
  },
  {
    "key": "conversation_sp4sbx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rj6ww8_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "FEN?!",
  },
  {
    "key": "conversation_rj6ww8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ad0u27_text",
    "metadata": {
      "notes": "*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    },
    "value": "Fen? Ich bin ... Ich bin Fen.",
  },
  {
    "key": "conversation_ad0u27_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_1ajm6u_text",
    "value": "Dorothy?",
  },
  {
    "key": "conversation_1ajm6u_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_wgoby1_text",
    "value": "RUSTY!",
  },
  {
    "key": "conversation_wgoby1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_r5a8b8_text",
    "value": "RUSTY?!",
  },
  {
    "key": "conversation_r5a8b8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pgjtz4_text",
    "value": "Komm schon Fen! Wir müssen uns beeilen!",
  },
  {
    "key": "conversation_pgjtz4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uzk2jn_text",
    "value": "Auf diese Weise werden wir es nie {format nervous}zurück in die Stadt schaffen{format reset} ...",
  },
  {
    "key": "conversation_uzk2jn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5rvneb_text",
    "metadata": {
      "notes": "*new* changed the format to affect more words",
    },
    "value": "Aber ich kann {format emph}euch beide{format reset} rechtzeitig rausbringen.",
  },
  {
    "key": "conversation_5rvneb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_32yflg_text",
    "value": ""WIR HABEN GESCHLOSSEN! GEHEN SIE NACH HAUSE!"",
  },
  {
    "key": "conversation_32yflg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ghi2wb_text",
    "value": "Hey, dieses Ding {format nervous}spielt verrückt!{format reset}",
  },
  {
    "key": "conversation_ghi2wb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_8xsftw_text",
    "metadata": {
      "notes": "*new* changed formated text from highlight to emph",
    },
    "value": "Los, verschwinden wir von hier! {format emph}Jetzt!{format reset}",
  },
  {
    "key": "conversation_8xsftw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4v2csa_text",
    "value": "Professorin Shermans Rakete!",
  },
  {
    "key": "conversation_4v2csa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_izxx5d_text",
    "value": "Wir müssen jetzt zurück zur Stadt!",
  },
  {
    "key": "conversation_izxx5d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x1pswz_text",
    "value": "Los jetzt! {format emph}Die Zeit rennt uns davon!{format reset}",
  },
  {
    "key": "conversation_x1pswz_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_bfup2f_text",
    "value": "Wir haben keine Zeit, um zu überlegen!",
  },
  {
    "key": "conversation_bfup2f_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_2ez9yy_text",
    "value": "Los!",
  },
  {
    "key": "conversation_2ez9yy_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_kuytvd_text",
    "value": "Du hast lange genug den Helden gespielt.",
  },
  {
    "key": "conversation_kuytvd_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_qsa1um_text",
    "value": "Wir sehen uns, Dot ...",
  },
  {
    "key": "conversation_hwmfh6_text",
    "value": "Ich würde mir wünschen, dass Bürgermeister Yonker der Vernunft zugänglich wäre.",
  },
  {
    "key": "conversation_hwmfh6_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_d0ozct_text",
    "value": "Es hat keinen Sinn, Personen überzeugen zu wollen, für die zu viel auf dem Spiel steht, wenn ihre Lügen in sich zusammenfallen, – und die sich selbst betrogen haben.",
  },
  {
    "key": "conversation_d0ozct_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_bdyzc2_text",
    "value": "Irgendetwas an diesen Erbeben ist irgendwie seltsam.",
  },
  {
    "key": "conversation_bdyzc2_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_tjv7fp_text",
    "metadata": {
      "notes": "*new* changes since earlier version could be off in some instances.",
    },
    "value": "Wow! Die Rakete sieht echt hammermäßig aus!",
  },
  {
    "key": "conversation_tjv7fp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t09utv_text",
    "metadata": {
      "notes": "*new* rephrased to work with new version of above line",
    },
    "value": "Nun ja, da sich der Bürgermeister momentan ziemlich unlogisch verhält, muss ich auf Eventualitäten vorbereitet sein.",
  },
  {
    "key": "conversation_t09utv_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_f7plgb_text",
    "value": "Mein Seismometer sagt mir, dass mit diesen Erdbeben irgendetwas nicht in Ordnung ist, weißt du.",
  },
  {
    "key": "conversation_f7plgb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yhfxkq_text",
    "value": "Unsere Mine befindet sich direkt an der Grenze einer Verwerfungslinie. Ein größeres Erdbeben, und bye-bye Mr. Mine!",
  },
  {
    "key": "conversation_yhfxkq_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_k00t1f_text",
    "value": "Ich hoffe, dass ich diese Rakete voll funktionsfähig bekomme, bevor es zu spät ist.",
  },
  {
    "key": "conversation_k00t1f_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_220si9_text",
    "value": "Diese neuen Erdbeben bitten förmlich darum, untersucht zu werden. Hier steht eine Menge auf dem Spiel.",
  },
  {
    "key": "conversation_220si9_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yd21lh_text",
    "value": "Nun, genau genommen treffen zwei riesige Kontinentalplatten direkt unter unseren Füßen aufeinander.",
  },
  {
    "key": "conversation_yd21lh_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yhhdlm_text",
    "value": "Die Stadt wurde auf einer Felsensäule errichtet, die dadurch entstand, dass diese beiden Platten vor Millionen von Jahren miteinander kollidierten.",
  },
  {
    "key": "conversation_yhhdlm_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_jd18od_text",
    "value": "Wow ...",
  },
  {
    "key": "conversation_jd18od_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ma515w_text",
    "value": "Ich bin aufgrund dieser seismischen Muster ein wenig besorgt.",
  },
  {
    "key": "conversation_ma515w_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_rh627j_text",
    "value": "Sie basieren definitiv nicht auf normalen Bewegungen der Erdkruste.",
  },
  {
    "key": "conversation_rh627j_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_8vxt9k_text",
    "value": "Wenn das Große Beben eintreffen sollte, würde dies die gesamte Stadt vernichten. Oder noch schlimmer: den gesamten Planeten!",
  },
  {
    "key": "conversation_8vxt9k_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_nid8rc_text",
    "value": "{format emph}Oha!{format reset} Dann wäre es wohl besser, meine Sensoren nach unten anzupassen.",
  },
  {
    "key": "conversation_nid8rc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_gqcn63_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Das ist die richtige Einstellung!",
  },
  {
    "key": "conversation_gqcn63_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_q2vvjy_text",
    "value": "Ich bin dennoch noch immer ein wenig beunruhigt, was die seismischen Muster angeht.",
  },
  {
    "key": "conversation_q2vvjy_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_46mop5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Der Schutzwall ganz unten in der Mine ist in der Tat sonderbar.",
  },
  {
    "key": "conversation_46mop5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_k6sl9a_text",
    "value": "Auch unterhalb meiner kleinen Heimatstadt, Tumbleton, gab es eine einen Wall.",
  },
  {
    "key": "conversation_k6sl9a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wb49hd_text",
    "value": "Genau genommen handelt es sich um denselben Wall. Er verläuft durchgängig und erstreckt sich über mehrere Kilometer!",
  },
  {
    "key": "conversation_wb49hd_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_prdn7m_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sie ist das größte Konstrukt, das je von Bot-Hand geschaffen wurde. Wäre sie hier oben, würdest du sie vom All aus sehen können.",
  },
  {
    "key": "conversation_prdn7m_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_0b17qr_text",
    "value": "Das Aneinandereihen all dieser Steine ... nur damit die Schnapsis nicht nach oben kommen ...",
  },
  {
    "key": "conversation_0b17qr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4s3zz6_text",
    "value": "Nun, die Schnapsis oder auch {format emph}homo cervisia{format reset} können ziemlich einfallsreich und geschickt sein, wenn es um das Anfertigen einiger ganz besonderer Gegenstände geht.",
  },
  {
    "key": "conversation_4s3zz6_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_29dn85_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "So ist beispielsweise der von ihnen gebraute Mondsaft, der es ihnen erlaubt, den unterirdischen Alltag erträglicher zu machen, etwas ganz Besonderes ...",
  },
  {
    "key": "conversation_29dn85_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_8na87z_text",
    "metadata": {
      "notes": "*new* added a comma after mutagenic",
    },
    "value": "Oblgeich mutagen, also erbgutverändernd, und süchtigmachend, ist er eine nicht zu unterschätzende Energiequelle.",
  },
  {
    "key": "conversation_8na87z_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_auy7u5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Um die Wahrheit zu sagen, habe ich mal versucht, das Zeug zu verbrennen, um es als Raketentreibstoff zu verwenden, aber ... es erwies sich als viel zu explosiv.",
  },
  {
    "key": "conversation_auy7u5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_0144bl_text",
    "value": "Der Schutzwall ist wahrlich ein ehrfurchtgebietendes Wunder, das man gesehen haben muss.",
  },
  {
    "key": "conversation_0144bl_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vfvf68_text",
    "value": "Weißt du etwas über höhlenbewohnende Pflanzen?",
  },
  {
    "key": "conversation_vfvf68_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n56yib_text",
    "value": "Nun, ich bin natürlich kein Biologie, aber ... ich würde auf irgendeine Art von Pilz tippen. Pilze sind wahre Überlebenskünstler und gedeihen nahezu überall.",
  },
  {
    "key": "conversation_n56yib_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_6u259t_text",
    "value": "Ich habe eine Höhle entdeckt, die überall damit bedeckt ist.",
  },
  {
    "key": "conversation_6u259t_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4luy17_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Eigenartig! Nun, wenn es eine Pflanze ist, dann kann sie ihre Energie jedenfalls nicht durch Fotosynthese gewinnen; das dürfte klar sein.",
  },
  {
    "key": "conversation_4luy17_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vq8bcq_text",
    "value": "Ich habe die Schnapsis gefunden. Ich habe sogar mit ihnen gesprochen! Sie haben unterhalb des Walls ein kleines Dorf errichtet.",
  },
  {
    "key": "conversation_vq8bcq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qbphbv_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Faszinierend! Ich habe schon seit Ewigkeiten nichts mehr von sprechenden Schnapsis gehört.",
  },
  {
    "key": "conversation_qbphbv_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_d8arjf_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Diejenigen, die ich mit meinen eigenen Augen gesehen habe, haben nur mithilfe von kehligen Lauten kommuniziert. Vollkommen unverständlich!",
  },
  {
    "key": "conversation_d8arjf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_m0q6cs_text",
    "value": "Ich habe einige Dateien durchgearbeitet, die die Hypothese vertreten, dass es sich bei den Schnapsis einst um die dominierende Spezies des Planeten gehandelt habe ...",
  },
  {
    "key": "conversation_m0q6cs_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_n96czx_text",
    "value": "Wir können heute natürlich nur spekulieren, wenn es darum geht, die Vergangenheit des homo cervisia korrekt zu verorten ...",
  },
  {
    "key": "conversation_n96czx_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9axbnb_text",
    "metadata": {
      "notes": "*format* *new* merged two lines into one.",
    },
    "value": "Es ist beinahe unmöglich, einige Testsubjekte dieser Spezies in Ruhe zu studieren, ohne diese ernsthaft zu beschädigen ... oder selbst einen Schaden davonzutragen.",
  },
  {
    "key": "conversation_9axbnb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_6qfwjp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Die Schnapsis sind eine faszinierende Spezies. Hinter ihren schlafen Augenlidern gibt es einen Funken von Individualität.",
  },
  {
    "key": "conversation_6qfwjp_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_wlfozb_text",
    "metadata": {
      "notes": "*new* rephrased",
    },
    "value": "Professor, du bist ein schlauer Bot. Denkst du, diese Erdbeben könnten botgemacht sein?",
  },
  {
    "key": "conversation_wlfozb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ylnbuf_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Du meinst, ob jemand diese Erdbeben künstlich erzeugt?",
  },
  {
    "key": "conversation_ylnbuf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_x4pgec_text",
    "value": "Das könnte natürlich das äußerst merkwürdige Epizentrum der letzten seismischen Aktivität erklären.",
  },
  {
    "key": "conversation_x4pgec_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_934xqz_text",
    "value": "Laut meinen Daten lag es direkt im Zentrum dieses verrückten Kults von Kleptomanen und Weltuntergangspanikern.",
  },
  {
    "key": "conversation_934xqz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_72gm7a_text",
    "value": "Also {format emph}ist es{format reset} möglich?",
  },
  {
    "key": "conversation_72gm7a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_w0qkeb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Nun, um diese Hypothese zu testen, musst du {format highlight}die Windigen Ebenen durchqueren{format reset}, und der Sache im Tempel im Osten auf den Grund gehen.",
  },
  {
    "key": "conversation_w0qkeb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_7xmo4l_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Diese Hypothese von botgemachten Erdbeben ist in der Tat ... Faszinierend.",
  },
  {
    "key": "conversation_7xmo4l_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_p7mpft_text",
    "metadata": {
      "notes": "*new* added the part about taking the ladder",
    },
    "value": "{format highlight}Durchquere die Windigen Ebenen{format reset}, um mehr zu erfahren. Klettere einfach die Leiter im Osten der Stadt hinunter.",
  },
  {
    "key": "conversation_p7mpft_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9zagcy_text",
    "value": "Der Kult beschützt eine Art von Maschine, die für die Erdbeben verantwortlich sein könnte.",
  },
  {
    "key": "conversation_9zagcy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_d8olb4_text",
    "value": "Dein nächster Schritt würde dann darin bestehen, die Maschine zu demontieren. Dies könnte die Erdbeben ein für alle Mal beenden.",
  },
  {
    "key": "conversation_d8olb4_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vts8e3_text",
    "value": "{format emph}Oh ja!{format reset} Demontieren hört sich lustig an! Ich bin dabei!",
  },
  {
    "key": "conversation_vts8e3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ly2vhz_text",
    "value": "Vielleicht kann ich mir dann sogar den Bau dieser Rakete sparen.",
  },
  {
    "key": "conversation_ly2vhz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ypryh5_text",
    "value": "Es ist immerhin keine leichte Aufgabe, ein Objekt zu konstruieren, mit dem man das All erforschen kann.",
  },
  {
    "key": "conversation_ypryh5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_qq0n6k_text",
    "value": "Wenn du den {format highlight}Erdbebengenerator demontieren{format reset} würdest, wäre ich davon verschont.",
  },
  {
    "key": "conversation_qq0n6k_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_hbhl5o_text",
    "value": "Wie bringt es ein Dampfbot zu Wege, eine Maschine herzustellen, die Erdbeben erzeugt?",
  },
  {
    "key": "conversation_hbhl5o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dpkudw_text",
    "value": "Sie müssen über eine Menge Wissen oder zumindest eine fortgeschrittene Technologie verfügen.",
  },
  {
    "key": "conversation_dpkudw_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_irqx6c_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Futuristische Technologie, die alles übersteigt, was ich bisher gesehen habe ...",
  },
  {
    "key": "conversation_irqx6c_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_gljg9h_text",
    "value": "Ich habe mir einige meiner alten Aufzeichnungen angesehen, um möglicherweise ein Muster zu erkennen ..., aber ohne Erfolg.",
  },
  {
    "key": "conversation_gljg9h_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j3paiq_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "Die erratischen Bewegungen dieser Erschütterungen deuten darauf hin, dass wir noch nicht aus dem Schneider sind.",
  },
  {
    "key": "conversation_j3paiq_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_w8nhom_text",
    "value": "Ich fühle mich definitiv noch nicht bereit, mein Herumexperimentieren mit der Rakete einzustellen.",
  },
  {
    "key": "conversation_w8nhom_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ihi6uu_text",
    "value": "Ich fühle mich noch nicht bereit, mein Herumexperimentieren mit der Rakete einzustellen.",
  },
  {
    "key": "conversation_ihi6uu_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j6jtna_text",
    "value": "Einem Kollegen von mir ist es gelungen, einige Proben des unterirdischen Dschungels zu sammeln.",
  },
  {
    "key": "conversation_j6jtna_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_oepnn1_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Seltsam, nicht wahr? Und sehr gefährlich.",
  },
  {
    "key": "conversation_oepnn1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kul85z_text",
    "value": "Ja, ziemlich cool.",
  },
  {
    "key": "conversation_kul85z_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b4ld5b_text",
    "value": "Wie dem auch sein – er meint, er sei auf mutagene Spuren gestoßen, die die Biologie der Pflanzen negativ beeinträchtigten.",
  },
  {
    "key": "conversation_b4ld5b_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_h8rkzh_text",
    "value": "Es scheint, als erhielten sie ihre Energie durch das Trinken mutagenen {format emph}Mondsaftes{format reset}, nach dem die Schnapsis so verrückt sind.",
  },
  {
    "key": "conversation_h8rkzh_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_bthpa5_text",
    "value": "Es {format emph}gibt{format reset} in diesem Gebiet eine Menge Röhren.",
  },
  {
    "key": "conversation_bthpa5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wvpx34_text",
    "value": "Dieses Röhrensystem könnte die Ursache für die Verschmutzung sein.",
  },
  {
    "key": "conversation_wvpx34_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ll0rrj_text",
    "value": "Der Dschungel ist nur ein weiteres Mysterium unter all den anderen seltsamen Ereignissen.",
  },
  {
    "key": "conversation_ll0rrj_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_gcue08_text",
    "value": "Wir haben alle Erdbebengeneratoren deaktiviert.",
  },
  {
    "key": "conversation_gcue08_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rhj5jo_text",
    "value": "Meine seismischen Daten weisen nicht mehr auf viele verschiedene, sondern nur noch auf einen einzigen Ort hin.",
  },
  {
    "key": "conversation_rhj5jo_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_pgv6y7_text",
    "value": "Der Ursprung des letzten Bebens scheint eindeutig Schnapsbergen gewesen zu sein.",
  },
  {
    "key": "conversation_pgv6y7_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j878i8_text",
    "metadata": {
      "notes": "*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    },
    "value": "Wir müssen unbedingt zurück nach unten und {format highlight}mit Rosie sprechen.{format reset}",
  },
  {
    "key": "conversation_j878i8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lv5xcl_text",
    "metadata": {
      "notes": "*new* rephrased the ending of the line.",
    },
    "value": "Bloß gut, dass meine Rakete einsatzbereit ist. Nur noch einige letzte Vorbereitungen und ich kann von hier verschwinden, wenn es sein muss.",
  },
  {
    "key": "conversation_lv5xcl_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9rxm14_text",
    "value": "Nur noch einige letzte Vorbereitungen und dann können wir den Planeten verlassen, falls uns das Große Beben mit seiner Anwesenheit beehrt.",
  },
  {
    "key": "conversation_9rxm14_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_tnyv5r_text",
    "value": "Sobald mein Forschungsschiff fertig ist, werde ich diesen Planeten hier hinter mir lassen.",
  },
  {
    "key": "conversation_tnyv5r_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_7an1z5_text",
    "value": "Und jeder, der mich begleiten will, darf dies gerne tun. Ich habe sie extra groß genug gebaut. Es gibt genug Platz für alle.",
  },
  {
    "key": "conversation_7an1z5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_f5xes1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oh, oh, oh!",
  },
  {
    "key": "conversation_f5xes1_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vwbtbo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich habe ein paar spitzenmäßige Verbesserungen für dich! Alles Technik vom Feinsten!",
  },
  {
    "key": "conversation_vwbtbo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_d17hfn_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Also, eh, tut mir leid, dich zu stören ... schon wieder.",
  },
  {
    "key": "conversation_d17hfn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_2hj8xd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aber ich habe gerade eine Lieferung neuer Teile bekommen! Damit kannst du deine Werkzeuge noch weiter verbessern.",
  },
  {
    "key": "conversation_2hj8xd_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_dnpk79_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eh ... dachte nur, du solltest das wissen.",
  },
  {
    "key": "conversation_dnpk79_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_cq63md_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hi ...?",
  },
  {
    "key": "conversation_cq63md_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_eb2wqf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Aaah{format reset}, Ich meine ... Hallo!",
  },
  {
    "key": "conversation_eb2wqf_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_6hj11o_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eh ... ich habe eine neue Lieferung erhalten!",
  },
  {
    "key": "conversation_6hj11o_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ozu5go_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Damit kannst du so ziemlich alle deine Werkzeuge verbessern ... Ich meine, noch weiter verbessern. Toll, oder?",
  },
  {
    "key": "conversation_ozu5go_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_rkault_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Mir, eh, war aufgefallen, dass deine Panzerung ein paar Dellen hatte ...",
  },
  {
    "key": "conversation_rkault_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_8lfpm2_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du kannst sie mit meiner neue Lieferung dicker Panzerplatten verbessern.",
  },
  {
    "key": "conversation_8lfpm2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kpzosz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Damit du dich dort unten besser, du weißt schon ... behaupten kannst.",
  },
  {
    "key": "conversation_kpzosz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vk0in8_text",
    "value": "Ähm ... Was möchtest du tun?",
  },
  {
    "key": "conversation_vk0in8_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xbec1d_text",
    "metadata": {
      "notes": "This is the introductary phrase from the mechanich",
    },
    "value": "Ähm ... Was möchtest du tun?",
  },
  {
    "key": "conversation_xbec1d_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4nh80e_text",
    "value": "Ähm ... Ich stehe voll auf dein Getriebe.",
  },
  {
    "key": "conversation_4nh80e_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_zb6ryl_text",
    "value": "Du ... du könntest es verbessern, indem du ein paar Rädchen verwenden würdest. Möchtest ... möchtest du wissen, wie?",
  },
  {
    "key": "conversation_zb6ryl_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_k47xd0_text",
    "metadata": {
      "notes": "This person is very nervous",
    },
    "value": "Tut mir leid ... Ich werde ruhig sein – wie?!",
  },
  {
    "key": "conversation_k47xd0_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xsq7ao_text",
    "value": "Du möchtest es wirklich wissen? Oh, okay, okay!",
  },
  {
    "key": "conversation_xsq7ao_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9iwqjw_text",
    "value": "Okay, es ... es tut mir leid. Ich werde mal besser hierüber gehen ...",
  },
  {
    "key": "conversation_9iwqjw_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_e2sw99_text",
    "metadata": {
      "notes": "*new* added {format highlight}",
    },
    "value": "Du kannst ... ähm ... mit ein paar Rädchen {image cogs_small} deine {format highlight}Werkzeuge verbessern{format reset}.",
  },
  {
    "key": "conversation_e2sw99_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qsonke_text",
    "value": "Du hast sie möglicherweise hier und da bereits herumliegen sehen.",
  },
  {
    "key": "conversation_qsonke_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9chqoj_text",
    "value": "Verwende die Werkbank, um den Rädchen-Platz eines Werkzeugs auszuwählen, und platziere deine Rädchen {image cogs_small} darin.",
  },
  {
    "key": "conversation_9chqoj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_0dnnax_text",
    "metadata": {
      "notes": "*new* added {format highlight}",
    },
    "value": "Und mache dir keine Sorgen ... Du kannst {format highlight}eingesetzte Rädchen {image cogs_small} ganz einfach wieder entfernen{format reset}.",
  },
  {
    "key": "conversation_0dnnax_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_90zfu2_text",
    "value": "Während du deine Instrumente aufwertest, wirst du Zugang zu noch cooleren Verbesserungen erhalten.",
  },
  {
    "key": "conversation_90zfu2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_a5snuc_text",
    "value": "So, es gäbe zwar noch einige Dinge, die dich dir erzählen könnte, aber wenn du nicht willst ...",
  },
  {
    "key": "conversation_a5snuc_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_b1szsc_text",
    "value": "Für einige Verbesserungen existieren Blaupausen, die du zunächst finden musst.",
  },
  {
    "key": "conversation_b1szsc_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_f0xxtp_text",
    "value": "Davy Dumpfbacke, unser ... ähm ... Kartograf, hat einige davon zur Hand, glaube ich.",
  },
  {
    "key": "conversation_f0xxtp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1q2dd2_text",
    "value": "Blaupausenverbesserungen sind normalerweise richtig cool. Zumindest glaube ich das ...",
  },
  {
    "key": "conversation_1q2dd2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_i2a540_text",
    "value": "Oh, und da du, wie bereits gesagt, alle Rädchen {image cogs_small} problemlos wieder entfernen kannst, möchtest du vielleicht ein wenig experimentieren.",
  },
  {
    "key": "conversation_i2a540_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_5p4bi7_text",
    "value": "Ändere doch einfach ab und zu deine Rädchen. Das heißt, wenn du das möchtest.",
  },
  {
    "key": "conversation_5p4bi7_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_iq6h9b_text",
    "value": "Ähm ... Du hast dir wirklich alles angehört! Das tun nicht viele ...",
  },
  {
    "key": "conversation_iq6h9b_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_e4vdfi_text",
    "value": "Okay, ich werde hier sein, denke ich.",
  },
  {
    "key": "conversation_e4vdfi_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9lkkka_text",
    "value": "Diese Ort kommt mir irgendwie vertraut vor. Vielleicht hat mich der Kult irgendwann mal hierher geführt.",
  },
  {
    "key": "conversation_9lkkka_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qsa4d1_text",
    "value": "Was glaubst du, in welcher Tiefe befinden sich {format nervous}die Überreste von Vectron{format reset}?",
  },
  {
    "key": "conversation_qsa4d1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3rahmd_text",
    "value": "Es ist noch ein langer Weg bis runter. Wir befinden uns noch immer in den erkundeten Minenbereichen.",
  },
  {
    "key": "conversation_3rahmd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xecqeg_text",
    "value": "Ah, okay. Ich begann bereits, mich zu wundern.",
  },
  {
    "key": "conversation_xecqeg_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mx4ktk_text",
    "value": "Nun muss ich nur noch einen Weg durch diesen vermaledeiten Wall finden.",
  },
  {
    "key": "conversation_mx4ktk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cat8cu_text",
    "value": "Oh jaa! {format singsong}Zeit für Explosionen!{format reset}",
  },
  {
    "key": "conversation_cat8cu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nq5gxh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Das wird nicht genügen. Dieser Wall wurde nach den Alkkriegen errichtet, um diese Spinner am Hochkommen zu hindern.",
  },
  {
    "key": "conversation_nq5gxh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_gu7tji_text",
    "value": "Und da Schnapsis Experten darin sind, Dinge in die Luft zu jagen, hält der Wall sogar starken Explosionen stand.",
  },
  {
    "key": "conversation_gu7tji_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mbv8tf_text",
    "metadata": {
      "notes": "Place, refering to the underground jungle that they just passed thruogh.",
    },
    "value": "Der Ort war {format nervous}ziemlich seltsam!{format reset}",
  },
  {
    "key": "conversation_mbv8tf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cj1k6o_text",
    "value": "Offenbar hat es mich durch die erste Schicht des Walls gebracht.",
  },
  {
    "key": "conversation_cj1k6o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_5mo9pe_text",
    "value": "Ich hoffe, dass die Bergbaustation hier irgendwo in der Nähe ist.",
  },
  {
    "key": "conversation_5mo9pe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vizvqs_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Und ich hoffe, dass wir dort irgendwas Cooles und Zerstörerisches finden.",
  },
  {
    "key": "conversation_vizvqs_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rswyd0_text",
    "value": "Was {format emph}ist{format reset} das hier eigentlich für ein Ort? So düster und gefährlich. Erkunden wir hier alles!",
  },
  {
    "key": "conversation_rswyd0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_vqbkn5_text",
    "metadata": {
      "notes": "*new* shortened by removing description of place. Was a bit misrepresentative",
    },
    "value": "Hier dürfte es wirklich keine Vegetation geben ...",
  },
  {
    "key": "conversation_vqbkn5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jk4t0s_text",
    "value": "Uns könnten allerlei Gefahren erwarten.",
  },
  {
    "key": "conversation_jk4t0s_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i4oq3o_text",
    "value": "{format laugh}Jaah!{format reset}",
  },
  {
    "key": "conversation_i4oq3o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qaywwl_text",
    "value": "Ich muss sichergehen, dass wir genug Licht haben, bevor wir hineinstürmen.",
  },
  {
    "key": "conversation_qaywwl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sf4uwk_text",
    "value": "Mit dir herumzureisen macht einfach keinen Spaß. Los jetzt!",
  },
  {
    "key": "conversation_sf4uwk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1135rj_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Diese Mine verfügt über solch eine interesante Geschichte! Ich versuche schon lange, dieses Gebiet hier zu kartografieren.",
  },
  {
    "key": "conversation_1135rj_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_dq65oq_text",
    "value": "Wenn man es darauf anlegt, kann man hier unten allerlei Schätze finden.",
  },
  {
    "key": "conversation_dq65oq_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_3fn5w0_text",
    "value": "Nun, es ist eine Mine. Also hoffe ich, dass sie bis zum Bersten mit wertvollen Steinen gefüllt ist.",
  },
  {
    "key": "conversation_3fn5w0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_npebbg_text",
    "value": "Nein, nein, nein! Ich spreche von {format emph}tatsächlichen{format reset} Kostbarkeiten. Faszinierende und zugleich seltsame Artefakte {image artifacts_small}.",
  },
  {
    "key": "conversation_npebbg_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_a7uvtg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Dinge, die ihre eigene fantastische Geschichte erzählen.",
  },
  {
    "key": "conversation_a7uvtg_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mjgdjr_text",
    "metadata": {
      "notes": "*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    },
    "value": "Falls du irgendwelche solcher Artefakte {image artifacts_small} finden solltest, würde ich gerne mal einen Blick drauf werfen.",
  },
  {
    "key": "conversation_mjgdjr_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_uwhgx6_text",
    "value": "Ich habe etwas gefunden, das dich interessieren könnte.",
  },
  {
    "key": "conversation_uwhgx6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_iqy08o_text",
    "value": "Verstanden, ich halte ein Auge offen.",
  },
  {
    "key": "conversation_iqy08o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rppjea_text",
    "value": "{format singsong}Traumhaft!{format reset} Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "conversation_rppjea_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_br857t_text",
    "value": "{format singsong}Meine Güte!{format reset} Da pack mich einer am Gewinde! Ist das zu fassen?",
  },
  {
    "key": "conversation_br857t_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_iptdw9_text",
    "value": "Es ist dir tatsächlich gelungen, das mystische 43. kostbare Artefakt {image artifacts_small} zu finden.",
  },
  {
    "key": "conversation_iptdw9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_lu65ll_text",
    "value": "Davon habe ich mein Leben lang geträumt. Für Generationen hat meine Familie danach gesucht. Ich kann es kaum abwarten, mich daran sattzusehen.",
  },
  {
    "key": "conversation_lu65ll_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_wu0y6m_text",
    "value": "...",
  },
  {
    "key": "conversation_wu0y6m_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_vyiiiz_text",
    "value": "Warte ...",
  },
  {
    "key": "conversation_vyiiiz_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ds3fs3_text",
    "value": "Das ist es?",
  },
  {
    "key": "conversation_ds3fs3_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_kheln9_text",
    "value": "Es ist so ... so ...",
  },
  {
    "key": "conversation_kheln9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_axft9i_text",
    "value": "Enttäuschend.",
  },
  {
    "key": "conversation_axft9i_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_66l4aw_text",
    "value": "Na ja, ich danke dir, trotzdem.",
  },
  {
    "key": "conversation_66l4aw_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_6ybt0n_text",
    "value": "Jetzt fühlt sich mein Leben so leer an.",
  },
  {
    "key": "conversation_6ybt0n_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_rlfp8l_text",
    "metadata": {
      "notes": "*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "{format singsong}Traumhaft!{format reset} Du hast bereits einige {var num_artifacts_current} faszinierende Artefakte {image artifacts_small} gefunden!",
  },
  {
    "key": "conversation_rlfp8l_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_as6lw7_text",
    "metadata": {
      "notes": "*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "{format singsong}Traumhaft!{format reset} Du hast bereits {var num_artifacts_current} faszinierendes Artefakt {image artifacts_small} gefunden!",
  },
  {
    "key": "conversation_as6lw7_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_p7vtak_text",
    "metadata": {
      "notes": "*format* removed emph from appreciation",
    },
    "value": "Als Zeichen meiner Dankbarkeit überreiche ich dir eine meiner {format highlight}Blaupausen{format reset}.",
  },
  {
    "key": "conversation_p7vtak_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_dcphb9_text",
    "metadata": {
      "notes": "*new* "it" refering to the blueprint",
    },
    "value": "Schaff es einfach zur Werkbank und verwende die Rädchenmods, um davon Gebrauch zu machen.",
  },
  {
    "key": "conversation_dcphb9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_g8lzbu_text",
    "metadata": {
      "notes": "*new* gives the player som info on how many artefacts until next blueprint",
    },
    "value": "Ich werde dir eine weitere Blaupause aushändigen, wenn du mir insgesamt {var num_artifacts_threshold} Artefakte {image artifacts_small} vorzeigen kannst.",
  },
  {
    "key": "conversation_g8lzbu_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_pwaqqk_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Nun, wie ich sehe, hast du bisher noch {format emph}keine{format reset} faszinierenden Artefakte {image artifacts_small} gefunden.",
  },
  {
    "key": "conversation_pwaqqk_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tm2fum_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "conversation_tm2fum_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_31n97u_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Oh, wie ich sehe, hast du {var num_artifacts_current} nettes Artefakt {image artifacts_small} ausfindig gemacht.",
  },
  {
    "key": "conversation_31n97u_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_xkdvzp_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Ich werde dir eine {format highlight}Blaupause{format reset} aushändigen, wenn du mir mindestens {var num_artifacts_threshold} {image artifacts_small} bringst.",
  },
  {
    "key": "conversation_xkdvzp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_vj87ok_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Oh sehr gut! Du hast {var num_artifacts_current} faszinierende Artefakte {image artifacts_small} gefunden.",
  },
  {
    "key": "conversation_vj87ok_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_c12v5z_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Diese kostbaren Dinge können überall versteckt sein.",
  },
  {
    "key": "conversation_c12v5z_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_r70wn4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aber du hast jetzt diese ganze ausgefallene Ausrüstung, um herumzukommen.",
  },
  {
    "key": "conversation_r70wn4_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ozgox8_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sieh dich immer gründlich um, ok?",
  },
  {
    "key": "conversation_ozgox8_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_crg8xl_text",
    "metadata": {
      "notes": "*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    },
    "value": "Ich werde dir eine weitere Blaupause aushändigen, wenn du mir insgesamt {var num_artifacts_threshold} Artefakte {image artifacts_small} vorzeigen kannst.",
  },
  {
    "key": "conversation_crg8xl_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_rkqt88_text",
    "metadata": {
      "notes": "*new* removed "wonderful" as it conflicted with previous lines in some cases",
    },
    "value": "Du warst wirklich fleißig. Es kommt mir so vor, als hättest du mir alle spannenden Artefakte dieses Planeten gezeigt.",
  },
  {
    "key": "conversation_rkqt88_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_4ngqs0_text",
    "value": "Und das ist auch gut so, ich habe nämliche keine Blaupausen mehr!",
  },
  {
    "key": "conversation_4ngqs0_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_75th6d_text",
    "value": "Früher, als ich noch ein agiler, herumspringender Bot, so wie du, gewesen bin, bin ich in dieser Mine überall herumgerannt und habe erstaunliche Karten angefertigt.",
  },
  {
    "key": "conversation_75th6d_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_wvg349_text",
    "value": "Ich hatte den Schutzwall bereits vollständig kartografiert, bevor meine Knie mehr und mehr nachgaben.",
  },
  {
    "key": "conversation_wvg349_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_90qcuc_text",
    "value": "Ich habe mit den unteren Ebenen begonnen. Allerdings waren diese unlogisch agierenden Schnapsis eine echte Plage.",
  },
  {
    "key": "conversation_90qcuc_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_pffrd2_text",
    "value": "Diese Kreaturen haben einfach keinen Respekt vor makelloser Handwerksarbeit. Verwenden unpräzisen Sprengstoff gegen solch ein erhabenes Monument! Absurd!",
  },
  {
    "key": "conversation_pffrd2_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_fc5nyv_text",
    "value": "Der Wall absorbiert die Mehrheit physikalischen Krafteinwirkens ... Allerdings ist es ihnen irgendwann doch geglückt, sich ihren Weg zu bahnen.",
  },
  {
    "key": "conversation_fc5nyv_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_219b44_text",
    "value": "Warst du schon mal beim Tempel auf der anderen Seite der Windigen Ebenen?",
  },
  {
    "key": "conversation_219b44_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0anv7h_text",
    "value": "Die Ruinen dort sind größtenteils unkartografiert. Und der Tempel war schon immer... trügerisch.",
  },
  {
    "key": "conversation_0anv7h_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tv8uil_text",
    "value": "Mein alter Kollege Ronald Hubot war der Einzige, der {format emph}den Mut hatte{format reset}, sich hineinzubegeben.",
  },
  {
    "key": "conversation_tv8uil_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_u57vpi_text",
    "value": "Was ist mit ihm passiert?",
  },
  {
    "key": "conversation_u57vpi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_g8rvft_text",
    "value": "Nun, offensichtlich hatte er eine entsetzliche Vision, die vom Ende der Welt kündete.",
  },
  {
    "key": "conversation_g8rvft_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_02chim_text",
    "value": "Er hat sich im Tempel verkrochen und verbarrikadiert. Und hat sich mit allen möglichen Wahnbots umgeben.",
  },
  {
    "key": "conversation_02chim_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_i026up_text",
    "value": "Ich kann nur vermuten, welch wundervollen Artefakte {image artifacts_small} sich in diesen Ruinen befinden mögen.",
  },
  {
    "key": "conversation_i026up_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tvge9q_text",
    "value": "In den Tiefen der Mine müssen sich {format emph}Schatzfunde{format reset} längt vergessener Artefakte {image artifacts_small} befinden.",
  },
  {
    "key": "conversation_tvge9q_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_iyk7r0_text",
    "value": "Stelle dir doch nur mal die Relikte vor, die längst vergessene Kulturen hier zurückgelassen haben müssen. Relikte, dir nur darauf warten, gefunden zu werden.",
  },
  {
    "key": "conversation_iyk7r0_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_hp4wcb_text",
    "value": "In was für einer faszinierenden Epoche du lebst! Es ist Ewigkeiten her, dass Bots so weit wie du vorgedrungen sind.",
  },
  {
    "key": "conversation_hp4wcb_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ekx3en_text",
    "value": "Du solltest sogar noch tiefer vordringen. Die Geschichte belohnt die Mutigen, weißt du.",
  },
  {
    "key": "conversation_ekx3en_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_bb807w_text",
    "value": "Die westliche Wüste ist ein rauer und trockener Ort, und dennoch leben Bots hier schon seit Jahrhunderten.",
  },
  {
    "key": "conversation_bb807w_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_6e53tq_text",
    "value": "Ich bin mir absolut sicher, dass etwas Spannendes unter den Felsen und dem Sand versteckt liegen muss.",
  },
  {
    "key": "conversation_6e53tq_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ja68cp_text",
    "value": "Ich weiß großartige Artefakte wirklich zu schätzen.",
  },
  {
    "key": "conversation_ja68cp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_9w2c24_text",
    "value": "Normalerweise dauert es {format emph}Äonen{format reset}, damit sich die geologische Sturktur der Erde signifikant ändert.",
  },
  {
    "key": "conversation_9w2c24_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_aactqp_text",
    "value": "Diese Erbeben scheinen in der Lage zu sein, die Erdschichten innerhalb nur weniger Dekaden verändern zu können.",
  },
  {
    "key": "conversation_aactqp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_fn5brp_text",
    "value": "Wir werden diese Beben bald ausgemerzt haben.",
  },
  {
    "key": "conversation_fn5brp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_d0c0zs_text",
    "value": "Was, wenn der Boden komplett aufbricht? Dann wären meine Karten komplett sinnlos. Was für ein Frevel!",
  },
  {
    "key": "conversation_d0c0zs_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_w56u9v_text",
    "value": "Das letzte Beben war erstaunlich problematisch.",
  },
  {
    "key": "conversation_w56u9v_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mcnumi_text",
    "value": "Vielleicht hat Professorin Sherman recht ... möglicherweise sind wir alle gezwungen, den Planeten zu verlassen.",
  },
  {
    "key": "conversation_mcnumi_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mq34gi_text",
    "value": "Wir versuchen unser Bestes, das zu verhindern.",
  },
  {
    "key": "conversation_mq34gi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h0mzw3_text",
    "value": "Zu lernen, wie man die Sterne kartografiert, hört sich nach einer spannenden Herausforderung an.",
  },
  {
    "key": "conversation_h0mzw3_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_uyr4r4_text",
    "metadata": {
      "notes": "This person id located upp on a trellis with a fantastic view.",
    },
    "value": "Ah, {format singsong}hallo Freund!{format reset} Die Aussicht ist hier oben wirklich klasse! Unser Bürgermeister ist wirklich ein Glückspilz.",
  },
  {
    "key": "conversation_uyr4r4_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_w3sayh_text",
    "value": "Allerdings sollte er mehr auf die Professorin hören. Diese Erschütterungen werden sich nicht einfach so in Luft auflösen!",
  },
  {
    "key": "conversation_w3sayh_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_cww3zx_text",
    "value": "Der Bürgermeister ist gerade nicht da. Ich frage mich, wann er wiederkommt.",
  },
  {
    "key": "conversation_cww3zx_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_0g6nsc_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hältst du da etwa eine Bombe in der Hand?",
  },
  {
    "key": "conversation_0g6nsc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_474v8c_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Bitte sag mir, dass du hier bist, um dieses schreckliche Gebäude hier in Stücke zu sprengen?",
  },
  {
    "key": "conversation_474v8c_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_o24esm_text",
    "value": "{format laugh}Ja, klar!{format reset} Ich meine, nein!",
  },
  {
    "key": "conversation_o24esm_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_yi4qcu_text",
    "metadata": {
      "notes": "*new* changed water bomb to pressure bomb",
    },
    "value": "Ich wollte Bürgermeister Yonker meine neue, verbesserte Druckbombe präsentieren. Sie ist genau das, was diese Stadt gerade braucht.",
  },
  {
    "key": "conversation_yi4qcu_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_bqmi7g_text",
    "value": "Aber er ... hielt mich auf Abstand und verwies mich einfach nur an sein Büro. Allerdings ist niemand hier.",
  },
  {
    "key": "conversation_bqmi7g_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_5kay5a_text",
    "value": "Aber ich habe kein Problem damit, zu warten. Ich bin sicher, dass der Bürgermeister bald wieder da ist. Wahrscheinlich. Möglicherweise. Vielleicht ... irgendwann.",
  },
  {
    "key": "conversation_5kay5a_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_73lt57_text",
    "value": "Bomben besitzen viele verschiedene Anwendungsmöglichkeiten. Du kannst sie eigentlich für {format emph}alles{format reset} verwenden – mehr oder weniger.",
  },
  {
    "key": "conversation_73lt57_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_2t4ktx_text",
    "value": "Du kannst mit ihnen Tunnel anlegen, harte mineralienreiche Steine aufsprengen, Schutt und Trümmer beseitigen ...",
  },
  {
    "key": "conversation_2t4ktx_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_tkp0i2_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Und vergiss nicht die blinde, unbegründete Zerstörung!",
  },
  {
    "key": "conversation_tkp0i2_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2ynw9y_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Früher haben sie unten in den Minen Tag und Nacht das Dynamit hochgehen lassen. Mann, war das Musik für die Ohren!",
  },
  {
    "key": "conversation_2ynw9y_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_2vgr7k_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Süße, tödliche Detonationen!",
  },
  {
    "key": "conversation_2vgr7k_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4nhr7x_text",
    "metadata": {
      "notes": "*new* changed pressurized water bomb to pressure bomb",
    },
    "value": "Ich hoffe, dass ich den Bürgermeister vom Design meiner Druckbombe überzeugen kann. Das Ding ist die Zukunft!",
  },
  {
    "key": "conversation_4nhr7x_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_gbuars_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Dieser Kerl versteht, worum es geht!",
  },
  {
    "key": "conversation_gbuars_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_h4evh3_text",
    "metadata": {
      "notes": "This is Dorothy talking",
    },
    "value": "Ich freue mich, dass du endlich jemanden gefunden hast, mit dem du dich verstehst. Allerdings wäre es mir lieber, wenn es nicht um Bomben ginge.",
  },
  {
    "key": "conversation_h4evh3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_v0gx3y_text",
    "value": "Ich bin sicher, dass ich den Bürgermeister davon überzeugen kann, dass die Zukunft meinen Bomben gehört.",
  },
  {
    "key": "conversation_v0gx3y_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_hwchba_text",
    "value": "Mr. Dumpfbacke hat mir mal ein zusammengedrücktes Bombengehäuse gebracht. Meinte, er habe es unten im Territorium der Schnapsis gefunden.",
  },
  {
    "key": "conversation_hwchba_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_q0vd7o_text",
    "value": "Mir wurde allein vom Ansehen speiübel! Wusstest du, dass die Schnapsis ihre Bomben aus {format nervous}Stoffwechselendprodukten und Mondsaft{format reset} herstellen?",
  },
  {
    "key": "conversation_q0vd7o_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_shtyfr_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Was soll so falsch daran sein? Es macht doch bumm, oder?",
  },
  {
    "key": "conversation_shtyfr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4nsm4v_text",
    "value": "Ja, das tut es. Und es reißt deine Finger mit weg, wenn du Glück hast!",
  },
  {
    "key": "conversation_4nsm4v_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_s7nbis_text",
    "metadata": {
      "notes": "*format* *new* changed pressurized water bomb to pressure bomb",
    },
    "value": "Nein, danke! Da bleibe ich doch lieber bei meinen sicheren Druckbomben. Da weiß man, was man hat, und es macht trotzdem schön bumm!",
  },
  {
    "key": "conversation_s7nbis_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_p2i5l7_text",
    "metadata": {
      "notes": "*format* *new* removed "..."",
    },
    "value": "Langweilig.",
  },
  {
    "key": "conversation_p2i5l7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ptgzep_text",
    "value": "Nimm dich hier unten in Acht. Diese Schnapsis bedeuten für gewöhnlich Ärger.",
  },
  {
    "key": "conversation_ptgzep_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_l8kkmb_text",
    "value": "Hast du schon Professorin Shermans neue Rakete gesehen? Ein Traum!",
  },
  {
    "key": "conversation_l8kkmb_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_9yditf_text",
    "metadata": {
      "notes": "This is Dororthy talking",
    },
    "value": "Ja, sie sieht wirklich beeindruckend aus.",
  },
  {
    "key": "conversation_9yditf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b8svck_text",
    "value": "Und sie ist wirklich sicher. Ich habe bei den Kalkulationen geholfen.",
  },
  {
    "key": "conversation_b8svck_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_wz8w9f_text",
    "value": "Es bedarf einigen Drucks, um solch ein riesiges Objekt in Richtung All zu befördern, weißt du. Alles muss präzise kalibriert werden, auf die Dezimalstelle genau.",
  },
  {
    "key": "conversation_wz8w9f_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_516qkn_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Nun, eigentlich ist eine Rakete doch ohnehin nichts anderes als eine große, instabile Bombe, nicht wahr?",
  },
  {
    "key": "conversation_516qkn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_8ly6iv_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Mir gefällt, wie sich das entwickelt. Warum gehen wir nicht zur Professorin und fragen sie nach einer Spritztour?",
  },
  {
    "key": "conversation_8ly6iv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pawve3_text",
    "metadata": {
      "notes": "This is Dorothy talking",
    },
    "value": "Vielleicht später, Fen.",
  },
  {
    "key": "conversation_pawve3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sqkxyn_text",
    "value": "Keine Sorge. Ich würde nie einen Fehler machen, wenn es um Bomben geht.",
  },
  {
    "key": "conversation_sqkxyn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ha9646_text",
    "value": "Ich habe über diese Erdbeben nachgedacht. Ein Beben ist doch nichts anderes als eine große, heftige Vibration, oder?",
  },
  {
    "key": "conversation_ha9646_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_fs869d_text",
    "value": "{format singsong}Das heißt, ...{format reset} wenn es uns gelänge, eine gleichgroße, aber {format emph}entgegenwirkende{format reset} Vibration zu erzeugen, würden sich die beiden aufheben!",
  },
  {
    "key": "conversation_fs869d_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_1frwlw_text",
    "value": "Ähm ... schlägst du tatsächlich vor ...?",
  },
  {
    "key": "conversation_1frwlw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qd7crv_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ja genau! Bomben! Alles, was wir brauchen, ist ein Netzwerk gut platzierter Bomben, die wir synchron zünden müssen!",
  },
  {
    "key": "conversation_qd7crv_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_t8xdab_text",
    "value": "Ein toller Plan, bei dem gar nichts schiefgehen kann!",
  },
  {
    "key": "conversation_t8xdab_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_50z3oe_text",
    "value": "Ich bin so froh, dass du zustimmst! Allerdings benötige ich ein paar Jahre für die entsprechenden Kalkulationen – die Sicherheit kommt schließlich zuerst!",
  },
  {
    "key": "conversation_50z3oe_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_wdv8yf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Menno ...",
  },
  {
    "key": "conversation_wdv8yf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_dx83ih_text",
    "value": "Ich kann es kaum erwarten, dem Bürgermeister von dem Plan zu berichten. Ich bin sicher, dass er Feuer und Flamme sein wird. Er ist ja nun schon seit einiger Zeit abwesend.",
  },
  {
    "key": "conversation_dx83ih_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_hu5cr9_text",
    "value": "Ich mag dieses ganze Gerede über das Große Beben nicht besonders; es gibt einfach zu viele Variablen: Wie groß? Wann wird es kommen? Wo? Werden die Gärtner arbeitslos?",
  },
  {
    "key": "conversation_hu5cr9_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_achdi1_text",
    "value": "Seit der Fahrstuhl abgestüzt ist, habe ich mir Gedanken darüber gemacht, was passieren wird, wenn sich ein {format emph}wirklich{format reset} großes Beben ereignet.",
  },
  {
    "key": "conversation_achdi1_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_k2l3ob_text",
    "value": "Professorin Sherman meint, dass es erst schlimmer werden müsse, bevor es besser wird.",
  },
  {
    "key": "conversation_k2l3ob_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ioi3ht_text",
    "value": "Es wäre weise, ihr zuzuhören. Sie ist der cleverste Bot der gesamten Stadt.",
  },
  {
    "key": "conversation_ioi3ht_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_5oey6i_text",
    "value": "Ich beginne langsam zu glauben, dass der Bürgermeister nicht zurückkehren wird.",
  },
  {
    "key": "conversation_5oey6i_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_xoknkn_text",
    "metadata": {
      "notes": "*format* *new* changed format from laugh to singsong",
    },
    "value": "{format singsong}Oh!{format reset} Ist das ein Druckgranatwerfer? Oh jaa, auch noch das Premium-Modell!",
  },
  {
    "key": "conversation_xoknkn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_uhq93q_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Bist du ein ... Bombenfetischist, so wie ich, mein Freund?",
  },
  {
    "key": "conversation_uhq93q_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_8o8ba8_text",
    "value": "Ich muss dir unbedingt mein Geheimprojekt zeigen. Ich kann's {format nervous}kaum erwarten{format reset}, das einem Bummkopf wie dir zu zeigen!",
  },
  {
    "key": "conversation_8o8ba8_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ux8mwy_text",
    "metadata": {
      "notes": "*new* changed format from highligh to emph",
    },
    "value": "Mit meiner als Patent angemeldeter Erweiterung kann dein Granatwerfer das Ziel mit {format emph}drei Mal mehr Zerstörung{format reset} als bisher überziehen!",
  },
  {
    "key": "conversation_ux8mwy_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_4urlt2_text",
    "value": "Ich würde es dir ja zum Testen eine Weile leihen, aber ... {format singsong}nun ja{format reset}, mein Forschungs- und Entwicklungsbudget ist in letzter Zeit relativ knapp bemessen.",
  },
  {
    "key": "conversation_4urlt2_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_uxln27_text",
    "value": "Wenn du, sagen wir mal, \${var pricelist_next:blueprint_vendor_02}{image money_small} beitragen würdest, könnte ich dir eine exklusive {format highlight}Blaupause{format reset} meiner Erfindung anvertrauen, die es so nur für Spendende gibt. Was denkst du?",
  },
  {
    "key": "conversation_uxln27_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_dgw94e_text",
    "value": "Übrigens, hast du dir die Spende noch einmal durch das Getriebe gehen lassen? Nur \${var pricelist_next:blueprint_vendor_02}{image money_small} und du erhältst diese exklusive {format highlight}Blaupause{format reset}!",
  },
  {
    "key": "conversation_dgw94e_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_20o2j5_text",
    "metadata": {
      "notes": "*format* *new* split this line up",
    },
    "value": "Wunderbar, mein Freund! Und hier ist die Ware. ",
  },
  {
    "key": "conversation_20o2j5_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_52n8bq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du musst sie bei der Werkbank verwenden, um diese deine Kanone da zu modifizieren.",
  },
  {
    "key": "conversation_52n8bq_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_9p7l5p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Worauf wartest du? Geh los und blase irgendwas in tausend Stücke!",
  },
  {
    "key": "conversation_9p7l5p_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_gui6im_text",
    "value": "Sieht aus, als ob auch deine finanziellen Mittel momentan ein wenig begrenzt sind. Aber keine Sorge! Ich warte hier auf dich, bis du genug Geld hast.",
  },
  {
    "key": "conversation_gui6im_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ijkhew_text",
    "value": "Ich verstehe, mein Freund. Komm doch einfach wieder, wenn du deine Meinung geändert hast.",
  },
  {
    "key": "conversation_ijkhew_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_02qawb_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sagen dir die Blaupausen zu? Schon irgendetwas Spannendes zum Wegsprengen gefunden?",
  },
  {
    "key": "conversation_02qawb_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_1hq43e_text",
    "metadata": {
      "notes": "This Character is a mail man/pony express person.",
    },
    "value": "Howdy, Partner. Es ist ziemlich gefährlich geworden, bei diesen Beben zu versuchen, rechtzeitig Nachrichten zu überbringen.",
  },
  {
    "key": "conversation_1hq43e_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_k6q6hf_text",
    "value": "Ich habe gehört, dass sich überall in der Wüste mehrere Schlucklöcher auftun sollen.",
  },
  {
    "key": "conversation_k6q6hf_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_ple2sp_text",
    "value": "Die Wüste ist daher kein sicherer Ort mehr für die Postmannbotreiter.",
  },
  {
    "key": "conversation_ple2sp_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_dum6i9_text",
    "value": "Daher kann ich dir aktuell nicht weiterhelfen.",
  },
  {
    "key": "conversation_dum6i9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_qy63x4_text",
    "value": "Alle unsere Postmannbotreiter befinden sich aktuell auf Botengängen. Wir haben nur noch einige Postbotenboybots hier.",
  },
  {
    "key": "conversation_qy63x4_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_4nc6nw_text",
    "value": "Warum bist du nicht ebenfalls dort draußen bei all den anderen?",
  },
  {
    "key": "conversation_4nc6nw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_aozfk3_text",
    "value": "Es gibt nichts, dass ein stärkeres Gefühl von {format nervous}Klaustrophobie{format reset} aufkommen lässt als die weiten Ebenen. Kilometerlang nur Leere.",
  },
  {
    "key": "conversation_aozfk3_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_opkpi5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich fühle mich schon beengt, wenn ich nur daran denke!",
  },
  {
    "key": "conversation_opkpi5_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_opmgdu_text",
    "value": "Es gibt wirklich nichts Grauen erregenderes als die endlosen, weiten Ebenen, Partner.",
  },
  {
    "key": "conversation_opmgdu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_384qc9_text",
    "value": "Unsere Pferdchen sind über die ganze Wüste verstreut. Man kann die Beben überall spüren, Partner.",
  },
  {
    "key": "conversation_384qc9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_c3vack_text",
    "value": "Diese verdammten Erschütterungen bedeuten eine Menge Ärger für all die kleine Dörfer, die sich hinter den alten Tempeln befinden.",
  },
  {
    "key": "conversation_c3vack_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_alusmw_text",
    "value": "Wir haben selbst Problem, importiertes Erz sicher hier her zu transportieren.",
  },
  {
    "key": "conversation_alusmw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_5nkkkg_text",
    "value": "Die Wirtschaft dieser kleinen Stadt baut auf importierte Waren aus der ganzen Region auf.",
  },
  {
    "key": "conversation_5nkkkg_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_1u0u2r_text",
    "value": "Der Dampfponyexpress ist normalerweise der beste Weg, alles hier her zu holen.",
  },
  {
    "key": "conversation_1u0u2r_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_2ufqac_text",
    "value": "Der Dampfponyexpress hat einen Ruf zu verteidigen. Ich will nicht, dass er von diesen Erdbeben beschädigt wird.",
  },
  {
    "key": "conversation_2ufqac_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_7idj7v_text",
    "value": "Waren einige von deinen Ponies schon einmal bei den Tempeln?",
  },
  {
    "key": "conversation_7idj7v_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vfl4c6_text",
    "metadata": {
      "notes": "*new* removed reference to Ron",
    },
    "value": "Witzig, dass du fragst. Dieser Typ hat sich vor einem Monat nach einer Lieferung der höchsten Dringlichkeitsstufe erkundigt.",
  },
  {
    "key": "conversation_vfl4c6_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_51nddn_text",
    "metadata": {
      "notes": "*new* changes to phrasing",
    },
    "value": "Wir mussten ein paar quer über die Windigen Ebenen schicken.",
  },
  {
    "key": "conversation_51nddn_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_hsitea_text",
    "metadata": {
      "notes": "*new* removed "pardner".",
    },
    "value": "Man braucht schon richtig kräftige Beine, um dem Gegenwind gewachsen zu sein, das kann ich dir sagen.",
  },
  {
    "key": "conversation_hsitea_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_g6i2qw_text",
    "metadata": {
      "notes": "*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    },
    "value": "Sie haben ein paar Kohlenpfannen bestellt und wollten, dass sie so schnell wie möglich geliefert werden.",
  },
  {
    "key": "conversation_g6i2qw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_j223bu_text",
    "value": "Wahrscheinlich ging's da um irgendwelche schwachsinnigen Kultaktivitäten.",
  },
  {
    "key": "conversation_j223bu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_p4ogy4_text",
    "value": "Jeder der sich durch die Windigen Ebenen im Osten schlagen will, muss sich Gedanken darüber machen, wie er mit dem Gegenwind fertig wird, Partner.",
  },
  {
    "key": "conversation_p4ogy4_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_pgpn5x_text",
    "value": "Ich habe gehört, dass du inzwischen eine anständige Tiefe erreicht hättest, Partner.",
  },
  {
    "key": "conversation_pgpn5x_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_2ir3fn_text",
    "value": "Ja, wir suchen nach meinem Freund. Und der könnte irgendwo da unten sein.",
  },
  {
    "key": "conversation_2ir3fn_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_l0q9lw_text",
    "metadata": {
      "notes": "*new* doggone to coggone",
    },
    "value": "Manchmal wünsche ich mir, ich würde diese gottverdammte Stadt einfach hinter mir lassen und an neue Orte reisen.",
  },
  {
    "key": "conversation_l0q9lw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_l0wgkw_text",
    "value": "Und dann denke ich an die Gerüchte, dass es einen gefährlichen Dschungel geben soll, der im Untergrund zu finden sein soll.",
  },
  {
    "key": "conversation_l0wgkw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_qgwwxu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich fange an, mir über all die Geheimnisse und Gefahren, die dort unten lauern, Gedanken zu machen.",
  },
  {
    "key": "conversation_qgwwxu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_5phwat_text",
    "value": "Mein Herz beginnt {format nervous}zu flattern{format reset} und ich spüre, wie meine Knie weich werden.",
  },
  {
    "key": "conversation_5phwat_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_cp57ox_text",
    "value": "Leck mir die Sporen, bin ich nicht das gelbbäuchigste Pony, das du je gesehen hast?",
  },
  {
    "key": "conversation_cp57ox_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_x5lp6f_text",
    "value": "Manchmal wünschte ich mir, ich wäre nicht so eine Memme. Die Welt ist voller spannender Dinge, und ich bin hier und verpasse alles.",
  },
  {
    "key": "conversation_x5lp6f_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_w4by19_text",
    "value": "Die Erschütterungen werden immer schlimmer. Ich spüre, dass meine 4 Knie langsam nachgeben.",
  },
  {
    "key": "conversation_w4by19_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_d4gln9_text",
    "value": "Wir sollten uns langsam in Richtung Rakete aufmachen. Die Zeit rennt uns davon.",
  },
  {
    "key": "conversation_d4gln9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_w15szm_text",
    "value": "Irgendwie kann ich mich mit dem Gedanken eines großen, weiten, mich umgebenden Weltraums nicht so richtig anfreunden.",
  },
  {
    "key": "conversation_w15szm_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_jnag7u_text",
    "value": "Aber andererseits, wenn der Planet ohnehin in die Binsen geht ..., habe ich natürlich keine andere Wahl.",
  },
  {
    "key": "conversation_jnag7u_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_oawrk7_text",
    "value": "Es wird also endlich Zeit, meine Komfortzone zu verlassen, wie spannend!",
  },
  {
    "key": "conversation_oawrk7_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_e1e8ry_text",
    "value": "Wenn dieser gesamte Planet draufgehen sollte, ist es jetzt vielleicht an der Zeit, mich auf ein Abenteuer zu begeben.",
  },
  {
    "key": "conversation_e1e8ry_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_cqe4nv_text",
    "value": "Tut mir leid, Partner. Aber meine Blaupausen sind leider alle.",
  },
  {
    "key": "conversation_cqe4nv_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_jm66o2_text",
    "value": "...",
  },
  {
    "key": "conversation_jm66o2_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_igsxan_text",
    "value": "Ist das eine {format emph}Statue von Rusty{format reset}, vor der du dich da verneigst?",
  },
  {
    "key": "conversation_igsxan_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1voalp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ja ... Der Große Rusty ist der Zerstörer der Legende.",
  },
  {
    "key": "conversation_1voalp_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_pd5hzj_text",
    "metadata": {
      "notes": "*new* removed reference to Ron and expanded the text format",
    },
    "value": "Der Großer Prophet hat es vorhergesagt. Und der lügt nie und hat immer recht! Er hat die Ankunft des {format singsong}gesegneten Endes vorausgesehen.{format reset}",
  },
  {
    "key": "conversation_pd5hzj_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_y6xyie_text",
    "value": "Ihr Typen findet wirklich überall Zeug, das ihr anbeten könnt, nicht wahr?",
  },
  {
    "key": "conversation_y6xyie_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_e76l4q_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Licht der Führung! Dieser Ungläubige hat dich aus dem Tempel der Führung entfernt!",
  },
  {
    "key": "conversation_e76l4q_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_qo16zi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich werde ihr Getriebe dem reinigenden Feuer übergeben!",
  },
  {
    "key": "conversation_qo16zi_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_mdyvq0_text",
    "value": "Guten Tag auch! Ich habe wirklich gedacht, {format nervous}dass mich niemand finden würde{format reset}.",
  },
  {
    "key": "conversation_mdyvq0_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_zcgves_text",
    "value": "Nicht, dass ich mich verlaufen hätte, oder so. Aber es war wirklich anstrengend, hierher zu kommen, weißt du!",
  },
  {
    "key": "conversation_zcgves_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_ara3qe_text",
    "metadata": {
      "notes": ""Feels like Ah should give..." is "Feels like I should give..."",
    },
    "value": "Ich sollte dich für deine Mühe belohnen. Aber alles, was ich habe, ist diese Blaupause.",
  },
  {
    "key": "conversation_ara3qe_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_2ebftt_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Merk dir einfach, dass deine Reise um {format danger}einiges schwerer{format reset} wird, wenn du das hier aktivierst.",
  },
  {
    "key": "conversation_2ebftt_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_6jeiwp_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Du solltest es nur verwenden, wenn du dich mal richtig was erleben möchtest!",
  },
  {
    "key": "conversation_6jeiwp_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_pvpsai_text",
    "value": "Mach dir keine Sorgen, ich habe mich nicht verirrt. Ich ruhe mich hier nur aus.",
  },
  {
    "key": "conversation_pvpsai_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_jbfsb5_text",
    "value": "Mein kleiner Bruder ist nicht besonders clever. Er hat das alte Transportsystem versiegelt.",
  },
  {
    "key": "conversation_jbfsb5_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_rq43xc_text",
    "value": "Er meinte, es sei nicht sicher, oder so. Ich hätte wohl aufmerksamer sein sollen.",
  },
  {
    "key": "conversation_rq43xc_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_v4t07d_text",
    "value": "Manchmal glaube ich, dass die "Hauptaufgabe" meines Bruders darin besteht, den Dampf zu limitieren, der in seinen Kopf gelangt.",
  },
  {
    "key": "conversation_v4t07d_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_y4mgz6_text",
    "value": "Ich vermisse diese praktischen Röhren jetzt schon ... Nun muss ich den ganzen Weg nach Hause laufen.",
  },
  {
    "key": "conversation_y4mgz6_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_9kai6i_text",
    "value": "Diese Wüsten stehen mit einigen seltsamen Dingen in Verbindung, das kann ich dir sagen.",
  },
  {
    "key": "conversation_9kai6i_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_1hh5hs_text",
    "value": "Ich habe sie genau gesehen: Wahnsinnige Kultisten, die den Eingang des alten Tempels unsicher machen.",
  },
  {
    "key": "conversation_1hh5hs_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_vpsiim_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wirres Gerede, das Abhalten seltsamer Messen und noch viele andere Dinge gehen da unten vor sich.",
  },
  {
    "key": "conversation_vpsiim_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_efhbif_text",
    "value": "Die Minen können die meisten Bots in den Wahnsinn treiben. Wenn sie sich dort zu lange aufhalten.",
  },
  {
    "key": "conversation_efhbif_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_914qie_text",
    "value": "Ich denke, ich werde noch eine Weile hier bleiben. Die harte Arbeit ist ganz schön ermüdend.",
  },
  {
    "key": "conversation_914qie_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_ppa3hq_text",
    "value": "{format emph}Verdammt!{format reset} Ich dachte schon, du seist einer von den {format nervous}verrückten Schnapsis!{format reset}",
  },
  {
    "key": "conversation_ppa3hq_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_rtaarn_text",
    "value": "Ich weiß nicht, wie ich diesen Ort einordnen soll. Er ist keinem der Orte ähnlich, die ich bisher gesehen habe.",
  },
  {
    "key": "conversation_rtaarn_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_rqui5d_text",
    "value": "Man trifft nicht alle Tage einen gleichgesinnten Bot an solch einem seltsamen Ort.",
  },
  {
    "key": "conversation_rqui5d_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_xpaj1a_text",
    "metadata": {
      "notes": "Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    },
    "value": "Hier, nimm diese Blaupause. Meine Art, dir für deine Gesellschaft zu danken.",
  },
  {
    "key": "conversation_xpaj1a_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_5zxme4_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Doch ich muss dich warnen. Wenn du es aktivierst, wird deine Quest {format danger}um einiges schwieriger{format reset}.",
  },
  {
    "key": "conversation_5zxme4_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_ncsd4z_text",
    "value": "Verwende es lieber nicht, wenn du der Gefahr nicht gewachsen bist!",
  },
  {
    "key": "conversation_ncsd4z_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_yp736j_text",
    "value": "Sei mir erneut gegrüßt, mein Bot-Kollege.",
  },
  {
    "key": "conversation_yp736j_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_g21tdm_text",
    "value": "Meine Brüder behaupten, die meisten dieser neuen Wallwände stammten von ihnen. Aber ich weiß, dass das nicht stimmt.",
  },
  {
    "key": "conversation_g21tdm_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_iehmo4_text",
    "value": "Es stimmt zwar, dass sie hier und da ein wenig geflickt haben, aber im Grunde genommen stehen diese Wände schon seit Ewigkeiten hier.",
  },
  {
    "key": "conversation_iehmo4_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_aytv9n_text",
    "value": "Diese Jungs überschätzen einfach ihre Bedeutung, wenn es um den Bau der Wand geht.",
  },
  {
    "key": "conversation_aytv9n_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_8srkg6_text",
    "value": "Wenn es Etwas gibt, was ich weiß, dann ist das, dass es immer einen Weg gibt, diese Wände zu umgehen.",
  },
  {
    "key": "conversation_8srkg6_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_vb6b0a_text",
    "value": "Ich schwöre dir, dass ich vor gar nicht so langer Zeit einige Pilze gesehen habe, die sich in Bewegung gesetzt haben.",
  },
  {
    "key": "conversation_vb6b0a_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_0yu226_text",
    "value": "Was glaubst du, wie lange werden sie brauchen, um bis zur Stadt zu gelangen?",
  },
  {
    "key": "conversation_0yu226_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_onpk10_text",
    "value": "Ich möchte noch ein wenig die hiesige Wildnis genießen, bevor ich mich auf den Rückweg begebe.",
  },
  {
    "key": "conversation_onpk10_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_xfyeov_text",
    "value": "Nun, ich war am Bauen und Reparieren, bis mir plötzlich einfiel, dass ich mein Werkzeug gar nicht hatte.",
  },
  {
    "key": "conversation_xfyeov_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_t1bq4v_text",
    "value": "Wenn du mir versprichst, deine Kinnlade geschlossen zu halten, gebe ich dir dieses wichtig aussehende Papier hier.",
  },
  {
    "key": "conversation_t1bq4v_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_odkj11_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Dadurch werden deine Abenteuer ein bisschen ... {format danger}herausfordernder{format reset}.",
  },
  {
    "key": "conversation_odkj11_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_nvlvnn_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Verwende es nur, wenn du drauf stehst, dem Tod ins Gesicht zu lachen!",
  },
  {
    "key": "conversation_nvlvnn_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_ajyl7v_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Oh und ... Gibt doch keinen Grund, dass meinen Bros zu erzählen, oder?",
  },
  {
    "key": "conversation_ajyl7v_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_zdkcdy_text",
    "value": "Ich freue mich, dass wir uns verstehen.",
  },
  {
    "key": "conversation_zdkcdy_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_wpy2vc_text",
    "value": "s gibt keinen Grund meinen Jungs zu sagen, dass du mich hier gefunden hast.",
  },
  {
    "key": "conversation_wpy2vc_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_0fsp3k_text",
    "value": "Ich bin eine Korifää..., Konifär..., ein richtiger {format emph}Experte{format reset}, wenn es um das Errichten von Wällen und solchen Dingen geht, musst du wissen.",
  },
  {
    "key": "conversation_0fsp3k_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_l2xfyd_text",
    "value": "Wenn diese verfluchten Schnapsis doch einfach nur mal auf ihrer Seite bleiben würden!",
  },
  {
    "key": "conversation_l2xfyd_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_a09h0a_text",
    "value": "Ich habe nicht die Zeit, herumzurennen und zu überprüfen, ob alles in Ordnung ist.",
  },
  {
    "key": "conversation_a09h0a_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_sy2ct5_text",
    "value": "Ich habe schon lange keinen Schnapsi mehr gesehen. Vor den Beben sah das allerdings anders aus – jeden Tag nichts als Ärger!",
  },
  {
    "key": "conversation_sy2ct5_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_w8p7tf_text",
    "value": "Wenn meine Bros mitbekommen, dass ich mich selbst eingemauert habe, werde ich meines Lebens nicht mehr froh!",
  },
  {
    "key": "conversation_w8p7tf_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_rbdoyh_text",
    "value": ""Rotfelsgang"",
  },
  {
    "key": "conversation_rbdoyh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jofluh_text",
    "value": "Oha! Sieh dir nur mal die Absturzstelle an. {format singsong}Was für eine Zerstörung!{format reset}",
  },
  {
    "key": "conversation_jofluh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rgfncb_text",
    "value": "Hoffen wir einfach mal, dass die Professorin der Rakete in der Stadt einige richtig gute Verbesserungen verpasst hat.",
  },
  {
    "key": "conversation_rgfncb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1mx9ap_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wie zum Beispiel ein paar coole Laser und solche Sachen!",
  },
  {
    "key": "conversation_1mx9ap_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_z6izd0_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wer wagt es, vor den Großen Propheten des Vernichters zu treten?",
  },
  {
    "key": "conversation_z6izd0_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_cu9az7_text",
    "value": "Hey, den Typen kenn' ich! Das ist der Kerl, der mich zu dem anderen Tempel gebracht hat.",
  },
  {
    "key": "conversation_cu9az7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4ljao8_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Licht der Führung! Ein unwürdiger Bot ... in meinem Tempel?!",
  },
  {
    "key": "conversation_4ljao8_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_m8bbt4_text",
    "value": "Wo ist Rusty? Was ist mit {format emph}ihm passiert?{format reset}",
  },
  {
    "key": "conversation_m8bbt4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6jm46x_text",
    "metadata": {
      "notes": "*new* moved text format to other words.",
    },
    "value": "Wie von mir vorhergesagt, wird Rusty der Zerstörer das {format laugh}Große Beben{format reset} hervorrufen, auf dass wir diese sterblichen Hüllen ablegen und Erleuchtung finden können.",
  },
  {
    "key": "conversation_6jm46x_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_mhn5s6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "In seiner unendlichen Gnade gewährte er uns eine Vorrichtung des Jüngsten Gerichts. Und dann ... verließ er uns. Seine Wege sind wahrlich unergründlich.",
  },
  {
    "key": "conversation_mhn5s6_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_davhio_text",
    "value": "...",
  },
  {
    "key": "conversation_davhio_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_39dqwa_text",
    "value": "Dann muss ich die Gerätschaft deaktivieren!",
  },
  {
    "key": "conversation_39dqwa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_f5igne_text",
    "metadata": {
      "notes": "*format* removed one of the text formats",
    },
    "value": "Jaah! Sag uns, wo du diese Maschine versteckt hast, damit wir sie {format laugh}wegbomben können{format reset}.",
  },
  {
    "key": "conversation_f5igne_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_t03c7h_text",
    "value": "Oh, Licht der Führung, diese ungläubigen Narren! Ihr werdet unserer Maschine kein Leid zufügen!",
  },
  {
    "key": "conversation_t03c7h_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_5ppdcr_text",
    "value": "{format nervous}Aaargh!{format reset} Ihr könnt die Ankunft des {format laugh}Großen Bebens{format reset} nicht verzögern, geschweige denn verhindern!",
  },
  {
    "key": "conversation_5ppdcr_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_veu3hm_text",
    "value": "Die Maschine des Jüngsten Gerichts ist noch immer sicher und unversehrt. Das Ende ist {format singsong}nah!{format reset}",
  },
  {
    "key": "conversation_veu3hm_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_1l6ojp_text",
    "metadata": {
      "notes": "There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    },
    "value": ""Illusionäre Wand voraus!"",
  },
  {
    "key": "conversation_1l6ojp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cp9bbp_text",
    "metadata": {
      "notes": "*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    },
    "value": "Komm schon, noch immer nichts?!",
  },
  {
    "key": "conversation_cp9bbp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_p1i3bn_text",
    "metadata": {
      "notes": "*new* changed an I to a We.",
    },
    "value": "Wir müssen einfach {format highlight}all diese Kohlenpfannen entzünden{format reset}, um die Kristalle zu aktivieren.",
  },
  {
    "key": "conversation_p1i3bn_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xqev6z_text",
    "metadata": {
      "notes": "*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    },
    "value": "Sie müssen irgendwo hier in der Nähe sein!",
  },
  {
    "key": "conversation_xqev6z_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kk5j23_text",
    "metadata": {
      "notes": "*new* changed the phrasing to be more Fen-like",
    },
    "value": "Alles klar, dann los. Lass sie uns in Brand stecken!",
  },
  {
    "key": "conversation_kk5j23_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4dihd5_text",
    "metadata": {
      "notes": "*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    },
    "value": "Ja, du hast immer noch nicht alle Kohlenpfannen in Brand gesteckt.",
  },
  {
    "key": "conversation_4dihd5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7gz2cu_text",
    "value": ""TOD VORAUS!"",
  },
  {
    "key": "conversation_7gz2cu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8fufl9_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Oh Großer Zerstörer, das Ende ist nah! Es muss einfach nah sein!",
  },
  {
    "key": "conversation_8fufl9_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_bj94jz_text",
    "value": "Was hält dich auf? Komm schon!",
  },
  {
    "key": "conversation_bj94jz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_i7wge8_text",
    "metadata": {
      "notes": "*new* made it clear that it's only the pipe to the oasis that is closed",
    },
    "value": "Seltsam ... Die Röhre zurück zur Oase funktioniert nicht!",
  },
  {
    "key": "conversation_i7wge8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t6jhkm_text",
    "metadata": {
      "notes": "*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    },
    "value": "Es wird immer merkwürdiger ... Vielleicht ist die Öffnung auf der Seite irgendwie blockiert?",
  },
  {
    "key": "conversation_t6jhkm_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kbmx5q_text",
    "metadata": {
      "notes": "*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    },
    "value": "Wir müssen uns wohl einfach durchgraben, um dort anzukommen.",
  },
  {
    "key": "conversation_kbmx5q_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dhpyma_text",
    "metadata": {
      "notes": "*new* changed this to not refert to whole tube system",
    },
    "value": "Das Röhre zurück zur Oase ist immer noch außer Betrieb!",
  },
  {
    "key": "conversation_dhpyma_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xdvi4z_text",
    "metadata": {
      "notes": "*new* added a "come on then,"",
    },
    "value": "Auf geht's, {format highlight}suchen wir einen anderen Weg Richtung Oase.{format reset}",
  },
  {
    "key": "conversation_xdvi4z_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_efpvk6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Du ... du bist zurückgekommen!",
  },
  {
    "key": "conversation_efpvk6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xs0zex_text",
    "value": "Ja. Ich weiß zwar nicht, wie ich rausgekommen bin, aber ich bin wieder da.",
  },
  {
    "key": "conversation_xs0zex_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2gp05g_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich war ... schon wieder allein und steckte fest. Ich muss ... wohl einen Moment eingedöst sein.",
  },
  {
    "key": "conversation_2gp05g_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_v8dyjq_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Und ich hatte seinen seltsamen Traum ... Ich träumte von etwas, was ich dir mitteilen wollte.",
  },
  {
    "key": "conversation_v8dyjq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xvqfeq_text",
    "value": "Es hatte irgendwas mit Erdbeben, fließender Energie und ... und Maschinen zu tun ...",
  },
  {
    "key": "conversation_xvqfeq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6uvdlp_text",
    "metadata": {
      "notes": "*new* changed format from nervous to emph",
    },
    "value": "{format emph}Dorothy!{format reset}",
  },
  {
    "key": "conversation_6uvdlp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x1cve3_text",
    "value": "Was, Fen? Was hast du gesehen?",
  },
  {
    "key": "conversation_x1cve3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c268na_text",
    "value": "Ich sah ... nein, ich fühlte ... ich fühlte die Präsenz der Maschine des Jüngsten Gerichts.",
  },
  {
    "key": "conversation_c268na_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_glw2u1_text",
    "metadata": {
      "notes": "*new* added the phrase "come on" at the start of the line.",
    },
    "value": "Los, wir müssen unbedingt {format highlight}Rosie davon erzählen{format reset}. Diese Beben sind noch nicht vorbei.",
  },
  {
    "key": "conversation_glw2u1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vduxpt_text",
    "value": "{format laugh}Ahahaha...{format reset}, Gott war das cool!",
  },
  {
    "key": "conversation_vduxpt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_bez5tc_text",
    "value": "Ja, sieht ziemlich harmlos aus, nicht wahr?",
  },
  {
    "key": "conversation_bez5tc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_02t7hw_text",
    "value": "Dieses Ding besteht aus lauter Dampfbot- und Vectronteilen.",
  },
  {
    "key": "conversation_02t7hw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nloh4y_text",
    "value": "Warum sollte Rusty auf die Idee kommen, so etwas zu bauen?",
  },
  {
    "key": "conversation_nloh4y_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uo5vst_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Du machst dir zu viele Sorgen. Weniger denken und mehr Zerstörung anrichten!",
  },
  {
    "key": "conversation_uo5vst_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cqegx4_text",
    "value": "Wir sollten {format highlight} zur Oase zurückkehren{format reset} und Rosie davon berichten, dass die Maschine deaktiviert ist.",
  },
  {
    "key": "conversation_cqegx4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_o7pn77_text",
    "value": "Das hat sich seltsam zufriedenstellend angefühlt.",
  },
  {
    "key": "conversation_o7pn77_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fhtom3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Jetzt verstehen wir uns!",
  },
  {
    "key": "conversation_fhtom3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0j9ty2_text",
    "value": "...",
  },
  {
    "key": "conversation_0j9ty2_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_j80dt5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hast du das gespürt, Fen?",
  },
  {
    "key": "conversation_j80dt5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4ctogi_text",
    "value": "Vielleicht, keine Ahnung.",
  },
  {
    "key": "conversation_4ctogi_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5r8xoq_text",
    "value": "Fühlte sich nach einem kleinen, feinen Bebchen an.",
  },
  {
    "key": "conversation_5r8xoq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ue7igm_text",
    "value": "Brechen wir auf und {format highlight}demolieren wir die anderen Generatoren{format reset}!",
  },
  {
    "key": "conversation_ue7igm_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kx4acl_text",
    "value": "Und ein weiterer gibt klein bei.",
  },
  {
    "key": "conversation_kx4acl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7knnev_text",
    "value": "{format laugh}Jaa!{format reset}",
  },
  {
    "key": "conversation_7knnev_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7xkz1w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Es ist echt toll, das ganze hier mit jemanden zusammen zu machen ... nicht allein zu sein, wenn ...",
  },
  {
    "key": "conversation_7xkz1w_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_orn1ay_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hey, das war definitiv ein Erdbeben!",
  },
  {
    "key": "conversation_orn1ay_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b59rnh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Muss wohl eine Reaktion darauf sein, dass wir das Ding demoliert haben.",
  },
  {
    "key": "conversation_b59rnh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_s51o2b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format emph}Wenn{format reset} wir Rusty finden, werde für alles zur Rede stellen!",
  },
  {
    "key": "conversation_s51o2b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lxj451_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Keine Sorge, ich stehe hinter dir.",
  },
  {
    "key": "conversation_lxj451_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mk9qpq_text",
    "value": "{format laugh}Oha!{format reset}",
  },
  {
    "key": "conversation_mk9qpq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_p2ot9u_text",
    "value": "Holerö, das ist der Letzte!",
  },
  {
    "key": "conversation_p2ot9u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xxw7zr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Oje, das war aber ein großes Beben!",
  },
  {
    "key": "conversation_xxw7zr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p4nitu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Das ergibt keinen Sinn. Ich dachte, wir wären die Erdbeben endlich losgeworden.",
  },
  {
    "key": "conversation_p4nitu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_48h46n_text",
    "value": "Ja, ich bin sicher, dass das die letzte dieser Maschinen war.",
  },
  {
    "key": "conversation_48h46n_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_vkntr1_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "Ich habe da ein ganz mieses Gefühl. Es gibt zu viele offene Fragen.",
  },
  {
    "key": "conversation_vkntr1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nzra7p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Durchgeknallte Kultisten und giftige Dschungel! Und wo ist Rusty?!",
  },
  {
    "key": "conversation_nzra7p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3r7w00_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Klingt verdammt faul ...",
  },
  {
    "key": "conversation_3r7w00_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mboiam_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Vielleicht ist es gar nicht Rusty? Vielleicht hat sich Rosie geirrt ...",
  },
  {
    "key": "conversation_mboiam_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_iz5s2x_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oder sie hält etwas vor uns geheim.",
  },
  {
    "key": "conversation_iz5s2x_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xd4lj1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir müssen zur Oase zurückkehren und {format highlight}ein Wörtchen mit Rosie sprechen{format reset}.",
  },
  {
    "key": "conversation_xd4lj1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7k0m7s_text",
    "metadata": {
      "notes": "*new* changed this since we now have the old version of it triggered up by the first lever at the entrance to this temple",
    },
    "value": "Noch so ein nutzloser Hebel ...",
  },
  {
    "key": "conversation_7k0m7s_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_bqsv37_text",
    "metadata": {
      "notes": "*new* same as above",
    },
    "value": "Ich schätze den muss ich auch einfach irgendwie {format highlight}verstärken{format reset}?",
  },
  {
    "key": "conversation_bqsv37_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rzhlfx_text",
    "value": "Noch immer nichts!",
  },
  {
    "key": "conversation_rzhlfx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1l90nu_text",
    "value": "Diese Kohlenpfanne könnte vielleicht etwas bringen.",
  },
  {
    "key": "conversation_1l90nu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_q9t7dt_text",
    "metadata": {
      "notes": "*new* rephrased it.",
    },
    "value": "Ja, ich muss nur einen Weg finden, sie anzuzünden.",
  },
  {
    "key": "conversation_q9t7dt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sb7zou_text",
    "value": "Komm schon, {format laugh}zünden wird das Ding endlich an{format reset}!",
  },
  {
    "key": "conversation_sb7zou_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_utqc5b_text",
    "value": "Du hättest wirklich nicht hierher zurückkehren sollen.",
  },
  {
    "key": "conversation_utqc5b_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_8jri1u_text",
    "value": "Was machst du da? Lass ihn sofort gehen, Rosie!",
  },
  {
    "key": "conversation_8jri1u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_q1eysc_text",
    "metadata": {
      "notes": "*format* *new* changed "he was" to "he's"",
    },
    "value": "Ist dir eigentlich klar, wie viele Schnapsis bei der Jagd nach ihm verletzt wurden? Er ist eine Bestie!",
  },
  {
    "key": "conversation_q1eysc_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_0g9r4c_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Nun ist er nichts weiter als eine Batterie in meinem Mech-Anzug ... und ich bin ... endlich mächtig genug, um deinesgleichen von hier zu vertreiben und fernzuhalten!",
  },
  {
    "key": "conversation_0g9r4c_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_icw8pm_text",
    "metadata": {
      "notes": "*new* changed format from nervous to emph",
    },
    "value": "Du hast micht {format emph}betrogen{format reset}!",
  },
  {
    "key": "conversation_icw8pm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ir71cz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich habe dich {format emph}benutzt{format reset}! Du bist ein Werkzeug! Ich brauchte jemanden, der sich um diese lästigen Maschinen kümmert.",
  },
  {
    "key": "conversation_ir71cz_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_d3ola6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Er hat sie gebaut, um meiner Fusionsbrennerei die gesamte Energie abzusaugen ..., aber das war einmal!",
  },
  {
    "key": "conversation_d3ola6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_pdqri5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Der Reaktor versorgt mich jetzt mit allem, was ich brauche, um meine Art zu kontrollieren – einem endlosen Nachschub an Mondsaft!",
  },
  {
    "key": "conversation_pdqri5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_rdwldu_text",
    "value": "Sie werden nicht mehr länger umherwandern. Sie werden sicher sein ... und mir {format emph}den Respekt zollen, den ich verdiene.{format reset}",
  },
  {
    "key": "conversation_rdwldu_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_03yhdy_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich verstehe. Das hast du also gemeint, als du sagtest, Schnapsis seien verwirrt und gefährlich.",
  },
  {
    "key": "conversation_03yhdy_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hj0t32_text",
    "metadata": {
      "notes": "*new* removed a couple of format tags and just enclosed the whole line",
    },
    "value": "{format nervous}Die Erdbeben ... der Reaktor basiert auf instabiler Vectron-Technologie{format reset} ...",
  },
  {
    "key": "conversation_hj0t32_text.Speaker",
    "value": "invisible_dummy_01",
  },
  {
    "key": "conversation_jndfz3_text",
    "metadata": {
      "notes": "*new* changed format from nervous to laugh",
    },
    "value": "{format laugh}NEIN, DU BIST INSTABIL! ICH HABE ENDLICH DIE KONTROLLE!{format reset}",
  },
  {
    "key": "conversation_jndfz3_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_18qzvo_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Du bist verrückt! Komplett wahnsinnig.",
  },
  {
    "key": "conversation_18qzvo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8q2tds_text",
    "metadata": {
      "notes": "*new* changed format from nervous to laugh",
    },
    "value": "{format laugh}GENUG!{format reset}",
  },
  {
    "key": "conversation_8q2tds_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_iot2uu_text",
    "value": "{format nervous}D... Dot?{format reset}",
  },
  {
    "key": "conversation_iot2uu_text.Speaker",
    "value": "invisible_dummy_01",
  },
  {
    "key": "conversation_rtuuk8_text",
    "value": "Was?",
  },
  {
    "key": "conversation_rtuuk8_text.Speaker",
    "value": "hub_guard_2",
  },
  {
    "key": "conversation_4hbzdf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hi, was machst du hier?",
  },
  {
    "key": "conversation_4hbzdf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n15uxu_text",
    "value": "Ause bautz scheppo! Verschwinde!",
  },
  {
    "key": "conversation_n15uxu_text.Speaker",
    "value": "hub_guard_2",
  },
  {
    "key": "conversation_ciyvzv_text",
    "value": "{format nervous}Der Reaktor ... er wird gleich explodieren!{format reset}",
  },
  {
    "key": "conversation_ciyvzv_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_8qc79q_text",
    "value": "{format nervous}Die Erdbeben werden alles vernichten ...{format reset}",
  },
  {
    "key": "conversation_8qc79q_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_118c4u_text",
    "value": "{format nervous}Du musst hier weg!{format reset}",
  },
  {
    "key": "conversation_118c4u_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_qm6zc7_text",
    "value": "Niemals! Wir werden {format emph}gemeinsam von hier verschwinden!{format reset}",
  },
  {
    "key": "conversation_qm6zc7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7421mi_text",
    "value": "Niemals! Wir gehen alle zusammen!",
  },
  {
    "key": "conversation_7421mi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_90knk7_text",
    "value": "Wenn du uns auf diese Weise hilft, kannst du nicht mitkommen ...",
  },
  {
    "key": "conversation_90knk7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0kxcna_text",
    "value": "Wir haben keine Zeit! Es gibt keinen anderen Weg. Ihr beiden, rein hier!",
  },
  {
    "key": "conversation_0kxcna_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_cd5m29_text",
    "value": "Jetzt!",
  },
  {
    "key": "conversation_cd5m29_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_ebuimt_text",
    "metadata": {
      "notes": "*new* changed phrasing",
    },
    "value": "Wo sind denn alle hin?",
  },
  {
    "key": "conversation_ebuimt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nr0trv_text",
    "value": "Hm, das {format nervous}macht mir Angst.{format reset}",
  },
  {
    "key": "conversation_nr0trv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5r1v5j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir müssen {format highlight}Rosie finden{format reset} und herausfinden, was sie bis jetzt getrieben hat.",
  },
  {
    "key": "conversation_5r1v5j_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_17f2xe_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Oh Mann! Das muss die Maschine des Jüngsten Gerichts sein.",
  },
  {
    "key": "conversation_17f2xe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jiz6v8_text",
    "value": "Ich wollte mir einfach nicht eingestehen, dass Rusty eine Sache wie diese hervorbringen könnte ...",
  },
  {
    "key": "conversation_jiz6v8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nkppty_text",
    "value": "Das Ding scheint eine Menge Vectron-Teile zu beinhalten.",
  },
  {
    "key": "conversation_nkppty_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5mvh1h_text",
    "value": "Schrotten wir das Teil! {format laugh}Woah!{format reset}",
  },
  {
    "key": "conversation_5mvh1h_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_t5tmkl_text",
    "value": "Wow! Was ist das für ein Ding?",
  },
  {
    "key": "conversation_t5tmkl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_96wcqq_text",
    "value": "Sieht für mich nach Vectron-Technologie aus.",
  },
  {
    "key": "conversation_96wcqq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3ss3dz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Wir sollten es schnell in seine Einzelteile zerlegen!",
  },
  {
    "key": "conversation_3ss3dz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4kheve_text",
    "value": "Der Eingang ist blockiert!",
  },
  {
    "key": "conversation_4kheve_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ruxx9o_text",
    "value": "Glaubst du, dass die Erdbeben dafür verantwortlich sind?",
  },
  {
    "key": "conversation_ruxx9o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cct3lh_text",
    "value": "Wir müssen {format highlight}einen anderen Weg dort hinein finden{format reset} und mit Rosie sprechen.",
  },
  {
    "key": "conversation_cct3lh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_s6wiy7_text",
    "value": "Und was, hier total gelangweilt und einsam herumschweben?",
  },
  {
    "key": "conversation_s6wiy7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qzc1ay_text",
    "value": "Dein Ofen ist so schön warm und behaglich. Und es macht Spaß, dich zu nerven. {format laugh}Hehehe!{format reset}",
  },
  {
    "key": "conversation_qzc1ay_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ruux6m_text",
    "value": "{format nervous}Verdammt!{format reset} Für so etwas habe ich keine Zeit! Ich muss hier {format highlight}raus{format reset}!",
  },
  {
    "key": "conversation_ruux6m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_34h62o_text",
    "value": "{format laugh}Hehehe!{format reset} Hört sich an, als könntest du doch ein wenig Hilfe gebrauchen ...",
  },
  {
    "key": "conversation_34h62o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_de9yap_text",
    "value": "Ich habe dieses Gebiet bereits gescannt und, ich {format emph}glaube{format reset}, ich kann dich meine Karte verwenden lassen.",
  },
  {
    "key": "conversation_de9yap_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wk05yo_text",
    "value": "Verschwinden wir von hier!",
  },
  {
    "key": "conversation_wk05yo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_h6d5t0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Herrje! Na gut, dann komm.",
  },
  {
    "key": "conversation_h6d5t0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a9gtqb_text",
    "value": "Hey! Was macht denn so ein verfluchtes Mutantendings hier?!",
  },
  {
    "key": "conversation_a9gtqb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hsioxg_text",
    "value": "Das ist ein Schnapsi, Fen. Und nun sei leise, er schläft.",
  },
  {
    "key": "conversation_hsioxg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cl8j2w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Baglarb.",
  },
  {
    "key": "conversation_cl8j2w_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_erniqz_text",
    "metadata": {
      "notes": "*format* Crab is a hideously mutated Shiner. Look like Crab. Talk like people.",
    },
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "conversation_erniqz_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_hgy6ga_text",
    "value": "Entschuldige, ich wollte nur ...",
  },
  {
    "key": "conversation_hgy6ga_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xsba9s_text",
    "metadata": {
      "notes": "*format* Speaks jibberish and half sentences.",
    },
    "value": "Meine Steine, baglurb!",
  },
  {
    "key": "conversation_xsba9s_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_eottc5_text",
    "value": "Ähm ... okay ...",
  },
  {
    "key": "conversation_eottc5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tolx3y_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_tolx3y_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_cmj0mp_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_cmj0mp_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_kqftzz_text",
    "metadata": {
      "notes": "*new* added a introductory line for dorothy",
    },
    "value": "Hey, wie bist du hier runter gekommen?",
  },
  {
    "key": "conversation_kqftzz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x2c4hn_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "conversation_x2c4hn_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_1d144p_text",
    "value": "Tut mir leid, aber ...",
  },
  {
    "key": "conversation_1d144p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_opes3o_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Meine Röhren, baglurb!",
  },
  {
    "key": "conversation_opes3o_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_kzffu7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Okay, aber hier unten ist es nicht sicher. Du solltest einen besseren Ort zum abhängen finden.",
  },
  {
    "key": "conversation_kzffu7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_514n8o_text",
    "value": "Baglarb!",
  },
  {
    "key": "conversation_514n8o_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_rjibkc_text",
    "value": "Schon gut, schon gut!",
  },
  {
    "key": "conversation_rjibkc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_q4yhzp_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_q4yhzp_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_mo6w8t_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich werde erstmal ein Bad nehmen. Wird höchste Zeit, ich fange schon an zu müffeln.",
  },
  {
    "key": "conversation_mo6w8t_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_i5u7gc_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Un' ich mache gerne {format singsong}Blubberblassen.{format reset}",
  },
  {
    "key": "conversation_i5u7gc_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_h9b611_text",
    "value": "Dieser Ort hier ist wirklich ein Hit.",
  },
  {
    "key": "conversation_h9b611_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7u1oej_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Rosie hat ihn errichtet. Als wir jünger waren, war sie 'ne ganz schöne Heulsuse.",
  },
  {
    "key": "conversation_7u1oej_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_d9pcrg_text",
    "value": "Aber jetzt ist sie groß und stark und sorgt für unseren Nachschub an Mondsaft.",
  },
  {
    "key": "conversation_d9pcrg_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_5hc8jc_text",
    "metadata": {
      "notes": "*format* *new* broke this up into two lines",
    },
    "value": "Ich würde am liebsten direkt hineinspringen! Er wird {format emph}mir{format reset} auch Kraft verleihen.",
  },
  {
    "key": "conversation_5hc8jc_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_dqkik7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aber Rosie rührt das Zeug niemals an. Sie hebt stattdessen einfach schwere Sachen. Blöd, wenn ihr mich fragt!",
  },
  {
    "key": "conversation_dqkik7_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_jra7p9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich könnte jetzt etwas Mondsaft vertragen!",
  },
  {
    "key": "conversation_jra7p9_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_0ga9xz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ich mag diesen Ort hier zwar sehr, aber ... ich kann dem Ruf der Tunnel dort draußen einfach nicht widerstehen.",
  },
  {
    "key": "conversation_0ga9xz_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_6i3ly8_text",
    "value": "Brüllen regelrecht mit ihrem Getöse.",
  },
  {
    "key": "conversation_6i3ly8_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_l4t4ta_text",
    "value": "Ich vermisse das Schwimmen meiner täglichen Bahnen im Mondsaft.",
  },
  {
    "key": "conversation_l4t4ta_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_brmgbs_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Es ist zwar matschig und dickflüssig, aber mir geht es ohnehin nur darum, ein paar Blasen zu erzeugen.",
  },
  {
    "key": "conversation_brmgbs_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_iyntgs_text",
    "value": "Die Tunnel, sie rufen nach mir!",
  },
  {
    "key": "conversation_iyntgs_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_rb7d43_text",
    "value": "Hast du die diese kleinen Kriechtiere in den Tunneln gesehen?",
  },
  {
    "key": "conversation_rb7d43_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_s21hym_text",
    "value": "Diese Viecher kann man zu schmackhaften Krapfen verwursten.",
  },
  {
    "key": "conversation_s21hym_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_ky29gq_text",
    "value": "Frittiert und mit ein wenig {format singsong}Mondsaft übergossen{format reset} – das schmeckt, als ob der Sommer nie zu Ende geht.",
  },
  {
    "key": "conversation_ky29gq_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_7w4sjb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir bereiten uns ein richtig schönes, leckeres Grillfest!",
  },
  {
    "key": "conversation_7w4sjb_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_4b9cj5_text",
    "value": "Lecker. Ich mag frittiertes Kriechzeugs.",
  },
  {
    "key": "conversation_4b9cj5_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_ofc7fu_text",
    "value": "Mondsaft ist nicht nur gesund, er macht mich auch stärker.",
  },
  {
    "key": "conversation_ofc7fu_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_l41o8r_text",
    "value": "Ich könnte ein drittes Bein ganz gut gebrauchen.",
  },
  {
    "key": "conversation_l41o8r_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_hu136t_text",
    "value": "{format laugh}Oh jaah!{format reset} {format singsong}Blinde, unbegründete Gewalt und Zerstörung!{format reset}",
  },
  {
    "key": "conversation_hu136t_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_sfe0sl_text",
    "value": "...",
  },
  {
    "key": "conversation_sfe0sl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fjpwyo_text",
    "value": "Fen ... Ich komme wieder, um dich zu holen.",
  },
  {
    "key": "conversation_fjpwyo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_va1y6u_text",
    "value": "Ja ... Ich weiß.",
  },
  {
    "key": "conversation_va1y6u_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_5idlry_text",
    "value": "Geh jetzt!",
  },
  {
    "key": "conversation_5idlry_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_x36dp8_text",
    "value": ""ACHTUNG: BITTE NICHT WEITERGEHEN!"",
  },
  {
    "key": "conversation_x36dp8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p6icsu_text",
    "metadata": {
      "notes": "*new* chenged this to not be a quesetion",
    },
    "value": "Diese Kultisten sind doch allesamt durchgedreht.",
  },
  {
    "key": "conversation_p6icsu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rm0amb_text",
    "value": "Ja, so ziemlich.",
  },
  {
    "key": "conversation_rm0amb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4rm6n6_text",
    "value": "Irgendwie vermisse ich es, sie alle abzuknallen. Gehen wir hinein und sehen nach, ob wir noch mehr finden.",
  },
  {
    "key": "conversation_4rm6n6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5q7isk_text",
    "value": "Ich würde gerne diesen {format highlight}Propheten von ihnen in die Finger bekommen{format reset}. Vielleicht weiß er, wo Rusty gerade steckt.",
  },
  {
    "key": "conversation_5q7isk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jd7aed_text",
    "value": "Hier gibt es viele Röhren ... Möglicherweise gelangen wir hindurch, indem wir das Röhrensystem benutzen?",
  },
  {
    "key": "conversation_jd7aed_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5wy6ob_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Mich überkommt das dumpfe Gefühl, dass das andere Ende dieser Röhren in den unterirdischen Dschungel mündet.",
  },
  {
    "key": "conversation_5wy6ob_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_444mtr_text",
    "value": "Hey, sieh dir mal diesen durchsickernden Schlamm an! Wofür ist der wohl gut, was glaubst du?",
  },
  {
    "key": "conversation_444mtr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_9gicpx_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ehrlich gesagt – ich habe keine Ahnung. Er sieht aber nicht sehr nett aus.",
  },
  {
    "key": "conversation_9gicpx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h3f7cn_text",
    "value": "Vielleicht ist es eine Art Abfallentsorgungssystem für die Erdbebenmaschine.",
  },
  {
    "key": "conversation_h3f7cn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jf4lyk_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Was auch immer hier vor sich geht ... dieser Dschungel scheint sich auszubreiten.",
  },
  {
    "key": "conversation_jf4lyk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tkhd41_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Komm jetzt. Lass uns endlich diese Maschine finden, und sie zerstören.",
  },
  {
    "key": "conversation_tkhd41_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uo28un_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Hm, noch mehr Kristalle. Ich habe keine Kohlenpfannen in der Nähe gesehen.",
  },
  {
    "key": "conversation_uo28un_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_orh8x3_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Sie müssen irgendwo in diesem verflixten Tempel sein!",
  },
  {
    "key": "conversation_orh8x3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fytrwl_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Aber die Maschine des Jüngsten Gerichts ist da nicht drin. Ich will das Ding in seine Einzelteile zerlegen, {format emph}jetzt!{format reset}",
  },
  {
    "key": "conversation_fytrwl_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w7ohum_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Jupp, du hast immer noch nicht alle Kohlenpfannen gefunden.",
  },
  {
    "key": "conversation_w7ohum_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_r9v53t_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Und ich will die Maschine des Jüngsten Gerichts jetzt zerstören.",
  },
  {
    "key": "conversation_r9v53t_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ubahwy_text",
    "metadata": {
      "notes": "*new* added new sign. Operating Acolytes is a referenece to Operating Thetan from Scientology",
    },
    "value": ""Ronalds Schatzkammer. Das Betreten ist nur Akolythen mit Sicherheitsstufe VI oder höher gestattet."",
  },
  {
    "key": "conversation_ubahwy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y2rvga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Die Luke bewegt sich nicht. Der Hebel ist vollkommen nutzlos.",
  },
  {
    "key": "conversation_y2rvga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_voevwm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Vielleicht muss ich ihn einfach nur irgendwie {format highlight}verstärken{format reset}?",
  },
  {
    "key": "conversation_voevwm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_29icwu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Das hat nichts gebracht!",
  },
  {
    "key": "conversation_29icwu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_86fd8m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich bin mir sicher, dass ich sie einfach nur irgendwie {format highlight}verstärken{format reset} muss.",
  },
  {
    "key": "conversation_86fd8m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_one4s1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey, diese neue Panzerung ist ja abgefahren. Jetzt musst du dich nicht mehr beschweren, von Zeugs zerquetscht zu werden und so.",
  },
  {
    "key": "conversation_one4s1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_i2p8ul_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir sollten schon noch auf der Hut sein, aber du hast recht, sie sieht ziemlich cool aus, nicht wahr?",
  },
  {
    "key": "conversation_i2p8ul_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6i6u7w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Weißt du, was sie noch cooler machen würde ...?",
  },
  {
    "key": "conversation_6i6u7w_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_716uhd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format singsong}Flammen!{format reset}",
  },
  {
    "key": "conversation_716uhd_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mg2reo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "WOW! Ich glaube, diese Maschine hat meinen Düsenantrieb gerade in eine Waffe verwandelt.",
  },
  {
    "key": "conversation_mg2reo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3ldyrw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Spitze! Dann fackeln wir jetzt diese mutierte Pflanzenwelt ab!",
  },
  {
    "key": "conversation_3ldyrw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_gbh1g1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hoffentlich ist er auch effektiv gegen Dreck. Wir stecken hier unten wohl fest!",
  },
  {
    "key": "conversation_gbh1g1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tvs6ch_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey, dort unten lauern doch wohl keine Gefahren, meinst du nicht? Sieht eigentlich ganz sicher aus.",
  },
  {
    "key": "conversation_tvs6ch_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5oflga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Warum machen wir die Wand nicht einfach platt und sehen nach, was sich dort unten befindet? {format laugh}Hihihi!{format reset}",
  },
  {
    "key": "conversation_5oflga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6nymg5_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich denke, man hat diese Wand aus gutem Grund gebaut.",
  },
  {
    "key": "conversation_6nymg5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a8vok3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Und du bist nicht diejenige, die es total zerlegen wird, wenn wir unten aufschlagen.",
  },
  {
    "key": "conversation_a8vok3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pi5rzp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Mann, wo bleibt dein Abenteuerdrang?",
  },
  {
    "key": "conversation_pi5rzp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2h7zkh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Das nenne ich mal 'nen {format emph}riesigen Teich{format reset} voller geschmolzener Mineralien!",
  },
  {
    "key": "conversation_2h7zkh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tw04k8_text",
    "metadata": {
      "notes": "*new* These -> This",
    },
    "value": "Dieser Kult fährt echt total auf das ganze Feuer- und Verdammniszeugs ab. Ich komme nicht auf die andere Seite, ohne selber zu schmelzen.",
  },
  {
    "key": "conversation_tw04k8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c0o17p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tauch doch mal deinen Fuß rein. Vielleicht ist es ja gar nicht {format emph}so{format reset} heiß.",
  },
  {
    "key": "conversation_c0o17p_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_651wxm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich müsste feuerresistent sein!",
  },
  {
    "key": "conversation_651wxm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1hn8s0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oder du wärst so cool wie ich, dann könntest du einfach rüber fliegen.",
  },
  {
    "key": "conversation_1hn8s0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_8yyuh8_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich habe immer noch ein mulmiges Gefühl. Irgendetwas stimmt hier definitiv nicht.",
  },
  {
    "key": "conversation_8yyuh8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jytjex_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Rosie hat eine Menge zu erklären, sobald wir zur Oase zurückgekehrt sind.",
  },
  {
    "key": "conversation_jytjex_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_g4kaqx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich hätte von Anfang an misstrauischer sein sollen!",
  },
  {
    "key": "conversation_g4kaqx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vigvfw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wärst du misstrauischer, dann würde ich warscheinlich noch allein in dem Tempel sein.",
  },
  {
    "key": "conversation_vigvfw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2h3jtj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Jetzt lass uns aus diesem Kanal abhauen und nachsehen, was da vor sich geht.",
  },
  {
    "key": "conversation_2h3jtj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w0gsxo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey! Diese Raketen sehen genau so wie die aus, die wir auf unserem Weg hier her gesehen haben.",
  },
  {
    "key": "conversation_w0gsxo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_n0y3vf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Versuch sie mal mit deiner Picke zu schlagen!",
  },
  {
    "key": "conversation_n0y3vf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nctmv1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hätte nicht gedacht, dass ich mal zu diesem Tempel zurückkehren würde.",
  },
  {
    "key": "conversation_nctmv1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_77tocr_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dieser Ort ist viel größer als nur der Teil dort oben.",
  },
  {
    "key": "conversation_77tocr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jpag4c_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich habe nur in dem Totem rumgehangen und bin nie in diesen Bereich gekommen.",
  },
  {
    "key": "conversation_jpag4c_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rzcgxv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hier sollte es einen Haufen absolut tödlicher Fallen und solche coolen Sachen geben.",
  },
  {
    "key": "conversation_rzcgxv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hbejz0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Mist!{format reset} Aus dem Weg! Bürgermeister und Kleinbots zuerst!",
  },
  {
    "key": "conversation_hbejz0_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ma479g_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Entschuldigt! Eh ... Ich gehe, so schnell ich kann!{format reset}",
  },
  {
    "key": "conversation_ma479g_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_fudqd9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Immer mit der Ruhe Leute! Einer nach dem anderen! Stellt euch in einer geordneten Schlange auf!",
  },
  {
    "key": "conversation_fudqd9_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pox4ng_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey! Für Schlangen haben wir keine Zeit! Jetzt steigt endlich in die Rakete einsteigen, bevor hier alles einstürzt!",
  },
  {
    "key": "conversation_pox4ng_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ewm51b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hau dir einen Bolzen in den Kiefer! Da sind immer noch Bots in der verdammten Mine. Wir können unsere Leute nicht einfach zurücklassen!",
  },
  {
    "key": "conversation_ewm51b_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tdyz6x_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Mr. Heisenberg ist bereit, die Rakete zu zünden, aber ich kann den Start um ein paar Minuten verzögern ... Dann müssen wir {format emph}durchstarten{format reset}.",
  },
  {
    "key": "conversation_tdyz6x_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vtsrcc_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Ziep-Piep{format reset} baglarb!",
  },
  {
    "key": "conversation_vtsrcc_text.Speaker",
    "value": "Barnacle Jones?",
  },
  {
    "key": "conversation_9s60lp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ja! Du sagst es, Mr. Krabbenbein!",
  },
  {
    "key": "conversation_9s60lp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qo44wn_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Was? Ich habe keinen Mucks gemacht.",
  },
  {
    "key": "conversation_qo44wn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_353gqh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Was zum Henker?!{format reset}",
  },
  {
    "key": "conversation_353gqh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_1engeq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oh, da bist du ja, Herzchen! Dem Erbauer sei Dank, es geht dir gut!",
  },
  {
    "key": "conversation_1engeq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ch1z21_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tolle Darbietung! Ich befürchtete schon, dass du dich verirrt hast.",
  },
  {
    "key": "conversation_ch1z21_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tb8wpb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du hast deinen Freund mit dem roten Schal gefunden. Aber wo ist deine kleine leuchtende Freundin abgeblieben?",
  },
  {
    "key": "conversation_tb8wpb_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_pbnvye_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Das ... Das ist eine lange Geschichte. Ich muss ...",
  },
  {
    "key": "conversation_pbnvye_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_u2fefz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Nun, es freut mich, dass dir nichts fehlt, aber ich kann nicht genug betonen, dass wir {format emph}keine Zeit mehr haben{format reset}.",
  },
  {
    "key": "conversation_u2fefz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_hi1tn7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Alle in die Rakete einsteigen!",
  },
  {
    "key": "conversation_hi1tn7_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_t4edhq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Zeit für uns Bots, ein paar Weltraumabenteuer zu erleben! {format singsong}Yippie!{format reset}",
  },
  {
    "key": "conversation_t4edhq_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_as8gn2_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eine letzte Sache noch, Fräulein.",
  },
  {
    "key": "conversation_as8gn2_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_3qlskx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du stehst davor, dort unten eine riesige und gefährliche Welt zu erkunden ...",
  },
  {
    "key": "conversation_3qlskx_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_24mz6s_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wenn du verfolgen möchtest, in welche Richtung du dich begibst, kannst du diese Markierungen auf deiner Karte ({image quest_pointer_arrow} und {image quest_pointer_crosshair}) verwenden.",
  },
  {
    "key": "conversation_24mz6s_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4j1s12_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich schätze, du bist ein weiser Bot.",
  },
  {
    "key": "conversation_4j1s12_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_mdsij3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich schätze, du bist ziemlich draufgängerisch.",
  },
  {
    "key": "conversation_mdsij3_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_vaf0gm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du hast vielleicht die blauen Pfeile ({image quest_pointer_arrow}) und Fadenkreuze ({image quest_pointer_crosshair}) auf deiner Karte bemerkt.",
  },
  {
    "key": "conversation_vaf0gm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4zvbgq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Man könnte sagen, ohne Markierungen bietet das Spiel eher eine "klassische" Erfahrung. Ob das eine gute Sache ist oder nicht ...",
  },
  {
    "key": "conversation_4zvbgq_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_9ah4fv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aber sei unbesorgt. Du kannst die Markierungen bei der Werkbank in der Stadt jederzeit an- oder abschalten.",
  },
  {
    "key": "conversation_9ah4fv_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_rkswy7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Also, was sagst du? Möchtest du die Markierungen ({image quest_pointer_arrow} und {image quest_pointer_crosshair}) auf dem Weg anzeigen lassen?",
  },
  {
    "key": "conversation_rkswy7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_w3uj01_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wie ich schon sagte ...",
  },
  {
    "key": "conversation_w3uj01_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_bw07t1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Du kannst die Markierungen bei der Werkbank in der Stadt jederzeit an- oder abschalten.",
  },
  {
    "key": "conversation_bw07t1_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_dvacv4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Also, ich will dich nicht länger aufhalten. Viel Glück dabei, im Rotfelsgang {format highlight}die Röhren freizuräumen{format reset}.",
  },
  {
    "key": "conversation_dvacv4_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wamta4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey, diese Technologie stammt aus Vectron!",
  },
  {
    "key": "conversation_wamta4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lkvb6m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Scheint jedoch nicht zu funktionieren.",
  },
  {
    "key": "conversation_lkvb6m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ocl1pj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_ocl1pj_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_llzd7n_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Fen?",
  },
  {
    "key": "conversation_llzd7n_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_74v2pp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_74v2pp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_hi83wt_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Scheint jedenfalls eine Sackgasse zu sein. Lass uns hier verschiwnden.",
  },
  {
    "key": "conversation_hi83wt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_u4cd0d_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Was ist los, Fen?",
  },
  {
    "key": "conversation_u4cd0d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3rpf0f_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich will {format emph}da{format reset} nicht rein. Lass uns umdrehen.",
  },
  {
    "key": "conversation_3rpf0f_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_supvbe_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dort draußen in den Minen gibt es 'ne Menge anderer Dinge zu tun.",
  },
  {
    "key": "conversation_supvbe_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tm3xhy_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Schon wieder dieser Teich voller geschmolzener Mineralien, hm?",
  },
  {
    "key": "conversation_tm3xhy_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_35yo2u_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ich glaube diesmal {format emph}müssen{format reset} wir ihn überqueren.",
  },
  {
    "key": "conversation_35yo2u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mhir26_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Blos gut, dass du jetzt fast so cool bist wie ich ...",
  },
  {
    "key": "conversation_mhir26_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fnd2g3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Fast.",
  },
  {
    "key": "conversation_fnd2g3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b0opbb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Das nenne ich mal 'nen {format emph}riesigen Teich{format reset} voller geschmolzener Mineralien!",
  },
  {
    "key": "conversation_b0opbb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_17hzlg_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dieser Kult fährt echt total auf das ganze Feuer- und Verdammniszeugs ab.",
  },
  {
    "key": "conversation_17hzlg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b7hr8v_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Lass ihn uns endlich überqueren.",
  },
  {
    "key": "conversation_b7hr8v_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_alk15j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Jepp! Weißt du, mit dieser ganzen neuen Ausrüstung bist du fast so cool wie ich ...",
  },
  {
    "key": "conversation_alk15j_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qa992m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Fast.",
  },
  {
    "key": "conversation_qa992m_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2ou9oe_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hey sieh mal! Das sind die überreste meines alten Totems.",
  },
  {
    "key": "conversation_2ou9oe_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wz87u3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Fühlt sich wie eine Ewigkeit an, seit wir uns hier begegnet sind, oder?",
  },
  {
    "key": "conversation_wz87u3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qxncbz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ja ... Ich kann nicht wirklich sagen, dass ich es vermisse, {format emph}da drin{format reset} gefangen zu sein.",
  },
  {
    "key": "conversation_qxncbz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rvd9qx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Kultisten abzuknallen hat echt Spass gemacht uns so, aber ich war die ganze Zeit allein.",
  },
  {
    "key": "conversation_rvd9qx_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_flred4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dieses Ding sieht echt bedrohlich aus, wenn es offen ist.",
  },
  {
    "key": "conversation_flred4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_z5ls33_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Müssen wir da wirklich reingehen?",
  },
  {
    "key": "conversation_z5ls33_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_n7df2r_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Okay. Sehen wir mal nach, was der dicke Schnapsi hier so treibt.",
  },
  {
    "key": "conversation_n7df2r_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_viru7l_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Wir wissen nicht, was Rosie da drin alles gemacht hat. Vielleicht sollten wir uns etwas vorbereiten, bevor wir reingehen?",
  },
  {
    "key": "conversation_viru7l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tkltgz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Alle Verbesserungen erlaubt."",
  },
  {
    "key": "conversation_tkltgz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_40ih51_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Fassaden und Illusionen."",
  },
  {
    "key": "conversation_40ih51_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_m31axp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Kein Greifhaken erlaubt."",
  },
  {
    "key": "conversation_m31axp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cbb9jh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Kein Düsenantrieb, \\nkein Greifhaken erlaubt."",
  },
  {
    "key": "conversation_cbb9jh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0tzxsw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Kein Düsenantrieb erlaubt."",
  },
  {
    "key": "conversation_0tzxsw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3k7mx1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Keine Verbesserungen erlaubt."",
  },
  {
    "key": "conversation_3k7mx1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mrg3os_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Nur Greifhaken erlaubt."",
  },
  {
    "key": "conversation_mrg3os_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ytjucx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Nur Düsenantrieb erlaubt."",
  },
  {
    "key": "conversation_ytjucx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nol9uu_text",
    "metadata": {
      "notes": "*TEMP* *NEW*",
    },
    "value": ""Bleibt die Tür verschlossen\\nWar die Lava dir nicht wohlgesonnen\\nSelbst die kleinste Berührung\\nKomme herein von Neuem"",
  },
  {
    "key": "conversation_nol9uu_text.Speaker",
    "value": "Dorothy",
  },
]
`;

