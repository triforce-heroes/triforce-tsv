  },
  {
    "key": "upgrade_pickaxe_bounty_flavor",
    "value": ""Ein paar machen's für's Geld, andere für die Jagd."",
  },
  {
    "key": "upgrade_pickaxe_health_pickup",
    "value": "Sanitäter",
