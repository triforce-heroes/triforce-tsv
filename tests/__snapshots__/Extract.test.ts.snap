  },
  {
    "key": "menu_options_input_tool_jackhammer",
    "value": "Utiliser Marteau-piqueur",
  },
  {
    "key": "menu_options_input_tool_jackhammer_desc",
    "value": "Utilise le marteau-piqueur.",
  },
  {
    "key": "menu_options_input_tool_hookshot",
    "value": "Utiliser Tir-grappin",
  },
  {
    "key": "menu_options_input_tool_hookshot_desc",
