exports[`extract(tests\\fixtures\\en_conversations.csv) function > matches snapshot > tests\\fixtures\\en_conversations.csv 1`] = `
[
  {
    "key": "buddy_inventory_full.conversation_yjp8nk_text",
    "notes": "Speaker=Fen Notes=Comes up when your inventory is full anyou try to pick up more ores.",
    "value": "Hey, your {format highlight}bag's already full{format reset}, doofus.",
  },
  {
    "key": "ore_vendor.conversation_hxfr0f_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* added "there"",
    "value": "Hey, got anything shiny for me there?",
  },
  {
    "key": "ore_vendor.conversation_jh3i2m_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Say, you've found a few rocks you want to trade for some moolah?",
  },
  {
    "key": "ore_vendor.conversation_69vpc2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo. Moved this node",
    "value": "Got anything valuable to trade with me?",
  },
  {
    "key": "ore_vendor.conversation_mi3myw_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Come on then! Let's do some real business, you and me.",
  },
  {
    "key": "ore_vendor.conversation_2l670i_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Now, what you got for me this time?",
  },
  {
    "key": "ore_vendor.conversation_89hare_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Now show me what you've found down there.",
  },
  {
    "key": "ore_vendor.conversation_dfflv5_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Now, I'll still take any ore off your clamps if you got it.",
  },
  {
    "key": "ore_vendor.conversation_dvsj68_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "You know, Mayor Yonker may be a chump, but he's right this time. We need to keep that ore flowing!",
  },
  {
    "key": "ore_vendor.conversation_gk3axq_text",
    "notes": "Speaker=Barnacle Jones Notes=*format* Hair on steambots is made of metal.",
    "value": "I heard he's fretting so much about it, his hair's started to rust, see?",
  },
  {
    "key": "ore_vendor.conversation_mosq62_text",
    "notes": "Speaker=Barnacle Jones Notes=" clamps" is the equivavlent of hands, since they are robots.",
    "value": "Now me, I'll always take any ore off a miner's clamps - whatever the circumstances!",
  },
  {
    "key": "ore_vendor.conversation_fnygz1_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll-face to kiddo.",
    "value": "Ain't nothing more important than keeping that ore flowing, kiddo.",
  },
  {
    "key": "ore_vendor.conversation_7dsj17_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Say, the town's a whispering about the fact that we found a fresh bot to work the mine.",
  },
  {
    "key": "ore_vendor.conversation_mh0ja0_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm actually here looking for a friend of mine. Quiet type, wears a red scarf.",
  },
  {
    "key": "ore_vendor.conversation_y6ys6p_text",
    "notes": "Speaker=Barnacle Jones Notes=Real McCoy= the real deal.",
    "value": "I knows the bot. Looked like the real McCoy, but boy was he a flat tire!",
  },
  {
    "key": "ore_vendor.conversation_0lzsu6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Didn't come back up even once, see?",
  },
  {
    "key": "ore_vendor.conversation_bhqgnn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    "value": "I hope you'll do a better job, kid.",
  },
  {
    "key": "ore_vendor.conversation_21a760_text",
    "notes": "Speaker=Barnacle Jones Notes=Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    "value": "Say, I'm guessing you heard about them clogged tubes.",
  },
  {
    "key": "ore_vendor.conversation_oxkxen_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Now I ain't one to gossip, but from what I've heard, the mayor closed them to get back at his minerbot brothers.",
  },
  {
    "key": "ore_vendor.conversation_2zloko_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Speaking of which, I haven't seen those saps in a while.",
  },
  {
    "key": "ore_vendor.conversation_xwxxg4_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I was hoping they'd step up their game now that you've brought some competition.",
  },
  {
    "key": "ore_vendor.conversation_gmenrv_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Should've known better than to expect hard work from them dewdroppers.",
  },
  {
    "key": "ore_vendor.conversation_xkngbf_text",
    "notes": "Speaker=Barnacle Jones Notes=mazumas= slang for money, please do translate.",
    "value": "Anyway, having the tubes closed is costing me a lot of mazumas, see?",
  },
  {
    "key": "ore_vendor.conversation_xfxkz8_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "There's riches just waiting to be found below those layers of brick and mortar.",
  },
  {
    "key": "ore_vendor.conversation_op5xlx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "If you happen on some shiners, clip them before you end up in a wooden overcoat.",
  },
  {
    "key": "ore_vendor.conversation_whma58_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "From what I've heard, they's usually all gowed up on Moon Juice and looking to scrap, see?",
  },
  {
    "key": "ore_vendor.conversation_t5mwlu_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "They can't get enough of that sludge. It makes them stronger but it also makes them all goofy.",
  },
  {
    "key": "ore_vendor.conversation_649tjr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "It's also highly corrosive, so you probably don't want to take a dip in it.",
  },
  {
    "key": "ore_vendor.conversation_03e7vh_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Say, I don't know if you've heard, but the rich professor up above has gone all nutty.",
  },
  {
    "key": "ore_vendor.conversation_u2ersk_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "She lost it after her house tumbled during one of the first earthquakes, see?",
  },
  {
    "key": "ore_vendor.conversation_h9iaiy_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Now she's {format emph}building a rocket{format reset} with all her sweet inherited scratch.",
  },
  {
    "key": "ore_vendor.conversation_3jgp0a_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I even heard she's in contact with a whole network of rocketeers.",
  },
  {
    "key": "ore_vendor.conversation_9mc50k_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "They's building these things all over the planet.",
  },
  {
    "key": "ore_vendor.conversation_bsxzro_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Say, have you taken the time to search all the caves you've come across, kid?",
  },
  {
    "key": "ore_vendor.conversation_dz2y8u_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "They're often a bit more hard boiled than the rest of the mines.",
  },
  {
    "key": "ore_vendor.conversation_3g80ch_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "But there is a good chance you'll find some more valuable stuff in them, see?",
  },
  {
    "key": "ore_vendor.conversation_nmjdda_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Once you've found everything in a cave, it should be marked {image cave_small} on your map. So you don't have to dig around for no reason.",
  },
  {
    "key": "ore_vendor.conversation_u3ck3c_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Who could've guessed those dingbat cultists had so many riches beneath that old ruin?",
  },
  {
    "key": "ore_vendor.conversation_zh09qm_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "We should've started digging there years ago!",
  },
  {
    "key": "ore_vendor.conversation_g3jyqr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*'",
    "value": "Sure, I've heard the ruins are occupied by a crazy cult, worshipping the end of the world.",
  },
  {
    "key": "ore_vendor.conversation_m4g0mn_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "That's their business, and I ain't one to pry into other bots' affairs, see?",
  },
  {
    "key": "ore_vendor.conversation_figdnq_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Say, just look at this city. I first came here in my youth. Trying to escape the dockworker's life.",
  },
  {
    "key": "ore_vendor.conversation_saxa80_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "This place was a lot smaller back then, but it was brimming with potential, see?",
  },
  {
    "key": "ore_vendor.conversation_c0haij_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I managed to build a thriving business here, and it all came down to moxie.",
  },
  {
    "key": "ore_vendor.conversation_3qiyya_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid",
    "value": "You have to dare go for the unexplored places of the world, kid.",
  },
  {
    "key": "ore_vendor.conversation_281tok_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "It might be a risk but that's how you get the big rewards.",
  },
  {
    "key": "ore_vendor.conversation_ef7tr2_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I've heard talk about this strange unnatural jungle growing in the mine.",
  },
  {
    "key": "ore_vendor.conversation_amxf2l_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Of course that won't stop someone like you.",
  },
  {
    "key": "ore_vendor.conversation_mp7r9y_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I'm just worried it'll scare off any whimpy miners, see?",
  },
  {
    "key": "ore_vendor.conversation_fmy8mc_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Say, the professor's getting her rocket ready for blastoff. ",
  },
  {
    "key": "ore_vendor.conversation_mxjgvx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "I thought she was just a nut job, but now I'm thinking she's got the right idea, see?",
  },
  {
    "key": "ore_vendor.conversation_gd4ef6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Space is completely unexplored and ripe with new business opportunities.",
  },
  {
    "key": "ore_vendor.conversation_wr4wq2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo",
    "value": "I've managed to build a new life out of nothing before, kiddo.",
  },
  {
    "key": "ore_vendor.conversation_mkud7m_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "If anything I'm more prepared now than when I was a youngster.",
  },
  {
    "key": "ore_vendor.conversation_08cc91_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved it to the bottom",
    "value": "You just come back any time you've got ore to sell, see?",
  },
  {
    "key": "inhabitant_01.conversation_07qv1j_text",
    "notes": "Speaker=Ma Yonker",
    "value": "That worthless son of mine has no idea what he's doing.",
  },
  {
    "key": "inhabitant_01.conversation_vx6mcl_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "We need competent people down below looking into what's causing these dang earthquakes!",
  },
  {
    "key": "inhabitant_01.conversation_hlqiyo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I know what a tectonic plate feels like when it's moving. By thunder, this ain't it, dearie!",
  },
  {
    "key": "inhabitant_01.conversation_q4ltpg_text",
    "notes": "Speaker=Ma Yonker",
    "value": "We need someone with brains and gusto to go down that mine.",
  },
  {
    "key": "inhabitant_01.conversation_8w93yl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I've been working the mines for ages, dearie... but I never felt anything like these earthquakes.",
  },
  {
    "key": "inhabitant_01.conversation_ibhbb2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I'd check them out myself if I could, but look at me... Not much miner left.",
  },
  {
    "key": "inhabitant_01.conversation_ffq3ty_text",
    "notes": "Speaker=Dorothy",
    "value": "What happened to you?",
  },
  {
    "key": "inhabitant_01.conversation_9hmzci_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ooh! Was it some horrible mining accident!?",
  },
  {
    "key": "inhabitant_01.conversation_uy4syk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nope! I gave up a lot of body parts to make all my coggone boys. Biggest mistake of my life...",
  },
  {
    "key": "inhabitant_01.conversation_g3ij4k_text",
    "notes": "Speaker=Fen Notes=*new* changed format from emph to singsong",
    "value": "{format singsong}Boooring!{format reset}",
  },
  {
    "key": "inhabitant_01.conversation_xxgpup_text",
    "notes": "Speaker=Ma Yonker",
    "value": "If I still could, I'd be down those confounded tunnels in a jiffy!",
  },
  {
    "key": "inhabitant_01.conversation_dgq9o3_text",
    "notes": "Speaker=Ma Yonker",
    "value": "If you're planning on going deep down, you'd better {format highlight}fix that light{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_o8vje6_text",
    "notes": "Speaker=Dorothy",
    "value": "Is the mine really that dangerous?",
  },
  {
    "key": "inhabitant_01.conversation_0c28a8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Well, there are some nasty crawlers, but at least I haven't seen any flippin' shiners in a while.",
  },
  {
    "key": "inhabitant_01.conversation_tt1za6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "My older boys have been patching the walls to keep those fleshy bipeds out.",
  },
  {
    "key": "inhabitant_01.conversation_n71xfs_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I was a young girlbot when the shiner wars ended, but I still remember the bad parts.",
  },
  {
    "key": "inhabitant_01.conversation_u3tho1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Anyway, it's always best to be prepared down there, dearie.",
  },
  {
    "key": "inhabitant_01.conversation_8xtyi1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Just {format highlight}use the workbench{format reset} next to the mine to fix that light. If you can afford the parts, that is...",
  },
  {
    "key": "inhabitant_01.conversation_y2vq9y_text",
    "notes": "Speaker=Ma Yonker",
    "value": "By thunder! You sure look ready to {format highlight}enter the mine{format reset} now, dearie.",
  },
  {
    "key": "inhabitant_01.conversation_st3zju_text",
    "notes": "Speaker=Dorothy",
    "value": "Has anyone been down to Red Rock Passage lately?",
  },
  {
    "key": "inhabitant_01.conversation_0zamqc_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Not since those darn tubes stopped working, dearie.",
  },
  {
    "key": "inhabitant_01.conversation_5atg04_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You'll need to pass through there if you're thinking about exploring the whole mine.",
  },
  {
    "key": "inhabitant_01.conversation_caroq1_text",
    "notes": "Speaker=Dorothy",
    "value": "I should probably {format highlight}clear out the tube{format reset} first though.",
  },
  {
    "key": "inhabitant_01.conversation_kq5k2e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Just be aware that the dirt gets tougher further down, so you'll need to keep your gear in shape.",
  },
  {
    "key": "inhabitant_01.conversation_yo8vom_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Red Rock is the only way to get deeper into the mine. At least while the dang tube system's down.",
  },
  {
    "key": "inhabitant_01.conversation_sxlsip_text",
    "notes": "Speaker=Dorothy",
    "value": "I hope I can use explosives to open up Red Rock Passage.",
  },
  {
    "key": "inhabitant_01.conversation_2e9pz1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Should work fine. I've had to do that more than a few dang times myself.",
  },
  {
    "key": "inhabitant_01.conversation_wkl33e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Just head down to Burster's Station and {format highlight}get them explosives{format reset} first.",
  },
  {
    "key": "inhabitant_01.conversation_xtf9h2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Shouldn't we be glad that the passage is still holding up as it is? I don't think we're insured against explosives.",
  },
  {
    "key": "inhabitant_01.conversation_5jzc1m_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Red Rock Passage is the only way to the deeper parts of the mine, now that the tube system is down.",
  },
  {
    "key": "inhabitant_01.conversation_3vmqnk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I hope you're making progress down there, dearie.",
  },
  {
    "key": "inhabitant_01.conversation_u6rmdw_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Professor Sherman has me worried about these cogawful earthquakes.",
  },
  {
    "key": "inhabitant_01.conversation_nxlgy6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "She's up there spending all her money building that rocket.",
  },
  {
    "key": "inhabitant_01.conversation_ginz3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "She's frigging smart, and I gather she's working on an exit plan.",
  },
  {
    "key": "inhabitant_01.conversation_jkfreb_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I just wish my idiot boy had the coggarn mind to listen to her for two seconds.",
  },
  {
    "key": "inhabitant_01.conversation_3pntbk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Well! You're just a real miner, aren't you!",
  },
  {
    "key": "inhabitant_01.conversation_ebwh66_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Just head back down to Red Rock Passage and clear that darn rubble away.",
  },
  {
    "key": "inhabitant_01.conversation_dayt2l_text",
    "notes": "Speaker=Dorothy",
    "value": "Red Rock blew right open with one well-placed charge!",
  },
  {
    "key": "inhabitant_01.conversation_5ji97r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Yeah, except for all the cave-ins, it's a dang sturdy construction.",
  },
  {
    "key": "inhabitant_01.conversation_m6zdrd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "I'm just glad it's still standing.",
  },
  {
    "key": "inhabitant_01.conversation_k7klvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You'll need to keep your gear up to snuff to handle the dirt at those depths.",
  },
  {
    "key": "inhabitant_01.conversation_dspvhm_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "And hey now, be sure to bring up more of those precious stones!",
  },
  {
    "key": "inhabitant_01.conversation_sl7olj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Use some of the cash to keep all your gear up to par. It'll pay off deeper down.",
  },
  {
    "key": "inhabitant_01.conversation_x0wxp1_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm going to need a way to get to Mason's Station.",
  },
  {
    "key": "inhabitant_01.conversation_63gsgh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "There's all kinds of cracks and passages down there, believe me!",
  },
  {
    "key": "inhabitant_01.conversation_qp9quj_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "My brothers have a knack for finding them... and getting lost for days.",
  },
  {
    "key": "inhabitant_01.conversation_x7yuib_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Those meatbag shiners have also been known to break through and wreak havoc.",
  },
  {
    "key": "inhabitant_01.conversation_hc3b2x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Scout the mine down by the shiner walls. I bet you'll {format highlight}find the mining station{format reset}, dearie.",
  },
  {
    "key": "inhabitant_01.conversation_gducoe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Seen any dang shiners yet, dearie? It's been a while since they caused trouble.",
  },
  {
    "key": "inhabitant_01.conversation_yr3kie_text",
    "notes": "Speaker=Dorothy",
    "value": "I noticed they disappeared from beneath Tumbleton, my home town, too.",
  },
  {
    "key": "inhabitant_01.conversation_owuynx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "So it's a widespread thing, huh? I haven't seen one for a few months, at least.",
  },
  {
    "key": "inhabitant_01.conversation_3h8ujv_text",
    "notes": "Speaker=Dorothy",
    "value": "They became scarce right after Rusty destroyed Vectron.",
  },
  {
    "key": "inhabitant_01.conversation_ezzezr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I'm sure I don't know much about that, but shiners I know.",
  },
  {
    "key": "inhabitant_01.conversation_dpbib8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "They always used to find ways through the wall to cause trouble for us miners.",
  },
  {
    "key": "inhabitant_01.conversation_3c3lpm_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Maybe they're worried about these quakes too? Like vermin leaving a sinking ship!",
  },
  {
    "key": "inhabitant_01.conversation_tcvt6a_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Can't say if it's a good or a bad sign that the shiners have been this quiet.",
  },
  {
    "key": "inhabitant_01.conversation_67vh5i_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, I found the shiners! They've built a little town, hidden away in the mine.",
  },
  {
    "key": "inhabitant_01.conversation_iu5kqd_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "What in tarnation! I'd stay well clear of a place like that. Can't be safe!",
  },
  {
    "key": "inhabitant_01.conversation_vhdww6_text",
    "notes": "Speaker=Dorothy",
    "value": "They actually didn't seem that bad. Not like the ones I've met before.",
  },
  {
    "key": "inhabitant_01.conversation_cbcmjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "There's one thing I'm coggarn certain of. You can never trust a shiner!",
  },
  {
    "key": "inhabitant_01.conversation_0glm7l_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Stay well away from that there shiner town, if you know what's good for you!",
  },
  {
    "key": "inhabitant_01.conversation_umbt7u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Digging about the temple can be pretty darn dangerous, but there's still lots of valuables there.",
  },
  {
    "key": "inhabitant_01.conversation_c5baff_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, now that sounds promising! You should definitely go there and find some more.",
  },
  {
    "key": "inhabitant_01.conversation_r8rlnp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Aw heck! You'd need some gusto to enter those ruins just to get at some valuable ore.",
  },
  {
    "key": "inhabitant_01.conversation_m8hqwy_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Not even his brothers are crazy enough to {format highlight}enter the temple{format reset} beyond the Windy Plains.",
  },
  {
    "key": "inhabitant_01.conversation_bvz9xj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "There's a crazy doom cult that gone claimed it as theirs.",
  },
  {
    "key": "inhabitant_01.conversation_fj6bw8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "They've even taken over the ruins in the west desert too.",
  },
  {
    "key": "inhabitant_01.conversation_u26tuh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I bet that crazy old Ronald is still calling the shots. Used to be a nice feller, but all this religious dung got to his head.",
  },
  {
    "key": "inhabitant_01.conversation_gr738j_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "That temple beyond the Windy Plains might be filled with riches, but it's still a pretty darn dangerous place to dig.",
  },
  {
    "key": "inhabitant_01.conversation_grrmq6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Looks like you're getting really dang deep on your quest, dearie!",
  },
  {
    "key": "inhabitant_01.conversation_335kyr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You might find traces of earlier civilizations down there. Just like those old machines in the mining stations.",
  },
  {
    "key": "inhabitant_01.conversation_2jepw2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "They've been down there since before even I can remember.",
  },
  {
    "key": "inhabitant_01.conversation_mv0s6q_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I've heard some smart bots saying it's the shiners that built them.",
  },
  {
    "key": "inhabitant_01.conversation_vxki0p_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Those bots don't sound so smart to me. Probably call themselves "experts" too.",
  },
  {
    "key": "inhabitant_01.conversation_ysj9vo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I'm not sure I'd risk digging that deep below shiner country. Who knows what you'll find!",
  },
  {
    "key": "inhabitant_01.conversation_uj1muo_text",
    "notes": "Speaker=Dorothy",
    "value": "I've got a lot of places to dig out if I'm to stop these earthquakes.",
  },
  {
    "key": "inhabitant_01.conversation_ykczsp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I've heard the professor mention a jungle spreading throughout the mine. ",
  },
  {
    "key": "inhabitant_01.conversation_z8gocf_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tarnations! That doesn't sound very good!",
  },
  {
    "key": "inhabitant_01.conversation_dzwjvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "How's a bot to mine amid dangers like that... How'll my darn sons manage?",
  },
  {
    "key": "inhabitant_01.conversation_x3v93r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I don't know if you've noticed, but they're really darn stupid.",
  },
  {
    "key": "inhabitant_01.conversation_jmwahi_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I guess we'll just have to see about getting some room on that rocket ship.",
  },
  {
    "key": "inhabitant_01.conversation_8augkl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "My boys might be useless, but they're still my bits and gears.",
  },
  {
    "key": "inhabitant_01.conversation_9v0sjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I guess I'll just have to get five tickets for that flight into space?",
  },
  {
    "key": "inhabitant_01.conversation_p75xau_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nice of you to listen to the ramblings of an old bot. Bet you make your parents proud!",
  },
  {
    "key": "inhabitant_01.conversation_8hjn65_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Not like my sons. Doggarn useless, the lot of them.",
  },
  {
    "key": "inhabitant_01.conversation_x6q3po_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Most of them keep getting themselves lost "working" the mine. Then there's that dang politician over there.",
  },
  {
    "key": "inhabitant_01.conversation_8tssip_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nice to have someone down the tunnels who knows what they're doing!",
  },
  {
    "key": "inhabitant_02.conversation_royiqq_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*new*",
    "value": "Oh my, oh my! That was a very big {format nervous}earthquake{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_0z0jlu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Gee wiz! You look like a small-town bot, just like me! {format singsong}How wonderful!{format reset}",
  },
  {
    "key": "inhabitant_02.conversation_i3c2ki_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "I've been feeling so lonely lately. Like a proper outsider.",
  },
  {
    "key": "inhabitant_02.conversation_fnv0dz_text",
    "notes": "Speaker=Fen",
    "value": "I thought it was just a whiff from the outhouse, but yeah, it's that outsider smell alright... ",
  },
  {
    "key": "inhabitant_02.conversation_q58pva_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "The glowing sparkly thing is right. I'm not really cut out for big-city life.",
  },
  {
    "key": "inhabitant_02.conversation_r68qcd_text",
    "notes": "Speaker=Dorothy",
    "value": "Could you try to be a little nice for a change, Fen? You might like it!",
  },
  {
    "key": "inhabitant_02.conversation_6c81lb_text",
    "notes": "Speaker=Fen",
    "value": "I doubt it.",
  },
  {
    "key": "inhabitant_02.conversation_qy4k1b_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I guess I should just head back to the farm.",
  },
  {
    "key": "inhabitant_02.conversation_q27f56_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Hello again, fellow small-town bot!",
  },
  {
    "key": "inhabitant_02.conversation_bfqhtj_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "There's a lot of complaints going around about our poor mayor.",
  },
  {
    "key": "inhabitant_02.conversation_xpriw7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Seems to me like he knows what he's talking about.",
  },
  {
    "key": "inhabitant_02.conversation_kqxpuz_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "After all, he was raised in the big city... he must be used to the pace of things here.",
  },
  {
    "key": "inhabitant_02.conversation_tdhokx_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "If I was to handle matters in such a crowded place, I'd be ground down like some used-up gear.",
  },
  {
    "key": "inhabitant_02.conversation_0k5x6v_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I'm sure the mayor knows what he's doing.",
  },
  {
    "key": "inhabitant_02.conversation_unbiry_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Hello again, friend!",
  },
  {
    "key": "inhabitant_02.conversation_fdlynd_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "It's not easy getting to know people around here.",
  },
  {
    "key": "inhabitant_02.conversation_7ymnmr_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Not at all like back home, where you know everybody from the day you're assembled.",
  },
  {
    "key": "inhabitant_02.conversation_enl4xa_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "This city has a pulse of its own, people are just too busy to stop and chat. Even too busy to be nice to each other!",
  },
  {
    "key": "inhabitant_02.conversation_aptgjz_text",
    "notes": "Speaker=Fen",
    "value": "Or it's just you.",
  },
  {
    "key": "inhabitant_02.conversation_cqddcg_text",
    "notes": "Speaker=Dorothy",
    "value": "Come on Fen, be nice!",
  },
  {
    "key": "inhabitant_02.conversation_3avufg_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Sigh, sometimes I even wonder if they'd notice anyone going missing.",
  },
  {
    "key": "inhabitant_02.conversation_bibnd6_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "From what I can gather, people get lost all the time here.",
  },
  {
    "key": "inhabitant_02.conversation_l5r7sq_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "At least in the countryside we value friendship and loyalty.",
  },
  {
    "key": "inhabitant_02.conversation_axrc0a_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I saw you were a small-town bot when I first met you! You know all about friendship and loyalty, right?",
  },
  {
    "key": "inhabitant_02.conversation_4ure1i_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Have you talked to that kooky professor that's building the rocket higher up in the city?",
  },
  {
    "key": "inhabitant_02.conversation_qahysn_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I heard she inherited a lot of money, but now she's spending it all on that spaceship.",
  },
  {
    "key": "inhabitant_02.conversation_5923lp_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "What a waste!",
  },
  {
    "key": "inhabitant_02.conversation_t94xdc_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "We had someone like that back in the village too, putting together a rocket.",
  },
  {
    "key": "inhabitant_02.conversation_x71xpu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Must be something going around, don't you think?",
  },
  {
    "key": "inhabitant_02.conversation_q3y399_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I bet this is the fanciest one though. The one back home was just a converted silo.",
  },
  {
    "key": "inhabitant_02.conversation_12pu8k_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Just imagine these kooky smart bots building their rockets all over the globe. Makes me {format laugh}giggle{format reset} just thinking about it.",
  },
  {
    "key": "inhabitant_02.conversation_e4onuf_text",
    "notes": "Speaker=Dorothy",
    "value": "You look a bit tired there.",
  },
  {
    "key": "inhabitant_02.conversation_ob0wy7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "There's just too much going on around here. I can't keep up!",
  },
  {
    "key": "inhabitant_02.conversation_54qfjg_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I've made up my mind, I'm going back to the Village.",
  },
  {
    "key": "inhabitant_02.conversation_i33o07_text",
    "notes": "Speaker=Penny Kettlebottom Notes=Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    "value": "The most excitement we get there is when Ol' Pa Pepper takes the kettle out of the barn.",
  },
  {
    "key": "inhabitant_02.conversation_7bo632_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I'm not cut out for this stress. Maybe I'll settle in with a couple of dozen steam cats.",
  },
  {
    "key": "inhabitant_02.conversation_jcodma_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Perhaps I'll even give Bess Bucklethorn a run for her money in that cog-greasing contest.",
  },
  {
    "key": "inhabitant_02.conversation_rjax07_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "It'd be just {format singsong}grand{format reset} to beat that prissy bot, Bess Bucklethorn.",
  },
  {
    "key": "inhabitant_02.conversation_kzt23q_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "I guess I should just head back to the farm.",
  },
  {
    "key": "climber_01.conversation_vyjpoj_text",
    "notes": "Speaker=Lady Botterley Notes=*format* There is a crashed elevator just next to them.",
    "value": "That earthquake made the elevator come crashing down!",
  },
  {
    "key": "climber_01.conversation_ctbic6_text",
    "notes": "Speaker=Fen Notes=*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    "value": "{format singsong}Ooooh{format reset}. Did someone get crushed?",
  },
  {
    "key": "climber_01.conversation_m9r7tc_text",
    "notes": "Speaker=Lady Botterley Notes=*new* changed horrible to terrible and emphasised "thing"",
    "value": "Why, {format nervous}I never!{format reset} What sort of a terrible {format emph}thing{format reset} are you?",
  },
  {
    "key": "climber_01.conversation_045qay_text",
    "notes": "Speaker=Fen Notes=She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    "value": "Hey, I'm {format emph}not{format reset} a thing! If I still had my totem, I'd zap you right now!",
  },
  {
    "key": "climber_01.conversation_fccwnq_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Well, whatever you are, you need to mind your manners.",
  },
  {
    "key": "climber_01.conversation_8oqmau_text",
    "notes": "Speaker=Dorothy",
    "value": "Excuse us ma'am, Fen hasn't really learned people skills yet.",
  },
  {
    "key": "climber_01.conversation_acx7g7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "How long shall I have to wait for someone to come and fix this elevator?",
  },
  {
    "key": "climber_01.conversation_matp87_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Waiting around down here in the desert does not befit a bot of my stature.",
  },
  {
    "key": "climber_01.conversation_eb6uiw_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Waiting around down here in the desert does not befit a bot of my stature.",
  },
  {
    "key": "climber_01.conversation_c7c7g6_text",
    "notes": "Speaker=Lady Botterley",
    "value": "This mayor we have may not be of the greatest stock, but he is not completely without refinement.",
  },
  {
    "key": "climber_01.conversation_mdqfxx_text",
    "notes": "Speaker=Lady Botterley Notes=This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    "value": "It is not uncommon for one to excel beyond the mere parts handed to one at assembly.",
  },
  {
    "key": "climber_01.conversation_uynh2z_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I must allow myself to trust his judgment, and so should everybody else.",
  },
  {
    "key": "climber_01.conversation_if7w3g_text",
    "notes": "Speaker=Lady Botterley",
    "value": "These earthquakes are obviously nothing to worry about. That elevator was probably due for a service anyway.",
  },
  {
    "key": "climber_01.conversation_540zgf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I do hope that they send someone to fix this contraption soon. I {format emph}have not{format reset} got all the time in the world to just stand around.",
  },
  {
    "key": "climber_01.conversation_t8w29c_text",
    "notes": "Speaker=Dorothy",
    "value": "So... that elevator's still not fixed, huh?",
  },
  {
    "key": "climber_01.conversation_2y8m3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Obviously not.",
  },
  {
    "key": "climber_01.conversation_sbn8ap_text",
    "notes": "Speaker=Lady Botterley",
    "value": "This spot may not suit a ladybot like myself, but at least it is quiet.",
  },
  {
    "key": "climber_01.conversation_x0xmdc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "That ridiculous professor living next door has been hammering away at her rockets day and night!",
  },
  {
    "key": "climber_01.conversation_9hvgg5_text",
    "notes": "Speaker=Fen Notes="Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    "value": "Why don't you just hoof it up the side of the cliff?",
  },
  {
    "key": "climber_01.conversation_b63bbp_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Pfft! A lady does not climb.",
  },
  {
    "key": "climber_01.conversation_ff5hlh_text",
    "notes": "Speaker=Lady Botterley",
    "value": "A lady does not climb. I shall wait here until the elevator is fixed or someone carries me. It is only befitting.",
  },
  {
    "key": "climber_01.conversation_3lbfex_text",
    "notes": "Speaker=Fen",
    "value": "Still here, huh?",
  },
  {
    "key": "climber_01.conversation_ykf245_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Yes, I am {format emph}still here{format reset}. And yes, the elevator is {format emph}still broken{format reset}. No need to be snippy about it.",
  },
  {
    "key": "climber_01.conversation_c50t6h_text",
    "notes": "Speaker=Lady Botterley",
    "value": "But it is quite preposterous! Someone as important as myself must surely be missed among the upper crust cogs.",
  },
  {
    "key": "climber_01.conversation_8rvp8u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "The mayor had better have a good explanation.",
  },
  {
    "key": "climber_01.conversation_wpxim7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I am sure that I am sorely missed. I am quite important you know.",
  },
  {
    "key": "climber_01.conversation_gtukg8_text",
    "notes": "Speaker=Fen",
    "value": "You're not really going anywhere, are you?",
  },
  {
    "key": "climber_01.conversation_cudej5_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Well, I have had to indulge in a new hobby.",
  },
  {
    "key": "climber_01.conversation_h438q0_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I am counting all those pilgrims passing through on their way to that filthy temple to the west.",
  },
  {
    "key": "climber_01.conversation_e0mg3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Under normal circumstances I would of course utterly ignore them, but I am beyond bored.",
  },
  {
    "key": "climber_01.conversation_x9lbaf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "These pilgrims seem to be up to something. I really should not have to be interested in such trivial affairs.",
  },
  {
    "key": "climber_01.conversation_ef66r2_text",
    "notes": "Speaker=Lady Botterley",
    "value": "You again? Have you nothing better to do than to pester me?",
  },
  {
    "key": "climber_01.conversation_4ay3w5_text",
    "notes": "Speaker=Fen",
    "value": "We do, but it's just so much fun!",
  },
  {
    "key": "climber_01.conversation_b1t04s_text",
    "notes": "Speaker=Lady Botterley",
    "value": "As if these earthquakes were not enough.",
  },
  {
    "key": "climber_01.conversation_6ntyzc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Whatever. I have come to the conclusion that this mayor of ours must be an idiot.",
  },
  {
    "key": "climber_01.conversation_9sm12u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I know that it is hard to imagine, but even I can be slightly less than perfectly correct at times.",
  },
  {
    "key": "climber_01.conversation_ce5r53_text",
    "notes": "Speaker=Fen",
    "value": "No kidding?",
  },
  {
    "key": "climber_01.conversation_1zdfzx_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I wonder how much a ticket for that rocket might cost...",
  },
  {
    "key": "climber_01.conversation_4y3t9l_text",
    "notes": "Speaker=Lady Botterley",
    "value": "I wonder how much a ticket for that rocket might cost...",
  },
  {
    "key": "climber_01.conversation_bfqth1_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Waiting around down here in the desert does not befit someone of my stature.",
  },
  {
    "key": "entering_guidance.conversation_kohvbb_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "{format emph}Ouch!{format reset}",
  },
  {
    "key": "entering_guidance.conversation_1a5f80_text",
    "notes": "Speaker=Dorothy Notes=*format* *DEMO*",
    "value": "Scrap, gosh darnit! My light broke.",
  },
  {
    "key": "entering_guidance.conversation_9rx08a_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Wow! What {format emph}is{format reset} this place?",
  },
  {
    "key": "entering_guidance.conversation_ojjbl5_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "I'll have to explore it to {format highlight}find another way out{format reset}.",
  },
  {
    "key": "cutscene_fen.conversation_y5enud_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "Oh, {format singsong}glorious Guiding Light!{format reset} Please shine on me!",
  },
  {
    "key": "cutscene_fen.conversation_hnsad0_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "YES, YOU MAY BASK IN MY DESTRUCTIVE GLOW.",
  },
  {
    "key": "cutscene_fen.conversation_a1al3q_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "{format singsong}Blessings!{format reset} Wonderful rapture awaits!",
  },
  {
    "key": "cutscene_fen_02.conversation_2ln8fi_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Hey! I was just about to light you up, you crazy cultist!",
  },
  {
    "key": "cutscene_fen_02.conversation_qzp3tz_text",
    "notes": "Speaker=Dorothy",
    "value": "I tried to tell you, I'm {format emph}not a cultist!{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_ksn1s4_text",
    "notes": "Speaker=Fen",
    "value": "Really? You bots all look the same to me.",
  },
  {
    "key": "cutscene_fen_02.conversation_g22jzu_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}You{format reset} look like some sort of Vectron sprite. How's that {format emph}possible?{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_01a075_text",
    "notes": "Speaker=Dorothy",
    "value": "My friend Rusty destroyed Vectron before he went missing.",
  },
  {
    "key": "cutscene_fen_02.conversation_w28at6_text",
    "notes": "Speaker=Fen",
    "value": "This cult stole me and plugged me in here to be worshipped. They wanted me to zap them, {format laugh}hehehe!{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_krzwlf_text",
    "notes": "Speaker=Fen",
    "value": "Hm... I can't do that without my cool totem though. So what are we going to do now?",
  },
  {
    "key": "cutscene_fen_02.conversation_wfa9i6_text",
    "notes": "Speaker=Dorothy",
    "value": "Well, {format emph}I'm{format reset} going up to the big city. I heard that Rusty had been seen there.",
  },
  {
    "key": "cutscene_fen_02.conversation_qhu4n0_text",
    "notes": "Speaker=Fen",
    "value": "To the city, you say? Alright, if you insist I suppose I can come with you.",
  },
  {
    "key": "cutscene_fen_01.conversation_e2v16f_text",
    "notes": "Speaker=The Guiding Light Notes=*DEMO*",
    "value": "ONE SHOT! {format laugh}HEHEHE!{format reset}",
  },
  {
    "key": "cutscene_fen_01.conversation_z0997i_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Whoa! What's {format emph}going on{format reset} here?",
  },
  {
    "key": "cutscene_fen_01.conversation_0dz6we_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "SWEET! ANOTHER PILGRIM!",
  },
  {
    "key": "cutscene_fen_01.conversation_mzljgp_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "But I'm not a-",
  },
  {
    "key": "cutscene_fen_01.conversation_yadt78_text",
    "notes": "Speaker=The Guiding Light Notes=*new* *DEMO* moved the pew-pew line from below into this line.",
    "value": "GET READY TO BE ZAPPED! {format laugh}PEW-PEW!{format reset}",
  },
  {
    "key": "fen_ledge_01.conversation_cukwql_text",
    "notes": "Speaker=Fen",
    "value": "Ooh wow, what a view! Why don't you take a closer look?",
  },
  {
    "key": "fen_ledge_02.conversation_aszmw4_text",
    "notes": "Speaker=Fen",
    "value": "You'll have to come closer!",
  },
  {
    "key": "fen_ledge_02.conversation_skvrgn_text",
    "notes": "Speaker=Fen",
    "value": "{format singsong}Cloooser...{format reset} {format laugh}hehehe!{format reset}",
  },
  {
    "key": "old_salesbot_01.conversation_x6t79e_text",
    "notes": "Speaker=Trader Carson",
    "value": "Why, if it isn't young Dorothy McCrank!",
  },
  {
    "key": "old_salesbot_01.conversation_yu1bwf_text",
    "notes": "Speaker=Dorothy",
    "value": "Trader Carson! I didn't think I'd meet anyone I knew this far from home.",
  },
  {
    "key": "old_salesbot_01.conversation_0hioym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Say, what's been going on in that little Tumbleton of yours? I've heard all sorts of rumors!",
  },
  {
    "key": "old_salesbot_01.conversation_dslq5p_text",
    "notes": "Speaker=Dorothy",
    "value": "It all started when Rusty arrived, digging riches out of the mine, and helping our town to prosper.",
  },
  {
    "key": "old_salesbot_01.conversation_8tr70j_text",
    "notes": "Speaker=Dorothy",
    "value": "But then he found some strange technology down there. He fused with it, and it made him stronger.",
  },
  {
    "key": "old_salesbot_01.conversation_70kkpo_text",
    "notes": "Speaker=Fen",
    "value": "Come on, get to the good stuff already!",
  },
  {
    "key": "old_salesbot_01.conversation_xfpxnh_text",
    "notes": "Speaker=Dorothy",
    "value": "Well, the source of that mysterious power turned out to be dangerous to us all.",
  },
  {
    "key": "old_salesbot_01.conversation_epbknd_text",
    "notes": "Speaker=Dorothy",
    "value": "He fought it and saved us, but after the fight he disappeared. I've been trying to find him ever since.",
  },
  {
    "key": "old_salesbot_01.conversation_c5qvu8_text",
    "notes": "Speaker=Dorothy",
    "value": "A traveler saw the posters I'd put up, and told me Rusty had been seen entering the mine in El Machino.",
  },
  {
    "key": "old_salesbot_01.conversation_i625og_text",
    "notes": "Speaker=Trader Carson",
    "value": "Yep, that's quite a story!",
  },
  {
    "key": "old_salesbot_01.conversation_umknih_text",
    "notes": "Speaker=Dorothy",
    "value": "Short story is, a friend of mine's gone missing.",
  },
  {
    "key": "old_salesbot_01.conversation_hp7xc3_text",
    "notes": "Speaker=Dorothy",
    "value": "A traveler saw the posters I'd put up, and told me he'd been seen entering the mine in El Machino.",
  },
  {
    "key": "old_salesbot_01.conversation_nfwjrx_text",
    "notes": "Speaker=Trader Carson Notes=*new* changed "well", to "now"",
    "value": "Now, the lift up to town is broken, so you'll have to {format highlight}climb the cliff{format reset} to get up there.",
  },
  {
    "key": "old_salesbot_01.conversation_c1qqn0_text",
    "notes": "Speaker=Trader Carson",
    "value": "I'll be up there shortly myself. Come by if you want to buy some Upgrade Cogs {image cogs_small}, to better handle that there mine.",
  },
  {
    "key": "old_salesbot_01.conversation_m6jpam_text",
    "notes": "Speaker=Trader Carson",
    "value": "I hope you have better luck finding him here.",
  },
  {
    "key": "old_salesbot_01.conversation_q4eiud_text",
    "notes": "Speaker=Trader Carson",
    "value": "I'm just resting my old joints here for a bit before I climb up to town.",
  },
  {
    "key": "old_salesbot_01.conversation_yx3y9m_text",
    "notes": "Speaker=Trader Carson",
    "value": "Why don't you tell me about what happened back in Tumbleton while I wait?",
  },
  {
    "key": "old_salesbot_01.conversation_x7qfv2_text",
    "notes": "Speaker=Trader Carson",
    "value": "Well alright, some other time then.",
  },
  {
    "key": "old_salesbot_01.conversation_5nktdz_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ah! I just love being up in these here polished quarters of the city.",
  },
  {
    "key": "old_salesbot_01.conversation_tj5uh7_text",
    "notes": "Speaker=Trader Carson",
    "value": "These here hipsterbots will pay anything for my genuine Upgrade Cogs {image cogs_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_nqd450_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "I've been doing good business wandering around selling these here little gears.",
  },
  {
    "key": "old_salesbot_01.conversation_ny6f1a_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Usually I pick them up in yard sales or thrift stores around the countryside, but some can be found out in the wild.",
  },
  {
    "key": "old_salesbot_01.conversation_smo857_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "They make this distinct sort of clackity-clack grinding noise.",
  },
  {
    "key": "old_salesbot_01.conversation_gq1rfi_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "It takes a trained ear to root them out, but if you listen carefully you'll hear them.",
  },
  {
    "key": "old_salesbot_01.conversation_dm175r_text",
    "notes": "Speaker=Trader Carson",
    "value": "Been a while since I saw your old pa, how's he doing?",
  },
  {
    "key": "old_salesbot_01.conversation_w6hv5b_text",
    "notes": "Speaker=Dorothy",
    "value": "He passed a while back, I'm afraid.",
  },
  {
    "key": "old_salesbot_01.conversation_by4nym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Aw, now that there's sad news! I always thought he was going to outlive us all...",
  },
  {
    "key": "old_salesbot_01.conversation_1g9zr8_text",
    "notes": "Speaker=Trader Carson",
    "value": "...out of pure spite, if nothing else.",
  },
  {
    "key": "old_salesbot_01.conversation_cgmjf4_text",
    "notes": "Speaker=Dorothy",
    "value": "I thought so too...",
  },
  {
    "key": "old_salesbot_01.conversation_i5igy1_text",
    "notes": "Speaker=Trader Carson",
    "value": "So what's happened to that little store of yours, with you digging here and all?",
  },
  {
    "key": "old_salesbot_01.conversation_lp4kx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Oh, Tumbleton's still thriving. There were plenty of bots willing to take up trade there.",
  },
  {
    "key": "old_salesbot_01.conversation_a7uh25_text",
    "notes": "Speaker=Dorothy",
    "value": "I always wanted to work the mine instead, but my father thought it was too dangerous.",
  },
  {
    "key": "old_salesbot_01.conversation_kyijyo_text",
    "notes": "Speaker=Trader Carson",
    "value": "Well then, I'm happy you're doing what you want now.",
  },
  {
    "key": "old_salesbot_01.conversation_s5417g_text",
    "notes": "Speaker=Trader Carson",
    "value": "Would have been nice to have met that there feller who saved your little town.",
  },
  {
    "key": "old_salesbot_01.conversation_tgpso6_text",
    "notes": "Speaker=Trader Carson",
    "value": "Didn't really have any pressing business there during that particular chunk of time.",
  },
  {
    "key": "old_salesbot_01.conversation_10nfc4_text",
    "notes": "Speaker=Trader Carson",
    "value": "What did you say his name was? Crusty... no... Trusty! That's it, isn't it?",
  },
  {
    "key": "old_salesbot_01.conversation_vzg8gx_text",
    "notes": "Speaker=Dorothy",
    "value": "Rusty...",
  },
  {
    "key": "old_salesbot_01.conversation_ymzbde_text",
    "notes": "Speaker=Trader Carson",
    "value": "Right, right. So he shut down some giant monster down in that there mine all by himself?",
  },
  {
    "key": "old_salesbot_01.conversation_la8vr6_text",
    "notes": "Speaker=Trader Carson",
    "value": "And then just done gone and disappeared!",
  },
  {
    "key": "old_salesbot_01.conversation_k59dwv_text",
    "notes": "Speaker=Trader Carson",
    "value": "Well, happy searching to you, young Dot. I hope you find him in good health.",
  },
  {
    "key": "old_salesbot_01.conversation_bzq0aw_text",
    "notes": "Speaker=Trader Carson Notes=*new* removed "nothing"",
    "value": "The world sure has changed since I was but a young bot.",
  },
  {
    "key": "old_salesbot_01.conversation_zc6l96_text",
    "notes": "Speaker=Trader Carson",
    "value": "This rock-weed taking over parts of the mine, and bots building rockets to escape the planet.",
  },
  {
    "key": "old_salesbot_01.conversation_jnptai_text",
    "notes": "Speaker=Trader Carson",
    "value": "I just keep selling my Upgrade Cogs {image cogs_small}, like I've always done.",
  },
  {
    "key": "old_salesbot_01.conversation_rk0bii_text",
    "notes": "Speaker=Trader Carson",
    "value": "I guess the future's for you young 'uns to create.",
  },
  {
    "key": "old_salesbot_01.conversation_r74j24_text",
    "notes": "Speaker=Trader Carson Notes=Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    "value": "Now, I've got a bunch of Upgrade Cogs {image cogs_small} to offload. I'll be happy to give you a fair price!",
  },
  {
    "key": "old_salesbot_01.conversation_0qym9q_text",
    "notes": "Speaker=Trader Carson",
    "value": "Now, I guess you're back for more Upgrade Cogs? {image cogs_small}",
  },
  {
    "key": "old_salesbot_01.conversation_yx06g0_text",
    "notes": "Speaker=Trader Carson",
    "value": "So, how about it? You can have a shiny new Upgrade Cog {image cogs_small} for only \${var pricelist_next:carson_cogs}{image money_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_x4iaao_text",
    "notes": "Speaker=Trader Carson",
    "value": "Thank you for the business, come back anytime!",
  },
  {
    "key": "old_salesbot_01.conversation_zfed36_text",
    "notes": "Speaker=Trader Carson",
    "value": "You've been a very good customer, young Dot! That's the last of the lot. Glad you found these things useful!",
  },
  {
    "key": "old_salesbot_01.conversation_koo3mt_text",
    "notes": "Speaker=Trader Carson",
    "value": "Well, I wish I could help you out for free, Dot, but a trader's gotta make a living somehow.",
  },
  {
    "key": "old_salesbot_01.conversation_1yrec8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Well alright then, come back anytime you need some Upgrade Cogs {image cogs_small}!",
  },
  {
    "key": "old_salesbot_01.conversation_27y4o8_text",
    "notes": "Speaker=Trader Carson",
    "value": "You've got your dad's moxie, I must say.",
  },
  {
    "key": "cutscene_fen_03.conversation_c3lb0g_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, what are you doing? Get {format emph}out{format reset} of my furnace!",
  },
  {
    "key": "fen_conquerer.conversation_f2k0wg_text",
    "notes": "Speaker=Fen",
    "value": "So this is what the surface looks like. It's bright!",
  },
  {
    "key": "fen_conquerer.conversation_x8lfrw_text",
    "notes": "Speaker=Dorothy",
    "value": "Hey, your map is great! Could you use it to locate someone?",
  },
  {
    "key": "fen_conquerer.conversation_02breo_text",
    "notes": "Speaker=Fen",
    "value": "Not even if I cared.",
  },
  {
    "key": "fen_conquerer.conversation_fek90f_text",
    "notes": "Speaker=Dorothy Notes=Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    "value": "You remind me of those nasty fenlights from my father's stories of the old country.",
  },
  {
    "key": "fen_conquerer.conversation_duq0rd_text",
    "notes": "Speaker=Dorothy",
    "value": "I'll just call you Fen for short.",
  },
  {
    "key": "fen_conquerer.conversation_uostgv_text",
    "notes": "Speaker=Dorothy Notes=*new* split from line above",
    "value": "I'm Dorothy, but my friends call me Dot.",
  },
  {
    "key": "fen_conquerer.conversation_em0ovz_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, whatever. I'm going back into your furnace now.",
  },
  {
    "key": "fen_conquerer.conversation_tats2u_text",
    "notes": "Speaker=Fen",
    "value": "Wake me up if something interesting happens.",
  },
  {
    "key": "mayor_01.conversation_szoc5w_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now, I'm late for my polish. If you've got complaints, leave them at my office.",
  },
  {
    "key": "mayor_01.conversation_r6bmk4_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "And if it's about the quakes, don't bother. Some shaking is just normal in these parts.",
  },
  {
    "key": "mayor_01.conversation_orgrlo_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm not here to complain. I just need access to the mine to search for a lost bot.",
  },
  {
    "key": "mayor_01.conversation_2k8w6x_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format laugh}Ha!{format reset} What I need is to get the mine running again. You don't even have a proper light!",
  },
  {
    "key": "mayor_01.conversation_o8zw9i_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "You're just as likely to get lost yourself, and I can't afford that. Not this close to an election.",
  },
  {
    "key": "mayor_01.conversation_2ok5e8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, tell you what, there is a {format emph}safer area{format reset} to dig in. Just to the left of the ladder down in the mine.",
  },
  {
    "key": "mayor_01.conversation_kbljxa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "If you can {format highlight}dig up ore{format reset} to buy yourself a new light, the guard will let you enter the real mine.",
  },
  {
    "key": "mayor_01.conversation_dgln8s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! I can't afford you getting lost in the mine. {format highlight}Dig for resources{format reset} to get that lamp fixed!",
  },
  {
    "key": "mayor_01.conversation_wdf2e3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, you've mined enough I see! Didn't think you had it in you. Now go see Barnacle Jones!",
  },
  {
    "key": "mayor_01.conversation_y8rutk_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "He's that green fellow with the clamps up there. {format highlight}Trade the ore{format reset} for real cash with him.",
  },
  {
    "key": "mayor_01.conversation_35uglo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format highlight}Trade your ore{format reset} over there at Barnacle Jones's.",
  },
  {
    "key": "mayor_01.conversation_p2p0j1_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now! That money you've earned is only good for something if you spend it.",
  },
  {
    "key": "mayor_01.conversation_hd3efw_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Now go {format highlight}fix your light{format reset} over at the workshop.",
  },
  {
    "key": "mayor_01.conversation_z86wxp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "That shy, square-looking fellow over there will help you out. ",
  },
  {
    "key": "mayor_01.conversation_w5r2nd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Go {format highlight}fix your light{format reset} over at the workshop.",
  },
  {
    "key": "mayor_01.conversation_ujjfnb_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now, that's better! Now you look ready to {format highlight}enter the mine{format reset}.",
  },
  {
    "key": "mayor_01.conversation_woghf0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "And hey, don't you forget to keep that sweet, sweet ore flowing!",
  },
  {
    "key": "mayor_01.conversation_5r6n65_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! It's great to have someone bringing that ore up at a steady pace again.",
  },
  {
    "key": "mayor_01.conversation_x2jdkd_text",
    "notes": "Speaker=Dorothy",
    "value": "Well, except for a few run-ins with some nasty critters, I'm making progress.",
  },
  {
    "key": "mayor_01.conversation_b8dzdr_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "It's just like I told everyone! They're getting all worked up over nothing.",
  },
  {
    "key": "mayor_01.conversation_cjntod_text",
    "notes": "Speaker=Dorothy",
    "value": "I'll head down to Red Rock Passage to see if I can {format highlight}get that tube working{format reset}.",
  },
  {
    "key": "mayor_01.conversation_pnbpzi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Just don't stop bringing that precious ore up to the surface!",
  },
  {
    "key": "mayor_01.conversation_2pgjla_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "And spend your earnings at some of the city's establishments.",
  },
  {
    "key": "mayor_01.conversation_j881iu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now! There's lots of riches to dig out before Red Rock. No need to disturb things for no reason.",
  },
  {
    "key": "mayor_01.conversation_827vm7_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, I don't see why you can't just leave Burster's Station be.",
  },
  {
    "key": "mayor_01.conversation_850lak_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Do we really need to resort to explosives, like some crazy shiners?",
  },
  {
    "key": "mayor_01.conversation_ebyo6x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You've got a better plan for clearing out that there Red Rock Passage, son?",
  },
  {
    "key": "mayor_01.conversation_hkla2t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Now, I just don't see why she has to go that deep at all.",
  },
  {
    "key": "mayor_01.conversation_s2zuik_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I tell you, the ore down there is more valuable than the stuff up here.",
  },
  {
    "key": "mayor_01.conversation_o84rmq_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* changed format from laugh to emph",
    "value": "Hey, there is {format emph}that{format reset} of course...",
  },
  {
    "key": "mayor_01.conversation_wray1t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "What's wrong with using a good old pickaxe? Do we really need to resort to bombs?",
  },
  {
    "key": "mayor_01.conversation_b6rus0_text",
    "notes": "Speaker=Dorothy",
    "value": "I'd better go down and clear out the caved-in passage at Red Rock.",
  },
  {
    "key": "mayor_01.conversation_j39zeq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "It'd be a whole lot better for everyone if it got cleared out.",
  },
  {
    "key": "mayor_01.conversation_vxn818_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, I {format emph}do like{format reset} the thought of getting at those precious stones deep down.",
  },
  {
    "key": "mayor_01.conversation_7zj949_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Let's hope you can clear out Red Rock without making things worse. ",
  },
  {
    "key": "mayor_01.conversation_f7egkh_text",
    "notes": "Speaker=Dorothy",
    "value": "Now that Red Rock Passage is open, I can look for Rusty deeper down.",
  },
  {
    "key": "mayor_01.conversation_ksg9fp_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, that bot still missing? Well, just don't forget to bring some of that valuable ore up with you now.",
  },
  {
    "key": "mayor_01.conversation_gu106f_text",
    "notes": "Speaker=Ma Yonker",
    "value": "It should be clear mining all the way down to the protective wall, dearie.",
  },
  {
    "key": "mayor_01.conversation_56ijq0_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I guess your pal could've slipped through one of them darn cracks in it.",
  },
  {
    "key": "mayor_01.conversation_ynbcdq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "If I was you, I'd head down to Mason's Station.",
  },
  {
    "key": "mayor_01.conversation_twgnbe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "There should still be an old equipment machine down there that'll make your life a whole lot easier.",
  },
  {
    "key": "mayor_01.conversation_51emyp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "You mean the one my idiot brothers walled in last year while laying brick?",
  },
  {
    "key": "mayor_01.conversation_8gee3i_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Well, tarnation! I bet you can {format highlight}find a way around{format reset} the brick if you scout the place.",
  },
  {
    "key": "mayor_01.conversation_4sh4u4_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed the line beneath this.",
    "value": "Hey now! Report any opening you find to me, so I can have someone patch the wall up later on.",
  },
  {
    "key": "mayor_01.conversation_gbjzn6_text",
    "notes": "Speaker=Dorothy Notes=*new* changed cave to passage",
    "value": "I found the strangest passage down by the wall. It's all overgrown with weird plants.",
  },
  {
    "key": "mayor_01.conversation_jsqibo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, most things at that depth are strange, if you ask me. It's close to shiner country after all.",
  },
  {
    "key": "mayor_01.conversation_2xq01z_text",
    "notes": "Speaker=Ma Yonker",
    "value": "My other good-for-nothing boys said something about stumbling into some strange, overgrown cave.",
  },
  {
    "key": "mayor_01.conversation_aukq83_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I just thought they'd gotten a case of that dang pressure sickness.",
  },
  {
    "key": "mayor_01.conversation_8rttb6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "My brothers walled Mason's Station up tight.",
  },
  {
    "key": "mayor_01.conversation_6scmnj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "They're not really the sharpest tools in the shed, any of my boys.",
  },
  {
    "key": "mayor_01.conversation_jseqve_text",
    "notes": "Speaker=Dorothy",
    "value": "I made it below the wall and found Mason's Station... but no sign of Rusty yet.",
  },
  {
    "key": "mayor_01.conversation_saqvas_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now! Why would any sane bot want to dig that deep? You don't want to {format highlight}enter shiner country{format reset}, now do you?",
  },
  {
    "key": "mayor_01.conversation_41t2gq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "That jackhammer will smash through them bricks and take you down there in no time at all.",
  },
  {
    "key": "mayor_01.conversation_nlrzra_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Watch your water level though. That tool will gulp it down like a sailorbot in a desert!",
  },
  {
    "key": "mayor_01.conversation_x4aowp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, just don't lead any of those insane shiners up here. That'd be the last thing I need!",
  },
  {
    "key": "mayor_01.conversation_acygrc_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Be careful breaking holes in the wall, and watch out for those deranged shiners.",
  },
  {
    "key": "mayor_01.conversation_mo33pi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed fake news to tone down Trumpism",
    "value": "That crackpot professor Sherman is still spreading fear with her readings of the earthquakes.",
  },
  {
    "key": "mayor_01.conversation_27gaig_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, that last rumble didn't even topple anything over.",
  },
  {
    "key": "mayor_01.conversation_ydzkaa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Looking down on us from her rocket launch ramp, just because she's got a degree.",
  },
  {
    "key": "mayor_01.conversation_667vwu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Sherman thinks she's so smart, with her degree. {format laugh}Ha!{format reset} The only paper that matters is green...",
  },
  {
    "key": "mayor_01.conversation_jx90fz_text",
    "notes": "Speaker=Dorothy",
    "value": "That crazy temple cult seems to be protecting some sort of {format emph}doomsday device{format reset}.",
  },
  {
    "key": "mayor_01.conversation_jw27fp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Is that what's been causing these dang unnatural shivers?",
  },
  {
    "key": "mayor_01.conversation_9baw7n_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey now, this is clearly someone else's problem!",
  },
  {
    "key": "mayor_01.conversation_7m1f5t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "The mayor's office can't be expected to deal with end-of-the-world scenarios.",
  },
  {
    "key": "mayor_01.conversation_qbl22o_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "My main job is to get bots to bring precious stones out of the mine. And tax them for it.",
  },
  {
    "key": "mayor_01.conversation_v4im3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You're the one in charge, idiot. You ran for this darn office, now deal with it!",
  },
  {
    "key": "mayor_01.conversation_v6x25f_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, the girlbot's already been to the temple. She can just head back there and disable that device!",
  },
  {
    "key": "mayor_01.conversation_6dx6ev_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "There, problem solved! And don't forget to bring back more of those precious stones.",
  },
  {
    "key": "mayor_01.conversation_6aje4l_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, have you had time to {format highlight}disable that doomsday device{format reset} yet?",
  },
  {
    "key": "mayor_01.conversation_3lxi6c_text",
    "notes": "Speaker=Dorothy",
    "value": "We managed to destroy the doomsday device.",
  },
  {
    "key": "mayor_01.conversation_rv004f_text",
    "notes": "Speaker=Fen",
    "value": "Yeah we did! You should've seen it blow!",
  },
  {
    "key": "mayor_01.conversation_7nmsnx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "See!? The mayor's office had it under control all along!",
  },
  {
    "key": "mayor_01.conversation_qpbmn2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format emph}Idiot!{format reset}",
  },
  {
    "key": "mayor_01.conversation_j8m71m_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, I {format emph}was{format reset} the one that sent her down the mine in the first place.",
  },
  {
    "key": "mayor_01.conversation_sptgv3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Some credit is due. I was the one that sent you down the mine in the first place.",
  },
  {
    "key": "mayor_01.conversation_2h1yth_text",
    "notes": "Speaker=Dorothy",
    "value": "We've discovered more quake-making devices down in the mines.",
  },
  {
    "key": "mayor_01.conversation_xbnodu_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* enclosed "come" into the format",
    "value": "Oh, {format emph}come on{format reset}! I just can't catch a break here, now can I?",
  },
  {
    "key": "mayor_01.conversation_6c2elx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, I just wanted a nice cushy job that didn't involve digging in that dirty mine.",
  },
  {
    "key": "mayor_01.conversation_kk8x0s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "If you can't {format highlight}disable those devices{format reset}, I might have to evacuate the whole city!",
  },
  {
    "key": "mayor_01.conversation_hmjz7t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Do you have any idea how much that is going to cost!?",
  },
  {
    "key": "mayor_01.conversation_qzd676_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hey, at least bring up some valuables while you're down there, will you?",
  },
  {
    "key": "mayor_01.conversation_ocz2bm_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Have you disabled the rest of those devices yet?",
  },
  {
    "key": "mayor_01.conversation_wihfk8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Jungles covering the mines, cultists plotting to wreck the world!",
  },
  {
    "key": "mayor_01.conversation_jcggy6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "I bet the last mayor didn't have to deal with anything like this...",
  },
  {
    "key": "mayor_01.conversation_8d282i_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "I sort of wish I'd gone into the family business instead. My brothers seem happy enough.",
  },
  {
    "key": "mayor_01.conversation_w4v0m6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "I guess I'll just start packing my bags like the rest of the constituency.",
  },
  {
    "key": "mayor_01.conversation_mm9lt2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, I can't be mayor if there's no town left to govern, can I? Hm, that's actually quite a comforting thought...",
  },
  {
    "key": "mayor_01.conversation_e4p6yr_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey, maybe I should just join the family business, and start a new life as an asteroid miner.",
  },
  {
    "key": "mayor_01.conversation_yzrylo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! What do you think about this slogan? "Business as usual!" Pretty good, right?",
  },
  {
    "key": "talk_to_mayor.conversation_pap70a_text",
    "notes": "Speaker=Dorothy",
    "value": "A red-scarfed miner? That {format emph}must{format reset} be Rusty! Finally a promising lead!",
  },
  {
    "key": "talk_to_mayor.conversation_n0lq8o_text",
    "notes": "Speaker=Fen",
    "value": "I think these earthquakes sound promising.",
  },
  {
    "key": "talk_to_mayor.conversation_3nu9ex_text",
    "notes": "Speaker=Fen",
    "value": "Nothing like a bit of chaos to liven up an adventure!",
  },
  {
    "key": "talk_to_mayor.conversation_elfbhm_text",
    "notes": "Speaker=Dorothy",
    "value": "I need to {format highlight}talk to the mayor{format reset} about entering that mine.",
  },
  {
    "key": "guard_archaea.conversation_lty8j0_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Say! You're not authorized to dig down here, young miss!",
  },
  {
    "key": "guard_archaea.conversation_ml6q7x_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Can't have any more miners getting lost, you understand?",
  },
  {
    "key": "guard_archaea.conversation_cmr7ae_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon you should go talk to the mayor. Get proper authorization.",
  },
  {
    "key": "guard_archaea.conversation_jqyolm_text",
    "notes": "Speaker=Coral Armstrong Notes=Her chest lamp is busted",
    "value": "Hold it right there, young miss! I can't let you dig here without a proper light source.",
  },
  {
    "key": "guard_archaea.conversation_jmhinb_text",
    "notes": "Speaker=Dorothy",
    "value": "I just want to go down and look for my friend! What if I just took a quick peek?",
  },
  {
    "key": "guard_archaea.conversation_97lht6_text",
    "notes": "Speaker=Fen",
    "value": "Yes, let her take a look. She'll {format emph}probably{format reset} make it back up.",
  },
  {
    "key": "guard_archaea.conversation_naakhs_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon we've already lost {format emph}one{format reset} too many miners down there.",
  },
  {
    "key": "guard_archaea.conversation_wjso4t_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "It's too dangerous guessing your way in the dark. How 'bout you {format highlight}dig for ore{format reset} in the well-lit area over there instead?",
  },
  {
    "key": "guard_archaea.conversation_iom5do_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "It's too dangerous guessing your way in the dark. How 'bout you {format highlight}fix your light{format reset} up in town first?",
  },
  {
    "key": "guard_archaea.conversation_c5cn1e_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I say! You need to {format highlight}dig for ore{format reset} so you can afford a proper light.",
  },
  {
    "key": "guard_archaea.conversation_6b9sev_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "How 'bout you {format highlight}trade any ore{format reset} you've got, then fix your light at the mechanic?",
  },
  {
    "key": "guard_archaea.conversation_66rd82_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon you can {format highlight}repair your light{format reset} at the workshop up in town.",
  },
  {
    "key": "guard_archaea.conversation_94r9zk_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ah! Looks like you're all 'bout ready to dig!",
  },
  {
    "key": "guard_archaea.conversation_n9j9h3_text",
    "notes": "Speaker=Dorothy",
    "value": "So you'll let me {format highlight}go deeper{format reset} into the mine now?",
  },
  {
    "key": "guard_archaea.conversation_p0ntw5_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Sure! Just show me you can {format highlight}light the lantern{format reset} over there and I'll open the hatches.",
  },
  {
    "key": "guard_archaea.conversation_wphcux_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "How 'bout you {format highlight}light the lantern{format reset} over there first, and I'll let you into the mine.",
  },
  {
    "key": "guard_archaea.conversation_f36o1k_text",
    "notes": "Speaker=Coral Armstrong Notes=*new* expanded this as I removed the full text that was used before. It was repatative.",
    "value": "I reckon the tube system'll get you back up to town a lot quicker than slogging up and down by foot.",
  },
  {
    "key": "guard_archaea.conversation_ih3zjl_text",
    "notes": "Speaker=Dorothy",
    "value": "You were right about Red Rock Passage being closed.",
  },
  {
    "key": "guard_archaea.conversation_lynw1k_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "That figures.",
  },
  {
    "key": "guard_archaea.conversation_arg7cq_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon you'll be able to clear it right out with some explosives though.",
  },
  {
    "key": "guard_archaea.conversation_94selp_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon Red Rock'll clear right up with a well-placed blast.",
  },
  {
    "key": "guard_archaea.conversation_pl5kjt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon the mayor'll probably want to know when Red Rock is cleared up.",
  },
  {
    "key": "guard_archaea.conversation_d3sb26_text",
    "notes": "Speaker=Coral Armstrong Notes=Shiners are cave dwelling human decendants.",
    "value": "I've seen plenty a' creatures down the mines, but none as fickle and dangerous as shiners.",
  },
  {
    "key": "guard_archaea.conversation_a458ae_text",
    "notes": "Speaker=Coral Armstrong Notes=A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    "value": "The war was before my time, but I've had my share of skirmishes with those hayseeds.",
  },
  {
    "key": "guard_archaea.conversation_t6mrk7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "No use talking to them, just hit them as fast as you can.",
  },
  {
    "key": "guard_archaea.conversation_pygh76_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Might seem a bit brutal, but I wouldn't take any chances.",
  },
  {
    "key": "guard_archaea.conversation_xgdjhu_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Good thing they build that wall after the war.",
  },
  {
    "key": "guard_archaea.conversation_ujn89n_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Those deranged shiners might have been different ages ago.",
  },
  {
    "key": "guard_archaea.conversation_nd5hoz_text",
    "notes": "Speaker=Coral Armstrong Notes=Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    "value": "Now they're just downright mutant quake makers.",
  },
  {
    "key": "guard_archaea.conversation_5xd7xt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I reckon you'll never be able to really trust a mutant.",
  },
  {
    "key": "guard_archaea.conversation_y6jyvf_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Have you met them crazy cultists on their pilgrimage of madness?",
  },
  {
    "key": "guard_archaea.conversation_1tzeuc_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Sometimes they pass through the mines when going between the temples.",
  },
  {
    "key": "guard_archaea.conversation_147ntm_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normally they'd just take the desert path across the Windy Plains.",
  },
  {
    "key": "guard_archaea.conversation_f34oeg_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I ain't really got anything against cultists, feels a bit less lonely too when they pass through here.",
  },
  {
    "key": "guard_archaea.conversation_l509g4_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I'm really impressed with how deep down you've made it.",
  },
  {
    "key": "guard_archaea.conversation_lbobkd_text",
    "notes": "Speaker=Coral Armstrong Notes=*format*",
    "value": "Don't get careless though, I've heard tales of dangers not known to the everyday townsfolk.",
  },
  {
    "key": "guard_archaea.conversation_alemgw_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Make sure you've always got a way back up. A tunnel without an exit is nothing but a long coffin.",
  },
  {
    "key": "guard_archaea.conversation_51bz8w_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Wouldn't hurt to keep {format emph}that{format reset} in mind, and make sure you've got enough armor.",
  },
  {
    "key": "guard_archaea.conversation_e9lgr6_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Stay alert and keep your gear up to snuff, that's the best advice I can give.",
  },
  {
    "key": "guard_archaea.conversation_19pnkh_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Apparently those Yonker brothers saw a strange jungle growing in the mines.",
  },
  {
    "key": "guard_archaea.conversation_205qqo_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Heard it's spreading too, but I'd never let it come near the town.",
  },
  {
    "key": "guard_archaea.conversation_59fokz_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I might just invest in a proper axe, just in case. It's a multi-purpose tool after all.",
  },
  {
    "key": "guard_archaea.conversation_vwt53j_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Scary that a jungle could pop up out of nowhere just like that.",
  },
  {
    "key": "guard_archaea.conversation_1re540_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "I admit I've been a bit worried after that last earthquake.",
  },
  {
    "key": "guard_archaea.conversation_25kyco_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Seems they're getting more intense lately. But rest assured, I'm not leaving my post.",
  },
  {
    "key": "guard_archaea.conversation_e0zgh7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "People might get hurt down here if nobody keeps them out of harm's way.",
  },
  {
    "key": "guard_archaea.conversation_jkptm2_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Fear has no place in this old chest, just duty. I'm just full of duty.",
  },
  {
    "key": "guard_archaea.conversation_4niz25_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format highlight}Watch your light{format reset} so you're not caught down there in the dark.",
  },
  {
    "key": "guard_archaea.conversation_aex9as_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "If it dwindles, just head back and {format highlight}refill it upstairs{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_dmvx8z_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "The mine ain't the safest place, so keep your equipment tip-top.",
  },
  {
    "key": "welcome_to_el_machino.conversation_uimryl_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey there! Keep calm, people!",
  },
  {
    "key": "welcome_to_el_machino.conversation_31d0sd_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Well actually, these {format nervous}earthquakes{format reset} are something to worry about.",
  },
  {
    "key": "welcome_to_el_machino.conversation_4njhbf_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I have already told you, my seismometer is getting some really strange readings!",
  },
  {
    "key": "welcome_to_el_machino.conversation_l4n0br_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "There are more important things to worry about, such as keeping the ore flowing.",
  },
  {
    "key": "welcome_to_el_machino.conversation_dzl3uz_text",
    "notes": "Speaker=Ma Yonker",
    "value": "You idiot! Why don't you listen to the experts?",
  },
  {
    "key": "welcome_to_el_machino.conversation_7blj3t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ma, please! These "experts" with their "facts"... They're missing the big picture.",
  },
  {
    "key": "welcome_to_el_machino.conversation_lwjidu_text",
    "notes": "Speaker=Ma Yonker",
    "value": "And what about that {format emph}red-scarfed miner{format reset} that never made it back up?",
  },
  {
    "key": "welcome_to_el_machino.conversation_jije2r_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "I've already hired a guard to prevent more unprepared bots from disappearing.",
  },
  {
    "key": "welcome_to_el_machino.conversation_jhc64p_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Now, let's all keep our heads cool, and just remind ourselves that the mayor's office is not to blame here.",
  },
  {
    "key": "welcome_to_el_machino.conversation_njlyi9_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Idiot!",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_xqrxw3_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hehehe! Boom!{format reset} Let's do that again.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_y6g3s7_text",
    "notes": "Speaker=Dorothy",
    "value": "These bombs sure will come in handy. They'll be able to reach places my pickaxe can't.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_c5us81_text",
    "notes": "Speaker=Dorothy",
    "value": "I guess I should go {format highlight}tell the mayor{format reset} that the passage is open again.",
  },
  {
    "key": "guard_open_hatch.conversation_ig8tga_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "'Bout time someone started mining these tunnels again.",
  },
  {
    "key": "guard_open_hatch.conversation_3li9iu_text",
    "notes": "Speaker=Dorothy",
    "value": "Finally I'm on the right track to find Rusty.",
  },
  {
    "key": "guard_open_hatch.conversation_ti9ln5_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "I reckon your compadre had to pass through Red Rock Passage, one time or another.",
  },
  {
    "key": "guard_open_hatch.conversation_60et06_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normally you could use the pneumatic tube system to get there and back.",
  },
  {
    "key": "guard_open_hatch.conversation_cix8sl_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "It clogged up during an earthquake though. It'd be smart to {format highlight}clear it out{format reset} first.",
  },
  {
    "key": "guard_open_hatch.conversation_h47l73_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Now, how 'bout I just open these hatches and let you down there?",
  },
  {
    "key": "buddy_need_light.conversation_q6n8pp_text",
    "notes": "Speaker=Fen",
    "value": "Hey it's getting dark. I can hardly see a thing, and I'm made of light.",
  },
  {
    "key": "buddy_need_light.conversation_1dc723_text",
    "notes": "Speaker=Fen Notes=The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    "value": "{format highlight}Go up to town{format reset} and replenish your lamp so I don't get lost down here.",
  },
  {
    "key": "fen_cave_in.conversation_ytvst4_text",
    "notes": "Speaker=Dorothy",
    "value": "This must be Red Rock Passage. It's caved in alright.",
  },
  {
    "key": "fen_cave_in.conversation_ac4a61_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "If you had some explosives, you could blow this rubble right away.",
  },
  {
    "key": "fen_cave_in.conversation_f2qhr1_text",
    "notes": "Speaker=Dorothy",
    "value": "That's actually not a bad idea! I should go back up to town and ask around.",
  },
  {
    "key": "fen_cave_in.conversation_8j9cex_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Yeah, explosives!{format reset} Maybe you'll even blow some of your parts off...",
  },
  {
    "key": "fen_cave_in.conversation_0g7tly_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Sheesh! Let's just clear out that pneumatic tube, shall we?",
  },
  {
    "key": "fen_cave_in.conversation_n67xrl_text",
    "notes": "Speaker=Dorothy",
    "value": "This must be Red Rock Passage. It's all caved in.",
  },
  {
    "key": "fen_cave_in.conversation_1kwj0v_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "You could use the bombs to clear it up.",
  },
  {
    "key": "fen_cave_in.conversation_661ekz_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "I probably shouldn't encourage your destructive streak, but it's not a bad idea.",
  },
  {
    "key": "fen_cave_in.conversation_xdrduu_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Yeah, explosives!{format reset} Maybe you'll even blow some of your parts off!",
  },
  {
    "key": "fen_cave_in.conversation_6c0vsm_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Sheesh! Let's just try out that pneumatic tube first, alright?",
  },
  {
    "key": "mechanic.conversation_h5wj1m_text",
    "notes": "Speaker=Turtle Bucket Notes=Very nervous person",
    "value": "Um, I don't want to be a bother... but these {format nervous}earthquakes{format reset} are a bit scary.",
  },
  {
    "key": "mechanic.conversation_o86kfe_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "But, um... if it really is a problem, I guess the mayor would be more worried.",
  },
  {
    "key": "mechanic.conversation_o2oiou_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "The mayor says these {format nervous}earthquakes{format reset} are nothing to worry about so I, um, guess it must be true.",
  },
  {
    "key": "mechanic.conversation_h7ppy6_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, hello...",
  },
  {
    "key": "mechanic.conversation_kg1mo1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* The light source is set in the middle of the chest.",
    "value": "I see you've broken your light source.",
  },
  {
    "key": "mechanic.conversation_q3my9j_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I wouldn't, um... wander around in the dark with all this {format nervous}rumbling{format reset} going on.",
  },
  {
    "key": "mechanic.conversation_ltmso8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "So, um... if you're heading into the mine, um... you better {format highlight}fix your light{format reset} first. ",
  },
  {
    "key": "mechanic.conversation_9zjn4q_text",
    "notes": "Speaker=Turtle Bucket Notes=Workbench",
    "value": "You can use my workbench here... if you like.",
  },
  {
    "key": "mechanic.conversation_izda31_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "You can {format highlight}fix that light{format reset} of yours at my workbench... if you like.",
  },
  {
    "key": "mechanic.conversation_649j7z_text",
    "notes": "Speaker=Turtle Bucket Notes=Dorothys speed boots.",
    "value": "Um, I like your boots.",
  },
  {
    "key": "mechanic.conversation_fjqq9f_text",
    "notes": "Speaker=Dorothy",
    "value": "Yeah? They got enhanced in some machine down below the desert.",
  },
  {
    "key": "mechanic.conversation_v3f2hn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "The extra, um, sprint hydraulics probably made them really, really fast.",
  },
  {
    "key": "mechanic.conversation_qnv8df_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Those equipment machines down in the mining stations are pretty cool, right?",
  },
  {
    "key": "mechanic.conversation_f9qput_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh... um, alright. Well, they can be found all over the mines.",
  },
  {
    "key": "mechanic.conversation_ji4atj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, they're very, {format emph}very old{format reset}. We don't really know who built them, but they work fine for our kind.",
  },
  {
    "key": "mechanic.conversation_kn7n3g_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Over the years the minerbots have set up mining stations around the machines.",
  },
  {
    "key": "mechanic.conversation_w8uqp5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "We know where a few of them are but, um, the mines are much, {format emph}much bigger{format reset} than just the part that's worked on.",
  },
  {
    "key": "mechanic.conversation_m5pbwk_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "I've read about other stations, with cool equipment, lost in deeper, um... unmapped parts of the mine.",
  },
  {
    "key": "mechanic.conversation_wad1be_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh... um, of course.",
  },
  {
    "key": "mechanic.conversation_apkmkg_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Wow, you've found a pressure bomb launcher!",
  },
  {
    "key": "mechanic.conversation_qjmh35_text",
    "notes": "Speaker=Turtle Bucket Notes=This is techno jibberish, feel free to make up new stuff.",
    "value": "That triple-plunger design makes for a {format singsong}smooth{format reset} flow through the siphon tube.",
  },
  {
    "key": "mechanic.conversation_ua28gp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "It'll shoot a self-adhesive projectile that sticks to any surface before detonating.",
  },
  {
    "key": "mechanic.conversation_saczrj_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The pressure bomb works with water.",
    "value": "I bet it makes a big splash! Hehe...",
  },
  {
    "key": "mechanic.conversation_tz9y1l_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um... sorry. I, um, got carried away.",
  },
  {
    "key": "mechanic.conversation_yxae4k_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, um... you managed to get through to Mason's Station I see.",
  },
  {
    "key": "mechanic.conversation_rz6lrl_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The upgrade is a mechanical fist that works like a jack hammer.",
    "value": "That hammer will drive a huge punch and break through even the hardest sections of brick.",
  },
  {
    "key": "mechanic.conversation_art1sv_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "You'll be able to explore the other side of the wall easy-peasy.",
  },
  {
    "key": "mechanic.conversation_1ghl26_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "And it's got upgradeable fuel supply and everything!",
  },
  {
    "key": "mechanic.conversation_a315z5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "A stronger pneumatic cylinder would allow for increased maximum operating speed...",
  },
  {
    "key": "mechanic.conversation_lyy59m_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, I mean, it's got a lot of potential, is all.",
  },
  {
    "key": "mechanic.conversation_ornloo_text",
    "notes": "Speaker=Turtle Bucket Notes=See "Spelunker Station" in other document",
    "value": "{format singsong}Oh, my!{format reset} I thought that Spelunker Station was gone!",
  },
  {
    "key": "mechanic.conversation_uo7wrd_text",
    "notes": "Speaker=Turtle Bucket Notes=The hook shot look like a grapling hook and is shot out of your arm",
    "value": "You managed to find the old hook shot anyway!",
  },
  {
    "key": "mechanic.conversation_4x94pz_text",
    "notes": "Speaker=Turtle Bucket Notes="zip" as in fly or move fast",
    "value": "This thing will just let you zip across the mine like {format emph}never{format reset} before.",
  },
  {
    "key": "mechanic.conversation_wt4pay_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "You'll be able to explore almost every nook and cranny now!",
  },
  {
    "key": "mechanic.conversation_jc96m9_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "These mines are full of hidden secrets, waiting to be uncovered.",
  },
  {
    "key": "mechanic.conversation_xxorzf_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "{format singsong}WHOA!{format reset} Is that what I think it is?",
  },
  {
    "key": "mechanic.conversation_h0sfna_text",
    "notes": "Speaker=Turtle Bucket Notes=It's a falaming Pick Axe",
    "value": "How on earth did you get hold of an Ignition Axe?",
  },
  {
    "key": "mechanic.conversation_4p03fk_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, I bet it was hidden away somewhere in the eastern temple.",
  },
  {
    "key": "mechanic.conversation_7shcmp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I read about it in one of my tool magazines. The possibility of this thing still existing... I just {format emph}can't believe{format reset} it!",
  },
  {
    "key": "mechanic.conversation_9e6rbj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Er... um, it's really nice.",
  },
  {
    "key": "mechanic.conversation_8x0zgn_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* see Aeronaut Station in the other document",
    "value": "Oh, get out! Don't tell me you've been all the way down to Aeronaut Station!",
  },
  {
    "key": "mechanic.conversation_gqdbky_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "That place was supposedly buried way down below the modern parts of the mine.",
  },
  {
    "key": "mechanic.conversation_34ele3_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I never in my days thought I'd actually get to see a real jet engine!",
  },
  {
    "key": "mechanic.conversation_vr5wop_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I'm geeking out here!",
  },
  {
    "key": "mechanic.conversation_0czv1r_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* just hammering home that the world is more open at this point.",
    "value": "That thing will let you travel all over the mine. You can explore places you'd no chance of reaching before. ",
  },
  {
    "key": "mechanic.conversation_2bpv40_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* as in the old saying "the world is your oyster"",
    "value": "The mine is truly your steam-oyster.",
  },
  {
    "key": "mechanic.conversation_6c8k38_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I bet I can even fashion some sick upgrades for it... um, if you want me to...",
  },
  {
    "key": "mechanic.conversation_kddst5_text",
    "notes": "Speaker=Turtle Bucket Notes=This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    "value": "Um, that jungle down in the mine... It's the talk of the town.",
  },
  {
    "key": "mechanic.conversation_1ibifo_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "I hope it won't spread all the way up here. Um... I don't even like going close to those terrible cacti.",
  },
  {
    "key": "mechanic.conversation_qxg2dp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "I bet if you had a nice weed whacker you'd, um... chop those veggies to pieces.",
  },
  {
    "key": "mechanic.conversation_jn0ayb_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Too bad there are no old mining stations with anything like that...",
  },
  {
    "key": "mechanic.conversation_evptsm_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, I hope those {format nervous}strange plants{format reset} won't make it up here to the city.",
  },
  {
    "key": "mechanic.conversation_d2k8hv_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, I don't like to bother the professor...",
  },
  {
    "key": "mechanic.conversation_zfm1c4_text",
    "notes": "Speaker=Turtle Bucket Notes=The rocket is a space rocket.",
    "value": "Maybe I could ask her if I could just take a look inside the rocket, now that it's done?",
  },
  {
    "key": "mechanic.conversation_js74jz_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "It's really really cool, don't you think?",
  },
  {
    "key": "mechanic.conversation_bufmli_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um, I'd really like to take a look inside that rocket ship...",
  },
  {
    "key": "mechanic.conversation_yxbbjn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Rockets are cool!",
  },
  {
    "key": "mechanic.conversation_1ovqzn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* rephrased this line to work in more situations.",
    "value": "You can fix or enhance your gear at my workbench, um... anytime.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_4dhtk4_text",
    "notes": "Speaker=Fen",
    "value": "Alright, let's blow this thing to {format singsong}smithereens!{format reset}",
  },
  {
    "key": "fen_cave_in_bomb.conversation_eff23g_text",
    "notes": "Speaker=Dorothy",
    "value": "You really need to talk to someone about this whole wanton destruction thing.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_oxrw0l_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "I'm talking to you about it right now. When am I not talking about destruction in general?",
  },
  {
    "key": "fen_cave_in_bomb.conversation_nmb2rq_text",
    "notes": "Speaker=Dorothy",
    "value": "Yeah...",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_t0dmfu_text",
    "notes": "Speaker=Fen Notes=*new* This message is shown when the player have unused upgrade-cogs.",
    "value": "Why do you keep hording all these cogs {image cogs_small} you find, like some crazy-bot?",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_w2gq2j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Just go use some of them by the workbench already!",
  },
  {
    "key": "rosie.conversation_enxhfq_text",
    "notes": "Speaker=Dorothy Notes=*format* *new* rephrased this line",
    "value": "Wow! This place is something else!",
  },
  {
    "key": "rosie.conversation_dsse8r_text",
    "notes": "Speaker=Rosie",
    "value": "Thank you. I built this Oasis to gather my kin. To protect 'em!",
  },
  {
    "key": "rosie.conversation_fu699v_text",
    "notes": "Speaker=Rosie",
    "value": "As long as I keep 'em calm an' content they stay here. Safe inside.",
  },
  {
    "key": "rosie.conversation_hx3qqt_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "At least that's how it was, until your friend brought these quakes down upon us.",
  },
  {
    "key": "rosie.conversation_6o8eta_text",
    "notes": "Speaker=Dorothy",
    "value": "Why would Rusty do something like that? He {format emph}risked his life{format reset} to save us all from Vectron.",
  },
  {
    "key": "rosie.conversation_x9aify_text",
    "notes": "Speaker=Rosie",
    "value": "How well did you really know him? Maybe his fight with that sparkly beast changed him?",
  },
  {
    "key": "rosie.conversation_y8f4q2_text",
    "notes": "Speaker=Fen",
    "value": "That is what Vectron does... {format nervous}It changes you.{format reset}",
  },
  {
    "key": "rosie.conversation_qjs5hn_text",
    "notes": "Speaker=Rosie",
    "value": "He came here an' told me he'd bring the mine down on our heads. We barely held him off!",
  },
  {
    "key": "rosie.conversation_mbjnhf_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm sorry, I can't... If I could just find him... talk to him...",
  },
  {
    "key": "rosie.conversation_7sza3z_text",
    "notes": "Speaker=Rosie",
    "value": "You're loyal, I get it, but if you can find the source of the quakes you'll see for yourself.",
  },
  {
    "key": "rosie.conversation_hihmd6_text",
    "notes": "Speaker=Rosie Notes=*new* rephrasing and added an emphasis",
    "value": "You might be able to stop these quakes. An' I'll help {format emph}you{format reset} out as best I can.",
  },
  {
    "key": "rosie.conversation_47pkq7_text",
    "notes": "Speaker=Rosie Notes=*new* added a bit at the end to this one.",
    "value": "{format highlight}Enter the minin' station{format reset} I'm usin' for storage. The old tool machine in there might be of use to you.",
  },
  {
    "key": "rosie.conversation_m6cj0e_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Enter the minin' station{format reset} an' take whatever you need.",
  },
  {
    "key": "rosie.conversation_4vzxih_text",
    "notes": "Speaker=Rosie",
    "value": "I'm glad you found somethin' you could use in my storage. You look prepared!",
  },
  {
    "key": "rosie.conversation_f1jnf5_text",
    "notes": "Speaker=Rosie",
    "value": "Now I need you to find where these earthquakes are comin' from, an' stop 'em.",
  },
  {
    "key": "rosie.conversation_ln5j60_text",
    "notes": "Speaker=Rosie",
    "value": "Help me keep my kin safe! I'm doin' all I can to just keep 'em listenin' to me.",
  },
  {
    "key": "rosie.conversation_u5463y_text",
    "notes": "Speaker=Rosie",
    "value": "I don't know anythin' more about the quakes, but maybe you can {format highlight}find a smart bot{format reset} on the surface?",
  },
  {
    "key": "rosie.conversation_dohwhw_text",
    "notes": "Speaker=Dorothy",
    "value": "Maybe then I'll find out where Rusty has gone... finally!",
  },
  {
    "key": "rosie.conversation_77fdqq_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Find a smart robot{format reset} up on the surface.",
  },
  {
    "key": "rosie.conversation_0jmccn_text",
    "notes": "Speaker=Rosie",
    "value": "They might be able to point you to where the quakes are comin' from.",
  },
  {
    "key": "rosie.conversation_xpdrbe_text",
    "notes": "Speaker=Dorothy",
    "value": "I found out that the last earthquake came out of the eastern temple.",
  },
  {
    "key": "rosie.conversation_oqlaq7_text",
    "notes": "Speaker=Rosie",
    "value": "The doom cult there worships nuthin' but destruction.",
  },
  {
    "key": "rosie.conversation_1kkqf6_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, I've got some experience with those guys.",
  },
  {
    "key": "rosie.conversation_v0wzpo_text",
    "notes": "Speaker=Rosie",
    "value": "They'll probably protect anythin' that has to do with the quakes.",
  },
  {
    "key": "rosie.conversation_nytcr5_text",
    "notes": "Speaker=Rosie",
    "value": "You have to {format highlight}search the temple{format reset} for the source of the quakes.",
  },
  {
    "key": "rosie.conversation_x2gmu8_text",
    "notes": "Speaker=Rosie",
    "value": "You have to {format highlight}search the temple{format reset} for the source of the quakes.",
  },
  {
    "key": "rosie.conversation_ly3hpt_text",
    "notes": "Speaker=Dorothy",
    "value": "You were right, Rosie. {format highlight}Rusty is involved{format reset} in all of this.",
  },
  {
    "key": "rosie.conversation_mp86jk_text",
    "notes": "Speaker=Rosie",
    "value": "So now you know... {format emph}He's evil!{format reset}",
  },
  {
    "key": "rosie.conversation_26ewef_text",
    "notes": "Speaker=Dorothy",
    "value": "He's built some sort of doomsday device that's generating the quakes.",
  },
  {
    "key": "rosie.conversation_r154n3_text",
    "notes": "Speaker=Rosie",
    "value": "You must {format highlight}destroy that device!{format reset} I want to keep my kin safe, but that thing's a danger to everyone.",
  },
  {
    "key": "rosie.conversation_mlv5kh_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "What are we waiting for? There are things to wreck!",
  },
  {
    "key": "rosie.conversation_607awg_text",
    "notes": "Speaker=Rosie",
    "value": "You have a chance to stop the earthquakes. {format highlight}Destroy the doomsday device!{format reset}",
  },
  {
    "key": "rosie.conversation_ck3lck_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "We managed to disable the thing that was causing the earthquakes.",
  },
  {
    "key": "rosie.conversation_kd9cyi_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Excellent! You actually did it!",
  },
  {
    "key": "rosie.conversation_mw42bj_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, we did!",
  },
  {
    "key": "rosie.conversation_3beotd_text",
    "notes": "Speaker=Dorothy",
    "value": "Still no sign of Rusty though...",
  },
  {
    "key": "rosie.conversation_akywya_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Hm... If the thing you call Vectron changed him, maybe he's down there? Among its remains.",
  },
  {
    "key": "rosie.conversation_rwy0gr_text",
    "notes": "Speaker=Dorothy",
    "value": "That doomsday device {format emph}was{format reset} partly made of Vectron technology...",
  },
  {
    "key": "rosie.conversation_ucjkci_text",
    "notes": "Speaker=Fen",
    "value": "Oh no, I know what you're thinking! I don't want to {format nervous}go back there!{format reset}",
  },
  {
    "key": "rosie.conversation_7irted_text",
    "notes": "Speaker=Fen",
    "value": "You don't know what it's like in there. What it's like to not have a will of your own.",
  },
  {
    "key": "rosie.conversation_21ym6y_text",
    "notes": "Speaker=Dorothy",
    "value": "I've already come this far... I can't stop now. If you could show me the entrance, Fen...",
  },
  {
    "key": "rosie.conversation_oredyt_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Why? Why can't we just go and wreck stuff instead?",
  },
  {
    "key": "rosie.conversation_tc3nlv_text",
    "notes": "Speaker=Dorothy Notes=*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    "value": "He brought down Vectron. Rusty saved us...",
  },
  {
    "key": "rosie.conversation_0xyfid_text",
    "notes": "Speaker=Fen",
    "value": "...",
  },
  {
    "key": "rosie.conversation_uvs1vb_text",
    "notes": "Speaker=Fen",
    "value": "I will get you there. But once you {format highlight}enter Vectron{format reset} you'll be on your own.",
  },
  {
    "key": "rosie.conversation_pq0jjj_text",
    "notes": "Speaker=Rosie",
    "value": "To find Rusty, you have to {format highlight}enter Vectron{format reset}.",
  },
  {
    "key": "rosie.conversation_vcgjsk_text",
    "notes": "Speaker=Fen",
    "value": "We could still just go and destroy more stuff instead?",
  },
  {
    "key": "rosie.conversation_3bw741_text",
    "notes": "Speaker=Rosie",
    "value": "You're {format emph}back{format reset}...",
  },
  {
    "key": "rosie.conversation_6r8y8d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Yes... I didn't find any trace of Rusty though.",
  },
  {
    "key": "rosie.conversation_jdhos3_text",
    "notes": "Speaker=Fen",
    "value": "But we did find out that there are {format emph}more doomsday devices{format reset} out there.",
  },
  {
    "key": "rosie.conversation_hlfgz1_text",
    "notes": "Speaker=Rosie",
    "value": "Of course! He's too smart to put all his eggs in one basket.",
  },
  {
    "key": "rosie.conversation_kix6a6_text",
    "notes": "Speaker=Rosie",
    "value": "This just won't do. You have to {format emph}find all{format reset} of 'em! None of us are safe until you do.",
  },
  {
    "key": "rosie.conversation_58f8ga_text",
    "notes": "Speaker=Fen Notes=*new* added "Dorothy"",
    "value": "Dorothy... I already know where they are. I felt it so clearly. The power flowing to them.",
  },
  {
    "key": "rosie.conversation_diuokv_text",
    "notes": "Speaker=Fen",
    "value": "One is in the {format emph}temple you found me in.{format reset}",
  },
  {
    "key": "rosie.conversation_5npqb6_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "The second one is in that weird {format emph}underground jungle{format reset} we passed on the way down here.",
  },
  {
    "key": "rosie.conversation_3v2hek_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Lastly, there is another one inside the {format emph}eastern temple{format reset}.",
  },
  {
    "key": "rosie.conversation_k5nk0l_text",
    "notes": "Speaker=Dorothy Notes=*new* added "then" moved the line",
    "value": "Alright, let's go {format highlight}break those devices{format reset} then!",
  },
  {
    "key": "rosie.conversation_1alf3v_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "The mines are huge, with lots of secrets and dangers. Might be the straight path ain't the best.",
  },
  {
    "key": "rosie.conversation_b6r8b9_text",
    "notes": "Speaker=Dorothy Notes=*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    "value": "This jet engine I found will make it easier for us to explore.",
  },
  {
    "key": "rosie.conversation_p2pe6o_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Yeah, we can go all over this place, digging up secrets and gearing up for destruction. Come on let's go.",
  },
  {
    "key": "rosie.conversation_jglhmm_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "You have to find and {format highlight}destroy the last devices{format reset}.",
  },
  {
    "key": "rosie.conversation_mqmqfa_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "You've already been to the temples and that gear you've gotten should make it easier for you to explore.",
  },
  {
    "key": "rosie.conversation_v81wm2_text",
    "notes": "Speaker=Rosie",
    "value": "I don't really know much about that there mysterious jungle though.",
  },
  {
    "key": "rosie.conversation_ckclse_text",
    "notes": "Speaker=Dorothy",
    "value": "We destroyed one more of Rusty's devices.",
  },
  {
    "key": "rosie.conversation_wzvouk_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Yeah, it was great!{format reset}",
  },
  {
    "key": "rosie.conversation_yb1vmx_text",
    "notes": "Speaker=Rosie",
    "value": "He's been crafty, hidin' 'em all around the mine.",
  },
  {
    "key": "rosie.conversation_hw5xmd_text",
    "notes": "Speaker=Rosie",
    "value": "It won't be easy to get to the rest, even though you know where they are.",
  },
  {
    "key": "rosie.conversation_oeqkzs_text",
    "notes": "Speaker=Rosie",
    "value": "I wish I could help you more, but I need to keep my kin safe here.",
  },
  {
    "key": "rosie.conversation_1wlu3i_text",
    "notes": "Speaker=Rosie",
    "value": "I think some of 'em are preparin' to go back out into the mine. ",
  },
  {
    "key": "rosie.conversation_y85nbk_text",
    "notes": "Speaker=Fen",
    "value": "Then let's go and {format highlight}trash the remaining devices{format reset}!",
  },
  {
    "key": "rosie.conversation_o9wzoz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "I hope you'll find that friend of yours soon, and stop him once and for all.",
  },
  {
    "key": "rosie.conversation_g8unqh_text",
    "notes": "Speaker=Rosie",
    "value": "Please {format highlight}destroy the remainin' devices{format reset}. I don't know how long I can keep my people here.",
  },
  {
    "key": "rosie.conversation_hinklt_text",
    "notes": "Speaker=Dorothy",
    "value": "Did you feel that quake after we destroyed the device?",
  },
  {
    "key": "rosie.conversation_7bjdrx_text",
    "notes": "Speaker=Rosie",
    "value": "Yes, I had some trouble calmin' my kin. They got all riled up by the shakin'.",
  },
  {
    "key": "rosie.conversation_ot1xb4_text",
    "notes": "Speaker=Rosie",
    "value": "I haven't done a headcount yet. I just hope they're all still here.",
  },
  {
    "key": "rosie.conversation_8vqdk5_text",
    "notes": "Speaker=Dorothy Notes=*new* removed a "yes"",
    "value": "There's still one device left out there that needs to be taken care of.",
  },
  {
    "key": "rosie.conversation_1t4jq7_text",
    "notes": "Speaker=Rosie",
    "value": "We'll all be a lot safer once all of those destructive things are done for.",
  },
  {
    "key": "rosie.conversation_5hrt2a_text",
    "notes": "Speaker=Rosie",
    "value": "Please {format highlight}destroy the last device{format reset}. We won't be safe until it's gone!",
  },
  {
    "key": "rosie.conversation_2jw2v2_text",
    "notes": "Speaker=Rosie",
    "value": "You're not anythin' like the rest of your kind.",
  },
  {
    "key": "rosie.conversation_pf575r_text",
    "notes": "Speaker=Rosie",
    "value": "I never thought I'd meet a steambot I kinda like.",
  },
  {
    "key": "used_teleporter.conversation_tb8lha_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hey! I never authorized the reopening of these tubes!",
  },
  {
    "key": "used_teleporter.conversation_c3vudp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Bolt your jaw, son! The tubes are the best way to move about the mine.",
  },
  {
    "key": "used_teleporter.conversation_of6kl3_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Red Rock Passage has caved in from all the earthquakes.",
  },
  {
    "key": "used_teleporter.conversation_p4u169_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "You can't prove the quakes did that. Could've been anything!",
  },
  {
    "key": "used_teleporter.conversation_wr7t16_text",
    "notes": "Speaker=Dorothy",
    "value": "Either way, I'll need explosives to clear it out.",
  },
  {
    "key": "used_teleporter.conversation_ljkhuj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "I bet you can {format highlight}find some explosives{format reset} down by Burster's Mining Station.",
  },
  {
    "key": "used_teleporter.conversation_kf7hxd_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Just keep a bit more to the east when you head down again and you'll find it.",
  },
  {
    "key": "used_teleporter.conversation_fsgerc_text",
    "notes": "Speaker=Dorothy",
    "value": "Either way I'm thinking about using explosives to clear it out.",
  },
  {
    "key": "used_teleporter.conversation_atnqc9_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ah, I see someone's been down by Burster's Station. You go {format highlight}clear out the passage{format reset}, dearie!",
  },
  {
    "key": "hub_guard_hurt.conversation_7mti7b_text",
    "notes": "Speaker=Schwifty Shawn",
    "value": "{format nervous}OUCH!{format reset}",
  },
  {
    "key": "hub_guard_woke.conversation_bg1gtj_text",
    "notes": "Speaker=Schwifty Shawn Notes=*new* changed a ) to a }",
    "value": "{format nervous}...huh?{format reset}",
  },
  {
    "key": "welcome_to_the_hub.conversation_5yt2bx_text",
    "notes": "Speaker=Fen",
    "value": "Reinforcements! Get them both now, before they multiply!",
  },
  {
    "key": "welcome_to_the_hub.conversation_0y97x7_text",
    "notes": "Speaker=Rosie",
    "value": "Another quake... and another violent bot. Keep that guard up, Shawn!",
  },
  {
    "key": "welcome_to_the_hub.conversation_swc23b_text",
    "notes": "Speaker=Dorothy",
    "value": "You can talk?",
  },
  {
    "key": "welcome_to_the_hub.conversation_sa7wlq_text",
    "notes": "Speaker=Rosie",
    "value": "Why wouldn't I be talkin'? Have you {format emph}tried{format reset} talkin' to any of us before, robot?",
  },
  {
    "key": "welcome_to_the_hub.conversation_h9pnyw_text",
    "notes": "Speaker=Dorothy",
    "value": "You're right. I'm sorry. I'm not here to pick a fight, I'm just trying to find a missing friend.",
  },
  {
    "key": "welcome_to_the_hub.conversation_mkx6nq_text",
    "notes": "Speaker=Rosie",
    "value": "Is this friend a brownish, tin-can lookin' tortoise fella?",
  },
  {
    "key": "welcome_to_the_hub.conversation_jignph_text",
    "notes": "Speaker=Dorothy",
    "value": "Yes! You've seen him! What's happened to him? Where is he?",
  },
  {
    "key": "welcome_to_the_hub.conversation_ryszmg_text",
    "notes": "Speaker=Rosie",
    "value": "Hm... probably not smart to let a steambot in, but you do seem sincere.",
  },
  {
    "key": "welcome_to_the_hub.conversation_2r5k9z_text",
    "notes": "Speaker=Rosie",
    "value": "I'm Rosie. Come on now, let's {format highlight}talk inside{format reset}, and I'll tell you what I know.",
  },
  {
    "key": "floaty.conversation_ty7umo_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Shhhh... you're just as loud as li'l Rosie.",
  },
  {
    "key": "floaty.conversation_35muig_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Shhhh...",
  },
  {
    "key": "floaty.conversation_trxx9s_text",
    "notes": "Speaker=Cleo Johnson Notes=She has a fishing pole",
    "value": "Shhhh... you'll scare dem away...",
  },
  {
    "key": "floaty.conversation_bcfgsy_text",
    "notes": "Speaker=Dorothy",
    "value": "No offense, but I don't think fish can survive down in that sludge.",
  },
  {
    "key": "floaty.conversation_ufdh71_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Fish... what fishes? It's my shoes. Dem slippery fingses keep running off.",
  },
  {
    "key": "floaty.conversation_x3mdff_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo needs new shoes, here shooey shooey...",
  },
  {
    "key": "floaty.conversation_6wq728_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* run offt is old 20's hillbilly-talk.",
    "value": "Shooey... swim here and protect footsies, so Cleo can run offt.",
  },
  {
    "key": "floaty.conversation_vrn5ho_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm pretty sure shoes can't swim...",
  },
  {
    "key": "floaty.conversation_syk9tk_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Cleo sees you don't know much about shoes.",
  },
  {
    "key": "floaty.conversation_ejlda7_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "How else did they get down there in the Moon Juice?",
  },
  {
    "key": "floaty.conversation_9ssddv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Waddaya mean shoes can't swim. 'Course dem can.",
  },
  {
    "key": "floaty.conversation_f5fe22_text",
    "notes": "Speaker=Dorothy",
    "value": "Any luck catching your shoes?",
  },
  {
    "key": "floaty.conversation_uwbwbt_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* Speachimpediment: "Dry mouf"="dry mouth"",
    "value": "Ah! To heck with shooey, Cleo has a dry mouf and can't wait around here no more.",
  },
  {
    "key": "floaty.conversation_7dil67_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo got plans, Cleo will leave this place and never fink-e-link about shooey again.",
  },
  {
    "key": "floaty.conversation_e7vvqa_text",
    "notes": "Speaker=Dorothy",
    "value": "Okay...",
  },
  {
    "key": "floaty.conversation_mkd1g9_text",
    "notes": "Speaker=Cleo Johnson Notes=You dumb bucket thing, Cleo should kick you before say more stupid things.",
    "value": "You dumb bucket fingsy, Cleo should kick you before you say more stupid fingses.",
  },
  {
    "key": "floaty.conversation_7c453w_text",
    "notes": "Speaker=Cleo Johnson Notes=Pay attention to the translation of "moon juice"",
    "value": "Cleo will leave soon, we's runsing low on Moon Juice.",
  },
  {
    "key": "floaty.conversation_nny1i7_text",
    "notes": "Speaker=Cleo Johnson Notes=thursty",
    "value": "Cleo is firsty.",
  },
  {
    "key": "floaty.conversation_atofqv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Here, shooey shooey shooey!",
  },
  {
    "key": "gran.conversation_dk7b1d_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Mah big soft daughter let in a steambot? She's even dumberer than she looks!",
  },
  {
    "key": "gran.conversation_0fdyik_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "What's a tinny metal thingy like ya'll doin' here?",
  },
  {
    "key": "gran.conversation_xx02dp_text",
    "notes": "Speaker=Dorothy",
    "value": "Rosie invited me here to talk.",
  },
  {
    "key": "gran.conversation_qvnh5f_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Typical of mah big mutant softy daughter. With all her brawn she can't even smash a tin can.",
  },
  {
    "key": "gran.conversation_n9fykw_text",
    "notes": "Speaker=Dorothy",
    "value": "That's not very nice.",
  },
  {
    "key": "gran.conversation_mypcv4_text",
    "notes": "Speaker=Dynomyte Harriet Notes=*new* rephrased. Boom sticks here are sticks of dynamite",
    "value": "What else should we do with 'em boom sticks!",
  },
  {
    "key": "gran.conversation_e6z5ja_text",
    "notes": "Speaker=Fen",
    "value": "I like this fleshy meat bag.",
  },
  {
    "key": "gran.conversation_3zke2l_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "How many sticks you think Ah'd need to blow up one of ya'll cans?",
  },
  {
    "key": "gran.conversation_a9cchj_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ah don't like tin cans hangin' 'round our oasis.",
  },
  {
    "key": "gran.conversation_9svalt_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Rosie shoulda smashed you instead of lettin' ya'll in here.",
  },
  {
    "key": "gran.conversation_3su3ui_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "In the good ol' days we roamed the mines. If we found any annoyin' tin thingies we'd blow 'em up.",
  },
  {
    "key": "gran.conversation_oza28i_text",
    "notes": "Speaker=Fen",
    "value": "This flesh-bag just gets more and more entertaining!",
  },
  {
    "key": "gran.conversation_yrhik2_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Watch ya back, tinny!",
  },
  {
    "key": "gran.conversation_ihr9we_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ah'm tired of shufflin' around in here in mah slippers.",
  },
  {
    "key": "gran.conversation_agybew_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Ah should go out there and blow 'em earthquakes and 'em weird jungle plants right up.",
  },
  {
    "key": "gran.conversation_nvv14n_text",
    "notes": "Speaker=Dynomyte Harriet Notes=Pay attention to translation of Moon Juice",
    "value": "Ah'll just wait for one more swig of that sweet Moon Juice, and I'm off.",
  },
  {
    "key": "gran.conversation_ezltzc_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Maybe if Ah tape a few boom sticks together? Stick 'em in a hole to keep those quakes in line?",
  },
  {
    "key": "gran.conversation_2h242j_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Keep off! Ah don't wanna waste my boom sticks on ya'll!",
  },
  {
    "key": "helpfulhelen.conversation_146h2g_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_w42y9y_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Keep... keep away... you... you gear-can!",
  },
  {
    "key": "helpfulhelen.conversation_lbsxjr_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm not dangerous. I just wondered if...",
  },
  {
    "key": "helpfulhelen.conversation_76kde3_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_nilvvh_text",
    "notes": "Speaker=Dorothy",
    "value": "Okay... I'm backing off!",
  },
  {
    "key": "helpfulhelen.conversation_nrvcc5_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed all-caps",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_na5ijp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "I'm great at rassling robots, you know. ",
  },
  {
    "key": "helpfulhelen.conversation_t4gyc9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "I rassled one just the other week.",
  },
  {
    "key": "helpfulhelen.conversation_8z4duw_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "And I almost didn't get hurt or nuthin'. I just had to regrow one of mah arms is all.",
  },
  {
    "key": "helpfulhelen.conversation_68xyfp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Lucky it wasn't mah stabbin' arm.",
  },
  {
    "key": "helpfulhelen.conversation_4tb6xl_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_mfx4dl_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Yep, I was in a robot scrap fight.",
  },
  {
    "key": "helpfulhelen.conversation_2z93th_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed "That"",
    "value": "Rosie don't like me going into the mine to stab around.",
  },
  {
    "key": "helpfulhelen.conversation_2r5nu3_text",
    "notes": "Speaker=Dorothy",
    "value": "Sounds reasonable enough.",
  },
  {
    "key": "helpfulhelen.conversation_10fkd9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "But I likes stabbin'!",
  },
  {
    "key": "helpfulhelen.conversation_sp7pdd_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_6iq52s_text",
    "notes": "Speaker=Stabby Helen",
    "value": "You know, I like to stab things.",
  },
  {
    "key": "helpfulhelen.conversation_1su49z_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed the last "left"",
    "value": "I dream of rushing the mines, stabby-stabbing left and right!",
  },
  {
    "key": "helpfulhelen.conversation_azc2px_text",
    "notes": "Speaker=Dorothy",
    "value": "Alright...",
  },
  {
    "key": "helpfulhelen.conversation_14e8qj_text",
    "notes": "Speaker=Stabby Helen Notes=*new* changed right to left",
    "value": "And left!",
  },
  {
    "key": "helpfulhelen.conversation_cu3ase_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_5wwgu9_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "helpfulhelen.conversation_rnl3im_text",
    "notes": "Speaker=Stabby Helen",
    "value": "I just wanna go out there and use mah stabber!",
  },
  {
    "key": "helpfulhelen.conversation_2kxxoa_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Stabby-stab-stab!",
  },
  {
    "key": "sign_shiver.conversation_iyd9iu_text",
    "notes": "Speaker=Dorothy",
    "value": ""Warning! Earthquakes! Contact the mayor of El Machino for additional information."",
  },
  {
    "key": "sign_miners_wanted.conversation_jn4gij_text",
    "notes": "Speaker=Dorothy",
    "value": ""Miners wanted! Continue east to El Machino and dig up your destiny!"",
  },
  {
    "key": "fen_on_shiners.conversation_04wf3d_text",
    "notes": "Speaker=Dorothy",
    "value": "I've never met a talking shiner before. Usually they're just deranged and dangerous.",
  },
  {
    "key": "fen_on_shiners.conversation_mlu9ml_text",
    "notes": "Speaker=Fen",
    "value": "Yes... what a disappointment this is!",
  },
  {
    "key": "fen_on_shiners.conversation_mcuc1c_text",
    "notes": "Speaker=Dorothy Notes=*new* removed and, added this",
    "value": "I'll go {format highlight}talk to this Rosie{format reset}. She might actually know where Rusty is.",
  },
  {
    "key": "guarding_hub.conversation_z2w2u3_text",
    "notes": "Speaker=Schwifty Shawn Notes=*format* *new* also removed the line break (
}",
    "value": "H-h-h-heeeey! Wedya shink yagon?",
  },
  {
    "key": "guarding_hub.conversation_n2ebi3_text",
    "notes": "Speaker=Fen",
    "value": "Ew, destroy that thing immediately!",
  },
  {
    "key": "guarding_hub.conversation_kljpda_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Whoa! Another earthquake!{format reset}",
  },
  {
    "key": "dorothy_intro.conversation_t7sxdc_text",
    "notes": "Speaker=Dorothy",
    "value": "Where have you {format emph}gone{format reset}, Rusty?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_vmz2v5_text",
    "notes": "Speaker=Fen",
    "value": "This is it. The entrance to Vectron.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_iupd4b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Alright, let's enter that thing?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_bbcmp1_text",
    "notes": "Speaker=Fen Notes=*format* *new*'",
    "value": "I told you, I'm not going {format emph}in there{format reset} with you. I don't want to...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rh2uj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Even if I did I wouldn't be able to. Not through a portal like {format emph}that{format reset}.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_pkxjfo_text",
    "notes": "Speaker=Fen",
    "value": "But I said I would {format emph}get you{format reset} in there...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_emqhdd_text",
    "notes": "Speaker=Dorothy",
    "value": "If there's a chance that Rusty's in there, I have to go.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rkegt_text",
    "notes": "Speaker=Fen",
    "value": "Then you must go, I guess...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_qrn9qn_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_bye",
    "value": "You'll be alone in there, and you won't have access to my map.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_sfgslu_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_by",
    "value": "You'll have to find your own way out.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_j9uqnv_text",
    "notes": "Speaker=Fen",
    "value": "Are you really sure you want to do this?",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_69953l_text",
    "notes": "Speaker=Fen Notes=*format* *new*",
    "value": "Okay...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_yjswup_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Here goes...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_uwxfmo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Yeah, {format emph}I'm{format reset} not going to twist your arm.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_91l718_text",
    "notes": "Speaker=Dorothy",
    "value": "I'll come find you when I'm out again.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vmzz9y_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_u6n77q_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "If you see anything moving in there, just run. Run as fast as you can...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vctaoa_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "exiting_vectron_firsttime_01.conversation_sp4sbx_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_rj6ww8_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "FEN!?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_ad0u27_text",
    "notes": "Speaker=vectron_teleporter Notes=*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    "value": "Fen? I... I am Fen.",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_1ajm6u_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Dorothy?",
  },
  {
    "key": "run_away_with_rusty_1.conversation_wgoby1_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY!",
  },
  {
    "key": "rosie_boss_intro_01.conversation_r5a8b8_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY!?",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_pgjtz4_text",
    "notes": "Speaker=Dorothy",
    "value": "Come on, Fen! We have to hurry!",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_uzk2jn_text",
    "notes": "Speaker=Fen",
    "value": "There's no way we'll {format nervous}make it back{format reset} to the city like this...",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_5rvneb_text",
    "notes": "Speaker=Fen Notes=*new* changed the format to affect more words",
    "value": "But I can get the {format emph}two of you{format reset} out in time.",
  },
  {
    "key": "sign_thehub.conversation_32yflg_text",
    "notes": "Speaker=Dorothy",
    "value": ""WE ARE COLSED! GO HOME!"",
  },
  {
    "key": "fen_its_gonna_blow.conversation_ghi2wb_text",
    "notes": "Speaker=Fen",
    "value": "Hey this thing is {format nervous}going haywire!{format reset}",
  },
  {
    "key": "fen_its_gonna_blow.conversation_8xsftw_text",
    "notes": "Speaker=Fen Notes=*new* changed formated text from highlight to emph",
    "value": "Let's get out of here! {format emph}Now!{format reset}",
  },
  {
    "key": "run_away_with_rusty_3.conversation_4v2csa_text",
    "notes": "Speaker=Dorothy",
    "value": "Professor Sherman's rocket!",
  },
  {
    "key": "run_away_with_rusty_3.conversation_izxx5d_text",
    "notes": "Speaker=Dorothy",
    "value": "We need to get back up to town now!",
  },
  {
    "key": "easteregg_ending.conversation_x1pswz_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Come on now! {format emph}Hurry!{format reset}",
  },
  {
    "key": "easteregg_ending.conversation_bfup2f_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "We don't have time for second thoughts!",
  },
  {
    "key": "easteregg_ending.conversation_2ez9yy_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Come on!",
  },
  {
    "key": "easteregg_ending.conversation_kuytvd_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "You've been playing the hero long enough.",
  },
  {
    "key": "fen_ending_goodbye.conversation_qsa1um_text",
    "value": "See you around, Dot...",
  },
  {
    "key": "rocketeer.conversation_hwmfh6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I just wish mayor Yonker would listen to reason.",
  },
  {
    "key": "rocketeer.conversation_d0ozct_text",
    "notes": "Speaker=Professor Sherman",
    "value": "There is simply no talking to people whose very survival depends on not getting it.",
  },
  {
    "key": "rocketeer.conversation_bdyzc2_text",
    "notes": "Speaker=Professor Sherman",
    "value": "There is something very strange about these earthquakes.",
  },
  {
    "key": "rocketeer.conversation_tjv7fp_text",
    "notes": "Speaker=Dorothy Notes=*new* changes since earlier version could be off in some instances.",
    "value": "Wow! That's one neat looking rocket!",
  },
  {
    "key": "rocketeer.conversation_t09utv_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased to work with new version of above line",
    "value": "Well, since the mayor is being highly unscientific at the moment, I have to think of a contingency plan.",
  },
  {
    "key": "rocketeer.conversation_f7plgb_text",
    "notes": "Speaker=Professor Sherman",
    "value": "My seismometer tells me that something is very off about these quakes, you see.",
  },
  {
    "key": "rocketeer.conversation_yhfxkq_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Our mine is dug right along a fault line. One great quake and this whole place could tumble!",
  },
  {
    "key": "rocketeer.conversation_k00t1f_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I hope I can get this rocket fully functional before it is too late.",
  },
  {
    "key": "rocketeer.conversation_220si9_text",
    "notes": "Speaker=Professor Sherman",
    "value": "These new earthquakes beg to be investigated more closely. There is a lot at stake.",
  },
  {
    "key": "rocketeer.conversation_yd21lh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Well, actually two large continental plates meet here, right beneath our boots.",
  },
  {
    "key": "rocketeer.conversation_yhhdlm_text",
    "notes": "Speaker=Professor Sherman",
    "value": "The city is built on a rock pillar that rose when these plates collided, millions of years ago.",
  },
  {
    "key": "rocketeer.conversation_jd18od_text",
    "notes": "Speaker=Dorothy",
    "value": "Wow...",
  },
  {
    "key": "rocketeer.conversation_ma515w_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I am a bit worried about these strange seismic patterns.",
  },
  {
    "key": "rocketeer.conversation_rh627j_text",
    "notes": "Speaker=Professor Sherman",
    "value": "They are not caused by the normal movements of the Earth's crust.",
  },
  {
    "key": "rocketeer.conversation_8vxt9k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "If the Great Quake hits, it could destroy the whole city. Or worse, the entire planet!",
  },
  {
    "key": "rocketeer.conversation_nid8rc_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Woah!{format reset} I'd better keep my senses tuned down there then.",
  },
  {
    "key": "rocketeer.conversation_gqcn63_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "That is the spirit!",
  },
  {
    "key": "rocketeer.conversation_q2vvjy_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I am still a bit worried about these strange seismic patterns.",
  },
  {
    "key": "rocketeer.conversation_46mop5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "The protective wall at the bottom of the mine really is a wonder.",
  },
  {
    "key": "rocketeer.conversation_k6sl9a_text",
    "notes": "Speaker=Dorothy",
    "value": "There was a wall beneath my little hometown, Tumbleton, too.",
  },
  {
    "key": "rocketeer.conversation_wb49hd_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Actually it is the same wall. It is continuous and goes on for miles!",
  },
  {
    "key": "rocketeer.conversation_prdn7m_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "It is the greatest single bot-made structure in existence. If it were up here, you would see it from space.",
  },
  {
    "key": "rocketeer.conversation_0b17qr_text",
    "notes": "Speaker=Dorothy",
    "value": "All that brick-laying just to keep the shiners down there...",
  },
  {
    "key": "rocketeer.conversation_4s3zz6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Well, the shiners, or {format emph}homo devolvis{format reset}, are quite crafty when it comes to specific subjects.",
  },
  {
    "key": "rocketeer.conversation_29dn85_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "That Moon Juice they have concocted, to cope with life underground, is quite special...",
  },
  {
    "key": "rocketeer.conversation_8na87z_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added a comma after mutagenic",
    "value": "It is highly mutagenic, and of course addictive, but it is also an extremely effective energy source.",
  },
  {
    "key": "rocketeer.conversation_auy7u5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "I actually tried to burn it for rocket fuel in an earlier experiment, but it proved much too volatile.",
  },
  {
    "key": "rocketeer.conversation_0144bl_text",
    "notes": "Speaker=Professor Sherman",
    "value": "The protective wall really is a marvel to behold. ",
  },
  {
    "key": "rocketeer.conversation_vfvf68_text",
    "notes": "Speaker=Dorothy",
    "value": "Do you know anything about cave-dwelling plants?",
  },
  {
    "key": "rocketeer.conversation_n56yib_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I am not really a biologist, but maybe some types of fungi could handle such environments?",
  },
  {
    "key": "rocketeer.conversation_6u259t_text",
    "notes": "Speaker=Dorothy",
    "value": "I found a whole cave that's been completely overgrown with it.",
  },
  {
    "key": "rocketeer.conversation_4luy17_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Peculiar! They would have to get their energy from something other than photosynthesis, that is for sure.",
  },
  {
    "key": "rocketeer.conversation_vq8bcq_text",
    "notes": "Speaker=Dorothy",
    "value": "I found the shiners. I even talked to them! They've built a village below the wall.",
  },
  {
    "key": "rocketeer.conversation_qbphbv_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Fascinating! I have not heard of any talking shiners in modern times at all.",
  },
  {
    "key": "rocketeer.conversation_d8arjf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "The few I have seen with my own eyes have communicated with guttural noises. Completely unintelligible!",
  },
  {
    "key": "rocketeer.conversation_m0q6cs_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I have read documents proposing that they were once the dominating species of this planet.",
  },
  {
    "key": "rocketeer.conversation_n96czx_text",
    "notes": "Speaker=Professor Sherman",
    "value": "It is hard to do anything but speculate when it comes to homo devolvis...",
  },
  {
    "key": "rocketeer.conversation_9axbnb_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new* merged two lines into one.",
    "value": "It is nearly impossible to get any specimen to study without harming them... or getting harmed yourself.",
  },
  {
    "key": "rocketeer.conversation_6qfwjp_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "The shiners are a fascinating species. A hint of individuality behind those deranged eyes.",
  },
  {
    "key": "rocketeer.conversation_wlfozb_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased",
    "value": "Professor, you're a smart bot. Do you think these earthquakes could be bot-made?",
  },
  {
    "key": "rocketeer.conversation_ylnbuf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "You mean, is someone generating the earthquakes?",
  },
  {
    "key": "rocketeer.conversation_x4pgec_text",
    "notes": "Speaker=Professor Sherman",
    "value": "That could actually explain the peculiarly specific epicenter of the latest seismic activity.",
  },
  {
    "key": "rocketeer.conversation_934xqz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "It came right out of the temple of that crazy doom cult.",
  },
  {
    "key": "rocketeer.conversation_72gm7a_text",
    "notes": "Speaker=Dorothy",
    "value": "So {format emph}it is{format reset} possible?",
  },
  {
    "key": "rocketeer.conversation_w0qkeb_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "If you want to test this hypothesis you must {format highlight}cross the Windy Plains{format reset} to the temple in the east and investigate.",
  },
  {
    "key": "rocketeer.conversation_7xmo4l_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "This hypothesis about bot-made earthquakes is fascinating.",
  },
  {
    "key": "rocketeer.conversation_p7mpft_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added the part about taking the ladder",
    "value": "{format highlight}Cross the Windy Plains{format reset} to investigate it further. Just take the ladder down the east side of the city.",
  },
  {
    "key": "rocketeer.conversation_9zagcy_text",
    "notes": "Speaker=Dorothy",
    "value": "The cult is protecting some sort of device that could be generating the quakes.",
  },
  {
    "key": "rocketeer.conversation_d8olb4_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Then your next step should be to dismantle that generator. That might stop these earthquakes.",
  },
  {
    "key": "rocketeer.conversation_vts8e3_text",
    "notes": "Speaker=Fen",
    "value": "{format emph}Yeah!{format reset} Dismantling sounds like fun. Let's do that!",
  },
  {
    "key": "rocketeer.conversation_ly2vhz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I may not even have to complete the construction of this rocket.",
  },
  {
    "key": "rocketeer.conversation_ypryh5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "It is not an easy task, building a space exploratory vessel.",
  },
  {
    "key": "rocketeer.conversation_qq0n6k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "If you could {format highlight}disable the earthquake generator{format reset}, I might not have to.",
  },
  {
    "key": "rocketeer.conversation_hbhl5o_text",
    "notes": "Speaker=Dorothy",
    "value": "How could a steambot build a device that generates earthquakes?",
  },
  {
    "key": "rocketeer.conversation_dpkudw_text",
    "notes": "Speaker=Professor Sherman",
    "value": "They must have great knowledge about some quite advanced technology.",
  },
  {
    "key": "rocketeer.conversation_irqx6c_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Futuristic technology beyond anything I have ever seen...",
  },
  {
    "key": "rocketeer.conversation_gljg9h_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I have looked into some of my old readings, tried to discern patterns, but they are all over the place.",
  },
  {
    "key": "rocketeer.conversation_j3paiq_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new*",
    "value": "The erratic movements of these tremors suggest that we are not all in the clear yet.",
  },
  {
    "key": "rocketeer.conversation_w8nhom_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I certainly do not feel ready to stop tinkering with the rocket just yet.",
  },
  {
    "key": "rocketeer.conversation_ihi6uu_text",
    "notes": "Speaker=Professor Sherman",
    "value": "I do not feel ready to stop tinkering with the rocket just yet.",
  },
  {
    "key": "rocketeer.conversation_j6jtna_text",
    "notes": "Speaker=Professor Sherman",
    "value": "A colleague of mine was able to get some samples from the subterranean jungle.",
  },
  {
    "key": "rocketeer.conversation_oepnn1_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "It's strange, isn't it? And very dangerous.",
  },
  {
    "key": "rocketeer.conversation_kul85z_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, it's pretty cool!",
  },
  {
    "key": "rocketeer.conversation_b4ld5b_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Anyway, he said that he found traces of some mutagen polluting the biology of the plants.",
  },
  {
    "key": "rocketeer.conversation_h8rkzh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "It seems like they get their energy from drinking the mutagenic {format emph}Moon Juice{format reset} that the shiners are so obsessed with.",
  },
  {
    "key": "rocketeer.conversation_bthpa5_text",
    "notes": "Speaker=Dorothy",
    "value": "There {format emph}are{format reset} a lot of pipes running through that place.",
  },
  {
    "key": "rocketeer.conversation_wvpx34_text",
    "notes": "Speaker=Professor Sherman",
    "value": "That could definitely be the source of the pollutant.",
  },
  {
    "key": "rocketeer.conversation_ll0rrj_text",
    "notes": "Speaker=Professor Sherman",
    "value": "This jungle is just one more mystery in an increasingly strange flow of events.",
  },
  {
    "key": "rocketeer.conversation_gcue08_text",
    "notes": "Speaker=Dorothy",
    "value": "We've disabled all of the quake generators.",
  },
  {
    "key": "rocketeer.conversation_rhj5jo_text",
    "notes": "Speaker=Professor Sherman",
    "value": "My seismic readings have stopped jumping around and have homed in on a single point.",
  },
  {
    "key": "rocketeer.conversation_pgv6y7_text",
    "notes": "Speaker=Professor Sherman",
    "value": "That last quake came right out of shiner country.",
  },
  {
    "key": "rocketeer.conversation_j878i8_text",
    "notes": "Speaker=Dorothy Notes=*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    "value": "We really have to get back down there and {format highlight}talk to Rosie.{format reset}",
  },
  {
    "key": "rocketeer.conversation_lv5xcl_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased the ending of the line.",
    "value": "Good thing my rocket is ready. Just some final preparations and I can leave if I have to.",
  },
  {
    "key": "rocketeer.conversation_9rxm14_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Just some final preparations and we can leave this planet, in case the Great Quake decides to strike.",
  },
  {
    "key": "rocketeer.conversation_tnyv5r_text",
    "notes": "Speaker=Professor Sherman",
    "value": "As soon as my space exploratory vessel is completed I will leave this planet.",
  },
  {
    "key": "rocketeer.conversation_7an1z5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Anyone is welcome to join me. I have made it big enough to hold everyone.",
  },
  {
    "key": "workbench_conversation.conversation_f5xes1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Oh oh oh!",
  },
  {
    "key": "workbench_conversation.conversation_vwbtbo_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "I got some fantastic new upgrades available for you! Very high tech stuff!",
  },
  {
    "key": "workbench_conversation.conversation_d17hfn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "So, um, sorry to bother you... again.",
  },
  {
    "key": "workbench_conversation.conversation_2hj8xd_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "But I just got a batch of new materials! They will let you upgrade your tools even more.",
  },
  {
    "key": "workbench_conversation.conversation_dnpk79_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Um... just thought you should know.",
  },
  {
    "key": "workbench_conversation.conversation_cq63md_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Hi...?",
  },
  {
    "key": "workbench_conversation.conversation_eb2wqf_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}Aaah{format reset}, I mean... Hello!",
  },
  {
    "key": "workbench_conversation.conversation_6hj11o_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Um... I got a new shipment of parts!",
  },
  {
    "key": "workbench_conversation.conversation_ozu5go_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "It will let you upgrade pretty much all of your tools... I mean, upgrade them even more. Neat, huh?",
  },
  {
    "key": "workbench_conversation.conversation_rkault_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "I, um, noted that your armor had some dents in it...",
  },
  {
    "key": "workbench_conversation.conversation_8lfpm2_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "My new shipment of thick plating will let you upgrade it.",
  },
  {
    "key": "workbench_conversation.conversation_kpzosz_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "So you'll have a better chance of, you know... surviving... down there.",
  },
  {
    "key": "workbench_conversation.conversation_vk0in8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um... what do you wanna do?",
  },
  {
    "key": "workbench_conversation.conversation_xbec1d_text",
    "notes": "Speaker=Turtle Bucket Notes=This is the introductary phrase from the mechanich",
    "value": "Um... what do you wanna do?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_4nh80e_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um... I like your gear.",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_zb6ryl_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "So, um... you could improve it by using cogs. Do you, um... wanna know how?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_k47xd0_text",
    "notes": "Speaker=Turtle Bucket Notes=This person is very nervous",
    "value": "Um, sorry... I'll keep quiet - huh!?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_xsq7ao_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "You really want to know!? Oh, oh, oh, okay! Okay!",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_9iwqjw_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Okay, well, um... yes. Sorry. I'll be over here...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e2sw99_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "So, um... you can {format highlight}enhance your tools{format reset} with cogs {image cogs_small}.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_qsonke_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "You may have seen a few of them around the place.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_9chqoj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Use the workbench to select a tool's cog slot and insert your cogs {image cogs_small} into it.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_0dnnax_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Oh! But, um... don't worry, you can {format highlight}extract your cogs{format reset} {image cogs_small} just as easily!",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_90zfu2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "As you upgrade your tools you'll get access to even cooler improvements.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_a5snuc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "So, um... there's a little more I want to tell you, but if you don't want to...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_b1szsc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "There are some enhancements that you need to find blueprints for.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_f0xxtp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Davy Bittenborough, our... um... cartographer, have a few on hand I think.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_1q2dd2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Blueprint improvements are usually pretty cool! Well, at least I think so...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_i2a540_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, and since you can extract any cogs {image cogs_small}, you may want to experiment.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_5p4bi7_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Change your setup every now and then. I mean, if you want to...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_iq6h9b_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Um... wow, you listened to all of it! Not many do...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e4vdfi_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Okay, um... I'll be here, I guess.",
  },
  {
    "key": "fen_wall_found.conversation_9lkkka_text",
    "notes": "Speaker=Fen",
    "value": "This place looks familiar. Maybe the cult brought me here on their way up.",
  },
  {
    "key": "fen_wall_found.conversation_qsa4d1_text",
    "notes": "Speaker=Fen",
    "value": "How much deeper down are the {format nervous}remains of Vectron{format reset}, you think?",
  },
  {
    "key": "fen_wall_found.conversation_3rahmd_text",
    "notes": "Speaker=Dorothy",
    "value": "It's a long way down. We're still in the explored parts of the mine.",
  },
  {
    "key": "fen_wall_found.conversation_xecqeg_text",
    "notes": "Speaker=Fen",
    "value": "Ah, okay... good. I was just wondering.",
  },
  {
    "key": "fen_wall_found.conversation_mx4ktk_text",
    "notes": "Speaker=Dorothy",
    "value": "Now I just need to find a way through this darn wall.",
  },
  {
    "key": "fen_wall_found.conversation_cat8cu_text",
    "notes": "Speaker=Fen",
    "value": "Ooh! {format singsong}Explosion time!{format reset}",
  },
  {
    "key": "fen_wall_found.conversation_nq5gxh_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "That won't do! These walls were built after the shiner wars to keep those crazies from coming up.",
  },
  {
    "key": "fen_wall_found.conversation_gu7tji_text",
    "notes": "Speaker=Dorothy",
    "value": "Shiners are experts at blowing things up, so the walls were built to withstand blasts.",
  },
  {
    "key": "fen_below_wall.conversation_mbv8tf_text",
    "notes": "Speaker=Fen Notes=Place, refering to the underground jungle that they just passed thruogh.",
    "value": "Hey, that place was {format nervous}pretty weird!{format reset}",
  },
  {
    "key": "fen_below_wall.conversation_cj1k6o_text",
    "notes": "Speaker=Dorothy",
    "value": "Looks like it got me beneath the first layer of the wall, at least.",
  },
  {
    "key": "fen_below_wall.conversation_5mo9pe_text",
    "notes": "Speaker=Dorothy",
    "value": "I hope that mining station is around here somewhere.",
  },
  {
    "key": "fen_below_wall.conversation_vizvqs_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "And I hope we find something cool and destructive in there.",
  },
  {
    "key": "fen_on_yarrow.conversation_rswyd0_text",
    "notes": "Speaker=Fen",
    "value": "Say, what {format emph}is{format reset} this place? Looks murky and dangerous. Let's explore it!",
  },
  {
    "key": "fen_on_yarrow.conversation_vqbkn5_text",
    "notes": "Speaker=Dorothy Notes=*new* shortened by removing description of place. Was a bit misrepresentative",
    "value": "There really shouldn't be anything growing down here...",
  },
  {
    "key": "fen_on_yarrow.conversation_jk4t0s_text",
    "notes": "Speaker=Dorothy",
    "value": "There could be all sorts of dangers waiting for us.",
  },
  {
    "key": "fen_on_yarrow.conversation_i4oq3o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Yeah!{format reset}",
  },
  {
    "key": "fen_on_yarrow.conversation_qaywwl_text",
    "notes": "Speaker=Dorothy",
    "value": "I'll have to make sure I have enough light before barging in here.",
  },
  {
    "key": "fen_on_yarrow.conversation_sf4uwk_text",
    "notes": "Speaker=Fen",
    "value": "Aw, you're no fun. Let's go!",
  },
  {
    "key": "blueprint_vendor_01.conversation_1135rj_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "My word! These earthquakes are troublesome. The Mayor really must have someone look into this.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dq65oq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "What if all of the wonderful treasures down there get crushed? Perish the thought!",
  },
  {
    "key": "blueprint_vendor_01.conversation_3fn5w0_text",
    "notes": "Speaker=Dorothy",
    "value": "So, I guess you really like precious stones?",
  },
  {
    "key": "blueprint_vendor_01.conversation_npebbg_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "No no no! I'm speaking of {format emph}real{format reset} treasures. Fascinating and strange artifacts {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_a7uvtg_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Something splendid, with its own marvelous tale to tell.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mjgdjr_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    "value": "If you happen to find any such artifacts {image artifacts_small} it would be lovely if you would let me have a look at them.",
  },
  {
    "key": "blueprint_vendor_01.conversation_uwhgx6_text",
    "notes": "Speaker=Dorothy",
    "value": "I think I've found something you might find interesting.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iqy08o_text",
    "notes": "Speaker=Dorothy",
    "value": "Right, I'll keep an eye open for anything interesting.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rppjea_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Splendid!{format reset} I shall give you a {format highlight}blueprint{format reset} if you bring me at least {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_br857t_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Oh my!{format reset} Spin me around and pinch me so I know that I'm awake.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iptdw9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You have actually located the mythical 43rd precious artifact{image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_lu65ll_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "How I have dreamed of this. My family has been looking for this thing for generations. I cannot wait to feast my eyes upon it.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wu0y6m_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "...",
  },
  {
    "key": "blueprint_vendor_01.conversation_vyiiiz_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Wait...",
  },
  {
    "key": "blueprint_vendor_01.conversation_ds3fs3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "That's it?",
  },
  {
    "key": "blueprint_vendor_01.conversation_kheln9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "This is so... so...",
  },
  {
    "key": "blueprint_vendor_01.conversation_axft9i_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Disappointing.",
  },
  {
    "key": "blueprint_vendor_01.conversation_66l4aw_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Well, thank you, I guess.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6ybt0n_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "My life feels so meaningless now.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rlfp8l_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Oh splendid!{format reset} You've found {var num_artifacts_current} fascinating artifacts {image artifacts_small} already!",
  },
  {
    "key": "blueprint_vendor_01.conversation_as6lw7_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Oh splendid!{format reset} You've found {var num_artifacts_current} fascinating artifact {image artifacts_small} already!",
  },
  {
    "key": "blueprint_vendor_01.conversation_p7vtak_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format* removed emph from appreciation",
    "value": "To show you my appreciation, I shall hand you a {format highlight}blueprint{format reset} from my stack.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dcphb9_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* "it" refering to the blueprint",
    "value": "You simply have to take it over to the workbench and use the Cog Mods to put it to good use.",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8lzbu_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* gives the player som info on how many artefacts until next blueprint",
    "value": "I will give you another blueprint if you can show me {var num_artifacts_threshold} artifacts {image artifacts_small} in total.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pwaqqk_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Well, I see you have not found {format emph}any{format reset} fascinating artifacts {image artifacts_small} yet.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tm2fum_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "I shall give you a {format highlight}blueprint{format reset} if you bring me at least {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_31n97u_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Well, it's wonderful that you have found {var num_artifacts_current} nice artifact {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_xkdvzp_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "I shall give you a {format highlight}blueprint{format reset} if you bring me at least {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_vj87ok_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Ah, yes! You've found {var num_artifacts_current} fascinating artifacts {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_c12v5z_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "These precious things can be hidden all over the place.",
  },
  {
    "key": "blueprint_vendor_01.conversation_r70wn4_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "But now you've got all this fancy new equipment to move about.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ozgox8_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Take care to really look around, will you?",
  },
  {
    "key": "blueprint_vendor_01.conversation_crg8xl_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    "value": "I will give you another blueprint if you can show me {var num_artifacts_threshold} artifacts {image artifacts_small} in total.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rkqt88_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* removed "wonderful" as it conflicted with previous lines in some cases",
    "value": "You have been so busy, I think you have shown me every fascinating item on this planet.",
  },
  {
    "key": "blueprint_vendor_01.conversation_4ngqs0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Good thing too, I don't seem to have any more blueprints!",
  },
  {
    "key": "blueprint_vendor_01.conversation_75th6d_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You know, when I was a spry young bot like yourself, I used to run all around this mine, making wonderful maps.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wvg349_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "I had the entire protective wall mapped out, even long before my knees started to snap and pop.",
  },
  {
    "key": "blueprint_vendor_01.conversation_90qcuc_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "I began with the lower layers, but those unreasonable shiners were quite the nuisance.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pffrd2_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Those creatures have no respect for fine craftsmanship. Using crude explosives on such a monument? Preposterous!",
  },
  {
    "key": "blueprint_vendor_01.conversation_fc5nyv_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "The wall naturally absorbs the majority of the force, but once in a while they manage to penetrate it.",
  },
  {
    "key": "blueprint_vendor_01.conversation_219b44_text",
    "notes": "Speaker=Dorothy",
    "value": "Have you ever been to the temple on the other side of the Windy Plains?",
  },
  {
    "key": "blueprint_vendor_01.conversation_0anv7h_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Those ruins are mostly uncharted. The temple has always been treacherous.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tv8uil_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "My old colleague, Ronald Hubbot, was the only one who {format emph}dared{format reset} venture down there.",
  },
  {
    "key": "blueprint_vendor_01.conversation_u57vpi_text",
    "notes": "Speaker=Dorothy",
    "value": "What happened to him?",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8rvft_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Oh, he apparently had some sort of ghastly vision foretelling the end of the world.",
  },
  {
    "key": "blueprint_vendor_01.conversation_02chim_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "He's been holed up in the temple. Gathering all sorts of madbots around him.",
  },
  {
    "key": "blueprint_vendor_01.conversation_i026up_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "I can just imagine what wonderful artifacts {image artifacts_small} are still hidden away in those ruins.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tvge9q_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You know, there must be {format emph}troves{format reset} of forgotten artifacts {image artifacts_small} deep down in the mine.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iyk7r0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Just imagine the relics long-forgotten cultures have left down there, waiting to be discovered.",
  },
  {
    "key": "blueprint_vendor_01.conversation_hp4wcb_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "What fascinating times to live in! It's been ages since bots ventured as deep as you have.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ekx3en_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You should head even deeper. History favors the bold, you know.",
  },
  {
    "key": "blueprint_vendor_01.conversation_bb807w_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "The western desert is a harsh and arid place, yet bots have lived out there for centuries. ",
  },
  {
    "key": "blueprint_vendor_01.conversation_6e53tq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "I'm certain there must be something fascinating hidden there among the rocks and the sand.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ja68cp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "I really do appreciate wonderful artifacts.",
  },
  {
    "key": "blueprint_vendor_01.conversation_9w2c24_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You know, usually it would take {format emph}aeons{format reset} for the Earth to change its geological structure.",
  },
  {
    "key": "blueprint_vendor_01.conversation_aactqp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "These new quakes could change the layout of the land in a matter of decades.",
  },
  {
    "key": "blueprint_vendor_01.conversation_fn5brp_text",
    "notes": "Speaker=Dorothy",
    "value": "We'll soon have these earthquakes sorted out.",
  },
  {
    "key": "blueprint_vendor_01.conversation_d0c0zs_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "What if the ground cracks completely? Then my maps would be completely useless. Outrageous!",
  },
  {
    "key": "blueprint_vendor_01.conversation_w56u9v_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "You know, that last earthquake was stupendously troublesome.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mcnumi_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Maybe professor Sherman is correct... We may all be forced to leave this planet.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mq34gi_text",
    "notes": "Speaker=Dorothy",
    "value": "We're trying our very best to prevent that from happening.",
  },
  {
    "key": "blueprint_vendor_01.conversation_h0mzw3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Having to learn how to map the stars might be a wonderful challenge, come to think of it.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uyr4r4_text",
    "notes": "Speaker=Clifford Heisenberg Notes=This person id located upp on a trellis with a fantastic view.",
    "value": "Ah, {format singsong}hi friend!{format reset} The view is great up here, isn't it? That mayor of ours sure is one lucky guy!",
  },
  {
    "key": "blueprint_vendor_02.conversation_w3sayh_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "He should listen more to the professor, though. These shakes aren't going to fix themselves!",
  },
  {
    "key": "blueprint_vendor_02.conversation_cww3zx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "The mayor isn't in. Wonder when he'll be back.",
  },
  {
    "key": "blueprint_vendor_02.conversation_0g6nsc_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Is that a bomb you're holding?",
  },
  {
    "key": "blueprint_vendor_02.conversation_474v8c_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Please tell me you're here to blow this ugly building to bits.",
  },
  {
    "key": "blueprint_vendor_02.conversation_o24esm_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format laugh}Yes!{format reset} I mean, no!",
  },
  {
    "key": "blueprint_vendor_02.conversation_yi4qcu_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed water bomb to pressure bomb",
    "value": "I wanted to show Mayor Yonker my new, improved pressure bomb. It's exactly what the city needs!",
  },
  {
    "key": "blueprint_vendor_02.conversation_bqmi7g_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "But... he just waved me off and told me to take it up with his office. There's no one here, though...",
  },
  {
    "key": "blueprint_vendor_02.conversation_5kay5a_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Oh, but I don't mind waiting! I'm sure the mayor will be back soon. Probably. Maybe. I dunno, sometime.",
  },
  {
    "key": "blueprint_vendor_02.conversation_73lt57_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Bombs have a lot of uses, you know. You can use them for {format emph}everything{format reset}. More or less.",
  },
  {
    "key": "blueprint_vendor_02.conversation_2t4ktx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "You can dig tunnels with them, crack hard mineral-rich rocks, clear debris and wreckage...",
  },
  {
    "key": "blueprint_vendor_02.conversation_tkp0i2_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Don't forget senseless destruction!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2ynw9y_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Used to be they'd be blasting day and night down in the mines. Oh, it was a feast for the ears!",
  },
  {
    "key": "blueprint_vendor_02.conversation_2vgr7k_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Sweet, lethal detonations!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nhr7x_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed pressurized water bomb to pressure bomb",
    "value": "I really hope I can talk the mayor into accepting the design for my new pressure bombs. Way of the future.",
  },
  {
    "key": "blueprint_vendor_02.conversation_gbuars_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "This guy gets it!",
  },
  {
    "key": "blueprint_vendor_02.conversation_h4evh3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "I'm happy you found someone to bond with, but I really wish it was over something else.",
  },
  {
    "key": "blueprint_vendor_02.conversation_v0gx3y_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I'm sure I can convince the mayor that my bombs are the way of the future.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hwchba_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Mr. Bittenborough brought me a twisted-up bomb casing once. Said he'd found it down in shiner territory.",
  },
  {
    "key": "blueprint_vendor_02.conversation_q0vd7o_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "It made me sick just looking at it! Did you know the shiners make their bombs out of {format nervous}nitroglycerin and Moon Juice?{format reset}",
  },
  {
    "key": "blueprint_vendor_02.conversation_shtyfr_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "What's wrong with that? It goes boom, doesn't it?",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nsm4v_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Sure does. And takes your fingers with it, if you're lucky that is!",
  },
  {
    "key": "blueprint_vendor_02.conversation_s7nbis_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed pressurized water bomb to pressure bomb",
    "value": "No thank you! I'll stick with my perfectly safe and stable pressure bombs. ",
  },
  {
    "key": "blueprint_vendor_02.conversation_p2i5l7_text",
    "notes": "Speaker=Fen Notes=*format* *new* removed "..."",
    "value": "Lame.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ptgzep_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Stay safe down there, friend. Those shiners are bad news.",
  },
  {
    "key": "blueprint_vendor_02.conversation_l8kkmb_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Have you been to see Professor Sherman's new rocket yet? It's a real beauty!",
  },
  {
    "key": "blueprint_vendor_02.conversation_9yditf_text",
    "notes": "Speaker=Dorothy Notes=This is Dororthy talking",
    "value": "Yeah, it sure is impressive.",
  },
  {
    "key": "blueprint_vendor_02.conversation_b8svck_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "And, it's perfectly safe. I helped with the calculations, after all!",
  },
  {
    "key": "blueprint_vendor_02.conversation_wz8w9f_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "It takes a lot of pressure to send something like that into space, you know. Everything must be precisely calibrated, down to the last decimal!",
  },
  {
    "key": "blueprint_vendor_02.conversation_516qkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "I mean, when it comes down to it, a rocket is really just a big bomb, isn't it?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8ly6iv_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "I like where this is going. Why don't we ask the professor for a ride?",
  },
  {
    "key": "blueprint_vendor_02.conversation_pawve3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Maybe later, Fen.",
  },
  {
    "key": "blueprint_vendor_02.conversation_sqkxyn_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Don't worry. I would never make a mistake when it comes to bombs!",
  },
  {
    "key": "blueprint_vendor_02.conversation_ha9646_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I've been thinking about these earthquakes. An earthquake is really just a large, violent vibration, right?",
  },
  {
    "key": "blueprint_vendor_02.conversation_fs869d_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format singsong}Sooo...{format reset} if we could create an equally large and violent but {format emph}opposite{format reset} vibration, the two should cancel out!",
  },
  {
    "key": "blueprint_vendor_02.conversation_1frwlw_text",
    "notes": "Speaker=Dorothy",
    "value": "Um... are you suggesting what I think you are...?",
  },
  {
    "key": "blueprint_vendor_02.conversation_qd7crv_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Exactly! Bombs! All we need to do is set up a network of synchronized bombs to counteract the shivers!",
  },
  {
    "key": "blueprint_vendor_02.conversation_t8xdab_text",
    "notes": "Speaker=Fen",
    "value": "Sweet! Nothing could possibly go wrong with this plan.",
  },
  {
    "key": "blueprint_vendor_02.conversation_50z3oe_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I'm so glad you agree! I just need to work on the calculations for a couple of years. Safety first!",
  },
  {
    "key": "blueprint_vendor_02.conversation_wdv8yf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Aw...",
  },
  {
    "key": "blueprint_vendor_02.conversation_dx83ih_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I can't wait to tell Mayor Yonker about my plan. I'm sure he'll go for it! I wonder when he'll be back. He's been gone a while.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hu5cr9_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I don't like all this talk about the Great Quake. There are so many unknowns. How big? When will it hit? Where?",
  },
  {
    "key": "blueprint_vendor_02.conversation_achdi1_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ever since the elevator came crashing down I've been thinking about what's going to happen if a {format emph}really{format reset} big one hits.",
  },
  {
    "key": "blueprint_vendor_02.conversation_k2l3ob_text",
    "notes": "Speaker=Dorothy",
    "value": "Professor Sherman seems to think it's going to get worse before it gets any better.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ioi3ht_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "You'd do well to listen to her. She's the smartest bot in town.",
  },
  {
    "key": "blueprint_vendor_02.conversation_5oey6i_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I'm starting to think the mayor isn't coming back to his office.",
  },
  {
    "key": "blueprint_vendor_02.conversation_xoknkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed format from laugh to singsong",
    "value": "{format singsong}Oh!{format reset} Is that... a pressure grenade launcher? Oh yeah, the deluxe model, too!",
  },
  {
    "key": "blueprint_vendor_02.conversation_uhq93q_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Are you... a bomb aficionado like me, friend?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8o8ba8_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I have to show you my secret project! Ooh, I've been {format nervous}bursting{format reset} to share this with a true blasthead!",
  },
  {
    "key": "blueprint_vendor_02.conversation_ux8mwy_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed format from highligh to emph",
    "value": "With my patent-pending upgrade, your launcher can deliver {format emph}three times more destruction{format reset} than before!",
  },
  {
    "key": "blueprint_vendor_02.conversation_4urlt2_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I'd let you take it for a field test, but... {format singsong}weeeelllll{format reset}... my R&D budget has been somewhat strained lately.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uxln27_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Perhaps if you were to contribute, say, \${var pricelist_next:blueprint_vendor_02}{image money_small}, I could promise you an exclusive, backer-only {format highlight}blueprint{format reset} of my invention. How about it?",
  },
  {
    "key": "blueprint_vendor_02.conversation_dgw94e_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "By the way, have you given that donation any more thought? Only \${var pricelist_next:blueprint_vendor_02}{image money_small} for a first crack at this exclusive {format highlight}blueprint{format reset}!",
  },
  {
    "key": "blueprint_vendor_02.conversation_20o2j5_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* split this line up",
    "value": "Wonderful, friend! Here, it's all yours!",
  },
  {
    "key": "blueprint_vendor_02.conversation_52n8bq_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "You will have to use it by the workbench to modify that cannon of yours.",
  },
  {
    "key": "blueprint_vendor_02.conversation_9p7l5p_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "What are you waiting for? Go and blow something to smithereens!",
  },
  {
    "key": "blueprint_vendor_02.conversation_gui6im_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Looks like your money is a bit tight too, friend. But don't worry! Just come see me when you've got money to spare.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ijkhew_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "I understand, friend! Come by anytime if you change your mind.",
  },
  {
    "key": "blueprint_vendor_02.conversation_02qawb_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "How's that blueprint treating you? Found anything interesting to blow up yet?",
  },
  {
    "key": "blueprint_vendor_03.conversation_1hq43e_text",
    "notes": "Speaker=Ty Nuzak Notes=This Character is a mail man/pony express person.",
    "value": "Hey there, pardner. With these quakes, delivering mail in a timely manner has become rather perilous.",
  },
  {
    "key": "blueprint_vendor_03.conversation_k6q6hf_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "I heard from one of our riders that there are sink holes opening up in the desert.",
  },
  {
    "key": "blueprint_vendor_03.conversation_ple2sp_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "The desert's not safe for the express riders anymore.",
  },
  {
    "key": "blueprint_vendor_03.conversation_dum6i9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Can't really help you with any deliveries at this moment, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qy63x4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "All our riders are out on deliveries, the poor saps.",
  },
  {
    "key": "blueprint_vendor_03.conversation_4nc6nw_text",
    "notes": "Speaker=Dorothy",
    "value": "Why aren't you out there with the rest of them?",
  },
  {
    "key": "blueprint_vendor_03.conversation_aozfk3_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "There's nothing as {format nervous}claustrophobic{format reset} as the wide open plains. Just miles and miles of nothing.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opkpi5_text",
    "notes": "Speaker=Ty Nuzak Notes=*format*",
    "value": "I feel boxed in just thinking about it.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opmgdu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "There's really nothing as terrifying as the wide open plains, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_384qc9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Our ponies have been all over the desert. Them tremors have been felt far and wide, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_c3vack_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "These darn quakes spell trouble for all the little hamlets out beyond the old temples.",
  },
  {
    "key": "blueprint_vendor_03.conversation_alusmw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "We're even having issues getting imported ore back here safely.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5nkkkg_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "A lot of the business in this city is built on imported wares from all over the plains.",
  },
  {
    "key": "blueprint_vendor_03.conversation_1u0u2r_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "The Steam Pony Express is usually the best way of getting it all here. ",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ufqac_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "The Steam Pony Express has a reputation to uphold. I don't want these quakes to tarnish it, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_7idj7v_text",
    "notes": "Speaker=Dorothy",
    "value": "Have any of your ponies ever been out to the temples?",
  },
  {
    "key": "blueprint_vendor_03.conversation_vfl4c6_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to Ron",
    "value": "Funny you'd ask, pardner. We had a priority delivery out to the eastern temple just the other month.",
  },
  {
    "key": "blueprint_vendor_03.conversation_51nddn_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* changes to phrasing",
    "value": "We had to send someone right across the Windy Plains.",
  },
  {
    "key": "blueprint_vendor_03.conversation_hsitea_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed "pardner".",
    "value": "Only the strongest of legs will get a runner through those head winds, let me tell you.",
  },
  {
    "key": "blueprint_vendor_03.conversation_g6i2qw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    "value": "They ordered a bunch of fancy braziers and wanted them shipped pronto.",
  },
  {
    "key": "blueprint_vendor_03.conversation_j223bu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Probably for some of their weird cult related scrap.",
  },
  {
    "key": "blueprint_vendor_03.conversation_p4ogy4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Anyone wanting to cross the Windy Plains to the east will need some way to handle the headwinds, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_pgpn5x_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "I heard you've been digging real deep down now, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ir3fn_text",
    "notes": "Speaker=Dorothy",
    "value": "Yes, we're looking for my friend and he might be down there.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0q9lw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* doggone to coggone",
    "value": "Sometimes I think I'd like to get out of this coggone town and just visit new places.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0wgkw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Then I hear talk of things like dangerous jungles growing underground.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qgwwxu_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "I start to think about all the secrets and dangers that lay hidden down below.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5phwat_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "My heart starts {format nervous}a-fluttering{format reset} and I get all weak in the knees.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cp57ox_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Dangle my spurs, ain't I just the most yellow-bellied pony you've ever laid eyes on?",
  },
  {
    "key": "blueprint_vendor_03.conversation_x5lp6f_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Sometimes I wish I wasn't such a steam chicken. The world is full of things to explore and I'm here missing it.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w4by19_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "These here shakes just keep getting worse. I can feel all four of my knees knocking.",
  },
  {
    "key": "blueprint_vendor_03.conversation_d4gln9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "I'm thinking we might all need to skedaddle on to that there rocket long before soon.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w15szm_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "I don't rightly like the thought of the wide open sky all around me.",
  },
  {
    "key": "blueprint_vendor_03.conversation_jnag7u_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "But then again, if the whole planet's going to pieces, what choice do I have...",
  },
  {
    "key": "blueprint_vendor_03.conversation_oawrk7_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "I guess I'll finally be forced to get out of my comfort zone after all, pardner.",
  },
  {
    "key": "blueprint_vendor_03.conversation_e1e8ry_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "If this whole planet is going to break apart I might just have to go on an adventure after all.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cqe4nv_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Howdy, pardner! It's great having someone digging locally, what with all these quakes shaking up the place.",
  },
  {
    "key": "cultist_worship_rusty.conversation_jm66o2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "cultist_worship_rusty.conversation_igsxan_text",
    "notes": "Speaker=Dorothy",
    "value": "Is that a {format emph}statue of Rusty{format reset} you're bowing to?",
  },
  {
    "key": "cultist_worship_rusty.conversation_1voalp_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Yes... The Great Rusty is the Destroyer that was promised.",
  },
  {
    "key": "cultist_worship_rusty.conversation_pd5hzj_text",
    "notes": "Speaker=Cultist Notes=*new* removed reference to Ron and expanded the text format",
    "value": "It was foretold by our Great Prophet. He has seen the coming of {format singsong}the blessed end.{format reset} ",
  },
  {
    "key": "cultist_worship_rusty.conversation_y6xyie_text",
    "notes": "Speaker=Fen",
    "value": "You guys just find stuff to worship all over the place, don't you?",
  },
  {
    "key": "cultist_worship_rusty.conversation_e76l4q_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Guiding Light! This infidel has removed you from The Temple of Guidance!",
  },
  {
    "key": "cultist_worship_rusty.conversation_qo16zi_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "I shall sacrifice her parts in cleansing fire!",
  },
  {
    "key": "yonker_01.conversation_mdyvq0_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Hey there! Ah honestly thought {format nervous}nobody would ever find me{format reset}.",
  },
  {
    "key": "yonker_01.conversation_zcgves_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Not that Ah'm lost or anythin', but it was pretty harsh gettin' here, ya know!",
  },
  {
    "key": "yonker_01.conversation_ara3qe_text",
    "notes": "Speaker=Zebulon Yonker Notes="Feels like Ah should give..." is "Feels like I should give..."",
    "value": "Feels like Ah should give ya a little somethin' for yer trouble. All Ah really have is this here blueprint.",
  },
  {
    "key": "yonker_01.conversation_2ebftt_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Just keep in mind that enablin' this one can make yer journey {format danger}more difficult{format reset}.",
  },
  {
    "key": "yonker_01.conversation_6jeiwp_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Ya should only use it if ya want a bit more challenge!",
  },
  {
    "key": "yonker_01.conversation_pvpsai_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Don't you worry, Ah ain't lost. Ah'm just restin' a bit.",
  },
  {
    "key": "yonker_01.conversation_jbfsb5_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Mah little brother's so dumb, he sealed up the ol' transportation system.",
  },
  {
    "key": "yonker_01.conversation_rq43xc_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "He claimed it wasn't safe or somethin' like that, Ah wasn't really paying attention.",
  },
  {
    "key": "yonker_01.conversation_v4t07d_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Sometimes I think mah brother's "mayor businesses" strangle the steam to his head.",
  },
  {
    "key": "yonker_01.conversation_y4mgz6_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ah sure miss having those tubes to zip about in. Now I have to walk all the way back home.",
  },
  {
    "key": "yonker_01.conversation_9kai6i_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "These deserts are connected to some strange things, Ah tells ya.",
  },
  {
    "key": "yonker_01.conversation_1hh5hs_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ah saw them there bonkers cultists around the entrance to that ol' temple.",
  },
  {
    "key": "yonker_01.conversation_vpsiim_text",
    "notes": "Speaker=Zebulon Yonker Notes=*format*",
    "value": "Ah'm not much for their mumbo jumbo, holdin' strange masses and whatever down there.",
  },
  {
    "key": "yonker_01.conversation_efhbif_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "The mines can drive most bots bonkers if they stay down there for too long.",
  },
  {
    "key": "yonker_01.conversation_914qie_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ah think Ah'll stay just a little while longer. Hard work sure is tiresome...",
  },
  {
    "key": "yonker_02.conversation_ppa3hq_text",
    "notes": "Speaker=Luke Yonker",
    "value": "{format emph}Sheesh{format reset}, I thought you were one of them {format nervous}crazy shiners!{format reset}",
  },
  {
    "key": "yonker_02.conversation_rtaarn_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Not sure what to make of this place, it's mighty different from anythin' I've seen before.",
  },
  {
    "key": "yonker_02.conversation_rqui5d_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Sure is a comfort to meet a feller bot down this strange place!",
  },
  {
    "key": "yonker_02.conversation_xpaj1a_text",
    "notes": "Speaker=Luke Yonker Notes=Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    "value": "Take this here blueprint as thanks for keepin' me company.",
  },
  {
    "key": "yonker_02.conversation_5zxme4_text",
    "notes": "Speaker=Luke Yonker Notes=*NEW*",
    "value": "I must warn you though. Enablin' it will make your quest {format danger}more difficult{format reset}.",
  },
  {
    "key": "yonker_02.conversation_ncsd4z_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Don't use it if you're not up for a greater challenge!",
  },
  {
    "key": "yonker_02.conversation_yp736j_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Hello again, feller bot!",
  },
  {
    "key": "yonker_02.conversation_g21tdm_text",
    "notes": "Speaker=Luke Yonker",
    "value": "My brothers claim they built most of the new walls around here, but I know it ain't so.",
  },
  {
    "key": "yonker_02.conversation_iehmo4_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Sure, they helped patch 'em up here and there, but they's been here for ages.",
  },
  {
    "key": "yonker_02.conversation_aytv9n_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Those fellers are filled with so much hot air they's almost floatin'!",
  },
  {
    "key": "yonker_02.conversation_8srkg6_text",
    "notes": "Speaker=Luke Yonker",
    "value": "If there's one thing I learned, it's that there's always a way 'round these walls.",
  },
  {
    "key": "yonker_02.conversation_vb6b0a_text",
    "notes": "Speaker=Luke Yonker",
    "value": "I swear I saw some of them mushrooms migratin' just a little while ago.",
  },
  {
    "key": "yonker_02.conversation_0yu226_text",
    "notes": "Speaker=Luke Yonker",
    "value": "How long do you think it would take for them to migrate up to town?",
  },
  {
    "key": "yonker_02.conversation_onpk10_text",
    "notes": "Speaker=Luke Yonker",
    "value": "I'm just gonna enjoy this here crazy wildlife for a bit before I head back.",
  },
  {
    "key": "yonker_03.conversation_xfyeov_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Wow, I was fixin' and buildin' 'til all of a sudden I realized I'd forgot mah tools!",
  },
  {
    "key": "yonker_03.conversation_t1bq4v_text",
    "notes": "Speaker=Josh Yonker",
    "value": "If ya can keep your trap shut about it, I'll give ya this here important-lookin' paper.",
  },
  {
    "key": "yonker_03.conversation_odkj11_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "It'll make yer adventures a bit more... {format danger}challengin'{format reset}.",
  },
  {
    "key": "yonker_03.conversation_nvlvnn_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Only use it if you like laughin' in the face of danger!",
  },
  {
    "key": "yonker_03.conversation_ajyl7v_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Oh, an' no need to tell mah brothers about this, eh?",
  },
  {
    "key": "yonker_03.conversation_zdkcdy_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Glad we see things the same way!",
  },
  {
    "key": "yonker_03.conversation_wpy2vc_text",
    "notes": "Speaker=Josh Yonker",
    "value": "No need to tell mah brothers ya found me in here.",
  },
  {
    "key": "yonker_03.conversation_0fsp3k_text",
    "notes": "Speaker=Josh Yonker",
    "value": "I'm a real profes... priffes... {format emph}expert{format reset} when it comes to buildin' walls, I tells ya.",
  },
  {
    "key": "yonker_03.conversation_l2xfyd_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Now if only those shiners would be so good an' keep to their side.",
  },
  {
    "key": "yonker_03.conversation_a09h0a_text",
    "notes": "Speaker=Josh Yonker",
    "value": "I ain't got time to wander around checkin' so everything's in place.",
  },
  {
    "key": "yonker_03.conversation_sy2ct5_text",
    "notes": "Speaker=Josh Yonker",
    "value": "I haven't seen a shiner in a long time now. Before the quakes started I'd have to deal with 'em constantly.",
  },
  {
    "key": "yonker_03.conversation_w8p7tf_text",
    "notes": "Speaker=Josh Yonker",
    "value": "If mah brothers found out I walled mahself in, I'd never hear the end of it.",
  },
  {
    "key": "sign_red_rock.conversation_rbdoyh_text",
    "notes": "Speaker=Dorothy",
    "value": ""Red Rock Passage"",
  },
  {
    "key": "fen_on_rocket.conversation_jofluh_text",
    "notes": "Speaker=Fen",
    "value": "Wow! Look at that crash site. {format singsong}Glorious destruction!{format reset}",
  },
  {
    "key": "fen_on_rocket.conversation_rgfncb_text",
    "notes": "Speaker=Dorothy",
    "value": "Let's just hope the professor's making some real improvements to the new rocket back in town.",
  },
  {
    "key": "fen_on_rocket.conversation_1mx9ap_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "M-hm. Like adding lasers and stuff to it!",
  },
  {
    "key": "firetemple_boss_intro.conversation_z6izd0_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Who dares stand before the Great Prophet of the Destroyer?",
  },
  {
    "key": "firetemple_boss_intro.conversation_cu9az7_text",
    "notes": "Speaker=Fen",
    "value": "Hey, I know this guy! He's the one that brought me to the other temple!",
  },
  {
    "key": "firetemple_boss_intro.conversation_4ljao8_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Guiding Light! What are you doing with this unworthy bot in my temple?",
  },
  {
    "key": "firetemple_boss_intro.conversation_m8bbt4_text",
    "notes": "Speaker=Dorothy",
    "value": "Where is Rusty? What have you {format emph}done to him?{format reset}",
  },
  {
    "key": "firetemple_boss_intro.conversation_6jm46x_text",
    "notes": "Speaker=Great Prophet Notes=*new* moved text format to other words.",
    "value": "As I have foretold, Rusty the Destroyer will bring the {format laugh}Great Quake{format reset} and shed our mortal coil.",
  },
  {
    "key": "firetemple_boss_intro.conversation_mhn5s6_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "He granted us a doomsday device! Then he left again. For his ways are mysterious.",
  },
  {
    "key": "firetemple_boss_intro.conversation_davhio_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "firetemple_boss_intro.conversation_39dqwa_text",
    "notes": "Speaker=Dorothy",
    "value": "Then I must disable that thing!",
  },
  {
    "key": "firetemple_boss_intro.conversation_f5igne_text",
    "notes": "Speaker=Fen Notes=*format* removed one of the text formats",
    "value": "Yeah! Tell us where you've hidden the doomsday device so we can {format laugh}blow it up{format reset}!",
  },
  {
    "key": "firetemple_boss_intro.conversation_t03c7h_text",
    "notes": "Speaker=Great Prophet",
    "value": "Oh, Guiding Light, how you have fallen. I will not let you two ruin our precious apocalypse!",
  },
  {
    "key": "firetemple_boss_outro.conversation_5ppdcr_text",
    "notes": "Speaker=Great Prophet",
    "value": "{format nervous}Aaargh!{format reset} You cannot stop the coming of the {format laugh}Great Quake{format reset}.",
  },
  {
    "key": "firetemple_boss_outro.conversation_veu3hm_text",
    "notes": "Speaker=Great Prophet",
    "value": "The doomsday device is still secure. The end is {format singsong}niiiigh!{format reset}",
  },
  {
    "key": "sign_maze_01.conversation_1l6ojp_text",
    "notes": "Speaker=Dorothy Notes=There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    "value": ""Illusory wall ahead!"",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_cp9bbp_text",
    "notes": "Speaker=Fen Notes=*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    "value": "Come on, still nothing!?",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_p1i3bn_text",
    "notes": "Speaker=Dorothy Notes=*new* changed an I to a We.",
    "value": "We just have to {format highlight}light more braziers{format reset} to activate all these crystals.",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_xqev6z_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    "value": "They must be somewhere around here!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_kk5j23_text",
    "notes": "Speaker=Fen Notes=*new* changed the phrasing to be more Fen-like",
    "value": "Alright, then let's go torch them already!",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_4dihd5_text",
    "notes": "Speaker=Fen Notes=*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    "value": "Yeah, you still haven't torched all the braziers.",
  },
  {
    "key": "sign_vectron2_1.conversation_7gz2cu_text",
    "notes": "Speaker=Dorothy",
    "value": ""DEATH AHEAD!"",
  },
  {
    "key": "cultist_worship_rusty_intro.conversation_8fufl9_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Oh Great Destroyer, the end must surely be nigh!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_bj94jz_text",
    "notes": "Speaker=Fen",
    "value": "What's stopping you? Come on!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_i7wge8_text",
    "notes": "Speaker=Dorothy Notes=*new* made it clear that it's only the pipe to the oasis that is closed",
    "value": "That's strange... the tube back to The Oasis isn't working.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_t6jhkm_text",
    "notes": "Speaker=Fen Notes=*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    "value": "Fishier and fishier... Maybe the opening on that side is clogged?",
  },
  {
    "key": "hub_teleporter_blocked.conversation_kbmx5q_text",
    "notes": "Speaker=Dorothy Notes=*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    "value": "We'll just have to dig the last stretch to get back there.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_dhpyma_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to not refert to whole tube system",
    "value": "The tube back to the Oasis is still not working!",
  },
  {
    "key": "hub_teleporter_blocked.conversation_xdvi4z_text",
    "notes": "Speaker=Fen Notes=*new* added a "come on then,"",
    "value": "Come on then, let's {format highlight}find another way to The Oasis{format reset}.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_efpvk6_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "You... you came back!",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xs0zex_text",
    "notes": "Speaker=Dorothy",
    "value": "Yes, I don't know how I got out exactly, but I told you I'd be back.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_2gp05g_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "I was alone again... Stuck. I must... I must have dozed off.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_v8dyjq_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "I dreamt of... something... something I wanted to tell you about.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xvqfeq_text",
    "notes": "Speaker=Fen",
    "value": "It had to do with the quakes, the flow of power and...",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_6uvdlp_text",
    "notes": "Speaker=Fen Notes=*new* changed format from nervous to emph",
    "value": "{format emph}Dorothy!{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_x1cve3_text",
    "notes": "Speaker=Dorothy",
    "value": "What, Fen? What did you see?",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_c268na_text",
    "notes": "Speaker=Fen",
    "value": "I saw... No... I felt... I felt the presence of more doomsday devices.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_glw2u1_text",
    "notes": "Speaker=Dorothy Notes=*new* added the phrase "come on" at the start of the line.",
    "value": "Come on, we have to {format highlight}tell Rosie{format reset}. We're not rid of these earthquakes yet.",
  },
  {
    "key": "temple_generator_destroyed.conversation_vduxpt_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hehehe...{format reset} that was great!",
  },
  {
    "key": "temple_generator_destroyed.conversation_bez5tc_text",
    "notes": "Speaker=Dorothy",
    "value": "Yes, it looks pretty harmless now, doesn't it?",
  },
  {
    "key": "temple_generator_destroyed.conversation_02t7hw_text",
    "notes": "Speaker=Dorothy",
    "value": "There are steambot and Vectron parts all jumbled together in this thing.",
  },
  {
    "key": "temple_generator_destroyed.conversation_nloh4y_text",
    "notes": "Speaker=Dorothy",
    "value": "Why would Rusty build something like this? ",
  },
  {
    "key": "temple_generator_destroyed.conversation_uo5vst_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "You worry too much. Less thinking, more smashing!",
  },
  {
    "key": "temple_generator_destroyed.conversation_cqegx4_text",
    "notes": "Speaker=Dorothy",
    "value": "We should {format highlight}head back to The Oasis{format reset} and tell Rosie that the device is disabled.",
  },
  {
    "key": "last_generator_destroyed.conversation_o7pn77_text",
    "notes": "Speaker=Dorothy",
    "value": "That actually felt oddly satisfying.",
  },
  {
    "key": "last_generator_destroyed.conversation_fhtom3_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Now we're talking!",
  },
  {
    "key": "last_generator_destroyed.conversation_0j9ty2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "last_generator_destroyed.conversation_j80dt5_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Did you feel that, Fen?",
  },
  {
    "key": "last_generator_destroyed.conversation_4ctogi_text",
    "notes": "Speaker=Fen",
    "value": "Maybe, I dunno.",
  },
  {
    "key": "last_generator_destroyed.conversation_5r8xoq_text",
    "notes": "Speaker=Dorothy",
    "value": "Felt like a tremor.",
  },
  {
    "key": "last_generator_destroyed.conversation_ue7igm_text",
    "notes": "Speaker=Fen",
    "value": "Let's just go and {format highlight}trash the other devices{format reset}!",
  },
  {
    "key": "last_generator_destroyed.conversation_kx4acl_text",
    "notes": "Speaker=Dorothy",
    "value": "Another one down!",
  },
  {
    "key": "last_generator_destroyed.conversation_7knnev_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Yeah!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_7xkz1w_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "It's nice to have someone to do this with... to not be on my own when-",
  },
  {
    "key": "last_generator_destroyed.conversation_orn1ay_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Hey, that was definitely an earthquake!",
  },
  {
    "key": "last_generator_destroyed.conversation_b59rnh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Could have been a reaction to us wrecking that thing, I guess.",
  },
  {
    "key": "last_generator_destroyed.conversation_s51o2b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "{format emph}When{format reset} we find Rusty I'm going to have him explain all this!",
  },
  {
    "key": "last_generator_destroyed.conversation_lxj451_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Don't worry, I've got your back.",
  },
  {
    "key": "last_generator_destroyed.conversation_mk9qpq_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Wooh!{format reset}",
  },
  {
    "key": "last_generator_destroyed.conversation_p2ot9u_text",
    "notes": "Speaker=Dorothy",
    "value": "That's the last one.",
  },
  {
    "key": "last_generator_destroyed.conversation_xxw7zr_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Whoa, that was a big one!",
  },
  {
    "key": "last_generator_destroyed.conversation_p4nitu_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "This doesn't make any sense. I thought we'd be rid of the earthquakes now. ",
  },
  {
    "key": "last_generator_destroyed.conversation_48h46n_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, I'm sure that was the last of these devices.",
  },
  {
    "key": "last_generator_destroyed.conversation_vkntr1_text",
    "notes": "Speaker=Dorothy Notes=*format* *new*",
    "value": "I've got a bad feeling about this. There are too many unanswered questions.",
  },
  {
    "key": "last_generator_destroyed.conversation_nzra7p_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Doomsday cults and toxic jungles! And where is Rusty!?",
  },
  {
    "key": "last_generator_destroyed.conversation_3r7w00_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Sure is fishy...",
  },
  {
    "key": "last_generator_destroyed.conversation_mboiam_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Maybe it's not Rusty? Maybe Rosie's wrong...",
  },
  {
    "key": "last_generator_destroyed.conversation_iz5s2x_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Or she's not telling us everything.",
  },
  {
    "key": "last_generator_destroyed.conversation_xd4lj1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "We need get back to The Oasis and have a {format highlight}talk with Rosie{format reset}.",
  },
  {
    "key": "fen_0_brazier_lit.conversation_7k0m7s_text",
    "notes": "Speaker=Fen Notes=*new* changed this since we now have the old version of it triggered up by the first lever at the entrance to this temple",
    "value": "Another useless lever, huh?",
  },
  {
    "key": "fen_0_brazier_lit.conversation_bqsv37_text",
    "notes": "Speaker=Dorothy Notes=*new* same as above",
    "value": "I guess I just have to {format highlight}power this thing up{format reset} too.",
  },
  {
    "key": "fen_0_brazier_lit.conversation_rzhlfx_text",
    "notes": "Speaker=Dorothy",
    "value": "Still nothing!",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_1l90nu_text",
    "notes": "Speaker=Fen",
    "value": "This brazier might do the trick.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_q9t7dt_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased it.",
    "value": "Yeah, I just have to find some way of lighting it.",
  },
  {
    "key": "fen_0_brazier_lit_b.conversation_sb7zou_text",
    "notes": "Speaker=Fen",
    "value": "Let's get this thing {format laugh}burning{format reset} already!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_utqc5b_text",
    "notes": "Speaker=Rosie",
    "value": "You really shouldn't have come back here.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8jri1u_text",
    "notes": "Speaker=Dorothy",
    "value": "What are you doing!? Let him go, Rosie!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_q1eysc_text",
    "notes": "Speaker=Rosie Notes=*format* *new* changed "he was" to "he's"",
    "value": "Do you know how many shiners were hurt capturin' him? He's a monster!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_0g9r4c_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Now he's just a battery in my mech-suit, and I'm finally strong enough to keep your kind out!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_icw8pm_text",
    "notes": "Speaker=Dorothy Notes=*new* changed format from nervous to emph",
    "value": "You {format emph}lied{format reset} to me!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_ir71cz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "I {format emph}used{format reset} you! You're a tool! And I needed someone to disable those pesky devices.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_d3ola6_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "He built them to draw all the power from my Fusion Distillery... but no more!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_pdqri5_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "This reactor will give me what I need to control my kin... An endless supply of Moon Juice!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_rdwldu_text",
    "notes": "Speaker=Rosie",
    "value": "They will have no reason to wander off. They will stay safe and show me {format emph}the respect I deserve{format reset}.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_03yhdy_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ah, so this is what you meant when you said shiners were deranged and dangerous.",
  },
  {
    "key": "rosie_boss_intro_03.conversation_hj0t32_text",
    "notes": "Speaker=invisible_dummy_01 Notes=*new* removed a couple of format tags and just enclosed the whole line",
    "value": "{format nervous}The earthquakes... The reactor is unstable Vectron tech{format reset}...",
  },
  {
    "key": "rosie_boss_intro_03.conversation_jndfz3_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}NO, YOU'RE UNSTABLE! I'M FINALLY IN CONTROL!{format reset}",
  },
  {
    "key": "rosie_boss_intro_03.conversation_18qzvo_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "You're insane!",
  },
  {
    "key": "rosie_boss_intro_03.conversation_8q2tds_text",
    "notes": "Speaker=Rosie Notes=*new* changed format from nervous to laugh",
    "value": "{format laugh}ENOUGH OF THIS!{format reset}",
  },
  {
    "key": "rosie_boss_intro_02.conversation_iot2uu_text",
    "notes": "Speaker=invisible_dummy_01",
    "value": "{format nervous}D... Dot?{format reset}",
  },
  {
    "key": "hub_guard_2.conversation_rtuuk8_text",
    "notes": "Speaker=hub_guard_2",
    "value": "Huh?",
  },
  {
    "key": "hub_guard_2.conversation_4hbzdf_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hi, what are you up to over here?",
  },
  {
    "key": "hub_guard_2.conversation_n15uxu_text",
    "notes": "Speaker=hub_guard_2",
    "value": "Goaan yargh! Git!",
  },
  {
    "key": "run_away_with_rusty_2.conversation_ciyvzv_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}The reactor... It's going to blow!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_8qc79q_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}The quakes will destroy everything...{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_118c4u_text",
    "notes": "Speaker=Rusty",
    "value": "{format nervous}You must get out of here!{format reset}",
  },
  {
    "key": "run_away_with_rusty_2.conversation_qm6zc7_text",
    "notes": "Speaker=Dorothy",
    "value": "Scrap that! We'll {format emph}make it out together!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_7421mi_text",
    "notes": "Speaker=Dorothy",
    "value": "No way! I'm not leaving you down here!",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_90knk7_text",
    "notes": "Speaker=Dorothy",
    "value": "You can't go through this thing with us...",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_0kxcna_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "There's no time to argue. There is no other way. You two get in here.",
  },
  {
    "key": "enter_endgame_teleporter_2.conversation_cd5m29_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Now!",
  },
  {
    "key": "buddy_everyone_left.conversation_ebuimt_text",
    "notes": "Speaker=Dorothy Notes=*new* changed phrasing",
    "value": "Where's everyone gone?",
  },
  {
    "key": "buddy_everyone_left.conversation_nr0trv_text",
    "notes": "Speaker=Fen",
    "value": "Hm... this is {format nervous}creeping me out.{format reset}",
  },
  {
    "key": "buddy_everyone_left.conversation_5r1v5j_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "We have to {format highlight}find Rosie{format reset} and see what she's been up to.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_17f2xe_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Woah! This must be the doomsday device.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_jiz6v8_text",
    "notes": "Speaker=Dorothy",
    "value": "I really didn't want to believe Rusty could do something like this...",
  },
  {
    "key": "buddy_first_generator_seen.conversation_nkppty_text",
    "notes": "Speaker=Fen",
    "value": "Seems to be a lot of Vectron parts in that thing.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_5mvh1h_text",
    "notes": "Speaker=Fen",
    "value": "Let's smash it! {format laugh}Wooh!{format reset}",
  },
  {
    "key": "buddy_first_generator_seen.conversation_t5tmkl_text",
    "notes": "Speaker=Dorothy",
    "value": "Wow! What is this thing?",
  },
  {
    "key": "buddy_first_generator_seen.conversation_96wcqq_text",
    "notes": "Speaker=Fen",
    "value": "Looks like Vectron technology.",
  },
  {
    "key": "buddy_first_generator_seen.conversation_3ss3dz_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Let's smash it!",
  },
  {
    "key": "player_oasis_locked.conversation_4kheve_text",
    "notes": "Speaker=Dorothy",
    "value": "The entrance is blocked!",
  },
  {
    "key": "player_oasis_locked.conversation_ruxx9o_text",
    "notes": "Speaker=Fen",
    "value": "Yeah, you think the earthquakes did this?",
  },
  {
    "key": "player_oasis_locked.conversation_cct3lh_text",
    "notes": "Speaker=Dorothy",
    "value": "We need to {format highlight}find another way in there{format reset} and talk to Rosie.",
  },
  {
    "key": "cutscene_fen_04.conversation_s6wiy7_text",
    "notes": "Speaker=Fen",
    "value": "What, and float around here all bored and alone?",
  },
  {
    "key": "cutscene_fen_04.conversation_qzc1ay_text",
    "notes": "Speaker=Fen",
    "value": "Your furnace is warm and comfy, and pestering you is fun. {format laugh}Hehehe!{format reset}",
  },
  {
    "key": "cutscene_fen_04.conversation_ruux6m_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Darnit!{format reset} I don't have time for this, I need to {format highlight}get out{format reset} of here!",
  },
  {
    "key": "cutscene_fen_04.conversation_34h62o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hehehe!{format reset} Sounds like you need my help after all...",
  },
  {
    "key": "cutscene_fen_04.conversation_de9yap_text",
    "notes": "Speaker=Fen",
    "value": "I've already scanned this area, and I {format emph}guess{format reset} I can let you use my map.",
  },
  {
    "key": "cutscene_fen_04.conversation_wk05yo_text",
    "notes": "Speaker=Fen",
    "value": "Now let's get out of this place!",
  },
  {
    "key": "cutscene_fen_04.conversation_h6d5t0_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Sigh! Well alright, come on then.",
  },
  {
    "key": "fen_haspants.conversation_a9gtqb_text",
    "notes": "Speaker=Fen",
    "value": "Hey! What's that freaky mutant thing doing here?",
  },
  {
    "key": "fen_haspants.conversation_hsioxg_text",
    "notes": "Speaker=Dorothy",
    "value": "That's a shiner, Fen. Now be quiet, it's sleeping.",
  },
  {
    "key": "crab.conversation_cl8j2w_text",
    "notes": "Speaker=Handy Gabby Notes=*new*",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_erniqz_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Crab is a hideously mutated Shiner. Look like Crab. Talk like people.",
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "crab.conversation_hgy6ga_text",
    "notes": "Speaker=Dorothy",
    "value": "Excuse me, I just-",
  },
  {
    "key": "crab.conversation_xsba9s_text",
    "notes": "Speaker=Handy Gabby Notes=*format* Speaks jibberish and half sentences.",
    "value": "Mah rocks, baglurb!",
  },
  {
    "key": "crab.conversation_eottc5_text",
    "notes": "Speaker=Dorothy",
    "value": "Er.. Okay...",
  },
  {
    "key": "crab.conversation_tolx3y_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_cmj0mp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "crab.conversation_kqftzz_text",
    "notes": "Speaker=Dorothy Notes=*new* added a introductory line for dorothy",
    "value": "Hey, how did you make it all the way down here?",
  },
  {
    "key": "crab.conversation_x2c4hn_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Bagarbagarglagurd!",
  },
  {
    "key": "crab.conversation_1d144p_text",
    "notes": "Speaker=Dorothy",
    "value": "I'm sorry, but-",
  },
  {
    "key": "crab.conversation_opes3o_text",
    "notes": "Speaker=Handy Gabby Notes=*format*",
    "value": "Mah pipes, baglurb!",
  },
  {
    "key": "crab.conversation_kzffu7_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Okay, but It's not really safe down here. You should try to find a better place to hang around.",
  },
  {
    "key": "crab.conversation_514n8o_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb!",
  },
  {
    "key": "crab.conversation_rjibkc_text",
    "notes": "Speaker=Dorothy",
    "value": "Alright, alright. ",
  },
  {
    "key": "crab.conversation_q4yhzp_text",
    "notes": "Speaker=Handy Gabby",
    "value": "Baglarb.",
  },
  {
    "key": "swimmer.conversation_mo6w8t_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Imma take a bath. 'Bout time too. I smell.",
  },
  {
    "key": "swimmer.conversation_i5u7gc_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "An' I like makin' {format singsong}bubbly bubbles.{format reset}",
  },
  {
    "key": "swimmer.conversation_h9b611_text",
    "notes": "Speaker=Dorothy",
    "value": "This place sure is something.",
  },
  {
    "key": "swimmer.conversation_7u1oej_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Rosie built it. She used to be all wimpy when she was youngerer.",
  },
  {
    "key": "swimmer.conversation_d9pcrg_text",
    "notes": "Speaker=Wet Willy",
    "value": "Now she's big an' strong and gots all this Moon Juice for us.",
  },
  {
    "key": "swimmer.conversation_5hc8jc_text",
    "notes": "Speaker=Wet Willy Notes=*format* *new* broke this up into two lines",
    "value": "I just wanna jump right in! It'll make {format emph}me{format reset} strong too.",
  },
  {
    "key": "swimmer.conversation_dqkik7_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "Rosie don't ever touch the stuff though. She just lifts heavy things instead. Silly!",
  },
  {
    "key": "swimmer.conversation_jra7p9_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "I want me some Moon Juice!",
  },
  {
    "key": "swimmer.conversation_0ga9xz_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "I like this place, but the tunnels out there are callin' me...",
  },
  {
    "key": "swimmer.conversation_6i3ly8_text",
    "notes": "Speaker=Wet Willy",
    "value": "Hollerin' with their shaky shakes.",
  },
  {
    "key": "swimmer.conversation_l4t4ta_text",
    "notes": "Speaker=Wet Willy",
    "value": "Imma miss swimmin' in Moon Juice.",
  },
  {
    "key": "swimmer.conversation_brmgbs_text",
    "notes": "Speaker=Wet Willy Notes=*format*",
    "value": "It's thick and sludgy, but imma make me some bubbles anyways.",
  },
  {
    "key": "swimmer.conversation_iyntgs_text",
    "notes": "Speaker=Wet Willy",
    "value": "Those tunnels just keep callin' on me!",
  },
  {
    "key": "swimmer.conversation_rb7d43_text",
    "notes": "Speaker=Wet Willy",
    "value": "Have you seen them critters out in the tunnels?",
  },
  {
    "key": "swimmer.conversation_s21hym_text",
    "notes": "Speaker=Wet Willy",
    "value": "Those critters make great fritters!",
  },
  {
    "key": "swimmer.conversation_ky29gq_text",
    "notes": "Speaker=Wet Willy",
    "value": "Fry 'em up, {format singsong}drenched in Moon Juice.{format reset}",
  },
  {
    "key": "swimmer.conversation_7w4sjb_text",
    "notes": "Speaker=Wet Willy Notes=*new*",
    "value": "We'll have ourself a great big 'ol bar-B-Q!",
  },
  {
    "key": "swimmer.conversation_4b9cj5_text",
    "notes": "Speaker=Wet Willy",
    "value": "Mm, I like me some fritter-critters.",
  },
  {
    "key": "swimmer.conversation_ofc7fu_text",
    "notes": "Speaker=Wet Willy",
    "value": "Moon Juice make me strong! Make me betterer.",
  },
  {
    "key": "swimmer.conversation_l41o8r_text",
    "notes": "Speaker=Wet Willy",
    "value": "I could use a third leg.",
  },
  {
    "key": "generator_sequence_break.conversation_hu136t_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Wooh!{format reset} {format singsong}Random destruction!{format reset}",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_sfe0sl_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_fjpwyo_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen... I'll come back for you!",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_va1y6u_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "I know you will.",
  },
  {
    "key": "enter_endgame_teleporter_3.conversation_5idlry_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Now go!",
  },
  {
    "key": "sign_vectron2_2.conversation_x36dp8_text",
    "notes": "Speaker=Dorothy",
    "value": ""WARNING: DO NOT ENTER!"",
  },
  {
    "key": "golden_hatch_open.conversation_p6icsu_text",
    "notes": "Speaker=Fen Notes=*new* chenged this to not be a quesetion",
    "value": "These cultists are all insane.",
  },
  {
    "key": "golden_hatch_open.conversation_rm0amb_text",
    "notes": "Speaker=Dorothy",
    "value": "Yeah, pretty much.",
  },
  {
    "key": "golden_hatch_open.conversation_4rm6n6_text",
    "notes": "Speaker=Fen",
    "value": "Well, I do miss zapping them. Let's go in there and see if we can find some more!",
  },
  {
    "key": "golden_hatch_open.conversation_5q7isk_text",
    "notes": "Speaker=Dorothy",
    "value": "I want to {format highlight}find that prophet{format reset} of theirs. He might know where Rusty is.",
  },
  {
    "key": "player_oasis_locked_2.conversation_jd7aed_text",
    "notes": "Speaker=Fen",
    "value": "There are a lot of pipes around here. Maybe we can get in through the drains?",
  },
  {
    "key": "player_oasis_locked_2.conversation_5wy6ob_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "I have a suspicious feeling that we'll find the other end of these pipes in the underground jungle.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_444mtr_text",
    "notes": "Speaker=Fen",
    "value": "Hey, look at this leaky thing! What do you think this is for?",
  },
  {
    "key": "fen_entering_yarrow2.conversation_9gicpx_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "I don't know, but it doesn't look very nice.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_h3f7cn_text",
    "notes": "Speaker=Fen",
    "value": "Could be some sort of waste system for those earthquake generators.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_jf4lyk_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Whatever's going on, this strange jungle seems to be spreading.",
  },
  {
    "key": "fen_entering_yarrow2.conversation_tkhd41_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Come on then, let's go find that device and wreck it!",
  },
  {
    "key": "fen_treasure_brazier.conversation_uo28un_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "Hm, more of these crystals. I didn't see any braziers nearby.",
  },
  {
    "key": "fen_treasure_brazier.conversation_orh8x3_text",
    "notes": "Speaker=Dorothy Notes=*new* this whole conversation is new",
    "value": "They must be somewhere inside this dang temple!",
  },
  {
    "key": "fen_treasure_brazier.conversation_fytrwl_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "But the doomsday device is not in there. I want to go destroy that thing {format emph}now!{format reset}",
  },
  {
    "key": "fen_treasure_brazier.conversation_w7ohum_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "Yeah, you still haven't found all the braziers.",
  },
  {
    "key": "fen_treasure_brazier.conversation_r9v53t_text",
    "notes": "Speaker=Fen Notes=*new* this whole conversation is new",
    "value": "And I want to destroy the doomsday device now.",
  },
  {
    "key": "sign_rons_chamber.conversation_ubahwy_text",
    "notes": "Speaker=Dorothy Notes=*new* added new sign. Operating Acolytes is a referenece to Operating Thetan from Scientology",
    "value": ""Ronald's Treasure Chamber. Only Operating Acolytes of level VI or higher may enter."",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_y2rvga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "The gate's not moving. This lever is useless.",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_voevwm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Maybe I just need to {format highlight}power it up{format reset} somehow?",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_29icwu_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Still useless!",
  },
  {
    "key": "fen_entrance_brazier_not_lit.conversation_86fd8m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I still think I need to {format highlight}power it up{format reset}.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_one4s1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey, that new armor is pretty sweet. Now you don't have to complain about getting smashed and stuff.",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_i2p8ul_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I don't think we can be completely careless, but yeah, it does look really cool, doesn't it?",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_6i6u7w_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "You know what would make it look even cooler..? ",
  },
  {
    "key": "fen_on_armor_upgrade.conversation_716uhd_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "{format singsong}Flames!{format reset}",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_mg2reo_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Whoa! I think that machine just turned my jet engine into a weapon.",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_3ldyrw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Sweet! Let's go scorch some of this mutated plant life then!",
  },
  {
    "key": "fen_on_ramjet_upgrade.conversation_gbh1g1_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hopefully it will be effective on dirt too. We seem to be buried down here!",
  },
  {
    "key": "fen_on_death_pit.conversation_tvs6ch_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey, there's probably nothing dangerous down there right? Looks safe enough to me.",
  },
  {
    "key": "fen_on_death_pit.conversation_5oflga_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Why don't we just smash that wall and see what's down there? {format laugh}Hehehe!{format reset}",
  },
  {
    "key": "fen_on_death_pit.conversation_6nymg5_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I'm thinking this place has been walled up for a reason.",
  },
  {
    "key": "fen_on_death_pit.conversation_a8vok3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "And you're not the one that will be smashed to bits when we hit the bottom.",
  },
  {
    "key": "fen_on_death_pit.conversation_pi5rzp_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Aw, where's your sense of adventure?",
  },
  {
    "key": "fen_on_lava_sea.conversation_2h7zkh_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "That's {format emph}one big pool{format reset} of molten minerals!",
  },
  {
    "key": "fen_on_lava_sea.conversation_tw04k8_text",
    "notes": "Speaker=Dorothy Notes=*new* These -> This",
    "value": "This cult is really into this whole fire and doom stuff. I can't cross that thing without melting.",
  },
  {
    "key": "fen_on_lava_sea.conversation_c0o17p_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Maybe if you just dip your foot in and see. It might not be {format emph}that{format reset} hot.",
  },
  {
    "key": "fen_on_lava_sea.conversation_651wxm_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I'd have to be fireproof!",
  },
  {
    "key": "fen_on_lava_sea.conversation_1hn8s0_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Or if you were as cool as me, you could just fly across it.",
  },
  {
    "key": "fen_on_hubtube.conversation_8yyuh8_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "That bad feeling I got is still hanging around. Something is definitely not right.",
  },
  {
    "key": "fen_on_hubtube.conversation_jytjex_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Rosie's got a lot of explaining to do once we get back to the Oasis.",
  },
  {
    "key": "fen_on_hubtube.conversation_g4kaqx_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I should have been more suspicious from the start!",
  },
  {
    "key": "fen_on_hubtube.conversation_vigvfw_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "If you were more suspicious then I'd probably still be alone in that temple.",
  },
  {
    "key": "fen_on_hubtube.conversation_2h3jtj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Now let's get out of this drain and see what's going on.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_w0gsxo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey! Those rockets look just like the ones we saw on our way here.",
  },
  {
    "key": "buddy_rosie_boss_fight_help.conversation_n0y3vf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Try bashing them em with your pickaxe!",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_nctmv1_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "I never thought I'd be coming back to this temple again.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_77tocr_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "This place is a lot bigger than just the part up there.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_jpag4c_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "I just hung out in the totem, so I never got to enter this area.",
  },
  {
    "key": "fen_on_temple_of_guidance_2.conversation_rzcgxv_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "It should be filled with deadly traps and cool things like that.",
  },
  {
    "key": "aftermath_elmachino.conversation_hbejz0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "{format nervous}Gah!{format reset} Get out of the way! Mayors and childbots first!",
  },
  {
    "key": "aftermath_elmachino.conversation_ma479g_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}I'm sorry! Um... I'm going as fast as I can!{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_fudqd9_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Calm down, folks! One at a time! Form an orderly line now, you hear!",
  },
  {
    "key": "aftermath_elmachino.conversation_pox4ng_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Hey! We ain't got time for lines! Just get on into the rocket before this whole place collapses on us!",
  },
  {
    "key": "aftermath_elmachino.conversation_ewm51b_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Bolt your jaw son! We've still got bots down in the darn mine. We can't just leave folk behind!",
  },
  {
    "key": "aftermath_elmachino.conversation_tdyz6x_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Mr. Heisenberg is ready to ignite the rocket, but I can hold the launch for a minute or two... Then we {format emph}have to blast off{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_vtsrcc_text",
    "notes": "Speaker=Barnacle Jones? Notes=*new*",
    "value": "{format nervous}Beep boop{format reset} baglarb!",
  },
  {
    "key": "aftermath_elmachino.conversation_9s60lp_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Yeah! You said it, Mr. Barnacle!",
  },
  {
    "key": "aftermath_elmachino.conversation_qo44wn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "What? I ain't said nothing.",
  },
  {
    "key": "aftermath_elmachino.conversation_353gqh_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "{format nervous}What in tarnation!?{format reset}",
  },
  {
    "key": "aftermath_elmachino.conversation_1engeq_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Oh, there you are, dearie! Thank goodness you're safe!",
  },
  {
    "key": "aftermath_elmachino.conversation_ch1z21_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Good show! I was worried that you'd got yourself lost.",
  },
  {
    "key": "aftermath_elmachino.conversation_tb8wpb_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "I see you found that red-scarfed miner. But where's that glowing little friend of yours?",
  },
  {
    "key": "aftermath_elmachino.conversation_pbnvye_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "It... it's a long story. I have to-",
  },
  {
    "key": "aftermath_elmachino.conversation_u2fefz_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Well, I am happy to see you safe and sound, but I must stress that we really are {format emph}out of time{format reset}.",
  },
  {
    "key": "aftermath_elmachino.conversation_hi1tn7_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Everyone aboard the rocket!",
  },
  {
    "key": "aftermath_elmachino.conversation_t4edhq_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Time for some steambot space adventures! {format singsong}Yeehaw!{format reset}",
  },
  {
    "key": "guard_open_hatch_post.conversation_as8gn2_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Just one last thing, miss.",
  },
  {
    "key": "guard_open_hatch_post.conversation_3qlskx_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "You're 'bout to explore a large and hazardous world down there...",
  },
  {
    "key": "guard_open_hatch_post.conversation_24mz6s_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "If you'd like to keep track of where you're heading, you can use these markers on your map ({image quest_pointer_arrow} and {image quest_pointer_crosshair}).",
  },
  {
    "key": "guard_open_hatch_post.conversation_4j1s12_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "I reckon that's the sign of a wise bot.",
  },
  {
    "key": "guard_open_hatch_post.conversation_mdsij3_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "I reckon that's quite brave.",
  },
  {
    "key": "guard_open_hatch_post.conversation_vaf0gm_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "You may have noticed some blue arrows ({image quest_pointer_arrow}) and crosshairs ({image quest_pointer_crosshair}) on your map.",
  },
  {
    "key": "guard_open_hatch_post.conversation_4zvbgq_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Not using markers could be called a more "classic" experience, I reckon. Whether that's a good thing or not...",
  },
  {
    "key": "guard_open_hatch_post.conversation_9ah4fv_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Now don't you fret. You can always toggle the markers on or off, using the Cog Mods tab up at the workbench.",
  },
  {
    "key": "guard_open_hatch_post.conversation_rkswy7_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "So what do you say? You reckon you'd like to use markers ({image quest_pointer_arrow} and {image quest_pointer_crosshair}) to show the way?",
  },
  {
    "key": "guard_open_hatch_post.conversation_w3uj01_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Like I said before...",
  },
  {
    "key": "guard_open_hatch_post.conversation_bw07t1_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "If you want to, you can always toggle the markers on or off at the workbench up in town.",
  },
  {
    "key": "guard_open_hatch_post.conversation_dvacv4_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Now, I won't keep you any longer. Good luck {format highlight}clearing the tubes out{format reset} in Red Rock Passage.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_wamta4_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Hey, this looks like Vectron technology!",
  },
  {
    "key": "fen_on_teleporter_2.conversation_lkvb6m_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "It doesn't seem to be working though.",
  },
  {
    "key": "fen_on_teleporter_2.conversation_ocl1pj_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_llzd7n_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Fen?",
  },
  {
    "key": "fen_on_teleporter_2.conversation_74v2pp_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "fen_on_teleporter_2.conversation_hi83wt_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Seems like a dead-end anyway. Let's get out of here.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_u4cd0d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "What is it, Fen?",
  },
  {
    "key": "fen_on_teleporter_1.conversation_3rpf0f_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "I don't want to go in {format emph}there{format reset}. Let's turn around.",
  },
  {
    "key": "fen_on_teleporter_1.conversation_supvbe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "There's lots of other stuff to do out in the mines.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_tm3xhy_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "This pool of molten minerals again, huh?",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_35yo2u_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "I think we {format emph}have{format reset} to get across it this time.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_mhir26_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Good thing you're almost as cool as me now then...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_fnd2g3_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Almost.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b0opbb_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "That's {format emph}one big pool{format reset} of molten minerals!",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_17hzlg_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "The cult is really into this whole fire and doom stuff.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_b7hr8v_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Let's just cross this thing already.",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_alk15j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Right! You know, with all this new gear you're almost as cool as me...",
  },
  {
    "key": "fen_on_lava_sea_2.conversation_qa992m_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Almost.",
  },
  {
    "key": "fen_on_totem.conversation_2ou9oe_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Hey look! It's the remains of my old totem.",
  },
  {
    "key": "fen_on_totem.conversation_wz87u3_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Feels like ages ago since we first met here, don't it?",
  },
  {
    "key": "fen_on_totem.conversation_qxncbz_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Yeah... Can't say that I miss being stuck in {format emph}there.{format reset}",
  },
  {
    "key": "fen_on_totem.conversation_rvd9qx_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Zapping cultists was fun and all, but it was mostly just sitting around on my own.",
  },
  {
    "key": "fen_on_distillery_door.conversation_flred4_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "This thing is looking really ominous when it's open.",
  },
  {
    "key": "fen_on_distillery_door.conversation_z5ls33_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Are you sure we need to go in there?",
  },
  {
    "key": "fen_on_distillery_door.conversation_n7df2r_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Okay. Let's see what that big shiner's got cooking in here.",
  },
  {
    "key": "fen_on_distillery_door.conversation_viru7l_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "We don't know what Rosie's been up to in there. Maybe we should prepare a bit before going in?",
  },
  {
    "key": "sign_trials_all_upgrades.conversation_tkltgz_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""All Upgrades allowed."",
  },
  {
    "key": "sign_trials_bedrock.conversation_40ih51_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""Facades and Illusions."",
  },
  {
    "key": "sign_trials_no_hook.conversation_m31axp_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": ""No Hook Shot allowed."",
  },
  {
    "key": "sign_trials_no_hook_jetpack.conversation_cbb9jh_text",
