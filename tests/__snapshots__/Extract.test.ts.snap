  {
    "key": "generic.notification_saving_settings",
    "notes": " *DEMO* Screen prompt telling the player that the settings are being saved.",
    "value": "Saving Settings...",
  },
  {
    "key": "generic.notification_saving_settings_failed",
    "notes": " Screen prompt shown if saving settings failed. Normally not encountered.",
