  {
    "key": "resources.resource_description_value",
    "notes": " A paragraph in resource descriptions, stating its individual value. %1% is the value.",
    "value": "Valore individuale $%1%{image money_small}.",
  },
  {
    "key": "resources.resource_trashium",
    "notes": "*DEMO*",
    "value": "Rifiutonio",
  },
  {
    "key": "resources.resource_trashium_desc",
    "value": "In parole povere, parti di metallo di scarto saldate insieme dalla forza della natura.",
  },
  {
    "key": "resources.resource_copper",
    "value": "Rame",
  },
  {
    "key": "resources.resource_copper_desc",
    "value": "La grande forza del rame e la sua bassa resistenza ne fanno un conduttore elettrico efficace e affidabile.",
  },
  {
    "key": "resources.resource_cinnabar",
    "value": "Cinabro",
  },
  {
    "key": "resources.resource_cinnabar_desc",
    "notes": "Vermillion is a scarlet pigment made of Cinnabar, expression "you look like a million dollars"",
    "value": "Solfuro di mercurio: un minerale brillante e tossico, utilizzato nell'antichità come pigmento. Avrai l'aspetto di un Vermiglione di dollari!",
  },
  {
    "key": "resources.resource_ironium",
    "notes": "Like irony",
    "value": "Ferronico",
  },
  {
    "key": "resources.resource_ironium_desc",
    "value": "Relativamente morbido nella sua forma più pura, una volta scaldato si indurisce notevolmente.",
  },
  {
    "key": "resources.resource_cornflorium",
    "notes": "From cornflower blue, color from the flower",
    "value": "Fiordalonio",
  },
  {
    "key": "resources.resource_cornflorium_desc",
    "value": "Molto raro in natura. Particolarmente noto tra gli artigiani dei bassi Paesi Bassi, per il suo bluissimo blu.",
  },
  {
    "key": "resources.resource_obsidian",
    "notes": "Spoof on Yngwie Malmsteen - swedish famous guitarr virtuoso",
    "value": "Yngwinio",
  },
  {
    "key": "resources.resource_obsidian_desc",
    "value": "Un minerale per veri maestri, della famiglia magmatica Malmsteen.",
  },
  {
    "key": "resources.resource_silver",
    "value": "Argento",
  },
  {
    "key": "resources.resource_silver_desc",
    "notes": "Werewolves are best killed with silver",
    "value": "Un materiale che si può rivelare utile nel caso che un'orda di lupi mannari invada il tuo cortile. E prima o poi accadrà. È solo questione di tempo.",
  },
  {
    "key": "resources.resource_zoinkonium",
    "value": "Zoinkonio",
  },
  {
    "key": "resources.resource_zoinkonium_desc",
    "notes": "Spoof on video game company Zoink and their titles Zombie Vikings and Stick it to the man",
    "value": "Un leggero ma persistente odore di idromele circonda questo materiale semplice ma colorato.",
  },
  {
    "key": "resources.resource_gold",
    "value": "Oro",
  },
  {
    "key": "resources.resource_gold_desc",
    "notes": "connectors = gold are used in technology",
    "value": "Un metallo regale che lascia a scavatori e minatori un desiderio incontrollabile di trovarne di più. La scelta di investitori e connettori dal 3000 a.C.",
  },
  {
    "key": "resources.resource_lazurite",
    "value": "Lazurite",
  },
  {
    "key": "resources.resource_lazurite_desc",
    "value": "Un fragile minerale molto ricercato per il suo uso nella pittura e nelle tinture come pigmento.",
  },
  {
    "key": "resources.resource_saturnium",
    "notes": "Saturnus, god of fertility",
    "value": "Saturnio",
  },
  {
    "key": "resources.resource_saturnium_desc",
    "value": "I contadini sostenevano che avesse un impatto positivo sul raccolto, e per questo motivo veniva posizionato sui campi durante la stagione della semina.",
  },
  {
    "key": "resources.resource_plutonium",
    "value": "Plutonio",
  },
  {
    "key": "resources.resource_plutonium_desc",
    "notes": "Shiner Wars is an old conflict preceeding the game story, Pluto = disney dog",
    "value": "Un elemento chimico ampiamente usato durante la fine della Grande guerra dei Grappisti. In seguito, ha spostato l'ago della bilancia senza portare benefici a nessuno. Al contrario di quanto si crede, non deve il suo nome a un famoso cane.",
  },
  {
    "key": "resources.resource_meteorum",
    "value": "Roccia Meteorica",
  },
  {
    "key": "resources.resource_meteorum_desc",
    "notes": "Nod to Game Maniac Mansion and the antagonist Dr Fred Edison, also the game creators Gilbert and Winnick",
    "value": "Scoperta per la prima volta nei pressi di una villa all'incrocio tra Gilbert Avenue e Winnick Road.",
  },
  {
    "key": "resources.resource_unobtainium",
    "notes": "Just a spoof on the word unobtainable",
    "value": "Introvabilanio",
  },
  {
    "key": "resources.resource_unobtainium_desc",
    "value": "Nessuno si è mai illuso di poterlo trovare, e per questo non c'è alcuna informazione disponibile. Peccato.",
  },
  {
    "key": "resources.resource_darkmatter",
    "value": "Materia Oscura",
  },
  {
    "key": "resources.resource_darkmatter_desc",
    "notes": "Play with mothers comments on dating bad boys",
    "value": "La materia per cui genitori e insegnanti continuano a tormentarti. Giorni, e persino settimane passate sui libri non ti basterebbero comunque per... oh, scusa, errore mio.",
  },
  {
    "key": "resources.resource_sodium",
    "notes": "NOT CURRENTLY USED",
    "value": "Sodio",
  },
  {
    "key": "resources.resource_sodium_desc",
    "value": "Un contatto continuo con la sua polvere soffice, bianca e luminosa può causare una rapida disidratazione.",
  },
  {
    "key": "resources.resource_aluminium",
    "notes": "NOT CURRENTLY USED",
    "value": "Alluminio",
  },
  {
    "key": "resources.resource_aluminium_desc",
    "value": "Il metallo più abbondante e diffuso sul pianeta. Perfetto per creare contenitori per le comuni bevande degli umani.",
  },
  {
    "key": "resources.resource_beryl",
    "value": "Berillio",
  },
  {
    "key": "resources.resource_beryl_desc",
    "value": "Si pensa che sia capace di trasformare i sogni e i desideri in realtà, nonché di eliminare le energie negative.",
  },
  {
    "key": "resources.resource_azurite",
    "notes": "Azurite just sounds like these two expressions put together – Do as you want with this :)",
    "value": "Azzurrite",
  },
  {
    "key": "resources.resource_azurite_desc",
    "value": " La combinazione tra "azzurro" e "dermatite".",
  },
  {
    "key": "resources.resource_tremolite",
    "value": "Tremolite",
  },
  {
    "key": "resources.resource_tremolite_desc",
    "notes": "Dr Dre = music producer and rapper – Dr Tre is a made up brother to make a pun on the resource name – mole pun molite",
    "value": " Un minerale noto per le sue vibrazioni positive, le quali influenzano l'umore di chiunque si avvicini facendolo fremere di gioia per qualche secondo.",
  },
  {
    "key": "resources.resource_topaz",
    "value": "Topazio",
  },
  {
    "key": "resources.resource_topaz_desc",
    "value": "Permea l'ambiente circostante con una radiosa aura rilassante. La varietà di colore viola è estremamente rara.",
  },
  {
    "key": "resources.resource_ametrine",
    "value": "Ametrina",
  },
  {
    "key": "resources.resource_ametrine_desc",
    "notes": "The spanish queen was said to have been given an ametrine stone as gift from the first batch leaving the mines",
    "value": "Una pietra rara che si dice abbia strani poteri. Si pensa che l'esemplare più grande sia sepolto sotto la tomba di una regina spagnola.",
  },
  {
    "key": "resources.resource_diamond",
    "value": "Diamante",
  },
  {
    "key": "resources.resource_diamond_desc",
    "notes": "Margareth Thatcher was chosen for her reputation as cold hearted – feel free to exchange for other politician of your country!",
    "value": "Un grande classico, duro e freddo come un abbraccio di Margaret Thatcher. Che tu sia uomo o donna, i diamanti saranno i tuoi migliori amici, per sempre.",
  },
  {
    "key": "resources.resource_bismuth",
    "value": "Bismuto",
  },
  {
    "key": "resources.resource_bismuth_desc",
    "notes": "Bismuth sounds a bit like Bismarck, thats why the pun is on German Otto Bismarck, but if the mineral is named something else in your country, feel free to pun away :) https://en.wikipedia.org/wiki/Otto_von_Bismarck",
    "value": "Scoperto intorno al 1400 d.C. da un misterioso alchimista. Spesso confuso con il piombo o con qualche specie di animale.",
  },
  {
    "key": "resources.resource_imagenite",
    "value": "Imaginite",
  },
  {
    "key": "resources.resource_imagenite_desc",
    "notes": "A pun on song from John Lennon Imagine – imagine there's no heaven, and no religion too",
    "value": "È oggetto di un acceso dibattito tra i minatori. Esiste veramente? Imaginite there's no Heavenite, and no Religionite too.",
  },
  {
    "key": "resources.resource_amethyst",
    "notes": "NOT CURRENTLY USED",
    "value": "Ametista",
  },
  {
    "key": "resources.resource_amethyst_desc",
    "value": "La sua luce darà conforto alla tua sofferenza, stimolerà le tue emozioni e ti convincerà a tornare alla ricerca del vero amore.",
  },
  {
    "key": "resources.resource_blooddrop",
    "value": "Goccia di Sangue",
  },
  {
    "key": "resources.resource_blooddrop_desc",
    "value": "Un concentrato di rabbia eliotropica proveniente da creature della penombra.",
  },
  {
    "key": "resources.resource_bloodstone",
    "value": "Pietra di Sangue",
  },
  {
    "key": "resources.resource_bloodstone_desc",
    "value": "Questo eliotropo ripristina la lucidità mentale di chi la possiede",
  },
  {
    "key": "resources.resource_bloodrock",
    "value": "Roccia di Sangue",
  },
  {
    "key": "resources.resource_bloodrock_desc",
    "value": "Paura e cattive intenzioni coagulate. Affina i sensi ma annebbia gli occhi della mente.",
  },
  {
    "key": "resources.resource_vectron",
    "value": "Criptio n. 5-1 16.17.4.8",
