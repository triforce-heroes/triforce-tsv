exports[`extract(tests\\fixtures\\es_conversations.csv) function > matches snapshot > tests\\fixtures\\es_conversations.csv 1`] = `
[
  {
    "key": "conversation_yjp8nk_text",
    "metadata": {
      "notes": "Comes up when your inventory is full anyou try to pick up more ores.",
    },
    "value": "Oye, cabeza hueca, tu {format highlight}mochila ya está llena.{format reset}",
  },
  {
    "key": "conversation_yjp8nk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hxfr0f_text",
    "metadata": {
      "notes": "*new* added "there"",
    },
    "value": "Oye, ¿tienes por ahí algo brillante para mí?",
  },
  {
    "key": "conversation_hxfr0f_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_jh3i2m_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Ey, ¿has encontrado rocas que quieras cambiar por un poco de plata?",
  },
  {
    "key": "conversation_jh3i2m_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_69vpc2_text",
    "metadata": {
      "notes": "*new* changed doll to kiddo. Moved this node",
    },
    "value": "Bueno, ¿tienes algo valioso para mí?",
  },
  {
    "key": "conversation_69vpc2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mi3myw_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "¡Vamos! Vamos a hacer negocios tu y yo.",
  },
  {
    "key": "conversation_mi3myw_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_2l670i_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Bueno, ¿qué me has traído esta vez?",
  },
  {
    "key": "conversation_2l670i_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_89hare_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "¡Ahora enséñame lo que has encontrado allí abajo!",
  },
  {
    "key": "conversation_89hare_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dfflv5_text",
    "metadata": {
      "notes": "*new* moved this",
    },
    "value": "Todavía quiero quitarte de encima esos minerales, si es que te queda alguno.",
  },
  {
    "key": "conversation_dfflv5_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dvsj68_text",
    "value": "El alcalde Yonker es un imbécil, pero esta vez tiene razón. ¡Hay que extraer más minerales!",
  },
  {
    "key": "conversation_dvsj68_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gk3axq_text",
    "metadata": {
      "notes": "*format* Hair on steambots is made of metal.",
    },
    "value": "Dicen que está tan preocupado que se le está oxidando el cabello, ¿sabes?",
  },
  {
    "key": "conversation_gk3axq_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mosq62_text",
    "metadata": {
      "notes": "" clamps" is the equivavlent of hands, since they are robots.",
    },
    "value": "Y yo siempre estoy dispuesto a arrebatar minerales a todo minero, cueste lo que cueste.",
  },
  {
    "key": "conversation_mosq62_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_fnygz1_text",
    "metadata": {
      "notes": "*new* changed doll-face to kiddo.",
    },
    "value": "¿Sabes, renacuaja? Lo único que importa es que siga habiendo movimiento de minerales.",
  },
  {
    "key": "conversation_fnygz1_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_7dsj17_text",
    "value": "He oído que tenemos un nuevo bot trabajando en la mina.",
  },
  {
    "key": "conversation_7dsj17_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mh0ja0_text",
    "value": "En realidad, estoy buscando a un amigo mío. Es bastante tranquilo y lleva una bufanda roja.",
  },
  {
    "key": "conversation_mh0ja0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y6ys6p_text",
    "metadata": {
      "notes": "Real McCoy= the real deal.",
    },
    "value": "Conozco a ese bot. Parecía ser el mejor, pero resultó ser un chasco.",
  },
  {
    "key": "conversation_y6ys6p_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_0lzsu6_text",
    "value": "Nunca volvió a la superficie, ¿sabes?",
  },
  {
    "key": "conversation_0lzsu6_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_bhqgnn_text",
    "metadata": {
      "notes": "*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    },
    "value": "Espero que lo hagas mejor, muchacha.",
  },
  {
    "key": "conversation_bhqgnn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_21a760_text",
    "metadata": {
      "notes": "Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    },
    "value": "Por cierto, sabrás que los tubos están bloqueados.",
  },
  {
    "key": "conversation_21a760_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_oxkxen_text",
    "value": "A mí no me gusta el chismorreo, pero dicen que el alcalde los ha cerrado para vengarse de sus hermanos minerobots.",
  },
  {
    "key": "conversation_oxkxen_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_2zloko_text",
    "value": "Por cierto, no he visto a esos bobos desde hace un tiempo.",
  },
  {
    "key": "conversation_2zloko_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xwxxg4_text",
    "value": "Esperaba que comenzaran a trabajar mejor, ahora que tenían un poco de competencia.",
  },
  {
    "key": "conversation_xwxxg4_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gmenrv_text",
    "value": "Fui un tonto al creer que unos papanatas como ellos iban a estar a la altura.",
  },
  {
    "key": "conversation_gmenrv_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xkngbf_text",
    "metadata": {
      "notes": "mazumas= slang for money, please do translate.",
    },
    "value": "De todas formas, esos tubos bloqueados me están haciendo perder mucho parné.",
  },
  {
    "key": "conversation_xkngbf_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_xfxkz8_text",
    "value": "Hay muchas riquezas esperando bajo esas capas de ladrillo y cemento.",
  },
  {
    "key": "conversation_xfxkz8_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_op5xlx_text",
    "value": "Si te encuentras con algún licorero, destrózalo, o terminarás llevando un traje de madera hecho a medida.",
  },
  {
    "key": "conversation_op5xlx_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_whma58_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Me han dicho que suelen andar colocados de Fermento Lunar y que les gusta armar jaleo.",
  },
  {
    "key": "conversation_whma58_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_t5mwlu_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Adoran esa porquería. El Fermento Lunar los hace más fuertes, pero también bastante torpes.",
  },
  {
    "key": "conversation_t5mwlu_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_649tjr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Además, es muy corrosivo. Más te vale no tocarlo.",
  },
  {
    "key": "conversation_649tjr_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_03e7vh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "No sé si lo sabes, pero a esa profesora ricachona de allá arriba le faltan un par de tornillos.",
  },
  {
    "key": "conversation_03e7vh_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_u2ersk_text",
    "value": "Verás, perdió la cabeza tras uno de los primeros terremotos, cuando su casa se vino abajo.",
  },
  {
    "key": "conversation_u2ersk_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_h9iaiy_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ahora está {format emph}construyendo un cohete{format reset} con toda esa hermosa chatarra que ha heredado.",
  },
  {
    "key": "conversation_h9iaiy_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3jgp0a_text",
    "value": "He oído incluso que está en contacto con toda una red de coheteros.",
  },
  {
    "key": "conversation_3jgp0a_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_9mc50k_text",
    "value": "Están construyendo estas cosas por todo el planeta.",
  },
  {
    "key": "conversation_9mc50k_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_bsxzro_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Oye renacuaja, ¿has tenido oportunidad de registrar todas las cavernas con las que te has encontrado?",
  },
  {
    "key": "conversation_bsxzro_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_dz2y8u_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "A veces resultan más complicadas que el resto de las minas.",
  },
  {
    "key": "conversation_dz2y8u_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3g80ch_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Pero hay una alta probabilidad de que encuentres cosas más valiosas allí, ¿sabes?",
  },
  {
    "key": "conversation_3g80ch_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_nmjdda_text",
    "metadata": {
      "notes": "*new* completely changed",
    },
    "value": "Una vez hayas encontrado todos los objetos de una caverna, esta quedará marcada como {image cave_small} en el mapa para que no pierdas el tiempo excavando inútilmente.",
  },
  {
    "key": "conversation_nmjdda_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_u3ck3c_text",
    "value": "¿Quién iba a pensar que estos imbéciles sectarios tenían tantas riquezas bajo unas ruinas tan viejas?",
  },
  {
    "key": "conversation_u3ck3c_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_zh09qm_text",
    "value": "¡Debimos comenzar a excavar hace años!",
  },
  {
    "key": "conversation_zh09qm_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_g3jyqr_text",
    "metadata": {
      "notes": "*format*'",
    },
    "value": "Cierto, hay una secta de chiflados que ocupan esas ruinas. Creo que andan promulgando el fin del mundo, o algo así.",
  },
  {
    "key": "conversation_g3jyqr_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_m4g0mn_text",
    "value": "Pero esa es su fe, y yo no voy a meterme con la fe de nadie.",
  },
  {
    "key": "conversation_m4g0mn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_figdnq_text",
    "value": "¡Mira qué ciudad! La primera vez que vine era un joven ilusionado que intentaba escapar de la dura vida de peón.",
  },
  {
    "key": "conversation_figdnq_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_saxa80_text",
    "value": "En esa época la ciudad no era tan grande, pero tenía muchísimo potencial.",
  },
  {
    "key": "conversation_saxa80_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_c0haij_text",
    "value": "Logré establecer un negocio muy próspero, y lo logré porque tengo agallas.",
  },
  {
    "key": "conversation_c0haij_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_3qiyya_text",
    "metadata": {
      "notes": "*new* changed doll to kid",
    },
    "value": "Tienes que ser valiente para lanzarte a los lugares más recónditos del mundo, chiquilla.",
  },
  {
    "key": "conversation_3qiyya_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_281tok_text",
    "value": "Será arriesgado, sin duda, pero solo así conseguirás las mejores recompensas.",
  },
  {
    "key": "conversation_281tok_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_ef7tr2_text",
    "value": "He oído rumores de que en la mina crece una selva extraña y antinatural.",
  },
  {
    "key": "conversation_ef7tr2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_amxf2l_text",
    "value": "Aunque claro, eso no detendrá a alguien como tú.",
  },
  {
    "key": "conversation_amxf2l_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mp7r9y_text",
    "value": "Pero verás, me preocupa que espante a otros mineros timoratos.",
  },
  {
    "key": "conversation_mp7r9y_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_fmy8mc_text",
    "value": "La profesora ya casi tiene el cohete listo para despegar.",
  },
  {
    "key": "conversation_fmy8mc_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mxjgvx_text",
    "value": "Creí que estaba chiflada, pero comienzo a pensar que sí que le funciona el coco.",
  },
  {
    "key": "conversation_mxjgvx_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_gd4ef6_text",
    "value": "Nadie ha explorado el espacio, y está lleno de nuevas oportunidades para hacer negocios.",
  },
  {
    "key": "conversation_gd4ef6_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_wr4wq2_text",
    "metadata": {
      "notes": "*new* changed doll to kiddo",
    },
    "value": "He logrado construir una nueva vida desde cero, ¿sabes, niña?",
  },
  {
    "key": "conversation_wr4wq2_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_mkud7m_text",
    "value": "Y en todo caso, ahora estoy mucho más preparado que cuando era joven.",
  },
  {
    "key": "conversation_mkud7m_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_08cc91_text",
    "metadata": {
      "notes": "*new* moved it to the bottom",
    },
    "value": "Bueno, puedes regresar siempre que tengas minerales para vender.",
  },
  {
    "key": "conversation_08cc91_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_07qv1j_text",
    "value": "El inútil de mi hijo no tiene ni idea de lo que hace.",
  },
  {
    "key": "conversation_07qv1j_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vx6mcl_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Necesitamos gente competente allí abajo para que investiguen qué está causando los malditos terremotos!",
  },
  {
    "key": "conversation_vx6mcl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hlqiyo_text",
    "value": "Sé muy bien lo que se siente cuando las placas tectónicas se mueven. ¡Y esto no es lo mismo, te lo digo yo!",
  },
  {
    "key": "conversation_hlqiyo_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_q4ltpg_text",
    "value": "Necesitamos a alguien que tenga cerebro y ganas de meterse en esa mina.",
  },
  {
    "key": "conversation_q4ltpg_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8w93yl_text",
    "value": "Me he pasado la vida trabajando en las minas, cariño..., pero nunca sentí algo parecido a estos terremotos.",
  },
  {
    "key": "conversation_8w93yl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ibhbb2_text",
    "value": "Yo misma lo investigaría, pero mírame... Mis días de minera han pasado.",
  },
  {
    "key": "conversation_ibhbb2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ffq3ty_text",
    "value": "¿Qué te ha sucedido?",
  },
  {
    "key": "conversation_ffq3ty_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_9hmzci_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Ah! ¡¿Fuiste víctima de algún accidente en las minas?!",
  },
  {
    "key": "conversation_9hmzci_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uy4syk_text",
    "value": "No. Pero he entregado muchas partes de mi cuerpo para crear a esos condenados hijos míos. Son el peor error que he cometido...",
  },
  {
    "key": "conversation_uy4syk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_g3ij4k_text",
    "metadata": {
      "notes": "*new* changed format from emph to singsong",
    },
    "value": "{format singsong}¡Me abuurrooo!{format reset}",
  },
  {
    "key": "conversation_g3ij4k_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xxgpup_text",
    "value": "Si aún pudiera hacerlo, ¡entraría en los puñeteros túneles en un abrir y cerrar de ojos!",
  },
  {
    "key": "conversation_xxgpup_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dgq9o3_text",
    "value": "Si están pensando en bajar a esas profundidades, les recomiendo que {format highlight}reparen esa linterna{format reset}.",
  },
  {
    "key": "conversation_dgq9o3_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_o8vje6_text",
    "value": "¿Tan peligrosas son las minas?",
  },
  {
    "key": "conversation_o8vje6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0c28a8_text",
    "value": "Bueno, hay bichejos de lo más asqueroso, pero al menos no he visto a ningún maldito licorero desde hace tiempo.",
  },
  {
    "key": "conversation_0c28a8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tt1za6_text",
    "value": "Mis chicos, los mayores, han estado reparando las paredes para mantener a raya a esos trozos de carne con patas.",
  },
  {
    "key": "conversation_tt1za6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_n71xfs_text",
    "value": "Yo era apenas una niñabot cuando la guerra licorera terminó, pero aún recuerdo los peores momentos.",
  },
  {
    "key": "conversation_n71xfs_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u3tho1_text",
    "value": "De cualquier forma, lo mejor es estar bien preparado estando allá abajo, cariño.",
  },
  {
    "key": "conversation_u3tho1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8xtyi1_text",
    "value": "Puedes {format highlight}usar la mesa de trabajo{format reset} que está junto a la mina para reparar esa linterna, si es que puedes permitirte pagar las partes...",
  },
  {
    "key": "conversation_8xtyi1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_y2vq9y_text",
    "value": "¡Recórcholis! Ahora sí que parece que estás lista {format highlight}para entrar en la mina{format reset}, hermosura.",
  },
  {
    "key": "conversation_y2vq9y_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_st3zju_text",
    "value": "¿Alguien ha bajado últimamente al Pasaje?",
  },
  {
    "key": "conversation_st3zju_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0zamqc_text",
    "value": "No, cariño. Nadie ha ido ahí desde que esos estúpidos tubos se estropearon.",
  },
  {
    "key": "conversation_0zamqc_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_5atg04_text",
    "value": "Pero tendrás que pasar por ahí si quieres explorar toda la mina.",
  },
  {
    "key": "conversation_5atg04_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_caroq1_text",
    "value": "Pues creo que primero tendré que {format highlight}despejar el tubo{format reset}.",
  },
  {
    "key": "conversation_caroq1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kq5k2e_text",
    "value": "Sí, pero recuerda que la tierra se hace más dura a medida que desciendes. Debes tener tus herramientas en buen estado.",
  },
  {
    "key": "conversation_kq5k2e_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_yo8vom_text",
    "value": "La Roca Rojiza es el único camino para llegar a lo más profundo de la mina, mientras el maldito sistema de tubos esté roto.",
  },
  {
    "key": "conversation_yo8vom_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_sxlsip_text",
    "value": "Espero que pueda usar explosivos para abrir el Pasaje de la Roca Rojiza.",
  },
  {
    "key": "conversation_sxlsip_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2e9pz1_text",
    "value": "Creo que sí. Yo misma lo he hecho en varias ocasiones.",
  },
  {
    "key": "conversation_2e9pz1_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_wkl33e_text",
    "value": "Pero primero ve a la estación de bombas y {format highlight}consigue explosivos{format reset}.",
  },
  {
    "key": "conversation_wkl33e_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_xtf9h2_text",
    "value": "¿No deberíamos alegrarnos de que el pasaje siga ahí tal y como está? Me parece que no estamos asegurados contra accidentes con explosivos.",
  },
  {
    "key": "conversation_xtf9h2_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_5jzc1m_text",
    "value": "El Pasaje de la Roca Rojiza es el único camino para llegar a lo más profundo de la mina ahora que el sistema de tubos no funciona.",
  },
  {
    "key": "conversation_5jzc1m_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3vmqnk_text",
    "value": "Espero que hayas avanzado allí abajo, cariño.",
  },
  {
    "key": "conversation_3vmqnk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u6rmdw_text",
    "value": "La profesora Sherman me ha preocupado con todos estos malgranajes terremotos.",
  },
  {
    "key": "conversation_u6rmdw_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_nxlgy6_text",
    "value": "Está allí arriba gastando todo su dinero para construir ese cohete.",
  },
  {
    "key": "conversation_nxlgy6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ginz3u_text",
    "value": "Es la mar de lista. Estoy segura de que está ideando algún plan de escape.",
  },
  {
    "key": "conversation_ginz3u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jkfreb_text",
    "value": "¡Cómo quisiera que el idiota de mi hijo tuviera un poco de sentido común y escuchara lo que ella dice!",
  },
  {
    "key": "conversation_jkfreb_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3pntbk_text",
    "value": "¡Vaya, eres una verdadera minera!",
  },
  {
    "key": "conversation_3pntbk_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ebwh66_text",
    "value": "Regresa al Pasaje de la Roca Rojiza y deshazte de toda esa maldita porquería.",
  },
  {
    "key": "conversation_ebwh66_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dayt2l_text",
    "value": "¡Bastó solo una explosión para abrir la Roca Rojiza!",
  },
  {
    "key": "conversation_dayt2l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_5ji97r_text",
    "value": "Sí, a excepción de todos esos derrumbes, su construcción es muy resistente.",
  },
  {
    "key": "conversation_5ji97r_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_m6zdrd_text",
    "value": "Bueno, me alegro de que siga en pie.",
  },
  {
    "key": "conversation_m6zdrd_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_k7klvq_text",
    "value": "Necesitarás que tus herramientas estén a punto para poder abrirte camino a esas profundidades.",
  },
  {
    "key": "conversation_k7klvq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dspvhm_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Y no olvides traer más piedras preciosas!",
  },
  {
    "key": "conversation_dspvhm_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_sl7olj_text",
    "value": "Es mejor que gastes un poco de dinero para mantener tus herramientas en buen estado. Cuando estés en lugares profundos, verás cómo merece la pena.",
  },
  {
    "key": "conversation_sl7olj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x0wxp1_text",
    "value": "Necesito encontrar un camino para llegar a la estación de mampostero.",
  },
  {
    "key": "conversation_x0wxp1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_63gsgh_text",
    "value": "Ya te digo que hay muchos pasajes y grietas allá abajo.",
  },
  {
    "key": "conversation_63gsgh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_qp9quj_text",
    "value": "A mis hermanos de les da bien encontrarlas... y perderse en ellas varios días.",
  },
  {
    "key": "conversation_qp9quj_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_x7yuib_text",
    "value": "Esos licoreros grasientos también suelen entrar y sembrar el caos.",
  },
  {
    "key": "conversation_x7yuib_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hc3b2x_text",
    "value": "Explora la mina cerca de los muros licoreros. Seguro que ahí {format highlight}encuentras la estación minera{format reset}, cariño.",
  },
  {
    "key": "conversation_hc3b2x_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_gducoe_text",
    "value": "¿Te has encontrado con alguno de esos licoreros, cariño? Hace tiempo que no causan problemas.",
  },
  {
    "key": "conversation_gducoe_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_yr3kie_text",
    "value": "Me he dado cuenta de que también desaparecieron de debajo de mi pueblo, Tumbleton.",
  },
  {
    "key": "conversation_yr3kie_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_owuynx_text",
    "value": "Vaya, ¿entonces sucede lo mismo en todas partes? Hace muchos meses que no veo a ninguno.",
  },
  {
    "key": "conversation_owuynx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3h8ujv_text",
    "value": "Comenzaron a desaparecer después de que Rusty destruyera al monstruo tecnológico ese, Vectron.",
  },
  {
    "key": "conversation_3h8ujv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ezzezr_text",
    "value": "No estoy al tanto de eso, pero sí sé bastante sobre los licoreros.",
  },
  {
    "key": "conversation_ezzezr_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dpbib8_text",
    "value": "Solían aprovechar las grietas en las paredes para entrar y causarnos problemas a los mineros.",
  },
  {
    "key": "conversation_dpbib8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_3c3lpm_text",
    "value": "¿Tal vez también están preocupados por los terremotos? ¡Son como las ratas: escapan del barco cuando se está hundiendo!",
  },
  {
    "key": "conversation_3c3lpm_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tcvt6a_text",
    "value": "No sé si es buena o mala señal que los licoreros estén tan callados.",
  },
  {
    "key": "conversation_tcvt6a_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_67vh5i_text",
    "value": "¡Oye, he encontrado a los licoreros! Han construido un pueblito escondido en la mina.",
  },
  {
    "key": "conversation_67vh5i_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_iu5kqd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡¿Qué diantres? Yo me mantendría lejos de un lugar así. ¡No puede ser seguro!",
  },
  {
    "key": "conversation_iu5kqd_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vhdww6_text",
    "value": "Pues no me parecieron tan malos. Al menos no como los que he visto antes.",
  },
  {
    "key": "conversation_vhdww6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cbcmjx_text",
    "value": "¡Yo apostaría todas mis tuercas a que no puedes confiar en un licorero!",
  },
  {
    "key": "conversation_cbcmjx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_0glm7l_text",
    "value": "¡No te acerques a ese pueblo licorero si sabes lo que te conviene!",
  },
  {
    "key": "conversation_0glm7l_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_umbt7u_text",
    "value": "Excavar cerca del templo puede ser muy peligroso, pero hay muchas cosas muy valiosas por ahí.",
  },
  {
    "key": "conversation_umbt7u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_c5baff_text",
    "value": "¡Vaya, eso parece prometedor! Tienes que ir allí y averiguar un poco más.",
  },
  {
    "key": "conversation_c5baff_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_r8rlnp_text",
    "value": "¡Caramba! Hay que tener mucho valor para entrar en esas ruinas y buscar minerales valiosos. ",
  },
  {
    "key": "conversation_r8rlnp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_m8hqwy_text",
    "value": "Ni siquiera sus hermanos están los suficientemente locos para {format highlight}ir al templo{format reset} que está más allá de las Llanuras Ventosas.",
  },
  {
    "key": "conversation_m8hqwy_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_bvz9xj_text",
    "value": "Allí hay una secta apocalíptica que se ha apropiado del lugar.",
  },
  {
    "key": "conversation_bvz9xj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_fj6bw8_text",
    "value": "También se han apropiado de las ruinas que están en el desierto del oeste.",
  },
  {
    "key": "conversation_fj6bw8_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_u26tuh_text",
    "value": "Apuesto a que ese maldito viejo loco de Ronald sigue siendo el jefe. Solía ser un buen tipo, pero toda esa porquería religiosa lo ha dejado chalado.",
  },
  {
    "key": "conversation_u26tuh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_gr738j_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "El templo que está más allá de las Llanuras Ventosas está lleno de riquezas, pero es un lugar demasiado peligroso para excavar.",
  },
  {
    "key": "conversation_gr738j_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_grrmq6_text",
    "value": "Vaya, parece que estás metida hasta el cuello en tu misión, cariño.",
  },
  {
    "key": "conversation_grrmq6_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_335kyr_text",
    "value": "Allí abajo encontrarás huellas de civilizaciones antiguas, como esas viejas máquinas en las estaciones mineras.",
  },
  {
    "key": "conversation_335kyr_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_2jepw2_text",
    "value": "Han estado allí desde que tengo memoria.",
  },
  {
    "key": "conversation_2jepw2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_mv0s6q_text",
    "value": "He escuchado a algunos listobots que dicen que los licoreros construyeron todo eso.",
  },
  {
    "key": "conversation_mv0s6q_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vxki0p_text",
    "value": "Pues a mi esos listobots no me parecen tan inteligentes. Apuesto a que también se hacen llamar "expertos".",
  },
  {
    "key": "conversation_vxki0p_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ysj9vo_text",
    "value": "A mí no me gustaría arriesgarme y excavar tan profundamente en territorio licorero. ¡Quién sabe lo que te puedes encontrar allí!",
  },
  {
    "key": "conversation_ysj9vo_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_uj1muo_text",
    "value": "Aún tengo mucho que excavar si quiero detener estos terremotos.",
  },
  {
    "key": "conversation_uj1muo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ykczsp_text",
    "value": "He oído a la profesora decir que hay una selva expandiéndose por toda la mina.",
  },
  {
    "key": "conversation_ykczsp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_z8gocf_text",
    "value": "¡Maldición! ¡Eso no suena nada bien!",
  },
  {
    "key": "conversation_z8gocf_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_dzwjvq_text",
    "value": "¿Cómo pude un bot excavar entre semejantes peligros...? ¿Cómo podrán sobrevivir mis malditos hijos?",
  },
  {
    "key": "conversation_dzwjvq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x3v93r_text",
    "value": "No sé si te has dado cuenta, pero son realmente memos.",
  },
  {
    "key": "conversation_x3v93r_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jmwahi_text",
    "value": "Creo que solo nos queda buscar la manera de formar parte de la tripulación de ese cohete.",
  },
  {
    "key": "conversation_jmwahi_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8augkl_text",
    "value": "Mis hijos serán unos inútiles, pero son aceite de mi aceite.",
  },
  {
    "key": "conversation_8augkl_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_9v0sjx_text",
    "value": "¿Entonces tengo que comprar cinco pasajes para ese vuelo espacial?",
  },
  {
    "key": "conversation_9v0sjx_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_p75xau_text",
    "value": "Muchas gracias por soportar la cháchara de un viejo bot. ¡Apuesto a que tus padres están orgullosos de ti!",
  },
  {
    "key": "conversation_p75xau_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8hjn65_text",
    "value": "No eres como mis hijos. Son un montón de chatarra inservible.",
  },
  {
    "key": "conversation_8hjn65_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x6q3po_text",
    "value": "Se pasan el rato perdidos en las minas "trabajando". Y claro, luego está ese saco de fierro de ahí que se hace llamar político.",
  },
  {
    "key": "conversation_x6q3po_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8tssip_text",
    "value": "¡Me da mucho gusto saber que hay alguien en los túneles que sí sabe lo que hace!",
  },
  {
    "key": "conversation_8tssip_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_royiqq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oh, madre mía! Eso sí que ha sido un gran {format nervous}terremoto{format reset}.",
  },
  {
    "key": "conversation_royiqq_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_0z0jlu_text",
    "value": "¡Anda ¡Pareces ser un bot pueblerino como yo! {format singsong}¡Maravilloso!{format reset}",
  },
  {
    "key": "conversation_0z0jlu_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_i3c2ki_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Me he sentido muy sola últimamente. Como una auténtica forastera.",
  },
  {
    "key": "conversation_i3c2ki_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_fnv0dz_text",
    "value": "Pensé que sería sólo un olorcillo a letrina, pero no, es olor a forastera...",
  },
  {
    "key": "conversation_fnv0dz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_q58pva_text",
    "value": "Esa cosa brillante tiene razón. No estoy hecha para la vida en la gran ciudad.",
  },
  {
    "key": "conversation_q58pva_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_r68qcd_text",
    "value": "Fen, ¿no puedes ser un poco más amable por una vez? ¡A lo mejor hasta te gusta!",
  },
  {
    "key": "conversation_r68qcd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6c81lb_text",
    "value": "No lo creo.",
  },
  {
    "key": "conversation_6c81lb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qy4k1b_text",
    "value": "Creo que lo mejor es que regrese a la granja.",
  },
  {
    "key": "conversation_qy4k1b_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_q27f56_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Hola de nuevo, compañerabot pueblerina!",
  },
  {
    "key": "conversation_q27f56_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_bfqhtj_text",
    "value": "Hay muchísimas quejas sobre nuestro pobre alcalde.",
  },
  {
    "key": "conversation_bfqhtj_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_xpriw7_text",
    "value": "A mí me parece que sabe de lo que habla.",
  },
  {
    "key": "conversation_xpriw7_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_kqxpuz_text",
    "value": "Después de todo, ha crecido en la gran ciudad... Seguro que está acostumbrado al ritmo de vida que hay aquí.",
  },
  {
    "key": "conversation_kqxpuz_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_tdhokx_text",
    "value": "Si yo tuviera que hacerme cargo de un lugar tan poblado como este, ya me habrían hecho chatarra.",
  },
  {
    "key": "conversation_tdhokx_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_0k5x6v_text",
    "value": "Estoy segura de que sabe bien lo que hace.",
  },
  {
    "key": "conversation_0k5x6v_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_unbiry_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Hola de nuevo, amiga!",
  },
  {
    "key": "conversation_unbiry_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_fdlynd_text",
    "value": "No es nada fácil entablar amistad con la gente de por aquí.",
  },
  {
    "key": "conversation_fdlynd_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_7ymnmr_text",
    "value": "No es como en casa, que conoces a todos desde el día en que te ensamblan.",
  },
  {
    "key": "conversation_7ymnmr_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_enl4xa_text",
    "value": "Esta ciudad tiene su propio ritmo, la gente está demasiado ocupada como para detenerse y charlar. ¡Están tan ocupados que no pueden ni ser amables con sus vecinos!",
  },
  {
    "key": "conversation_enl4xa_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_aptgjz_text",
    "value": "Quizás seas tú el problema.",
  },
  {
    "key": "conversation_aptgjz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cqddcg_text",
    "value": "¡Venga, Fen, sé amable!",
  },
  {
    "key": "conversation_cqddcg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3avufg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Aish... A veces incluso me pregunto si se darían cuenta en el caso de que alguien desapareciese.",
  },
  {
    "key": "conversation_3avufg_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_bibnd6_text",
    "value": "Porque he notado que hay mucha gente que desaparece por aquí.",
  },
  {
    "key": "conversation_bibnd6_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_l5r7sq_text",
    "value": "Pero nosotros en el campo sí valoramos la amistad y la lealtad.",
  },
  {
    "key": "conversation_l5r7sq_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_axrc0a_text",
    "value": "¡Supe que eras un bot pueblerino desde el primer momento que te vi! Valoras cosas como la amistad y la lealtad, ¿verdad?",
  },
  {
    "key": "conversation_axrc0a_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_4ure1i_text",
    "value": "¿Has hablado con esa profesora chiflada que está construyendo un cohete a las afueras de la ciudad?",
  },
  {
    "key": "conversation_4ure1i_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_qahysn_text",
    "value": "Dicen por ahí que ha heredado un montón de dinero, pero se lo está gastando todo en esa nave espacial.",
  },
  {
    "key": "conversation_qahysn_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_5923lp_text",
    "value": "¡Qué desperdicio!",
  },
  {
    "key": "conversation_5923lp_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_t94xdc_text",
    "value": "En mi pueblo también teníamos a un chalado como ella que estaba construyendo un cohete.",
  },
  {
    "key": "conversation_t94xdc_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_x71xpu_text",
    "value": "Me parece que algo está pasando, ¿no crees?",
  },
  {
    "key": "conversation_x71xpu_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_q3y399_text",
    "value": "Pero seguro que este es el más elegante. El que tenemos en el pueblo es ahora un silo.",
  },
  {
    "key": "conversation_q3y399_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_12pu8k_text",
    "value": "Imagínate a todos estos bots chiflados construyendo cohetes por todo el mundo. Solo de pensarlo, me dan ganas de {format laugh}reír{format reset}.",
  },
  {
    "key": "conversation_12pu8k_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_e4onuf_text",
    "value": "Pareces un poco cansada.",
  },
  {
    "key": "conversation_e4onuf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ob0wy7_text",
    "value": "Es que suceden demasiadas cosas por aquí. ¡Ya no puedo mantenerme al día!",
  },
  {
    "key": "conversation_ob0wy7_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_54qfjg_text",
    "value": "Lo he decidido, regreso al pueblo.",
  },
  {
    "key": "conversation_54qfjg_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_i33o07_text",
    "metadata": {
      "notes": "Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    },
    "value": "Lo más emocionante que sucede allí es cuando la vieja Paca Pepinillos saca el ganado del establo.",
  },
  {
    "key": "conversation_i33o07_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_7bo632_text",
    "value": "No estoy hecha para esta vida tan estresante. Me sentiría mejor con una docena de gatobots.",
  },
  {
    "key": "conversation_7bo632_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_jcodma_text",
    "value": "Puede que hasta le dé una lección a Bess Bucklethorn en esa competición de engrasado de engranajes.",
  },
  {
    "key": "conversation_jcodma_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_rjax07_text",
    "value": "Sería {format singsong}genial{format reset} si venciera a esa bot cursi de Bess Bucklethorn.",
  },
  {
    "key": "conversation_rjax07_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_kzt23q_text",
    "value": "Creo que lo mejor es que regrese a la granja.",
  },
  {
    "key": "conversation_kzt23q_text.Speaker",
    "value": "Penny Kettlebottom",
  },
  {
    "key": "conversation_vyjpoj_text",
    "metadata": {
      "notes": "*format* There is a crashed elevator just next to them.",
    },
    "value": "¡Ese terremoto hizo que el elevador se desplomara!",
  },
  {
    "key": "conversation_vyjpoj_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ctbic6_text",
    "metadata": {
      "notes": "*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    },
    "value": "{format singsong}¡Guaaau!{format reset}. ¿Y aplastó a alguien?",
  },
  {
    "key": "conversation_ctbic6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_m9r7tc_text",
    "metadata": {
      "notes": "*new* changed horrible to terrible and emphasised "thing"",
    },
    "value": "¿Cómo? {format nervous}¡Madre mía!{format reset} ¡Eres una {format emph}cosa{format reset} espantosa! ",
  },
  {
    "key": "conversation_m9r7tc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_045qay_text",
    "metadata": {
      "notes": "She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    },
    "value": "¡Oye, {format emph}no{format reset} soy una "cosa"! Si tuviera mi tótem aquí conmigo, ¡te daría tu merecido!",
  },
  {
    "key": "conversation_045qay_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fccwnq_text",
    "value": "Bueno, sea lo que sea que eres, debes aprender a comportarte.",
  },
  {
    "key": "conversation_fccwnq_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_8oqmau_text",
    "value": "Perdone, señora, pero Fen aún no ha aprendido a relacionarse con la gente.",
  },
  {
    "key": "conversation_8oqmau_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_acx7g7_text",
    "value": "¿Cuánto he de esperar hasta que vengan a reparar este elevador?",
  },
  {
    "key": "conversation_acx7g7_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_matp87_text",
    "value": "Esperar aquí, en este desierto, no es algo digno de un bot de mi alcurnia.",
  },
  {
    "key": "conversation_matp87_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_eb6uiw_text",
    "value": "Esperar aquí, en este desierto, no es algo digno de un bot de mi alcurnia.",
  },
  {
    "key": "conversation_eb6uiw_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_c7c7g6_text",
    "value": "El alcalde que tenemos ahora no es el mejor, pero tiene cierto refinamiento.",
  },
  {
    "key": "conversation_c7c7g6_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_mdqfxx_text",
    "metadata": {
      "notes": "This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    },
    "value": "No es raro que un bot logre mucho más de lo que sus partes indicaban cuando lo ensamblaron.",
  },
  {
    "key": "conversation_mdqfxx_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_uynh2z_text",
    "value": "Debo confiar en su juicio. Todos debemos confiar en su juicio.",
  },
  {
    "key": "conversation_uynh2z_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_if7w3g_text",
    "value": "No hay que preocuparse por estos terremotos. Estoy segura de que este elevador estaba falto de mantenimiento.",
  },
  {
    "key": "conversation_if7w3g_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_540zgf_text",
    "value": "Espero que reparen pronto este artilugio. {format emph}No puedo{format reset} estar esperando eternamente.",
  },
  {
    "key": "conversation_540zgf_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_t8w29c_text",
    "value": "Entonces..., aún no han reparado el elevador, ¿verdad?",
  },
  {
    "key": "conversation_t8w29c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2y8m3i_text",
    "value": "Obviamente, no.",
  },
  {
    "key": "conversation_2y8m3i_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_sbn8ap_text",
    "value": "Este no es el mejor lugar para una señorabot como yo, pero al menos es tranquilo.",
  },
  {
    "key": "conversation_sbn8ap_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_x0xmdc_text",
    "value": "¡Esa ridícula profesora que vive al lado se pasa día y noche martillando ese cohete suyo!",
  },
  {
    "key": "conversation_x0xmdc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_9hvgg5_text",
    "metadata": {
      "notes": ""Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    },
    "value": "¿Por qué no sube por ese risco?",
  },
  {
    "key": "conversation_9hvgg5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b63bbp_text",
    "value": "¡Ni hablar! Una dama no escala riscos.",
  },
  {
    "key": "conversation_b63bbp_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ff5hlh_text",
    "value": "Una dama no escala. Esperaré aquí hasta que reparen el elevador o hasta que alguien me suba. Es lo más apropiado.",
  },
  {
    "key": "conversation_ff5hlh_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_3lbfex_text",
    "value": "Sigue aquí ¿eh?",
  },
  {
    "key": "conversation_3lbfex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ykf245_text",
    "value": "Sí, {format emph}sigo aquí{format reset}. Y sí, el elevador {format emph}aún está roto{format reset}. No hay necesidad de ser grosero.",
  },
  {
    "key": "conversation_ykf245_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_c50t6h_text",
    "value": "¡Qué escándalo! Seguro que la flor y nata del mundo de los engranajes se preguntan dónde estoy.",
  },
  {
    "key": "conversation_c50t6h_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_8rvp8u_text",
    "value": "Espero que el alcalde tenga una explicación satisfactoria.",
  },
  {
    "key": "conversation_8rvp8u_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_wpxim7_text",
    "value": "Estoy segura de que me extrañan mucho. Soy muy importante, ¿lo sabías?",
  },
  {
    "key": "conversation_wpxim7_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_gtukg8_text",
    "value": "Te piensas quedar aquí para siempre, ¿verdad?",
  },
  {
    "key": "conversation_gtukg8_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cudej5_text",
    "value": "Bueno, he tenido que encontrarme un nuevo pasatiempo.",
  },
  {
    "key": "conversation_cudej5_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_h438q0_text",
    "value": "Estoy contando a todos los peregrinos que van a ese sucio templo en el oeste.",
  },
  {
    "key": "conversation_h438q0_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_e0mg3i_text",
    "value": "En circunstancias normales, los ignoraría completamente, pero estoy muy aburrida.",
  },
  {
    "key": "conversation_e0mg3i_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_x9lbaf_text",
    "value": "Me parece que estos peregrinos se traen algo entre manos. Aunque no debería interesarme por estas cosas tan mundanas.",
  },
  {
    "key": "conversation_x9lbaf_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ef66r2_text",
    "value": "¿Vosotros de nuevo? ¿No tenéis nada mejor que hacer que molestarme?",
  },
  {
    "key": "conversation_ef66r2_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_4ay3w5_text",
    "value": "¡Claro que tenemos mucho que hacer! Pero molestarla es tan divertido...",
  },
  {
    "key": "conversation_4ay3w5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b1t04s_text",
    "value": "Como si estos terremotos no fueran suficiente molestia.",
  },
  {
    "key": "conversation_b1t04s_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_6ntyzc_text",
    "value": "Me da igual. He llegado a la conclusión de que este alcalde es un idiota.",
  },
  {
    "key": "conversation_6ntyzc_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_9sm12u_text",
    "value": "Sé que es muy difícil de creer, pero yo también puedo llegar a ser ofensiva en contadas ocasiones.",
  },
  {
    "key": "conversation_9sm12u_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_ce5r53_text",
    "value": "Venga ya, ¿en serio?",
  },
  {
    "key": "conversation_ce5r53_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1zdfzx_text",
    "value": "Me pregunto cuánto cuesta un pasaje para ese cohete...",
  },
  {
    "key": "conversation_1zdfzx_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_4y3t9l_text",
    "value": "Me pregunto cuánto cuesta un pasaje para ese cohete...",
  },
  {
    "key": "conversation_4y3t9l_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_bfqth1_text",
    "value": "Esperar aquí, en este desierto, no es digno de alguien de mi alcurnia.",
  },
  {
    "key": "conversation_bfqth1_text.Speaker",
    "value": "Lady Botterley",
  },
  {
    "key": "conversation_kohvbb_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "{format emph}¡Auch!{format reset}",
  },
  {
    "key": "conversation_kohvbb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1a5f80_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "¡Mecachatarris! Se ha roto mi linterna.",
  },
  {
    "key": "conversation_1a5f80_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_9rx08a_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "¡Guau! ¿Qué {format emph}es{format reset} este lugar?",
  },
  {
    "key": "conversation_9rx08a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ojjbl5_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "Tendré que explorarlo para {format highlight}encontrar otra salida{format reset}.",
  },
  {
    "key": "conversation_ojjbl5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y5enud_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "¡Oh, {format singsong}divina Luz del consejo!{format reset} ¡Ilumina mi camino!",
  },
  {
    "key": "conversation_y5enud_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_hnsad0_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "¡SÍ, TÚ PUEDES DISFRUTAR DE MI BRILLO DESTRUCTOR!",
  },
  {
    "key": "conversation_hnsad0_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_a1al3q_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "{format singsong}¡Bienaventurado seas!{format reset} ¡El ascenso me espera!",
  },
  {
    "key": "conversation_a1al3q_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_2ln8fi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Oye! He estado a punto de prenderte en llamas, sectaria chiflada.",
  },
  {
    "key": "conversation_2ln8fi_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qzp3tz_text",
    "value": "Ya te lo he dicho, {format emph}no soy una sectaria.{format reset}",
  },
  {
    "key": "conversation_qzp3tz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ksn1s4_text",
    "value": "¿En serio? Bueno, todos los bots me parecéis iguales.",
  },
  {
    "key": "conversation_ksn1s4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_g22jzu_text",
    "value": "{format emph}Te{format reset} pareces a uno de esos duendecillos de Vectron. ¿Cómo es eso {format emph}posible?{format reset}",
  },
  {
    "key": "conversation_g22jzu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_01a075_text",
    "value": "Mi amigo Rusty destruyó a Vectron antes de desaparecer.",
  },
  {
    "key": "conversation_01a075_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_w28at6_text",
    "value": "Los de la secta me han secuestrado y me han conectado aquí para adorarme. ¡Querían que los destruyera, {format laugh}je, je, je, je!{format reset}",
  },
  {
    "key": "conversation_w28at6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_krzwlf_text",
    "value": "Hm... Pero no puedo hacerlo sin mi genial tótem. ¿Qué hacemos ahora?",
  },
  {
    "key": "conversation_krzwlf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wfa9i6_text",
    "value": "Bueno, {format emph}voy{format reset} a la gran ciudad. Me dijeron que habían visto a Rusty por allí.",
  },
  {
    "key": "conversation_wfa9i6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qhu4n0_text",
    "value": "¿A la ciudad? Pues, si tanto insistes, iré contigo.",
  },
  {
    "key": "conversation_qhu4n0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_e2v16f_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "¡UN DISPARO! {format laugh}¡JE, JE, JE!{format reset}",
  },
  {
    "key": "conversation_e2v16f_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_z0997i_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "¡Alto ahí! ¿Qué {format emph}sucede{format reset} aquí?",
  },
  {
    "key": "conversation_z0997i_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0dz6we_text",
    "metadata": {
      "notes": "*format* *DEMO*",
    },
    "value": "¡PERFECTO! ¡OTRO PEREGRINO!",
  },
  {
    "key": "conversation_0dz6we_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_mzljgp_text",
    "metadata": {
      "notes": "*DEMO*",
    },
    "value": "No soy un...",
  },
  {
    "key": "conversation_mzljgp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_yadt78_text",
    "metadata": {
      "notes": "*new* *DEMO* moved the pew-pew line from below into this line.",
    },
    "value": "¡PREPÁRATE PARA MORIR! {format laugh}¡PIUM, PIUM!{format reset}",
  },
  {
    "key": "conversation_yadt78_text.Speaker",
    "value": "The Guiding Light",
  },
  {
    "key": "conversation_cukwql_text",
    "value": "¡Vaya, menudo paisaje! ¿Qué te parece si echas un vistazo más de cerca?",
  },
  {
    "key": "conversation_cukwql_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_aszmw4_text",
    "value": "¡Tendrás que acercarte aún más!",
  },
  {
    "key": "conversation_aszmw4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_skvrgn_text",
    "value": "{format singsong}¡Más cercaaaaaaaa...{format reset} {format laugh}je, je, je!{format reset}",
  },
  {
    "key": "conversation_skvrgn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x6t79e_text",
    "value": "¡Miren quién ha llegado! ¡Es Dorothy McCrank!",
  },
  {
    "key": "conversation_x6t79e_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yu1bwf_text",
    "value": "¡Tratante Carson! No creía que encontraría a algún conocido tan lejos de casa.",
  },
  {
    "key": "conversation_yu1bwf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0hioym_text",
    "value": "Dime, ¿qué hay de nuevo en tu Tumbleton natal? ¡He oído cantidad de rumores!",
  },
  {
    "key": "conversation_0hioym_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_dslq5p_text",
    "value": "Todo comenzó con la llegada de Rusty, empezó a extraer riquezas de la mina y a contribuir a la prosperidad de la ciudad.",
  },
  {
    "key": "conversation_dslq5p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8tr70j_text",
    "value": "Pero un día se encontró con una extraña tecnología allí abajo. Se fusionó con ella y se volvió más fuerte.",
  },
  {
    "key": "conversation_8tr70j_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_70kkpo_text",
    "value": "¡Venga! ¿Cuándo empieza lo bueno?",
  },
  {
    "key": "conversation_70kkpo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xfpxnh_text",
    "value": "Pues bien, la fuente de ese poder misterioso resultó ser extremadamente peligrosa.",
  },
  {
    "key": "conversation_xfpxnh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_epbknd_text",
    "value": "Rusty peleó contra ese poder y nos salvó, pero después de la lucha, desapareció. Lo estoy buscando desde entonces.",
  },
  {
    "key": "conversation_epbknd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c5qvu8_text",
    "value": "Un viajero vio mis anuncios de "desaparecido" y me dijo que lo habían visto entrar en las minas de El Machino.",
  },
  {
    "key": "conversation_c5qvu8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i625og_text",
    "value": "¡Guau, menuda historia!",
  },
  {
    "key": "conversation_i625og_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_umknih_text",
    "value": "La versión corta es que mi amigo ha desaparecido.",
  },
  {
    "key": "conversation_umknih_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_hp7xc3_text",
    "value": "Un viajero vio mis anuncios de "desaparecido" y me dijo lo habían visto entrar en las minas de El Machino.",
  },
  {
    "key": "conversation_hp7xc3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nfwjrx_text",
    "metadata": {
      "notes": "*new* changed "well", to "now"",
    },
    "value": "Actualmente el transporte para subir al pueblo está roto, tendrás que {format highlight}escalar el risco{format reset} para llegar hasta allí.",
  },
  {
    "key": "conversation_nfwjrx_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_c1qqn0_text",
    "value": "Estaré allí en breves. Pásate si quieres comprar algunos engranajes de mejora {image cogs_small} para apañártelas mejor en la mina.",
  },
  {
    "key": "conversation_c1qqn0_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_m6jpam_text",
    "value": "Espero que tengas más suerte y lo encuentres allí.",
  },
  {
    "key": "conversation_m6jpam_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_q4eiud_text",
    "value": "Yo voy a descansar un poco aquí antes de escalar. Mis engranajes ya están algo viejos.",
  },
  {
    "key": "conversation_q4eiud_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yx3y9m_text",
    "value": "¿Por qué no me cuentas lo que pasó en Tumbleton mientras tanto?",
  },
  {
    "key": "conversation_yx3y9m_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_x7qfv2_text",
    "value": "Bueno, como quieras, que sea en otro momento.",
  },
  {
    "key": "conversation_x7qfv2_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_5nktdz_text",
    "value": "¡Ah, cómo adoro estar en estos distritos tan refinados de la ciudad!",
  },
  {
    "key": "conversation_5nktdz_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_tj5uh7_text",
    "value": "Estos hipsterbots pagan cualquier precio por mis engranajes de mejora {image cogs_small} originales.",
  },
  {
    "key": "conversation_tj5uh7_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_nqd450_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "He estado haciendo un buen negocio comerciando estos pequeños engranajes por ahí.",
  },
  {
    "key": "conversation_nqd450_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_ny6f1a_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Normalmente los recojo en mercadillos o tiendas de segunda mano en áreas rurales, pero algunos otros se pueden encontrar simplemente tirados en el campo. ",
  },
  {
    "key": "conversation_ny6f1a_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_smo857_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hacen ese clásico ruido de "clín clín, clán clán" que tanto los caracteriza.",
  },
  {
    "key": "conversation_smo857_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_gq1rfi_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sólo los oídos entrenados pueden notar la diferencia pero, si escuchas con cuidado, sabrás a lo que me refiero.",
  },
  {
    "key": "conversation_gq1rfi_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_dm175r_text",
    "value": "Hace tiempo que no veo a tu papá, ¿cómo está?",
  },
  {
    "key": "conversation_dm175r_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_w6hv5b_text",
    "value": "Desgraciadamente murió hace tiempo.",
  },
  {
    "key": "conversation_w6hv5b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_by4nym_text",
    "value": "¡Vaya, qué noticia tan triste! Creía que antes nos enterraría a todos...",
  },
  {
    "key": "conversation_by4nym_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_1g9zr8_text",
    "value": "Aunque fuera solo por fastidiar.",
  },
  {
    "key": "conversation_1g9zr8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_cgmjf4_text",
    "value": "Yo también lo creía...",
  },
  {
    "key": "conversation_cgmjf4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i5igy1_text",
    "value": "Y dime, ¿qué ha sido de esa tienda tuya ahora que estás aquí excavando?",
  },
  {
    "key": "conversation_i5igy1_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_lp4kx4_text",
    "value": "Oh, Tumbleton prospera. Hay muchísimos bots dispuestos a hacer negocios.",
  },
  {
    "key": "conversation_lp4kx4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a7uh25_text",
    "value": "Yo, por el contrario, siempre quise trabajar en las minas, pero mi padre lo consideraba demasiado peligroso.",
  },
  {
    "key": "conversation_a7uh25_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kyijyo_text",
    "value": "Ya, bueno, me alegra saber que estás haciendo lo que siempre quisiste.",
  },
  {
    "key": "conversation_kyijyo_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_s5417g_text",
    "value": "Habría estado bien conocer al tipo que salvó tu pueblo.",
  },
  {
    "key": "conversation_s5417g_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_tgpso6_text",
    "value": "En esa época no tenía ningún negocio importante por allí.",
  },
  {
    "key": "conversation_tgpso6_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_10nfc4_text",
    "value": "¿Cómo se llamaba? Krusty... no... ¡Trusty! ¿Cierto?",
  },
  {
    "key": "conversation_10nfc4_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_vzg8gx_text",
    "value": "Rusty...",
  },
  {
    "key": "conversation_vzg8gx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ymzbde_text",
    "value": "Sí, claro. Por lo que recuerdo, destruyó a cierto monstruo gigante en esa mina.",
  },
  {
    "key": "conversation_ymzbde_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_la8vr6_text",
    "value": "Y luego, ¡va y desaparece!",
  },
  {
    "key": "conversation_la8vr6_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_k59dwv_text",
    "value": "Espero que encuentres a quien buscas, jovencita. Y espero que lo encuentres sano y salvo.",
  },
  {
    "key": "conversation_k59dwv_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_bzq0aw_text",
    "metadata": {
      "notes": "*new* removed "nothing"",
    },
    "value": "El mundo ha cambiado mucho desde que no era más que un pequeño bot.",
  },
  {
    "key": "conversation_bzq0aw_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_zc6l96_text",
    "value": "Ahora muchos buscan extraer partes de la mina o construir naves espaciales para escapar del planeta.",
  },
  {
    "key": "conversation_zc6l96_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_jnptai_text",
    "value": "Pero yo sigo aquí, vendiendo mis engranajes de mejora {image cogs_small}, tal como lo he hecho siempre.",
  },
  {
    "key": "conversation_jnptai_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_rk0bii_text",
    "value": "Creo que el futuro os pertenece a los jóvenes.",
  },
  {
    "key": "conversation_rk0bii_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_r74j24_text",
    "metadata": {
      "notes": "Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    },
    "value": "Mira, tengo un montón de engranajes de mejora {image cogs_small} de sobra. ¡Te los ofrezco a precio de ganga!",
  },
  {
    "key": "conversation_r74j24_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_0qym9q_text",
    "value": "Supongo que has regresado a por más engranajes de mejora {image cogs_small}, ¿cierto?",
  },
  {
    "key": "conversation_0qym9q_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_yx06g0_text",
    "value": "¿Qué me dices? Llévate un engranaje de mejora {image cogs_small} nuevecito por solo \${var pricelist_next:carson_cogs}{image money_small}.",
  },
  {
    "key": "conversation_yx06g0_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_x4iaao_text",
    "value": "¡Gracias por tu compra! ¡Vuelve cuando quieras!",
  },
  {
    "key": "conversation_x4iaao_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_zfed36_text",
    "value": "Eres una de mis mejores clientes, joven Dot. Es el último que tenía. ¡Espero que te sirvan estas cosas!",
  },
  {
    "key": "conversation_zfed36_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_koo3mt_text",
    "value": "Pues, quisiera poder ayudarte gratuitamente, Dot, pero los tratantes también tenemos que comer.",
  },
  {
    "key": "conversation_koo3mt_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_1yrec8_text",
    "value": "Bueno, de acuerdo, ¡regresa cuando necesites un engranaje de mejora {image cogs_small}!",
  },
  {
    "key": "conversation_1yrec8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_27y4o8_text",
    "value": "Tienes las agallas de tu padre, lo reconozco.",
  },
  {
    "key": "conversation_27y4o8_text.Speaker",
    "value": "Trader Carson",
  },
  {
    "key": "conversation_c3lb0g_text",
    "value": "¡Oye tú! ¿Qué demonios crees que haces? ¡{format emph}Largo{format reset} de mi caldera!",
  },
  {
    "key": "conversation_c3lb0g_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_f2k0wg_text",
    "value": "Así que esta es la superficie..., ¡cuánta luz!",
  },
  {
    "key": "conversation_f2k0wg_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x8lfrw_text",
    "value": "¡Tu mapa es genial! ¿Puedes utilizarlo para localizar a la gente?",
  },
  {
    "key": "conversation_x8lfrw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_02breo_text",
    "value": "No, ni aunque quisiera.",
  },
  {
    "key": "conversation_02breo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fek90f_text",
    "metadata": {
      "notes": "Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    },
    "value": "Me recuerdas a los odiosos fuegos fatuos de las historias que mi papá contaba sobre su patria.",
  },
  {
    "key": "conversation_fek90f_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_duq0rd_text",
    "value": "Te llamaré Fen, para abreviar.",
  },
  {
    "key": "conversation_duq0rd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uostgv_text",
    "metadata": {
      "notes": "*new* split from line above",
    },
    "value": "Me llamo Dorothy, pero mis amigos me llaman Dot.",
  },
  {
    "key": "conversation_uostgv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_em0ovz_text",
    "value": "Sí ya, claro. Regreso a tu caldera.",
  },
  {
    "key": "conversation_em0ovz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tats2u_text",
    "value": "Despiértame si hay algo interesante.",
  },
  {
    "key": "conversation_tats2u_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_szoc5w_text",
    "value": "Bueno, llego tarde a mi sesión de abrillantamiento. Si tienes alguna queja, déjala en mi oficina.",
  },
  {
    "key": "conversation_szoc5w_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_r6bmk4_text",
    "value": "Y si vienes a quejarte de los terremotos, ¡ni te molestes! Es normal que la tierra se sacuda de vez en cuando por estas tierras.",
  },
  {
    "key": "conversation_r6bmk4_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_orgrlo_text",
    "value": "No he venido a quejarme. Necesito entrar en la mina para encontrar a un bot perdido.",
  },
  {
    "key": "conversation_orgrlo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2k8w6x_text",
    "value": "{format laugh}¡Ja!{format reset} Lo que yo necesito es reactivar la mina. ¡Y tú ni siquiera tienes una linterna en condiciones!",
  },
  {
    "key": "conversation_2k8w6x_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_o8zw9i_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Lo más probable es que termines perdida, y eso no me conviene. Especialmente ahora, con las elecciones tan cerca.",
  },
  {
    "key": "conversation_o8zw9i_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2ok5e8_text",
    "value": "Bueno, te propongo una cosa: hay un {format emph}área más segura{format reset} donde puedes excavar. Está en la mina, justo a la izquierda de las escaleras.",
  },
  {
    "key": "conversation_2ok5e8_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_kbljxa_text",
    "value": "Si consigues {format highlight}extraer minerales{format reset} para comprarte una linterna nueva, entonces el guardia te permitirá entrar en la mina.",
  },
  {
    "key": "conversation_kbljxa_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_dgln8s_text",
    "value": "¡No puedo permitir que te pierdas en esa mina! {format highlight}Extrae los recursos{format reset} necesarios para reparar esa linterna.",
  },
  {
    "key": "conversation_dgln8s_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wdf2e3_text",
    "value": "¡Vaya, has extraído lo suficiente! No pensé que lo lograrías. ¡Ve a visitar a Cangrejo Jones!",
  },
  {
    "key": "conversation_wdf2e3_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_y8rutk_text",
    "value": "Es ese tipo verde con pinzas. Con él puedes {format highlight}cambia tus minerales{format reset} por dinero contante y sonante.",
  },
  {
    "key": "conversation_y8rutk_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_35uglo_text",
    "value": "{format highlight}Comercia con tus minerales{format reset} con Cangrejo Jones.",
  },
  {
    "key": "conversation_35uglo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_p2p0j1_text",
    "value": "Veamos, lo que has ganado solo sirve si lo gastas.",
  },
  {
    "key": "conversation_p2p0j1_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_hd3efw_text",
    "value": "Ahora ve y {format highlight}repara tu linterna{format reset} en el taller.",
  },
  {
    "key": "conversation_hd3efw_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_z86wxp_text",
    "value": "Ese tipo tímido y cuadrado te ayudará.",
  },
  {
    "key": "conversation_z86wxp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_w5r2nd_text",
    "value": "Ve y {format highlight}repara tu linterna{format reset} en el taller.",
  },
  {
    "key": "conversation_w5r2nd_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ujjfnb_text",
    "value": "¡Mucho mejor! Ahora sí pareces estar lista para {format highlight}entrar en la mina{format reset}.",
  },
  {
    "key": "conversation_ujjfnb_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_woghf0_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Y no olvides seguir trayendo más de esos dulces, dulces minerales!",
  },
  {
    "key": "conversation_woghf0_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_5r6n65_text",
    "value": "¡Es estupendo tener a alguien que traiga minerales constantemente de nuevo!",
  },
  {
    "key": "conversation_5r6n65_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_x2jdkd_text",
    "value": "Y, a excepción de algunos desacuerdos con esos malditos bichos, estoy progresando.",
  },
  {
    "key": "conversation_x2jdkd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b8dzdr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Se lo he dicho a todos! Se están alterando por nada.",
  },
  {
    "key": "conversation_b8dzdr_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_cjntod_text",
    "value": "Voy al Pasaje de la Roca Rojiza para ver si puedo {format highlight}reparar ese maldito tubo{format reset}.",
  },
  {
    "key": "conversation_cjntod_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pnbpzi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡No dejes de traer esos preciosos minerales a la superficie!",
  },
  {
    "key": "conversation_pnbpzi_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2pgjla_text",
    "value": "Y no olvides gastar tus ganancias en las tiendas de la ciudad.",
  },
  {
    "key": "conversation_2pgjla_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_j881iu_text",
    "value": "Mira, hay muchas riquezas por extraer justo frente a la Roca Rojiza. No hay necesidad de alterar el orden de las cosas sin razón.",
  },
  {
    "key": "conversation_j881iu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_827vm7_text",
    "value": "No comprendo por qué no puedes dejar la estación de bombas en paz.",
  },
  {
    "key": "conversation_827vm7_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_850lak_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Realmente necesitamos solucionar todo con explosivos, tal como lo hacen esos licoreros locos?",
  },
  {
    "key": "conversation_850lak_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ebyo6x_text",
    "value": "¿Tienes un plan mejor para abrirte paso por el Pasaje de la Roca Rojiza, hijo mío?",
  },
  {
    "key": "conversation_ebyo6x_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_hkla2t_text",
    "value": "Es solo que no entiendo por qué tiene que bajar a tanta profundidad.",
  },
  {
    "key": "conversation_hkla2t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_s2zuik_text",
    "value": "Ya te lo he dicho, allí los minerales son más valiosos que lo que hay por aquí.",
  },
  {
    "key": "conversation_s2zuik_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_o84rmq_text",
    "metadata": {
      "notes": "*new* changed format from laugh to emph",
    },
    "value": "Sí, bueno, está {format emph}eso{format reset}...",
  },
  {
    "key": "conversation_o84rmq_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wray1t_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Qué tiene de malo una buena pica? ¿Realmente tenemos que usar bombas?",
  },
  {
    "key": "conversation_wray1t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_b6rus0_text",
    "value": "Es mejor que vaya a despejar ese pasaje derrumbado en la Roca Rojiza.",
  },
  {
    "key": "conversation_b6rus0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_j39zeq_text",
    "value": "A todos les vendría bien que lo despejaras.",
  },
  {
    "key": "conversation_j39zeq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_vxn818_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Pues, {format emph}me gusta mucho{format reset} la idea de extraer todas esas piedras preciosas que están en las profundidades.",
  },
  {
    "key": "conversation_vxn818_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_7zj949_text",
    "value": "Esperemos que puedas limpiar la Roca Rojiza sin empeorar las cosas.",
  },
  {
    "key": "conversation_7zj949_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_f7egkh_text",
    "value": "Ahora que el Pasaje de la Roca Rojiza está abierto, puedo buscar a Rusty en las profundidades.",
  },
  {
    "key": "conversation_f7egkh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ksg9fp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ey, ¿El bot ese sigue perdido? Bueno, pero no te olvides de traer más de esos valiosos minerales.",
  },
  {
    "key": "conversation_ksg9fp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_gu106f_text",
    "value": "Debería ser fácil excavar hasta llegar al muro protector, cariño.",
  },
  {
    "key": "conversation_gu106f_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_56ijq0_text",
    "value": "Supongo que tu amigo se habrá resbalado y caído por una de esas grietas.",
  },
  {
    "key": "conversation_56ijq0_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ynbcdq_text",
    "value": "En tu lugar, yo iría a la estación de mampostero.",
  },
  {
    "key": "conversation_ynbcdq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_twgnbe_text",
    "value": "Ahí deben tener una vieja máquina que te facilitará mucho la vida.",
  },
  {
    "key": "conversation_twgnbe_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_51emyp_text",
    "value": "¿Te refieres a la máquina que los estúpidos de mis hermanos emparedaron el año pasado cuando pusieron esos ladrillos?",
  },
  {
    "key": "conversation_51emyp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_8gee3i_text",
    "value": "¡Que me lleve el diablo! Apuesto a que puedes {format highlight}encontrar otro camino{format reset} para superar ese muro si exploras el lugar con cuidado.",
  },
  {
    "key": "conversation_8gee3i_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_4sh4u4_text",
    "metadata": {
      "notes": "*new* removed the line beneath this.",
    },
    "value": "¡Y no te olvides de informarme si encuentras algún pasadizo! Enviaré a alguien después para que lo tape.",
  },
  {
    "key": "conversation_4sh4u4_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_gbjzn6_text",
    "metadata": {
      "notes": "*new* changed cave to passage",
    },
    "value": "He encontrado un pasadizo la mar de extraño allí abajo. Está lleno de plantas raras.",
  },
  {
    "key": "conversation_gbjzn6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jsqibo_text",
    "value": "Bueno, casi todo lo que hay a esas profundidades es extraño. Está demasiado cerca del territorio licorero.",
  },
  {
    "key": "conversation_jsqibo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2xq01z_text",
    "value": "Los inútiles de mis otros hijos dijeron algo sobre haber entrado en una caverna extraña y llena de plantas.",
  },
  {
    "key": "conversation_2xq01z_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_aukq83_text",
    "value": "En su momento pensé que tenían ese maldito síndrome de descompresión.",
  },
  {
    "key": "conversation_aukq83_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_8rttb6_text",
    "value": "Mis hermanos sellaron totalmente la estación de mampostero.",
  },
  {
    "key": "conversation_8rttb6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6scmnj_text",
    "value": "A decir verdad, mis chicos no son los más brillantes del barrio.",
  },
  {
    "key": "conversation_6scmnj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jseqve_text",
    "value": "Logré colarme por debajo del muro y encontré la estación de mampostero..., pero aún no hay señal de Rusty.",
  },
  {
    "key": "conversation_jseqve_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_saqvas_text",
    "value": "¡Pero venga! ¿Por qué alguien en su sano juicio querría excavar tan profundo? ¿No querrás {format highlight}entrar en territorio licorero{format reset}, verdad?",
  },
  {
    "key": "conversation_saqvas_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_41t2gq_text",
    "value": "Ese martillo neumático destrozará todo a su paso y te llevará a tu destino en un santiamén.",
  },
  {
    "key": "conversation_41t2gq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_nlrzra_text",
    "value": "Pero pon atención a tu nivel de agua. ¡Esa herramienta consume más agua que un marinerobot en el desierto!",
  },
  {
    "key": "conversation_nlrzra_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_x4aowp_text",
    "value": "¡Y mucha atención! No quiero que te siga ninguno de esos licoreros enfermos hasta aquí. ¡Eso es lo último que necesito!",
  },
  {
    "key": "conversation_x4aowp_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_acygrc_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ten cuidado cuando perfores el muro y cuídate de esos dementes.",
  },
  {
    "key": "conversation_acygrc_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_mo33pi_text",
    "metadata": {
      "notes": "*new* removed fake news to tone down Trumpism",
    },
    "value": "La profesora chiflada esa, Sherman, sigue sembrando el terror con sus lecturas sobre los terremotos.",
  },
  {
    "key": "conversation_mo33pi_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_27gaig_text",
    "value": "Venga ya, ese último temblor no derribó nada. ",
  },
  {
    "key": "conversation_27gaig_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ydzkaa_text",
    "value": "Nos mira con desprecio desde la lanzadera de su cohete solo porque tiene un título.",
  },
  {
    "key": "conversation_ydzkaa_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_667vwu_text",
    "value": "Sherman se cree muy lista porque tiene un título. {format laugh}¡Ja!{format reset} El único papel que importa en este mundo es el que sacas del banco...",
  },
  {
    "key": "conversation_667vwu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jx90fz_text",
    "value": "Esa secta loca del templo parece estar protegiendo algún {format emph}generador apocalíptico{format reset}.",
  },
  {
    "key": "conversation_jx90fz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jw27fp_text",
    "value": "¿Será eso lo que ha estado causando tantos temblores antinaturales?",
  },
  {
    "key": "conversation_jw27fp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_9baw7n_text",
    "value": "¡Bueno, eso no es problema mío!",
  },
  {
    "key": "conversation_9baw7n_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_7m1f5t_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "La oficina del alcalde no puede permitirse ocuparse de problemas apocalípticos.",
  },
  {
    "key": "conversation_7m1f5t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qbl22o_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Mi trabajo es hacer que los bots extraigan piedras preciosas de las minas. Y cobrarles impuestos por ello.",
  },
  {
    "key": "conversation_qbl22o_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_v4im3u_text",
    "value": "¡Idiota, tú eres el que manda aquí! ¡Querías ser alcalde, pues ahora actúa como alcalde!",
  },
  {
    "key": "conversation_v4im3u_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_v6x25f_text",
    "value": "La chicabot esa ya ha estado en el templo. ¡Hagamos que regrese y desactive ese generador!",
  },
  {
    "key": "conversation_v6x25f_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6dx6ev_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Listo, problema resuelto! No olvides traerme más de esas piedras preciosas.",
  },
  {
    "key": "conversation_6dx6ev_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6aje4l_text",
    "value": "Oye, ¿has tenido tiempo de{format highlight} desactivar ese generador apocalíptico{format reset}?",
  },
  {
    "key": "conversation_6aje4l_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_3lxi6c_text",
    "value": "Hemos logrado destruir el generador apocalíptico.",
  },
  {
    "key": "conversation_3lxi6c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rv004f_text",
    "value": "¡Sí, lo hemos hecho! ¡Lástima que te perdiste la explosión!",
  },
  {
    "key": "conversation_rv004f_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7nmsnx_text",
    "value": "¡¿Lo ves?! ¡La oficina del alcalde lo tenía todo bajo control!",
  },
  {
    "key": "conversation_7nmsnx_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qpbmn2_text",
    "value": "{format emph}¡Idiota!{format reset}",
  },
  {
    "key": "conversation_qpbmn2_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_j8m71m_text",
    "value": "{format emph}Fui{format reset} yo quien la envió a la mina en un principio.",
  },
  {
    "key": "conversation_j8m71m_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_sptgv3_text",
    "value": "Merezco cierto reconocimiento. Fui yo quien te envió a la mina en un principio.",
  },
  {
    "key": "conversation_sptgv3_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_2h1yth_text",
    "value": "Hemos descubierto otras máquinas que causan terremotos en las minas.",
  },
  {
    "key": "conversation_2h1yth_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xbnodu_text",
    "metadata": {
      "notes": "*new* enclosed "come" into the format",
    },
    "value": "¡Oh, {format emph}por favor{format reset}! ¿Es que no pueden darme un respiro?",
  },
  {
    "key": "conversation_xbnodu_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_6c2elx_text",
    "value": "¡Lo único que quería era un trabajo en el que no tuviera que excavar en esa asquerosa mina!",
  },
  {
    "key": "conversation_6c2elx_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_kk8x0s_text",
    "value": "Si no puedes {format highlight}desactivar esas máquinas{format reset}, ¡tendré que evacuar toda la ciudad!",
  },
  {
    "key": "conversation_kk8x0s_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_hmjz7t_text",
    "value": "¿Tienes idea de lo mucho que me costará?",
  },
  {
    "key": "conversation_hmjz7t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_qzd676_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Bueno, al menos tráeme algo valioso de allí abajo, ¿de acuerdo?",
  },
  {
    "key": "conversation_qzd676_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ocz2bm_text",
    "value": "¿Has logrado desactivar todas las máquinas?",
  },
  {
    "key": "conversation_ocz2bm_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wihfk8_text",
    "value": "¡Hay selvas en las minas y sectarios que planean destrozar el mundo!",
  },
  {
    "key": "conversation_wihfk8_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jcggy6_text",
    "value": "Apuesto a que el último alcalde no se las tuvo que ver con cosas así...",
  },
  {
    "key": "conversation_jcggy6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_8d282i_text",
    "value": "Hasta he llegado a desear haberme quedado en el negocio familiar. Mis hermanos parecen bastante felices.",
  },
  {
    "key": "conversation_8d282i_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_w4v0m6_text",
    "value": "Creo que es hora de comenzar a empacar mis maletas como el resto de los votantes.",
  },
  {
    "key": "conversation_w4v0m6_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_mm9lt2_text",
    "value": "No puedo ser alcalde si no hay un pueblo que gobernar, ¿cierto? Mm, es una idea bastante reconfortante...",
  },
  {
    "key": "conversation_mm9lt2_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_e4p6yr_text",
    "value": "Bueno, tal vez debería unirme al negocio familiar y comenzar una nueva vida como minero de asteroides.",
  },
  {
    "key": "conversation_e4p6yr_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_yzrylo_text",
    "value": "Oye, ¿qué opinas de esta consigna? "¡El negocio de siempre!". Suena bien, ¿no crees?",
  },
  {
    "key": "conversation_yzrylo_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_pap70a_text",
    "value": "¿Un minero con bufanda roja? ¡{format emph}Tiene que ser{format reset} Rusty! ¡Al fin he encontrado una pista prometedora!",
  },
  {
    "key": "conversation_pap70a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n0lq8o_text",
    "value": "Me parece que estos terremotos suenan prometedores.",
  },
  {
    "key": "conversation_n0lq8o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3nu9ex_text",
    "value": "No hay nada mejor que un poco de caos para animar una aventura.",
  },
  {
    "key": "conversation_3nu9ex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_elfbhm_text",
    "value": "Tengo que {format highlight}hablar con el alcalde{format reset} para poder regresar a la mina.",
  },
  {
    "key": "conversation_elfbhm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lty8j0_text",
    "value": "¡Alto ahí! ¡No está autorizada para excavar aquí, señorita!",
  },
  {
    "key": "conversation_lty8j0_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ml6q7x_text",
    "value": "No puedo permitir que se pierda ningún minero, ¿entendido?",
  },
  {
    "key": "conversation_ml6q7x_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_cmr7ae_text",
    "value": "Me parece que debe hablar con el alcalde para obtener la autorización correspondiente.",
  },
  {
    "key": "conversation_cmr7ae_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jqyolm_text",
    "metadata": {
      "notes": "Her chest lamp is busted",
    },
    "value": "¡Alto ahí, señorita! No puedo permitirle excavar aquí sin una fuente de luz adecuada.",
  },
  {
    "key": "conversation_jqyolm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jmhinb_text",
    "value": "¡Solo quiero entrar ahí y buscar a mi amigo! ¿Qué le parece si solo echo un vistazo?",
  },
  {
    "key": "conversation_jmhinb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_97lht6_text",
    "value": "Sí, déjela echar un vistazo. {format emph}Probablemente{format reset} se las arregle para volver.",
  },
  {
    "key": "conversation_97lht6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_naakhs_text",
    "value": "Creo que ya hemos perdido {format emph}demasiados{format reset} mineros allí abajo.",
  },
  {
    "key": "conversation_naakhs_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wjso4t_text",
    "value": "Es demasiado peligroso andar a oscuras. ¿Por qué no {format highlight}extrae minerales{format reset} en esa zona mejor iluminada?",
  },
  {
    "key": "conversation_wjso4t_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_iom5do_text",
    "value": "Es demasiado peligroso andar a oscuras. ¿Por qué no {format highlight}repara primero su linterna{format reset} en la ciudad?",
  },
  {
    "key": "conversation_iom5do_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_c5cn1e_text",
    "value": "¡Necesita {format highlight}extraer minerales{format reset} para poder reparar su linterna!",
  },
  {
    "key": "conversation_c5cn1e_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_6b9sev_text",
    "value": "¿Por qué no {format highlight}vende los minerales{format reset} que tenga y va a ver al mecánico para que repare su linterna?",
  },
  {
    "key": "conversation_6b9sev_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_66rd82_text",
    "value": "Creo que puede {format highlight}reparar su linterna{format reset} en el taller de la ciudad.",
  },
  {
    "key": "conversation_66rd82_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_94r9zk_text",
    "value": "¡Vaya, parece que está lista para excavar!",
  },
  {
    "key": "conversation_94r9zk_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_n9j9h3_text",
    "value": "Entonces, ¿ahora sí me permitirá {format highlight}excavar en las profundidades{format reset} de la mina?",
  },
  {
    "key": "conversation_n9j9h3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p0ntw5_text",
    "value": "¡Por supuesto! Solo muéstreme si su {format highlight}linterna funciona{format reset} correctamente y le abriré la escotilla.",
  },
  {
    "key": "conversation_p0ntw5_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wphcux_text",
    "value": "Muéstreme por favor si su {format highlight}linterna funciona{format reset} correctamente y le permitiré entrar en la mina.",
  },
  {
    "key": "conversation_wphcux_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_f36o1k_text",
    "metadata": {
      "notes": "*new* expanded this as I removed the full text that was used before. It was repatative.",
    },
    "value": "Me parece que el sistema de tubos la llevará a la ciudad más rápido que si hace el trayecto a pie.",
  },
  {
    "key": "conversation_f36o1k_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ih3zjl_text",
    "value": "Tenías razón, el Pasaje de la Roca Rojiza está cerrado.",
  },
  {
    "key": "conversation_ih3zjl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lynw1k_text",
    "value": "No me extraña.",
  },
  {
    "key": "conversation_lynw1k_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_arg7cq_text",
    "value": "Aunque me parece que podrá abrirse paso con algún explosivo.",
  },
  {
    "key": "conversation_arg7cq_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_94selp_text",
    "value": "Me parece que la Roca Rojiza quedará despejada con una buena explosión.",
  },
  {
    "key": "conversation_94selp_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pl5kjt_text",
    "value": "Apuesto a que el alcalde querrá saber si despeja la Roca Rojiza.",
  },
  {
    "key": "conversation_pl5kjt_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_d3sb26_text",
    "metadata": {
      "notes": "Shiners are cave dwelling human decendants.",
    },
    "value": "He visto muchas criaturas en las minas, pero ninguna es tan peligrosa y caprichosa como los licoreros.",
  },
  {
    "key": "conversation_d3sb26_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_a458ae_text",
    "metadata": {
      "notes": "A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    },
    "value": "La guerra tuvo lugar antes de que me ensamblaran, pero he tenido mis riñas con esos palurdos.",
  },
  {
    "key": "conversation_a458ae_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_t6mrk7_text",
    "value": "No vale la pena hablar con ellos, es mejor golpearlos lo más rápido posible.",
  },
  {
    "key": "conversation_t6mrk7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pygh76_text",
    "value": "Parece un poco salvaje, pero es mejor no arriesgar.",
  },
  {
    "key": "conversation_pygh76_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_xgdjhu_text",
    "value": "Menos mal que construyeron ese muro después de la guerra.",
  },
  {
    "key": "conversation_xgdjhu_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_ujn89n_text",
    "value": "Tal vez esos malditos licoreros eran distintos hace mucho tiempo.",
  },
  {
    "key": "conversation_ujn89n_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_nd5hoz_text",
    "metadata": {
      "notes": "Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    },
    "value": "Pero ahora no son más que unos mutantes que causan terremotos.",
  },
  {
    "key": "conversation_nd5hoz_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_5xd7xt_text",
    "value": "Supongo que nunca se podrá confiar realmente en un mutante.",
  },
  {
    "key": "conversation_5xd7xt_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_y6jyvf_text",
    "value": "¿Se ha encontrado con alguno de esos sectarios en sus descabellados peregrinajes?",
  },
  {
    "key": "conversation_y6jyvf_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_1tzeuc_text",
    "value": "A veces cruzan por las minas cuando van de templo en templo.",
  },
  {
    "key": "conversation_1tzeuc_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_147ntm_text",
    "value": "Suelen tomar el camino desierto a través de las Llanuras Ventosas.",
  },
  {
    "key": "conversation_147ntm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_f34oeg_text",
    "value": "No tengo nada en contra de esos sectarios, me siento un poco menos solo cuando los veo pasar por aquí.",
  },
  {
    "key": "conversation_f34oeg_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_l509g4_text",
    "value": "Me sorprende ver que haya alcanzado tal profundidad.",
  },
  {
    "key": "conversation_l509g4_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_lbobkd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Pero no se descuide, he oído historias sobre ciertos peligros que los ciudadanos comunes desconocen.",
  },
  {
    "key": "conversation_lbobkd_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_alemgw_text",
    "value": "Asegúrese de tener siempre una vía de escape. Un túnel sin salida no es más que un gran sarcófago.",
  },
  {
    "key": "conversation_alemgw_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_51bz8w_text",
    "value": "Le vendría bien {format emph}recordarlo{format reset} y asegurarse de tener una armadura adecuada.",
  },
  {
    "key": "conversation_51bz8w_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_e9lgr6_text",
    "value": "Esté alerta y mantenga su equipo en buen estado, es el mejor consejo que le puedo ofrecer.",
  },
  {
    "key": "conversation_e9lgr6_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_19pnkh_text",
    "value": "Dicen que los hermanos Yonker han visto una extraña selva creciendo en las minas.",
  },
  {
    "key": "conversation_19pnkh_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_205qqo_text",
    "value": "Dicen que se está expandiendo, pero nunca la dejaré acercarse a la ciudad.",
  },
  {
    "key": "conversation_205qqo_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_59fokz_text",
    "value": "Por si acaso, voy a invertir en una buena hacha. Vale la pena porque es una herramienta multiuso.",
  },
  {
    "key": "conversation_59fokz_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_vwt53j_text",
    "value": "Da miedo pensar que una selva ha aparecido de la nada, así como así.",
  },
  {
    "key": "conversation_vwt53j_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_1re540_text",
    "value": "Admito que he estado un poco preocupado después del último terremoto.",
  },
  {
    "key": "conversation_1re540_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_25kyco_text",
    "value": "Me parece que se vuelven cada vez más fuertes. Pero le aseguro que no abandonaré mi puesto.",
  },
  {
    "key": "conversation_25kyco_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_e0zgh7_text",
    "value": "Hay mucha gente que se puede lastimar si nadie los protege del peligro.",
  },
  {
    "key": "conversation_e0zgh7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_jkptm2_text",
    "value": "En mi corazón no hay sitio para el miedo, solo para el deber. Estoy lleno de deber.",
  },
  {
    "key": "conversation_jkptm2_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4niz25_text",
    "value": "{format highlight}Cuide su linterna{format reset}, no querrá quedarse a oscuras allí abajo.",
  },
  {
    "key": "conversation_4niz25_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_aex9as_text",
    "value": "Si mengua, regrese y {format highlight}reposte aquí arriba{format reset}.",
  },
  {
    "key": "conversation_aex9as_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_dmvx8z_text",
    "value": "Las minas no son el lugar más seguro del mundo, es mejor que su equipo esté a punto.",
  },
  {
    "key": "conversation_dmvx8z_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_uimryl_text",
    "value": "¡Calma, gente, calma!",
  },
  {
    "key": "conversation_uimryl_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_31d0sd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "En realidad, es difícil mantener la calma con estos {format nervous}terremotos{format reset}.",
  },
  {
    "key": "conversation_31d0sd_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_4njhbf_text",
    "value": "Ya te lo he dicho, ¡mi sismógrafo me da lecturas muy extrañas!",
  },
  {
    "key": "conversation_4njhbf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_l4n0br_text",
    "value": "Hay muchas otras cosas más importantes que resolver, por ejemplo, conseguir más minerales.",
  },
  {
    "key": "conversation_l4n0br_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_dzl3uz_text",
    "value": "¡Eres un idiota! ¿Por qué no quieres escuchar a los expertos?",
  },
  {
    "key": "conversation_dzl3uz_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_7blj3t_text",
    "value": "¡Mamá, por favor! Estos "expertos" y sus "datos"... no son capaces de ver lo importante.",
  },
  {
    "key": "conversation_7blj3t_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_lwjidu_text",
    "value": "¿Y qué me dices de ese {format emph}minero con una bufanda roja{format reset} que nunca logró salir de ahí?",
  },
  {
    "key": "conversation_lwjidu_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_jije2r_text",
    "value": "Ya he contratado a un guardia para que evite que desaparezcan más bots.",
  },
  {
    "key": "conversation_jije2r_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_jhc64p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Bueno, bueno. Mantengamos la mente fría y recordemos que la oficina del alcalde no es responsable de estas cosas.",
  },
  {
    "key": "conversation_jhc64p_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_njlyi9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Idiota!",
  },
  {
    "key": "conversation_njlyi9_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_xqrxw3_text",
    "value": "{format laugh}¡Je, je, je! ¡Bum!{format reset} Hagámoslo de nuevo.",
  },
  {
    "key": "conversation_xqrxw3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_y6g3s7_text",
    "value": "Estas bombas nos serán muy útiles. Pueden alcanzar zonas a las que no llegaría con la pica.",
  },
  {
    "key": "conversation_y6g3s7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c5us81_text",
    "value": "Creo que debo ir a {format highlight}y hablar con el alcalde{format reset} para decirle que el pasaje está abierto.",
  },
  {
    "key": "conversation_c5us81_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ig8tga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Con el tiempo, la gente empezó a excavar túneles de nuevo.",
  },
  {
    "key": "conversation_ig8tga_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_3li9iu_text",
    "value": "Por fin tengo una buena pista para encontrar a Rusty.",
  },
  {
    "key": "conversation_3li9iu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ti9ln5_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Supongo que su colega debió de pasar por el Pasaje de la Roca Rojiza en algún momento.",
  },
  {
    "key": "conversation_ti9ln5_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_60et06_text",
    "value": "Los mineros solían usar el sistema de tubos neumáticos para moverse por las minas.",
  },
  {
    "key": "conversation_60et06_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_cix8sl_text",
    "value": "Pero quedó bloqueado después de un terremoto. Lo mejor sería {format highlight}despejarlo{format reset} primero.",
  },
  {
    "key": "conversation_cix8sl_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_h47l73_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Y si abro la escotilla y te dejo bajar?",
  },
  {
    "key": "conversation_h47l73_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_q6n8pp_text",
    "value": "Está oscureciendo. Casi no puedo ver nada a pesar de estar hecho de luz.",
  },
  {
    "key": "conversation_q6n8pp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1dc723_text",
    "metadata": {
      "notes": "The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    },
    "value": "{format highlight}Regresa a la ciudad{format reset} y reposta tu linterna, así no nos perderemos aquí.",
  },
  {
    "key": "conversation_1dc723_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ytvst4_text",
    "value": "Este debe de ser el Pasaje de la Roca Rojiza. Está bloqueado.",
  },
  {
    "key": "conversation_ytvst4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ac4a61_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Si tienes explosivos puedes volar en mil pedazos estos escombros rápidamente.",
  },
  {
    "key": "conversation_ac4a61_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_f2qhr1_text",
    "value": "¡No es mala idea! Debería regresar a la ciudad y preguntar.",
  },
  {
    "key": "conversation_f2qhr1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8j9cex_text",
    "value": "{format laugh}¡Sí, explosivos!{format reset} Tal vez hasta vuelen algunas de tus partes...",
  },
  {
    "key": "conversation_8j9cex_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0g7tly_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Silencio Mejor despejemos ese tubo neumático, ¿de acuerdo?",
  },
  {
    "key": "conversation_0g7tly_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n67xrl_text",
    "value": "Este debe de ser el Pasaje de la Roca Rojiza. Está completamente bloqueado.",
  },
  {
    "key": "conversation_n67xrl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1kwj0v_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Podrías usar bombas para despejarlo.",
  },
  {
    "key": "conversation_1kwj0v_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_661ekz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "No debería alentar tus deseos de destrucción, pero no es mala idea.",
  },
  {
    "key": "conversation_661ekz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xdrduu_text",
    "value": "{format laugh}¡Sí, explosivos!{format reset} ¡Tal vez hasta vuelen algunas de tus partes!",
  },
  {
    "key": "conversation_xdrduu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6c0vsm_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Silencio! Primero vamos a intentar despejar ese tubo neumático, ¿de acuerdo?",
  },
  {
    "key": "conversation_6c0vsm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h5wj1m_text",
    "metadata": {
      "notes": "Very nervous person",
    },
    "value": "Eh, no quiero molestar... pero estos {format nervous}terremotos{format reset} me dan bastante miedo.",
  },
  {
    "key": "conversation_h5wj1m_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_o86kfe_text",
    "value": "Aunque... si fuera realmente serio, el alcalde estaría más preocupado.",
  },
  {
    "key": "conversation_o86kfe_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_o2oiou_text",
    "value": "El alcalde ha dicho que estos {format nervous}terremotos{format reset} no son nada importante, así que, bueno... supongo que será verdad.",
  },
  {
    "key": "conversation_o2oiou_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_h7ppy6_text",
    "value": "Hm, hola...",
  },
  {
    "key": "conversation_h7ppy6_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kg1mo1_text",
    "metadata": {
      "notes": "*new* The light source is set in the middle of the chest.",
    },
    "value": "Vaya, veo que has roto tu fuente de luz.",
  },
  {
    "key": "conversation_kg1mo1_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_q3my9j_text",
    "value": "Si fuera tú, hmm... no andaría por ahí a oscuras, especialmente con todo este {format nervous}estruendo{format reset} por todos lados.",
  },
  {
    "key": "conversation_q3my9j_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ltmso8_text",
    "value": "Así que, bueno... si vas a entrar en la mina es mejor que antes, eh... {format highlight}repares tu linterna{format reset}.",
  },
  {
    "key": "conversation_ltmso8_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9zjn4q_text",
    "metadata": {
      "notes": "Workbench",
    },
    "value": "Puedes usar mi mesa de trabajo... si quieres.",
  },
  {
    "key": "conversation_9zjn4q_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_izda31_text",
    "value": "Puedes {format highlight}reparar tu linterna{format reset} en mi mesa de trabajo... si quieres.",
  },
  {
    "key": "conversation_izda31_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_649j7z_text",
    "metadata": {
      "notes": "Dorothys speed boots.",
    },
    "value": "Y... por cierto, me gustan tus botas.",
  },
  {
    "key": "conversation_649j7z_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_fjqq9f_text",
    "value": "¿De verdad? Las he mejorado en una máquina cuando estaba bajo el desierto.",
  },
  {
    "key": "conversation_fjqq9f_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_v3f2hn_text",
    "value": "Seguro que el... a ver... mecanismo hidráulico de esprint las hace mucho más veloces.",
  },
  {
    "key": "conversation_v3f2hn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qnv8df_text",
    "value": "Esas máquinas de equipo de las minas son estupendas, ¿verdad?",
  },
  {
    "key": "conversation_qnv8df_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_f9qput_text",
    "value": "Hmm... de acuerdo. Bueno, hay en todas las minas.",
  },
  {
    "key": "conversation_f9qput_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ji4atj_text",
    "value": "Mm, son muy, pero que {format emph}muy viejas{format reset}. No sabemos quién las construyó, pero son muy útiles.",
  },
  {
    "key": "conversation_ji4atj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kn7n3g_text",
    "value": "Los bots mineros han construido estaciones mineras alrededor de las máquinas desde hace mucho tiempo.",
  },
  {
    "key": "conversation_kn7n3g_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_w8uqp5_text",
    "value": "Sabemos dónde se encuentran varias de ellas, pero, bueno, las minas son mucho {format emph}más grandes{format reset} que la pequeña parte en la que trabajamos.",
  },
  {
    "key": "conversation_w8uqp5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_m5pbwk_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "He leído sobre otras estaciones llenas de genial equipamiento, que se encuentran escondidas en, eh..., las partes desconocidas y más profundas de las minas.",
  },
  {
    "key": "conversation_m5pbwk_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_wad1be_text",
    "value": "Sí, claro... por supuesto.",
  },
  {
    "key": "conversation_wad1be_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_apkmkg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Genial! ¡Has encontrado un lanzador de bombas de presión!",
  },
  {
    "key": "conversation_apkmkg_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qjmh35_text",
    "metadata": {
      "notes": "This is techno jibberish, feel free to make up new stuff.",
    },
    "value": "Su diseño de succión triple hace que todo fluya {format singsong}suavemente{format reset} a través del tubo del sifón.",
  },
  {
    "key": "conversation_qjmh35_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ua28gp_text",
    "value": "Dispara proyectiles autoadhesivos que se pegan a cualquier superficie antes de explotar.",
  },
  {
    "key": "conversation_ua28gp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_saczrj_text",
    "metadata": {
      "notes": "*format* The pressure bomb works with water.",
    },
    "value": "¡Seguro que salpica! Je, je, je...",
  },
  {
    "key": "conversation_saczrj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_tz9y1l_text",
    "value": "Hm... lo siento. Me he, ejem, emocionado un poco.",
  },
  {
    "key": "conversation_tz9y1l_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_yxae4k_text",
    "value": "Vaya, eh... veo que has logrado pasar por la estación de mampostero.",
  },
  {
    "key": "conversation_yxae4k_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_rz6lrl_text",
    "metadata": {
      "notes": "*format* The upgrade is a mechanical fist that works like a jack hammer.",
    },
    "value": "Ese martillo dará un gran golpe y romperá hasta las secciones más duras del ladrillo.",
  },
  {
    "key": "conversation_rz6lrl_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_art1sv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Podrás explorar el otro lado del muro sin problemas.",
  },
  {
    "key": "conversation_art1sv_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ghl26_text",
    "value": "Además, ¡tiene una fuente de combustible mejorable y todo!",
  },
  {
    "key": "conversation_1ghl26_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_a315z5_text",
    "value": "Un cilindro neumático más fuerte te ayudará a aumentar la velocidad máxima de funcionamiento...",
  },
  {
    "key": "conversation_a315z5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_lyy59m_text",
    "value": "Bueno, es decir, tiene mucho potencial, sí, solo eso.",
  },
  {
    "key": "conversation_lyy59m_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ornloo_text",
    "metadata": {
      "notes": "See "Spelunker Station" in other document",
    },
    "value": "{format singsong}¡Vaya!{format reset} ¡Creía que la estación de espeleología estaba desaparecida! ",
  },
  {
    "key": "conversation_ornloo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_uo7wrd_text",
    "metadata": {
      "notes": "The hook shot look like a grapling hook and is shot out of your arm",
    },
    "value": "¡Pero has logrado encontrar el viejo gancho!",
  },
  {
    "key": "conversation_uo7wrd_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4x94pz_text",
    "metadata": {
      "notes": ""zip" as in fly or move fast",
    },
    "value": "Esta cosa te permite pasar volando por la mina como {format emph}nunca{format reset} lo has imaginado.",
  },
  {
    "key": "conversation_4x94pz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_wt4pay_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Ahora podrás explorar casi todos los rincones y rendijas!",
  },
  {
    "key": "conversation_wt4pay_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_jc96m9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Estas minas están llenas de secretos ocultos que esperan ser descubiertos.",
  },
  {
    "key": "conversation_jc96m9_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xxorzf_text",
    "value": "{format singsong}¡GENIAL!{format reset} ¿Es eso lo que estoy pensando?",
  },
  {
    "key": "conversation_xxorzf_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_h0sfna_text",
    "metadata": {
      "notes": "It's a falaming Pick Axe",
    },
    "value": "¿Cómo demonios has conseguido una pica de fuego?",
  },
  {
    "key": "conversation_h0sfna_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4p03fk_text",
    "value": "Oh, apuesto a que estaba escondida en el templo del este.",
  },
  {
    "key": "conversation_4p03fk_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_7shcmp_text",
    "value": "He leído sobre ella en una de mis revistas de herramientas. La posibilidad de que aún exista... ¡{format emph}No me lo puedo creer{format reset}!",
  },
  {
    "key": "conversation_7shcmp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9e6rbj_text",
    "value": "Sí, bueno... es genial.",
  },
  {
    "key": "conversation_9e6rbj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_8x0zgn_text",
    "metadata": {
      "notes": "*format* see Aeronaut Station in the other document",
    },
    "value": "¡¿Qué?! ¡No me lo creo! ¿Has estado en la estación aeronáutica?!",
  },
  {
    "key": "conversation_8x0zgn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_gqdbky_text",
    "value": "Se supone que ese lugar está enterrado muy profundo bajo las partes más modernas de la mina.",
  },
  {
    "key": "conversation_gqdbky_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_34ele3_text",
    "value": "Nunca pensé que viviría para ver un propulsor de verdad.",
  },
  {
    "key": "conversation_34ele3_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vr5wop_text",
    "value": "¡Esto es increíble!",
  },
  {
    "key": "conversation_vr5wop_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_0czv1r_text",
    "metadata": {
      "notes": "*new* just hammering home that the world is more open at this point.",
    },
    "value": "Esta cosa te permite viajar por todos los lugares de la mina. Puedes explorar lugares que no tuviste oportunidad de visitar antes por medios convencionales.",
  },
  {
    "key": "conversation_0czv1r_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_2bpv40_text",
    "metadata": {
      "notes": "*new* as in the old saying "the world is your oyster"",
    },
    "value": "La mina es tu ostra, ¡así que échale un poco de salsa y trágatela de un tirón!",
  },
  {
    "key": "conversation_2bpv40_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_6c8k38_text",
    "value": "Apuesto a que puedo crear algunas mejoras geniales para esto... Bueno, si quieres que lo haga...",
  },
  {
    "key": "conversation_6c8k38_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kddst5_text",
    "metadata": {
      "notes": "This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    },
    "value": "Mm, esa selva en la mina... todo el mundo está hablando del tema.",
  },
  {
    "key": "conversation_kddst5_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ibifo_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Espero que no llegue hasta aquí. Hm..., no me gusta nada acercarme a esos horribles cactus.",
  },
  {
    "key": "conversation_1ibifo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qxg2dp_text",
    "value": "Apuesto a que, si tuvieras una buena podadora, bueno... podrías cortar esas plantas en pedazos.",
  },
  {
    "key": "conversation_qxg2dp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_jn0ayb_text",
    "value": "Lástima que no haya viejas estaciones mineras con algo parecido...",
  },
  {
    "key": "conversation_jn0ayb_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_evptsm_text",
    "value": "Bueno, espero que esas {format nervous}plantas tan raras{format reset} no lleguen hasta la ciudad.",
  },
  {
    "key": "conversation_evptsm_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_d2k8hv_text",
    "value": "Mm, no me gusta molestar a la profesora...",
  },
  {
    "key": "conversation_d2k8hv_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_zfm1c4_text",
    "metadata": {
      "notes": "The rocket is a space rocket.",
    },
    "value": "Pero quizá le pueda pedir que me permita echar un vistazo dentro del cohete, ahora que está completo.",
  },
  {
    "key": "conversation_zfm1c4_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_js74jz_text",
    "value": "Está genial, ¿no crees?",
  },
  {
    "key": "conversation_js74jz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_bufmli_text",
    "value": "Mm, me muero de ganas de echarle un vistazo a ese cohete...",
  },
  {
    "key": "conversation_bufmli_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_yxbbjn_text",
    "value": "¡Los cohetes son de lo mejor!",
  },
  {
    "key": "conversation_yxbbjn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1ovqzn_text",
    "metadata": {
      "notes": "*new* rephrased this line to work in more situations.",
    },
    "value": "Puedes reparar o mejorar tu equipo en mi mesa de trabajo cuando... cuando quieras.",
  },
  {
    "key": "conversation_1ovqzn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4dhtk4_text",
    "value": "Bueno, pues reventemos esta cosa en {format singsong}mil pedazos{format reset}.",
  },
  {
    "key": "conversation_4dhtk4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_eff23g_text",
    "value": "En serio, necesitas hablar con alguien sobre tus ansias de destrucción.",
  },
  {
    "key": "conversation_eff23g_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oxrw0l_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Exacto, por eso lo estoy hablando contigo justo ahora. Es más, ¿cuándo NO hablo sobre mis ansias de destrucción?",
  },
  {
    "key": "conversation_oxrw0l_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nmb2rq_text",
    "value": "Cierto...",
  },
  {
    "key": "conversation_nmb2rq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t0dmfu_text",
    "metadata": {
      "notes": "*new* This message is shown when the player have unused upgrade-cogs.",
    },
    "value": "¿Por qué sigues acumulando todos los engranajes {image cogs_small} que vas encontrando cual diógenes-bot?",
  },
  {
    "key": "conversation_t0dmfu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w2gq2j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Usa algunos de ellos en la mesa de trabajo!",
  },
  {
    "key": "conversation_w2gq2j_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_enxhfq_text",
    "metadata": {
      "notes": "*format* *new* rephrased this line",
    },
    "value": "¡Guau! ¡Este lugar ya es otra cosa!",
  },
  {
    "key": "conversation_enxhfq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dsse8r_text",
    "value": "Gracias. He construido este oasis para mi gente, ¡para protegerlos!",
  },
  {
    "key": "conversation_dsse8r_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_fu699v_text",
    "value": "Mientras los pueda mantener contentos y tranquilos, se quedarán aquí, seguros.",
  },
  {
    "key": "conversation_fu699v_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hx3qqt_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Al menos esa era nuestra vida, hasta que tu amigo vino a incordiar con esos terremotos.",
  },
  {
    "key": "conversation_hx3qqt_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_6o8eta_text",
    "value": "¿Por qué haría Rusty algo así? {format emph}Arriesgó su vida{format reset} para salvarnos a todos de Vectron.",
  },
  {
    "key": "conversation_6o8eta_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x9aify_text",
    "value": "¿Realmente lo conocías tan bien? ¿Y si su lucha contra esa bestia chispeante lo cambió?",
  },
  {
    "key": "conversation_x9aify_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_y8f4q2_text",
    "value": "Es lo que hace Vectron... {format nervous}Te cambia.{format reset}",
  },
  {
    "key": "conversation_y8f4q2_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qjs5hn_text",
    "value": "Vino aquí y me dijo que derrumbaría la mina sobre nuestras cabezas. Fue difícil detenerlo.",
  },
  {
    "key": "conversation_qjs5hn_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mbjnhf_text",
    "value": "Lo siento, no puedo... Si tan solo pudiera encontrarlo... hablar con él...",
  },
  {
    "key": "conversation_mbjnhf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7sza3z_text",
    "value": "Eres leal, lo entiendo, pero si encuentras el origen de estos terremotos, lo verás por ti misma.",
  },
  {
    "key": "conversation_7sza3z_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hihmd6_text",
    "metadata": {
      "notes": "*new* rephrasing and added an emphasis",
    },
    "value": "Quizá puedas detener estos terremotos. Entonces, te {format emph}ayudaré {format reset} en todo lo que pueda!",
  },
  {
    "key": "conversation_hihmd6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_47pkq7_text",
    "metadata": {
      "notes": "*new* added a bit at the end to this one.",
    },
    "value": "{format highlight}Ve a la estación minera{format reset} que uso como almacén. La vieja máquina de herramientas puede serte de utilidad.",
  },
  {
    "key": "conversation_47pkq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_m6cj0e_text",
    "value": "{format highlight}Ve a la estación minera{format reset} y toma todo lo que necesites.",
  },
  {
    "key": "conversation_m6cj0e_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_4vzxih_text",
    "value": "Me alegro de que hayas encontrado algo útil en mi almacén. ¡Pareces preparada!",
  },
  {
    "key": "conversation_4vzxih_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_f1jnf5_text",
    "value": "Ahora solo necesito que encuentres el origen de estos terremotos y que los detengas.",
  },
  {
    "key": "conversation_f1jnf5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ln5j60_text",
    "value": "¡Ayúdame a mantener a los míos a salvo! Estoy haciendo todo lo que puedo para que me hagan caso.",
  },
  {
    "key": "conversation_ln5j60_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_u5463y_text",
    "value": "No sé nada más sobre esos terremotos, pero, ¿quizá puedas {format highlight}encontrar a un listobot{format reset} en la superficie que sí sepa?",
  },
  {
    "key": "conversation_u5463y_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_dohwhw_text",
    "value": "Quizá, ¡y entonces podré descubrir por fin dónde está Rusty!",
  },
  {
    "key": "conversation_dohwhw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_77fdqq_text",
    "value": "{format highlight}Encuentra a un listobot{format reset} en la superficie.",
  },
  {
    "key": "conversation_77fdqq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_0jmccn_text",
    "value": "Tal vez te puedan indicar la zona de origen de los terremotos.",
  },
  {
    "key": "conversation_0jmccn_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_xpdrbe_text",
    "value": "He descubierto que el último terremoto se originó en el templo del este.",
  },
  {
    "key": "conversation_xpdrbe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oqlaq7_text",
    "value": "La secta apocalíptica que está allí solo adora la destrucción.",
  },
  {
    "key": "conversation_oqlaq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_1kkqf6_text",
    "value": "Sí, conozco a esos tipos.",
  },
  {
    "key": "conversation_1kkqf6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_v0wzpo_text",
    "value": "Seguramente protegerán cualquier cosa que se relacione con los terremotos.",
  },
  {
    "key": "conversation_v0wzpo_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_nytcr5_text",
    "value": "Tienes que {format highlight}investigar en el templo{format reset} para encontrar el origen de los terremotos.",
  },
  {
    "key": "conversation_nytcr5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_x2gmu8_text",
    "value": "Tienes que {format highlight}investigar en el templo{format reset} para encontrar el origen de los terremotos.",
  },
  {
    "key": "conversation_x2gmu8_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ly3hpt_text",
    "value": "Tenías razón, Rosie. {format highlight}Rusty está metido{format reset} en todo esto.",
  },
  {
    "key": "conversation_ly3hpt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mp86jk_text",
    "value": "Así que ya lo sabes... {format emph}¡Es malvado!{format reset}",
  },
  {
    "key": "conversation_mp86jk_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_26ewef_text",
    "value": "Ha construido una especie de generador apocalíptico que causa esos terremotos.",
  },
  {
    "key": "conversation_26ewef_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_r154n3_text",
    "value": "¡Debes {format highlight}destruir esa máquina!{format reset} Quiero que mi gente esté a salvo, pero esa cosa es un gran peligro para todos.",
  },
  {
    "key": "conversation_r154n3_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mlv5kh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿A qué esperas? ¡Hay mucho que destruir!",
  },
  {
    "key": "conversation_mlv5kh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_607awg_text",
    "value": "Tienes la oportunidad de detener los terremotos. {format highlight}¡Destruye ese generador apocalíptico!{format reset}",
  },
  {
    "key": "conversation_607awg_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ck3lck_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hemos logrado desactivar el cacharro que estaba causando los terremotos.",
  },
  {
    "key": "conversation_ck3lck_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kd9cyi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Excelente! ¡Lo has logrado!",
  },
  {
    "key": "conversation_kd9cyi_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mw42bj_text",
    "value": "¡Sí, lo hemos logrado!",
  },
  {
    "key": "conversation_mw42bj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3beotd_text",
    "value": "Ni rastro de Rusty, sin embargo...",
  },
  {
    "key": "conversation_3beotd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_akywya_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hm... Si eso que llamas Vectron lo ha cambiado, ¿quizás siga allí abajo entre sus restos?",
  },
  {
    "key": "conversation_akywya_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_rwy0gr_text",
    "value": "Ese generador apocalíptico {format emph}fue{format reset} parcialmente construido con la tecnología de Vectron...",
  },
  {
    "key": "conversation_rwy0gr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ucjkci_text",
    "value": "¡Oh no, ya sé lo que estás pensando! ¡No quiero {format nervous}regresar allí abajo!{format reset}",
  },
  {
    "key": "conversation_ucjkci_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7irted_text",
    "value": "No tienes ni idea de lo que hay allí. No sabes lo que es no tener control ni voluntad.",
  },
  {
    "key": "conversation_7irted_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_21ym6y_text",
    "value": "Ya he llegado muy lejos... No puedo detenerme ahora. Al menos muéstrame la entrada, Fen...",
  },
  {
    "key": "conversation_21ym6y_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_oredyt_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Para qué? ¿Por qué mejor no nos vamos a destruir cosas a otro lugar?",
  },
  {
    "key": "conversation_oredyt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tc3nlv_text",
    "metadata": {
      "notes": "*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    },
    "value": "Rusty neutralizó a Vectron. Nos salvó a todos...",
  },
  {
    "key": "conversation_tc3nlv_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0xyfid_text",
    "value": "...",
  },
  {
    "key": "conversation_0xyfid_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uvs1vb_text",
    "value": "Te llevaré hasta allí. Pero si {format highlight}entras en Vectron{format reset}, lo harás tú sola.",
  },
  {
    "key": "conversation_uvs1vb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pq0jjj_text",
    "value": "Si quieres encontrar a Rusty, tendrás que {format highlight}entrar en Vectron{format reset}.",
  },
  {
    "key": "conversation_pq0jjj_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_vcgjsk_text",
    "value": "¿Por qué mejor no nos vamos a destruir cosas a otro lugar?",
  },
  {
    "key": "conversation_vcgjsk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3bw741_text",
    "value": "Has {format emph}vuelto{format reset}...",
  },
  {
    "key": "conversation_3bw741_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_6r8y8d_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sí. Y no encontré ni rastro de Rusty.",
  },
  {
    "key": "conversation_6r8y8d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jdhos3_text",
    "value": "Pero hemos averiguado que hay {format emph}más generadores apocalípticos{format reset} ahí fuera.",
  },
  {
    "key": "conversation_jdhos3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hlfgz1_text",
    "value": "¡Por supuesto! Es demasiado inteligente para poner todos sus huevos en una sola canasta.",
  },
  {
    "key": "conversation_hlfgz1_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_kix6a6_text",
    "value": "Lo que has hecho hasta ahora no será suficiente. ¡Tienes que {format emph}encontrarlos{format reset} todos! Nadie estará seguro hasta que lo hagas.",
  },
  {
    "key": "conversation_kix6a6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_58f8ga_text",
    "metadata": {
      "notes": "*new* added "Dorothy"",
    },
    "value": "Dorothy... Ya sé dónde están. Sentí claramente el poder que fluye a través de ellos.",
  },
  {
    "key": "conversation_58f8ga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_diuokv_text",
    "value": "Uno está en {format emph}el templo donde me encontraste.{format reset}",
  },
  {
    "key": "conversation_diuokv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5npqb6_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "El segundo está en esa extraña {format emph}jungla subterránea{format reset} por la que pasamos.",
  },
  {
    "key": "conversation_5npqb6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3v2hek_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Por último, hay otro dentro del {format emph}Templo del Destructor{format reset}.",
  },
  {
    "key": "conversation_3v2hek_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_k5nk0l_text",
    "metadata": {
      "notes": "*new* added "then" moved the line",
    },
    "value": "Perfecto, ¡vayamos pues {format highlight}a destruir esas máquinas{format reset}!",
  },
  {
    "key": "conversation_k5nk0l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1alf3v_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Las minas son enormes, con montones de secretos y peligros. Quizás el camino directo no sea el más adecuado.",
  },
  {
    "key": "conversation_1alf3v_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_b6r8b9_text",
    "metadata": {
      "notes": "*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    },
    "value": "Este propulsor que he encontrado nos hará la búsqueda más fácil.",
  },
  {
    "key": "conversation_b6r8b9_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p2pe6o_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sí, podemos recorrer el lugar desenterrando secretos y preparándonos para la destrucción. ¡Venga, adelante!",
  },
  {
    "key": "conversation_p2pe6o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jglhmm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tienes que encontrar y {format highlight}destruir los últimos generadores{format reset}.",
  },
  {
    "key": "conversation_jglhmm_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_mqmqfa_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ya has estado en los templos y el equipo que has obtenido debería bastarte para continuar explorando.",
  },
  {
    "key": "conversation_mqmqfa_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_v81wm2_text",
    "value": "En cualquier caso, no sé demasiadas cosas sobre esa jungla misteriosa.",
  },
  {
    "key": "conversation_v81wm2_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ckclse_text",
    "value": "Hemos destruido otra de las máquinas de Rusty.",
  },
  {
    "key": "conversation_ckclse_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wzvouk_text",
    "value": "{format laugh}¡Sí, ha sido genial!{format reset}",
  },
  {
    "key": "conversation_wzvouk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yb1vmx_text",
    "value": "Ha sido muy astuto de su parte el esconderlas por toda la mina.",
  },
  {
    "key": "conversation_yb1vmx_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hw5xmd_text",
    "value": "No será nada fácil encontrar el resto, aun si sabes dónde están.",
  },
  {
    "key": "conversation_hw5xmd_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_oeqkzs_text",
    "value": "Quisiera poder ayudarte más, pero necesito mantener a mi gente a salvo.",
  },
  {
    "key": "conversation_oeqkzs_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_1wlu3i_text",
    "value": "Creo que algunos se están preparando para volver a la mina.",
  },
  {
    "key": "conversation_1wlu3i_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_y85nbk_text",
    "value": "¡Bueno, pues vamos {format highlight}a destruir el resto de los generadores{format reset}!",
  },
  {
    "key": "conversation_y85nbk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_o9wzoz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Espero que encontréis a ese amigo vuestro pronto y que lo detengáis de una vez por todas.",
  },
  {
    "key": "conversation_o9wzoz_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_g8unqh_text",
    "value": "{format highlight}Destruye todas las máquinas restantes{format reset}, por favor. No sé cuánto tiempo más podré mantener a mi gente a salvo aquí.",
  },
  {
    "key": "conversation_g8unqh_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_hinklt_text",
    "value": "¿Has sentido el terremoto que hubo después de que destruyéramos la máquina?",
  },
  {
    "key": "conversation_hinklt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7bjdrx_text",
    "value": "Sí, fue difícil calmar a mi gente. Estaban fuera de sí por el temblor.",
  },
  {
    "key": "conversation_7bjdrx_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ot1xb4_text",
    "value": "Aún no los he contado. Espero que todos sigan aquí.",
  },
  {
    "key": "conversation_ot1xb4_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_8vqdk5_text",
    "metadata": {
      "notes": "*new* removed a "yes"",
    },
    "value": "Aún queda una máquina de la que tenéis que ocuparos.",
  },
  {
    "key": "conversation_8vqdk5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1t4jq7_text",
    "value": "Todos estaremos mucho más seguros cuando esas máquinas apocalípticas sean destruidas.",
  },
  {
    "key": "conversation_1t4jq7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_5hrt2a_text",
    "value": "{format highlight}Destruye la última máquina{format reset}, por favor. ¡No estaremos seguros hasta que desaparezcan todas!",
  },
  {
    "key": "conversation_5hrt2a_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_2jw2v2_text",
    "value": "No te pareces nada a los de tu especie.",
  },
  {
    "key": "conversation_2jw2v2_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_pf575r_text",
    "value": "Nunca pensé que conocería a un steambot que me agradase.",
  },
  {
    "key": "conversation_pf575r_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_tb8lha_text",
    "value": "¡Oye! ¡No he autorizado que se abran esos tubos!",
  },
  {
    "key": "conversation_tb8lha_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_c3vudp_text",
    "value": "¡Cierra el pico, hijo! Los tubos son el mejor medio de transporte en la mina.",
  },
  {
    "key": "conversation_c3vudp_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_of6kl3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "El Pasaje de la Roca Rojiza está totalmente derrumbado debido a los terremotos.",
  },
  {
    "key": "conversation_of6kl3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p4u169_text",
    "value": "No puedes probar que es por los terremotos. ¡Podría ser por cualquier otra cosa!",
  },
  {
    "key": "conversation_p4u169_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_wr7t16_text",
    "value": "No importa, de todos modos necesito explosivos para despejarlo.",
  },
  {
    "key": "conversation_wr7t16_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ljkhuj_text",
    "value": "Apuesto a que puedes {format highlight}encontrar explosivos{format reset} en la estación de bombas.",
  },
  {
    "key": "conversation_ljkhuj_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_kf7hxd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Simplemente tienes que dirigirte hacia el este cuando vuelvas a descender y la encontrarás.",
  },
  {
    "key": "conversation_kf7hxd_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_fsgerc_text",
    "value": "De todas formas, creo que usaré explosivos para despejarlo.",
  },
  {
    "key": "conversation_fsgerc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_atnqc9_text",
    "value": "Vaya, alguien ha ido a la estación de bombas. ¡Ve y {format highlight}despeja ese pasaje{format reset}, cariño!",
  },
  {
    "key": "conversation_atnqc9_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_7mti7b_text",
    "value": "{format nervous}¡AY!{format reset}",
  },
  {
    "key": "conversation_7mti7b_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_bg1gtj_text",
    "metadata": {
      "notes": "*new* changed a ) to a }",
    },
    "value": "{format nervous}...eh?{format reset}",
  },
  {
    "key": "conversation_bg1gtj_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_5yt2bx_text",
    "value": "¡Refuerzos! ¡Atrápenlos a ambos, antes de que se multipliquen!",
  },
  {
    "key": "conversation_5yt2bx_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0y97x7_text",
    "value": "Otro terremoto..., y otro bot violento. ¡Mantén la guardia, Shawn!",
  },
  {
    "key": "conversation_0y97x7_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_swc23b_text",
    "value": "¿Puedes hablar?",
  },
  {
    "key": "conversation_swc23b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sa7wlq_text",
    "value": "¿Por qué no podría hablar? ¿Alguna vez has {format emph}intentado{format reset} hablar con alguno de nosotros, robot?",
  },
  {
    "key": "conversation_sa7wlq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_h9pnyw_text",
    "value": "Tienes razón, lo siento. No he venido a pelear, solo estoy buscando a mi amigo.",
  },
  {
    "key": "conversation_h9pnyw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mkx6nq_text",
    "value": "¿Tu amigo es una tortuga marrón que parece una lata?",
  },
  {
    "key": "conversation_mkx6nq_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_jignph_text",
    "value": "¡Sí! ¿Lo has visto? ¿Qué ha pasado con él? ¿Dónde está?",
  },
  {
    "key": "conversation_jignph_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ryszmg_text",
    "value": "Pues..., no debería dejar entrar a un steambot, pero tú pareces sincera.",
  },
  {
    "key": "conversation_ryszmg_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_2r5k9z_text",
    "value": "Soy Rosie. Ven, {format highlight}hablemos dentro{format reset}. Te contaré todo lo que sé.",
  },
  {
    "key": "conversation_2r5k9z_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_ty7umo_text",
    "value": "Chssst.., ere' tan ruidosa como la Rosie.",
  },
  {
    "key": "conversation_ty7umo_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_35muig_text",
    "value": "Chssst...",
  },
  {
    "key": "conversation_35muig_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_trxx9s_text",
    "metadata": {
      "notes": "She has a fishing pole",
    },
    "value": "Chssst..., que lo' va' a e'pantar...",
  },
  {
    "key": "conversation_trxx9s_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_bcfgsy_text",
    "value": "No quiero ofenderte, pero no creo que ningún pez sobreviva en ese fango.",
  },
  {
    "key": "conversation_bcfgsy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ufdh71_text",
    "value": "Pe'...., ¿qué pe'? Yo e'toy aquí bu'cando mi' zapato'. Lo' condena'o' me se siguen e'cabullendo.",
  },
  {
    "key": "conversation_ufdh71_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_x3mdff_text",
    "value": "Cleo nece'ita uno' nuevo' zapatito'...",
  },
  {
    "key": "conversation_x3mdff_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_6wq728_text",
    "metadata": {
      "notes": "*new* run offt is old 20's hillbilly-talk.",
    },
    "value": "Zapatito'..., venid p'acá pa' protegerme lo' pinrele', pa que así pue'a salir por pata'",
  },
  {
    "key": "conversation_6wq728_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_vrn5ho_text",
    "value": "Estoy bien segura de que los zapatos no nadan...",
  },
  {
    "key": "conversation_vrn5ho_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_syk9tk_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Me pa'ece a mí que no tiene' muncha idea de zapato' tú.",
  },
  {
    "key": "conversation_syk9tk_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_ejlda7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Cómo narice' se m'abrán caí'o?",
  },
  {
    "key": "conversation_ejlda7_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_9ssddv_text",
    "value": "Cómo que los zapato' no nadan. C'aro que nadan.",
  },
  {
    "key": "conversation_9ssddv_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_f5fe22_text",
    "value": "¿Has logrado atrapar tus zapatos?",
  },
  {
    "key": "conversation_f5fe22_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uwbwbt_text",
    "metadata": {
      "notes": "*new* Speachimpediment: "Dry mouf"="dry mouth"",
    },
    "value": "¡Foh! ¡Ar diablo con lo' zapato'! Lo único que tengo como un zapato e' la boca, me pa'ece que voy a empina' er codo un poquico.",
  },
  {
    "key": "conversation_uwbwbt_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_7dil67_text",
    "value": "Ese va a se' mi plan, me voy a ir d'aquí y que le den morcilla a lo' condenao' zapato'.",
  },
  {
    "key": "conversation_7dil67_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_e7vvqa_text",
    "value": "De acuerdo...",
  },
  {
    "key": "conversation_e7vvqa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mkd1g9_text",
    "metadata": {
      "notes": "You dumb bucket thing, Cleo should kick you before say more stupid things.",
    },
    "value": "Ere' bien tonta tú, lo mi'mo te pego un par de guantazo' pa' que deje' de decí' tontería'.",
  },
  {
    "key": "conversation_mkd1g9_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_7c453w_text",
    "metadata": {
      "notes": "Pay attention to the translation of "moon juice"",
    },
    "value": "Noh vamoh a ir yendo, noh queda poco Fermento Luná'.",
  },
  {
    "key": "conversation_7c453w_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_nny1i7_text",
    "metadata": {
      "notes": "thursty",
    },
    "value": "Cleo tiene se'.",
  },
  {
    "key": "conversation_nny1i7_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_atofqv_text",
    "value": "¡Aquí, zapatito', zapatito' mío'!",
  },
  {
    "key": "conversation_atofqv_text.Speaker",
    "value": "Cleo Johnson",
  },
  {
    "key": "conversation_dk7b1d_text",
    "value": "¿La debilucha de m'hija ha dejao entrar a un robot de eso'? ¡Eh más tonta de lo que paece!",
  },
  {
    "key": "conversation_dk7b1d_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_0fdyik_text",
    "value": "¿Qué hace un pedazo de latón tan pequeñín como tú por aquí?",
  },
  {
    "key": "conversation_0fdyik_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_xx02dp_text",
    "value": "Rosie me ha invitado a venir para hablar.",
  },
  {
    "key": "conversation_xx02dp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qvnh5f_text",
    "value": "La debilucha de m'hija siempre igua'. Tanto músculo y no pue' ni derrotá a una latita como tú.",
  },
  {
    "key": "conversation_qvnh5f_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_n9fykw_text",
    "value": "Vaya, qué poco amable.",
  },
  {
    "key": "conversation_n9fykw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mypcv4_text",
    "metadata": {
      "notes": "*new* rephrased. Boom sticks here are sticks of dynamite",
    },
    "value": "¡Por algo tenemo' e'to' petardillo'!",
  },
  {
    "key": "conversation_mypcv4_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_e6z5ja_text",
    "value": "Me gusta esta bola de carne.",
  },
  {
    "key": "conversation_e6z5ja_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3zke2l_text",
    "value": "¿Cuánto' petardillo' crees que necesito pa' reventá una lata como tú?",
  },
  {
    "key": "conversation_3zke2l_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_a9cchj_text",
    "value": "No me gu'ta que las latas anden rondando por nuestro oasi'.",
  },
  {
    "key": "conversation_a9cchj_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_9svalt_text",
    "value": "Rosie debió de'truirte en vez de dejarte entra'.",
  },
  {
    "key": "conversation_9svalt_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_3su3ui_text",
    "value": "¡Qué hermoso' eran eso' tiempo' cuando volábamo' en mil pe'azo' cualquie' cosa molesta que no' encontrábamo' en la' mina'!",
  },
  {
    "key": "conversation_3su3ui_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_oza28i_text",
    "value": "¡Esta bola de carne se vuelve cada vez más interesante!",
  },
  {
    "key": "conversation_oza28i_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yrhik2_text",
    "value": "¡Ándate con cuida'o, latita!",
  },
  {
    "key": "conversation_yrhik2_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_ihr9we_text",
    "value": "Estoy cansa' de anda' arrastrando mis sandalia' por aquí.",
  },
  {
    "key": "conversation_ihr9we_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_agybew_text",
    "value": "Debería sali' y reventa' en mil pe'azos eso' terremoto' y esa selva tan rara.",
  },
  {
    "key": "conversation_agybew_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_nvv14n_text",
    "metadata": {
      "notes": "Pay attention to translation of Moon Juice",
    },
    "value": "Güeno, voy a tomarme un vasico má' de Fermento Luna' y me largo.",
  },
  {
    "key": "conversation_nvv14n_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_ezltzc_text",
    "value": "¿Y si pongo uno' cuanto' petardillo' y lo' meto en un 'bujero pa asusta' a lo' terremoto'?",
  },
  {
    "key": "conversation_ezltzc_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_2h242j_text",
    "value": "¡Fuera d'aquí! ¡No quiero malgasta' mi' petardillo' con u'tede'!",
  },
  {
    "key": "conversation_2h242j_text.Speaker",
    "value": "Dynomyte Harriet",
  },
  {
    "key": "conversation_146h2g_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_146h2g_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_w42y9y_text",
    "value": "¡Largo..., largo d'aquí..., maldita..., pe'azo de lata!",
  },
  {
    "key": "conversation_w42y9y_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_lbsxjr_text",
    "value": "No soy peligrosa, solo me preguntaba si...",
  },
  {
    "key": "conversation_lbsxjr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_76kde3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_76kde3_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_nilvvh_text",
    "value": "¡De acuerdo..., me mantendré lejos!",
  },
  {
    "key": "conversation_nilvvh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nrvcc5_text",
    "metadata": {
      "notes": "*new* removed all-caps",
    },
    "value": "¡APUÑALA-PUÑAL-APUÑALA!",
  },
  {
    "key": "conversation_nrvcc5_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_na5ijp_text",
    "value": "Soy buenísima destruyendo cacharro', ¿lo sabías?",
  },
  {
    "key": "conversation_na5ijp_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_t4gyc9_text",
    "value": "Reventé a uno hará una semanilla.",
  },
  {
    "key": "conversation_t4gyc9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_8z4duw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Y yo no me hice ni un rasguño. Na' má' que tuve que recomponerme un brazo, ya ve' tú.",
  },
  {
    "key": "conversation_8z4duw_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_68xyfp_text",
    "value": "Meno' mal que no fue mi brazo de apuñalar.",
  },
  {
    "key": "conversation_68xyfp_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_4tb6xl_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_4tb6xl_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_mfx4dl_text",
    "value": "Sí, estuve en una pelea de robots.",
  },
  {
    "key": "conversation_mfx4dl_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2z93th_text",
    "metadata": {
      "notes": "*new* removed "That"",
    },
    "value": "A Rosie no le gusta que vaya a la' mina' para apuñala' cosa'.",
  },
  {
    "key": "conversation_2z93th_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2r5nu3_text",
    "value": "Me parece bastante razonable.",
  },
  {
    "key": "conversation_2r5nu3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_10fkd9_text",
    "value": "¡Pero a mí me gu'ta muncho dar puñala'íca'!",
  },
  {
    "key": "conversation_10fkd9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_sp7pdd_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_sp7pdd_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_6iq52s_text",
    "value": "Yatusabe', me gusta apuñala' cosa'.",
  },
  {
    "key": "conversation_6iq52s_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_1su49z_text",
    "metadata": {
      "notes": "*new* removed the last "left"",
    },
    "value": "Sueño con ir a la' mina' y liarme allí a pega' puñalada' por todo' sitio'.",
  },
  {
    "key": "conversation_1su49z_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_azc2px_text",
    "value": "Vale...",
  },
  {
    "key": "conversation_azc2px_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_14e8qj_text",
    "metadata": {
      "notes": "*new* changed right to left",
    },
    "value": "¡Ya ve' tú!",
  },
  {
    "key": "conversation_14e8qj_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_cu3ase_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_cu3ase_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_5wwgu9_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_5wwgu9_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_rnl3im_text",
    "value": "¡Lo único que quiero e' salir y usa' mi apuñalado'!",
  },
  {
    "key": "conversation_rnl3im_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_2kxxoa_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Apuñala-puñal-apuñala!",
  },
  {
    "key": "conversation_2kxxoa_text.Speaker",
    "value": "Stabby Helen",
  },
  {
    "key": "conversation_iyd9iu_text",
    "value": ""¡Precaución, terremotos! Para más información, póngase en contacto con el alcalde de El Machino".",
  },
  {
    "key": "conversation_iyd9iu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jn4gij_text",
    "value": ""¡Se buscan mineros! ¡Sigue hacia el este hasta El Machino y extrae tu destino!".",
  },
  {
    "key": "conversation_jn4gij_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_04wf3d_text",
    "value": "Nunca he conocido a un licorero que hablara. Suelen estar un poco locos y ser peligrosos.",
  },
  {
    "key": "conversation_04wf3d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mlu9ml_text",
    "value": "Sí..., ¡qué decepción!",
  },
  {
    "key": "conversation_mlu9ml_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mcuc1c_text",
    "metadata": {
      "notes": "*new* removed and, added this",
    },
    "value": "Voy a {format highlight}hablar con Rosie{format reset}. Quizá ella sepa dónde está Rusty.",
  },
  {
    "key": "conversation_mcuc1c_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_z2w2u3_text",
    "metadata": {
      "notes": "*format* *new* also removed the line break (\\n}",
    },
    "value": "¡O-o-o-oyeee! ¿A dónde crees que vas?",
  },
  {
    "key": "conversation_z2w2u3_text.Speaker",
    "value": "Schwifty Shawn",
  },
  {
    "key": "conversation_n2ebi3_text",
    "value": "¡Puaj! ¡Destruye esa cosa de inmediato!",
  },
  {
    "key": "conversation_n2ebi3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kljpda_text",
    "value": "{format nervous}¡Demonios! ¡Otro terremoto!{format reset}",
  },
  {
    "key": "conversation_kljpda_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t7sxdc_text",
    "value": "¿A dónde has {format emph}ido{format reset}, Rusty?",
  },
  {
    "key": "conversation_t7sxdc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vmz2v5_text",
    "value": "Aquí está. La entrada a Vectron.",
  },
  {
    "key": "conversation_vmz2v5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_iupd4b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Bueno, ¿entramos en esa cosa?",
  },
  {
    "key": "conversation_iupd4b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_bbcmp1_text",
    "metadata": {
      "notes": "*format* *new*'",
    },
    "value": "Te lo dije, no voy a entrar {format emph}ahí{format reset}. No quiero...",
  },
  {
    "key": "conversation_bbcmp1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1rh2uj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Y aunque quisiera, no podría. No puedo entrar en un portal como {format emph}este{format reset}.",
  },
  {
    "key": "conversation_1rh2uj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pkxjfo_text",
    "value": "Pero te he prometido que {format emph}te{format reset} ayudaría a entrar...",
  },
  {
    "key": "conversation_pkxjfo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_emqhdd_text",
    "value": "Si existe la más mínima posibilidad de que Rusty esté ahí, tengo que entrar.",
  },
  {
    "key": "conversation_emqhdd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1rkegt_text",
    "value": "Entonces entra, supongo...",
  },
  {
    "key": "conversation_1rkegt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qrn9qn_text",
    "metadata": {
      "notes": "*new* moved here from fen_vectron_teleporter_bye",
    },
    "value": "Ahí dentro estarás sola y no podrás usar mi mapa.",
  },
  {
    "key": "conversation_qrn9qn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_sfgslu_text",
    "metadata": {
      "notes": "*new* moved here from fen_vectron_teleporter_by",
    },
    "value": "Tendrás que orientarte sola.",
  },
  {
    "key": "conversation_sfgslu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_j9uqnv_text",
    "value": "¿Estás segura de que quieres hacerlo?",
  },
  {
    "key": "conversation_j9uqnv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_69953l_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "De acuerdo...",
  },
  {
    "key": "conversation_69953l_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_yjswup_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Allá vamos...",
  },
  {
    "key": "conversation_yjswup_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uwxfmo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sí, no seré {format emph}yo{format reset} quien trate de convencerte.",
  },
  {
    "key": "conversation_uwxfmo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_91l718_text",
    "value": "Te buscaré cuando salga.",
  },
  {
    "key": "conversation_91l718_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vmzz9y_text",
    "value": "...",
  },
  {
    "key": "conversation_vmzz9y_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_u6n77q_text",
    "value": "Si ves movimiento ahí dentro, corre. Corre tan rápido como puedas...",
  },
  {
    "key": "conversation_u6n77q_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_vctaoa_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_vctaoa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sp4sbx_text",
    "value": "¿Fen?",
  },
  {
    "key": "conversation_sp4sbx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rj6ww8_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡¿FEN?!",
  },
  {
    "key": "conversation_rj6ww8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ad0u27_text",
    "metadata": {
      "notes": "*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    },
    "value": "¿Fen? Soy... Soy Fen.",
  },
  {
    "key": "conversation_ad0u27_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_1ajm6u_text",
    "value": "¿Dorothy?",
  },
  {
    "key": "conversation_1ajm6u_text.Speaker",
    "value": "vectron_teleporter",
  },
  {
    "key": "conversation_wgoby1_text",
    "value": "¡RUSTY!",
  },
  {
    "key": "conversation_wgoby1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_r5a8b8_text",
    "value": "¡¿RUSTY?!",
  },
  {
    "key": "conversation_r5a8b8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pgjtz4_text",
    "value": "¡Vamos, Fen! ¡Tenemos que apresurarnos!",
  },
  {
    "key": "conversation_pgjtz4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uzk2jn_text",
    "value": "Así es imposible que {format nervous}logremos volver{format reset} a la ciudad...",
  },
  {
    "key": "conversation_uzk2jn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5rvneb_text",
    "metadata": {
      "notes": "*new* changed the format to affect more words",
    },
    "value": "Pero sí puedo lograr que {format emph}ustedes dos{format reset} escapen a tiempo.",
  },
  {
    "key": "conversation_5rvneb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_32yflg_text",
    "value": ""¡CERRADO! ¡VÁYANSE A CASA!"",
  },
  {
    "key": "conversation_32yflg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ghi2wb_text",
    "value": "Oye, ¡esta cosa se ha {format nervous}vuelto loca{format reset}!",
  },
  {
    "key": "conversation_ghi2wb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_8xsftw_text",
    "metadata": {
      "notes": "*new* changed formated text from highlight to emph",
    },
    "value": "¡Larguémonos de aquí! {format emph}¡Ahora!{format reset}",
  },
  {
    "key": "conversation_8xsftw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4v2csa_text",
    "value": "¡El cohete de la profesora Sherman!",
  },
  {
    "key": "conversation_4v2csa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_izxx5d_text",
    "value": "¡Tenemos que regresar a la ciudad ya mismo!",
  },
  {
    "key": "conversation_izxx5d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x1pswz_text",
    "value": "¡Vamos! {format emph}¡Apresúrate!{format reset}",
  },
  {
    "key": "conversation_x1pswz_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_bfup2f_text",
    "value": "¡No queda tiempo para pensarlo dos veces!",
  },
  {
    "key": "conversation_bfup2f_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_2ez9yy_text",
    "value": "¡Vamos!",
  },
  {
    "key": "conversation_2ez9yy_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_kuytvd_text",
    "value": "Ya está bien de hacerte pasar por heroína.",
  },
  {
    "key": "conversation_kuytvd_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_qsa1um_text",
    "value": "Nos vemos, Dot...",
  },
  {
    "key": "conversation_hwmfh6_text",
    "value": "Ojalá el alcalde Yonker atendiese a razones.",
  },
  {
    "key": "conversation_hwmfh6_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_d0ozct_text",
    "value": "Pero no tiene sentido razonar con personas cuya supervivencia depende de que no entiendan nada.",
  },
  {
    "key": "conversation_d0ozct_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_bdyzc2_text",
    "value": "Hay algo muy extraño en esos terremotos.",
  },
  {
    "key": "conversation_bdyzc2_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_tjv7fp_text",
    "metadata": {
      "notes": "*new* changes since earlier version could be off in some instances.",
    },
    "value": "¡Vaya! ¡Qué cohete tan genial!",
  },
  {
    "key": "conversation_tjv7fp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t09utv_text",
    "metadata": {
      "notes": "*new* rephrased to work with new version of above line",
    },
    "value": "Bueno, dado que el alcalde no tiene mucho interés en la ciencia últimamente, tenía que pensar en algún plan de contingencia.",
  },
  {
    "key": "conversation_t09utv_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_f7plgb_text",
    "value": "Verás, mi sismógrafo me indica que hay algo muy extraño en esos terremotos.",
  },
  {
    "key": "conversation_f7plgb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yhfxkq_text",
    "value": "Excavamos nuestra mina justo en una falla tectónica. ¡Con un terremoto intenso, todo esto se vendrá abajo!",
  },
  {
    "key": "conversation_yhfxkq_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_k00t1f_text",
    "value": "Espero tener este cohete listo y funcionando antes de que sea demasiado tarde.",
  },
  {
    "key": "conversation_k00t1f_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_220si9_text",
    "value": "Hay que investigar más de cerca los nuevos terremotos. Nos estamos jugando prácticamente todo.",
  },
  {
    "key": "conversation_220si9_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yd21lh_text",
    "value": "Bueno, en realidad son dos grandes placas tectónicas las que se juntan aquí, justo debajo de nosotros.",
  },
  {
    "key": "conversation_yd21lh_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_yhhdlm_text",
    "value": "Esta ciudad está construida en un pilar rocoso que apareció cuando estas placas chocaron hace millones de años.",
  },
  {
    "key": "conversation_yhhdlm_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_jd18od_text",
    "value": "Guau...",
  },
  {
    "key": "conversation_jd18od_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ma515w_text",
    "value": "Estoy un poco preocupada por estos extraños patrones sísmicos.",
  },
  {
    "key": "conversation_ma515w_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_rh627j_text",
    "value": "No son resultado de los movimientos naturales de la corteza terrestre.",
  },
  {
    "key": "conversation_rh627j_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_8vxt9k_text",
    "value": "Si hay un gran terremoto, podría destruir toda la ciudad. O aún peor, ¡todo el planeta!",
  },
  {
    "key": "conversation_8vxt9k_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_nid8rc_text",
    "value": "{format emph}¡Vaya!{format reset} Es mejor que me mantenga bien alerta.",
  },
  {
    "key": "conversation_nid8rc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_gqcn63_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Así se habla!",
  },
  {
    "key": "conversation_gqcn63_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_q2vvjy_text",
    "value": "Sigo un poco preocupada por estos extraños patrones sísmicos.",
  },
  {
    "key": "conversation_q2vvjy_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_46mop5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "El muro protector en el fondo de la mina es toda una maravilla.",
  },
  {
    "key": "conversation_46mop5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_k6sl9a_text",
    "value": "También había un muro justo debajo de mi pueblo, Tumbleton.",
  },
  {
    "key": "conversation_k6sl9a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wb49hd_text",
    "value": "En realidad, es el mismo muro. ¡Ese muro se extiende miles de kilómetros!",
  },
  {
    "key": "conversation_wb49hd_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_prdn7m_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Es la mayor estructura bot jamás creada. Si estuviera en la superficie, la podrías ver desde el espacio.",
  },
  {
    "key": "conversation_prdn7m_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_0b17qr_text",
    "value": "Tantos ladrillos solo para que los licoreros no lleguen hasta aquí...",
  },
  {
    "key": "conversation_0b17qr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4s3zz6_text",
    "value": "Bueno, los licoreros, o {format emph}Homo devolvis{format reset}, son bastante ingeniosos si se trata de ciertos temas.",
  },
  {
    "key": "conversation_4s3zz6_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_29dn85_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Ese Fermento Lunar que han creado para soportar la vida en las profundidades es bastante especial...",
  },
  {
    "key": "conversation_29dn85_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_8na87z_text",
    "metadata": {
      "notes": "*new* added a comma after mutagenic",
    },
    "value": "Es un excelente mutágeno y muy adictivo, pero también es una rica fuente de energía.",
  },
  {
    "key": "conversation_8na87z_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_auy7u5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "De hecho, intenté usarlo como combustible para el cohete en algunos experimentos previos, pero resultó ser demasiado inestable.",
  },
  {
    "key": "conversation_auy7u5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_0144bl_text",
    "value": "El muro protector es toda una maravilla.",
  },
  {
    "key": "conversation_0144bl_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vfvf68_text",
    "value": "¿Sabe algo sobre esas plantas que crecen en las cavernas?",
  },
  {
    "key": "conversation_vfvf68_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n56yib_text",
    "value": "No soy bióloga, pero supongo que algunos tipos de hongos pueden sobrevivir en tales condiciones.",
  },
  {
    "key": "conversation_n56yib_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_6u259t_text",
    "value": "Me he topado con una caverna que está repleta de esas plantas.",
  },
  {
    "key": "conversation_6u259t_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4luy17_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Interesante! Seguramente obtienen energía usando un mecanismo distinto a la fotosíntesis.",
  },
  {
    "key": "conversation_4luy17_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vq8bcq_text",
    "value": "Me he encontrado con los licoreros. ¡Hasta he hablado con ellos! Han construido un pueblito justo debajo del muro.",
  },
  {
    "key": "conversation_vq8bcq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qbphbv_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Fascinante! No sabía que aún existieran licoreros que hablaban.",
  },
  {
    "key": "conversation_qbphbv_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_d8arjf_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Los pocos que he visto con mis propios ojos se comunican usando sonidos guturales. ¡No se les entiende nada!",
  },
  {
    "key": "conversation_d8arjf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_m0q6cs_text",
    "value": "He leído algunos estudios que dicen que antes eran la especie dominante en este planeta.",
  },
  {
    "key": "conversation_m0q6cs_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_n96czx_text",
    "value": "Es difícil saber algo a ciencia cierta. Tratándose del Homo devolvis, solo podemos especular.",
  },
  {
    "key": "conversation_n96czx_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9axbnb_text",
    "metadata": {
      "notes": "*format* *new* merged two lines into one.",
    },
    "value": "Es prácticamente imposible conseguir un espécimen y estudiarlo sin dañarlo... O sin que ellos te dañen a ti.",
  },
  {
    "key": "conversation_9axbnb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_6qfwjp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Los licoreros son una especie fascinante. Pueden parecer una panda de locos, pero conservan cierta individualidad.",
  },
  {
    "key": "conversation_6qfwjp_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_wlfozb_text",
    "metadata": {
      "notes": "*new* rephrased",
    },
    "value": "Profesora, ya que usted es una bot inteligente, ¿cree que estos terremotos pueden ser causados por bots?",
  },
  {
    "key": "conversation_wlfozb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ylnbuf_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Te refieres a que alguien está generando estos terremotos?",
  },
  {
    "key": "conversation_ylnbuf_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_x4pgec_text",
    "value": "Eso explicaría los epicentros extrañamente precisos de las últimas actividades sísmicas.",
  },
  {
    "key": "conversation_x4pgec_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_934xqz_text",
    "value": "El epicentro estaba justo en el templo de esa absurda secta apocalíptica.",
  },
  {
    "key": "conversation_934xqz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_72gm7a_text",
    "value": "Entonces, ¿{format emph}es{format reset} posible?",
  },
  {
    "key": "conversation_72gm7a_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_w0qkeb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Para comprobar esta hipótesis deberás {format highlight}atravesar las Llanuras Ventosas{format reset} y dirigirte al templo del este para investigarlo por ti misma.",
  },
  {
    "key": "conversation_w0qkeb_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_7xmo4l_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Esa hipótesis de que los terremotos son causados por bots es fascinante.",
  },
  {
    "key": "conversation_7xmo4l_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_p7mpft_text",
    "metadata": {
      "notes": "*new* added the part about taking the ladder",
    },
    "value": "{format highlight}Atraviesa las Llanuras Ventosas{format reset} para seguir investigando. Baja por la escalera que se encuentra en el este de la ciudad.",
  },
  {
    "key": "conversation_p7mpft_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9zagcy_text",
    "value": "La secta protege una especie de máquina que podría causar terremotos.",
  },
  {
    "key": "conversation_9zagcy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_d8olb4_text",
    "value": "Lo que tienes que hacer es desmantelar la máquina. Eso podría detener los terremotos.",
  },
  {
    "key": "conversation_d8olb4_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vts8e3_text",
    "value": "{format emph}¡Sí!{format reset} Desmantelar suena divertido. ¡Hagámoslo!",
  },
  {
    "key": "conversation_vts8e3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ly2vhz_text",
    "value": "Quizá no logre terminar de fabricar este cohete.",
  },
  {
    "key": "conversation_ly2vhz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ypryh5_text",
    "value": "No es nada sencillo construir una nave espacial de exploración.",
  },
  {
    "key": "conversation_ypryh5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_qq0n6k_text",
    "value": "Si pudieras {format highlight}desmantelar ese generador de terremotos{format reset}, quizás no tendría que construirla.",
  },
  {
    "key": "conversation_qq0n6k_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_hbhl5o_text",
    "value": "¿Como puede un steambot crear una máquina que causa terremotos?",
  },
  {
    "key": "conversation_hbhl5o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dpkudw_text",
    "value": "Deben de tener muchos conocimientos y tecnología muy avanzada.",
  },
  {
    "key": "conversation_dpkudw_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_irqx6c_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Tecnología del futuro, mucho más avanzada de lo que podemos imaginar...",
  },
  {
    "key": "conversation_irqx6c_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_gljg9h_text",
    "value": "He investigado un poco entre mis datos viejos para buscar patrones, pero no hay nada claro.",
  },
  {
    "key": "conversation_gljg9h_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j3paiq_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "Los movimientos erráticos de estos temblores parecen indicar que hay más que una máquina.",
  },
  {
    "key": "conversation_j3paiq_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_w8nhom_text",
    "value": "Puedes estar segura de que no dejaré de trabajar en este cohete por el momento.",
  },
  {
    "key": "conversation_w8nhom_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ihi6uu_text",
    "value": "No dejaré de trabajar en este cohete por el momento.",
  },
  {
    "key": "conversation_ihi6uu_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j6jtna_text",
    "value": "Un colega logró obtener algunas muestras de la selva subterránea",
  },
  {
    "key": "conversation_j6jtna_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_oepnn1_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Es extraña, ¿verdad? Y muy peligrosa.",
  },
  {
    "key": "conversation_oepnn1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kul85z_text",
    "value": "¡Sí, es genial!",
  },
  {
    "key": "conversation_kul85z_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b4ld5b_text",
    "value": "Sea como sea, me dijo que encontró restos de un mutágeno que ha contaminado la biología de esas plantas.",
  },
  {
    "key": "conversation_b4ld5b_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_h8rkzh_text",
    "value": "Parece ser que toman su energía del mutágeno {format emph}Fermento Lunar{format reset}, el mismo que tanto obsesiona a los licoreros.",
  },
  {
    "key": "conversation_h8rkzh_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_bthpa5_text",
    "value": "{format emph}Hay{format reset} muchas tuberías por todo ese lugar.",
  },
  {
    "key": "conversation_bthpa5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_wvpx34_text",
    "value": "Estoy segura de que el mutágeno viene de ahí.",
  },
  {
    "key": "conversation_wvpx34_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_ll0rrj_text",
    "value": "La selva es uno más de los muchos misterios que vienen apareciendo.",
  },
  {
    "key": "conversation_ll0rrj_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_gcue08_text",
    "value": "Ya hemos desactivado los generadores de terremotos.",
  },
  {
    "key": "conversation_gcue08_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rhj5jo_text",
    "value": "Los datos de mi sismógrafo han dejado de variar como locos y se han concentrado en un solo punto.",
  },
  {
    "key": "conversation_rhj5jo_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_pgv6y7_text",
    "value": "El último terremoto se originó en territorio licorero.",
  },
  {
    "key": "conversation_pgv6y7_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_j878i8_text",
    "metadata": {
      "notes": "*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    },
    "value": "Pues hay que encontrar otro camino para llegar hasta allí y {format highlight}hablar con Rosie.{format reset}",
  },
  {
    "key": "conversation_j878i8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lv5xcl_text",
    "metadata": {
      "notes": "*new* rephrased the ending of the line.",
    },
    "value": "¡Qué suerte que mi cohete esté listo! Solo necesito hacerle unos últimos ajustes y estaré lista para partir cuando sea necesario.",
  },
  {
    "key": "conversation_lv5xcl_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_9rxm14_text",
    "value": "Solo unos cuantos ajustes más y podremos abandonar este planeta, en caso de que el gran terremoto lo destruya todo.",
  },
  {
    "key": "conversation_9rxm14_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_tnyv5r_text",
    "value": "En cuanto mi nave espacial exploradora esté lista, me iré de este planeta.",
  },
  {
    "key": "conversation_tnyv5r_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_7an1z5_text",
    "value": "Todos están invitados a venir conmigo. Hay suficiente espacio para todos.",
  },
  {
    "key": "conversation_7an1z5_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_f5xes1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oh, oh, oh!",
  },
  {
    "key": "conversation_f5xes1_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vwbtbo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tengo fantásticas mejoras disponibles para ti! ¡Solo alta tecnología, por supuesto!",
  },
  {
    "key": "conversation_vwbtbo_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_d17hfn_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eh, bueno, perdona que te moleste... de nuevo.",
  },
  {
    "key": "conversation_d17hfn_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_2hj8xd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Es que acaba de llegar un lote de nuevos materiales que te permitirán mejorar aún más tus herramientas!",
  },
  {
    "key": "conversation_2hj8xd_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_dnpk79_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hm... solo creía que lo supieras.",
  },
  {
    "key": "conversation_dnpk79_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_cq63md_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Hola?",
  },
  {
    "key": "conversation_cq63md_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_eb2wqf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}Ah{format reset}, quiero decir... ¡Hola!",
  },
  {
    "key": "conversation_eb2wqf_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_6hj11o_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Eh... ¡tengo una nueva remesa de piezas!",
  },
  {
    "key": "conversation_6hj11o_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_ozu5go_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Te permitirán mejorar bastante todas tus herramientas... Quiero decir, mejorarlas aún más. Genial, ¿verdad?",
  },
  {
    "key": "conversation_ozu5go_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_rkault_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Bueno, eh, me he dado cuenta de que tu armadura tiene algunas abolladuras...",
  },
  {
    "key": "conversation_rkault_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_8lfpm2_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Mi nuevo pedido de chapado grueso te permitirá mejorarla.",
  },
  {
    "key": "conversation_8lfpm2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_kpzosz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Así tendrás más posibilidades de..., ya sabes..., de sobrevivir allí abajo.",
  },
  {
    "key": "conversation_kpzosz_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_vk0in8_text",
    "value": "Y..., ¿que piensas hacer?",
  },
  {
    "key": "conversation_vk0in8_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xbec1d_text",
    "metadata": {
      "notes": "This is the introductary phrase from the mechanich",
    },
    "value": "Y..., ¿que piensas hacer?",
  },
  {
    "key": "conversation_xbec1d_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_4nh80e_text",
    "value": "Pues..., me gusta tu equipo.",
  },
  {
    "key": "conversation_4nh80e_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_zb6ryl_text",
    "value": "Ehm..., puedes mejorarlo con engranajes. ¿Quieres, hmm..., quieres saber cómo?",
  },
  {
    "key": "conversation_zb6ryl_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_k47xd0_text",
    "metadata": {
      "notes": "This person is very nervous",
    },
    "value": "Eh, lo siento, mejor me callo... ¿verdad?",
  },
  {
    "key": "conversation_k47xd0_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_xsq7ao_text",
    "value": "¡¿De verdad quieres saberlo?! Vaya, pues, mm... ¡de acuerdo, sí!",
  },
  {
    "key": "conversation_xsq7ao_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9iwqjw_text",
    "value": "De acuerdo, pues, ejem... sí. Lo siento. Estaré aquí...",
  },
  {
    "key": "conversation_9iwqjw_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_e2sw99_text",
    "metadata": {
      "notes": "*new* added {format highlight}",
    },
    "value": "Entonces, ejem..., puedes {format highlight}mejorar tus herramientas{format reset} con engranajes {image cogs_small}.",
  },
  {
    "key": "conversation_e2sw99_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qsonke_text",
    "value": "Seguro que habrás visto algunos rondando por ahí.",
  },
  {
    "key": "conversation_qsonke_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9chqoj_text",
    "value": "Usa la mesa de trabajo para elegir la ranura de engranaje de una herramienta e insertar el engranaje {image cogs_small} en ella.",
  },
  {
    "key": "conversation_9chqoj_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_0dnnax_text",
    "metadata": {
      "notes": "*new* added {format highlight}",
    },
    "value": "¡Vaya! Pero, eh..., no te preocupes, ¡{format highlight}extraer los engranajes {format reset} {image cogs_small} es fácil también!",
  },
  {
    "key": "conversation_0dnnax_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_90zfu2_text",
    "value": "Conforme mejores tus herramientas, tendrás acceso a mejoras mucho más geniales.",
  },
  {
    "key": "conversation_90zfu2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_a5snuc_text",
    "value": "Pero, hmm..., hay algo más que quiero decirte, pero si no quieres no pasa nada...",
  },
  {
    "key": "conversation_a5snuc_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_b1szsc_text",
    "value": "Para algunas mejoras tendrás que encontrar heliografías.",
  },
  {
    "key": "conversation_b1szsc_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_f0xxtp_text",
    "value": "Davy Mordidas, nuestro, eh..., cartógrafo, tiene algunas, me parece...",
  },
  {
    "key": "conversation_f0xxtp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_1q2dd2_text",
    "value": "¡Las mejoras con heliografías son geniales! Bueno, mm, eso creo...",
  },
  {
    "key": "conversation_1q2dd2_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_i2a540_text",
    "value": "Ah, y dado que puedes extraer cualquier engranaje {image cogs_small}, no dudes en experimentar un poco.",
  },
  {
    "key": "conversation_i2a540_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_5p4bi7_text",
    "value": "Cambia tus ajustes de vez en cuando. Si gustas, claro...",
  },
  {
    "key": "conversation_5p4bi7_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_iq6h9b_text",
    "value": "Oh, eh..., ¡guau, has prestado atención a todo! Son pocos los que lo hacen...",
  },
  {
    "key": "conversation_iq6h9b_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_e4vdfi_text",
    "value": "Bueno, pues, eh..., yo estaré por aquí, supongo.",
  },
  {
    "key": "conversation_e4vdfi_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_9lkkka_text",
    "value": "Este lugar es familiar. Apuesto a que la secta me trajo por aquí cuando subían.",
  },
  {
    "key": "conversation_9lkkka_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qsa4d1_text",
    "value": "¿A qué profundidad crees que se encuentran los {format nervous}restos de Vectron{format reset}?",
  },
  {
    "key": "conversation_qsa4d1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3rahmd_text",
    "value": "Pues a mucha. Todavía estamos en las partes exploradas de la mina.",
  },
  {
    "key": "conversation_3rahmd_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xecqeg_text",
    "value": "Ya, de acuerdo..., bien. Solo me lo preguntaba.",
  },
  {
    "key": "conversation_xecqeg_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mx4ktk_text",
    "value": "Ahora solo tengo que encontrar la manera de atravesar ese maldito muro.",
  },
  {
    "key": "conversation_mx4ktk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cat8cu_text",
    "value": "¡Sí! {format singsong}¡Qué comiencen las explosiones!{format reset}",
  },
  {
    "key": "conversation_cat8cu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nq5gxh_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡No será suficiente! Este muro se construyó después de las guerras licoreras para mantener alejados a esos lunáticos.",
  },
  {
    "key": "conversation_nq5gxh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_gu7tji_text",
    "value": "Los licoreros son expertos en explotar cosas, así que el muro es a prueba de explosiones.",
  },
  {
    "key": "conversation_gu7tji_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mbv8tf_text",
    "metadata": {
      "notes": "Place, refering to the underground jungle that they just passed thruogh.",
    },
    "value": "¡Vaya, ese lugar era {format nervous}de lo más extraño!{format reset}",
  },
  {
    "key": "conversation_mbv8tf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cj1k6o_text",
    "value": "Parece que al menos hemos atravesado la primera capa del muro.",
  },
  {
    "key": "conversation_cj1k6o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_5mo9pe_text",
    "value": "Espero que esa estación minera esté por aquí cerca.",
  },
  {
    "key": "conversation_5mo9pe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vizvqs_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Y yo espero que encontremos algo interesante y destructivo por ahí.",
  },
  {
    "key": "conversation_vizvqs_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rswyd0_text",
    "value": "Dime, ¿qué {format emph}es{format reset} este lugar? Parece oscuro y peligroso. ¡Exploremos!",
  },
  {
    "key": "conversation_rswyd0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_vqbkn5_text",
    "metadata": {
      "notes": "*new* shortened by removing description of place. Was a bit misrepresentative",
    },
    "value": "No parece que crezca nada aquí abajo...",
  },
  {
    "key": "conversation_vqbkn5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jk4t0s_text",
    "value": "Apuesto a que hay muchos peligros acechándonos.",
  },
  {
    "key": "conversation_jk4t0s_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_i4oq3o_text",
    "value": "{format laugh}¡Sí!{format reset}",
  },
  {
    "key": "conversation_i4oq3o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qaywwl_text",
    "value": "Me aseguraré de tener suficiente luz antes de entrar.",
  },
  {
    "key": "conversation_qaywwl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sf4uwk_text",
    "value": "¡No seas tan sosa, vamos!",
  },
  {
    "key": "conversation_sf4uwk_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_1135rj_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Diantres! Estos terremotos son fastidiosos. El alcalde debería poner a alguien a investigar sobre el tema.",
  },
  {
    "key": "conversation_1135rj_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_dq65oq_text",
    "value": "¿Y si todos esos magníficos tesoros que hay bajo la superficie quedasen aplastados por los escombros? ¡Qué aberración!",
  },
  {
    "key": "conversation_dq65oq_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_3fn5w0_text",
    "value": "Se ve que sientes una gran atracción por las piedras preciosas, ¿eh?",
  },
  {
    "key": "conversation_3fn5w0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_npebbg_text",
    "value": "¡No, no, no! Me refiero a tesoros {format emph}reales{format reset}. Extraños y fascinantes artefactos {image artifacts_small}.",
  },
  {
    "key": "conversation_npebbg_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_a7uvtg_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Algo espléndido, con toda una historia que contar.",
  },
  {
    "key": "conversation_a7uvtg_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mjgdjr_text",
    "metadata": {
      "notes": "*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    },
    "value": "Si te topas con alguno de estos {image artifacts_small} artefactos, te agradecería mucho que me permitieras echarle un vistazo.",
  },
  {
    "key": "conversation_mjgdjr_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_uwhgx6_text",
    "value": "Creo que he encontrado algo que te resultará interesante.",
  },
  {
    "key": "conversation_uwhgx6_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_iqy08o_text",
    "value": "De acuerdo, mantendré los ojos abiertos por si veo algo interesante.",
  },
  {
    "key": "conversation_iqy08o_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rppjea_text",
    "value": "{format singsong}¡Espléndido!{format reset} Te daré una {format highlight}heliografía{format reset} si me traes al menos {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "conversation_rppjea_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_br857t_text",
    "value": "{format singsong}¡Oh!{format reset} ¿Estoy soñando? ¡Que alguien me pellizque!",
  },
  {
    "key": "conversation_br857t_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_iptdw9_text",
    "value": "Actualmente has localizado el artefacto{image artifacts_small} mítico 43.",
  },
  {
    "key": "conversation_iptdw9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_lu65ll_text",
    "value": "Cuántas veces he soñado con este momento... Mi familia ha estado buscando este objeto durante generaciones. Espero con ansia poder deleitarme con él.",
  },
  {
    "key": "conversation_lu65ll_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_wu0y6m_text",
    "value": "...",
  },
  {
    "key": "conversation_wu0y6m_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_vyiiiz_text",
    "value": "Espera...",
  },
  {
    "key": "conversation_vyiiiz_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ds3fs3_text",
    "value": "¿Eso es todo?",
  },
  {
    "key": "conversation_ds3fs3_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_kheln9_text",
    "value": "Es tan... tan...",
  },
  {
    "key": "conversation_kheln9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_axft9i_text",
    "value": "Decepcionante.",
  },
  {
    "key": "conversation_axft9i_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_66l4aw_text",
    "value": "Bueno, gracias, supongo.",
  },
  {
    "key": "conversation_66l4aw_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_6ybt0n_text",
    "value": "Mi vida no tiene sentido ahora.",
  },
  {
    "key": "conversation_6ybt0n_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_rlfp8l_text",
    "metadata": {
      "notes": "*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "{format singsong}¡Magnífico!{format reset} ¡Ya has encontrado {var num_artifacts_current} artefactos fascinantes {image artifacts_small}!",
  },
  {
    "key": "conversation_rlfp8l_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_as6lw7_text",
    "metadata": {
      "notes": "*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "{format singsong}¡Magnífico!{format reset} ¡Ya has encontrado {var num_artifacts_current} artefacto fascinante {image artifacts_small}!",
  },
  {
    "key": "conversation_as6lw7_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_p7vtak_text",
    "metadata": {
      "notes": "*format* removed emph from appreciation",
    },
    "value": "Para darte las gracias, te regalaré una {format highlight}heliografía{format reset} de las muchas que tengo.",
  },
  {
    "key": "conversation_p7vtak_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_dcphb9_text",
    "metadata": {
      "notes": "*new* "it" refering to the blueprint",
    },
    "value": "Simplemente tienes que llevarla a la mesa de trabajo y usar los engranajes modificadores para darle buen uso.",
  },
  {
    "key": "conversation_dcphb9_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_g8lzbu_text",
    "metadata": {
      "notes": "*new* gives the player som info on how many artefacts until next blueprint",
    },
    "value": "Te daré otra heliografía cuando me enseñes {var num_artifacts_threshold} artefactos {image artifacts_small} en total.",
  },
  {
    "key": "conversation_g8lzbu_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_pwaqqk_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Vaya, veo que aún no has encontrado {format emph}ningún{format reset} artefacto interesante {image artifacts_small}.",
  },
  {
    "key": "conversation_pwaqqk_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tm2fum_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Te daré una {format highlight}heliografía{format reset} si me traes al menos {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "conversation_tm2fum_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_31n97u_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Vaya, has encontrado {var num_artifacts_current} artefactos {image artifacts_small} interesantes.",
  },
  {
    "key": "conversation_31n97u_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_xkdvzp_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "Te daré una {format highlight}heliografía{format reset} si me traes al menos {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "conversation_xkdvzp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_vj87ok_text",
    "metadata": {
      "notes": "*new* Changed {image artifacts} to {image artifacts_small}",
    },
    "value": "¡Excelente! Has encontrado {var num_artifacts_current} artefactos fascinantes {image artifacts_small}.",
  },
  {
    "key": "conversation_vj87ok_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_c12v5z_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Estas cositas preciosas se pueden esconder por todas partes.",
  },
  {
    "key": "conversation_c12v5z_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_r70wn4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Pero ahora tienes este magnífico equipamiento para mantenerte ocupado.",
  },
  {
    "key": "conversation_r70wn4_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ozgox8_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tómate tu tiempo para buscar con cuidado, ¿de acuerdo?",
  },
  {
    "key": "conversation_ozgox8_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_crg8xl_text",
    "metadata": {
      "notes": "*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    },
    "value": "Te daré otra heliografía cuando me enseñes {var num_artifacts_threshold} artefactos {image artifacts_small} en total.",
  },
  {
    "key": "conversation_crg8xl_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_rkqt88_text",
    "metadata": {
      "notes": "*new* removed "wonderful" as it conflicted with previous lines in some cases",
    },
    "value": "Te has esforzado mucho y creo que me has traído todos los objetos más fascinantes de este planeta.",
  },
  {
    "key": "conversation_rkqt88_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_4ngqs0_text",
    "value": "Menos mal, porque creo que ya no tengo más heliografías.",
  },
  {
    "key": "conversation_4ngqs0_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_75th6d_text",
    "value": "Cuando era un bot joven y bien engrasado como tú, solía vagar por la mina, dibujando mapas maravillosos.",
  },
  {
    "key": "conversation_75th6d_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_wvg349_text",
    "value": "Dibujé un mapa de todo el muro protector, mucho antes de que mis rodillas comenzaran a rechinar y crujir.",
  },
  {
    "key": "conversation_wvg349_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_90qcuc_text",
    "value": "Comencé con las capas más bajas, pero esos irracionales licoreros eran toda una molestia.",
  },
  {
    "key": "conversation_90qcuc_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_pffrd2_text",
    "value": "Esas criaturas no tienen respeto por la artesanía fina. ¿Atreverse a usar explosivos caseros en tal monumento? ¡Ridículo!",
  },
  {
    "key": "conversation_pffrd2_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_fc5nyv_text",
    "value": "Por supuesto, el muro absorbió la mayoría del impacto, pero de vez en cuando logran penetrarlo.",
  },
  {
    "key": "conversation_fc5nyv_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_219b44_text",
    "value": "¿Ha estado alguna vez en el templo que está al otro lado de las Llanuras Ventosas?",
  },
  {
    "key": "conversation_219b44_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0anv7h_text",
    "value": "Esas ruinas están poco exploradas. El templo siempre ha sido muy traicionero.",
  },
  {
    "key": "conversation_0anv7h_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tv8uil_text",
    "value": "Un viejo colega, Ronald Hubot, fue el único que se {format emph}atrevió{format reset} a adentrarse en ese lugar.",
  },
  {
    "key": "conversation_tv8uil_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_u57vpi_text",
    "value": "¿Qué ha sido de él?",
  },
  {
    "key": "conversation_u57vpi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_g8rvft_text",
    "value": "Pues parece ser que tuvo una especie de visión horrible que profetizaba el fin del mundo.",
  },
  {
    "key": "conversation_g8rvft_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_02chim_text",
    "value": "Se ha refugiado en el templo y se rodea de locobots de todo tipo.",
  },
  {
    "key": "conversation_02chim_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_i026up_text",
    "value": "Puedo imaginarme la de artefactos maravillosos {image artifacts_small} que hay en esas ruinas.",
  },
  {
    "key": "conversation_i026up_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tvge9q_text",
    "value": "Debe haber muchos {format emph}tesoros{format reset} de artefactos {image artifacts_small} olvidados en lo más profundo de las minas.",
  },
  {
    "key": "conversation_tvge9q_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_iyk7r0_text",
    "value": "Imagina todas esas reliquias que han dejado culturas desaparecidas hace siglos, esperando ser descubiertas.",
  },
  {
    "key": "conversation_iyk7r0_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_hp4wcb_text",
    "value": "¡Qué época tan maravillosa para vivir! Hace siglos que los bots no se aventuran a tanta profundidad como tú.",
  },
  {
    "key": "conversation_hp4wcb_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ekx3en_text",
    "value": "Deberías ir a mayor profundidad todavía. Recuerda que la historia favorece a los valientes.",
  },
  {
    "key": "conversation_ekx3en_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_bb807w_text",
    "value": "El desierto del oeste es un lugar duro y árido, aun así, los bots han vivido en él durante siglos.",
  },
  {
    "key": "conversation_bb807w_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_6e53tq_text",
    "value": "Estoy seguro de que debe haber algo fascinante por allí, escondido entre rocas y arena.",
  },
  {
    "key": "conversation_6e53tq_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_ja68cp_text",
    "value": "La verdad es que me encantan esos maravillosos artefactos.",
  },
  {
    "key": "conversation_ja68cp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_9w2c24_text",
    "value": "Normalmente la tierra tarda {format emph}eones{format reset} en cambiar su estructura geológica.",
  },
  {
    "key": "conversation_9w2c24_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_aactqp_text",
    "value": "Pero los terremotos parecen tener la fuerza suficiente para cambiar la disposición de la tierra en solo décadas.",
  },
  {
    "key": "conversation_aactqp_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_fn5brp_text",
    "value": "Pronto terminaremos con esos terremotos.",
  },
  {
    "key": "conversation_fn5brp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_d0c0zs_text",
    "value": "¿Y si el suelo se resquebraja totalmente? Entonces mis mapas serán inútiles. ¡Qué escándalo!",
  },
  {
    "key": "conversation_d0c0zs_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_w56u9v_text",
    "value": "El último terremoto fue extremadamente problemático.",
  },
  {
    "key": "conversation_w56u9v_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mcnumi_text",
    "value": "Tal vez la profesora Sherman tenga razón y la tierra esté a punto de hacerse pedazos.",
  },
  {
    "key": "conversation_mcnumi_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_mq34gi_text",
    "value": "Estamos haciendo todo lo que podemos para que eso no suceda.",
  },
  {
    "key": "conversation_mq34gi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h0mzw3_text",
    "value": "Aprender a dibujar mapas de las estrellas debe de ser un reto magnífico.",
  },
  {
    "key": "conversation_h0mzw3_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_uyr4r4_text",
    "metadata": {
      "notes": "This person id located upp on a trellis with a fantastic view.",
    },
    "value": "{format singsong}¡Hola, amiga!{format reset} La vista es genial desde aquí, ¿no crees? ¡Nuestro alcalde es un tipo con suerte!",
  },
  {
    "key": "conversation_uyr4r4_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_w3sayh_text",
    "value": "Aunque debería poner más atención a las palabras de la profesora. ¡Estos temblores no desaparecerán por sí solos!",
  },
  {
    "key": "conversation_w3sayh_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_cww3zx_text",
    "value": "El alcalde no está. Me pregunto cuándo regresará.",
  },
  {
    "key": "conversation_cww3zx_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_0g6nsc_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Es una bomba eso que traes?",
  },
  {
    "key": "conversation_0g6nsc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_474v8c_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Te lo ruego, dime que vas a volar este horroroso edificio en mil pedazos.",
  },
  {
    "key": "conversation_474v8c_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_o24esm_text",
    "value": "{format laugh}¡Sí!{format reset} Es decir, ¡no!",
  },
  {
    "key": "conversation_o24esm_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_yi4qcu_text",
    "metadata": {
      "notes": "*new* changed water bomb to pressure bomb",
    },
    "value": "Quería mostrarle al alcalde Yonker mi nueva bomba presurizada mejorada. ¡Es justo lo que esta ciudad necesita!",
  },
  {
    "key": "conversation_yi4qcu_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_bqmi7g_text",
    "value": "Y..., me ha ignorado y solo me ha dicho que lo presente en su oficina. Pero aquí no hay nadie...",
  },
  {
    "key": "conversation_bqmi7g_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_5kay5a_text",
    "value": "Aunque no me importa esperar. Apuesto a que el alcalde regresará pronto. Supongo, tal vez, no sé..., pronto.",
  },
  {
    "key": "conversation_5kay5a_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_73lt57_text",
    "value": "Las bombas sirven para muchas cosas, ¿sabes? Las puedes usar para {format emph}todo{format reset}. Bueno, casi todo.",
  },
  {
    "key": "conversation_73lt57_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_2t4ktx_text",
    "value": "Puedes excavar túneles, romper rocas duras ricas en minerales, despejar escombros y restos...",
  },
  {
    "key": "conversation_2t4ktx_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_tkp0i2_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "¡Y no te olvides de que también puedes causar destrucción sin sentido!",
  },
  {
    "key": "conversation_tkp0i2_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2ynw9y_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Antes se pasaban día y noche explotando abajo, en las minas. ¡Eso era música para mis oídos!",
  },
  {
    "key": "conversation_2ynw9y_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_2vgr7k_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "¡Genial, detonaciones letales!",
  },
  {
    "key": "conversation_2vgr7k_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4nhr7x_text",
    "metadata": {
      "notes": "*new* changed pressurized water bomb to pressure bomb",
    },
    "value": "Espero tener la oportunidad de hablar con el alcalde y que acepte el diseño de mi nueva bomba presurizada. Es lo más avanzado que puede haber.",
  },
  {
    "key": "conversation_4nhr7x_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_gbuars_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "¡Este tipo sabe lo que es bueno!",
  },
  {
    "key": "conversation_gbuars_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_h4evh3_text",
    "metadata": {
      "notes": "This is Dorothy talking",
    },
    "value": "Me alegro de que hayas encontrado a alguien que tiene algo común en contigo, pero preferiría que no fueran las explosiones.",
  },
  {
    "key": "conversation_h4evh3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_v0gx3y_text",
    "value": "Apuesto a que puedo convencer al alcalde de que mis bombas son el futuro.",
  },
  {
    "key": "conversation_v0gx3y_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_hwchba_text",
    "value": "Una vez el señor Bittenborough me trajo la carcasa de los restos de una bomba. Me dijo que lo había encontrado en territorio licorero.",
  },
  {
    "key": "conversation_hwchba_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_q0vd7o_text",
    "value": "¡Me dieron ganas de vomitar con solo verlo! ¿Sabías que los licoreros fabrican sus bombas con {format nervous}nitroglicerina y Fermento Lunar?{format reset}",
  },
  {
    "key": "conversation_q0vd7o_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_shtyfr_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "¿Y eso es malo por qué? Explota, ¿o no?",
  },
  {
    "key": "conversation_shtyfr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4nsm4v_text",
    "value": "Claro que explota. ¡Y te destroza los dedos, si es que tienes suerte!",
  },
  {
    "key": "conversation_4nsm4v_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_s7nbis_text",
    "metadata": {
      "notes": "*format* *new* changed pressurized water bomb to pressure bomb",
    },
    "value": "¡No, gracias! Prefiero seguir con mis estables y seguras bombas de agua presurizadas.",
  },
  {
    "key": "conversation_s7nbis_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_p2i5l7_text",
    "metadata": {
      "notes": "*format* *new* removed "..."",
    },
    "value": "Sosainas.",
  },
  {
    "key": "conversation_p2i5l7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ptgzep_text",
    "value": "Ten cuidado allá abajo. Esos licoreros son muy brutos.",
  },
  {
    "key": "conversation_ptgzep_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_l8kkmb_text",
    "value": "¿Has visto el nuevo cohete de la profesora Sherman? ¡Es una hermosura!",
  },
  {
    "key": "conversation_l8kkmb_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_9yditf_text",
    "metadata": {
      "notes": "This is Dororthy talking",
    },
    "value": "Sí, es muy impresionante.",
  },
  {
    "key": "conversation_9yditf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b8svck_text",
    "value": "Y totalmente seguro. ¡Yo mismo la he ayudado con los cálculos!",
  },
  {
    "key": "conversation_b8svck_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_wz8w9f_text",
    "value": "Se necesita muchísima presión para lanzar algo así al espacio. Todo debe estar perfectamente calibrado, ¡hasta el último decimal!",
  },
  {
    "key": "conversation_wz8w9f_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_516qkn_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Porque, al final, un cohete es como una bomba gigante, ¿no?",
  },
  {
    "key": "conversation_516qkn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_8ly6iv_text",
    "metadata": {
      "notes": "This is Fen talking",
    },
    "value": "Esto me gusta. ¿Por qué no le pedimos a la profesora que nos dé una vuelta?",
  },
  {
    "key": "conversation_8ly6iv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_pawve3_text",
    "metadata": {
      "notes": "This is Dorothy talking",
    },
    "value": "Ya veremos después, Fen.",
  },
  {
    "key": "conversation_pawve3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sqkxyn_text",
    "value": "No te preocupes. ¡Nunca cometo ningún error cuando se trata de bombas!",
  },
  {
    "key": "conversation_sqkxyn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ha9646_text",
    "value": "He estado pensando sobre los terremotos. Un terremoto no es más que una vibración grande y violenta, ¿cierto?",
  },
  {
    "key": "conversation_ha9646_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_fs869d_text",
    "value": "{format singsong}Así que...{format reset}, si pudiéramos crear una vibración igualmente grande y violenta, pero {format emph}opuesta{format reset}, ¡al encontrarse se deberían anular!",
  },
  {
    "key": "conversation_fs869d_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_1frwlw_text",
    "value": "Eh... ¿Estás diciendo lo que pienso que estás diciendo...?",
  },
  {
    "key": "conversation_1frwlw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qd7crv_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Exacto! ¡Bombas! ¡Solo necesitamos establecer una red de bombas sincronizadas para contrarrestar los temblores!",
  },
  {
    "key": "conversation_qd7crv_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_t8xdab_text",
    "value": "¡Genial! Es un plan a prueba de fallos.",
  },
  {
    "key": "conversation_t8xdab_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_50z3oe_text",
    "value": "¡Me alegro que estés de acuerdo! Solo necesito trabajar un par de años para hacer los cálculos. ¡La seguridad es lo primero!",
  },
  {
    "key": "conversation_50z3oe_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_wdv8yf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ay...",
  },
  {
    "key": "conversation_wdv8yf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_dx83ih_text",
    "value": "Estoy ansioso por contarle mi plan al alcalde Yonker. ¡Apuesto a que lo aprobará! Me pregunto cuándo regresará. Ya ha pasado bastante tiempo.",
  },
  {
    "key": "conversation_dx83ih_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_hu5cr9_text",
    "value": "No me gusta nada todo este chismorreo sobre el gran terremoto. Es mucho lo que ignoramos. ¿Cómo de intenso? ¿Cuándo tendrá lugar? ¿Dónde?",
  },
  {
    "key": "conversation_hu5cr9_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_achdi1_text",
    "value": "Desde que el elevador se desplomó, he estado pensando qué sucedería si un terremoto {format emph}realmente{format reset} fuerte tiene lugar.",
  },
  {
    "key": "conversation_achdi1_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_k2l3ob_text",
    "value": "La profesora Sherman piensa que será mucho peor, antes de que siquiera mejore.",
  },
  {
    "key": "conversation_k2l3ob_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ioi3ht_text",
    "value": "Es mejor que hagas caso a sus palabras. Es el bot más inteligente de por aquí.",
  },
  {
    "key": "conversation_ioi3ht_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_5oey6i_text",
    "value": "Comienzo a pensar que el alcalde no regresará a su oficina.",
  },
  {
    "key": "conversation_5oey6i_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_xoknkn_text",
    "metadata": {
      "notes": "*format* *new* changed format from laugh to singsong",
    },
    "value": "{format singsong}¡Guau!{format reset} ¿Es eso un... lanzagranadas presurizado? ¡Claro que lo es! Y además, el modelo de lujo.",
  },
  {
    "key": "conversation_xoknkn_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_uhq93q_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Eres una... amante de las bombas igual que yo?",
  },
  {
    "key": "conversation_uhq93q_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_8o8ba8_text",
    "value": "¡Tengo que mostrarte mi proyecto secreto! ¡Vaya, cuántas {format nervous}ganas{format reset} tenía de compartir esto con otro entusiasta como yo!",
  },
  {
    "key": "conversation_8o8ba8_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ux8mwy_text",
    "metadata": {
      "notes": "*new* changed format from highligh to emph",
    },
    "value": "Si le aplicamos mi mejora, que pronto será patentada, ¡tu lanzagranadas puede causar {format emph}el triple de destrucción{format reset}!",
  },
  {
    "key": "conversation_ux8mwy_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_4urlt2_text",
    "value": "Te dejaría probarlo en acción, pero..., {format singsong}es queeeee{format reset}... mi presupuesto de I+D está algo limitado últimamente.",
  },
  {
    "key": "conversation_4urlt2_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_uxln27_text",
    "value": "Pero, si contribuyeras con, digamos, \${var pricelist_next:blueprint_vendor_02}{image money_small}, te prometo que tendrás una {format highlight}heliografía{format reset} de mi invención exclusiva para patrocinadores. ¿Qué te parece?",
  },
  {
    "key": "conversation_uxln27_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_dgw94e_text",
    "value": "Por cierto, ¿has pensado sobre la donación? Son solo \${var pricelist_next:blueprint_vendor_02}{image money_small} por la posibilidad de usar esta exclusiva {format highlight}heliografía{format reset}.",
  },
  {
    "key": "conversation_dgw94e_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_20o2j5_text",
    "metadata": {
      "notes": "*format* *new* split this line up",
    },
    "value": "¡Maravilloso! Aquí tienes, ¡es toda tuya!",
  },
  {
    "key": "conversation_20o2j5_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_52n8bq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tendrás que usarla en el banco de trabajo para modificar tu cañón.",
  },
  {
    "key": "conversation_52n8bq_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_9p7l5p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿A que esperas? ¡Ve y vuela algo en mil pedazos!",
  },
  {
    "key": "conversation_9p7l5p_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_gui6im_text",
    "value": "Parece que también andas mal de plata. ¡No te preocupes! Puedes regresar cuando tengas algo de dinero.",
  },
  {
    "key": "conversation_gui6im_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_ijkhew_text",
    "value": "¡Te comprendo perfectamente! Regresa si cambias de opinión.",
  },
  {
    "key": "conversation_ijkhew_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_02qawb_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Y, ¿qué tal la heliografía? ¿Has encontrado ya algo interesante que quieras volar por los aires?",
  },
  {
    "key": "conversation_02qawb_text.Speaker",
    "value": "Clifford Heisenberg",
  },
  {
    "key": "conversation_1hq43e_text",
    "metadata": {
      "notes": "This Character is a mail man/pony express person.",
    },
    "value": "Oye tú, camarada. Con estos terremotos, entregar el correo a tiempo se ha convertido en una tarea más bien peligrosa.",
  },
  {
    "key": "conversation_1hq43e_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_k6q6hf_text",
    "value": "Me ha dicho uno de los jinetes que en el desierto están apareciendo socavones.",
  },
  {
    "key": "conversation_k6q6hf_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_ple2sp_text",
    "value": "El desierto ya no es seguro para los jinetes exprés.",
  },
  {
    "key": "conversation_ple2sp_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_dum6i9_text",
    "value": "Lo siento, no te puedo ayudar con ninguna entrega ahora, camarada.",
  },
  {
    "key": "conversation_dum6i9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_qy63x4_text",
    "value": "Todos nuestros jinetes están ocupados, los pobres.",
  },
  {
    "key": "conversation_qy63x4_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_4nc6nw_text",
    "value": "¿Por qué no ha ido usted con el resto?",
  },
  {
    "key": "conversation_4nc6nw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_aozfk3_text",
    "value": "No hay nada más {format nervous}claustrofóbico{format reset} que las vastas llanuras. Miles de kilómetros donde no hay nada.",
  },
  {
    "key": "conversation_aozfk3_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_opkpi5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Me siento atrapado con solo pensarlo.",
  },
  {
    "key": "conversation_opkpi5_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_opmgdu_text",
    "value": "No hay nada más terrorífico que las vastas llanuras, camarada.",
  },
  {
    "key": "conversation_opmgdu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_384qc9_text",
    "value": "Nuestros ponis han andado por todo el desierto. Esos terremotos se han sentido por todos lados, camarada.",
  },
  {
    "key": "conversation_384qc9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_c3vack_text",
    "value": "Los malditos terremotos causan problemas en todos esos pueblitos que están más allá de los templos antiguos.",
  },
  {
    "key": "conversation_c3vack_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_alusmw_text",
    "value": "Tenemos muchos problemas para transportar los minerales importados hasta aquí.",
  },
  {
    "key": "conversation_alusmw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_5nkkkg_text",
    "value": "Muchos de los negocios en esta ciudad están fundamentados en importar mercancías de toda la llanura.",
  },
  {
    "key": "conversation_5nkkkg_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_1u0u2r_text",
    "value": "El Pony Express de Vapor es normalmente la mejor manera de llegar allí.",
  },
  {
    "key": "conversation_1u0u2r_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_2ufqac_text",
    "value": "El Pony Express de Vapor tiene una reputación que mantener. No quiero que estos terremotos empañen su fama, camarada.",
  },
  {
    "key": "conversation_2ufqac_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_7idj7v_text",
    "value": "¿Alguno de tus ponis ha estado en los templos?",
  },
  {
    "key": "conversation_7idj7v_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vfl4c6_text",
    "metadata": {
      "notes": "*new* removed reference to Ron",
    },
    "value": "Qué pregunta tan curiosa, camarada. Hace un mes tuvimos un pedido urgente que entregar en el templo del este.",
  },
  {
    "key": "conversation_vfl4c6_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_51nddn_text",
    "metadata": {
      "notes": "*new* changes to phrasing",
    },
    "value": "Tuvimos que enviar a alguien a través de las Llanuras Ventosas.",
  },
  {
    "key": "conversation_51nddn_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_hsitea_text",
    "metadata": {
      "notes": "*new* removed "pardner".",
    },
    "value": "Se necesitan las piernas más fuertes del mundo para atravesar esos vientos tan fuertes.",
  },
  {
    "key": "conversation_hsitea_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_g6i2qw_text",
    "metadata": {
      "notes": "*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    },
    "value": "Habían pedido un montón de braseros antiguos y los quería lo antes posible.",
  },
  {
    "key": "conversation_g6i2qw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_j223bu_text",
    "value": "Supongo que los necesitaba para algo relacionado con esa extraña secta suya.",
  },
  {
    "key": "conversation_j223bu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_p4ogy4_text",
    "value": "Alguien que quiera cruzar las Llanuras Ventosas hacia el este tendrá que saber cómo vérselas con el viento en contra, camarada.",
  },
  {
    "key": "conversation_p4ogy4_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_pgpn5x_text",
    "value": "He escuchado por ahí que estás excavando en lo más profundo, camarada.",
  },
  {
    "key": "conversation_pgpn5x_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_2ir3fn_text",
    "value": "Sí, estamos buscando a mi amigo. Creo que está allí abajo.",
  },
  {
    "key": "conversation_2ir3fn_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_l0q9lw_text",
    "metadata": {
      "notes": "*new* doggone to coggone",
    },
    "value": "A veces me gustaría largarme de este condenado pueblo y visitar nuevos lugares.",
  },
  {
    "key": "conversation_l0q9lw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_l0wgkw_text",
    "value": "Pero entonces me llegan rumores de selvas peligrosas creciendo en las cuevas.",
  },
  {
    "key": "conversation_l0wgkw_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_qgwwxu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Empiezo a pensar en todos los secretos y peligros que aguardan ahí abajo.",
  },
  {
    "key": "conversation_qgwwxu_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_5phwat_text",
    "value": "Mi corazón me da un {format nervous}vuelco{format reset} y me tiemblan las piernas.",
  },
  {
    "key": "conversation_5phwat_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_cp57ox_text",
    "value": "¡Por mis espuelas! Soy el pedazo de lata más cobarde que hayas visto jamás.",
  },
  {
    "key": "conversation_cp57ox_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_x5lp6f_text",
    "value": "A veces desearía no ser tan gallina. El mundo está lleno de cosas que explorar y aquí estoy perdiéndomelas todas.",
  },
  {
    "key": "conversation_x5lp6f_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_w4by19_text",
    "value": "Los terremotos son cada vez peores. Siento cómo mis cuatro rodillas entrechocan.",
  },
  {
    "key": "conversation_w4by19_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_d4gln9_text",
    "value": "Estoy pensando que tendremos que escaparnos en ese cohete, más pronto de lo que creíamos.",
  },
  {
    "key": "conversation_d4gln9_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_w15szm_text",
    "value": "Aunque no me gusta para nada pensar que estaré rodeado solo de cielo.",
  },
  {
    "key": "conversation_w15szm_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_jnag7u_text",
    "value": "Pero, si el planeta va a hacerse pedazos, ¿qué otra opción me queda?...",
  },
  {
    "key": "conversation_jnag7u_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_oawrk7_text",
    "value": "Supongo que al fin tendré que abandonar mi entorno seguro, camarada.",
  },
  {
    "key": "conversation_oawrk7_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_e1e8ry_text",
    "value": "Si el planeta entero va a estallar, me gustaría vivir una aventura, al fin y al cabo",
  },
  {
    "key": "conversation_e1e8ry_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_cqe4nv_text",
    "value": "¡Saludetes, camarada! Es genial tener a un minero local como tú, con todos estos temblores sacudiendo estas tierras.",
  },
  {
    "key": "conversation_cqe4nv_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_jm66o2_text",
    "value": "...",
  },
  {
    "key": "conversation_jm66o2_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_igsxan_text",
    "value": "¿Estás haciendo una reverencia frente a una {format emph}estatua de Rusty{format reset}?",
  },
  {
    "key": "conversation_igsxan_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1voalp_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sí..., el gran Rusty es el destructor de la profecía.",
  },
  {
    "key": "conversation_1voalp_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_pd5hzj_text",
    "metadata": {
      "notes": "*new* removed reference to Ron and expanded the text format",
    },
    "value": "Lo predijo nuestro gran profeta. Ha predicho que el {format singsong}sagrado final{format reset} se acerca.",
  },
  {
    "key": "conversation_pd5hzj_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_y6xyie_text",
    "value": "Vaya, ustedes encuentran cualquier motivo para adorar por doquier, ¿verdad?",
  },
  {
    "key": "conversation_y6xyie_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_e76l4q_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Luz del consejo! ¡Esta hereje te ha robado del Templo del Consejo!",
  },
  {
    "key": "conversation_e76l4q_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_qo16zi_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Sacrificaré sus partes en el fuego redentor!",
  },
  {
    "key": "conversation_qo16zi_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_mdyvq0_text",
    "value": "¡Oye, tú! Vaya, creí que {format nervous}nunca naiden me encontraría{format reset}.",
  },
  {
    "key": "conversation_mdyvq0_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_zcgves_text",
    "value": "No e' que e'té perdido ni na' pareci'o, ¡pero e' bastante difícil llegar ha'ta aquí!",
  },
  {
    "key": "conversation_zcgves_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_ara3qe_text",
    "metadata": {
      "notes": ""Feels like Ah should give..." is "Feels like I should give..."",
    },
    "value": "Creo que hay que recompensa'te por tu esfuerzo. Pero lo único que tengo e' e'ta heliografía.",
  },
  {
    "key": "conversation_ara3qe_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_2ebftt_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Sólo recuerda que activar e'to puede que {format danger}dificulte{format reset} tu viaje.",
  },
  {
    "key": "conversation_2ebftt_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_6jeiwp_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Na' más deberías usarlo si busca' má' desafíos.",
  },
  {
    "key": "conversation_6jeiwp_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_pvpsai_text",
    "value": "No te preocupe', no e'toy perdido. Solo e'toy de'cansando un poco.",
  },
  {
    "key": "conversation_pvpsai_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_jbfsb5_text",
    "value": "Mi hermano pequeño e' tan tonto, ha cerra'o el sistema de transporte.",
  },
  {
    "key": "conversation_jbfsb5_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_rq43xc_text",
    "value": "Dice que no era seguro o argo así, no le he pre'ta'o mucha atención.",
  },
  {
    "key": "conversation_rq43xc_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_v4t07d_text",
    "value": "A vece' pienso que la posición de mi hermano de "alcalde de lo' negocio'" se le ha subi'o a la cabeza.",
  },
  {
    "key": "conversation_v4t07d_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_y4mgz6_text",
    "value": "Voy a extrañar eso' tubo', era tan fácil subirse y pasear... Ahora tengo que regresa' caminando a casa.",
  },
  {
    "key": "conversation_y4mgz6_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_9kai6i_text",
    "value": "Esto' desierto' están conectado' a cosa' muy extraña', créeme.",
  },
  {
    "key": "conversation_9kai6i_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_1hh5hs_text",
    "value": "He vi'to a eso' sectario' loco' en la entrada del viejo templo.",
  },
  {
    "key": "conversation_1hh5hs_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_vpsiim_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "No me agradan mucho to'a' su' tontería', su' reunione' masiva' y to' lo que hacen por ahí.",
  },
  {
    "key": "conversation_vpsiim_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_efhbif_text",
    "value": "Esta' mina' pueden volver loco a cualquier bot si pasa mucho tiempo aquí.",
  },
  {
    "key": "conversation_efhbif_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_914qie_text",
    "value": "Creo que me quedaré un poco má'. Uno se cansa de trabaja' duro...",
  },
  {
    "key": "conversation_914qie_text.Speaker",
    "value": "Zebulon Yonker",
  },
  {
    "key": "conversation_ppa3hq_text",
    "value": "¡{format emph}Vaya{format reset}, me pareció escuchar a uno de esos {format nervous}licoreros locos{format reset}!",
  },
  {
    "key": "conversation_ppa3hq_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_rtaarn_text",
    "value": "No sé qué pensar de este sitio, es totalmente distinto de todo lo que he conocido antes.",
  },
  {
    "key": "conversation_rtaarn_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_rqui5d_text",
    "value": "¡Pero es todo un placer encontrarme con un camarada bot en este extraño lugar!",
  },
  {
    "key": "conversation_rqui5d_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_xpaj1a_text",
    "metadata": {
      "notes": "Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    },
    "value": "Toma esta heliografía como agradecimiento por hacerme compañía.",
  },
  {
    "key": "conversation_xpaj1a_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_5zxme4_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Tengo que advertirte de algo: activar esto podría {format danger}dificultar{format reset} la misión.",
  },
  {
    "key": "conversation_5zxme4_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_ncsd4z_text",
    "value": "¡No se te ocurra usarla si no buscas mayores desafíos!",
  },
  {
    "key": "conversation_ncsd4z_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_yp736j_text",
    "value": "¡Hola de nuevo, camarada bot!",
  },
  {
    "key": "conversation_yp736j_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_g21tdm_text",
    "value": "Mis hermanos aseguran que han construido la mayoría del nuevo muro que hay por aquí, pero yo sé que no es así.",
  },
  {
    "key": "conversation_g21tdm_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_iehmo4_text",
    "value": "Cierto que lo han reparado por aquí y por allá, pero el muro se construyó hace siglos.",
  },
  {
    "key": "conversation_iehmo4_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_aytv9n_text",
    "value": "Están tan henchidos de orgullo absurdo que un día van a salir flotando.",
  },
  {
    "key": "conversation_aytv9n_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_8srkg6_text",
    "value": "Pero si hay algo que he aprendido, es que siempre hay una manera de atravesar cualquier muro.",
  },
  {
    "key": "conversation_8srkg6_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_vb6b0a_text",
    "value": "Te aseguro que he visto varios hongos migrando hace poco.",
  },
  {
    "key": "conversation_vb6b0a_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_0yu226_text",
    "value": "¿Cuánto tiempo crees que tardarán en llegar al pueblo?",
  },
  {
    "key": "conversation_0yu226_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_onpk10_text",
    "value": "Voy a sentarme a disfrutar un poco de esta loca vida salvaje antes de regresar.",
  },
  {
    "key": "conversation_onpk10_text.Speaker",
    "value": "Luke Yonker",
  },
  {
    "key": "conversation_xfyeov_text",
    "value": "¡Vaya, pues e'taba construyendo y reparando cuando de repente me di cuenta de que m'había olvida'o de mi' herramienta'!",
  },
  {
    "key": "conversation_xfyeov_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_t1bq4v_text",
    "value": "Si puede' mantener el pico cerra'o, te daré un documento que parece muy importante.",
  },
  {
    "key": "conversation_t1bq4v_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_odkj11_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "Hará tus aventuras un poquillo má'... {format danger}desafiantes{format reset}.",
  },
  {
    "key": "conversation_odkj11_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_nvlvnn_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "¡Na' má' úsalo si te gu'ta reírte der peligro!",
  },
  {
    "key": "conversation_nvlvnn_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_ajyl7v_text",
    "metadata": {
      "notes": "*NEW*",
    },
    "value": "No hay necesida' de comentárselo a mi' hermano', ¿vale?",
  },
  {
    "key": "conversation_ajyl7v_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_zdkcdy_text",
    "value": "¡Me alegra saber que pensamo' igual!",
  },
  {
    "key": "conversation_zdkcdy_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_wpy2vc_text",
    "value": "No hay necesida' de decirle a mi' hermano' que me ha' vi'to aquí.",
  },
  {
    "key": "conversation_wpy2vc_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_0fsp3k_text",
    "value": "Soy todo un profe..., prife..., {format emph}un experto{format reset} construyendo muro', lo juro.",
  },
  {
    "key": "conversation_0fsp3k_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_l2xfyd_text",
    "value": "Si tan solo lo' licorero' fueran má' amable' y se quedaran en su la'o.",
  },
  {
    "key": "conversation_l2xfyd_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_a09h0a_text",
    "value": "No tengo tiempo pa' buscar por todo' lado' y ver si todo e'tá en su lugar.",
  },
  {
    "key": "conversation_a09h0a_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_sy2ct5_text",
    "value": "No he vi'to a ningún licorero de'de hace muncho tiempo. Ante' de que lo' terremoto' comenzaran lo' veía mu' a menudo.",
  },
  {
    "key": "conversation_sy2ct5_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_w8p7tf_text",
    "value": "Si mi' hermano' descubren que me he empareda'o a mí mi'mo, no pararían de reírse.",
  },
  {
    "key": "conversation_w8p7tf_text.Speaker",
    "value": "Josh Yonker",
  },
  {
    "key": "conversation_rbdoyh_text",
    "value": ""Pasaje de la Roca Rojiza"",
  },
  {
    "key": "conversation_rbdoyh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jofluh_text",
    "value": "¡Guau! Mira ese cráter {format singsong}¡Qué gloriosa destrucción!{format reset}",
  },
  {
    "key": "conversation_jofluh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rgfncb_text",
    "value": "Esperemos que la profesora esté progresando bastante con lo del cohete.",
  },
  {
    "key": "conversation_rgfncb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1mx9ap_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Hmm... ¡ojalá le haya añadido láseres y cosas así!",
  },
  {
    "key": "conversation_1mx9ap_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_z6izd0_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Quién osa presentarse ante el gran profeta del Destructor?",
  },
  {
    "key": "conversation_z6izd0_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_cu9az7_text",
    "value": "¡Oye, conozco a este tipo! Es uno de los que me trajeron al templo.",
  },
  {
    "key": "conversation_cu9az7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4ljao8_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Luz del consejo! ¿Qué haces con este bot indigno aquí en mi templo?",
  },
  {
    "key": "conversation_4ljao8_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_m8bbt4_text",
    "value": "¿Dónde está Rusty? ¿Qué {format emph}le has hecho?{format reset}",
  },
  {
    "key": "conversation_m8bbt4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6jm46x_text",
    "metadata": {
      "notes": "*new* moved text format to other words.",
    },
    "value": "Tal como he predicho, Rusty el Destructor causará {format laugh}el gran terremoto{format reset} y nos desharemos de nuestras carcasas mortales.",
  },
  {
    "key": "conversation_6jm46x_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_mhn5s6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Nos bendijo con este generador apocalíptico! Después nos abandonó. Sus caminos son siempre inescrutables.",
  },
  {
    "key": "conversation_mhn5s6_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_davhio_text",
    "value": "...",
  },
  {
    "key": "conversation_davhio_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_39dqwa_text",
    "value": "¡Entonces tengo que desactivar esa máquina!",
  },
  {
    "key": "conversation_39dqwa_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_f5igne_text",
    "metadata": {
      "notes": "*format* removed one of the text formats",
    },
    "value": "¡Exacto! Dinos dónde has escondido ese generador apocalíptico. ¡Lo {format laugh}volaremos en mil pedazos{format reset}!",
  },
  {
    "key": "conversation_f5igne_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_t03c7h_text",
    "value": "Oh, luz del consejo, qué bajo has caído. ¡No permitiré que arruinéis nuestro precioso apocalipsis!",
  },
  {
    "key": "conversation_t03c7h_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_5ppdcr_text",
    "value": "{format nervous}¡Aaah!{format reset} No podrán evitar que suceda el {format laugh}gran terremoto.{format reset}",
  },
  {
    "key": "conversation_5ppdcr_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_veu3hm_text",
    "value": "El generador apocalíptico está a salvo. ¡El fin está {format singsong}cercaaaa!{format reset}",
  },
  {
    "key": "conversation_veu3hm_text.Speaker",
    "value": "Great Prophet",
  },
  {
    "key": "conversation_1l6ojp_text",
    "metadata": {
      "notes": "There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    },
    "value": ""¡Cuidado con el muro imaginario!".",
  },
  {
    "key": "conversation_1l6ojp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cp9bbp_text",
    "metadata": {
      "notes": "*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    },
    "value": "Vamos, ¿aún nada?",
  },
  {
    "key": "conversation_cp9bbp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_p1i3bn_text",
    "metadata": {
      "notes": "*new* changed an I to a We.",
    },
    "value": "Solo tenemos que {format highlight}encender todos los braseros{format reset} para activar los cristales.",
  },
  {
    "key": "conversation_p1i3bn_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xqev6z_text",
    "metadata": {
      "notes": "*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    },
    "value": "¡Deben de estar en algún lugar cercano!",
  },
  {
    "key": "conversation_xqev6z_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_kk5j23_text",
    "metadata": {
      "notes": "*new* changed the phrasing to be more Fen-like",
    },
    "value": "¡De acuerdo, vamos a prenderles fuego de una vez!",
  },
  {
    "key": "conversation_kk5j23_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4dihd5_text",
    "metadata": {
      "notes": "*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    },
    "value": "Sí, todavía no has encendido todos los braseros.",
  },
  {
    "key": "conversation_4dihd5_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7gz2cu_text",
    "value": ""¡LA MUERTE ESPERA!"",
  },
  {
    "key": "conversation_7gz2cu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8fufl9_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Oh, Gran Destructor, ¡el final se acerca!",
  },
  {
    "key": "conversation_8fufl9_text.Speaker",
    "value": "Cultist",
  },
  {
    "key": "conversation_bj94jz_text",
    "value": "¿Por qué no lo has hecho? ¡Vamos!",
  },
  {
    "key": "conversation_bj94jz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_i7wge8_text",
    "metadata": {
      "notes": "*new* made it clear that it's only the pipe to the oasis that is closed",
    },
    "value": "¡Que extraño..., el tubo que conduce de vuelta a El Oasis no funciona!",
  },
  {
    "key": "conversation_i7wge8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_t6jhkm_text",
    "metadata": {
      "notes": "*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    },
    "value": "Esto huele cada vez peor. Quizá el sistema está obstruido otra vez.",
  },
  {
    "key": "conversation_t6jhkm_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kbmx5q_text",
    "metadata": {
      "notes": "*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    },
    "value": "Parece que tendremos que excavar el último tramo para llegar hasta allí.",
  },
  {
    "key": "conversation_kbmx5q_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_dhpyma_text",
    "metadata": {
      "notes": "*new* changed this to not refert to whole tube system",
    },
    "value": "¡El sistema de tubos que conduce a El Oasis está roto!",
  },
  {
    "key": "conversation_dhpyma_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xdvi4z_text",
    "metadata": {
      "notes": "*new* added a "come on then,"",
    },
    "value": "Bueno, entonces encontremos {format highlight}otro camino para llegar a El Oasis.{format reset}",
  },
  {
    "key": "conversation_xdvi4z_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_efpvk6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Has... has regresado!",
  },
  {
    "key": "conversation_efpvk6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xs0zex_text",
    "value": "Sí, no sé cómo he logrado salir, pero te dije que volvería.",
  },
  {
    "key": "conversation_xs0zex_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_2gp05g_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Estaba solo otra vez... atascado. Debí... debí de quedarme dormido.",
  },
  {
    "key": "conversation_2gp05g_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_v8dyjq_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "He soñado que... debía... decirte algo.",
  },
  {
    "key": "conversation_v8dyjq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xvqfeq_text",
    "value": "Algo sobre los terremotos, los flujos de poder y...",
  },
  {
    "key": "conversation_xvqfeq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6uvdlp_text",
    "metadata": {
      "notes": "*new* changed format from nervous to emph",
    },
    "value": "{format emph}¡Dorothy!{format reset}",
  },
  {
    "key": "conversation_6uvdlp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_x1cve3_text",
    "value": "¿Qué pasa, Fen? ¿Qué has visto?",
  },
  {
    "key": "conversation_x1cve3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c268na_text",
    "value": "He visto..., no..., he sentido..., he sentido la presencia de otras máquinas apocalípticas.",
  },
  {
    "key": "conversation_c268na_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_glw2u1_text",
    "metadata": {
      "notes": "*new* added the phrase "come on" at the start of the line.",
    },
    "value": "Vamos, tenemos que decírselo a {format highlight}Rosie{format reset}. Aún no hemos acabado con los malditos terremotos.",
  },
  {
    "key": "conversation_glw2u1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vduxpt_text",
    "value": "{format laugh}¡Je, je, je...!{format reset} ¡Ha sido genial!",
  },
  {
    "key": "conversation_vduxpt_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_bez5tc_text",
    "value": "Sí, parece inofensivo, ¿no crees?",
  },
  {
    "key": "conversation_bez5tc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_02t7hw_text",
    "value": "Hay partes de steambots y Vectron puestas juntas en esta cosa.",
  },
  {
    "key": "conversation_02t7hw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nloh4y_text",
    "value": "¿Por qué construiría Rusty algo así?",
  },
  {
    "key": "conversation_nloh4y_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_uo5vst_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Te preocupas demasiado. ¡A pensar menos y destruir más!",
  },
  {
    "key": "conversation_uo5vst_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cqegx4_text",
    "value": "Tenemos que {format highlight}regresar a El Oasis{format reset} y decirle a Rosie que hemos desactivado la máquina.",
  },
  {
    "key": "conversation_cqegx4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_o7pn77_text",
    "value": "Aunque parezca extraño, fue bastante satisfactorio.",
  },
  {
    "key": "conversation_o7pn77_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fhtom3_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Ya estamos en la misma onda!",
  },
  {
    "key": "conversation_fhtom3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_0j9ty2_text",
    "value": "...",
  },
  {
    "key": "conversation_0j9ty2_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_j80dt5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿Has notado eso, Fen?",
  },
  {
    "key": "conversation_j80dt5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4ctogi_text",
    "value": "Quizá, no sé.",
  },
  {
    "key": "conversation_4ctogi_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5r8xoq_text",
    "value": "Parecía ser un temblor.",
  },
  {
    "key": "conversation_5r8xoq_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ue7igm_text",
    "value": "¡Vamos a {format highlight}destruir los demás generadores{format reset}!",
  },
  {
    "key": "conversation_ue7igm_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_kx4acl_text",
    "value": "¡Uno más destruido!",
  },
  {
    "key": "conversation_kx4acl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7knnev_text",
    "value": "{format laugh}¡Sí!{format reset}",
  },
  {
    "key": "conversation_7knnev_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_7xkz1w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Es agradable hacer esto en compañía de alguien... no estar sola cuando...",
  },
  {
    "key": "conversation_7xkz1w_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_orn1ay_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Oye, eso sí que era un terremoto!",
  },
  {
    "key": "conversation_orn1ay_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b59rnh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Habrá sido una reacción porque hemos destruido esta cosa, supongo.",
  },
  {
    "key": "conversation_b59rnh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_s51o2b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡{format emph}Cuando{format reset} encontremos a Rusty tendrá que explicarme todo esto!",
  },
  {
    "key": "conversation_s51o2b_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lxj451_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No te preocupes, te cubro las espaldas.",
  },
  {
    "key": "conversation_lxj451_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mk9qpq_text",
    "value": "{format laugh}¡Guau!{format reset}",
  },
  {
    "key": "conversation_mk9qpq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_p2ot9u_text",
    "value": "Ese era el último.",
  },
  {
    "key": "conversation_p2ot9u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xxw7zr_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Ese ha sido enorme!",
  },
  {
    "key": "conversation_xxw7zr_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p4nitu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Esto no tiene sentido. Creía que así nos libraríamos de los terremotos.",
  },
  {
    "key": "conversation_p4nitu_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_48h46n_text",
    "value": "Sí, estoy seguro de que fue la última de las máquinas.",
  },
  {
    "key": "conversation_48h46n_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_vkntr1_text",
    "metadata": {
      "notes": "*format* *new*",
    },
    "value": "Tengo un mal presentimiento. Hay demasiadas preguntas sin respuesta.",
  },
  {
    "key": "conversation_vkntr1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nzra7p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Sectas apocalípticas y junglas tóxicas! ¿Y dónde está Rusty?",
  },
  {
    "key": "conversation_nzra7p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3r7w00_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aquí hay gato encerrado...",
  },
  {
    "key": "conversation_3r7w00_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mboiam_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Y si no es Rusty? Quizás Rosie está equivocada.",
  },
  {
    "key": "conversation_mboiam_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_iz5s2x_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "O quizás no nos haya contado toda la verdad.",
  },
  {
    "key": "conversation_iz5s2x_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_xd4lj1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Es mejor que regresemos a El Oasis y {format highlight}hablemos con Rosie{format reset}.",
  },
  {
    "key": "conversation_xd4lj1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7k0m7s_text",
    "metadata": {
      "notes": "*new* changed this since we now have the old version of it triggered up by the first lever at the entrance to this temple",
    },
    "value": "Otra palanca inservible, ¿eh?",
  },
  {
    "key": "conversation_7k0m7s_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_bqsv37_text",
    "metadata": {
      "notes": "*new* same as above",
    },
    "value": "Quizás también tengamos que {format highlight}activarla{format reset}.",
  },
  {
    "key": "conversation_bqsv37_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_rzhlfx_text",
    "value": "¡No, nada!",
  },
  {
    "key": "conversation_rzhlfx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1l90nu_text",
    "value": "Tal vez este brasero funcione.",
  },
  {
    "key": "conversation_1l90nu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_q9t7dt_text",
    "metadata": {
      "notes": "*new* rephrased it.",
    },
    "value": "Sí, pero tengo que encontrar el modo de encenderlo.",
  },
  {
    "key": "conversation_q9t7dt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_sb7zou_text",
    "value": "¡Venga, {format laugh}prendámosle fuego{format reset} a esta cosa!",
  },
  {
    "key": "conversation_sb7zou_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_utqc5b_text",
    "value": "No deberías haber regresado aquí.",
  },
  {
    "key": "conversation_utqc5b_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_8jri1u_text",
    "value": "¿Qué estás haciendo? ¡Suéltalo, Rosie!",
  },
  {
    "key": "conversation_8jri1u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_q1eysc_text",
    "metadata": {
      "notes": "*format* *new* changed "he was" to "he's"",
    },
    "value": "¿Sabes cuántos licoreros murieron para poder capturarlo? ¡Es un monstruo!",
  },
  {
    "key": "conversation_q1eysc_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_0g9r4c_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Pero ahora solo es una batería en mi traje mecánico, ¡y por fin tengo la fuerza suficiente para destruir a los tuyos!",
  },
  {
    "key": "conversation_0g9r4c_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_icw8pm_text",
    "metadata": {
      "notes": "*new* changed format from nervous to emph",
    },
    "value": "¡Tú..., {format emph}me has mentido{format reset}!",
  },
  {
    "key": "conversation_icw8pm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ir71cz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Te he {format emph}usado{format reset}! No eras más que una herramienta, y necesitaba que alguien desactivara esas molestas máquinas.",
  },
  {
    "key": "conversation_ir71cz_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_d3ola6_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Él las construyó para extraer toda la energía de mi destilería de fusión... ¡pero se acabó!",
  },
  {
    "key": "conversation_d3ola6_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_pdqri5_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "El reactor me dará todo lo que necesito para controlar a los míos..., ¡una fuente infinita de Fermento Lunar!",
  },
  {
    "key": "conversation_pdqri5_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_rdwldu_text",
    "value": "Ya no tendrán que vagar. Estarán a salvo y me tendrán el {format emph}respeto que me merezco.{format reset}",
  },
  {
    "key": "conversation_rdwldu_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_03yhdy_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¿A esto te referías cuando decías que los licoreros eran peligrosos y estaban desquiciados?",
  },
  {
    "key": "conversation_03yhdy_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hj0t32_text",
    "metadata": {
      "notes": "*new* removed a couple of format tags and just enclosed the whole line",
    },
    "value": "{format nervous}Los terremotos... El reactor es tecnología Vectron inestable{format reset}...",
  },
  {
    "key": "conversation_hj0t32_text.Speaker",
    "value": "invisible_dummy_01",
  },
  {
    "key": "conversation_jndfz3_text",
    "metadata": {
      "notes": "*new* changed format from nervous to laugh",
    },
    "value": "{format laugh}¡NO, TÚ ERES EL INESTABLE! ¡POR FIN TENGO TODO EL CONTROL!{format reset}",
  },
  {
    "key": "conversation_jndfz3_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_18qzvo_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Estás totalmente loca!",
  },
  {
    "key": "conversation_18qzvo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_8q2tds_text",
    "metadata": {
      "notes": "*new* changed format from nervous to laugh",
    },
    "value": "{format laugh}¡BASTA YA!{format reset}",
  },
  {
    "key": "conversation_8q2tds_text.Speaker",
    "value": "Rosie",
  },
  {
    "key": "conversation_iot2uu_text",
    "value": "{format nervous}¿D-Dot?{format reset}",
  },
  {
    "key": "conversation_iot2uu_text.Speaker",
    "value": "invisible_dummy_01",
  },
  {
    "key": "conversation_rtuuk8_text",
    "value": "¿Eh?",
  },
  {
    "key": "conversation_rtuuk8_text.Speaker",
    "value": "hub_guard_2",
  },
  {
    "key": "conversation_4hbzdf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Hola, ¿qué estáis tramando ahí arriba?",
  },
  {
    "key": "conversation_4hbzdf_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_n15uxu_text",
    "value": "¡Gaaar, yaar! ¡Largo!",
  },
  {
    "key": "conversation_n15uxu_text.Speaker",
    "value": "hub_guard_2",
  },
  {
    "key": "conversation_ciyvzv_text",
    "value": "{format nervous}El reactor..., ¡va a explotar!{format reset}",
  },
  {
    "key": "conversation_ciyvzv_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_8qc79q_text",
    "value": "{format nervous}Los terremotos lo destruirán todo...{format reset}",
  },
  {
    "key": "conversation_8qc79q_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_118c4u_text",
    "value": "{format nervous}¡Debes salir de aquí!{format reset}",
  },
  {
    "key": "conversation_118c4u_text.Speaker",
    "value": "Rusty",
  },
  {
    "key": "conversation_qm6zc7_text",
    "value": "¡Y una tuerca! {format emph}¡Saldremos de aquí juntos!{format reset}",
  },
  {
    "key": "conversation_qm6zc7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7421mi_text",
    "value": "¡Ni lo pienses! ¡No te dejaré aquí abajo!",
  },
  {
    "key": "conversation_7421mi_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_90knk7_text",
    "value": "No podrás salir de aquí con nosotros en esta cosa...",
  },
  {
    "key": "conversation_90knk7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0kxcna_text",
    "value": "No hay tiempo para discutir. Es la única manera. Vamos, métanse allí.",
  },
  {
    "key": "conversation_0kxcna_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_cd5m29_text",
    "value": "¡Ya!",
  },
  {
    "key": "conversation_cd5m29_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_ebuimt_text",
    "metadata": {
      "notes": "*new* changed phrasing",
    },
    "value": "¿A dónde se han ido todos?",
  },
  {
    "key": "conversation_ebuimt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nr0trv_text",
    "value": "Hmm... esto {format nervous}me está asustando.{format reset}",
  },
  {
    "key": "conversation_nr0trv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5r1v5j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tenemos que {format highlight}encontrar a Rosie{format reset} y ver qué ha estado maquinando.",
  },
  {
    "key": "conversation_5r1v5j_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_17f2xe_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Guau! Esta debe de ser el famoso generador apocalíptico.",
  },
  {
    "key": "conversation_17f2xe_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jiz6v8_text",
    "value": "Jamás creí que Rusty pudiera hacer algo así...",
  },
  {
    "key": "conversation_jiz6v8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nkppty_text",
    "value": "Me parece que hay muchas partes de Vectron en esa cosa.",
  },
  {
    "key": "conversation_nkppty_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5mvh1h_text",
    "value": "¡Hay que destruirlo! {format laugh}¡Síííí!{format reset}",
  },
  {
    "key": "conversation_5mvh1h_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_t5tmkl_text",
    "value": "¡Guau! ¿Qué es esa cosa? ",
  },
  {
    "key": "conversation_t5tmkl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_96wcqq_text",
    "value": "Parece ser tecnología Vectron.",
  },
  {
    "key": "conversation_96wcqq_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_3ss3dz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Destrocémoslo!",
  },
  {
    "key": "conversation_3ss3dz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_4kheve_text",
    "value": "¡La entrada está bloqueada!",
  },
  {
    "key": "conversation_4kheve_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ruxx9o_text",
    "value": "Sí, ¿crees que se ha bloqueado por los terremotos?",
  },
  {
    "key": "conversation_ruxx9o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_cct3lh_text",
    "value": "Tenemos que {format highlight}encontrar otra entrada{format reset} y hablar con Rosie.",
  },
  {
    "key": "conversation_cct3lh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_s6wiy7_text",
    "value": "¿Qué? ¿Tendré que flotar por aquí, solo y aburrido?",
  },
  {
    "key": "conversation_s6wiy7_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qzc1ay_text",
    "value": "Tu caldera es muy cómoda y calentita. Y, me divierto metiéndome contigo, {format laugh}je, je, je.{format reset}",
  },
  {
    "key": "conversation_qzc1ay_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ruux6m_text",
    "value": "{format nervous}¡Maldita sea!{format reset} No tengo tiempo que perder, ¡necesito {format highlight}salir{format reset} de aquí!",
  },
  {
    "key": "conversation_ruux6m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_34h62o_text",
    "value": "{format laugh}¡Je, je, je!{format reset} Parece ser que sí necesitas mi ayuda...",
  },
  {
    "key": "conversation_34h62o_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_de9yap_text",
    "value": "Ya he explorado el área. {format emph}Creo{format reset} que te puedo permitir usar mi mapa.",
  },
  {
    "key": "conversation_de9yap_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wk05yo_text",
    "value": "¡Listo, larguémonos de aquí!",
  },
  {
    "key": "conversation_wk05yo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_h6d5t0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Aish, bueno, vamos entonces.",
  },
  {
    "key": "conversation_h6d5t0_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a9gtqb_text",
    "value": "¡Oye! ¿Qué está haciendo ese mutante por aquí?",
  },
  {
    "key": "conversation_a9gtqb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hsioxg_text",
    "value": "Es un licorero, Fen. No hagas ruido, está dormido.",
  },
  {
    "key": "conversation_hsioxg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cl8j2w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Baglarb.",
  },
  {
    "key": "conversation_cl8j2w_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_erniqz_text",
    "metadata": {
      "notes": "*format* Crab is a hideously mutated Shiner. Look like Crab. Talk like people.",
    },
    "value": "¡Bagarbagarglagurd!",
  },
  {
    "key": "conversation_erniqz_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_hgy6ga_text",
    "value": "Perdone, solam...",
  },
  {
    "key": "conversation_hgy6ga_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_xsba9s_text",
    "metadata": {
      "notes": "*format* Speaks jibberish and half sentences.",
    },
    "value": "¡Mi rocasssss baglurb!",
  },
  {
    "key": "conversation_xsba9s_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_eottc5_text",
    "value": "Eh... vale...",
  },
  {
    "key": "conversation_eottc5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tolx3y_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_tolx3y_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_cmj0mp_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_cmj0mp_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_kqftzz_text",
    "metadata": {
      "notes": "*new* added a introductory line for dorothy",
    },
    "value": "Oye, ¿cómo has llegado hasta aquí?",
  },
  {
    "key": "conversation_kqftzz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_x2c4hn_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Bagarbagarglagurd!",
  },
  {
    "key": "conversation_x2c4hn_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_1d144p_text",
    "value": "Lo siento, pero...",
  },
  {
    "key": "conversation_1d144p_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_opes3o_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Mih tuboshsh baglurb!",
  },
  {
    "key": "conversation_opes3o_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_kzffu7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "De acuerdo, pero este no es un sitio muy seguro. Deberías encontrar otro lugar en el que pasar el tiempo.",
  },
  {
    "key": "conversation_kzffu7_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_514n8o_text",
    "value": "Baglarb!",
  },
  {
    "key": "conversation_514n8o_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_rjibkc_text",
    "value": "Vale, de acuerdo.",
  },
  {
    "key": "conversation_rjibkc_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_q4yhzp_text",
    "value": "Baglarb.",
  },
  {
    "key": "conversation_q4yhzp_text.Speaker",
    "value": "Handy Gabby",
  },
  {
    "key": "conversation_mo6w8t_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ya e' hora de que me duche. Huelo a perro' muerto'.",
  },
  {
    "key": "conversation_mo6w8t_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_i5u7gc_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ademá', me gusta hace' {format singsong}burbujita' burbujeante'{format reset}.",
  },
  {
    "key": "conversation_i5u7gc_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_h9b611_text",
    "value": "Este lugar sí que es peculiar.",
  },
  {
    "key": "conversation_h9b611_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_7u1oej_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Rosie lo hizo. Era una debilucha cuando era má' chiquita.",
  },
  {
    "key": "conversation_7u1oej_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_d9pcrg_text",
    "value": "Pero ahora está grandota y fuertota, y tiene to'l Fermento Luna' pa' nosotro'.",
  },
  {
    "key": "conversation_d9pcrg_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_5hc8jc_text",
    "metadata": {
      "notes": "*format* *new* broke this up into two lines",
    },
    "value": "¡Solo quiero zambullirme en Fermento Luna'! Asín me haré fuerte {format emph}yo{format reset} también.",
  },
  {
    "key": "conversation_5hc8jc_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_dqkik7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Y la Rosie ni huele e'ta cosa, ella se contenta levantando cosa' pesada'. ¡Qué tonta!",
  },
  {
    "key": "conversation_dqkik7_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_jra7p9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Quiero un poquillo de Fermento Luna'!",
  },
  {
    "key": "conversation_jra7p9_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_0ga9xz_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Me agrada e'te luga', pero lo' túnele' me e'tán llamando...",
  },
  {
    "key": "conversation_0ga9xz_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_6i3ly8_text",
    "value": "Gritan con sus temblore' tembloroso'.",
  },
  {
    "key": "conversation_6i3ly8_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_l4t4ta_text",
    "value": "Voy a extrañar pode' nada' en Fermento Luna'.",
  },
  {
    "key": "conversation_l4t4ta_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_brmgbs_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Es viscoso y pringoso, pero de to'a' forma' voy a hacer una' burbujica'.",
  },
  {
    "key": "conversation_brmgbs_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_iyntgs_text",
    "value": "¡Los túnele' no dejan de llamarme!",
  },
  {
    "key": "conversation_iyntgs_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_rb7d43_text",
    "value": "¿Has visto to' eso' bichejo' en los túnele'?",
  },
  {
    "key": "conversation_rb7d43_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_s21hym_text",
    "value": "¡Eso' bichejo' e'tán de rechupete!",
  },
  {
    "key": "conversation_s21hym_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_ky29gq_text",
    "value": "Los fríe', {format singsong}remoja'os en Fermento Luna'.{format reset}",
  },
  {
    "key": "conversation_ky29gq_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_7w4sjb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Me pa'ece que podemo' hacer una buena barbacoa como las d'antaño!",
  },
  {
    "key": "conversation_7w4sjb_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_4b9cj5_text",
    "value": "Mmm, me gustan eso' bichejo' frito'",
  },
  {
    "key": "conversation_4b9cj5_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_ofc7fu_text",
    "value": "¡El Fermento Luna' me da fuerza'! Me hace má' mejó'.",
  },
  {
    "key": "conversation_ofc7fu_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_l41o8r_text",
    "value": "No me iría mal una tercera piernecilla.",
  },
  {
    "key": "conversation_l41o8r_text.Speaker",
    "value": "Wet Willy",
  },
  {
    "key": "conversation_hu136t_text",
    "value": "{format laugh}¡Yupiii!{format reset} {format singsong}¡Destrucción sin sentido!{format reset}",
  },
  {
    "key": "conversation_hu136t_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_sfe0sl_text",
    "value": "...",
  },
  {
    "key": "conversation_sfe0sl_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fjpwyo_text",
    "value": "Fen..., regresaré a buscarte.",
  },
  {
    "key": "conversation_fjpwyo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_va1y6u_text",
    "value": "Sé que lo harás.",
  },
  {
    "key": "conversation_va1y6u_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_5idlry_text",
    "value": "¡Vete! ¡Ahora!",
  },
  {
    "key": "conversation_5idlry_text.Speaker",
    "value": "endgame_teleporter",
  },
  {
    "key": "conversation_x36dp8_text",
    "value": ""CUIDADO: ¡NO ENTRAR!".",
  },
  {
    "key": "conversation_x36dp8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_p6icsu_text",
    "metadata": {
      "notes": "*new* chenged this to not be a quesetion",
    },
    "value": "Todos estos sectarios están chalados, ¿verdad?",
  },
  {
    "key": "conversation_p6icsu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rm0amb_text",
    "value": "Sí, bastante chalados.",
  },
  {
    "key": "conversation_rm0amb_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_4rm6n6_text",
    "value": "Echo de menos destruirlos. Entremos y veamos si encontramos más.",
  },
  {
    "key": "conversation_4rm6n6_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5q7isk_text",
    "value": "Quiero {format highlight}encontrar a su profeta{format reset}. Él podría saber dónde está Rusty.",
  },
  {
    "key": "conversation_5q7isk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jd7aed_text",
    "value": "Hay demasiadas tuberías por aquí. ¿Quizá podemos entrar por el desagüe?",
  },
  {
    "key": "conversation_jd7aed_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5wy6ob_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Tengo la sospecha de que encontraremos el final de las tuberías en la selva subterránea.",
  },
  {
    "key": "conversation_5wy6ob_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_444mtr_text",
    "value": "¡Oye, mira esta cosa toda agujerada! ¿Para qué crees que sirve?",
  },
  {
    "key": "conversation_444mtr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_9gicpx_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "No sé, pero no parece muy agradable.",
  },
  {
    "key": "conversation_9gicpx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_h3f7cn_text",
    "value": "Tal vez sea una especie de sistema de desechos para las máquinas de terremotos.",
  },
  {
    "key": "conversation_h3f7cn_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jf4lyk_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "Sea lo que sea lo que está sucediendo, esta selva parece estar extendiéndose.",
  },
  {
    "key": "conversation_jf4lyk_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tkhd41_text",
    "metadata": {
      "notes": "*format*",
    },
    "value": "¡Basta ya, vamos a encontrar esa máquina y vamos a destruirla!",
  },
  {
    "key": "conversation_tkhd41_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_uo28un_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Hm, más cristales de esos. No veo ningún brasero cerca.",
  },
  {
    "key": "conversation_uo28un_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_orh8x3_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "¡Tienen que estar en algún lugar de este maldito templo!",
  },
  {
    "key": "conversation_orh8x3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_fytrwl_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Pero el generador apocalíptico no está aquí dentro. ¡Quiero ir a destrozar esa cosa {format emph}ahora!{format reset}",
  },
  {
    "key": "conversation_fytrwl_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w7ohum_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Sí, todavía no has encontrado todos los braseros.",
  },
  {
    "key": "conversation_w7ohum_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_r9v53t_text",
    "metadata": {
      "notes": "*new* this whole conversation is new",
    },
    "value": "Y yo quiero destruir ya el generador apocalíptico.",
  },
  {
    "key": "conversation_r9v53t_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_ubahwy_text",
    "metadata": {
      "notes": "*new* added new sign. Operating Acolytes is a referenece to Operating Thetan from Scientology",
    },
    "value": ""Sala del tesoro de Ronald. Entrada permitida sólo a los Acólitos Operativos de nivel VI o superior".",
  },
  {
    "key": "conversation_ubahwy_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_y2rvga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "La puerta no se mueve. La palanca es inservible.",
  },
  {
    "key": "conversation_y2rvga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_voevwm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿A lo mejor sólo tenemos que {format highlight}encenderla {format reset} de algún modo?",
  },
  {
    "key": "conversation_voevwm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_29icwu_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡No funciona!",
  },
  {
    "key": "conversation_29icwu_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_86fd8m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Todavía pienso que tenemos que {format highlight}encenderla {format reset}.",
  },
  {
    "key": "conversation_86fd8m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_one4s1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oye, esta nueva armadura está muy bien. Ahora dejarás de lloriquear diciendo que te han destrozado y demás.",
  },
  {
    "key": "conversation_one4s1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_i2p8ul_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No creo que podamos ir sin cuidado, pero sí, está genial, ¿verdad?",
  },
  {
    "key": "conversation_i2p8ul_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_6i6u7w_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Sabes con qué estaría aún más genial?",
  },
  {
    "key": "conversation_6i6u7w_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_716uhd_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format singsong}¡Con fuego!{format reset}",
  },
  {
    "key": "conversation_716uhd_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_mg2reo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Vaya! Creo que esta máquina acaba de convertir mi propulsor en un arma.",
  },
  {
    "key": "conversation_mg2reo_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3ldyrw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Genial! ¡Entonces vamos a chamuscar plantas mutantes!",
  },
  {
    "key": "conversation_3ldyrw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_gbh1g1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Con un poco de suerte también será efectivo contra la tierra. ¡Parece como si estuviésemos enterrados aquí abajo!",
  },
  {
    "key": "conversation_gbh1g1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tvs6ch_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Oye, aquí probablemente no hay nada peligroso, ¿no? A mí me parece un sitio bastante seguro.",
  },
  {
    "key": "conversation_tvs6ch_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_5oflga_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Por qué no reventamos de una vez ese muro y vemos lo que hay allí abajo? {format laugh}¡Je, je, je!{format reset}",
  },
  {
    "key": "conversation_5oflga_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_6nymg5_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Creo que este lugar ha sido tapiado por alguna razón.",
  },
  {
    "key": "conversation_6nymg5_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_a8vok3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Y tú no vas a ser el guapo que se rompa en mil pedazos cuando nos estrellemos contra el fondo.",
  },
  {
    "key": "conversation_a8vok3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_pi5rzp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Jo, ¿dónde está tu espíritu aventurero?",
  },
  {
    "key": "conversation_pi5rzp_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2h7zkh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Eso es una {format emph}enorme piscina{format reset} de minerales fundidos!",
  },
  {
    "key": "conversation_2h7zkh_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tw04k8_text",
    "metadata": {
      "notes": "*new* These -> This",
    },
    "value": "La secta está realmente metida en el tema ese de luz fuego y destrucción. No puedo cruzar por ahí sin derretirme.",
  },
  {
    "key": "conversation_tw04k8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_c0o17p_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Estaría bien que te mojaras un pie para comprobarlo. A lo mejor no está {format emph}tan{format reset} caliente.",
  },
  {
    "key": "conversation_c0o17p_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_651wxm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Tendría que ser ignífuga!",
  },
  {
    "key": "conversation_651wxm_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_1hn8s0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "O si fueses tan estupenda como yo, podrías simplemente volar sobre ella.",
  },
  {
    "key": "conversation_1hn8s0_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_8yyuh8_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Tengo un mal presentimiento que no se me va de la cabeza. Definitivamente, hay algo aquí que no marcha bien.",
  },
  {
    "key": "conversation_8yyuh8_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_jytjex_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Rosie tiene muchas explicaciones que darnos cuando volvamos a El Oasis.",
  },
  {
    "key": "conversation_jytjex_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_g4kaqx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Debería haber sido más precavida desde el principio!",
  },
  {
    "key": "conversation_g4kaqx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_vigvfw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Si fueses más precavida, ahora probablemente estaría yo solo en ese templo.",
  },
  {
    "key": "conversation_vigvfw_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2h3jtj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Ahora salgamos de este desagüe y veamos qué está sucediendo.",
  },
  {
    "key": "conversation_2h3jtj_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_w0gsxo_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oye! Esos cohetes son igualitos a los que vimos antes al venir.",
  },
  {
    "key": "conversation_w0gsxo_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_n0y3vf_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Intenta golpearlos con la pica!",
  },
  {
    "key": "conversation_n0y3vf_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_nctmv1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Nunca pensé que volvería a este templo.",
  },
  {
    "key": "conversation_nctmv1_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_77tocr_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Esta parte es mucho más grande que la que hemos dejado arriba.",
  },
  {
    "key": "conversation_77tocr_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_jpag4c_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Yo siempre pasaba el rato en el tótem, así que nunca llegué a entrar en este área.",
  },
  {
    "key": "conversation_jpag4c_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rzcgxv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Debería estar repleta de trampas mortales y cosas chulas como aquella.",
  },
  {
    "key": "conversation_rzcgxv_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_hbejz0_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}¡Wargh!{format reset} ¡Apartad de mi camino! ¡alcaldes y niñobots primero!",
  },
  {
    "key": "conversation_hbejz0_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ma479g_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}¡Lo siento! Ehm... ¡voy tan rápido como puedo!{format reset}",
  },
  {
    "key": "conversation_ma479g_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_fudqd9_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Calmaos, compadres! ¡de uno en uno! ¡formad una cola ordenada! ¿me oís?",
  },
  {
    "key": "conversation_fudqd9_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_pox4ng_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡No tenemos tiempo para colas! Métanse en el cohete antes de que todo se nos caiga encima!",
  },
  {
    "key": "conversation_pox4ng_text.Speaker",
    "value": "Mayor Mic Yonker",
  },
  {
    "key": "conversation_ewm51b_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Atorníllate el pico, hijo! Todavía hay bots en la maldita mina. ¡No podemos abandonarlos sin más!",
  },
  {
    "key": "conversation_ewm51b_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_tdyz6x_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "El Sr. Heisenberg está preparado para encender el cohete, pero puedo retrasar el lanzamiento uno o dos minutos... Después, {format emph}tendremos que despegar{format reset}.",
  },
  {
    "key": "conversation_tdyz6x_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_vtsrcc_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡{format nervous}Deugphsaagh{format reset} baglarb!",
  },
  {
    "key": "conversation_vtsrcc_text.Speaker",
    "value": "Barnacle Jones?",
  },
  {
    "key": "conversation_9s60lp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Exacto! ¡Tú lo has dicho, Sr. Cangrejo!",
  },
  {
    "key": "conversation_9s60lp_text.Speaker",
    "value": "Turtle Bucket",
  },
  {
    "key": "conversation_qo44wn_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Qué? Yo no he dicho nada.",
  },
  {
    "key": "conversation_qo44wn_text.Speaker",
    "value": "Barnacle Jones",
  },
  {
    "key": "conversation_353gqh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "{format nervous}¿{format reset}¿¡Qué diantres!?",
  },
  {
    "key": "conversation_353gqh_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_1engeq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oh, aquí estás, cariño! ¡Menos mal que estás a salvo!",
  },
  {
    "key": "conversation_1engeq_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_ch1z21_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Soberbio! Temía que te hubieses perdido.",
  },
  {
    "key": "conversation_ch1z21_text.Speaker",
    "value": "Davy Bittenborough",
  },
  {
    "key": "conversation_tb8wpb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Veo que habéis dado con ese minero de la bufanda roja. Pero, ¿qué hay de tu brillante amiguito?",
  },
  {
    "key": "conversation_tb8wpb_text.Speaker",
    "value": "Ma Yonker",
  },
  {
    "key": "conversation_pbnvye_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Es... es una larga historia. Tengo que...",
  },
  {
    "key": "conversation_pbnvye_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_u2fefz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Bien, me alegra verte sana y salva, pero tengo que hacer hincapié en el hecho de que {format emph}no tenemos más tiempo{format reset}.",
  },
  {
    "key": "conversation_u2fefz_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_hi1tn7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Todo el mundo a bordo del cohete!",
  },
  {
    "key": "conversation_hi1tn7_text.Speaker",
    "value": "Professor Sherman",
  },
  {
    "key": "conversation_t4edhq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Hora de vivir aventuras en el espacio para este bot a vapor! {format singsong}¡Yiiija!{format reset}",
  },
  {
    "key": "conversation_t4edhq_text.Speaker",
    "value": "Ty Nuzak",
  },
  {
    "key": "conversation_as8gn2_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Una última cosa, señorita.",
  },
  {
    "key": "conversation_as8gn2_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_3qlskx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Estás a punto de explorar un mundo vasto y peligroso allí abajo...",
  },
  {
    "key": "conversation_3qlskx_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_24mz6s_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Si quieres controlar hacia dónde te estás dirigiendo, puedes usar estos marcadores en tu mapa ({image quest_pointer_arrow} y {image quest_pointer_crosshair}).",
  },
  {
    "key": "conversation_24mz6s_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4j1s12_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Creo que eso es señal de sabiduría.",
  },
  {
    "key": "conversation_4j1s12_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_mdsij3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Creo que eso es valiente.",
  },
  {
    "key": "conversation_mdsij3_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_vaf0gm_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Seguro que te has percatado de la existencia de flechas azules ({image quest_pointer_arrow}) y puntos de mira ({image quest_pointer_crosshair}) en el mapa.",
  },
  {
    "key": "conversation_vaf0gm_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_4zvbgq_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Creo que no usar los marcadores significaría una experiencia "clásica". Ahora, que eso sea una buena idea...",
  },
  {
    "key": "conversation_4zvbgq_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_9ah4fv_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Pero no te preocupes, siempre puedes activar y desactivar los marcadores a través de la tabla de engranajes modificadores en la mesa de trabajo.",
  },
  {
    "key": "conversation_9ah4fv_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_rkswy7_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Qué me dices? ¿Permitirás que los marcadores ({image quest_pointer_arrow} y {image quest_pointer_crosshair}) te muestren el camino?",
  },
  {
    "key": "conversation_rkswy7_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_w3uj01_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Como te acabo de decir...",
  },
  {
    "key": "conversation_w3uj01_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_bw07t1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Si quieres, siempre puedes activar y desactivar los marcadores en la mesa de trabajo de la ciudad.",
  },
  {
    "key": "conversation_bw07t1_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_dvacv4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No te quiero entretener más. Buena suerte {format highlight}limpiando los tubos{format reset} en el Pasadizo de la Roca Rojiza.",
  },
  {
    "key": "conversation_dvacv4_text.Speaker",
    "value": "Coral Armstrong",
  },
  {
    "key": "conversation_wamta4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oye, esto parece tecnología de Vectron!",
  },
  {
    "key": "conversation_wamta4_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_lkvb6m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No parece que funcione, de todos modos.",
  },
  {
    "key": "conversation_lkvb6m_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ocl1pj_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_ocl1pj_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_llzd7n_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Fen?",
  },
  {
    "key": "conversation_llzd7n_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_74v2pp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "...",
  },
  {
    "key": "conversation_74v2pp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_hi83wt_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Parece que no tiene salida. Vayámonos de aquí.",
  },
  {
    "key": "conversation_hi83wt_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_u4cd0d_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Qué es esto, Fen?",
  },
  {
    "key": "conversation_u4cd0d_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3rpf0f_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No quiero entrar {format emph}ahí{format reset}. Mejor démonos la vuelta.",
  },
  {
    "key": "conversation_3rpf0f_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_supvbe_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Todavía hay mucho por hacer en las minas.",
  },
  {
    "key": "conversation_supvbe_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_tm3xhy_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Otra vez esta piscina de minerales fundidos, ¿eh?",
  },
  {
    "key": "conversation_tm3xhy_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_35yo2u_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Creo que esta vez {format emph}tenemos{format reset} que atravesarla.",
  },
  {
    "key": "conversation_35yo2u_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mhir26_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Suerte que ahora seas casi tan genial como yo...",
  },
  {
    "key": "conversation_mhir26_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_fnd2g3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Casi.",
  },
  {
    "key": "conversation_fnd2g3_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_b0opbb_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Eso es una {format emph}enorme piscina{format reset} de minerales fundidos!",
  },
  {
    "key": "conversation_b0opbb_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_17hzlg_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "La secta está realmente metida en el tema ese de luz fuego y destrucción.",
  },
  {
    "key": "conversation_17hzlg_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_b7hr8v_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Vamos a cruzar esta cosa de una vez.",
  },
  {
    "key": "conversation_b7hr8v_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_alk15j_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Genial! ¿Sabes qué? Con tu nuevo equipo, casi eres tan genial como yo...",
  },
  {
    "key": "conversation_alk15j_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_qa992m_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Casi.",
  },
  {
    "key": "conversation_qa992m_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_2ou9oe_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¡Oye, mira! Los restos de mi viejo tótem.",
  },
  {
    "key": "conversation_2ou9oe_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_wz87u3_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Parece que hace siglos desde que nos conocimos justo aquí, ¿verdad?",
  },
  {
    "key": "conversation_wz87u3_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_qxncbz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Sí... No puede decirse que eche de menos estar encerrado {format emph}ahí{format reset}.",
  },
  {
    "key": "conversation_qxncbz_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_rvd9qx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Dar leña a los de la secta era divertido, pero la mayor parte del tiempo me la pasaba sentado por ahí, en soledad.",
  },
  {
    "key": "conversation_rvd9qx_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_flred4_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "Este lugar da muy mala espina cuando está abierto.",
  },
  {
    "key": "conversation_flred4_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_z5ls33_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "¿Estás segura de que quieres entrar?",
  },
  {
    "key": "conversation_z5ls33_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_n7df2r_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "De acuerdo. Veamos qué está preparando esa licorera grandullona ahí dentro.",
  },
  {
    "key": "conversation_n7df2r_text.Speaker",
    "value": "Fen",
  },
  {
    "key": "conversation_viru7l_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": "No sabemos lo que ha estado tramando Rosie. ¿Y si nos preparamos antes de entrar?",
  },
  {
    "key": "conversation_viru7l_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_tkltgz_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Todas las mejoras permitidas."",
  },
  {
    "key": "conversation_tkltgz_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_40ih51_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Fachadas e ilusiones."",
  },
  {
    "key": "conversation_40ih51_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_m31axp_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""No se permiten ganchos."",
  },
  {
    "key": "conversation_m31axp_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_cbb9jh_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""No se permiten propulsores \\nni ganchos."",
  },
  {
    "key": "conversation_cbb9jh_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_0tzxsw_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""No se permiten propulsores."",
  },
  {
    "key": "conversation_0tzxsw_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_3k7mx1_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""No se permiten mejoras".",
  },
  {
    "key": "conversation_3k7mx1_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_mrg3os_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Sólo se permiten ganchos".",
  },
  {
    "key": "conversation_mrg3os_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_ytjucx_text",
    "metadata": {
      "notes": "*new*",
    },
    "value": ""Sólo se permiten propulsores".",
  },
  {
    "key": "conversation_ytjucx_text.Speaker",
    "value": "Dorothy",
  },
  {
    "key": "conversation_nol9uu_text",
    "metadata": {
      "notes": "*TEMP* *NEW*",
    },
    "value": ""Si te mantienes lejos del hogar de la lava\\nLas puertas seguirán cerradas\\nPero tras el mínimo contacto\\nTendrás que volver a intentarlo".",
  },
  {
    "key": "conversation_nol9uu_text.Speaker",
