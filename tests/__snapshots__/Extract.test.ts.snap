  },
  {
    "key": "upgrade_lamp_infinite_light_01_desc",
    "value": "Dein Licht kann nicht unter 50%% sinken.",
  },
  {
    "key": "upgrade_lamp_infinite_light_01_flavor",
    "value": ""Keine Dunkelheit der Welt hat die Macht, das Licht einer einzigen Kerze auszulöschen."",
