  {
    "key": "upgrades.upgrade_pickaxe_knockback_01_flavor",
    "notes": "Arnold Schwartzenegger quote from T2",
    "value": ""Hasta la vista, baby."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01",
    "value": "Rispediti al Mittente",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01_desc",
    "notes": " new: minor rephrasing.",
    "value": "Ti permette di colpire i proiettili a mezz'aria e invertirne la direzione.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_deflect_projectiles_01_flavor",
    "value": ""C'è posta per te."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire",
    "value": "Ascia di Fuoco",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire_desc",
    "value": "Aggiunge fuoco, portata ed efficacia al tuo fedele piccone. Potrebbe avere anche altri utilizzi...",
  },
  {
    "key": "upgrades.upgrade_pickaxe_fire_flavor",
    "value": ""Alziamo la temperatura!"",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp",
    "value": "Punta del Cacciatore",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp_desc",
    "value": "Ottieni 5 PE extra quando sconfiggi i nemici con il piccone.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bonus_xp_flavor",
    "notes": " Old Ghanaian proverb meaning that the hunter didn't get anything that he hunted so instead he picked mushrooms, but telling him that might hurt his feelings",
    "value": ""Se il cacciatore torna a casa con i funghi, non chiedergli come è andata la caccia."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty",
    "value": "Cacciatore di Taglie",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty_desc",
    "value": "Ottieni un premio in denaro quando sconfiggi i nemici con il piccone.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_bounty_flavor",
    "value": ""C'è chi lo fa per soldi, e chi per il gusto di cacciare."",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup",
    "value": "Guaritore",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup_desc",
    "value": "Aggiunge la possibilità di rilascio di un globo di salute extra dai nemici sconfitti.",
  },
  {
    "key": "upgrades.upgrade_pickaxe_health_pickup_flavor",
    "notes": "*NEW* Marvin Gaye song "sexual healing"",
    "value": ""Prenditi cura di me."",
  },
  {
    "key": "upgrades.upgrade_backpack",
    "value": "Zaino",
  },
  {
    "key": "upgrades.upgrade_backpack_desc",
    "value": "Contiene i minerali e le gemme che trovi.",
  },
  {
    "key": "upgrades.upgrade_backpack_next_level_desc",
    "value": "Migliora il tuo zaino per ottenere uno slot extra per minerali e gemme.",
  },
  {
    "key": "upgrades.upgrade_backpack_01",
    "value": "Sacca del Minatore",
  },
  {
    "key": "upgrades.upgrade_backpack_01_desc",
    "value": ""Non molto grande, ma può contenere diversi tipi di minerali e gemme."",
  },
  {
    "key": "upgrades.upgrade_backpack_02",
    "value": "Sacca in Pelle di Puzzola",
  },
  {
    "key": "upgrades.upgrade_backpack_02_desc",
    "notes": "Pun on Shakespeare play "Taming of the shrew"",
    "value": ""Catturare le puzzole senza subirne le conseguenze è un'operazione delicata, per questo non è facile da trovare."",
  },
  {
    "key": "upgrades.upgrade_backpack_03",
    "value": "Borsa Porta-tutto",
  },
  {
    "key": "upgrades.upgrade_backpack_03_desc",
    "value": ""Il nome dice tutto. Non serve aggiungere altro."",
  },
  {
    "key": "upgrades.upgrade_backpack_04",
    "notes": " Pun on the lost epic of ancient Greek litterature, The Sack of Troy",
    "value": "Sacco di Troia",
  },
  {
    "key": "upgrades.upgrade_backpack_04_desc",
    "notes": " Pun on Achillean heel,expression meaning where your weakness is",
    "value": ""Se cercavi una borsa di qualità, sei a cavallo."",
  },
  {
    "key": "upgrades.upgrade_backpack_05",
    "notes": "Pun on the old "I can't believe it's not butter" https://en.wikipedia.org/wiki/I_Can%27t_Believe_It%27s_Not_Butter!",
    "value": "Borsa delle Brame",
  },
  {
    "key": "upgrades.upgrade_backpack_05_desc",
    "notes": "When re-released the product had an additional line on the package - Good on everything.",
    "value": ""La più capiente del reame!"",
  },
  {
    "key": "upgrades.upgrade_backpack_06",
    "value": "Sacca Gremlin",
  },
  {
    "key": "upgrades.upgrade_backpack_06_desc",
    "notes": " A pun on the creatures Gremlins from movie Gremlins. They get evil if they eat after midnight.",
    "value": ""Passata la mezzanotte, tienila lontano dal cibo."",
  },
  {
    "key": "upgrades.upgrade_backpack_07",
    "notes": "Elves like Legolas from Lord of The rings",
    "value": "Borsa Elfica",
  },
  {
    "key": "upgrades.upgrade_backpack_07_desc",
    "notes": "Pun on Legolas quote: let a ploughman plough, but choose an otter for swimming, and for running light over grass and leaf, or over snow--an Elf.",
    "value": ""Fate arare il campo al coltivatore, ma scegliete una lontra per nuotare, e per correre veloce su erbe e foglie... una borsa."",
  },
  {
    "key": "upgrades.upgrade_backpack_08",
    "notes": "Lord of the Rings pun - One ring to tame them all.",
    "value": "Una Borsa per Ghermirli",
  },
  {
    "key": "upgrades.upgrade_backpack_08_desc",
    "value": ""Non è fantastico sentire le stesse battute riciclate in tutti i modi? La borsa ti piacerà, comunque. Davvero."",
  },
  {
    "key": "upgrades.upgrade_backpack_09",
    "notes": " The big and extinct Elephant-like creature.",
    "value": "Borsa del Mammut",
  },
  {
    "key": "upgrades.upgrade_backpack_09_desc",
    "value": ""Lanosa e capiente."",
  },
  {
    "key": "upgrades.upgrade_backpack_10",
    "notes": "Pun on the Hindu Scripture Bhagavad Gita https://en.wikipedia.org/wiki/Bhagavad_Gita",
    "value": "Borsa Shiva",
  },
  {
    "key": "upgrades.upgrade_backpack_10_desc",
    "notes": "sanskrit vedanta – vedan't ya? Hinduism - Hindsight",
    "value": ""Una borsa di proporzioni mitologiche. Non indù-giare, riempila delle ricchezze più pregiate."",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01",
    "value": "Separatore Magnetico",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01_desc",
    "notes": " new: minor rephrasing",
    "value": "Le risorse esposte verranno attirate verso di te.",
  },
  {
    "key": "upgrades.upgrade_backpack_magnetic_pull_01_flavor",
    "notes": "Harry Potter pun on spell accio = fetch",
    "value": ""Accio!"",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01",
    "notes": " Norse God Freyr owned a ship that he could fold into his pocket when not needed",
    "value": "Tasca di Freyr",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01_desc",
    "value": "Ti permette di aggiungere un pezzo di minerale extra per ciascuno slot.",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_ore_01_flavor",
    "notes": " Taken from norse mythology, The books of Snorri, The prose Edda, The poetic Edda.",
    "value": ""Prosaica, poetica, elegante."",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01",
    "value": "Doppio Deposito",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01_desc",
    "notes": " new: rephrasing",
    "value": "Ciascuno slot può contenere due gemme.",
  },
  {
    "key": "upgrades.upgrade_backpack_extra_gem_01_flavor",
    "value": ""Nella borsa piccola c'è il profitto buono."",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01",
    "value": "Incentivo per lo smaltimento",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01_desc",
    "value": "Scartando una risorsa otterrai anche una parte del suo valore in denaro.",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_money_01_flavor",
    "notes": "Lyrics From Sades song Smooth Operator",
    "value": ""Non vedi che è un vero affare? Non perdere l'occasione."",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_health",
    "notes": " Pun on Elton john song circle of life meaning that everything goes around and comes back to life – from song circle of life, Recycle the present is just a quote on how recycling today will make the future a better place.",
    "value": "Il Cerchio della Vita",
  },
  {
    "key": "upgrades.upgrade_backpack_discard_give_health_desc",
    "value": "Scartando una risorsa ripristini una parte della tua salute. Scartando una gemma recuperi più salute che scartando un minerale.",
