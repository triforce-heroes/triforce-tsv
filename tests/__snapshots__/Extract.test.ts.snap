    "key": "upgrade_pickaxe_05",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Legierte Stahlpicke",
  },
  {
    "key": "upgrade_pickaxe_05_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Die eigens entwickelte Aktivkohlebehandlung gibt deinem Schwung die richtige Balance."",
  },
  {
    "key": "upgrade_pickaxe_06",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Wolframpicke",
  },
  {
    "key": "upgrade_pickaxe_06_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Sie hat genau die richtige Dichte und Zähigkeit und gibt dir dieses erstklassige Gefühl beim Buddeln."",
  },
  {
    "key": "upgrade_pickaxe_07",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Ödlandpicke",
  },
  {
    "key": "upgrade_pickaxe_07_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Langlebiger und Effizienter. Genau das, was man braucht, um im Ödland zu überleben."",
  },
  {
    "key": "upgrade_pickaxe_08",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Templerpicke",
  },
  {
    "key": "upgrade_pickaxe_08_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Optimal gewichtet. Fühlt sich so an, als würde sie von ganz alleine buddeln."",
  },
