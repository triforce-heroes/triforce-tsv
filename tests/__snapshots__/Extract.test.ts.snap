  {
    "key": "upgrades.upgrade_jackhammer_01_desc",
    "notes": "Pun on Peter Gabriels song Sledgehammer - I want to be your sledgehammer",
    "value": ""Seré tu amante martillo, martillo."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02",
    "notes": "Titans=Mythological adversaries to the gods",
    "value": "La perdición del titán",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02_desc",
    "notes": "Removed MC Hammer reference",
    "value": ""Consumo de combustible mejorado para que des más golpes por cada cubo de agua."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03",
    "notes": "From Rocky 4 - Character Ivan Drago",
    "value": "Iván Drago M4",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03_desc",
    "notes": "His signature phrase "I must break you"",
    "value": ""Su punta ha sido reforzada con carburo de tungsteno para tener una potencia que rompe hasta la muralla de hierro."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04",
    "notes": "In norse mythology Mjölnir is the hammer of the mighty Thor",
    "value": "Voluntad de Mjolnir",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04_desc",
    "value": ""Todo aquel que posea este martillo, si es digno, poseerá el poder de Thor."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water",
    "notes": "Jab - to punch NOT CURRENTLY USED",
    "value": "Golpe seco",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_desc",
    "notes": "NOT CURRENTLY USED",
    "value": "Disminuye el consumo de agua a la mitad.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_flavor",
    "notes": "NOT CURRENTLY USED",
    "value": ""Hace calor, un calor muy seco."",
