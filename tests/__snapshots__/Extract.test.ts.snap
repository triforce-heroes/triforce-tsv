exports[`extract(tests\\fixtures\\fr_conversations.csv) function > matches snapshot > tests\\fixtures\\fr_conversations.csv 1`] = `
[
  {
    "key": "buddy_inventory_full.conversation_yjp8nk_text",
    "notes": "Speaker=Fen Notes=Comes up when your inventory is full anyou try to pick up more ores.",
    "value": "Hé ! Ton {format highlight}sac est plein{format reset}, banane !",
  },
  {
    "key": "ore_vendor.conversation_hxfr0f_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* added "there"",
    "value": "T'aurais pas quelque chose de brillant et précieux pour tonton Bernache ?",
  },
  {
    "key": "ore_vendor.conversation_jh3i2m_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Alors t'as quelques cailloux que tu veux échanger contre quelques pièces ?",
  },
  {
    "key": "ore_vendor.conversation_69vpc2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo. Moved this node",
    "value": "Alors ma petite, t'as quelque chose pour moi ?",
  },
  {
    "key": "ore_vendor.conversation_mi3myw_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Passons aux choses sérieuses ! Faisons affaire toi et moi !",
  },
  {
    "key": "ore_vendor.conversation_2l670i_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Alors, qu'est-ce que tu m'apportes ?",
  },
  {
    "key": "ore_vendor.conversation_89hare_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Montre donc ce que tu as apporté.",
  },
  {
    "key": "ore_vendor.conversation_dfflv5_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved this",
    "value": "Alors ma mignonne, besoin d'aide avec ce minerai ?",
  },
  {
    "key": "ore_vendor.conversation_dvsj68_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Maire Yonker est peut-être un imbécile, mais il a raison ce coup-ci. On a besoin de faire couler le minerai !",
  },
  {
    "key": "ore_vendor.conversation_gk3axq_text",
    "notes": "Speaker=Barnacle Jones Notes=*format* Hair on steambots is made of metal.",
    "value": "J'ai entendu dire que ça le tracasse tellement que ses cheveux commencent à rouiller !",
  },
  {
    "key": "ore_vendor.conversation_mosq62_text",
    "notes": "Speaker=Barnacle Jones Notes=" clamps" is the equivavlent of hands, since they are robots.",
    "value": "Moi par contre, j'ai jamais rien eu contre prendre le minerai des pinces d'un mineur, peu importe les circonstances !",
  },
  {
    "key": "ore_vendor.conversation_fnygz1_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll-face to kiddo.",
    "value": "Y'a rien de plus important que de faire couler le minerai, ma petite.",
  },
  {
    "key": "ore_vendor.conversation_7dsj17_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Écoute ça, j'ai entendu dire qu'on avait trouvé un bot tout frais pour travailler la mine.",
  },
  {
    "key": "ore_vendor.conversation_mh0ja0_text",
    "notes": "Speaker=Dorothy",
    "value": "Je suis à la recherche d'un ami, du genre silencieux qui porte une écharpe rouge.",
  },
  {
    "key": "ore_vendor.conversation_y6ys6p_text",
    "notes": "Speaker=Barnacle Jones Notes=Real McCoy= the real deal.",
    "value": "J'connais le bot, il avait tout l'air d'être un crack mais c'était que du vent !",
  },
  {
    "key": "ore_vendor.conversation_0lzsu6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Il est même pas revenu une seule fois, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_bhqgnn_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid added "I" at start of sentance. Removed last part of sentance",
    "value": "J'espère que tu feras un meilleur boulot, ma petite. Ramène tout le minerai que tes jolies pinces peuvent porter.",
  },
  {
    "key": "ore_vendor.conversation_21a760_text",
    "notes": "Speaker=Barnacle Jones Notes=Refering to pneumatic tubes that's used for fast travel between the surface and the deep parts of the mine",
    "value": "Dis voir, j'parie que t'as entendu parler des tubes bouchés.",
  },
  {
    "key": "ore_vendor.conversation_oxkxen_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "C'est pas mon genre d'écouter les racontars mais de ce que j'ai entendu c'est le maire qui les a fermés pour se venger de ses frères mineurbots.",
  },
  {
    "key": "ore_vendor.conversation_2zloko_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "En parlant de ça, je les ai pas vus depuis des lustres.",
  },
  {
    "key": "ore_vendor.conversation_xwxxg4_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'aurais cru qu'ils allaient au moins se mettre au niveau de la compétition.",
  },
  {
    "key": "ore_vendor.conversation_gmenrv_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Mais bon, c'est pas si étonnant de la part de ces bons à rien.",
  },
  {
    "key": "ore_vendor.conversation_xkngbf_text",
    "notes": "Speaker=Barnacle Jones Notes=mazumas= slang for money, please do translate.",
    "value": "Bref, les tubes fermés me coûtent pas mal de grisbi, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_xfxkz8_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Il y a des richesses qui n'attendent qu'à être découvertes là-d'ssous !",
  },
  {
    "key": "ore_vendor.conversation_op5xlx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Si tu tombes sur des soiffards, dézingue-les avant de finir entre quatre planches.",
  },
  {
    "key": "ore_vendor.conversation_whma58_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "De ce que j'ai entendu, ils sont accros au pousse-café et cherchent à en découdre, si tu vois ce que j'veux dire.",
  },
  {
    "key": "ore_vendor.conversation_t5mwlu_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Ça les rend plus forts mais ils deviennent totalement gaga.",
  },
  {
    "key": "ore_vendor.conversation_649tjr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "C'est une substance très corrosive, un conseil, évite de t'y baigner.",
  },
  {
    "key": "ore_vendor.conversation_03e7vh_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*",
    "value": "Dis voir, j'sais pas si t'as entendu, mais la prof plein aux as a perdu les pédales.",
  },
  {
    "key": "ore_vendor.conversation_u2ersk_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Elle a perdu la tête quand sa maison s'est écroulée suite à un tremblement, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_h9iaiy_text",
    "notes": "Speaker=Barnacle Jones Notes=*new*",
    "value": "Elle est en train de construire une {format emph}fusée{format reset} grâce à son héritage.",
  },
  {
    "key": "ore_vendor.conversation_3jgp0a_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'ai même entendu dire qu'elle était en contact avec des amateurs de fusée.",
  },
  {
    "key": "ore_vendor.conversation_9mc50k_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ils en construisent un peu partout sur la planète.",
  },
  {
    "key": "ore_vendor.conversation_bsxzro_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Dis voir, est-ce que tu as pris le temps de fouiller les caves, ma petite ?",
  },
  {
    "key": "ore_vendor.conversation_dz2y8u_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Elles sont plus coriaces que le reste des mines.",
  },
  {
    "key": "ore_vendor.conversation_3g80ch_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Mais tu y trouveras des trucs ayant plus de valeur, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_nmjdda_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* completely changed",
    "value": "Une fois que tu as trouvé tout le contenu d'une cave, cela devrait être marqué {image cave_small} sur ta carte. Comme ça tu creuseras pas pour rien, ma petite !",
  },
  {
    "key": "ore_vendor.conversation_u3ck3c_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Qui aurait pensé que ces détraqués de cultistes cachaient autant de richesses dans ces ruines ?",
  },
  {
    "key": "ore_vendor.conversation_zh09qm_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "On aurait dû creuser là-bas depuis longtemps !",
  },
  {
    "key": "ore_vendor.conversation_g3jyqr_text",
    "notes": "Speaker=Barnacle Jones Notes=*format*'",
    "value": "Pour sûr, j'ai entendu dire que les ruines sont occupées par un culte de dingues, qui vénèrent la fin du monde.",
  },
  {
    "key": "ore_vendor.conversation_m4g0mn_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Ils font c'qu'ils veulent, c'est pas mon genre d'me mêler de c'qui me regarde pas, si tu vois c'que je veux dire ?",
  },
  {
    "key": "ore_vendor.conversation_figdnq_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Dis voir, cette ville, j'y suis venu quand j'étais tout gamin. J'voulais éviter une vie sur les docks.",
  },
  {
    "key": "ore_vendor.conversation_saxa80_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "La ville était toute petite dans l'temps, mais elle avait du potentiel, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_c0haij_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'ai réussi à monter une affaire qui tourne bien rien qu'avec mes pinces et mes boulons.",
  },
  {
    "key": "ore_vendor.conversation_3qiyya_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kid",
    "value": "Il faut vouloir aller plus loin que les autres pour réussir, ma petite.",
  },
  {
    "key": "ore_vendor.conversation_281tok_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "Aucune récompense n'arrive sans risque.",
  },
  {
    "key": "ore_vendor.conversation_ef7tr2_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'ai entendu parler d'une jungle étrange qui grandirait dans la mine.",
  },
  {
    "key": "ore_vendor.conversation_amxf2l_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'pense pas que c'est le genre de chose qui va te ralentir.",
  },
  {
    "key": "ore_vendor.conversation_mp7r9y_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'ai juste peur que ça fasse fuir les mineurs mauviettes, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_fmy8mc_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "La prof finalise sa fusée, elle s'ra bientôt prête à décoller.",
  },
  {
    "key": "ore_vendor.conversation_mxjgvx_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'croyais que c'était une folle-dingo, mais p't'êt' qu'elle a raison au final, tu vois ?",
  },
  {
    "key": "ore_vendor.conversation_gd4ef6_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "L'espace est un endroit totalement inexploré, j'suis certain qu'il y a des bonnes affaires à faire !",
  },
  {
    "key": "ore_vendor.conversation_wr4wq2_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* changed doll to kiddo",
    "value": "J'ai réussi à m'créer une vie à partir de rien, ma petite.",
  },
  {
    "key": "ore_vendor.conversation_mkud7m_text",
    "notes": "Speaker=Barnacle Jones",
    "value": "J'sais encore mieux à quoi m'attendre que quand j'étais gamin.",
  },
  {
    "key": "ore_vendor.conversation_08cc91_text",
    "notes": "Speaker=Barnacle Jones Notes=*new* moved it to the bottom",
    "value": "Reviens quand tu veux, surtout si tu as du minerai à vendre, on s'comprend ?",
  },
  {
    "key": "inhabitant_01.conversation_07qv1j_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Mon bon à rien de fils ne sait pas ce qu'il fait.",
  },
  {
    "key": "inhabitant_01.conversation_vx6mcl_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Nous avons besoin de personnes compétentes là-dessous pour trouver l'origine de ces maudits tremblements !",
  },
  {
    "key": "inhabitant_01.conversation_hlqiyo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je suis familier avec les mouvements des plaques tectoniques. Par mes rouages, ça n'en est pas, ma chère !",
  },
  {
    "key": "inhabitant_01.conversation_q4ltpg_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Nous avons besoin de quelqu'un de brave sachant utiliser son cerveau pour descendre dans cette mine.",
  },
  {
    "key": "inhabitant_01.conversation_8w93yl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'ai travaillé la mine pendant longtemps, ma chère... mais je n'ai jamais ressenti quelque chose de similaire à ces tremblements.",
  },
  {
    "key": "inhabitant_01.conversation_ibhbb2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'irais vérifier moi-même si j'en avais la capacité... regardez-moi, je n'ai plus rien d'une mineuse.",
  },
  {
    "key": "inhabitant_01.conversation_ffq3ty_text",
    "notes": "Speaker=Dorothy",
    "value": "Qu'est-ce qui vous est arrivé ?",
  },
  {
    "key": "inhabitant_01.conversation_9hmzci_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Oh ! Est-ce que c'était un horrible accident minier ?",
  },
  {
    "key": "inhabitant_01.conversation_uy4syk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Du tout ! J'ai donné beaucoup de mes morceaux pour créer mes garçons. La plus grosse erreur de ma vie.",
  },
  {
    "key": "inhabitant_01.conversation_g3ij4k_text",
    "notes": "Speaker=Fen Notes=*new* changed format from emph to singsong",
    "value": "{format singsong}ENNUYEUX !{format reset}",
  },
  {
    "key": "inhabitant_01.conversation_xxgpup_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Si je le pouvais encore, je descendrais dans ces tunnels en un rien de temps !",
  },
  {
    "key": "inhabitant_01.conversation_dgq9o3_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Si tu penses descendre profondément, tu ferais mieux de {format highlight}réparer la lumière{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_o8vje6_text",
    "notes": "Speaker=Dorothy",
    "value": "Est-ce que la mine est si dangereuse ?",
  },
  {
    "key": "inhabitant_01.conversation_0c28a8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Eh bien, il y a des sacrées bestioles là-dessous mais, au moins, je n'ai pas croisé de soiffards depuis un moment.",
  },
  {
    "key": "inhabitant_01.conversation_tt1za6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Mon aîné s'est occupé de réparer les murs pour empêcher ces maudites créatures d'entrer.",
  },
  {
    "key": "inhabitant_01.conversation_n71xfs_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je n'étais qu'une jeune botinette quand les guerres des soiffards se sont terminées, mais je me souviens encore du pire.",
  },
  {
    "key": "inhabitant_01.conversation_u3tho1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Quoi qu'il en soit, il vaut mieux se préparer avant de descendre, ma chère.",
  },
  {
    "key": "inhabitant_01.conversation_8xtyi1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format highlight}Utilise l'établi{format reset} proche de la mine pour réparer cette lumière, du moins si tu as de quoi payer pour les pièces...",
  },
  {
    "key": "inhabitant_01.conversation_y2vq9y_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Par mes rouages ! Tu as l'air fin prête pour {format highlight}entrer dans la mine{format reset}, ma chère.",
  },
  {
    "key": "inhabitant_01.conversation_st3zju_text",
    "notes": "Speaker=Dorothy",
    "value": "Est-ce que quelqu'un s'est rendu au Passage de la Roche Rouge récemment ?",
  },
  {
    "key": "inhabitant_01.conversation_0zamqc_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Pas depuis que ces tubes ont cessé de fonctionner, ma chère.",
  },
  {
    "key": "inhabitant_01.conversation_5atg04_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu vas devoir passer par-là si tu veux explorer toute la mine.",
  },
  {
    "key": "inhabitant_01.conversation_caroq1_text",
    "notes": "Speaker=Dorothy",
    "value": "Je devrais d'abord m'occuper de {format highlight}ces tubes{format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_kq5k2e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "N'oublie pas que la densité augmente plus tu descends, tu auras besoin d'équipements spécifiques pour continuer à creuser.",
  },
  {
    "key": "inhabitant_01.conversation_yo8vom_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Passer par la Roche Rouge est le seul moyen de descendre plus profondément dans la mine, du moins tant que le système de tubes n'est pas réparé.",
  },
  {
    "key": "inhabitant_01.conversation_sxlsip_text",
    "notes": "Speaker=Dorothy",
    "value": "J'espère que je pourrai utiliser des explosifs pour ouvrir le Passage de la Roche Rouge.",
  },
  {
    "key": "inhabitant_01.conversation_2e9pz1_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ça devrait fonctionner sans problème. J'ai employé les mêmes moyens dans ma jeunesse.",
  },
  {
    "key": "inhabitant_01.conversation_wkl33e_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Va d'abord à la Station sans pression pour {format highlight}obtenir ces explosifs {format reset}.",
  },
  {
    "key": "inhabitant_01.conversation_xtf9h2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ne devrions-nous pas être heureux que le passage tienne tel quel ? Je ne pense pas que notre assurance couvre les explosions.",
  },
  {
    "key": "inhabitant_01.conversation_5jzc1m_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Le Passage de la Roche Rouge est le seul moyen d'aller plus profondément dans la mine puisque le système de tubes ne fonctionne pas.",
  },
  {
    "key": "inhabitant_01.conversation_3vmqnk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'espère que tu fais des progrès là-dessous, ma chère.",
  },
  {
    "key": "inhabitant_01.conversation_u6rmdw_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Prof Sherman m'inquiète de plus en plus à propos de ces tremblements.",
  },
  {
    "key": "inhabitant_01.conversation_nxlgy6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Elle est là-haut à dépenser toutes ses économies pour construire une fusée.",
  },
  {
    "key": "inhabitant_01.conversation_ginz3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Elle est incroyablement brillante, j'imagine qu'elle travaille sur une porte de sortie.",
  },
  {
    "key": "inhabitant_01.conversation_jkfreb_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'aurais tellement aimé que mon idiot de fils puisse l'écouter pendant plus de deux secondes.",
  },
  {
    "key": "inhabitant_01.conversation_3pntbk_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Eh bien, on dirait que tu as le minage dans les rouages, n'est-ce pas ?",
  },
  {
    "key": "inhabitant_01.conversation_ebwh66_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Rends-toi au Passage de la Roche Rouge pour nettoyer les débris.",
  },
  {
    "key": "inhabitant_01.conversation_dayt2l_text",
    "notes": "Speaker=Dorothy",
    "value": "La Roche Rouge a explosé comme il faut avec une seule charge !",
  },
  {
    "key": "inhabitant_01.conversation_5ji97r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Oui, mis à part tous ces effondrements, c'est une construction plutôt solide.",
  },
  {
    "key": "inhabitant_01.conversation_m6zdrd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Je suis juste heureux que cela tienne toujours debout.",
  },
  {
    "key": "inhabitant_01.conversation_k7klvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu vas devoir améliorer ton équipement si tu veux pouvoir creuser dans les profondeurs.",
  },
  {
    "key": "inhabitant_01.conversation_dspvhm_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Et n'oublie pas de rapporter plus de pierres précieuses !",
  },
  {
    "key": "inhabitant_01.conversation_sl7olj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "N'hésite pas à dépenser un peu pour maintenir ton équipement au top. Tu trouveras des merveilles dans les profondeurs.",
  },
  {
    "key": "inhabitant_01.conversation_x0wxp1_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai besoin de me rendre à la Station tête au carré.",
  },
  {
    "key": "inhabitant_01.conversation_63gsgh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Il y a plein de brèches et de passages là-dessous, tu peux me croire !",
  },
  {
    "key": "inhabitant_01.conversation_qp9quj_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Mes frères savent les trouver... et se perdre ensuite.",
  },
  {
    "key": "inhabitant_01.conversation_x7yuib_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ces sacs à viande de soiffards sont connus pour passer par là et semer le chaos !",
  },
  {
    "key": "inhabitant_01.conversation_hc3b2x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Explore la mine du côté des murs de soiffards. Tu devrais trouver la {format highlight}Station de minage{format reset}, ma chère.",
  },
  {
    "key": "inhabitant_01.conversation_gducoe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "As-tu finalement croisé des soiffards, ma chère ? Ça fait un moment qu'ils n'ont pas causé de problèmes.",
  },
  {
    "key": "inhabitant_01.conversation_yr3kie_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai remarqué qu'ils avaient disparu d'en-dessous de Tumbleton aussi, la ville d'où je viens.",
  },
  {
    "key": "inhabitant_01.conversation_owuynx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "C'est donc un phénomène répandu alors ? Ça doit bien faire des mois, si c'est pas plus, que j'en ai vu un.",
  },
  {
    "key": "inhabitant_01.conversation_3h8ujv_text",
    "notes": "Speaker=Dorothy",
    "value": "Ils se font rares depuis que Rusty a détruit Vectron, le monstre technologique.",
  },
  {
    "key": "inhabitant_01.conversation_ezzezr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je ne sais pas grand chose sur ça... tout ce que je sais, c'est que les soiffards se font rares.",
  },
  {
    "key": "inhabitant_01.conversation_dpbib8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ils trouvaient toujours moyen de passer à travers le mur et venir créer des problèmes pour les mineurs.",
  },
  {
    "key": "inhabitant_01.conversation_3c3lpm_text",
    "notes": "Speaker=Ma Yonker",
    "value": "C'est peut-être lié aux tremblements ? Comme toute bonne vermine, ils fuient le vaisseau qui coule !",
  },
  {
    "key": "inhabitant_01.conversation_tcvt6a_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je ne pourrais pas dire si c'est un bon ou mauvais signe.",
  },
  {
    "key": "inhabitant_01.conversation_67vh5i_text",
    "notes": "Speaker=Dorothy",
    "value": "Hé ! J'ai trouvé les soiffards ! Ils ont construit une petite ville cachée dans les profondeurs de la mine.",
  },
  {
    "key": "inhabitant_01.conversation_iu5kqd_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Par les saintes huiles ! J'éviterais d'aller dans un tel endroit. C'est probablement très dangereux !",
  },
  {
    "key": "inhabitant_01.conversation_vhdww6_text",
    "notes": "Speaker=Dorothy",
    "value": "Ils n'avaient pas l'air si terribles. Ils n'étaient pas comme ceux que j'ai pu croiser avant.",
  },
  {
    "key": "inhabitant_01.conversation_cbcmjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je suis certaine d'une chose, il ne faut jamais faire confiance à un soiffard !",
  },
  {
    "key": "inhabitant_01.conversation_0glm7l_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ne t'approche pas de cette ville de soiffards, du moins si tu veux éviter les problèmes !",
  },
  {
    "key": "inhabitant_01.conversation_umbt7u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Creuser non loin du temple est assez dangereux mais tu y trouveras beaucoup de ressources.",
  },
  {
    "key": "inhabitant_01.conversation_c5baff_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Eh bien, c'est plutôt prometteur ! Tu devrais y aller et en trouver le plus possible !",
  },
  {
    "key": "inhabitant_01.conversation_r8rlnp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu vas avoir besoin d'un brin de courage pour entrer dans ces ruines.",
  },
  {
    "key": "inhabitant_01.conversation_m8hqwy_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Même ses frères ne sont pas assez dingues pour {format highlight}entrer dans le temple{format reset} par-delà les Plaines venteuses.",
  },
  {
    "key": "inhabitant_01.conversation_bvz9xj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Un culte de détraqués occupe les lieux.",
  },
  {
    "key": "inhabitant_01.conversation_fj6bw8_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ils occupent aussi les ruines dans le Désert de l'Ouest.",
  },
  {
    "key": "inhabitant_01.conversation_u26tuh_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je suis certaine que le vieux Ronald est toujours aux commandes. C'était plutôt un gars gentil mais tout ce fanatisme a finalement eu raison de lui.",
  },
  {
    "key": "inhabitant_01.conversation_gr738j_text",
    "notes": "Speaker=Ma Yonker Notes=*format*",
    "value": "Le temple par-delà les Plaines venteuses est peut-être rempli de richesses, mais ça reste un endroit très dangereux pour n'importe quel mineur.",
  },
  {
    "key": "inhabitant_01.conversation_grrmq6_text",
    "notes": "Speaker=Ma Yonker",
    "value": "On dirait que tu as bien avancé dans ta quête, ma chère !",
  },
  {
    "key": "inhabitant_01.conversation_335kyr_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu vas sûrement trouver des traces d'anciennes civilisations là-dessous. Comme ces vieilles machines dans la Station de minage.",
  },
  {
    "key": "inhabitant_01.conversation_2jepw2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "D'aussi loin que je puisse me souvenir, elles ont toujours été là.",
  },
  {
    "key": "inhabitant_01.conversation_mv0s6q_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'ai entendu des bots sagaces dire que c'est les soiffards qui les ont construites.",
  },
  {
    "key": "inhabitant_01.conversation_vxki0p_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Ces "experts" ne savent rien.",
  },
  {
    "key": "inhabitant_01.conversation_ysj9vo_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je ne risquerais pas de miner si profond en dessous des terres des soiffards. Qui sait ce que tu vas y trouver ?!",
  },
  {
    "key": "inhabitant_01.conversation_uj1muo_text",
    "notes": "Speaker=Dorothy",
    "value": "Je dois creuser partout si je veux arrêter ces tremblements.",
  },
  {
    "key": "inhabitant_01.conversation_ykczsp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'ai entendu parler d'une jungle qui se répand dans la mine.",
  },
  {
    "key": "inhabitant_01.conversation_z8gocf_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Par mes rouages ! Ce n'est pas bien du tout !",
  },
  {
    "key": "inhabitant_01.conversation_dzwjvq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Comment miner avec autant de dangers tout autour ? Comment vont faire mes gars ?",
  },
  {
    "key": "inhabitant_01.conversation_x3v93r_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je ne sais pas si tu as remarqué mais ils sont vraiment très stupides.",
  },
  {
    "key": "inhabitant_01.conversation_jmwahi_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'imagine qu'il va falloir trouver une place dans cette fusée.",
  },
  {
    "key": "inhabitant_01.conversation_8augkl_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Mes gars sont peut-être stupides mais ils sont le fruit – littéralement – de mes morceaux.",
  },
  {
    "key": "inhabitant_01.conversation_9v0sjx_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'ai plus qu'à trouver cinq billets pour aller dans l'espace, non ?",
  },
  {
    "key": "inhabitant_01.conversation_p75xau_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Merci d'écouter les divagations d'une vieille mamabot. Tu fais honneur à tes parents ma petite !",
  },
  {
    "key": "inhabitant_01.conversation_8hjn65_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Pas comme mes gars. Pas un boulon d'utile dans chacun.",
  },
  {
    "key": "inhabitant_01.conversation_x6q3po_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ils ne font que de se perdre dans les mines. Et puis il y a ce fichu politicien là.",
  },
  {
    "key": "inhabitant_01.conversation_8tssip_text",
    "notes": "Speaker=Ma Yonker",
    "value": "C'est une bonne chose d'avoir quelqu'un qui sait quoi faire dans ces tunnels !",
  },
  {
    "key": "inhabitant_02.conversation_royiqq_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*new*",
    "value": "Oh là là, Oh là là ! C'était un très gros {format nervous}tremblement{format reset}.",
  },
  {
    "key": "inhabitant_02.conversation_0z0jlu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ça alors ! Tu as l'air d'une bot de la campagne, comme moi ! {format singsong}C'est fantastique !{format reset}",
  },
  {
    "key": "inhabitant_02.conversation_i3c2ki_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Je me sens si seule dernièrement. Comme une étrangère.",
  },
  {
    "key": "inhabitant_02.conversation_fnv0dz_text",
    "notes": "Speaker=Fen",
    "value": "Je pensais que c'était une odeur latente de latrines mais non, c'est bien l'odeur du désespoir...",
  },
  {
    "key": "inhabitant_02.conversation_q58pva_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Le machin brillant a raison, je ne suis pas faite pour la vie dans la grande ville.",
  },
  {
    "key": "inhabitant_02.conversation_r68qcd_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen, tu pourrais essayer d'être ne serait-ce qu'un tout petit peu agréable ? Tu verras, ça change tout.",
  },
  {
    "key": "inhabitant_02.conversation_6c81lb_text",
    "notes": "Speaker=Fen",
    "value": "J'en doute.",
  },
  {
    "key": "inhabitant_02.conversation_qy4k1b_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je devrais juste rentrer à la ferme.",
  },
  {
    "key": "inhabitant_02.conversation_q27f56_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Re-bonjour, amie de la campagne !",
  },
  {
    "key": "inhabitant_02.conversation_bfqhtj_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Les bots se plaignent de l'incompétence du maire.",
  },
  {
    "key": "inhabitant_02.conversation_xpriw7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Pourtant j'ai l'impression qu'il sait de quoi il parle.",
  },
  {
    "key": "inhabitant_02.conversation_kqxpuz_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Après tout, il vient de la grande ville... Il doit savoir comment les choses fonctionnent.",
  },
  {
    "key": "inhabitant_02.conversation_tdhokx_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Si je devais m'occuper des problèmes d'une aussi grande ville, je ne pense pas que je pourrais m'en sortir !",
  },
  {
    "key": "inhabitant_02.conversation_0k5x6v_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je pense que le maire sait ce qu'il fait.",
  },
  {
    "key": "inhabitant_02.conversation_unbiry_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "Bonjour bonjour, amie !",
  },
  {
    "key": "inhabitant_02.conversation_fdlynd_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ce n'est pas facile de rencontrer les gens ici.",
  },
  {
    "key": "inhabitant_02.conversation_7ymnmr_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "C'est pas comme à la maison. Tout le monde se connaît dès l'assemblage.",
  },
  {
    "key": "inhabitant_02.conversation_enl4xa_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "La vie grouille de vie, les gens sont tous trop occupés pour s'arrêter et discuter. Ils n'ont même pas le temps d'être gentils les uns avec les autres !",
  },
  {
    "key": "inhabitant_02.conversation_aptgjz_text",
    "notes": "Speaker=Fen",
    "value": "Ou juste avec toi.",
  },
  {
    "key": "inhabitant_02.conversation_cqddcg_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen ! Fais un effort !",
  },
  {
    "key": "inhabitant_02.conversation_3avufg_text",
    "notes": "Speaker=Penny Kettlebottom Notes=*format*",
    "value": "*Soupir* Je me demande parfois si les gens se rendent compte quand quelqu'un disparaît.",
  },
  {
    "key": "inhabitant_02.conversation_bibnd6_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "De ce que je comprends, beaucoup de gens se perdent dans les environs.",
  },
  {
    "key": "inhabitant_02.conversation_l5r7sq_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "À la campagne, on cultive la loyauté et l'amitié.",
  },
  {
    "key": "inhabitant_02.conversation_axrc0a_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "J'ai vu que tu étais comme moi dès que je t'ai vue ! Tu sais tout de la loyauté et de l'amitié, n'est-ce pas ?",
  },
  {
    "key": "inhabitant_02.conversation_4ure1i_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "As-tu parlé avec la folle qui construit une fusée plus haut dans la ville ?",
  },
  {
    "key": "inhabitant_02.conversation_qahysn_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je crois qu'elle a hérité de beaucoup d'argent mais qu'elle dépense tout pour construire cette fusée.",
  },
  {
    "key": "inhabitant_02.conversation_5923lp_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "C'est du gâchis !",
  },
  {
    "key": "inhabitant_02.conversation_t94xdc_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Il y avait quelqu'un qui faisait pareil à la ferme.",
  },
  {
    "key": "inhabitant_02.conversation_x71xpu_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Peut-être qu'ils savent quelque chose, tu ne crois pas ?",
  },
  {
    "key": "inhabitant_02.conversation_q3y399_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je crois que la sienne sera plus belle. Celle à la ferme ressemblait juste à un gros silo.",
  },
  {
    "key": "inhabitant_02.conversation_12pu8k_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Quand je pense à tous ces bots qui construisent des fusées un peu partout dans le monde, ça me fait {format laugh}rire{format reset} !",
  },
  {
    "key": "inhabitant_02.conversation_e4onuf_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu as l'air fatigué !",
  },
  {
    "key": "inhabitant_02.conversation_ob0wy7_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Il y a trop de choses qui se passent, je n'arrive pas à suivre !",
  },
  {
    "key": "inhabitant_02.conversation_54qfjg_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "J'ai pris ma décision, je vais rentrer à la ferme !",
  },
  {
    "key": "inhabitant_02.conversation_i33o07_text",
    "notes": "Speaker=Penny Kettlebottom Notes=Kettle, as in a pun on cattle. Steam cows are called Kettle.",
    "value": "La seule distraction là-bas c'est quand Pépé Pepper sort les anibots de la grange.",
  },
  {
    "key": "inhabitant_02.conversation_7bo632_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je ne suis pas faite pour vivre avec autant de stress. Je vais m'installer quelque part avec une douzaine de chabots !",
  },
  {
    "key": "inhabitant_02.conversation_jcodma_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Peut-être même que je vais battre Laura Corneseau dans la compétition de graissage de rouages !",
  },
  {
    "key": "inhabitant_02.conversation_rjax07_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Ça serait juste {format singsong}magique{format reset} de battre cette Laura Corneseau !",
  },
  {
    "key": "inhabitant_02.conversation_kzt23q_text",
    "notes": "Speaker=Penny Kettlebottom",
    "value": "Je pense que je vais juste rentrer à la ferme.",
  },
  {
    "key": "climber_01.conversation_vyjpoj_text",
    "notes": "Speaker=Lady Botterley Notes=*format* There is a crashed elevator just next to them.",
    "value": "Ce tremblement a fait s'écraser l'ascenseur !",
  },
  {
    "key": "climber_01.conversation_ctbic6_text",
    "notes": "Speaker=Fen Notes=*new* Added format on "Ooooh", removed horribly double use of horribly. Gleefully. Fen has lot of scadenfreude! :)",
    "value": "{format singsong}Ooooh !{format reset} Est-ce que quelqu'un était en dessous au moment des faits ?",
  },
  {
    "key": "climber_01.conversation_m9r7tc_text",
    "notes": "Speaker=Lady Botterley Notes=*new* changed horrible to terrible and emphasised "thing"",
    "value": "Quoi ? {format nervous}Pas du tout !{format reset} Quel genre de terrible {format emph}chose{format reset} es-tu ?",
  },
  {
    "key": "climber_01.conversation_045qay_text",
    "notes": "Speaker=Fen Notes=She was locked in a statue before Dorothy destroyed it, then she moved into Dorothys chest cavity.",
    "value": "Hé ! Je ne suis {format emph}pas{format reset} une chose ! Si j'avais encore mon totem, je pourrais te zapper sur l'instant !",
  },
  {
    "key": "climber_01.conversation_fccwnq_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Eh bien, peu importe ce que tu es, tu manques cruellement de manières.",
  },
  {
    "key": "climber_01.conversation_8oqmau_text",
    "notes": "Speaker=Dorothy",
    "value": "Excusez-nous m'dame, Fen n'a pas encore appris la courtoisie.",
  },
  {
    "key": "climber_01.conversation_acx7g7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Combien de temps vais-je devoir attendre qu'un reparbot vienne s'occuper de l'ascenseur ?",
  },
  {
    "key": "climber_01.conversation_matp87_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Une bot de ma condition ne devrait pas avoir à attendre dans le désert !",
  },
  {
    "key": "climber_01.conversation_eb6uiw_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Une bot de ma condition ne devrait pas avoir à attendre dans le désert !",
  },
  {
    "key": "climber_01.conversation_c7c7g6_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ce maire que nous avons n'est pas d'une bonne lignée, toutefois, il est plutôt raffiné.",
  },
  {
    "key": "climber_01.conversation_mdqfxx_text",
    "notes": "Speaker=Lady Botterley Notes=This is in reference to that all steambots are assembled, but the "soul" may lay in the parts, but anyone has free will.",
    "value": "Ce n'est pas impossible de surpasser sa condition initiale d'assemblage.",
  },
  {
    "key": "climber_01.conversation_uynh2z_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je me dois de croire en son jugement, les autres devraient aussi.",
  },
  {
    "key": "climber_01.conversation_if7w3g_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Il ne faut pas s'inquiéter par rapport à ces tremblements. L'ascenseur avait de toute manière besoin d'une réparation.",
  },
  {
    "key": "climber_01.conversation_540zgf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "J'espère vraiment qu'ils vont envoyer quelqu'un pour réparer cet engin rapidement. Je {format emph}n'ai pas{format reset} de temps à perdre avec ces bêtises.",
  },
  {
    "key": "climber_01.conversation_t8w29c_text",
    "notes": "Speaker=Dorothy",
    "value": "Donc... l'ascenseur n'est toujours pas réparé ?",
  },
  {
    "key": "climber_01.conversation_2y8m3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Bien évidemment que non.",
  },
  {
    "key": "climber_01.conversation_sbn8ap_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Cet endroit n'est peut-être pas digne de ma personne mais c'est au moins relativement silencieux.",
  },
  {
    "key": "climber_01.conversation_x0xmdc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Cette prof ridicule qui vit non loin, a passé la journée et la nuit à construire – bruyamment – sa fusée !",
  },
  {
    "key": "climber_01.conversation_9hvgg5_text",
    "notes": "Speaker=Fen Notes="Hoof it" - slang for run, or walk. Hoof like in horse foot!",
    "value": "Pourquoi ne pas vous grimper de l'autre côté de la falaise ?",
  },
  {
    "key": "climber_01.conversation_b63bbp_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Pardon ? Une dame ne grimpe pas !",
  },
  {
    "key": "climber_01.conversation_ff5hlh_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Une dame ne grimpe pas ! Je vais attendre la réparation de l'ascenseur ou que quelqu'un me porte, tout naturellement.",
  },
  {
    "key": "climber_01.conversation_3lbfex_text",
    "notes": "Speaker=Fen",
    "value": "Toujours là ?",
  },
  {
    "key": "climber_01.conversation_ykf245_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Oui, je suis {format emph}toujours là{format reset}. Et oui, l'ascenseur n'est toujours pas {format emph}réparé{format reset}. Nul besoin de le pointer de la sorte.",
  },
  {
    "key": "climber_01.conversation_c50t6h_text",
    "notes": "Speaker=Lady Botterley",
    "value": "C'est parfaitement absurde ! Quelqu'un de mon importance doit sûrement manquer à toute la haute société !",
  },
  {
    "key": "climber_01.conversation_8rvp8u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "J'espère que le maire a une bonne excuse !",
  },
  {
    "key": "climber_01.conversation_wpxim7_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je dois tellement manquer aux membres de la haute, je suis très importante !",
  },
  {
    "key": "climber_01.conversation_gtukg8_text",
    "notes": "Speaker=Fen",
    "value": "Vous allez juste rester ici, n'est-ce pas ?",
  },
  {
    "key": "climber_01.conversation_cudej5_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Eh bien, je vais simplement trouver une nouvelle occupation en attendant.",
  },
  {
    "key": "climber_01.conversation_h438q0_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je compte tous les pèlerins qui se rendent vers ce temple dégoûtant à l'ouest.",
  },
  {
    "key": "climber_01.conversation_e0mg3i_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je n'aurais, normalement, pas prêté attention à ces gueux, mais je m'ennuie horriblement.",
  },
  {
    "key": "climber_01.conversation_x9lbaf_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Ces pèlerins semblent fomenter quelque chose. Je ne devrais vraiment pas m'intéresser à des choses si basses.",
  },
  {
    "key": "climber_01.conversation_ef66r2_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Encore toi ? N'as-tu rien de mieux à faire que de me tourmenter ?",
  },
  {
    "key": "climber_01.conversation_4ay3w5_text",
    "notes": "Speaker=Fen",
    "value": "Si, bien entendu, mais c'est tellement drôle !",
  },
  {
    "key": "climber_01.conversation_b1t04s_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Comme si ces tremblements n'étaient pas suffisants.",
  },
  {
    "key": "climber_01.conversation_6ntyzc_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Peu importe. Je suis arrivée à la conclusion que notre maire est un idiot.",
  },
  {
    "key": "climber_01.conversation_9sm12u_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je sais que c'est impensable mais il m'arrive parfois de me tromper, légèrement.",
  },
  {
    "key": "climber_01.conversation_ce5r53_text",
    "notes": "Speaker=Fen",
    "value": "Sans déconner ?",
  },
  {
    "key": "climber_01.conversation_1zdfzx_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je me demande combien coûte un ticket pour cette fusée...",
  },
  {
    "key": "climber_01.conversation_4y3t9l_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Je me demande combien coûte un ticket pour cette fusée...",
  },
  {
    "key": "climber_01.conversation_bfqth1_text",
    "notes": "Speaker=Lady Botterley",
    "value": "Une bot de ma condition ne devrait pas avoir à atteindre dans le désert !",
  },
  {
    "key": "entering_guidance.conversation_kohvbb_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "{format emph}Aïe !{format reset}",
  },
  {
    "key": "entering_guidance.conversation_1a5f80_text",
    "notes": "Speaker=Dorothy Notes=*format* *DEMO*",
    "value": "Oh non, pas ça ! Bon sang ! Ma lumière s'est cassée.",
  },
  {
    "key": "entering_guidance.conversation_9rx08a_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Waouh ! C'est {format emph}quoi{format reset} cet endroit ?",
  },
  {
    "key": "entering_guidance.conversation_ojjbl5_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Je dois l'explorer pour trouver {format highlight}une autre sortie{format reset}.",
  },
  {
    "key": "cutscene_fen.conversation_y5enud_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "Oh, {format singsong}glorieuse Lumière à suivre !{format reset} Éclaire-moi !",
  },
  {
    "key": "cutscene_fen.conversation_hnsad0_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "OUI, TU PEUX BAIGNER DANS MA LUMIÈRE DESTRUCTRICE.",
  },
  {
    "key": "cutscene_fen.conversation_a1al3q_text",
    "notes": "Speaker=Cultist Notes=*DEMO*",
    "value": "{format singsong}Bénédiction !{format reset} L'extase ultime nous attend !",
  },
  {
    "key": "cutscene_fen_02.conversation_2ln8fi_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Hé ! J'allais juste t'allumer, espèce de dingue.",
  },
  {
    "key": "cutscene_fen_02.conversation_qzp3tz_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai essayé de te le dire, je ne suis {format emph}pas une cultiste.{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_ksn1s4_text",
    "notes": "Speaker=Fen",
    "value": "Vraiment ? Vous autres les bots, vous vous ressemblez tous.",
  },
  {
    "key": "cutscene_fen_02.conversation_g22jzu_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}Toi{format reset} par contre, tu ressembles à une sorte d'esprit Vectron. Comment est-ce {format emph}possible ?{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_01a075_text",
    "notes": "Speaker=Dorothy",
    "value": "Mon ami Rusty a détruit Vectron avant de disparaître.",
  },
  {
    "key": "cutscene_fen_02.conversation_w28at6_text",
    "notes": "Speaker=Fen",
    "value": "Ce culte m'a capturé et placé ici pour me vénérer. Ils veulent que je les zappe. {format laugh}Hé hé hé !{format reset}",
  },
  {
    "key": "cutscene_fen_02.conversation_krzwlf_text",
    "notes": "Speaker=Fen",
    "value": "Hmm... Je ne peux pas le faire sans mon super totem. Qu'est-ce qu'on fait maintenant ?",
  },
  {
    "key": "cutscene_fen_02.conversation_wfa9i6_text",
    "notes": "Speaker=Dorothy",
    "value": "Eh bien, {format emph}JE{format reset} vais dans la grande ville. On m'a dit que Rusty y était.",
  },
  {
    "key": "cutscene_fen_02.conversation_qhu4n0_text",
    "notes": "Speaker=Fen",
    "value": "En ville tu dis ? D'accord, puisque tu insistes, je vais t'accompagner.",
  },
  {
    "key": "cutscene_fen_01.conversation_e2v16f_text",
    "notes": "Speaker=The Guiding Light Notes=*DEMO*",
    "value": "EN UN SEUL COUP ! {format laugh}HÉ HÉ HÉ !{format reset}",
  },
  {
    "key": "cutscene_fen_01.conversation_z0997i_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Waouh ! Qu'est-ce qui {format emph}se passe{format reset} ici ?",
  },
  {
    "key": "cutscene_fen_01.conversation_0dz6we_text",
    "notes": "Speaker=The Guiding Light Notes=*format* *DEMO*",
    "value": "SUPER ! UN AUTRE PÈLERIN !",
  },
  {
    "key": "cutscene_fen_01.conversation_mzljgp_text",
    "notes": "Speaker=Dorothy Notes=*DEMO*",
    "value": "Mais je ne suis pas un...",
  },
  {
    "key": "cutscene_fen_01.conversation_yadt78_text",
    "notes": "Speaker=The Guiding Light Notes=*new* *DEMO* moved the pew-pew line from below into this line.",
    "value": "PRÉPARE-TOI À TE FAIRE ZAPPER ! {format laugh}PEW-PEW !{format reset}",
  },
  {
    "key": "fen_ledge_01.conversation_cukwql_text",
    "notes": "Speaker=Fen",
    "value": "Oh whaou ! Ça c'est une vue ! Pourquoi ne pas se rapprocher un petit peu...",
  },
  {
    "key": "fen_ledge_02.conversation_aszmw4_text",
    "notes": "Speaker=Fen",
    "value": "Rapproche-toi !",
  },
  {
    "key": "fen_ledge_02.conversation_skvrgn_text",
    "notes": "Speaker=Fen",
    "value": "{format singsong}Encore plus...{format reset} {format laugh}hé hé hé !{format reset}",
  },
  {
    "key": "old_salesbot_01.conversation_x6t79e_text",
    "notes": "Speaker=Trader Carson",
    "value": "Mais c'est bel et bien la petite Dorothy McCrank !",
  },
  {
    "key": "old_salesbot_01.conversation_yu1bwf_text",
    "notes": "Speaker=Dorothy",
    "value": "Négociant Carson ! Je ne pensais pas croiser une tête connue si loin de la maison !",
  },
  {
    "key": "old_salesbot_01.conversation_0hioym_text",
    "notes": "Speaker=Trader Carson",
    "value": "Qu'est-ce qui est arrivé à Tumbleton ? J'ai entendu toutes sortes de rumeurs.",
  },
  {
    "key": "old_salesbot_01.conversation_dslq5p_text",
    "notes": "Speaker=Dorothy",
    "value": "Tout a commencé lorsque Rusty est arrivé. La ville se portait bien à mesure que les ressources étaient extraites.",
  },
  {
    "key": "old_salesbot_01.conversation_8tr70j_text",
    "notes": "Speaker=Dorothy",
    "value": "Puis Rusty a découvert une vieille technologie étrange dans les profondeurs. Il a fusionné avec et il est devenu plus fort.",
  },
  {
    "key": "old_salesbot_01.conversation_70kkpo_text",
    "notes": "Speaker=Fen",
    "value": "Allez, passe la seconde et raconte-moi les détails croustillants !",
  },
  {
    "key": "old_salesbot_01.conversation_xfpxnh_text",
    "notes": "Speaker=Dorothy",
    "value": "Eh bien, ce pouvoir était en fait dangereux pour tout le monde.",
  },
  {
    "key": "old_salesbot_01.conversation_epbknd_text",
    "notes": "Speaker=Dorothy",
    "value": "Il l'a combattu et nous a sauvés mais il a disparu ensuite. J'essaye de le retrouver depuis.",
  },
  {
    "key": "old_salesbot_01.conversation_c5qvu8_text",
    "notes": "Speaker=Dorothy",
    "value": "Un voyageur a vu une de mes affiches et m'a dit qu'il avait vu entrer Rusty dans la mine d'El Machino.",
  },
  {
    "key": "old_salesbot_01.conversation_i625og_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ouaip, c'est toute une histoire !",
  },
  {
    "key": "old_salesbot_01.conversation_umknih_text",
    "notes": "Speaker=Dorothy",
    "value": "En bref, un ami a disparu.",
  },
  {
    "key": "old_salesbot_01.conversation_hp7xc3_text",
    "notes": "Speaker=Dorothy",
    "value": "Un voyageur a vu une de mes affiches et m'a dit qu'il l'avait vu entrer dans la mine d'El Machino.",
  },
  {
    "key": "old_salesbot_01.conversation_nfwjrx_text",
    "notes": "Speaker=Trader Carson Notes=*new* changed "well", to "now"",
    "value": "L'engin pour accéder à la ville est cassé.Tu vas devoir {format highlight}grimper la falaise{format reset} pour y entrer.",
  },
  {
    "key": "old_salesbot_01.conversation_c1qqn0_text",
    "notes": "Speaker=Trader Carson",
    "value": "J'serai là-haut très bientôt moi aussi. Viens me voir si tu veux acheter des {image cogs_small} Méca dopeurs pour explorer la mine plus facilement.",
  },
  {
    "key": "old_salesbot_01.conversation_m6jpam_text",
    "notes": "Speaker=Trader Carson",
    "value": "J'espère que tu auras plus de chance que moi.",
  },
  {
    "key": "old_salesbot_01.conversation_q4eiud_text",
    "notes": "Speaker=Trader Carson",
    "value": "Très bien, je vais aller reposer mes vieilles jointures pendant un moment avant de grimper moi aussi.",
  },
  {
    "key": "old_salesbot_01.conversation_yx3y9m_text",
    "notes": "Speaker=Trader Carson",
    "value": "Pourquoi ne me raconterais-tu pas ce qui est arrivé à Tumbleton pendant qu'on patiente ?",
  },
  {
    "key": "old_salesbot_01.conversation_x7qfv2_text",
    "notes": "Speaker=Trader Carson",
    "value": "Très bien, peut-être une autre fois.",
  },
  {
    "key": "old_salesbot_01.conversation_5nktdz_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ah ! J'aime tellement être dans les beaux quartiers de la ville.",
  },
  {
    "key": "old_salesbot_01.conversation_tj5uh7_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ces hipsterbots sont prêts à payer n'importe quoi pour mes authentiques {image cogs_small} Méca dopeurs.",
  },
  {
    "key": "old_salesbot_01.conversation_nqd450_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Les affaires ont été bonnes pour moi.",
  },
  {
    "key": "old_salesbot_01.conversation_ny6f1a_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "En général je me procure ces dopeurs un peu partout, ventes de garage, boutiques d'occasions, mais tu peux aussi en trouver dans la nature.",
  },
  {
    "key": "old_salesbot_01.conversation_smo857_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Ils font un bruit très particulier, unique même.",
  },
  {
    "key": "old_salesbot_01.conversation_gq1rfi_text",
    "notes": "Speaker=Trader Carson Notes=*new*",
    "value": "Il faut avoir une bonne oreille pour les débusquer. Sois attentive et tu pourras les trouver.",
  },
  {
    "key": "old_salesbot_01.conversation_dm175r_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ça fait longtemps que j'ai vu ton vieux père, comment va-t-il ?",
  },
  {
    "key": "old_salesbot_01.conversation_w6hv5b_text",
    "notes": "Speaker=Dorothy",
    "value": "Il s'est éteint il y a quelque temps.",
  },
  {
    "key": "old_salesbot_01.conversation_by4nym_text",
    "notes": "Speaker=Trader Carson",
    "value": "En voilà une bien triste nouvelle ! J'ai toujours cru qu'il allait vivre plus longtemps que tout le monde...",
  },
  {
    "key": "old_salesbot_01.conversation_1g9zr8_text",
    "notes": "Speaker=Trader Carson",
    "value": "... juste pour avoir le dernier mot.",
  },
  {
    "key": "old_salesbot_01.conversation_cgmjf4_text",
    "notes": "Speaker=Dorothy",
    "value": "C'est ce que je pensais aussi.",
  },
  {
    "key": "old_salesbot_01.conversation_i5igy1_text",
    "notes": "Speaker=Trader Carson",
    "value": "Qu'est-ce qu'il advient de ton petit magasin, maintenant que tu creuses un peu partout ?",
  },
  {
    "key": "old_salesbot_01.conversation_lp4kx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Oh, tout va bien à Tumbleton ! Il y avait plein de bots qui souhaitaient reprendre les affaires.",
  },
  {
    "key": "old_salesbot_01.conversation_a7uh25_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai toujours voulu travailler la mine, mais papa disait que c'était trop dangereux.",
  },
  {
    "key": "old_salesbot_01.conversation_kyijyo_text",
    "notes": "Speaker=Trader Carson",
    "value": "Eh bien, j'espère que tu es heureuse en faisant ce qui te plaît.",
  },
  {
    "key": "old_salesbot_01.conversation_s5417g_text",
    "notes": "Speaker=Trader Carson",
    "value": "Je ne peux pas dire que j'ai eu le plaisir de rencontrer ce courageux bot qui a sauvé ta ville.",
  },
  {
    "key": "old_salesbot_01.conversation_tgpso6_text",
    "notes": "Speaker=Trader Carson",
    "value": "Je n'avais pas d'affaire en cours dans ces environs à ce moment-là.",
  },
  {
    "key": "old_salesbot_01.conversation_10nfc4_text",
    "notes": "Speaker=Trader Carson",
    "value": "C'était quoi son nom ? Crusty... non... Trusty ! C'est ça, non ?",
  },
  {
    "key": "old_salesbot_01.conversation_vzg8gx_text",
    "notes": "Speaker=Dorothy",
    "value": "Rusty...",
  },
  {
    "key": "old_salesbot_01.conversation_ymzbde_text",
    "notes": "Speaker=Trader Carson",
    "value": "Ah oui, Rusty, c'est ça ! De ce que j'ai compris, il a débranché un monstre géant au fond de la mine.",
  },
  {
    "key": "old_salesbot_01.conversation_la8vr6_text",
    "notes": "Speaker=Trader Carson",
    "value": "Et puis il a disparu !",
  },
  {
    "key": "old_salesbot_01.conversation_k59dwv_text",
    "notes": "Speaker=Trader Carson",
    "value": "Bonne recherche, ma petite. J'espère que tu vas le retrouver en bonne santé.",
  },
  {
    "key": "old_salesbot_01.conversation_bzq0aw_text",
    "notes": "Speaker=Trader Carson Notes=*new* removed "nothing"",
    "value": "Le monde a bien changé depuis mes jeunes années.",
  },
  {
    "key": "old_salesbot_01.conversation_zc6l96_text",
    "notes": "Speaker=Trader Carson",
    "value": "Cette herbe rocheuse qui envahit la mine, ces bots qui construisent des fusées pour quitter la planète...",
  },
  {
    "key": "old_salesbot_01.conversation_jnptai_text",
    "notes": "Speaker=Trader Carson",
    "value": "Moi je me contente de vendre mes {image cogs_small} Méca dopeurs, comme toujours.",
  },
  {
    "key": "old_salesbot_01.conversation_rk0bii_text",
    "notes": "Speaker=Trader Carson",
    "value": "J'imagine que votre futur se trouve dans la création.",
  },
  {
    "key": "old_salesbot_01.conversation_r74j24_text",
    "notes": "Speaker=Trader Carson Notes=Upgrade Cogs are used to enhance various equipement. Look like golden gear/cog.",
    "value": "Dis-moi, j'ai pas mal des {image cogs_small} Méca dopeurs en stock. Je peux te faire un très bon prix !",
  },
  {
    "key": "old_salesbot_01.conversation_0qym9q_text",
    "notes": "Speaker=Trader Carson",
    "value": "J'imagine que tu as besoin de plus des {image cogs_small} Méca dopeurs ?",
  },
  {
    "key": "old_salesbot_01.conversation_yx06g0_text",
    "notes": "Speaker=Trader Carson",
    "value": "Alors, qu'en penses-tu ? Tu peux avoir un {image cogs_small} Méca dopeur pour seulement {var pricelist_next:carson_cogs}\${image money_small}.",
  },
  {
    "key": "old_salesbot_01.conversation_x4iaao_text",
    "notes": "Speaker=Trader Carson",
    "value": "Merci à toi ! Reviens quand tu veux !",
  },
  {
    "key": "old_salesbot_01.conversation_zfed36_text",
    "notes": "Speaker=Trader Carson",
    "value": "Dot, ma petite, tu es ma meilleure cliente ! C'est la dernière en stock ! Je suis content qu'elles te soient utiles !",
  },
  {
    "key": "old_salesbot_01.conversation_koo3mt_text",
    "notes": "Speaker=Trader Carson",
    "value": "Eh bien, j'aurais aimé pouvoir t'aider gratuitement, Dot, mais un simple négociant doit gagner sa vie d'une manière ou d'une autre.",
  },
  {
    "key": "old_salesbot_01.conversation_1yrec8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Pas de problème, reviens quand tu auras besoin de quelques {image cogs_small} Méca dopeurs !",
  },
  {
    "key": "old_salesbot_01.conversation_27y4o8_text",
    "notes": "Speaker=Trader Carson",
    "value": "Tu as autant de cran que ton papa, tu sais.",
  },
  {
    "key": "cutscene_fen_03.conversation_c3lb0g_text",
    "notes": "Speaker=Dorothy",
    "value": "Hé ! Qu'est-ce que tu fais ? {format emph}Sors{format reset} tout de suite de ma chaudière !",
  },
  {
    "key": "fen_conquerer.conversation_f2k0wg_text",
    "notes": "Speaker=Fen",
    "value": "Alors c'est à ça que ça ressemble la surface ? C'est... lumineux.",
  },
  {
    "key": "fen_conquerer.conversation_x8lfrw_text",
    "notes": "Speaker=Dorothy",
    "value": "Hé, ta carte est super ! Tu pourrais retrouver quelqu'un avec ?",
  },
  {
    "key": "fen_conquerer.conversation_02breo_text",
    "notes": "Speaker=Fen",
    "value": "Pas même si ça m'intéressait.",
  },
  {
    "key": "fen_conquerer.conversation_fek90f_text",
    "notes": "Speaker=Dorothy Notes=Fen is reference to "Fenlights", a supernatural folklore being that lured people into the woods.",
    "value": "Tu me fais penser à ces vilains esprits dans les histoires du vieux monde que mon papa me racontait.",
  },
  {
    "key": "fen_conquerer.conversation_duq0rd_text",
    "notes": "Speaker=Dorothy",
    "value": "Je vais juste t'appeler Fen pour faire court.",
  },
  {
    "key": "fen_conquerer.conversation_uostgv_text",
    "notes": "Speaker=Dorothy Notes=*new* split from line above",
    "value": "Je suis Dorothy mais mes amis m'appellent Dot.",
  },
  {
    "key": "fen_conquerer.conversation_em0ovz_text",
    "notes": "Speaker=Fen",
    "value": "Peu m'importe, je retourne dans ta chaudière pour le moment.",
  },
  {
    "key": "fen_conquerer.conversation_tats2u_text",
    "notes": "Speaker=Fen",
    "value": "Réveille-moi s'il y a un truc intéressant.",
  },
  {
    "key": "mayor_01.conversation_szoc5w_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Bonjour, je suis malheureusement en retard pour mon polissage. Si vous avez des plaintes à déposer, laissez-les dans mon bureau.",
  },
  {
    "key": "mayor_01.conversation_r6bmk4_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Si c'est à propos des tremblements, pas la peine. C'est parfaitement normal dans le coin.",
  },
  {
    "key": "mayor_01.conversation_orgrlo_text",
    "notes": "Speaker=Dorothy",
    "value": "Je ne suis pas ici pour me plaindre. J'ai juste besoin d'entrer dans la mine pour rechercher un ami disparu.",
  },
  {
    "key": "mayor_01.conversation_2k8w6x_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format laugh}Ha !{format reset} Et moi j'ai besoin de faire refonctionner cette mine. Tu n'as même pas de lumière adéquate !",
  },
  {
    "key": "mayor_01.conversation_o8zw9i_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Tu vas juste te perdre là-dedans et je ne peux pas me le permettre, pas si proche des élections.",
  },
  {
    "key": "mayor_01.conversation_2ok5e8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voilà ce qu'on va faire, il y a une {format emph}zone sans danger{format reset} où tu peux creuser. Juste à gauche de l'échelle pour entrer dans la mine.",
  },
  {
    "key": "mayor_01.conversation_kbljxa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Si tu peux {format highlight}miner assez de minerai{format reset} pour t'acheter une nouvelle lumière, tu pourras entrer dans la vraie mine.",
  },
  {
    "key": "mayor_01.conversation_dgln8s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Je ne peux pas me permettre que tu te perdes dans la mine. {format highlight}Mine des ressources{format reset} pour faire réparer cette lampe !",
  },
  {
    "key": "mayor_01.conversation_wdf2e3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé, je vois que tu as assez miné ! Je ne pensais pas que tu en sois capable. Va voir Jean Bernache !",
  },
  {
    "key": "mayor_01.conversation_y8rutk_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "C'est le bot verdâtre avec des pinces là-haut. {format highlight}Échange le minerai{format reset} contre de l'argent.",
  },
  {
    "key": "mayor_01.conversation_35uglo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format highlight}Échange ton minerai{format reset} auprès de Jean Bernache.",
  },
  {
    "key": "mayor_01.conversation_p2p0j1_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "L'argent que tu amasses ne vaut que ce que tu achètes avec !",
  },
  {
    "key": "mayor_01.conversation_hd3efw_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Va {format highlight}réparer ta lampe{format reset} maintenant.",
  },
  {
    "key": "mayor_01.conversation_z86wxp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Le bot aussi carré que timide qui se trouve là-bas pourra t'aider.",
  },
  {
    "key": "mayor_01.conversation_w5r2nd_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Va {format highlight}réparer ta lampe{format reset} maintenant.",
  },
  {
    "key": "mayor_01.conversation_ujjfnb_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voilà ! C'est bien mieux maintenant ! Tu es prête pour {format highlight}entrer dans la mine{format reset}.",
  },
  {
    "key": "mayor_01.conversation_woghf0_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Oh et surtout, n'oublie pas de rapporter du minerai, le plus sera le mieux !",
  },
  {
    "key": "mayor_01.conversation_5r6n65_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! C'est vraiment bien d'avoir quelqu'un pour rapporter du minerai en ville.",
  },
  {
    "key": "mayor_01.conversation_x2jdkd_text",
    "notes": "Speaker=Dorothy",
    "value": "Eh bien, sauf quelques rencontres avec des bestioles peu commodes, je progresse bien.",
  },
  {
    "key": "mayor_01.conversation_b8dzdr_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "C'est ce que je dis à tout le monde ! Ils s'inquiètent pour rien du tout !",
  },
  {
    "key": "mayor_01.conversation_cjntod_text",
    "notes": "Speaker=Dorothy",
    "value": "Je vais me rendre au Passage de la Roche Rouge pour voir si je peux {format highlight}réparer le système de tubes{format reset}.",
  },
  {
    "key": "mayor_01.conversation_pnbpzi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Quoi qu'il en soit, surtout ne t'arrête pas de rapporter ce précieux minerai à la surface !",
  },
  {
    "key": "mayor_01.conversation_2pgjla_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Et de dépenser tes gains dans les différents commerces de la ville.",
  },
  {
    "key": "mayor_01.conversation_j881iu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Il y a beaucoup de richesses à miner avant d'aller à la Roche Rouge. Aucune raison de perturber les choses qui marchent.",
  },
  {
    "key": "mayor_01.conversation_827vm7_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Je ne vois pas pourquoi tu ne peux pas laisser la Station sans pression en paix.",
  },
  {
    "key": "mayor_01.conversation_850lak_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Avons-nous réellement besoin d'utiliser des explosifs ? Nous ne sommes pas aussi barbares que les soiffards !",
  },
  {
    "key": "mayor_01.conversation_ebyo6x_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu as un autre plan pour libérer le Passage de la Roche Rouge, fils ?",
  },
  {
    "key": "mayor_01.conversation_hkla2t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Non, je ne comprends juste pas pourquoi nous devons creuser si profond.",
  },
  {
    "key": "mayor_01.conversation_s2zuik_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je vais te le dire, le minerai qui se trouve plus bas a beaucoup plus de valeur.",
  },
  {
    "key": "mayor_01.conversation_o84rmq_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* changed format from laugh to emph",
    "value": "Hé ! C'est une raison {format emph}valable{format reset} j'imagine...",
  },
  {
    "key": "mayor_01.conversation_wray1t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Mais pourquoi ne pas utiliser une bonne vieille pioche ? Devons-nous vraiment utiliser des bombes ?",
  },
  {
    "key": "mayor_01.conversation_b6rus0_text",
    "notes": "Speaker=Dorothy",
    "value": "Je ferais mieux de descendre et de dégager l'effondrement proche de la Roche Rouge.",
  },
  {
    "key": "mayor_01.conversation_j39zeq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ce serait bien mieux pour tout le monde si c'était dégagé.",
  },
  {
    "key": "mayor_01.conversation_vxn818_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Hé ! {format emph}J'aime{format reset} bien l'idée de miner ces pierres précieuses dans les profondeurs.",
  },
  {
    "key": "mayor_01.conversation_7zj949_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Espérons que tu puisses dégager la Roche Rouge sans aggraver la situation.",
  },
  {
    "key": "mayor_01.conversation_f7egkh_text",
    "notes": "Speaker=Dorothy",
    "value": "Maintenant que le Passage est ouvert, je peux chercher Rusty dans les profondeurs.",
  },
  {
    "key": "mayor_01.conversation_ksg9fp_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ce bot est toujours porté disparu ? N'oublie juste pas de rapporter du minerai avec toi.",
  },
  {
    "key": "mayor_01.conversation_gu106f_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu ne devrais avoir aucun problème pour miner jusqu'au mur protecteur, ma chère.",
  },
  {
    "key": "mayor_01.conversation_56ijq0_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'imagine que ton camarade pourrait se glisser dans l'une des fissures.",
  },
  {
    "key": "mayor_01.conversation_ynbcdq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Si j'étais toi, j'irais à la Station tête au carré.",
  },
  {
    "key": "mayor_01.conversation_twgnbe_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Tu devrais y trouver de l'équipement qui rendra ta vie plus facile en-bas.",
  },
  {
    "key": "mayor_01.conversation_51emyp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Tu veux dire l'équipement que mes idiots de frères ont emmuré l'année dernière en posant des briques ?",
  },
  {
    "key": "mayor_01.conversation_8gee3i_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Saints rouages ! Je suis certaine que tu peux {format highlight}contourner{format reset} les briques si tu explores la zone.",
  },
  {
    "key": "mayor_01.conversation_4sh4u4_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed the line beneath this.",
    "value": "Voilà ! Je souhaite être tenu au courant de tous les accès que tu trouveras. Nous pourrons combler les brèches ensuite.",
  },
  {
    "key": "mayor_01.conversation_gbjzn6_text",
    "notes": "Speaker=Dorothy Notes=*new* changed cave to passage",
    "value": "J'ai trouvé un passage très étrange près du mur. Il est plein de plantes étranges.",
  },
  {
    "key": "mayor_01.conversation_jsqibo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Eh bien, tout ce qui se trouve là-dessous est plutôt étrange, si tu veux mon avis. C'est proche des terres des soiffards après tout.",
  },
  {
    "key": "mayor_01.conversation_2xq01z_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Mes autres bons à rien de fils m'ont dit avoir trouvé cette cave.",
  },
  {
    "key": "mayor_01.conversation_aukq83_text",
    "notes": "Speaker=Ma Yonker",
    "value": "J'ai juste pensé qu'ils souffraient du mal des profondeurs.",
  },
  {
    "key": "mayor_01.conversation_8rttb6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Mes frères ont emmuré la Station tête au carré comme il faut !",
  },
  {
    "key": "mayor_01.conversation_6scmnj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Il y en a pas un pour rattraper l'autre, malheureusement.",
  },
  {
    "key": "mayor_01.conversation_jseqve_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai pu atteindre la Station tête au carré... mais aucun signe de Rusty pour le moment.",
  },
  {
    "key": "mayor_01.conversation_saqvas_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voilà ! Pourquoi creuser si profondément ? Tu ne veux tout de même pas {format highlight}entrer dans le territoire des soiffards{format reset}, si ?",
  },
  {
    "key": "mayor_01.conversation_41t2gq_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Le marteau-piqueur peut éclater les briques, tu pourras descendre rapidement.",
  },
  {
    "key": "mayor_01.conversation_nlrzra_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Fais attention à ton niveau d'eau. Cet outil en consomme autant qu'un bot marin dans le désert !",
  },
  {
    "key": "mayor_01.conversation_x4aowp_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Fais attention à ne pas attirer de soiffards par ici surtout ! C'est la dernière chose dont on a besoin !",
  },
  {
    "key": "mayor_01.conversation_acygrc_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Fais attention en creusant dans le mur, en particulier s'il y a des soiffards dérangés non loin.",
  },
  {
    "key": "mayor_01.conversation_mo33pi_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* removed fake news to tone down Trumpism",
    "value": "La dingo de Prof. Sherman continue de faire peur aux gens avec ses études des tremblements.",
  },
  {
    "key": "mayor_01.conversation_27gaig_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Le dernier tremblement n'a provoqué aucun dégât.",
  },
  {
    "key": "mayor_01.conversation_ydzkaa_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Elle nous regarde de haut – littéralement – depuis sa rampe de lancement, tout ça parce qu'elle a un diplôme.",
  },
  {
    "key": "mayor_01.conversation_667vwu_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Sherman se croit si intelligente avec son diplôme. {format laugh}Ha !{format reset} Le seul papier qui compte est de couleur verte, c'est bien connu !",
  },
  {
    "key": "mayor_01.conversation_jx90fz_text",
    "notes": "Speaker=Dorothy",
    "value": "Ce culte de dérangés semble protéger une sorte de {format emph}dispositif pour la fin du monde{format reset}.",
  },
  {
    "key": "mayor_01.conversation_jw27fp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "C'est à cause de ça qu'il y a des tremblements ?",
  },
  {
    "key": "mayor_01.conversation_9baw7n_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voilà ! C'est donc la responsabilité de quelqu'un d'autre !",
  },
  {
    "key": "mayor_01.conversation_7m1f5t_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Le bureau du maire ne s'occupe pas des scénarios de fin du monde.",
  },
  {
    "key": "mayor_01.conversation_qbl22o_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Mon travail consiste à m'assurer que les bots rapportent des pierres précieuses de la mine. Et d'appliquer une taxe dessus, bien entendu.",
  },
  {
    "key": "mayor_01.conversation_v4im3u_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Imbécile, c'est toi qui es en charge ! C'est ta responsabilité, occupe-t'en !",
  },
  {
    "key": "mayor_01.conversation_v6x25f_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Euh ? Voilà ! La botinette a déjà été dans le temple. Elle peut y retourner et s'occuper du dispositif !",
  },
  {
    "key": "mayor_01.conversation_6dx6ev_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Ha ha, problème résolu ! Oh et surtout, n'oublie pas de rapporter des pierres précieuses.",
  },
  {
    "key": "mayor_01.conversation_6aje4l_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Est-ce que tu t'es occupée du {format highlight}dispositif de fin du monde{format reset} ?",
  },
  {
    "key": "mayor_01.conversation_3lxi6c_text",
    "notes": "Speaker=Dorothy",
    "value": "On a désarmé le dispositif.",
  },
  {
    "key": "mayor_01.conversation_rv004f_text",
    "notes": "Speaker=Fen",
    "value": "Carrément ! Vous avez raté quelque chose !",
  },
  {
    "key": "mayor_01.conversation_7nmsnx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Tu vois ? Le bureau du maire contrôlait la situation depuis le début !",
  },
  {
    "key": "mayor_01.conversation_qpbmn2_text",
    "notes": "Speaker=Ma Yonker",
    "value": "{format emph}Imbécile !{format reset}",
  },
  {
    "key": "mayor_01.conversation_j8m71m_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "{format emph}C'est moi{format reset} qui ai eu l'idée d'envoyer la petite dans la mine !",
  },
  {
    "key": "mayor_01.conversation_sptgv3_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Je mérite des remerciements, c'est moi qui t'ai envoyé dans la mine en premier lieu !",
  },
  {
    "key": "mayor_01.conversation_2h1yth_text",
    "notes": "Speaker=Dorothy",
    "value": "On a trouvé d'autres machines qui provoquent des tremblements.",
  },
  {
    "key": "mayor_01.conversation_xbnodu_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new* enclosed "come" into the format",
    "value": "Oh ? {format emph}C'est pas possible !{format reset} Impossible d'avoir la paix !",
  },
  {
    "key": "mayor_01.conversation_6c2elx_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Moi qui voulais juste un job peinard, sans trop de problèmes et loin de cette mine dégoûtante.",
  },
  {
    "key": "mayor_01.conversation_kk8x0s_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Si tu ne t'occupes pas {format highlight}de ces machines{format reset}, je vais devoir évacuer toute la ville !",
  },
  {
    "key": "mayor_01.conversation_hmjz7t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Est-ce que tu te rends compte du prix que ça va coûter ?",
  },
  {
    "key": "mayor_01.conversation_qzd676_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*format*",
    "value": "Pendant que tu y seras, n'oublie pas de rapporter des ressources de la mine, d'accord ?",
  },
  {
    "key": "mayor_01.conversation_ocz2bm_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Est-ce que tu t'es occupée des autres machines ?",
  },
  {
    "key": "mayor_01.conversation_wihfk8_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Une jungle qui recouvre la mine, des détraqués qui essayent de détruire le monde !",
  },
  {
    "key": "mayor_01.conversation_jcggy6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Je suis certain que le dernier maire n'a pas eu à gérer ce genre de chose !",
  },
  {
    "key": "mayor_01.conversation_8d282i_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "J'aurais dû m'occuper de l'affaire familiale à la place. Mes frères ont l'air relativement heureux.",
  },
  {
    "key": "mayor_01.conversation_w4v0m6_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Je vais juste faire mes valises comme mes électeurs.",
  },
  {
    "key": "mayor_01.conversation_mm9lt2_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voilà ! Je ne peux pas être le maire s'il n'y a plus personne dans la ville à gouverner, non ? C'est plutôt réconfortant.",
  },
  {
    "key": "mayor_01.conversation_e4p6yr_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Peut-être que je devrais juste m'occuper du commerce familial et commencer une nouvelle vie comme mineur d'astéroïdes.",
  },
  {
    "key": "mayor_01.conversation_yzrylo_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Que penses-tu de ce slogan : "Les affaires continuent !" C'est plutôt bon, non ?",
  },
  {
    "key": "talk_to_mayor.conversation_pap70a_text",
    "notes": "Speaker=Dorothy",
    "value": "Un mineur avec une écharpe rouge ? Ça {format emph}doit{format reset} être Rusty ! Enfin une piste solide !",
  },
  {
    "key": "talk_to_mayor.conversation_n0lq8o_text",
    "notes": "Speaker=Fen",
    "value": "Je trouve que ces tremblements sont prometteurs.",
  },
  {
    "key": "talk_to_mayor.conversation_3nu9ex_text",
    "notes": "Speaker=Fen",
    "value": "Il n'y a rien de mieux qu'un peu de chaos pour pimenter une aventure.",
  },
  {
    "key": "talk_to_mayor.conversation_elfbhm_text",
    "notes": "Speaker=Dorothy",
    "value": "Je dois {format highlight}parler au maire{format reset} avant d'entrer dans cette mine.",
  },
  {
    "key": "guard_archaea.conversation_lty8j0_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Hé ! Tu n'as pas le droit de creuser ici, botinette !",
  },
  {
    "key": "guard_archaea.conversation_ml6q7x_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "On ne veut pas que d'autres mineurs se perdent, tu comprends ?",
  },
  {
    "key": "guard_archaea.conversation_cmr7ae_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Je pense que tu devrais parler avec le maire et obtenir une autorisation officielle.",
  },
  {
    "key": "guard_archaea.conversation_jqyolm_text",
    "notes": "Speaker=Coral Armstrong Notes=Her chest lamp is busted",
    "value": "Halte, botinette ! Je ne peux pas te laisser creuser ici sans un éclairage adéquat.",
  },
  {
    "key": "guard_archaea.conversation_jmhinb_text",
    "notes": "Speaker=Dorothy",
    "value": "Je veux juste descendre et retrouver mon ami ! Je peux juste jeter un rapide coup d'oeil ?",
  },
  {
    "key": "guard_archaea.conversation_97lht6_text",
    "notes": "Speaker=Fen",
    "value": "Allez, sois sympa, laisse-la jeter un oeil. Elle va {format emph}probablement{format reset} remonter à la surface.",
  },
  {
    "key": "guard_archaea.conversation_naakhs_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Nous avons déjà perdu {format emph}un{format reset} mineur de trop là-dessous.",
  },
  {
    "key": "guard_archaea.conversation_wjso4t_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "C'est bien trop dangereux d'explorer dans l'obscurité. Pourquoi ne pas plutôt {format highlight}miner des ressources{format reset} dans la zone éclairée ?",
  },
  {
    "key": "guard_archaea.conversation_iom5do_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "C'est bien trop dangereux d'explorer dans l'obscurité. Pourquoi ne répares-tu pas ta {format highlight}lampe{format reset} d'abord ?",
  },
  {
    "key": "guard_archaea.conversation_c5cn1e_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "J'ai dit que tu dois {format highlight}miner des ressources{format reset} pour pouvoir te payer la réparation de ta lampe.",
  },
  {
    "key": "guard_archaea.conversation_6b9sev_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Pourquoi ne pas échanger {format highlight}ton minerai{format reset} contre de l'argent et ensuite réparer ton éclairage ?",
  },
  {
    "key": "guard_archaea.conversation_66rd82_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Tu devrais pouvoir {format highlight}réparer ta lampe{format reset} à l'établi en ville.",
  },
  {
    "key": "guard_archaea.conversation_94r9zk_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Bah voilà ! T'es toute prête à creuser !",
  },
  {
    "key": "guard_archaea.conversation_n9j9h3_text",
    "notes": "Speaker=Dorothy",
    "value": "Je vais pouvoir aller {format highlight}plus bas{format reset} dans la mine ?",
  },
  {
    "key": "guard_archaea.conversation_p0ntw5_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Absolument ! Montre-moi que tu peux allumer la {format highlight}lanterne{format reset} là et j'ouvrirais les écoutilles.",
  },
  {
    "key": "guard_archaea.conversation_wphcux_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Pourquoi n'irais-tu pas allumer cette {format highlight}lanterne{format reset} d'abord ? Tu pourras descendre dans la mine ensuite.",
  },
  {
    "key": "guard_archaea.conversation_f36o1k_text",
    "notes": "Speaker=Coral Armstrong Notes=*new* expanded this as I removed the full text that was used before. It was repatative.",
    "value": "Le système de tubes te permettra de remonter en ville bien plus rapidement qu'à pied.",
  },
  {
    "key": "guard_archaea.conversation_ih3zjl_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu avais raison à propos du Passage de la Roche Rouge, il est bloqué.",
  },
  {
    "key": "guard_archaea.conversation_lynw1k_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ça ne m'étonne pas.",
  },
  {
    "key": "guard_archaea.conversation_arg7cq_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Tu devrais pouvoir le débloquer en utilisant des explosifs.",
  },
  {
    "key": "guard_archaea.conversation_94selp_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Une explosion bien placée devrait débloquer la situation... et le Passage de la Roche Rouge.",
  },
  {
    "key": "guard_archaea.conversation_pl5kjt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Tu devrais tenir le maire informé de ta progression.",
  },
  {
    "key": "guard_archaea.conversation_d3sb26_text",
    "notes": "Speaker=Coral Armstrong Notes=Shiners are cave dwelling human decendants.",
    "value": "J'ai vu beaucoup de créatures dans les profondeurs de la mine, mais aucune n'est aussi dangereuse et vicelarde qu'un soiffard.",
  },
  {
    "key": "guard_archaea.conversation_a458ae_text",
    "notes": "Speaker=Coral Armstrong Notes=A long time ago there was a war between humans and steambots that eventually drove humanity under ground.",
    "value": "Je n'ai pas connu les guerres, mais j'ai eu mon lot d'escarmouches avec ces manges-foins.",
  },
  {
    "key": "guard_archaea.conversation_t6mrk7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Pas la peine de parler avec eux, tape-les dès que tu les croises.",
  },
  {
    "key": "guard_archaea.conversation_pygh76_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ça peut te sembler un peu brutal, mais c'est mieux que de prendre des risques.",
  },
  {
    "key": "guard_archaea.conversation_xgdjhu_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "C'est une bonne chose qu'ils aient construit ce mur après les guerres.",
  },
  {
    "key": "guard_archaea.conversation_ujn89n_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ces détraqués de soiffards étaient peut-être différents dans le passé.",
  },
  {
    "key": "guard_archaea.conversation_nd5hoz_text",
    "notes": "Speaker=Coral Armstrong Notes=Quake makers, as in earth quake. He's blaming the frequent earthquakes on the shiners.",
    "value": "Mais maintenant ce sont juste des mutants causant des tremblements.",
  },
  {
    "key": "guard_archaea.conversation_5xd7xt_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Et on ne peut pas faire confiance à un mutant, pas vrai ?",
  },
  {
    "key": "guard_archaea.conversation_y6jyvf_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "As-tu rencontré ces pèlerins de la folie ?",
  },
  {
    "key": "guard_archaea.conversation_1tzeuc_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Parfois ils passent par les mines pour aller d'un temple à l'autre.",
  },
  {
    "key": "guard_archaea.conversation_147ntm_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normalement, ils passent juste par le désert non loin des Plaines venteuses.",
  },
  {
    "key": "guard_archaea.conversation_f34oeg_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Je n'ai rien contre les cultistes, c'est plus animé quand ils passent par ici.",
  },
  {
    "key": "guard_archaea.conversation_l509g4_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ta progression est assez impressionnante.",
  },
  {
    "key": "guard_archaea.conversation_lbobkd_text",
    "notes": "Speaker=Coral Armstrong Notes=*format*",
    "value": "Redouble d'attention, j'ai entendu parler de dangers légendaires qui se trouvent dans les profondeurs.",
  },
  {
    "key": "guard_archaea.conversation_alemgw_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Assure-toi d'avoir toujours un moyen pour remonter à la surface. Un tunnel sans sortie n'est au final qu'un cercueil sinueux.",
  },
  {
    "key": "guard_archaea.conversation_51bz8w_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Ça ne fait pas de mal de garder {format emph}ça{format reset} en tête et de s'assurer d'avoir une bonne armure.",
  },
  {
    "key": "guard_archaea.conversation_e9lgr6_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Reste sur tes gardes et améliore ton équipement, c'est le seul conseil que je peux te donner.",
  },
  {
    "key": "guard_archaea.conversation_19pnkh_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Les frères Yonker auraient vu une sorte de jungle dans la mine.",
  },
  {
    "key": "guard_archaea.conversation_205qqo_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "J'ai entendu dire qu'elle se propage aussi. Elle n'approchera jamais de la ville, tu peux me croire !",
  },
  {
    "key": "guard_archaea.conversation_59fokz_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Je vais sûrement m'acheter une bonne hache, juste au cas où.",
  },
  {
    "key": "guard_archaea.conversation_vwt53j_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "C'est dingue d'imaginer qu'une jungle puisse apparaître juste comme ça.",
  },
  {
    "key": "guard_archaea.conversation_1re540_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Je dois avouer que j'ai un peu peur de ces tremblements.",
  },
  {
    "key": "guard_archaea.conversation_25kyco_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "On dirait qu'ils deviennent de plus en plus puissants. Quoi qu'il en soit, je reste à mon poste !",
  },
  {
    "key": "guard_archaea.conversation_e0zgh7_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Des bots pourraient se blesser dans la mine si personne ne surveille l'entrée.",
  },
  {
    "key": "guard_archaea.conversation_jkptm2_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Il n'y a pas la place pour la peur dans ma vieille armature. Je dois faire mon devoir et juste ça.",
  },
  {
    "key": "guard_archaea.conversation_4niz25_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "{format highlight}Fais attention à ta lumière{format reset} pour ne pas te retrouver dans le noir là-dessous.",
  },
  {
    "key": "guard_archaea.conversation_aex9as_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Si elle commence à clignoter, remonte à la surface pour la {format highlight}recharger{format reset}.",
  },
  {
    "key": "guard_archaea.conversation_dmvx8z_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "La mine n'est pas un endroit sans danger, un équipement à la pointe est recommandé.",
  },
  {
    "key": "welcome_to_el_machino.conversation_uimryl_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Voyons ! Restez calmes !",
  },
  {
    "key": "welcome_to_el_machino.conversation_31d0sd_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Factuellement, ces {format nervous}tremblements{format reset} sont très inquiétants.",
  },
  {
    "key": "welcome_to_el_machino.conversation_4njhbf_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Je vous l'ai déjà dit, mon sismographe capte des mouvements étranges !",
  },
  {
    "key": "welcome_to_el_machino.conversation_l4n0br_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Il y a des choses bien plus importantes que les tremblements, comme par exemple, obtenir plus de minerai !",
  },
  {
    "key": "welcome_to_el_machino.conversation_dzl3uz_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Imbécile ! Pourquoi n'écoutes-tu pas les experts ?",
  },
  {
    "key": "welcome_to_el_machino.conversation_7blj3t_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "M'man ! Ces "experts" avec leurs "faits"... Ils ne comprennent rien à rien.",
  },
  {
    "key": "welcome_to_el_machino.conversation_lwjidu_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Et qu'advient-il de ce {format emph}mineur à l'écharpe rouge{format reset} qui n'est jamais remonté ?",
  },
  {
    "key": "welcome_to_el_machino.conversation_jije2r_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "J'ai engagé un garde pour éviter que des bots mal préparés se perdent dans la mine.",
  },
  {
    "key": "welcome_to_el_machino.conversation_jhc64p_text",
    "notes": "Speaker=Mayor Mic Yonker Notes=*new*",
    "value": "Restons calmes, mais surtout, il ne faut pas perdre de vue que le bureau du maire n'est pas à blâmer dans cette situation.",
  },
  {
    "key": "welcome_to_el_machino.conversation_njlyi9_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Idiot !",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_xqrxw3_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hé hé hé ! BOOM !{format reset} ENCORE ! ENCORE !",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_y6g3s7_text",
    "notes": "Speaker=Dorothy",
    "value": "Ces bombes vont être très utiles. Elles peuvent atteindre des zones inaccessibles pour ma pioche.",
  },
  {
    "key": "report_to_mayor_pressurebomb.conversation_c5us81_text",
    "notes": "Speaker=Dorothy",
    "value": "Je devrais aller {format highlight}dire au maire{format reset} que le passage est ouvert de nouveau.",
  },
  {
    "key": "guard_open_hatch.conversation_ig8tga_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Il était temps que quelqu'un recommence à miner.",
  },
  {
    "key": "guard_open_hatch.conversation_3li9iu_text",
    "notes": "Speaker=Dorothy",
    "value": "Je suis finalement sur la piste de Rusty.",
  },
  {
    "key": "guard_open_hatch.conversation_ti9ln5_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "Ton camarade a probablement utilisé le Passage de la Roche Rouge, d'une manière ou d'une autre.",
  },
  {
    "key": "guard_open_hatch.conversation_60et06_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Normalement tu utiliserais le système de tubes pneumatiques pour y aller.",
  },
  {
    "key": "guard_open_hatch.conversation_cix8sl_text",
    "notes": "Speaker=Coral Armstrong",
    "value": "Mais il est bouché à cause des tremblements. {format highlight}Déboucher{format reset} le système, en voilà une bonne idée.",
  },
  {
    "key": "guard_open_hatch.conversation_h47l73_text",
    "notes": "Speaker=Coral Armstrong Notes=*new*",
    "value": "J'vais ouvrir ces écoutilles pour te laisser descendre là-dessous, qu'est-ce que tu en penses ?",
  },
  {
    "key": "buddy_need_light.conversation_q6n8pp_text",
    "notes": "Speaker=Fen",
    "value": "Hé ! Il commence à faire sombre. Je n'y vois plus rien et pourtant je suis fait de lumière.",
  },
  {
    "key": "buddy_need_light.conversation_1dc723_text",
    "notes": "Speaker=Fen Notes=The player has a light source that diminish over time. When the player goes back up to town it replenishes.",
    "value": "{format highlight}Remonte à la surface{format reset} pour faire le plein, j'ai pas envie de me perdre dans la mine.",
  },
  {
    "key": "fen_cave_in.conversation_ytvst4_text",
    "notes": "Speaker=Dorothy",
    "value": "C'est sûrement le Passage de la Roche Rouge. C'est totalement encombré.",
  },
  {
    "key": "fen_cave_in.conversation_ac4a61_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Si tu avais des explosifs, tu pourrais tout faire sauter.",
  },
  {
    "key": "fen_cave_in.conversation_f2qhr1_text",
    "notes": "Speaker=Dorothy",
    "value": "Ce n'est pas une si mauvaise idée ! Retournons en ville pour demander où en trouver.",
  },
  {
    "key": "fen_cave_in.conversation_8j9cex_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}WAOUH, des explosifs !{format reset} Avec de la chance, tu te feras sauter aussi.",
  },
  {
    "key": "fen_cave_in.conversation_0g7tly_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Chut ! Débouchons le tube pneumatique.",
  },
  {
    "key": "fen_cave_in.conversation_n67xrl_text",
    "notes": "Speaker=Dorothy",
    "value": "C'est sûrement le Passage de la Roche Rouge. C'est totalement encombré.",
  },
  {
    "key": "fen_cave_in.conversation_1kwj0v_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Tu pourrais utiliser des bombes pour dégager la zone.",
  },
  {
    "key": "fen_cave_in.conversation_661ekz_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Je ne devrais probablement pas vous écouter toi et tes pulsions destructrices, mais ce n'est pas une si mauvaise idée.",
  },
  {
    "key": "fen_cave_in.conversation_xdrduu_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}OUAIS, DES EXPLOSIFS !{format reset} Avec de la chance, tu vas perdre quelques pièces dans l'explosion.",
  },
  {
    "key": "fen_cave_in.conversation_6c0vsm_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Chut ! T'as terminé ? On peut déboucher le tube maintenant ?",
  },
  {
    "key": "mechanic.conversation_h5wj1m_text",
    "notes": "Speaker=Turtle Bucket Notes=Very nervous person",
    "value": "Je ne veux pas euh... déranger mais euh... ces {format nervous}tremblements{format reset} me rendent plutôt nerveux.",
  },
  {
    "key": "mechanic.conversation_o86kfe_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Mais euh... si c'était vraiment un problème, je pense que le maire s'inquiéterait davantage.",
  },
  {
    "key": "mechanic.conversation_o2oiou_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Le maire dit que ces {format nervous}tremblements{format reset} ne sont pas dangereux du tout, alors euh... j'imagine que c'est le cas si il le dit.",
  },
  {
    "key": "mechanic.conversation_h7ppy6_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh euh... j'aime bien tes bottes.",
  },
  {
    "key": "mechanic.conversation_kg1mo1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* The light source is set in the middle of the chest.",
    "value": "Je vois que tu as euh... cassé ta source de lumière.",
  },
  {
    "key": "mechanic.conversation_q3my9j_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Si j'étais toi, je n'irais pas me balader dans l'obscurité, euh... surtout avec ces {format nervous}grondements{format reset}.",
  },
  {
    "key": "mechanic.conversation_ltmso8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Dis, euh... si tu vas dans la mine, euh... tu devrais {format highlight}réparer ton éclairage{format reset} au préalable.",
  },
  {
    "key": "mechanic.conversation_9zjn4q_text",
    "notes": "Speaker=Turtle Bucket Notes=Workbench",
    "value": "Tu peux euh... utiliser mon établi... si tu veux, bien sûr.",
  },
  {
    "key": "mechanic.conversation_izda31_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Tu peux {format highlight}réparer ta lumière{format reset} en utilisant l'établi... si tu veux.",
  },
  {
    "key": "mechanic.conversation_649j7z_text",
    "notes": "Speaker=Turtle Bucket Notes=Dorothys speed boots.",
    "value": "Oh euh... j'aime bien tes bottes.",
  },
  {
    "key": "mechanic.conversation_fjqq9f_text",
    "notes": "Speaker=Dorothy",
    "value": "Ah oui ? Elles ont été améliorées par une machine située sous le désert.",
  },
  {
    "key": "mechanic.conversation_v3f2hn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Le système euh... hydraulique amélioré, doit euh... les rendre vraiment rapides !",
  },
  {
    "key": "mechanic.conversation_qnv8df_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Ces machines à équipements que l'on trouve dans les station de minage sont vraiment cools hein ?",
  },
  {
    "key": "mechanic.conversation_f9qput_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh...euh, OK. Bon, on peut en trouver partout dans les mines.",
  },
  {
    "key": "mechanic.conversation_ji4atj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... elles sont très, {format emph}très vieilles{format reset}. On ne sait pas trop qui en est à l'origine, mais elles sont plutôt utiles pour notre espèce.",
  },
  {
    "key": "mechanic.conversation_kn7n3g_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Avec les années, les mineurbots ont établi des stations de minage autour de ces machines.",
  },
  {
    "key": "mechanic.conversation_w8uqp5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Certaines n'ont pas encore été découvertes, la mine {format emph}est bien plus grande{format reset} que le simple espace sur lequel nous travaillons.",
  },
  {
    "key": "mechanic.conversation_m5pbwk_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "J'ai lu des choses sur les autres stations, euh... dans les profondeurs, dans les zones inexplorées de la mine.",
  },
  {
    "key": "mechanic.conversation_wad1be_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh...euh, bien sûr.",
  },
  {
    "key": "mechanic.conversation_apkmkg_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "Waouh, tu as trouvé un lance-bombe à pression !",
  },
  {
    "key": "mechanic.conversation_qjmh35_text",
    "notes": "Speaker=Turtle Bucket Notes=This is techno jibberish, feel free to make up new stuff.",
    "value": "Il est euh... de très bonne facture, tu peux voir la {format singsong}finition impeccable{format reset} et la qualité des matériaux utilisés.",
  },
  {
    "key": "mechanic.conversation_ua28gp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Il peut tirer des projectiles qui se collent à n'importe quelle surface avant d'exploser.",
  },
  {
    "key": "mechanic.conversation_saczrj_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The pressure bomb works with water.",
    "value": "Ça risque de faire de belles éclaboussures ! Hé hé...",
  },
  {
    "key": "mechanic.conversation_tz9y1l_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... je suis désolé, je euh... je me suis laissé emporter.",
  },
  {
    "key": "mechanic.conversation_yxae4k_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh...euh... on dirait que tu as réussi à passer la Station tête au carré.",
  },
  {
    "key": "mechanic.conversation_rz6lrl_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* The upgrade is a mechanical fist that works like a jack hammer.",
    "value": "Ce marteau délivre une grosse puissance et peut briser les briques les plus résistantes avec facilité.",
  },
  {
    "key": "mechanic.conversation_art1sv_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Tu vas pouvoir explorer l'autre côté du mur sans problème !",
  },
  {
    "key": "mechanic.conversation_1ghl26_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh et euh... il est possible de l'améliorer encore plus !",
  },
  {
    "key": "mechanic.conversation_a315z5_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Comme par exemple euh... renforcer le cylindre pneumatique pour augmenter le vitesse d'exploitation.",
  },
  {
    "key": "mechanic.conversation_lyy59m_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... pardon... je voulais simplement souligner tout son potentiel.",
  },
  {
    "key": "mechanic.conversation_ornloo_text",
    "notes": "Speaker=Turtle Bucket Notes=See "Spelunker Station" in other document",
    "value": "{format singsong}Incroyable !{format reset} Je croyais que la Station de l'explorateur était détruite !",
  },
  {
    "key": "mechanic.conversation_uo7wrd_text",
    "notes": "Speaker=Turtle Bucket Notes=The hook shot look like a grapling hook and is shot out of your arm",
    "value": "Tu as trouvé le vieux tir-grappin !",
  },
  {
    "key": "mechanic.conversation_4x94pz_text",
    "notes": "Speaker=Turtle Bucket Notes="zip" as in fly or move fast",
    "value": "Avec ça tu peux euh... te déplacer dans la mine comme {format emph}jamais !{format reset}",
  },
  {
    "key": "mechanic.conversation_wt4pay_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Tu vas pouvoir explorer partout maintenant !",
  },
  {
    "key": "mechanic.conversation_jc96m9_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Ces mines sont pleines de secrets à découvrir !",
  },
  {
    "key": "mechanic.conversation_xxorzf_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "{format singsong}WAOUH !{format reset} C'est euh... vraiment ce que je crois ?",
  },
  {
    "key": "mechanic.conversation_h0sfna_text",
    "notes": "Speaker=Turtle Bucket Notes=It's a falaming Pick Axe",
    "value": "Comment diable as-tu trouvé une pioche de feu ?",
  },
  {
    "key": "mechanic.conversation_4p03fk_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh, je suis sûr qu'elle était cachée quelque part dans le temple de l'est.",
  },
  {
    "key": "mechanic.conversation_7shcmp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "J'ai lu un article qui en parlait dans Outil Mag, euh... je ne pensais pas qu'il en existait encore... c'est juste euh... {format emph}incroyable !{format reset}",
  },
  {
    "key": "mechanic.conversation_9e6rbj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... c'est vraiment beau.",
  },
  {
    "key": "mechanic.conversation_8x0zgn_text",
    "notes": "Speaker=Turtle Bucket Notes=*format* see Aeronaut Station in the other document",
    "value": "Oh, c'est pas possible ! Tu as vraiment été dans la Station Aéro ?",
  },
  {
    "key": "mechanic.conversation_gqdbky_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Cet endroit était supposé être enterré profondément sous la partie moderne de la mine.",
  },
  {
    "key": "mechanic.conversation_34ele3_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Je ne pensais pas euh... avoir la chance de voir un tel moteur de mon vivant !",
  },
  {
    "key": "mechanic.conversation_vr5wop_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Le geek en moi est heureux.",
  },
  {
    "key": "mechanic.conversation_0czv1r_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* just hammering home that the world is more open at this point.",
    "value": "Avec ça, tu vas pouvoir aller un peu partout dans la mine. Tu vas pouvoir atteindre des zones jusque-là inaccessibles.",
  },
  {
    "key": "mechanic.conversation_2bpv40_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* as in the old saying "the world is your oyster"",
    "value": "La mine est à toi.",
  },
  {
    "key": "mechanic.conversation_6c8k38_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Je suis certain de pouvoir inventer de superbes améliorations euh... si tu es d'accord, bien entendu.",
  },
  {
    "key": "mechanic.conversation_kddst5_text",
    "notes": "Speaker=Turtle Bucket Notes=This is in refferal to location: Yarrow, a mysterious subteranian mushroom jungle full of dangers.",
    "value": "Euh... cette jungle dans la mine... ils ne parlent que de ça en ville.",
  },
  {
    "key": "mechanic.conversation_1ibifo_text",
    "notes": "Speaker=Turtle Bucket Notes=*format*",
    "value": "J'espère que ça ne va pas se propager jusqu'ici. Euh... je n'aime pas trop m'approcher des cactus.",
  },
  {
    "key": "mechanic.conversation_qxg2dp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Si tu avais un coupe-broussailles, je pense que euh... tu pourrais découper ces végétaux en un rien de temps !",
  },
  {
    "key": "mechanic.conversation_jn0ayb_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Dommage qu'on ne puisse pas trouver un tel objet dans les vieilles stations de minage.",
  },
  {
    "key": "mechanic.conversation_evptsm_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... j'espère que ces {format nervous}plantes bizarres{format reset} n'arriveront pas jusqu'à la surface.",
  },
  {
    "key": "mechanic.conversation_d2k8hv_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... je ne préfère pas déranger la prof...",
  },
  {
    "key": "mechanic.conversation_zfm1c4_text",
    "notes": "Speaker=Turtle Bucket Notes=The rocket is a space rocket.",
    "value": "Peut-être que euh... je pourrais lui demander à... euh... jeter un coup d'oeil à la fusée, maintenant qu'elle est terminée ?",
  },
  {
    "key": "mechanic.conversation_js74jz_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "C'est vraiment, vraiment cool, tu ne trouves pas ?",
  },
  {
    "key": "mechanic.conversation_bufmli_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... j'aimerais vraiment jeter un coup d'oeil à cette fusée...",
  },
  {
    "key": "mechanic.conversation_yxbbjn_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Les fusées c'est euh... cool !",
  },
  {
    "key": "mechanic.conversation_1ovqzn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* rephrased this line to work in more situations.",
    "value": "Si tu veux réparer ou améliorer ton équipement, tu peux euh... utiliser mon établi quand tu veux.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_4dhtk4_text",
    "notes": "Speaker=Fen",
    "value": "Parfait, faisons exploser ce truc {format singsong}en mille morceaux !{format reset}",
  },
  {
    "key": "fen_cave_in_bomb.conversation_eff23g_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu devrais vraiment parler à quelqu'un de ces pulsions de destruction de masse.",
  },
  {
    "key": "fen_cave_in_bomb.conversation_oxrw0l_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ah mais j'en parle, là, tout de suite ! J'en parle tout le temps ! Quand est-ce que je n'ai pas parlé de destruction ?",
  },
  {
    "key": "fen_cave_in_bomb.conversation_nmb2rq_text",
    "notes": "Speaker=Dorothy",
    "value": "Mouais...",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_t0dmfu_text",
    "notes": "Speaker=Fen Notes=*new* This message is shown when the player have unused upgrade-cogs.",
    "value": "Pourquoi n'utilises-tu pas les {image cogs_small} Méca dopeurs que tu trouves ? Est-ce que t'es une sorte de dingobot ?",
  },
  {
    "key": "buddy_reminder_use_cogs.conversation_w2gq2j_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Allez, utilise-les à l'établi !",
  },
  {
    "key": "rosie.conversation_enxhfq_text",
    "notes": "Speaker=Dorothy Notes=*format* *new* rephrased this line",
    "value": "Waouh ! Cet endroit est fantastique !",
  },
  {
    "key": "rosie.conversation_dsse8r_text",
    "notes": "Speaker=Rosie",
    "value": "Merci. J'ai construit cet Oasis pour regrouper les miens. Pour les protéger !",
  },
  {
    "key": "rosie.conversation_fu699v_text",
    "notes": "Speaker=Rosie",
    "value": "Du moment que j'arrive à faire en sorte qu'ils restent "calmes", ils restent à l'intérieur, loin des dangers.",
  },
  {
    "key": "rosie.conversation_hx3qqt_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Du moins c'était comme ça avant que ton ami provoque ces tremblements.",
  },
  {
    "key": "rosie.conversation_6o8eta_text",
    "notes": "Speaker=Dorothy",
    "value": "Rusty ne ferait jamais une chose pareille ! Il a {format emph}risqué sa vie{format reset} pour nous sauver de Vectron.",
  },
  {
    "key": "rosie.conversation_x9aify_text",
    "notes": "Speaker=Rosie",
    "value": "Est-ce que tu le connais vraiment ? Peut-être qu'il a changé après avoir affronté ce monstre.",
  },
  {
    "key": "rosie.conversation_y8f4q2_text",
    "notes": "Speaker=Fen",
    "value": "C'est l'effet de Vectron...{format nervous}Il change les gens.{format reset}",
  },
  {
    "key": "rosie.conversation_qjs5hn_text",
    "notes": "Speaker=Rosie",
    "value": "Il est venu ici et m'a dit qu'il allait faire s'effondrer la mine sur nous. Nous avons à peine réussi à le repousser.",
  },
  {
    "key": "rosie.conversation_mbjnhf_text",
    "notes": "Speaker=Dorothy",
    "value": "Je suis désolée... Si seulement je pouvais le retrouver... parler avec lui...",
  },
  {
    "key": "rosie.conversation_7sza3z_text",
    "notes": "Speaker=Rosie",
    "value": "Tu es loyale, je peux comprendre ça, mais si tu trouves la source de ces tremblements, tu comprendras par toi-même.",
  },
  {
    "key": "rosie.conversation_hihmd6_text",
    "notes": "Speaker=Rosie Notes=*new* rephrasing and added an emphasis",
    "value": "Tu pourrais nous aider à stopper ces tremblements. En échange je vais {format emph}t'aider{format reset} dans tes recherches.",
  },
  {
    "key": "rosie.conversation_47pkq7_text",
    "notes": "Speaker=Rosie Notes=*new* added a bit at the end to this one.",
    "value": "{format highlight}Entre dans la station de minage{format reset} que j'utilise comme réserve. Il y a une vieille machine à outils qui devrait toujours fonctionner. Elle devrait t'être utile.",
  },
  {
    "key": "rosie.conversation_m6cj0e_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Entre dans la station de minage{format reset} et prends tout ce dont tu as besoin.",
  },
  {
    "key": "rosie.conversation_4vzxih_text",
    "notes": "Speaker=Rosie",
    "value": "Tu as trouvé ce que tu voulais ? J'en suis contente. Tu as l'air au point !",
  },
  {
    "key": "rosie.conversation_f1jnf5_text",
    "notes": "Speaker=Rosie",
    "value": "J'ai besoin que tu trouves l'origine de ces tremblements et que tu les stoppes.",
  },
  {
    "key": "rosie.conversation_ln5j60_text",
    "notes": "Speaker=Rosie",
    "value": "Aide-moi à garder les miens en sécurité ! J'ai de plus en plus de mal à me faire entendre.",
  },
  {
    "key": "rosie.conversation_u5463y_text",
    "notes": "Speaker=Rosie",
    "value": "Je ne sais rien de plus sur ces tremblements, tu devrais chercher un {format highlight}intellobot{format reset} à la surface.",
  },
  {
    "key": "rosie.conversation_dohwhw_text",
    "notes": "Speaker=Dorothy",
    "value": "Peut-être que je pourrais enfin savoir où est Rusty !",
  },
  {
    "key": "rosie.conversation_77fdqq_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Trouve un intellobot{format reset} à la surface.",
  },
  {
    "key": "rosie.conversation_0jmccn_text",
    "notes": "Speaker=Rosie",
    "value": "Il pourra sûrement t'indiquer la source de ces tremblements.",
  },
  {
    "key": "rosie.conversation_xpdrbe_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai découvert que le dernier tremblement venait du temple de l'est.",
  },
  {
    "key": "rosie.conversation_oqlaq7_text",
    "notes": "Speaker=Rosie",
    "value": "Le culte présent là-bas ne pense qu'à la destruction.",
  },
  {
    "key": "rosie.conversation_1kkqf6_text",
    "notes": "Speaker=Fen",
    "value": "Ouais, je les connais plutôt bien...",
  },
  {
    "key": "rosie.conversation_v0wzpo_text",
    "notes": "Speaker=Rosie",
    "value": "Ils voudront protéger tout ce qui a rapport aux tremblements.",
  },
  {
    "key": "rosie.conversation_nytcr5_text",
    "notes": "Speaker=Rosie",
    "value": "Tu dois {format highlight}trouver et fouiller le temple{format reset} pour trouver l'origine de ces tremblements.",
  },
  {
    "key": "rosie.conversation_x2gmu8_text",
    "notes": "Speaker=Rosie",
    "value": "Tu dois {format highlight}trouver et fouiller le temple{format reset} pour trouver l'origine de ces tremblements.",
  },
  {
    "key": "rosie.conversation_ly3hpt_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu avais raison, Rosie. {format highlight}Rusty est impliqué{format reset} dans cette histoire.",
  },
  {
    "key": "rosie.conversation_mp86jk_text",
    "notes": "Speaker=Rosie",
    "value": "Tu le sais maintenant... {format emph}Il est malfaisant !{format reset}",
  },
  {
    "key": "rosie.conversation_26ewef_text",
    "notes": "Speaker=Dorothy",
    "value": "Il a construit une espèce de dispositif de la fin du monde, c'est cette machine qui provoque les tremblements.",
  },
  {
    "key": "rosie.conversation_r154n3_text",
    "notes": "Speaker=Rosie",
    "value": "Tu dois détruire {format highlight}cette machine !{format reset} Je dois protéger les miens et c'est un danger pour tout le monde !",
  },
  {
    "key": "rosie.conversation_mlv5kh_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Qu'est-ce qu'on attend ? On a des trucs à démolir !",
  },
  {
    "key": "rosie.conversation_607awg_text",
    "notes": "Speaker=Rosie",
    "value": "Tu as une chance de stopper ces tremblements. {format highlight}Désactive le dispositif de la fin du monde !{format reset}",
  },
  {
    "key": "rosie.conversation_ck3lck_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Nous avons réussi à désactiver le dispositif qui provoquait les tremblements.",
  },
  {
    "key": "rosie.conversation_kd9cyi_text",
    "notes": "Speaker=Rosie Notes=*format*",
    "value": "Super ! Tu as réussi !",
  },
  {
    "key": "rosie.conversation_mw42bj_text",
    "notes": "Speaker=Fen",
    "value": "Ouais, on l'a fait.",
  },
  {
    "key": "rosie.conversation_3beotd_text",
    "notes": "Speaker=Dorothy",
    "value": "Mais toujours pas de traces de Rusty...",
  },
  {
    "key": "rosie.conversation_akywya_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Hum... Si le monstre que tu appelles Vectron l'a changé, peut-être qu'il est dans les profondeurs ? Parmi les ruines ?",
  },
  {
    "key": "rosie.conversation_rwy0gr_text",
    "notes": "Speaker=Dorothy",
    "value": "Ce dispositif {format emph}était{format reset} en partie fait de technologie Vectron...",
  },
  {
    "key": "rosie.conversation_ucjkci_text",
    "notes": "Speaker=Fen",
    "value": "Oh non, je sais à quoi tu penses ! Et je ne veux pas {format nervous}y retourner !{format reset}",
  },
  {
    "key": "rosie.conversation_7irted_text",
    "notes": "Speaker=Fen",
    "value": "Tu ne sais pas ce quel effet ça fait... de ne pas avoir de volonté propre.",
  },
  {
    "key": "rosie.conversation_21ym6y_text",
    "notes": "Speaker=Dorothy",
    "value": "On a déjà traversé tellement d'épreuves... On ne peut pas s'arrêter maintenant... Montre-moi l'entrée, Fen...",
  },
  {
    "key": "rosie.conversation_oredyt_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Pourquoi ? On pourrait juste détruire des trucs à la place.",
  },
  {
    "key": "rosie.conversation_tc3nlv_text",
    "notes": "Speaker=Dorothy Notes=*new* removed Dot's explicit reason being loyalty and pushing Rusty.",
    "value": "Il a vaincu Vectron... Il nous a sauvés !",
  },
  {
    "key": "rosie.conversation_0xyfid_text",
    "notes": "Speaker=Fen",
    "value": "...",
  },
  {
    "key": "rosie.conversation_uvs1vb_text",
    "notes": "Speaker=Fen",
    "value": "Je vais te montrer le chemin. Mais une fois dans {format highlight}Vectron{format reset}, tu seras toute seule.",
  },
  {
    "key": "rosie.conversation_pq0jjj_text",
    "notes": "Speaker=Rosie",
    "value": "Pour retrouver Rusty, tu vas devoir {format highlight}entrer dans Vectron{format reset}.",
  },
  {
    "key": "rosie.conversation_vcgjsk_text",
    "notes": "Speaker=Fen",
    "value": "On pourrait ne pas aller détruire des trucs à la place ?",
  },
  {
    "key": "rosie.conversation_3bw741_text",
    "notes": "Speaker=Rosie",
    "value": "Tu es {format emph}revenue{format reset}...",
  },
  {
    "key": "rosie.conversation_6r8y8d_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "Oui... je n'ai trouvé aucune trace de Rusty.",
  },
  {
    "key": "rosie.conversation_jdhos3_text",
    "notes": "Speaker=Fen",
    "value": "Mais on a découvert qu'il y a {format emph}d'autres dispositifs de la fin du monde{format reset} là-dessous.",
  },
  {
    "key": "rosie.conversation_hlfgz1_text",
    "notes": "Speaker=Rosie",
    "value": "Bien sûr ! Il est bien trop malin pour mettre tous ses oeufs dans le même panier.",
  },
  {
    "key": "rosie.conversation_kix6a6_text",
    "notes": "Speaker=Rosie",
    "value": "C'est terrible. Tu dois {format emph}les trouver tous !{format reset} Personne n'est en sécurité tant que ce n'est pas fait.",
  },
  {
    "key": "rosie.conversation_58f8ga_text",
    "notes": "Speaker=Fen Notes=*new* added "Dorothy"",
    "value": "Dorothy... Je sais déjà où ils sont. Le pouvoir qui en émane... Je l'ai senti si distinctement.",
  },
  {
    "key": "rosie.conversation_diuokv_text",
    "notes": "Speaker=Fen",
    "value": "Il y en a un {format emph}dans le temple où tu m'as trouvé.{format reset}",
  },
  {
    "key": "rosie.conversation_5npqb6_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Le second se trouve dans {format emph}cette drôle de jungle souterraine{format reset} que nous avons traversée plus tôt.",
  },
  {
    "key": "rosie.conversation_3v2hek_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Tu trouveras le dernier dans {format emph}le temple de l'est{format reset}.",
  },
  {
    "key": "rosie.conversation_k5nk0l_text",
    "notes": "Speaker=Dorothy Notes=*new* added "then" moved the line",
    "value": "D'accord, allons {format highlight}éclater ces machines{format reset} alors !",
  },
  {
    "key": "rosie.conversation_1alf3v_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Les mines sont pleines de secrets et de dangers. Le chemin le plus court n'est pas forcément le meilleur.",
  },
  {
    "key": "rosie.conversation_b6r8b9_text",
    "notes": "Speaker=Dorothy Notes=*new* made where ever one word; new line about Fen commenting on the fact that the world is more open now that you've got the jet engine.",
    "value": "J'ai trouvé ce truc, ça devrait nous aider à explorer plus facilement.",
  },
  {
    "key": "rosie.conversation_p2pe6o_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ouaip, on va pouvoir aller partout et trouver des tonnes de secrets et se préparer pour la destruction finale ! Allons-y !",
  },
  {
    "key": "rosie.conversation_jglhmm_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Tu dois {format highlight}détruire la dernière machine{format reset}.",
  },
  {
    "key": "rosie.conversation_mqmqfa_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "Tu as déjà visité les temples, l'équipement que tu as trouvé devrait rendre l'exploration plus facile.",
  },
  {
    "key": "rosie.conversation_v81wm2_text",
    "notes": "Speaker=Rosie",
    "value": "Je ne sais pas grand chose à propos de la jungle mystérieuse par contre.",
  },
  {
    "key": "rosie.conversation_ckclse_text",
    "notes": "Speaker=Dorothy",
    "value": "Nous avons détruit une des machines de Rusty.",
  },
  {
    "key": "rosie.conversation_wzvouk_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Ouais et c'était génial !{format reset}",
  },
  {
    "key": "rosie.conversation_yb1vmx_text",
    "notes": "Speaker=Rosie",
    "value": "C'est assez malin de les placer un peu partout dans la mine.",
  },
  {
    "key": "rosie.conversation_hw5xmd_text",
    "notes": "Speaker=Rosie",
    "value": "Ça ne va pas être facile d'atteindre les autres, même si tu sais où elles sont.",
  },
  {
    "key": "rosie.conversation_oeqkzs_text",
    "notes": "Speaker=Rosie",
    "value": "J'aurais aimé pouvoir t'aider d'avantage mais je dois rester ici et protéger les miens.",
  },
  {
    "key": "rosie.conversation_1wlu3i_text",
    "notes": "Speaker=Rosie",
    "value": "Je pense que certains se préparent à aller dans la mine.",
  },
  {
    "key": "rosie.conversation_y85nbk_text",
    "notes": "Speaker=Fen",
    "value": "Alors allons-y et {format highlight}détruisons les derniers dispositifs !{format reset}",
  },
  {
    "key": "rosie.conversation_o9wzoz_text",
    "notes": "Speaker=Rosie Notes=*new*",
    "value": "J'espère que tu vas trouver ton ami rapidement... et l'arrêter une bonne fois pour toutes.",
  },
  {
    "key": "rosie.conversation_g8unqh_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Il faut détruire les dernières machines{format reset}. Je ne sais pas combien de temps encore je pourrai contenir les miens ici.",
  },
  {
    "key": "rosie.conversation_hinklt_text",
    "notes": "Speaker=Dorothy",
    "value": "As-tu senti le tremblement, une fois la machine détruite ?",
  },
  {
    "key": "rosie.conversation_7bjdrx_text",
    "notes": "Speaker=Rosie",
    "value": "Oui, j'ai eu beaucoup de mal à calmer les miens. Ils étaient très nerveux.",
  },
  {
    "key": "rosie.conversation_ot1xb4_text",
    "notes": "Speaker=Rosie",
    "value": "Je n'ai pas encore fait de décompte. J'espère juste qu'ils sont tous là.",
  },
  {
    "key": "rosie.conversation_8vqdk5_text",
    "notes": "Speaker=Dorothy Notes=*new* removed a "yes"",
    "value": "Il y a encore une machine à détruire.",
  },
  {
    "key": "rosie.conversation_1t4jq7_text",
    "notes": "Speaker=Rosie",
    "value": "Nous serons tous en sécurité une fois ces machines détruites.",
  },
  {
    "key": "rosie.conversation_5hrt2a_text",
    "notes": "Speaker=Rosie",
    "value": "{format highlight}Il faut détruire la dernière machine{format reset}. Personne n'est en sécurité !",
  },
  {
    "key": "rosie.conversation_2jw2v2_text",
    "notes": "Speaker=Rosie",
    "value": "Tu n'es pas comme les autres de ton espèce.",
  },
  {
    "key": "rosie.conversation_pf575r_text",
    "notes": "Speaker=Rosie",
    "value": "Je n'aurais jamais pensé rencontrer quelqu'un de ton espèce que j'apprécie !",
  },
  {
    "key": "used_teleporter.conversation_tb8lha_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Hé ! Je n'ai pas autorisé la réouverture de ces tubes !",
  },
  {
    "key": "used_teleporter.conversation_c3vudp_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Visse ton clapet, fils ! C'est le moyen le plus efficace pour se déplacer dans la mine.",
  },
  {
    "key": "used_teleporter.conversation_of6kl3_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Le Passage de la Roche Rouge est totalement bouché à cause des tremblements.",
  },
  {
    "key": "used_teleporter.conversation_p4u169_text",
    "notes": "Speaker=Mayor Mic Yonker",
    "value": "Tu n'as aucune preuve que c'est à cause des tremblements. Ça pourrait être n'importe quoi d'autre !",
  },
  {
    "key": "used_teleporter.conversation_wr7t16_text",
    "notes": "Speaker=Dorothy",
    "value": "Quoi qu'il en soit, j'ai besoin d'explosifs pour dégager le passage.",
  },
  {
    "key": "used_teleporter.conversation_ljkhuj_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Je pense que tu peux {format highlight}trouver des explosifs{format reset} dans la Station sans pression.",
  },
  {
    "key": "used_teleporter.conversation_kf7hxd_text",
    "notes": "Speaker=Ma Yonker Notes=*new*",
    "value": "Reste sur le côté est lors de ta prochaine descente et tu le trouveras.",
  },
  {
    "key": "used_teleporter.conversation_fsgerc_text",
    "notes": "Speaker=Dorothy",
    "value": "Quoi qu'il en soit, je pensais utiliser des explosifs pour dégager le chemin.",
  },
  {
    "key": "used_teleporter.conversation_atnqc9_text",
    "notes": "Speaker=Ma Yonker",
    "value": "Ah, je vois que quelqu'un a été à la Station sans pression. Va donc {format highlight}déboucher le passage{format reset}, ma petite !",
  },
  {
    "key": "hub_guard_hurt.conversation_7mti7b_text",
    "notes": "Speaker=Schwifty Shawn",
    "value": "{format nervous}AÏE !{format reset}",
  },
  {
    "key": "hub_guard_woke.conversation_bg1gtj_text",
    "notes": "Speaker=Schwifty Shawn Notes=*new* changed a ) to a }",
    "value": "{format nervous}...hein ?{format reset}",
  },
  {
    "key": "welcome_to_the_hub.conversation_5yt2bx_text",
    "notes": "Speaker=Fen",
    "value": "Des renforts ! Occupe-toi-en avant qu'ils ne se multiplient !",
  },
  {
    "key": "welcome_to_the_hub.conversation_0y97x7_text",
    "notes": "Speaker=Rosie",
    "value": "Encore un tremblement... et un robot sacrément violent. Reste sur tes gardes, Shawn !",
  },
  {
    "key": "welcome_to_the_hub.conversation_swc23b_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu peux parler ?",
  },
  {
    "key": "welcome_to_the_hub.conversation_sa7wlq_text",
    "notes": "Speaker=Rosie",
    "value": "Pourquoi ne pourrais-je pas parler ? As-tu seulement {format emph}essayé{format reset} de parler avec l'un de nous auparavant, petit robot ?",
  },
  {
    "key": "welcome_to_the_hub.conversation_h9pnyw_text",
    "notes": "Speaker=Dorothy",
    "value": "Tu as raison, je suis désolée. Je ne cherche pas la bagarre, je suis à la recherche d'un ami qui a disparu.",
  },
  {
    "key": "welcome_to_the_hub.conversation_mkx6nq_text",
    "notes": "Speaker=Rosie",
    "value": "Est-ce que ton ami est cuivré et ressemble un peu à une tortue ?",
  },
  {
    "key": "welcome_to_the_hub.conversation_jignph_text",
    "notes": "Speaker=Dorothy",
    "value": "Oui ! C'est lui ! Est-ce que tu sais où il est ?",
  },
  {
    "key": "welcome_to_the_hub.conversation_ryszmg_text",
    "notes": "Speaker=Rosie",
    "value": "Hum... c'est probablement une mauvaise idée de laisser un vapbot entrer, mais tu sembles sincère.",
  },
  {
    "key": "welcome_to_the_hub.conversation_2r5k9z_text",
    "notes": "Speaker=Rosie",
    "value": "Je suis Rosie. Viens. {format highlight}Nous allons parler à l'intérieur{format reset}, je vais te dire tout ce que je sais.",
  },
  {
    "key": "floaty.conversation_ty7umo_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Chut... tu es aussi bruyante que la p'tite Rosie.",
  },
  {
    "key": "floaty.conversation_35muig_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Chut...",
  },
  {
    "key": "floaty.conversation_trxx9s_text",
    "notes": "Speaker=Cleo Johnson Notes=She has a fishing pole",
    "value": "Chut... tu vas leur faire peur...",
  },
  {
    "key": "floaty.conversation_bcfgsy_text",
    "notes": "Speaker=Dorothy",
    "value": "Ne le prends pas mal, mais je ne pense pas que des poissons puissent survivre dans un truc pareil.",
  },
  {
    "key": "floaty.conversation_ufdh71_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Poissons... quels poissons ? Chaussure, c'est ma chaussure. Elle glisse tout l'temps !",
  },
  {
    "key": "floaty.conversation_x3mdff_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo a besoin d'une chaussure, ici, ici chaussure...",
  },
  {
    "key": "floaty.conversation_6wq728_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* run offt is old 20's hillbilly-talk.",
    "value": "Chaussure... nage ici et protège mes petons ! Comme ça Cleo pourra s'cliqueter !",
  },
  {
    "key": "floaty.conversation_vrn5ho_text",
    "notes": "Speaker=Dorothy",
    "value": "Les chaussures ça ne peut pas nager...",
  },
  {
    "key": "floaty.conversation_syk9tk_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Cleo sait que tu connais rien en chaussures.",
  },
  {
    "key": "floaty.conversation_ejlda7_text",
    "notes": "Speaker=Cleo Johnson Notes=*new*",
    "value": "Sinon, comment elles auraient pu arriver ici dans l'pousse-café ?",
  },
  {
    "key": "floaty.conversation_9ssddv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Comment ça chaussure ne nage pas ? Bien sûr que si.",
  },
  {
    "key": "floaty.conversation_f5fe22_text",
    "notes": "Speaker=Dorothy",
    "value": "As-tu réussi à retrouver tes chaussures ?",
  },
  {
    "key": "floaty.conversation_uwbwbt_text",
    "notes": "Speaker=Cleo Johnson Notes=*new* Speachimpediment: "Dry mouf"="dry mouth"",
    "value": "Ah ! M'en fiche de chaussure maintenant, Cleo a chouaf et n'a plus l'temps d'attendre ici.",
  },
  {
    "key": "floaty.conversation_7dil67_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Cleo a des plans, Cleo va quitter cet endroit et ne plus jamais penser à chaussure.",
  },
  {
    "key": "floaty.conversation_e7vvqa_text",
    "notes": "Speaker=Dorothy",
    "value": "D'accord...",
  },
  {
    "key": "floaty.conversation_mkd1g9_text",
    "notes": "Speaker=Cleo Johnson Notes=You dumb bucket thing, Cleo should kick you before say more stupid things.",
    "value": "Stupide seau d'métal, Cleo devrait te taper avant que tu dises plus d'bêtises !",
  },
  {
    "key": "floaty.conversation_7c453w_text",
    "notes": "Speaker=Cleo Johnson Notes=Pay attention to the translation of "moon juice"",
    "value": "Cleo va partir bientôt, presque plus d'pousse-café.",
  },
  {
    "key": "floaty.conversation_nny1i7_text",
    "notes": "Speaker=Cleo Johnson Notes=thursty",
    "value": "Cleo a chouaf.",
  },
  {
    "key": "floaty.conversation_atofqv_text",
    "notes": "Speaker=Cleo Johnson",
    "value": "Par ici, chaussure, chaussure, chaussure !",
  },
  {
    "key": "gran.conversation_dk7b1d_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "M'fille est trop gentille...laisser entrer un vapbot ? L'est encore plus bête qu'elle en a l'air !",
  },
  {
    "key": "gran.conversation_0fdyik_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Qu'est-ce qu'un bout d'métal comme toi viens faire ici ?",
  },
  {
    "key": "gran.conversation_xx02dp_text",
    "notes": "Speaker=Dorothy",
    "value": "Rosie m'a invité pour parler.",
  },
  {
    "key": "gran.conversation_qvnh5f_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Typique d'ma grande mutante d'fille. Même pas capable d'écraser une boîte d'conserve quand elle en voit une.",
  },
  {
    "key": "gran.conversation_n9fykw_text",
    "notes": "Speaker=Dorothy",
    "value": "Ce n'est pas très gentil.",
  },
  {
    "key": "gran.conversation_mypcv4_text",
    "notes": "Speaker=Dynomyte Harriet Notes=*new* rephrased. Boom sticks here are sticks of dynamite",
    "value": "Qu'est-ce qu'on peut faire d'autre avec d'bâtons qui font boum !",
  },
  {
    "key": "gran.conversation_e6z5ja_text",
    "notes": "Speaker=Fen",
    "value": "J'aime bien ce tas de viande.",
  },
  {
    "key": "gran.conversation_3zke2l_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Combien t'penses qu'il faut d'bâtons pour faire boum à vous aut' boîtes d'conserve ?",
  },
  {
    "key": "gran.conversation_a9cchj_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "J'aime po trop avoir une boîte d'conserve dans not' oasis.",
  },
  {
    "key": "gran.conversation_9svalt_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Rosie aurait dû t'écraser au lieu d't'laisser entrer !",
  },
  {
    "key": "gran.conversation_3su3ui_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Dans l'temps, les mines étaient à nous. Si on trouvait des boîtes d'conserve, on les faisait boum !",
  },
  {
    "key": "gran.conversation_oza28i_text",
    "notes": "Speaker=Fen",
    "value": "Ce tas de viande est de plus en plus intéressant !",
  },
  {
    "key": "gran.conversation_yrhik2_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Fais 'ttention à c'que tu dis, miniature !",
  },
  {
    "key": "gran.conversation_ihr9we_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "J'suis fatiguée d'traîner m'chaussons ici.",
  },
  {
    "key": "gran.conversation_agybew_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "J'voudrais ben sortir et faire boum ces tremblements et aussi ces drôles d'plantes.",
  },
  {
    "key": "gran.conversation_nvv14n_text",
    "notes": "Speaker=Dynomyte Harriet Notes=Pay attention to translation of Moon Juice",
    "value": "J'vais juste attendre une goutte d'pousse-café avant d'partir.",
  },
  {
    "key": "gran.conversation_ezltzc_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "P'têt que si on met plusieurs bâtons qui font boum ensemble dans un trou, ç'va calmer ces tremblements.",
  },
  {
    "key": "gran.conversation_2h242j_text",
    "notes": "Speaker=Dynomyte Harriet",
    "value": "Bas les pinces ! J'veux pas gâcher mes bâtons sur toi !",
  },
  {
    "key": "helpfulhelen.conversation_146h2g_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_w42y9y_text",
    "notes": "Speaker=Stabby Helen",
    "value": "R'cule...r'cule... méchante boîte d'conserve !",
  },
  {
    "key": "helpfulhelen.conversation_lbsxjr_text",
    "notes": "Speaker=Dorothy",
    "value": "Je ne te veux pas de mal, je me demande seulement si...",
  },
  {
    "key": "helpfulhelen.conversation_76kde3_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_nilvvh_text",
    "notes": "Speaker=Dorothy",
    "value": "D'accord... je vais reculer un peu !",
  },
  {
    "key": "helpfulhelen.conversation_nrvcc5_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed all-caps",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_na5ijp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "J'suis forte pour taper les boîtes d'conserves, t'sais.",
  },
  {
    "key": "helpfulhelen.conversation_t4gyc9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "J'en ai tapé une l'autre s'maine.",
  },
  {
    "key": "helpfulhelen.conversation_8z4duw_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "J'ai même pas d'blessure ni rien. J'ai juste fait repousser un d'mes bras, c'tout.",
  },
  {
    "key": "helpfulhelen.conversation_68xyfp_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Heureusement, c'était pas mon bras pour couper !",
  },
  {
    "key": "helpfulhelen.conversation_4tb6xl_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_mfx4dl_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Ouaip, j'tais dans une bagarre d'robots.",
  },
  {
    "key": "helpfulhelen.conversation_2z93th_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed "That"",
    "value": "Rosie, l'aime pas qu'j'aille dans la mine pour couper des trucs.",
  },
  {
    "key": "helpfulhelen.conversation_2r5nu3_text",
    "notes": "Speaker=Dorothy",
    "value": "Ça peut se comprendre.",
  },
  {
    "key": "helpfulhelen.conversation_10fkd9_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Mais j'aime couper !",
  },
  {
    "key": "helpfulhelen.conversation_sp7pdd_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_6iq52s_text",
    "notes": "Speaker=Stabby Helen",
    "value": "Tu sais, j'aime vraiment couper des trucs.",
  },
  {
    "key": "helpfulhelen.conversation_1su49z_text",
    "notes": "Speaker=Stabby Helen Notes=*new* removed the last "left"",
    "value": "J'rêve d'me balader dans la mine, en faisant coupe-coupe sur les bots que j'croise à gauche et à droite !",
  },
  {
    "key": "helpfulhelen.conversation_azc2px_text",
    "notes": "Speaker=Dorothy",
    "value": "D'accord...",
  },
  {
    "key": "helpfulhelen.conversation_14e8qj_text",
    "notes": "Speaker=Stabby Helen Notes=*new* changed right to left",
    "value": "Et encore à gauche !",
  },
  {
    "key": "helpfulhelen.conversation_cu3ase_text",
    "notes": "Speaker=Stabby Helen Notes=*new*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_5wwgu9_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_rnl3im_text",
    "notes": "Speaker=Stabby Helen",
    "value": "J'veux sortir faire coupe-coupe !",
  },
  {
    "key": "helpfulhelen.conversation_2kxxoa_text",
    "notes": "Speaker=Stabby Helen Notes=*format*",
    "value": "Coupant-coupe-coupe !",
  },
  {
    "key": "sign_shiver.conversation_iyd9iu_text",
    "notes": "Speaker=Dorothy",
    "value": ""Attention ! Risque de tremblements ! Contactez le maire d'El Machino pour en savoir plus."",
  },
  {
    "key": "sign_miners_wanted.conversation_jn4gij_text",
    "notes": "Speaker=Dorothy",
    "value": ""Nous avons besoin de mineurs ! Continuez vers l'est pour atteindre El Machino et creuser votre destin !"",
  },
  {
    "key": "fen_on_shiners.conversation_04wf3d_text",
    "notes": "Speaker=Dorothy",
    "value": "Je n'avais jamais rencontré de soiffards capables de parler auparavant. D'habitude ils sont juste aussi détraqués que dangereux.",
  },
  {
    "key": "fen_on_shiners.conversation_mlu9ml_text",
    "notes": "Speaker=Fen",
    "value": "Oui... c'est vraiment plus ce que c'était !",
  },
  {
    "key": "fen_on_shiners.conversation_mcuc1c_text",
    "notes": "Speaker=Dorothy Notes=*new* removed and, added this",
    "value": "Je vais {format highlight}parler à cette Rosie{format reset}. Elle sait peut-être où est Rusty.",
  },
  {
    "key": "guarding_hub.conversation_z2w2u3_text",
    "notes": "Speaker=Schwifty Shawn Notes=*format* *new* also removed the line break (
}",
    "value": "H-h-h-hééééé ! C'est où qu'tu crois aller c'mme ça ?",
  },
  {
    "key": "guarding_hub.conversation_n2ebi3_text",
    "notes": "Speaker=Fen",
    "value": "BEURK ! Détruis cette chose immédiatement !",
  },
  {
    "key": "guarding_hub.conversation_kljpda_text",
    "notes": "Speaker=Dorothy",
    "value": "{format nervous}Un autre tremblement !{format reset}",
  },
  {
    "key": "dorothy_intro.conversation_t7sxdc_text",
    "notes": "Speaker=Dorothy",
    "value": "Où es-tu {format emph}passé{format reset}, Rusty ?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_vmz2v5_text",
    "notes": "Speaker=Fen",
    "value": "Voilà. C'est l'entrée de Vectron.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_iupd4b_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "D'accord. On y va ?",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_bbcmp1_text",
    "notes": "Speaker=Fen Notes=*format* *new*'",
    "value": "On ? Non, je ne rentre pas {format emph}là-dedans{format reset}. Je ne veux pas...",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rh2uj_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Même si je le voulais, je ne pourrais pas. Pas à travers un portail comme {format emph}celui-là{format reset}.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_pkxjfo_text",
    "notes": "Speaker=Fen",
    "value": "Mais j'ai dit que j'allais {format emph}te{format reset} faire entrer.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_emqhdd_text",
    "notes": "Speaker=Dorothy",
    "value": "S'il y a une petite chance que Rusty soit là-dedans, je dois y aller.",
  },
  {
    "key": "fen_vectron_teleporter_intro.conversation_1rkegt_text",
    "notes": "Speaker=Fen",
    "value": "Alors vas-y.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_qrn9qn_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_bye",
    "value": "Tu seras toute seule là-dedans et tu n'auras pas accès à la carte.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_sfgslu_text",
    "notes": "Speaker=Fen Notes=*new* moved here from fen_vectron_teleporter_by",
    "value": "Tu vas devoir trouver la sortie toute seule.",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_j9uqnv_text",
    "notes": "Speaker=Fen",
    "value": "Tu veux vraiment le faire ?",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_69953l_text",
    "notes": "Speaker=Fen Notes=*format* *new*",
    "value": "OK...",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_yjswup_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "OK, c'est parti....",
  },
  {
    "key": "fen_vectron_teleporter_ask.conversation_uwxfmo_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ouais, {format emph}je{format reset} ne vais pas te forcer.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_91l718_text",
    "notes": "Speaker=Dorothy",
    "value": "Je viendrai te chercher dès que je sors.",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vmzz9y_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_u6n77q_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Si tu vois quelque chose qui bouge, fuis. Fuis aussi vite que tu peux...",
  },
  {
    "key": "fen_vectron_teleporter_bye.conversation_vctaoa_text",
    "notes": "Speaker=Dorothy Notes=*new*",
    "value": "...",
  },
  {
    "key": "exiting_vectron_firsttime_01.conversation_sp4sbx_text",
    "notes": "Speaker=Dorothy",
    "value": "Fen ?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_rj6ww8_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "FEN !?",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_ad0u27_text",
    "notes": "Speaker=vectron_teleporter Notes=*format* *new* shortened "I am..." to "I..." and emphasised the last "Fen"",
    "value": "Fen ? Je... je suis Fen.",
  },
  {
    "key": "exiting_vectron_firsttime_02.conversation_1ajm6u_text",
    "notes": "Speaker=vectron_teleporter",
    "value": "Dorothy ?",
  },
  {
    "key": "run_away_with_rusty_1.conversation_wgoby1_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY !",
  },
  {
    "key": "rosie_boss_intro_01.conversation_r5a8b8_text",
    "notes": "Speaker=Dorothy",
    "value": "RUSTY !?",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_pgjtz4_text",
    "notes": "Speaker=Dorothy",
    "value": "Allez Fen ! On doit faire vite !",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_uzk2jn_text",
    "notes": "Speaker=Fen",
    "value": "Nous n'allons jamais {format nervous}rentrer{format reset} en ville comme ça...",
  },
  {
    "key": "enter_endgame_teleporter_1.conversation_5rvneb_text",
    "notes": "Speaker=Fen Notes=*new* changed the format to affect more words",
    "value": "Mais je peux {format emph}vous{format reset} faire sortir d'ici à temps.",
  },
  {
    "key": "sign_thehub.conversation_32yflg_text",
    "notes": "Speaker=Dorothy",
    "value": "" ON ETS FREMÉ ! RENTREZ CHEZ VOUS !"",
  },
  {
    "key": "fen_its_gonna_blow.conversation_ghi2wb_text",
    "notes": "Speaker=Fen",
    "value": "Hé ! Cette chose est complètement {format nervous}détraquée !{format reset}",
  },
  {
    "key": "fen_its_gonna_blow.conversation_8xsftw_text",
    "notes": "Speaker=Fen Notes=*new* changed formated text from highlight to emph",
    "value": "Filons d'ici tant que c'est possible ! {format emph}Maintenant !{format reset}",
  },
  {
    "key": "run_away_with_rusty_3.conversation_4v2csa_text",
    "notes": "Speaker=Dorothy",
    "value": "La fusée de Prof. Sherman !",
  },
  {
    "key": "run_away_with_rusty_3.conversation_izxx5d_text",
    "notes": "Speaker=Dorothy",
    "value": "On doit rentrer en ville tout de suite !",
  },
  {
    "key": "easteregg_ending.conversation_x1pswz_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Allez ! {format emph}Vite !{format reset}",
  },
  {
    "key": "easteregg_ending.conversation_bfup2f_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Pas le temps de douter !",
  },
  {
    "key": "easteregg_ending.conversation_2ez9yy_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Allez !",
  },
  {
    "key": "easteregg_ending.conversation_kuytvd_text",
    "notes": "Speaker=endgame_teleporter",
    "value": "Il est plus que temps d'y aller.",
  },
  {
    "key": "fen_ending_goodbye.conversation_qsa1um_text",
    "value": "À un de ces jours, Dot...",
  },
  {
    "key": "rocketeer.conversation_hwmfh6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Si seulement le maire Yonker pouvait entendre raison...",
  },
  {
    "key": "rocketeer.conversation_d0ozct_text",
    "notes": "Speaker=Professor Sherman",
    "value": "À quoi bon parler avec ceux dont la survie dépend d'une capacité à ne rien comprendre ?",
  },
  {
    "key": "rocketeer.conversation_bdyzc2_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Il y a quelque chose de très étrange autour de ces tremblements de terre.",
  },
  {
    "key": "rocketeer.conversation_tjv7fp_text",
    "notes": "Speaker=Dorothy Notes=*new* changes since earlier version could be off in some instances.",
    "value": "Ouh là ! C'est vraiment une chouette fusée !",
  },
  {
    "key": "rocketeer.conversation_t09utv_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased to work with new version of above line",
    "value": "En effet. Je n'ai guère le choix à vrai dire, puisque le maire fait peu de cas de la science à l'heure actuelle, j'ai dû imaginer un plan de secours.",
  },
  {
    "key": "rocketeer.conversation_f7plgb_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Mon sismographe m'indique que quelque chose ne tourne pas rond avec ces tremblements.",
  },
  {
    "key": "rocketeer.conversation_yhfxkq_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Notre mine a été creusée le long d'une ligne de faille. Un bon séisme, et hop, tout ici finirait par terre !",
  },
  {
    "key": "rocketeer.conversation_k00t1f_text",
    "notes": "Speaker=Professor Sherman",
    "value": "J'espère réussir à faire fonctionner cette fusée avant qu'il ne soit trop tard.",
  },
  {
    "key": "rocketeer.conversation_220si9_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ces nouveaux séismes ne demandent qu'à être étudiés de plus près. L'enjeu est énorme.",
  },
  {
    "key": "rocketeer.conversation_yd21lh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "À vrai dire, deux grandes plaques tectoniques se rencontrent ici, juste sous nos pieds.",
  },
  {
    "key": "rocketeer.conversation_yhhdlm_text",
    "notes": "Speaker=Professor Sherman",
    "value": "La ville a été bâtie sur un piton rocheux né de la collision de ces plaques, il y a des millions d'années.",
  },
  {
    "key": "rocketeer.conversation_jd18od_text",
    "notes": "Speaker=Dorothy",
    "value": "Waouh...",
  },
  {
    "key": "rocketeer.conversation_ma515w_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ces schémas sismiques inhabituels m'inquiètent un peu.",
  },
  {
    "key": "rocketeer.conversation_rh627j_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ils ne sont pas dus à des mouvements ordinaires de la croûte terrestre.",
  },
  {
    "key": "rocketeer.conversation_8vxt9k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Si le Grand tremblement survenait, il pourrait bien détruire toute la ville. Ou pire, toute la planète !",
  },
  {
    "key": "rocketeer.conversation_nid8rc_text",
    "notes": "Speaker=Dorothy",
    "value": "{format emph}La vache !{format reset} Je ferais mieux de concentrer mes capteurs là-bas alors.",
  },
  {
    "key": "rocketeer.conversation_gqcn63_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Tu ferais bien, oui !",
  },
  {
    "key": "rocketeer.conversation_q2vvjy_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ces schémas sismiques inhabituels continuer à m'inquiéter.",
  },
  {
    "key": "rocketeer.conversation_46mop5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Le mur protecteur au fond de la mine est une vraie merveille.",
  },
  {
    "key": "rocketeer.conversation_k6sl9a_text",
    "notes": "Speaker=Dorothy",
    "value": "Il y avait aussi un mur sous mon village natal, à Tumbleton.",
  },
  {
    "key": "rocketeer.conversation_wb49hd_text",
    "notes": "Speaker=Professor Sherman",
    "value": "En réalité, c'est le même mur. Il s'étend sur des kilomètres et des kilomètres !",
  },
  {
    "key": "rocketeer.conversation_prdn7m_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "C'est la plus grande structure jamais construite par des robots. S'il était à la surface, on le verrait de l'espace.",
  },
  {
    "key": "rocketeer.conversation_0b17qr_text",
    "notes": "Speaker=Dorothy",
    "value": "Toutes ces couches de briques, rien que pour maintenir les soiffards dans les profondeurs...",
  },
  {
    "key": "rocketeer.conversation_4s3zz6_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Vois-tu, les soiffards, ou {format emph}homo devolvis{format reset}, se montrent plutôt ingénieux dans certains domaines.",
  },
  {
    "key": "rocketeer.conversation_29dn85_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Ce pousse-café qu'ils ont concocté, pour tenir sous terre, est assez spécial...",
  },
  {
    "key": "rocketeer.conversation_8na87z_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added a comma after mutagenic",
    "value": "C'est une substance mutagène et bien sûr addictive, mais c'est aussi une source d'énergie extrêmement efficace.",
  },
  {
    "key": "rocketeer.conversation_auy7u5_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "J'avoue l'avoir expérimenté comme carburant pour roquette au début, mais il s'est avéré bien trop instable.",
  },
  {
    "key": "rocketeer.conversation_0144bl_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Quel plaisir de contempler le mur protecteur !",
  },
  {
    "key": "rocketeer.conversation_vfvf68_text",
    "notes": "Speaker=Dorothy",
    "value": "Qu'est-ce que vous savez au sujet des plantes cavernicoles ?",
  },
  {
    "key": "rocketeer.conversation_n56yib_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Je ne suis pas vraiment biologiste, mais j'imagine que certains champignons peuvent s'adapter à de tels environnements.",
  },
  {
    "key": "rocketeer.conversation_6u259t_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai trouvé une grotte qui en est complètement envahie.",
  },
  {
    "key": "rocketeer.conversation_4luy17_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Intéressant ! En toute logique, ils doivent tirer leur énergie d'une autre source que la photosynthèse.",
  },
  {
    "key": "rocketeer.conversation_vq8bcq_text",
    "notes": "Speaker=Dorothy",
    "value": "J'ai trouvé les soiffards. Je leur ai même parlé ! Ils ont construit un village sous le mur.",
  },
  {
    "key": "rocketeer.conversation_qbphbv_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Fascinant ! Je n'avais jamais entendu parler de soiffards en vie capables de communiquer.",
  },
  {
    "key": "rocketeer.conversation_d8arjf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Les rares que j'ai vus de mes yeux poussaient des grondements bestiaux. Totalement inintelligible !",
  },
  {
    "key": "rocketeer.conversation_m0q6cs_text",
    "notes": "Speaker=Professor Sherman",
    "value": "J'ai lu quelque part une théorie selon laquelle ils auraient été autrefois l'espèce dominante de cette planète.",
  },
  {
    "key": "rocketeer.conversation_n96czx_text",
    "notes": "Speaker=Professor Sherman",
    "value": "On ne peut faire guère plus que spéculer quand on s'intéresse à l'homo devolvis...",
  },
  {
    "key": "rocketeer.conversation_9axbnb_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new* merged two lines into one.",
    "value": "Il est pratiquement impossible de mettre la main sur un spécimen d'étude sans le blesser...ou être blessé.",
  },
  {
    "key": "rocketeer.conversation_6qfwjp_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Les soiffards sont une espèce fascinante. On devine une lueur d'individualité dans leurs yeux hagards.",
  },
  {
    "key": "rocketeer.conversation_wlfozb_text",
    "notes": "Speaker=Dorothy Notes=*new* rephrased",
    "value": "Professeur, pensez-vous que les robots soient à l'origine des tremblements de terre ?",
  },
  {
    "key": "rocketeer.conversation_ylnbuf_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Tu veux savoir si quelqu'un provoque les tremblements de terre ?",
  },
  {
    "key": "rocketeer.conversation_x4pgec_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Cela pourrait expliquer l'épicentre insolite des dernières secousses.",
  },
  {
    "key": "rocketeer.conversation_934xqz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Je l'ai localisé à l'emplacement du temple de la secte démente.",
  },
  {
    "key": "rocketeer.conversation_72gm7a_text",
    "notes": "Speaker=Dorothy",
    "value": "C'est donc {format emph}possible{format reset} ?",
  },
  {
    "key": "rocketeer.conversation_w0qkeb_text",
    "notes": "Speaker=Professor Sherman Notes=*new*",
    "value": "Pour tester cette hypothèse, tu dois {format highlight}traverser les Plaines venteuses{format reset} et atteindre le temple à l'est, pour mener l'enquête.",
  },
  {
    "key": "rocketeer.conversation_7xmo4l_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Cette hypothèse de séismes d'origine robotique est fascinante.",
  },
  {
    "key": "rocketeer.conversation_p7mpft_text",
    "notes": "Speaker=Professor Sherman Notes=*new* added the part about taking the ladder",
    "value": "{format highlight}Traverse les Plaines venteuses{format reset} pour en savoir plus. Utilise l'échelle dans la partie est de la ville.",
  },
  {
    "key": "rocketeer.conversation_9zagcy_text",
    "notes": "Speaker=Dorothy",
    "value": "Le culte garde une sorte de machine potentiellement capable de générer les tremblements de terre.",
  },
  {
    "key": "rocketeer.conversation_d8olb4_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Dans ce cas, ce que tu dois faire, c'est démanteler la machine. Cela pourrait mettre fin aux séismes.",
  },
  {
    "key": "rocketeer.conversation_vts8e3_text",
    "notes": "Speaker=Fen",
    "value": "{format emph}Ouais !{format reset} Démanteler, ça a l'air rigolo. Allons-y !",
  },
  {
    "key": "rocketeer.conversation_ly2vhz_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Il se peut que je n'aie même pas à achever cette roquette.",
  },
  {
    "key": "rocketeer.conversation_ypryh5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Construire un vaisseau d'exploration spatiale n'est pas chose aisée.",
  },
  {
    "key": "rocketeer.conversation_qq0n6k_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Si tu réussis à {format highlight}arrêter le générateur de séisme{format reset}, je n'aurai pas besoin de le faire.",
  },
  {
    "key": "rocketeer.conversation_hbhl5o_text",
    "notes": "Speaker=Dorothy",
    "value": "Comment est-ce qu'un robot à vapeur a bien pu construire un générateur de séismes ?",
  },
  {
    "key": "rocketeer.conversation_dpkudw_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Ils doivent avoir accès à une technologie très avancée.",
  },
  {
    "key": "rocketeer.conversation_irqx6c_text",
    "notes": "Speaker=Professor Sherman Notes=*format*",
    "value": "Une technologie futuriste qui dépasse tout ce que j'ai connu...",
  },
  {
    "key": "rocketeer.conversation_gljg9h_text",
    "notes": "Speaker=Professor Sherman",
    "value": "J'ai consulté mes anciens livres pour essayer d'identifier un modèle général, mais il y en a partout.",
  },
  {
    "key": "rocketeer.conversation_j3paiq_text",
    "notes": "Speaker=Professor Sherman Notes=*format* *new*",
    "value": "Les mouvements erratiques de ces séismes me laissent penser que nous ne sommes pas sortis d'affaire.",
  },
  {
    "key": "rocketeer.conversation_w8nhom_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Je suis loin d'être prête à abandonner le bricolage de la fusée.",
  },
  {
    "key": "rocketeer.conversation_ihi6uu_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Je ne me sens pas prête à arrêter de bricoler la fusée.",
  },
  {
    "key": "rocketeer.conversation_j6jtna_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Un de mes collègues a pu obtenir des échantillons de la jungle souterraine.",
  },
  {
    "key": "rocketeer.conversation_oepnn1_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "C'est bizarre, vous ne trouvez pas ? Et très dangereux.",
  },
  {
    "key": "rocketeer.conversation_kul85z_text",
    "notes": "Speaker=Fen",
    "value": "Et super cool !",
  },
  {
    "key": "rocketeer.conversation_b4ld5b_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Quoi qu'il en soit, il dit avoir trouvé des traces d'un mutagène ayant contaminé les plantes.",
  },
  {
    "key": "rocketeer.conversation_h8rkzh_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Il semblerait qu'elles puisent leur énergie dans le {format emph}pousse-café{format reset} mutagène qui obsède les soiffards.",
  },
  {
    "key": "rocketeer.conversation_bthpa5_text",
    "notes": "Speaker=Dorothy",
    "value": "Il y a {format emph}beaucoup{format reset} de tuyaux par ici.",
  },
  {
    "key": "rocketeer.conversation_wvpx34_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Il pourrait bien s'agir de la source du polluant.",
  },
  {
    "key": "rocketeer.conversation_ll0rrj_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Cette jungle n'est qu'un mystère de plus dans une longue série d'événements étranges.",
  },
  {
    "key": "rocketeer.conversation_gcue08_text",
    "notes": "Speaker=Dorothy",
    "value": "On a désactivé tous les générateurs de tremblements de terre.",
  },
  {
    "key": "rocketeer.conversation_rhj5jo_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Mes relevés sismiques ont cessé leurs sursauts chaotiques et se sont fixés sur un point.",
  },
  {
    "key": "rocketeer.conversation_pgv6y7_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Le dernier séisme provient des terres des soiffards.",
  },
  {
    "key": "rocketeer.conversation_j878i8_text",
    "notes": "Speaker=Dorothy Notes=*new* removed the reference to the oasis being blocked as the player could be oblivious to this.",
    "value": "Nous devons absolument redescendre et {format highlight}parler avec Rosie.{format reset}",
  },
  {
    "key": "rocketeer.conversation_lv5xcl_text",
    "notes": "Speaker=Professor Sherman Notes=*new* rephrased the ending of the line.",
    "value": "Heureusement que ma fusée est prête. Il ne me reste plus qu'une dernière touche à apporter et nous pourrons partir si besoin.",
  },
  {
    "key": "rocketeer.conversation_9rxm14_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Plus qu'une dernière touche et nous pourrons quitter cette planète, au cas où le Grand tremblement de terre éclate.",
  },
  {
    "key": "rocketeer.conversation_tnyv5r_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Dès que vaisseau d'exploration spatiale sera terminé, je quitterai cette planète.",
  },
  {
    "key": "rocketeer.conversation_7an1z5_text",
    "notes": "Speaker=Professor Sherman",
    "value": "Tout le monde est bienvenu à bord. Je l'ai fait assez grand pour accueillir des invités.",
  },
  {
    "key": "workbench_conversation.conversation_f5xes1_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Oh oh oh !",
  },
  {
    "key": "workbench_conversation.conversation_vwbtbo_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "J'ai des nouvelles améliorations pour toi ! Des trucs de haute technologie !",
  },
  {
    "key": "workbench_conversation.conversation_d17hfn_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Donc, euh... désolé de te déranger... encore une fois.",
  },
  {
    "key": "workbench_conversation.conversation_2hj8xd_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Mais j'ai des nouveaux trucs en stock ! Tu vas pouvoir améliorer tes outils encore plus !",
  },
  {
    "key": "workbench_conversation.conversation_dnpk79_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Euh... j'voulais juste que tu le saches.",
  },
  {
    "key": "workbench_conversation.conversation_cq63md_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Bonjour... ?",
  },
  {
    "key": "workbench_conversation.conversation_eb2wqf_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "{format nervous}Aaah{format reset}, je veux dire euh... Bonjour !",
  },
  {
    "key": "workbench_conversation.conversation_6hj11o_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Euh... j'ai un nouvel arrivage de pièces !",
  },
  {
    "key": "workbench_conversation.conversation_ozu5go_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Avec ça tu peux améliorer tes outils... Je veux dire, tu peux les améliorer encore plus ! C'est cool, non ?",
  },
  {
    "key": "workbench_conversation.conversation_rkault_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Euh... j'ai remarqué que ton armure est un peu cabossée...",
  },
  {
    "key": "workbench_conversation.conversation_8lfpm2_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Il y a de quoi l'améliorer dans mon dernier arrivage.",
  },
  {
    "key": "workbench_conversation.conversation_kpzosz_text",
    "notes": "Speaker=Turtle Bucket Notes=*new*",
    "value": "Comme ça tu auras une meilleure chance de... tu sais... survivre là-dessous.",
  },
  {
    "key": "workbench_conversation.conversation_vk0in8_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... qu'est-ce que tu veux savoir ?",
  },
  {
    "key": "workbench_conversation.conversation_xbec1d_text",
    "notes": "Speaker=Turtle Bucket Notes=This is the introductary phrase from the mechanich",
    "value": "Euh... qu'est-ce que tu veux savoir ?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_4nh80e_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... j'aime bien ton équipement.",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_zb6ryl_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Donc, euh... tu peux l'améliorer avec des dopeurs. Tu veux euh... savoir comment faire ?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_k47xd0_text",
    "notes": "Speaker=Turtle Bucket Notes=This person is very nervous",
    "value": "Euh... pardon... Je vais me taire, d'accord ?",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_xsq7ao_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Tu veux vraiment euh... savoir ? Oh ! OK, OK !",
  },
  {
    "key": "workbench_conversation_cog_intro.conversation_9iwqjw_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "OK donc euh... oui, désolé. Je serai là si tu as euh... besoin de moi.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e2sw99_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Donc, euh... tu peux {format highlight}améliorer tes outils{format reset} avec des {image cogs_small} Méca dopeurs.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_qsonke_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Tu as dû en trouver dans les environs.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_9chqoj_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Utilise l'établi pour sélectionner l'emplacement de dopeur d'un outil, afin d'y placer tes {image cogs_small} Méca dopeurs.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_0dnnax_text",
    "notes": "Speaker=Turtle Bucket Notes=*new* added {format highlight}",
    "value": "Oh ! J'allais oublier... euh... pas de panique ! Tu peux ensuite {format highlight}retirer tes {image cogs_small} dopeurs{format reset} sans problème !",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_90zfu2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "À mesure que tu améliores tes outils, tu débloqueras d'autres améliorations !",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_a5snuc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Donc, euh... il y a encore deux ou trois trucs à dire sur le sujet, enfin si tu veux...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_b1szsc_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Il y a des améliorations dont tu dois d'abord trouver les plans.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_f0xxtp_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Davy Bittenborough, notre euh... cartographe, doit en avoir quelques uns.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_1q2dd2_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Les plans sont généralement plutôt cools ! Du moins euh... c'est ce que je crois...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_i2a540_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Oh et comme tu peux retirer n'importe quel dopeur {image cogs_small}, tu peux euh... tester ce qui te convient le mieux.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_5p4bi7_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "N'hésite pas à modifier de temps en temps. Euh... j'veux dire, si c'est ce que tu veux.",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_iq6h9b_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "Euh... waouh, tu m'as écouté jusqu'au bout ! Je ne peux pas en dire autant de tout le monde...",
  },
  {
    "key": "workbench_conversation_cog_tutorial.conversation_e4vdfi_text",
    "notes": "Speaker=Turtle Bucket",
    "value": "OK donc euh... oui, désolé. Je serai là si tu as euh... besoin de moi.",
  },
  {
    "key": "fen_wall_found.conversation_9lkkka_text",
    "notes": "Speaker=Fen",
    "value": "Cet endroit m'est familier. Le culte m'a peut-être amené ici en remontant.",
  },
  {
    "key": "fen_wall_found.conversation_qsa4d1_text",
    "notes": "Speaker=Fen",
    "value": "À quelle profondeur crois-tu que se trouvent {format nervous}les restes de Vectron ?{format reset}",
  },
  {
    "key": "fen_wall_found.conversation_3rahmd_text",
    "notes": "Speaker=Dorothy",
    "value": "C'est encore loin. On est toujours dans la partie explorée de la mine.",
  },
  {
    "key": "fen_wall_found.conversation_xecqeg_text",
    "notes": "Speaker=Fen",
    "value": "Ah, d'accord... bien, bien. Je me posais juste la question.",
  },
  {
    "key": "fen_wall_found.conversation_mx4ktk_text",
    "notes": "Speaker=Dorothy",
    "value": "Je dois juste trouver un moyen de passer ce maudit mur !",
  },
  {
    "key": "fen_wall_found.conversation_cat8cu_text",
    "notes": "Speaker=Fen",
    "value": "Oh ! Tu sais quelle heure il est ? {format singsong}L'heure d'exploser des trucs !{format reset}",
  },
  {
    "key": "fen_wall_found.conversation_nq5gxh_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Non, ça ne sera pas suffisant. Ces murs ont été construits après les guerres des soiffards, pour empêcher ces dingos de monter à la surface.",
  },
  {
    "key": "fen_wall_found.conversation_gu7tji_text",
    "notes": "Speaker=Dorothy",
    "value": "Les soiffards sont des experts en explosifs, les murs ont donc été construits pour résister aux explosions.",
  },
  {
    "key": "fen_below_wall.conversation_mbv8tf_text",
    "notes": "Speaker=Fen Notes=Place, refering to the underground jungle that they just passed thruogh.",
    "value": "Hé ! Cet endroit était {format nervous}super bizarre !{format reset}",
  },
  {
    "key": "fen_below_wall.conversation_cj1k6o_text",
    "notes": "Speaker=Dorothy",
    "value": "On dirait qu'on a passé la première couche du mur quand même.",
  },
  {
    "key": "fen_below_wall.conversation_5mo9pe_text",
    "notes": "Speaker=Dorothy",
    "value": "J'espère que cette station de minage n'est pas loin.",
  },
  {
    "key": "fen_below_wall.conversation_vizvqs_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Et moi j'espère qu'on va y trouver quelque chose de cool et de destructif.",
  },
  {
    "key": "fen_on_yarrow.conversation_rswyd0_text",
    "notes": "Speaker=Fen",
    "value": "Hé, c'est quoi cet endroit ? Ça a l'air sombre et dangereux. Explorons-le !",
  },
  {
    "key": "fen_on_yarrow.conversation_vqbkn5_text",
    "notes": "Speaker=Dorothy Notes=*new* shortened by removing description of place. Was a bit misrepresentative",
    "value": "Rien ne devrait pousser à cet endroit...",
  },
  {
    "key": "fen_on_yarrow.conversation_jk4t0s_text",
    "notes": "Speaker=Dorothy",
    "value": "Il y a sûrement toutes sortes de dangers dans le coin.",
  },
  {
    "key": "fen_on_yarrow.conversation_i4oq3o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}J'espère bien !{format reset}",
  },
  {
    "key": "fen_on_yarrow.conversation_qaywwl_text",
    "notes": "Speaker=Dorothy",
    "value": "Je dois m'assurer d'avoir assez de lumière avant de m'aventurer dans la zone.",
  },
  {
    "key": "fen_on_yarrow.conversation_sf4uwk_text",
    "notes": "Speaker=Fen",
    "value": "T'es vraiment pas drôle... tu le sais ça ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_1135rj_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Cette mine a une histoire si riche ! J'essaye de la cartographier depuis pas mal de temps.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dq65oq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "On peut trouver toutes sortes de merveilles là-dessous, si on sait où chercher, bien entendu.",
  },
  {
    "key": "blueprint_vendor_01.conversation_3fn5w0_text",
    "notes": "Speaker=Dorothy",
    "value": "Eh bien, c'est une mine après tout. C'est donc logique qu'elle soit pleine de roches précieuses.",
  },
  {
    "key": "blueprint_vendor_01.conversation_npebbg_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Non non non ! Je ne parle pas de ça mais de {format emph}vrais{format reset} trésors ! Des artefacts {image artifacts_small} aussi fascinants qu'étranges.",
  },
  {
    "key": "blueprint_vendor_01.conversation_a7uvtg_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format*",
    "value": "Des choses merveilleuses, avec leurs propres histoires à raconter.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mjgdjr_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added the artifact image to this line and added a more specific wording to point to artifacts",
    "value": "Si tu trouves des artefacts intéressants {image artifacts_small}, aurais-tu la courtoisie de me les montrer ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_uwhgx6_text",
    "notes": "Speaker=Dorothy",
    "value": "Je pense avoir trouvé quelque chose d'intéressant.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iqy08o_text",
    "notes": "Speaker=Dorothy",
    "value": "D'accord, je vais garder ça en tête durant mes explorations.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rppjea_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Formidable !{format reset} Je vais te donner un {format highlight}plan{format reset} si tu me rapportes au moins {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_br857t_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "{format singsong}Joie !{format reset} Pince-moi sans plus attendre, je ne veux pas que ce soit un rêve !",
  },
  {
    "key": "blueprint_vendor_01.conversation_iptdw9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Tu as trouvé l'emplacement du mythique 43ème artefact {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_lu65ll_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "J'ai si souvent rêvé de ça. Ma famille le recherche depuis des générations. Je ne peux pas croire que je vais poser mes yeux dessus.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wu0y6m_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "...",
  },
  {
    "key": "blueprint_vendor_01.conversation_vyiiiz_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Euh...",
  },
  {
    "key": "blueprint_vendor_01.conversation_ds3fs3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "C'est tout ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_kheln9_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "C'est assez médiocre.",
  },
  {
    "key": "blueprint_vendor_01.conversation_axft9i_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "C'est décevant.",
  },
  {
    "key": "blueprint_vendor_01.conversation_66l4aw_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Merci, j'imagine.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6ybt0n_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Je n'ai plus de raison d'être maintenant.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rlfp8l_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Blueprints unlock new upgrades for your equipement. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Splendide !{format reset} Tu as déjà trouvé {var num_artifacts_current} artefacts fascinants {image artifacts_small} !",
  },
  {
    "key": "blueprint_vendor_01.conversation_as6lw7_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* added a version of the above line that is singular artifact. Changed {image artifacts} to {image artifacts_small}",
    "value": "{format singsong}Splendide !{format reset} Tu as trouvé {var num_artifacts_current} artefact fascinant {image artifacts_small} !",
  },
  {
    "key": "blueprint_vendor_01.conversation_p7vtak_text",
    "notes": "Speaker=Davy Bittenborough Notes=*format* removed emph from appreciation",
    "value": "Pour te montrer ma reconnaissance, voici un {format highlight}plan{format reset} de ma collection.",
  },
  {
    "key": "blueprint_vendor_01.conversation_dcphb9_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* "it" refering to the blueprint",
    "value": "Il suffit de l'apporter à l'établi et d'utiliser les bidouillages pour en profiter.",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8lzbu_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* gives the player som info on how many artefacts until next blueprint",
    "value": "Je vais te donner un autre plan si tu me montres {var num_artifacts_threshold} artefacts {image artifacts_small} en tout.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pwaqqk_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Je vois que tu n'as trouvé {format emph}aucun{format reset} artefact fascinant {image artifacts_small} pour le moment, quel dommage.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tm2fum_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Je te donnerai un {format highlight}plan{format reset} si tu me rapportes au moins {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_31n97u_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Eh bien, je vois que tu as trouvé {var num_artifacts_current} joli artefact {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_xkdvzp_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Je te donnerai un {format highlight}plan{format reset} si tu me rapportes au moins {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_vj87ok_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* Changed {image artifacts} to {image artifacts_small}",
    "value": "Oh oui ! Tu as trouvé {var num_artifacts_current} artefacts fascinants {image artifacts_small} !",
  },
  {
    "key": "blueprint_vendor_01.conversation_c12v5z_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Ces merveilles sont cachées un peu partout.",
  },
  {
    "key": "blueprint_vendor_01.conversation_r70wn4_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Mais tu disposes d'un équipement de pointe pour te déplacer avec aise.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ozgox8_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new*",
    "value": "Prends bien soin de regarder dans tous les coins, d'accord ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_crg8xl_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* changed "found" to "if you can show me". Changed {image artifacts} to {image artifacts_small} changed a to another",
    "value": "Je te donnerai un autre plan si tu me montres {var num_artifacts_threshold} {image artifacts_small}.",
  },
  {
    "key": "blueprint_vendor_01.conversation_rkqt88_text",
    "notes": "Speaker=Davy Bittenborough Notes=*new* removed "wonderful" as it conflicted with previous lines in some cases",
    "value": "Tu as bien travaillé ! Je crois que j'ai vu tous les objets fascinants de cette planète.",
  },
  {
    "key": "blueprint_vendor_01.conversation_4ngqs0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "C'est une bonne chose car je n'ai plus aucun plan dans ma collection !",
  },
  {
    "key": "blueprint_vendor_01.conversation_75th6d_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Quand j'étais un jeune bot très actif comme toi, j'avais pour habitude de parcourir cette mine pour faire des jolies cartes.",
  },
  {
    "key": "blueprint_vendor_01.conversation_wvg349_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "J'ai réussi à cartographier toute la zone protégée par le mur, bien avant que mes rotules ne commencent à me jouer des tours.",
  },
  {
    "key": "blueprint_vendor_01.conversation_90qcuc_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "J'ai commencé par les couches inférieures, mais ces soiffards ne sont pas particulièrement coopératifs.",
  },
  {
    "key": "blueprint_vendor_01.conversation_pffrd2_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ces créatures n'ont aucun respect pour le beau. Utiliser des explosifs dans un tel monument ? Quel scandale !",
  },
  {
    "key": "blueprint_vendor_01.conversation_fc5nyv_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Le mur absorbe la majorité des impacts, mais il arrive parfois qu'ils passent tout de même.",
  },
  {
    "key": "blueprint_vendor_01.conversation_219b44_text",
    "notes": "Speaker=Dorothy",
    "value": "As-tu été au temple qui se trouve de l'autre côté des Plaines venteuses ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_0anv7h_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ces ruines sont inexplorées. Le temple est un endroit particulièrement dangereux.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tv8uil_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Mon ancien collègue, Ronald Hubot, est le seul à avoir {format emph}tenté{format reset} de s'y aventurer.",
  },
  {
    "key": "blueprint_vendor_01.conversation_u57vpi_text",
    "notes": "Speaker=Dorothy",
    "value": "Qu'est-ce qui est arrivé ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_g8rvft_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Eh bien, il a apparemment eu une vision cauchemardesque de la fin du monde.",
  },
  {
    "key": "blueprint_vendor_01.conversation_02chim_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Il s'est enfermé dans le temple depuis. S'entourant de bots fous.",
  },
  {
    "key": "blueprint_vendor_01.conversation_i026up_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Je ne peux qu'imaginer les artefacts {image artifacts_small} merveilleux qui sont cachés dans ces ruines.",
  },
  {
    "key": "blueprint_vendor_01.conversation_tvge9q_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Il doit y avoir {format emph}beaucoup{format reset} d'artefacts {image artifacts_small} oubliés dans les profondeurs de la mine.",
  },
  {
    "key": "blueprint_vendor_01.conversation_iyk7r0_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Imagine un peu les reliques de cultures oubliées qui n'attendent que d'être trouvées !",
  },
  {
    "key": "blueprint_vendor_01.conversation_hp4wcb_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "C'est vraiment la meilleure époque pour être en vie ! Il y a bien longtemps qu'aucun bot n'avait réussi à aller si profondément dans la mine.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ekx3en_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Tu devrais aller encore plus profondément. Audentes fortuna juvat, n'est-ce pas ?",
  },
  {
    "key": "blueprint_vendor_01.conversation_bb807w_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Le désert de l'ouest est un endroit brutal et aride... et pourtant des bots y vivent depuis des siècles.",
  },
  {
    "key": "blueprint_vendor_01.conversation_6e53tq_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Je suis persuadé qu'il doit y avoir des merveilles cachées dans cet océan de sable et de cailloux.",
  },
  {
    "key": "blueprint_vendor_01.conversation_ja68cp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "J'aime vraiment les artefacts.",
  },
  {
    "key": "blueprint_vendor_01.conversation_9w2c24_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Normalement, ça prendrait une {format emph}éternité{format reset} à la Terre de changer sa structure géologique.",
  },
  {
    "key": "blueprint_vendor_01.conversation_aactqp_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ces tremblements semblent avoir la capacité de changer la répartition des terres en seulement quelques décennies.",
  },
  {
    "key": "blueprint_vendor_01.conversation_fn5brp_text",
    "notes": "Speaker=Dorothy",
    "value": "Nous nous occupons de ces tremblements.",
  },
  {
    "key": "blueprint_vendor_01.conversation_d0c0zs_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Et si une couche cédait complètement ? Mes cartes deviendraient inutiles ! Ce serait scandaleux !",
  },
  {
    "key": "blueprint_vendor_01.conversation_w56u9v_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Ce dernier tremblement était incroyablement inquiétant.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mcnumi_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Peut-être que Prof. Sherman a raison... Nous allons devoir quitter cette planète.",
  },
  {
    "key": "blueprint_vendor_01.conversation_mq34gi_text",
    "notes": "Speaker=Dorothy",
    "value": "On va tout faire pour qu'on ne soit pas obligés de partir.",
  },
  {
    "key": "blueprint_vendor_01.conversation_h0mzw3_text",
    "notes": "Speaker=Davy Bittenborough",
    "value": "Apprendre à cartographier les étoiles ? Voilà un merveilleux défi !",
  },
  {
    "key": "blueprint_vendor_02.conversation_uyr4r4_text",
    "notes": "Speaker=Clifford Heisenberg Notes=This person id located upp on a trellis with a fantastic view.",
    "value": "Ah, {format singsong}bonjour, chère amie !{format reset} Quelle vue fantastique nous avons ici, n'est-ce pas ? Notre maire est un sacré veinard !",
  },
  {
    "key": "blueprint_vendor_02.conversation_w3sayh_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Mais il devrait tout de même écouter un peu plus la prof. Ces secousses ne vont pas s'arrêter toutes seules !",
  },
  {
    "key": "blueprint_vendor_02.conversation_cww3zx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Le maire n'est pas rentré. Je me demande quand il sera de retour.",
  },
  {
    "key": "blueprint_vendor_02.conversation_0g6nsc_text",
    "notes": "Speaker=Dorothy Notes=*format*",
    "value": "Ce que vous tenez dans les mains, c'est une bombe ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_474v8c_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Enfin quelqu'un pour faire sauter ce bâtiment affreux!",
  },
  {
    "key": "blueprint_vendor_02.conversation_o24esm_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format laugh}Oui !{format reset} Je veux dire, non !",
  },
  {
    "key": "blueprint_vendor_02.conversation_yi4qcu_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed water bomb to pressure bomb",
    "value": "Je voulais montrer au maire Yonker mon nouveau modèle de bombe à pression. C'est exactement ce dont la ville a besoin !",
  },
  {
    "key": "blueprint_vendor_02.conversation_bqmi7g_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Mais... il m'a fait signe de partir et m'a dit de l'apporter à son bureau. Seulement, il n'y a personne ici...",
  },
  {
    "key": "blueprint_vendor_02.conversation_5kay5a_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Enfin, cela ne me dérange pas de patienter ! Je suis sûr que le maire sera bientôt de retour. Sans doute. Peut-être. Plus tard, j'imagine.",
  },
  {
    "key": "blueprint_vendor_02.conversation_73lt57_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Les bombes peuvent servir à beaucoup de choses, vous savez. On peut les utiliser pour {format emph}tout{format reset}. Plus ou moins.",
  },
  {
    "key": "blueprint_vendor_02.conversation_2t4ktx_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "On peut s'en servir pour creuser des tunnels, fendre des roches riches en minéraux, dégager des débris...",
  },
  {
    "key": "blueprint_vendor_02.conversation_tkp0i2_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Sans oublier le simple plaisir d'exploser des trucs !",
  },
  {
    "key": "blueprint_vendor_02.conversation_2ynw9y_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Les mineurs les faisaient détoner autrefois à longueur de journée et de nuit. Oh, ça devait être un régal pour les oreilles !",
  },
  {
    "key": "blueprint_vendor_02.conversation_2vgr7k_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "De belles détonations mortelles !",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nhr7x_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed pressurized water bomb to pressure bomb",
    "value": "J'espère de tout cœur pouvoir présenter au maire mon nouveau modèle de bombe à pression. C'est une solution d'avenir.",
  },
  {
    "key": "blueprint_vendor_02.conversation_gbuars_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "Ce gars a tout compris !",
  },
  {
    "key": "blueprint_vendor_02.conversation_h4evh3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Je suis contente que tu te fasses un ami, mais j'aurais préféré que ce soit pour une autre raison.",
  },
  {
    "key": "blueprint_vendor_02.conversation_v0gx3y_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je suis certain de pouvoir convaincre le maire de la pertinence de mes bombes.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hwchba_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "M. Bittenborough m'a apporté un jour l'enveloppe d'une bombe éclatée. Il affirmait l'avoir trouvée chez les soiffards.",
  },
  {
    "key": "blueprint_vendor_02.conversation_q0vd7o_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "J'en étais malade rien qu'à la voir ! Saviez-vous que les soiffards fabriquent leurs bombes à partir {format nervous}de nitroglycérine et de pousse-café{format reset} ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_shtyfr_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "C'est quoi, le problème ? Elles explosent, non ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_4nsm4v_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Évidemment. En emportant tes doigts, si tu as de la chance !",
  },
  {
    "key": "blueprint_vendor_02.conversation_s7nbis_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed pressurized water bomb to pressure bomb",
    "value": "Non merci ! Je m'en tiens à la sécurité et à la stabilité de mes bombes à pression !",
  },
  {
    "key": "blueprint_vendor_02.conversation_p2i5l7_text",
    "notes": "Speaker=Fen Notes=*format* *new* removed "..."",
    "value": "C'est naze.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ptgzep_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Restez à l'abri en bas. Et méfiez-vous plutôt de ces soiffards.",
  },
  {
    "key": "blueprint_vendor_02.conversation_l8kkmb_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Avez-vous vu la nouvelle fusée de la Prof. Sherman ? C'est une vraie merveille !",
  },
  {
    "key": "blueprint_vendor_02.conversation_9yditf_text",
    "notes": "Speaker=Dorothy Notes=This is Dororthy talking",
    "value": "Ouais, elle est très impressionnante.",
  },
  {
    "key": "blueprint_vendor_02.conversation_b8svck_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Et parfaitement sûre. J'ai participé aux calculs, après tout !",
  },
  {
    "key": "blueprint_vendor_02.conversation_wz8w9f_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Envoyer un tel engin dans l'espace implique une très forte pression, vous savez. Tout doit être calibré avec la plus grande précision, jusqu'au moindre détail !",
  },
  {
    "key": "blueprint_vendor_02.conversation_516qkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Ce que je veux dire c'est que, quand on y réfléchit bien, une fusée n'est qu'une grosse bombe, pas vrai ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8ly6iv_text",
    "notes": "Speaker=Fen Notes=This is Fen talking",
    "value": "J'aime la tournure de la discussion. Et si on allait demander à la prof pour faire un petit tour ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_pawve3_text",
    "notes": "Speaker=Dorothy Notes=This is Dorothy talking",
    "value": "Une autre fois, Fen.",
  },
  {
    "key": "blueprint_vendor_02.conversation_sqkxyn_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Ne vous inquiétez pas. Loin de moi la possibilité de laisser une erreur se glisser quand des bombes sont en jeu !",
  },
  {
    "key": "blueprint_vendor_02.conversation_ha9646_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "J'ai beaucoup réfléchi à ces tremblements de terre. Un tremblement de terre n'est qu'une grande vibration destructrice, pas vrai ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_fs869d_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "{format singsong}Donc...{format reset}, si nous créions une autre vibration {format emph}contraire{format reset} de même taille et de même puissance, les deux devraient s'annuler !",
  },
  {
    "key": "blueprint_vendor_02.conversation_1frwlw_text",
    "notes": "Speaker=Dorothy",
    "value": "Hmm... est-ce que vous suggérez bien ce que j'imagine...?",
  },
  {
    "key": "blueprint_vendor_02.conversation_qd7crv_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Tout à fait ! Fabriquons des bombes ! Tout ce que nous avons à faire est de mettre en place un réseau de bombes synchronisées qui contrera les secousses !",
  },
  {
    "key": "blueprint_vendor_02.conversation_t8xdab_text",
    "notes": "Speaker=Fen",
    "value": "Splendide ! Ce plan est infaillible.",
  },
  {
    "key": "blueprint_vendor_02.conversation_50z3oe_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je suis ravi de vous voir du même avis ! Laissez-moi seulement deux/trois ans pour faire les calculs. La sécurité avant tout !",
  },
  {
    "key": "blueprint_vendor_02.conversation_wdv8yf_text",
    "notes": "Speaker=Fen Notes=*new*",
    "value": "Ouch...",
  },
  {
    "key": "blueprint_vendor_02.conversation_dx83ih_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "J'ai hâte de présenter mon plan au maire Yonker. Je suis certain qu'il sera partant ! Je me demande quand il sera de retour. Cela fait un moment qu'il est parti.",
  },
  {
    "key": "blueprint_vendor_02.conversation_hu5cr9_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je n'aime pas toute cette agitation autour du Grand tremblement de terre. Il y a tant d'inconnues. Quelle en sera l'intensité ? Quand frappera-t-il ? Et où ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_achdi1_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Depuis que l'ascenseur s'est écrasé, je n'arrête pas de penser à ce qui se passera si le séisme {format emph}du millénaire{format reset} éclate.",
  },
  {
    "key": "blueprint_vendor_02.conversation_k2l3ob_text",
    "notes": "Speaker=Dorothy",
    "value": "La Prof. Sherman pense que les choses vont empirer avant qu'il n'y ait le moindre espoir d'amélioration.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ioi3ht_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Tu ferais bien de l'écouter. C'est le robot le plus intelligent de la ville.",
  },
  {
    "key": "blueprint_vendor_02.conversation_5oey6i_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je commence à me dire que le maire ne va pas retourner à son bureau.",
  },
  {
    "key": "blueprint_vendor_02.conversation_xoknkn_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* changed format from laugh to singsong",
    "value": "{format singsong}Oh !{format reset} Serait-ce un... lance-grenade pneumatique ? Oh oui, et le modèle de luxe, qui plus est !",
  },
  {
    "key": "blueprint_vendor_02.conversation_uhq93q_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Serais-tu toi aussi une... amatrice de bombes, ma chère ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_8o8ba8_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Il faut que je te montre mon projet secret ! Ha, je {format nervous}crevais{format reset} d'envie de le montrer à une vraie tête brûlée !",
  },
  {
    "key": "blueprint_vendor_02.conversation_ux8mwy_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new* changed format from highligh to emph",
    "value": "Cette amélioration pour ton lance-grenade est encore en attente de brevet, mais sache qu'elle le rendra d'ores et déjà {format emph}trois fois plus destructeur{format reset} !",
  },
  {
    "key": "blueprint_vendor_02.conversation_4urlt2_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je serais prêt à te la laisser pour un essai pratique, mais... {format singsong}comment diiiiire{format reset}... Mon budget de recherche a été quelque peu tendu dernièrement.",
  },
  {
    "key": "blueprint_vendor_02.conversation_uxln27_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Peut-être que si tu pouvais me laisser une petite contribution, disons de {var pricelist_next:blueprint_vendor_02} \${image money_small}, je pourrais te confier un {format highlight}plan{format reset} exclusif aux primo-financeurs de mon invention. Qu'est-ce que tu en dis ?",
  },
  {
    "key": "blueprint_vendor_02.conversation_dgw94e_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Au fait, est-ce que tu as réfléchi à ce petit don ? Pour à peine {var pricelist_next:blueprint_vendor_02} \${image money_small}, tu feras partie des premiers à essayer ce {format highlight}plan{format reset} exclusif !",
  },
  {
    "key": "blueprint_vendor_02.conversation_20o2j5_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format* *new* split this line up",
    "value": "Fantastique, chère amie ! Tiens, c'est à toi !",
  },
  {
    "key": "blueprint_vendor_02.conversation_52n8bq_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Tu dois l'utiliser à l'établi pour modifier ton canon.",
  },
  {
    "key": "blueprint_vendor_02.conversation_9p7l5p_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*new*",
    "value": "Qu'attends-tu donc ? Pars tout faire sauter autour de toi !",
  },
  {
    "key": "blueprint_vendor_02.conversation_gui6im_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "On dirait que tes finances sont tendues elles aussi, ma chère. Pas de souci ! Reviens me voir quand tu auras de quoi m'aider.",
  },
  {
    "key": "blueprint_vendor_02.conversation_ijkhew_text",
    "notes": "Speaker=Clifford Heisenberg",
    "value": "Je comprends, mon amie. N'hésite pas à revenir si tu changes d'avis.",
  },
  {
    "key": "blueprint_vendor_02.conversation_02qawb_text",
    "notes": "Speaker=Clifford Heisenberg Notes=*format*",
    "value": "Le plan te convient ? Tu as trouvé quelque chose d'intéressant à faire exploser récemment ?",
  },
  {
    "key": "blueprint_vendor_03.conversation_1hq43e_text",
    "notes": "Speaker=Ty Nuzak Notes=This Character is a mail man/pony express person.",
    "value": "Bienvenue à toi camarade. J'ai des difficultés à livrer le courrier à l'heure à cause de ces tremblements.",
  },
  {
    "key": "blueprint_vendor_03.conversation_k6q6hf_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Un de nos coursiers m'a raconté que des trous géants s'ouvrent dans le désert.",
  },
  {
    "key": "blueprint_vendor_03.conversation_ple2sp_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Le désert est devenu encore plus dangereux pour les coursiers.",
  },
  {
    "key": "blueprint_vendor_03.conversation_dum6i9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Je ne peux pas t'aider au sujet de tes livraisons pour l'instant, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qy63x4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Tous nos coursiers sont occupés pour le moment, les pauvres.",
  },
  {
    "key": "blueprint_vendor_03.conversation_4nc6nw_text",
    "notes": "Speaker=Dorothy",
    "value": "Pourquoi n'es-tu pas avec eux ?",
  },
  {
    "key": "blueprint_vendor_03.conversation_aozfk3_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Il n'y a rien de pire pour un {format nervous}claustrophobe{format reset} que de se retrouver dans ces grandes plaines. C'est juste une grande étendue de rien.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opkpi5_text",
    "notes": "Speaker=Ty Nuzak Notes=*format*",
    "value": "Je me sens oppressé rien que d'y penser.",
  },
  {
    "key": "blueprint_vendor_03.conversation_opmgdu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Je me sens oppressé rien que d'y penser.",
  },
  {
    "key": "blueprint_vendor_03.conversation_384qc9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Nos poneys ont parcouru tout le désert. On peut sentir ces secousses de là-bas, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_c3vack_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Ces fichus tremblements sont dangereux pour tous les hameaux au-delà des vieux temples.",
  },
  {
    "key": "blueprint_vendor_03.conversation_alusmw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Nous avons du mal à importer du minerai en sécurité.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5nkkkg_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "La plupart des entreprises de la ville fonctionnent grâce à l'importation de biens.",
  },
  {
    "key": "blueprint_vendor_03.conversation_1u0u2r_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "La Société des Poneys Postaux est la meilleure solution pour acheminer les biens jusqu'en ville.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ufqac_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "La Société des Poneys Postaux a une réputation à maintenir. Je refuse que ces tremblements affectent notre réputation, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_7idj7v_text",
    "notes": "Speaker=Dorothy",
    "value": "Est-ce qu'un de tes poneys a déjà été jusqu'aux temples ?",
  },
  {
    "key": "blueprint_vendor_03.conversation_vfl4c6_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to Ron",
    "value": "Marrant que tu demandes, camarade. On a eu une livraison prioritaire au temple de l'est l'mois dernier.",
  },
  {
    "key": "blueprint_vendor_03.conversation_51nddn_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* changes to phrasing",
    "value": "On a dû faire une course par-delà les Plaines venteuses.",
  },
  {
    "key": "blueprint_vendor_03.conversation_hsitea_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed "pardner".",
    "value": "Laisse-moi t'dire qu'il faut de sacrées pattes pour faire une course avec un tel vent.",
  },
  {
    "key": "blueprint_vendor_03.conversation_g6i2qw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* removed reference to four braziers as this is no longer relevant. Also changed he to they, to make sense with changes above",
    "value": "Ils avaient commandé des vieux braseros et ils voulaient les recevoir pour hier en plus.",
  },
  {
    "key": "blueprint_vendor_03.conversation_j223bu_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Sûrement pour leurs trucs bizarres de culte, s'tu veux mon avis.",
  },
  {
    "key": "blueprint_vendor_03.conversation_p4ogy4_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Quiconque décide de traverser les Plaines venteuses à l'est aura besoin de se protéger des turbulences, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_pgpn5x_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'ai entendu dire que tu avais creusé en profondeur, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_2ir3fn_text",
    "notes": "Speaker=Dorothy",
    "value": "Oui, nous sommes à la recherche de mon ami, il est peut-être là-dessous.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0q9lw_text",
    "notes": "Speaker=Ty Nuzak Notes=*new* doggone to coggone",
    "value": "Parfois j'pense que j'aimerais bien partir d'cette maudite ville et découvrir d'nouveaux endroits.",
  },
  {
    "key": "blueprint_vendor_03.conversation_l0wgkw_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Et voilà que j'entends parler d'une jungle dangereuse dans les profondeurs.",
  },
  {
    "key": "blueprint_vendor_03.conversation_qgwwxu_text",
    "notes": "Speaker=Ty Nuzak Notes=*new*",
    "value": "Je pense à tous les dangers qu'on peut rencontrer là-dessous.",
  },
  {
    "key": "blueprint_vendor_03.conversation_5phwat_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Mon coeur commence à {format nervous}palpiter{format reset} et mes pattes à flageoler.",
  },
  {
    "key": "blueprint_vendor_03.conversation_cp57ox_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Par mes éperons, as-tu déjà vu pire chiffe molle que moi ?",
  },
  {
    "key": "blueprint_vendor_03.conversation_x5lp6f_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'aimerais tellement ne pas être une aussi grosse poule à vapeur. J'aimerais découvrir le monde et ne pas rester planqué ici.",
  },
  {
    "key": "blueprint_vendor_03.conversation_w4by19_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Ces secousses empirent, j'peux sentir mes quatre pattes trembler à l'unisson.",
  },
  {
    "key": "blueprint_vendor_03.conversation_d4gln9_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'crois qu'on devrait se carapater dans la fusée le plus vite possible !",
  },
  {
    "key": "blueprint_vendor_03.conversation_w15szm_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'aime pas trop l'idée d'un ciel ouvert tout autour de moi...",
  },
  {
    "key": "blueprint_vendor_03.conversation_jnag7u_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Mais si la planète explose en petits morceaux, j'n'aurai juste pas l'choix...",
  },
  {
    "key": "blueprint_vendor_03.conversation_oawrk7_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'imagine que j'vais devoir quitter ma zone de confort après tout, camarade.",
  },
  {
    "key": "blueprint_vendor_03.conversation_e1e8ry_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "Mais si la planète explose en petits morceaux, j'n'aurai juste pas l'choix...",
  },
  {
    "key": "blueprint_vendor_03.conversation_cqe4nv_text",
    "notes": "Speaker=Ty Nuzak",
    "value": "J'te demande pardon, camarade, mais j'ai bien peur de ne plus avoir aucun plan en stock !",
  },
  {
    "key": "cultist_worship_rusty.conversation_jm66o2_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "cultist_worship_rusty.conversation_igsxan_text",
    "notes": "Speaker=Dorothy",
    "value": "Est-ce que c'est une {format emph}statue de Rusty{format reset} devant laquelle tu te prosternes ?",
  },
  {
    "key": "cultist_worship_rusty.conversation_1voalp_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Oui... Rusty le Magnifique est le Destructeur qui a été promis.",
  },
  {
    "key": "cultist_worship_rusty.conversation_pd5hzj_text",
    "notes": "Speaker=Cultist Notes=*new* removed reference to Ron and expanded the text format",
    "value": "Cela a été prédit par notre Grand Prophète. Il a vu l'arrivée de la {format singsong}fin divine{format reset}.",
  },
  {
    "key": "cultist_worship_rusty.conversation_y6xyie_text",
    "notes": "Speaker=Fen",
    "value": "Tout est bon à vénérer dans vos têtes, n'est-ce pas ?",
  },
  {
    "key": "cultist_worship_rusty.conversation_e76l4q_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Ô Lumière à suivre ! Cette créature impie t'a prise du Temple de l'Orientation !",
  },
  {
    "key": "cultist_worship_rusty.conversation_qo16zi_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Je vais sacrifier ses pièces dans le feu purificateur !",
  },
  {
    "key": "yonker_01.conversation_mdyvq0_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Coucou ! J'pensais qu'personne {format nervous}allait m'retrouver{format reset}.",
  },
  {
    "key": "yonker_01.conversation_zcgves_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Pas que j'suis perdu hein, juste que c'était pas simple d'arriver ici, t'sais !",
  },
  {
    "key": "yonker_01.conversation_ara3qe_text",
    "notes": "Speaker=Zebulon Yonker Notes="Feels like Ah should give..." is "Feels like I should give..."",
    "value": "J'pense que j'devrais t'donner un p'tit quelque chose ! Tout c'que j'ai c'est c'plan ici.",
  },
  {
    "key": "yonker_01.conversation_2ebftt_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Garde en tête qu'activer celui-ci risque de rendre ton aventure {format danger}plus difficile{format reset}.",
  },
  {
    "key": "yonker_01.conversation_6jeiwp_text",
    "notes": "Speaker=Zebulon Yonker Notes=*NEW*",
    "value": "Tu d'vrais l'utiliser qu'si tu veux un peu plus d'challenge !",
  },
  {
    "key": "yonker_01.conversation_pvpsai_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Pas d'panique, j'suis pas perdu ! J'm'repose un peu c'tout !",
  },
  {
    "key": "yonker_01.conversation_jbfsb5_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Mon p'tit frère est si bête qu'il a scellé l'vieux système d'transport.",
  },
  {
    "key": "yonker_01.conversation_rq43xc_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Il disait qu'c'était dangereux ou quelque chose du genre, j'sais plus trop.",
  },
  {
    "key": "yonker_01.conversation_v4t07d_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Des fois j'pense que tous les "trucs de maire" bloquent la vapeur dans la tête d'mon frère.",
  },
  {
    "key": "yonker_01.conversation_y4mgz6_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "J'sais juste que ces tubes, ils m'manquent bien. Maintenant j'dois marcher jusqu'à la maison.",
  },
  {
    "key": "yonker_01.conversation_9kai6i_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "Ces déserts sont liés à des trucs bizarres, j'te l'dis.",
  },
  {
    "key": "yonker_01.conversation_1hh5hs_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "J'ai vu des cultistes frappés près d'l'entrée du vieux temple.",
  },
  {
    "key": "yonker_01.conversation_vpsiim_text",
    "notes": "Speaker=Zebulon Yonker Notes=*format*",
    "value": "J'comprends pas grand chose d'leurs histoires et des messes bizarres et d'autres trucs.",
  },
  {
    "key": "yonker_01.conversation_efhbif_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "La mine peut changer la tête de n'importe quel mineur, s'il reste trop longtemps là-d'ssous.",
  },
  {
    "key": "yonker_01.conversation_914qie_text",
    "notes": "Speaker=Zebulon Yonker",
    "value": "J'pense que j'va rester encore un p'tit peu. L'travail c'est dur...",
  },
  {
    "key": "yonker_02.conversation_ppa3hq_text",
    "notes": "Speaker=Luke Yonker",
    "value": "{format emph}Fiouu{format reset}, j'croyais que t'étais l'un d'ces {format nervous}maudits soiffards !{format reset}",
  },
  {
    "key": "yonker_02.conversation_rtaarn_text",
    "notes": "Speaker=Luke Yonker",
    "value": "J'sais pas quoi penser de cet endroit, c'est différent de tout c'que j'ai vu avant.",
  },
  {
    "key": "yonker_02.conversation_rqui5d_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ça fait plaisir d'voir un autr' bot dans cet endroit !",
  },
  {
    "key": "yonker_02.conversation_xpaj1a_text",
    "notes": "Speaker=Luke Yonker Notes=Acquiring Blueprints is how you get new upgrade slots for your equipment, not a physical thing, but only expressed in text.",
    "value": "Prends c'plan pour t'remercier d'm'avoir tenu compagnie.",
  },
  {
    "key": "yonker_02.conversation_5zxme4_text",
    "notes": "Speaker=Luke Yonker Notes=*NEW*",
    "value": "Attention toutefois, si tu l'actives, ton aventure sera {format danger}plus difficile{format reset}.",
  },
  {
    "key": "yonker_02.conversation_ncsd4z_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ne l'utilise pas si tu ne veux pas d'un défi supplémentaire !",
  },
  {
    "key": "yonker_02.conversation_yp736j_text",
    "notes": "Speaker=Luke Yonker",
    "value": "R'bonjour l'amie !",
  },
  {
    "key": "yonker_02.conversation_g21tdm_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Mes frères disent qu'ils ont construit l'plupart des murs ici mais c'est pas vrai !",
  },
  {
    "key": "yonker_02.conversation_iehmo4_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ils ont aidé un peu c'est vrai pour les renforcer mais ils étaient là d'puis bien longtemps.",
  },
  {
    "key": "yonker_02.conversation_aytv9n_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Ils sont tellement remplis d'air chaud qu'c'est un miracle qu'ils flottent pas ces deux-là !",
  },
  {
    "key": "yonker_02.conversation_8srkg6_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Si y a un truc que j'sais, c'est qu'il y a toujours un moyen d'contourner ces murs.",
  },
  {
    "key": "yonker_02.conversation_vb6b0a_text",
    "notes": "Speaker=Luke Yonker",
    "value": "J'le jure ! J'ai vu des champignons migrer y a pas longtemps d'ça.",
  },
  {
    "key": "yonker_02.conversation_0yu226_text",
    "notes": "Speaker=Luke Yonker",
    "value": "Combien d'temps tu penses que ça prendrait pour qu'ils atteignent la ville ?",
  },
  {
    "key": "yonker_02.conversation_onpk10_text",
    "notes": "Speaker=Luke Yonker",
    "value": "J'vais juste profiter encore un peu d'la faune et d'la flore avant d'rentrer.",
  },
  {
    "key": "yonker_03.conversation_xfyeov_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Waouh ! J'étais en train d'réparer et d'construire, puis j'me suis rendu compte qu'j'avais oublié mes outils !",
  },
  {
    "key": "yonker_03.conversation_t1bq4v_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Si tu en parles à personne, j'vais te donner c'papier qu'a l'air important.",
  },
  {
    "key": "yonker_03.conversation_odkj11_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Ça va rendre ton aventure un peu plus... {format danger}difficile{format reset}.",
  },
  {
    "key": "yonker_03.conversation_nvlvnn_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Utilise-le si t'aimes le danger !",
  },
  {
    "key": "yonker_03.conversation_ajyl7v_text",
    "notes": "Speaker=Josh Yonker Notes=*NEW*",
    "value": "Oh et euh... faut pas l'dire à mes frères, d'accord ?",
  },
  {
    "key": "yonker_03.conversation_zdkcdy_text",
    "notes": "Speaker=Josh Yonker",
    "value": "J'suis bien content qu'on puisse s'entendre !",
  },
  {
    "key": "yonker_03.conversation_wpy2vc_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Dis pas à mes frères qu'tu m'as trouvé ici, d'accord ?",
  },
  {
    "key": "yonker_03.conversation_0fsp3k_text",
    "notes": "Speaker=Josh Yonker",
    "value": "J'suis un vrai prouf... euh pross... {format emph}expert{format reset} de la construction d'murs, j'te l'dis !",
  },
  {
    "key": "yonker_03.conversation_l2xfyd_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Faudrait juste qu'ces soiffards restent d'leur côté.",
  },
  {
    "key": "yonker_03.conversation_a09h0a_text",
    "notes": "Speaker=Josh Yonker",
    "value": "J'ai pas l'temps d'me promener pour vérifier si y'a des trous partout.",
  },
  {
    "key": "yonker_03.conversation_sy2ct5_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Ça fait longtemps qu'j'ai pas vu d'soiffards. Avant les tremblements, y'en avait partout.",
  },
  {
    "key": "yonker_03.conversation_w8p7tf_text",
    "notes": "Speaker=Josh Yonker",
    "value": "Si mes frères apprennent que j'me suis emmuré, y vont m'taquiner jusqu'à la fin du monde !",
  },
  {
    "key": "sign_red_rock.conversation_rbdoyh_text",
    "notes": "Speaker=Dorothy",
    "value": ""Passage de la Roche Rouge"",
  },
  {
    "key": "fen_on_rocket.conversation_jofluh_text",
    "notes": "Speaker=Fen",
    "value": "Waouh ! Regarde un peu cette zone de crash ! {format singsong}Si ça c'est pas de la glorieuse destruction !{format reset}",
  },
  {
    "key": "fen_on_rocket.conversation_rgfncb_text",
    "notes": "Speaker=Dorothy",
    "value": "J'espère que Prof. Sherman va apporter quelques améliorations majeures au nouveau modèle.",
  },
  {
    "key": "fen_on_rocket.conversation_1mx9ap_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Ah oui, bonne idée, comme ajouter des lasers et ce genre de trucs !",
  },
  {
    "key": "firetemple_boss_intro.conversation_z6izd0_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Qui ose se tenir devant le Grand Prophète du Destructeur ?",
  },
  {
    "key": "firetemple_boss_intro.conversation_cu9az7_text",
    "notes": "Speaker=Fen",
    "value": "Hé ! Je connais ce gars là ! C'est lui qui m'a amené dans l'autre temple.",
  },
  {
    "key": "firetemple_boss_intro.conversation_4ljao8_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Lumière à suivre ! Que fais-tu avec ce bot indigne dans mon temple ?",
  },
  {
    "key": "firetemple_boss_intro.conversation_m8bbt4_text",
    "notes": "Speaker=Dorothy",
    "value": "Où est Rusty ? Qu'est-ce que vous lui {format emph}avez fait ?{format reset}",
  },
  {
    "key": "firetemple_boss_intro.conversation_6jm46x_text",
    "notes": "Speaker=Great Prophet Notes=*new* moved text format to other words.",
    "value": "Comme je l'avais prédit, Rusty le Destructeur va apporter le {format laugh}Grand Tremblement{format reset} et nous libérer de ce bas monde.",
  },
  {
    "key": "firetemple_boss_intro.conversation_mhn5s6_text",
    "notes": "Speaker=Great Prophet Notes=*format*",
    "value": "Il nous a offert un dispositif de la fin du monde ! Et puis il s'en est retourné. Ses voies sont impénétrables.",
  },
  {
    "key": "firetemple_boss_intro.conversation_davhio_text",
    "notes": "Speaker=Dorothy",
    "value": "...",
  },
  {
    "key": "firetemple_boss_intro.conversation_39dqwa_text",
    "notes": "Speaker=Dorothy",
    "value": "Alors je dois désactiver cette machine !",
  },
  {
    "key": "firetemple_boss_intro.conversation_f5igne_text",
    "notes": "Speaker=Fen Notes=*format* removed one of the text formats",
    "value": "Ouais ! Dis-nous où tu as caché cette machine à la noix pour qu'on puisse la {format laugh}faire sauter{format reset}.",
  },
  {
    "key": "firetemple_boss_intro.conversation_t03c7h_text",
    "notes": "Speaker=Great Prophet",
    "value": "Lumière à suivre ! Tu es tombée bien bas. Je ne vais pas te laisser toucher à notre précieuse machine !",
  },
  {
    "key": "firetemple_boss_outro.conversation_5ppdcr_text",
    "notes": "Speaker=Great Prophet",
    "value": "{format nervous}Aaargh !{format reset} Tu ne peux pas stopper le {format laugh}Grand Tremblement.{format reset}",
  },
  {
    "key": "firetemple_boss_outro.conversation_veu3hm_text",
    "notes": "Speaker=Great Prophet",
    "value": "Le dispositif de la fin du monde est encore en sécurité. La fin est {format singsong}proooche !{format reset}",
  },
  {
    "key": "sign_maze_01.conversation_1l6ojp_text",
    "notes": "Speaker=Dorothy Notes=There actually is an illusory wall that the player can go through. This is also a refference to the game Dark Souls, where people could set up signs in other players game-worlds with hints, and it was very common for people to troll other players by saying there is a false wall where there in fact is nothing but a regular wall.s",
    "value": ""Mur illusoire droit devant !"",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_cp9bbp_text",
    "notes": "Speaker=Fen Notes=*new* removed the reference to dooms day device since player might read this before knowing about the device.",
    "value": "Quoi, toujours rien ?",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_p1i3bn_text",
    "notes": "Speaker=Dorothy Notes=*new* changed an I to a We.",
    "value": "On doit allumer {format highlight}tous les braseros{format reset} pour activer ces cristaux.",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_xqev6z_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to reflect that the braziers are close by now, and not spread around the temple.",
    "value": "Ils doivent être quelque part ici !",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_kk5j23_text",
    "notes": "Speaker=Fen Notes=*new* changed the phrasing to be more Fen-like",
    "value": "Ok, mettons-y le feu alors !",
  },
  {
    "key": "fen_4_brazier_not_lit.conversation_4dihd5_text",
    "notes": "Speaker=Fen Notes=*new* changed this to be said by Fen and re-phrased it to fit. Removed the previous player_buddy line to optimize it too. Removed reference to four braziers as this in no longer relevant.",
    "value": "Ouais, t'as toujours pas foutu le feu à ces braseros.",
  },
  {
    "key": "sign_vectron2_1.conversation_7gz2cu_text",
    "notes": "Speaker=Dorothy",
    "value": ""MORT DROIT DEVANT !"",
  },
  {
    "key": "cultist_worship_rusty_intro.conversation_8fufl9_text",
    "notes": "Speaker=Cultist Notes=*format*",
    "value": "Ô Grand Destructeur, la fin doit être proche !",
  },
  {
    "key": "hub_teleporter_blocked.conversation_bj94jz_text",
    "notes": "Speaker=Fen",
    "value": "Pourquoi tu restes plantée là ? Allez !",
  },
  {
    "key": "hub_teleporter_blocked.conversation_i7wge8_text",
    "notes": "Speaker=Dorothy Notes=*new* made it clear that it's only the pipe to the oasis that is closed",
    "value": "C'est étrange, ce tube à destination de l'Oasis ne fonctionne pas !",
  },
  {
    "key": "hub_teleporter_blocked.conversation_t6jhkm_text",
    "notes": "Speaker=Fen Notes=*new* now said by Fen instead of Dorothy. Changed this to work with thne",
    "value": "De plus en plus étrange. Peut-être que le système est bouché de ce côté ?",
  },
  {
    "key": "hub_teleporter_blocked.conversation_kbmx5q_text",
    "notes": "Speaker=Dorothy Notes=*new* now said by Dorothy instead of Fen. Changed this to work with the changes on above line",
    "value": "Il va juste falloir déboucher totalement pour pouvoir repartir.",
  },
  {
    "key": "hub_teleporter_blocked.conversation_dhpyma_text",
    "notes": "Speaker=Dorothy Notes=*new* changed this to not refert to whole tube system",
    "value": "Le tube à destination de l'Oasis ne fonctionne toujours pas !",
  },
  {
    "key": "hub_teleporter_blocked.conversation_xdvi4z_text",
    "notes": "Speaker=Fen Notes=*new* added a "come on then,"",
    "value": "Alors cherchons {format highlight}un autre moyen d'entrer dans l'Oasis.{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_efpvk6_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Tu... tu es revenue !",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xs0zex_text",
    "notes": "Speaker=Dorothy",
    "value": "Oui, je ne sais pas comment je suis sortie, mais je t'ai dit que j'allais revenir !",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_2gp05g_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "J'étais seul à nouveau... bloqué. J'ai dû... J'ai dû m'endormir.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_v8dyjq_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "J'ai rêvé de...quelque chose... quelque chose dont je voulais te parler.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_xvqfeq_text",
    "notes": "Speaker=Fen",
    "value": "Ça a à voir avec les tremblements, le flux de puissance et... et les machines...",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_6uvdlp_text",
    "notes": "Speaker=Fen Notes=*new* changed format from nervous to emph",
    "value": "{format emph}Dorothy !{format reset}",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_x1cve3_text",
    "notes": "Speaker=Dorothy",
    "value": "Qu'est-ce qu'il y a Fen, qu'est-ce que tu as vu ?",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_c268na_text",
    "notes": "Speaker=Fen",
    "value": "J'ai vu... non... j'ai senti... j'ai senti la présence de plus de dispositifs de la fin du monde.",
  },
  {
    "key": "exiting_vectron_firsttime_03.conversation_glw2u1_text",
    "notes": "Speaker=Dorothy Notes=*new* added the phrase "come on" at the start of the line.",
    "value": "Nous devons {format highlight}le dire à Rosie{format reset}. On n'en a pas encore terminé avec ces tremblements.",
  },
  {
    "key": "temple_generator_destroyed.conversation_vduxpt_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hé hé hé...{format reset} c'était super !",
  },
  {
    "key": "temple_generator_destroyed.conversation_bez5tc_text",
    "notes": "Speaker=Dorothy",
    "value": "Oui, ça a l'air plutôt sans danger maintenant, non ?",
  },
  {
    "key": "temple_generator_destroyed.conversation_02t7hw_text",
    "notes": "Speaker=Dorothy",
    "value": "Il y a des pièces de vapbots et Vectron combinées dans cette chose.",
  },
  {
    "key": "temple_generator_destroyed.conversation_nloh4y_text",
    "notes": "Speaker=Dorothy",
    "value": "Pourquoi Rusty aurait-il construit une chose pareille ?",
  },
  {
    "key": "temple_generator_destroyed.conversation_uo5vst_text",
    "notes": "Speaker=Fen Notes=*format*",
    "value": "Tu te fais trop de soucis. Moins de réflexion, plus d'explosions !",
  },
  {
    "key": "temple_generator_destroyed.conversation_cqegx4_text",
    "notes": "Speaker=Dorothy",
    "value": "Nous devrions {format highlight}retourner à l'Oasis{format reset} pour dire à Rosie que la machine est désactivée.",
  },
  {
    "key": "last_generator_destroyed.conversation_o7pn77_text",
    "notes": "Speaker=Dorothy",
