  },
  {
    "key": "menu_options_input_talk_to_buddy_desc",
    "value": "Parle avec ton compagnon à certaines occasions.",
  },
  {
    "key": "menu_options_input_skip",
    "value": "Passer",
  },
  {
    "key": "menu_options_input_skip_desc",
    "value": "Appuie deux fois pour passer les conversations et certaines scènes, comme par exemple lorsque tu vends des minerais.",
  },
  {
    "key": "menu_options_input_tool_pickaxe",
    "value": "Utiliser Pioche",
  },
  {
    "key": "menu_options_input_tool_pickaxe_desc",
    "value": "Utilise la pioche.",
  },
  {
    "key": "menu_options_input_tool_pressurebomb",
    "value": "Utiliser Bombe à pression",
