  {
    "key": "cutscene_fen_04.conversation_34h62o_text",
    "notes": "Speaker=Fen",
    "value": "{format laugh}Hé hé hé !{format reset} On dirait que tu as besoin de mon aide !",
  },
  {
    "key": "cutscene_fen_04.conversation_de9yap_text",
    "notes": "Speaker=Fen",
    "value": "J'ai déjà cartographié cette zone, {format emph}j'imagine{format reset} que je peux te laisser utiliser ma carte.",
