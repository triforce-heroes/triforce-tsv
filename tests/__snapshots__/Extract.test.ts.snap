  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_desc",
    "value": "Erlaubt es dir, während des Fluges Druckbomben zu verwenden. Achte auf den nötigen Sicherheitsabstand!",
  },
  {
    "key": "upgrades.upgrade_pressurebomb_air_bomb_flavor",
    "value": ""Mach es wie der mächtige Spat – erhebe dich in die Lüfte und lasse es regnen."",
  },
  {
    "key": "upgrades.upgrade_jackhammer",
    "value": "Presslufthammer",
  },
  {
    "key": "upgrades.upgrade_jackhammer_desc",
    "value": "Ein bemerkenswertes Werkzeug, um harte Materialien zu zerbrechen, ist jedoch ineffektiv gegen Gegner. Benötigt Wasser. Halte {indicator tool_jackhammer} gedrückt, um richtig Dampf zu machen!",
  },
  {
    "key": "upgrades.upgrade_jackhammer_next_level_desc",
    "value": "Verbessere den Presslufthammer, um seine Effizienz beim Graben zu erhöhen.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_01",
    "notes": "Pun on Peter Gabriels song Sledgehammer",
    "value": "Gabriels Hammer",
  },
  {
    "key": "upgrades.upgrade_jackhammer_01_desc",
    "notes": "Pun on Peter Gabriels song Sledgehammer - I want to be your sledgehammer",
    "value": ""Er möchte dein ganz persönlicher Presslufthammer sein!"",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02",
    "notes": "Titans=Mythological adversaries to the gods",
    "value": "Bohrer der Titanen",
  },
  {
    "key": "upgrades.upgrade_jackhammer_02_desc",
    "notes": "Removed MC Hammer reference",
    "value": ""Verbesserte Effizienz bedeutet weniger Verbrauch bei gesteigertem Abbauvolumen."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03",
    "notes": "From Rocky 4 - Character Ivan Drago",
    "value": "Der "Ivan Drago" Nr. IV",
  },
  {
    "key": "upgrades.upgrade_jackhammer_03_desc",
    "notes": "His signature phrase "I must break you"",
    "value": ""Die Spitze wurde mit Wolframcarbid verstärkt und hat richtig Wumms. Schnapp dir 'n Ivan Drago!"",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04",
    "notes": "In norse mythology Mjölnir is the hammer of the mighty Thor",
    "value": "Mjöllnir-Kraftpaket",
  },
  {
    "key": "upgrades.upgrade_jackhammer_04_desc",
    "value": ""Kosmos und Chaos ziehen dich in ihren Bann."",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water",
    "notes": "Jab - to punch NOT CURRENTLY USED",
    "value": "Trockenlager",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_desc",
    "notes": "NOT CURRENTLY USED",
    "value": "Der Wasserverbrauch wird um die Hälfte reduziert.",
  },
  {
    "key": "upgrades.upgrade_jackhammer_improved_water_flavor",
    "notes": "NOT CURRENTLY USED",
    "value": ""Ziemlich heiß, aber die trockene Art von Hitze."",
