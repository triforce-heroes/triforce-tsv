  {
    "key": "upgrade_broken_lamp_next_level_desc",
    "value": "Ripara la lampada per poter entrare nella miniera.",
  },
  {
    "key": "upgrade_lamp_desc",
    "value": "Illumina l'area intorno a te. Consuma carburante nel tempo, di cui si può far rifornimento in città.",
  },
  {
    "key": "upgrade_lamp_next_level_desc",
    "value": "Potenzia la lampada per ridurre il consumo di carburante.",
  },
  {
    "key": "upgrade_lamp_01",
    "metadata": {
      "raw": "Rock bottom, as in the lowest value. To hit rock bottom, etc.",
    },
    "value": "Lampada di Scarsa Qualità",
  },
  {
    "key": "upgrade_lamp_01_desc",
    "value": ""Non è rotta, perlomeno."",
  },
  {
    "key": "upgrade_lamp_02",
    "value": "Luce del Minatore",
  },
  {
    "key": "upgrade_lamp_02_desc",
    "value": ""Una combustione più economica."",
  },
  {
    "key": "upgrade_lamp_03",
    "value": "Lampada a Carburo Modificata",
  },
  {
    "key": "upgrade_lamp_03_desc",
    "value": ""Una fiamma migliore grazie a un controllo del flusso ottimizzato."",
  },
  {
    "key": "upgrade_lamp_04",
    "value": "Stella Polare",
  },
  {
    "key": "upgrade_lamp_04_desc",
    "metadata": {
      "raw": "Rudolf the Red nose reindeer – lyrics pun.",
    },
    "value": ""C'era una stella che danzava, e sotto quella sono nata."",
  },
  {
    "key": "upgrade_lamp_05",
    "value": "Lanterna",
  },
  {
    "key": "upgrade_lamp_05_desc",
    "metadata": {
      "raw": "Green Lantern pun – Green lantern inaguration text.",
    },
    "value": ""Nel giorno più splendente, nella notte più profonda, nessun metallo sfugga alla mia ronda."",
  },
  {
    "key": "upgrade_lamp_06",
    "metadata": {
      "raw": "The Alexandrian Lighthouse",
    },
    "value": "Luce di Pharos",
  },
  {
    "key": "upgrade_lamp_06_desc",
    "value": ""Rinforzato con piombo colato per resistere alla prova del tempo."",
  },
  {
    "key": "upgrade_lamp_07",
    "metadata": {
      "raw": "*NEW* Name meaning "Unconquered Sun", Official sun god of the later Roman Empire and also reference to Emperor Constantines old roman coins with inscription SOL INVICTO COMITI = Commited to the Invincible Sun",
    },
    "value": "Sol Invictus",
  },
  {
    "key": "upgrade_lamp_07_desc",
    "value": ""Inginocchiati davanti al potere del Sole Invincibile, o almeno fai buon uso del fascio di luce più ampio."",
  },
  {
    "key": "upgrade_lamp_increased_area_01",
    "metadata": {
      "raw": "Backstreet Boys pun, lyrics from """Larger than Life""" too for flare.",
    },
    "value": "Luce del Cammino",
  },
  {
    "key": "upgrade_lamp_increased_area_01_desc",
    "value": "Aumenta l'ampiezza della luce della tua lampada.",
  },
  {
    "key": "upgrade_lamp_increased_area_01_flavor",
    "metadata": {
      "raw": "Backstreet Boys pun, lyrics from "Larger than Life" too for flare.",
    },
    "value": ""Luce Cammina con Me."",
  },
  {
    "key": "upgrade_lamp_light_pickup_01",
    "value": "Evocatore",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Aggiunge la possibilità di rilascio di un globo di luce extra dai nemici sconfitti.",
  },
  {
    "key": "upgrade_lamp_light_pickup_01_flavor",
    "value": ""Libera il loro sole interiore."",
  },
  {
    "key": "upgrade_lamp_infinite_light_01",
    "metadata": {
      "raw": "Movie Eternal Sunshine on the spotless mind.",
    },
    "value": "Eterno Fulgore",
  },
  {
    "key": "upgrade_lamp_infinite_light_01_desc",
    "value": "Impedisce alla tua luce di andare al di sotto del 50%%.",
  },
  {
    "key": "upgrade_lamp_infinite_light_01_flavor",
    "value": ""Non sarai mai solo nell'oscurità."",
  },
  {
    "key": "upgrade_lamp_damaging_light_01",
    "metadata": {
      "raw": "Song: I am the God of hellfire by Arthur Brown*NOT CURRENTLY USED*",
    },
    "value": "Ingranaggio Infernale",
  },
  {
    "key": "upgrade_lamp_damaging_light_01_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Infligge danni ai nemici all'interno della tua luce.",
  },
  {
    "key": "upgrade_lamp_damaging_light_01_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": ""Scatenate l'inferno!"",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01",
    "metadata": {
      "raw": " Kubera – Hindu Mythology Lord of Wealth, Quote is from Thomas Aquinas",
    },
    "value": "Fiamma di Kubera",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01_desc",
    "value": "Fa sì che gli oggetti emettano luce, rendendoli più facili da trovare.",
  },
  {
    "key": "upgrade_lamp_lit_pickups_01_flavor",
    "value": ""È meglio illuminare che brillare per sé stessi."",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes",
    "metadata": {
      "raw": " Gordon is a reference to character Flash Gordon and particularily important is the ""Flash"" part which is referencing this upgrade being for the light."",
    },
    "value": "Riflessi di Gordon",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes_desc",
    "value": "Aumenta la possibilità di evitare automaticamente le rocce che cadono e altre trappole mortali simili.",
  },
  {
    "key": "upgrade_lamp_lightning_reflexes_flavor",
    "metadata": {
      "raw": "*NEW* Quote is a reference to Queen Song "Flash" and the lyrics- He save with a mighty hand every man, every woman every child, with a mighty Flash",
    },
    "value": ""Salvati in un flash!"",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness",
    "metadata": {
      "raw": " Text from Pink Floyd's song Another brick in the wall: We don't need no education ,We don't need no thought control, All in all you're just another brick in the wall . Quote by Joseph Ford Newton regarding intolerans, hate and not enough love in the world.",
    },
    "value": "Occhio per i dettagli",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness_desc",
    "value": "Ti permette di vedere le parti deboli di un muro quando lo illumini. Parlare al muro non serve, basta guardarlo.",
  },
  {
    "key": "upgrade_lamp_eye_for_weakness_flavor",
    "value": ""Gli uomini costruiscono troppi muri e troppi pochi ponti."",
  },
  {
    "key": "upgrade_pickaxe",
    "value": "Piccone",
  },
  {
    "key": "upgrade_pickaxe_desc",
    "value": "L'attrezzo principale usato da Dorothy per scavare.",
  },
  {
    "key": "upgrade_pickaxe_next_level_desc",
    "metadata": {
      "raw": " This means that whatever you hit, you'll need to hit it two times less when you equip this cog in your Pickaxe",
    },
    "value": "Potenzia il piccone per migliorarne l'efficacia.",
  },
  {
    "key": "upgrade_pickaxe_01",
    "metadata": {
      "raw": "it's rusty",
    },
    "value": "Piccone Arrugginito",
  },
  {
    "key": "upgrade_pickaxe_01_desc",
    "value": ""Ha fatto il suo tempo, senza dubbio."",
  },
  {
    "key": "upgrade_pickaxe_02",
    "value": "Classico Piccone di Ferro",
  },
  {
    "key": "upgrade_pickaxe_02_desc",
    "value": ""L'attrezzo di base di un minatore."",
  },
  {
    "key": "upgrade_pickaxe_03",
    "metadata": {
      "raw": " Bardur is an Icelandic half-troll half-man from their mythology.",
    },
    "value": "Piccone con Impugnatura di Bardur",
  },
  {
    "key": "upgrade_pickaxe_03_desc",
    "value": ""Un compagno semplice ma robusto."",
  },
  {
    "key": "upgrade_pickaxe_04",
    "metadata": {
      "raw": "Pun on Pikachu",
    },
    "value": "Piccon-chu",
  },
  {
    "key": "upgrade_pickaxe_04_desc",
    "metadata": {
      "raw": "Based on the old Japanese Cho measuring system, cho, an ancient Japanese unit of length approximately equal to 109.1 meters",
    },
    "value": ""Accuratamente calibrato con un tradizionale sistema di misura giapponese."",
  },
  {
    "key": "upgrade_pickaxe_05",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Piccone in Lega d'Acciaio",
  },
  {
    "key": "upgrade_pickaxe_05_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Questo trattamento al carbonio brevettato dona ai tuoi colpi un magnifico equilibrio."",
  },
  {
    "key": "upgrade_pickaxe_06",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Piccone in Tungsteno",
  },
  {
    "key": "upgrade_pickaxe_06_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""La densità e la robustezza perfetta per la migliore esperienza di scavo."",
  },
  {
    "key": "upgrade_pickaxe_07",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Piccone dell'Arido Nord",
  },
  {
    "key": "upgrade_pickaxe_07_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Più durevole ed efficace. Proprio ciò che serve per l'arido Nord."",
  },
  {
    "key": "upgrade_pickaxe_08",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": "Piccone dei Templari",
  },
  {
    "key": "upgrade_pickaxe_08_desc",
    "metadata": {
      "raw": " Reordered some names",
    },
    "value": ""Bilanciato alla perfezione. Sembra quasi che scavi da solo."",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01",
    "metadata": {
      "raw": "This is an upgrade for the pickaxe",
    },
    "value": "Punta Affilata",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01_desc",
    "value": "Infligge danni extra ai nemici.",
  },
  {
    "key": "upgrade_pickaxe_enemy_damage_01_flavor",
    "metadata": {
      "raw": "From song The first cut is the deepest.",
    },
    "value": ""Il primo colpo non si scorda mai."",
  },
  {
    "key": "upgrade_pickaxe_speed_01",
    "metadata": {
      "raw": "Pun on movie title Midnight Express",
    },
    "value": "Scheggia Come un Scheggia",
  },
  {
    "key": "upgrade_pickaxe_speed_01_desc",
    "metadata": {
      "raw": " new: minor rephasing",
    },
    "value": "Un assetto aerodinamico migliorato per velocizzare i tuoi colpi.",
  },
  {
    "key": "upgrade_pickaxe_speed_01_flavor",
    "metadata": {
      "raw": "Old Duke Ellington song.",
    },
    "value": ""Si vive e si muore alla velocità della luce!"",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01",
    "value": "Delirio di Risorse",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01_desc",
    "value": "Infligge danni extra alle mattonelle che contengono risorse.",
  },
  {
    "key": "upgrade_pickaxe_resource_damage_01_flavor",
    "metadata": {
      "raw": "Spoof on Patrik Swayzee line from Roadhouse: My way or the highway",
    },
    "value": ""Le mattonelle non sono quello che sembrano."",
  },
  {
    "key": "upgrade_pickaxe_knockback_01",
    "metadata": {
      "raw": "Movie Total Recall",
    },
    "value": "Impatto Imminente",
  },
  {
    "key": "upgrade_pickaxe_knockback_01_desc",
    "value": "Respinge ulteriormente i nemici all'impatto.",
  },
  {
    "key": "upgrade_pickaxe_knockback_01_flavor",
    "metadata": {
      "raw": "Arnold Schwartzenegger quote from T2",
    },
    "value": ""Hasta la vista, baby."",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01",
    "value": "Rispediti al Mittente",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing.",
    },
    "value": "Ti permette di colpire i proiettili a mezz'aria e invertirne la direzione.",
  },
  {
    "key": "upgrade_pickaxe_deflect_projectiles_01_flavor",
    "value": ""C'è posta per te."",
  },
  {
    "key": "upgrade_pickaxe_fire",
    "value": "Ascia di Fuoco",
  },
  {
    "key": "upgrade_pickaxe_fire_desc",
    "value": "Aggiunge fuoco, portata ed efficacia al tuo fedele piccone. Potrebbe avere anche altri utilizzi...",
  },
  {
    "key": "upgrade_pickaxe_fire_flavor",
    "value": ""Alziamo la temperatura!"",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp",
    "value": "Punta del Cacciatore",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp_desc",
    "value": "Ottieni 5 PE extra quando sconfiggi i nemici con il piccone.",
  },
  {
    "key": "upgrade_pickaxe_bonus_xp_flavor",
    "metadata": {
      "raw": " Old Ghanaian proverb meaning that the hunter didn't get anything that he hunted so instead he picked mushrooms, but telling him that might hurt his feelings",
    },
    "value": ""Se il cacciatore torna a casa con i funghi, non chiedergli come è andata la caccia."",
  },
  {
    "key": "upgrade_pickaxe_bounty",
    "value": "Cacciatore di Taglie",
  },
  {
    "key": "upgrade_pickaxe_bounty_desc",
    "value": "Ottieni un premio in denaro quando sconfiggi i nemici con il piccone.",
  },
  {
    "key": "upgrade_pickaxe_bounty_flavor",
    "value": ""C'è chi lo fa per soldi, e chi per il gusto di cacciare."",
  },
  {
    "key": "upgrade_pickaxe_health_pickup",
    "value": "Guaritore",
  },
  {
    "key": "upgrade_pickaxe_health_pickup_desc",
    "value": "Aggiunge la possibilità di rilascio di un globo di salute extra dai nemici sconfitti.",
  },
  {
    "key": "upgrade_pickaxe_health_pickup_flavor",
    "metadata": {
      "raw": "*NEW* Marvin Gaye song "sexual healing"",
    },
    "value": ""Prenditi cura di me."",
  },
  {
    "key": "upgrade_backpack",
    "value": "Zaino",
  },
  {
    "key": "upgrade_backpack_desc",
    "value": "Contiene i minerali e le gemme che trovi.",
  },
  {
    "key": "upgrade_backpack_next_level_desc",
    "value": "Migliora il tuo zaino per ottenere uno slot extra per minerali e gemme.",
  },
  {
    "key": "upgrade_backpack_01",
    "value": "Sacca del Minatore",
  },
  {
    "key": "upgrade_backpack_01_desc",
    "value": ""Non molto grande, ma può contenere diversi tipi di minerali e gemme."",
  },
  {
    "key": "upgrade_backpack_02",
    "value": "Sacca in Pelle di Puzzola",
  },
  {
    "key": "upgrade_backpack_02_desc",
    "metadata": {
      "raw": "Pun on Shakespeare play "Taming of the shrew"",
    },
    "value": ""Catturare le puzzole senza subirne le conseguenze è un'operazione delicata, per questo non è facile da trovare."",
  },
  {
    "key": "upgrade_backpack_03",
    "value": "Borsa Porta-tutto",
  },
  {
    "key": "upgrade_backpack_03_desc",
    "value": ""Il nome dice tutto. Non serve aggiungere altro."",
  },
  {
    "key": "upgrade_backpack_04",
    "metadata": {
      "raw": " Pun on the lost epic of ancient Greek litterature, The Sack of Troy",
    },
    "value": "Sacco di Troia",
  },
  {
    "key": "upgrade_backpack_04_desc",
    "metadata": {
      "raw": " Pun on Achillean heel,expression meaning where your weakness is",
    },
    "value": ""Se cercavi una borsa di qualità, sei a cavallo."",
  },
  {
    "key": "upgrade_backpack_05",
    "metadata": {
      "raw": "Pun on the old "I can't believe it's not butter" https://en.wikipedia.org/wiki/I_Can%27t_Believe_It%27s_Not_Butter!",
    },
    "value": "Borsa delle Brame",
  },
  {
    "key": "upgrade_backpack_05_desc",
    "metadata": {
      "raw": "When re-released the product had an additional line on the package - Good on everything.",
    },
    "value": ""La più capiente del reame!"",
  },
  {
    "key": "upgrade_backpack_06",
    "value": "Sacca Gremlin",
  },
  {
    "key": "upgrade_backpack_06_desc",
    "metadata": {
      "raw": " A pun on the creatures Gremlins from movie Gremlins. They get evil if they eat after midnight.",
    },
    "value": ""Passata la mezzanotte, tienila lontano dal cibo."",
  },
  {
    "key": "upgrade_backpack_07",
    "metadata": {
      "raw": "Elves like Legolas from Lord of The rings",
    },
    "value": "Borsa Elfica",
  },
  {
    "key": "upgrade_backpack_07_desc",
    "metadata": {
      "raw": "Pun on Legolas quote: let a ploughman plough, but choose an otter for swimming, and for running light over grass and leaf, or over snow--an Elf.",
    },
    "value": ""Fate arare il campo al coltivatore, ma scegliete una lontra per nuotare, e per correre veloce su erbe e foglie... una borsa."",
  },
  {
    "key": "upgrade_backpack_08",
    "metadata": {
      "raw": "Lord of the Rings pun - One ring to tame them all.",
    },
    "value": "Una Borsa per Ghermirli",
  },
  {
    "key": "upgrade_backpack_08_desc",
    "value": ""Non è fantastico sentire le stesse battute riciclate in tutti i modi? La borsa ti piacerà, comunque. Davvero."",
  },
  {
    "key": "upgrade_backpack_09",
    "metadata": {
      "raw": " The big and extinct Elephant-like creature.",
    },
    "value": "Borsa del Mammut",
  },
  {
    "key": "upgrade_backpack_09_desc",
    "value": ""Lanosa e capiente."",
  },
  {
    "key": "upgrade_backpack_10",
    "metadata": {
      "raw": "Pun on the Hindu Scripture Bhagavad Gita https://en.wikipedia.org/wiki/Bhagavad_Gita",
    },
    "value": "Borsa Shiva",
  },
  {
    "key": "upgrade_backpack_10_desc",
    "metadata": {
      "raw": "sanskrit vedanta – vedan't ya? Hinduism - Hindsight",
    },
    "value": ""Una borsa di proporzioni mitologiche. Non indù-giare, riempila delle ricchezze più pregiate."",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01",
    "value": "Separatore Magnetico",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Le risorse esposte verranno attirate verso di te.",
  },
  {
    "key": "upgrade_backpack_magnetic_pull_01_flavor",
    "metadata": {
      "raw": "Harry Potter pun on spell accio = fetch",
    },
    "value": ""Accio!"",
  },
  {
    "key": "upgrade_backpack_extra_ore_01",
    "metadata": {
      "raw": " Norse God Freyr owned a ship that he could fold into his pocket when not needed",
    },
    "value": "Tasca di Freyr",
  },
  {
    "key": "upgrade_backpack_extra_ore_01_desc",
    "value": "Ti permette di aggiungere un pezzo di minerale extra per ciascuno slot.",
  },
  {
    "key": "upgrade_backpack_extra_ore_01_flavor",
    "metadata": {
      "raw": " Taken from norse mythology, The books of Snorri, The prose Edda, The poetic Edda.",
    },
    "value": ""Prosaica, poetica, elegante."",
  },
  {
    "key": "upgrade_backpack_extra_gem_01",
    "value": "Doppio Deposito",
  },
  {
    "key": "upgrade_backpack_extra_gem_01_desc",
    "metadata": {
      "raw": " new: rephrasing",
    },
    "value": "Ciascuno slot può contenere due gemme.",
  },
  {
    "key": "upgrade_backpack_extra_gem_01_flavor",
    "value": ""Nella borsa piccola c'è il profitto buono."",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01",
    "value": "Incentivo per lo smaltimento",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01_desc",
    "value": "Scartando una risorsa otterrai anche una parte del suo valore in denaro.",
  },
  {
    "key": "upgrade_backpack_discard_give_money_01_flavor",
    "metadata": {
      "raw": "Lyrics From Sades song Smooth Operator",
    },
    "value": ""Non vedi che è un vero affare? Non perdere l'occasione."",
  },
  {
    "key": "upgrade_backpack_discard_give_health",
    "metadata": {
      "raw": " Pun on Elton john song circle of life meaning that everything goes around and comes back to life – from song circle of life, Recycle the present is just a quote on how recycling today will make the future a better place.",
    },
    "value": "Il Cerchio della Vita",
  },
  {
    "key": "upgrade_backpack_discard_give_health_desc",
    "value": "Scartando una risorsa ripristini una parte della tua salute. Scartando una gemma recuperi più salute che scartando un minerale.",
  },
  {
    "key": "upgrade_backpack_discard_give_health_flavor",
    "value": ""Ricicla il presente, salva il futuro."",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01",
    "value": "Lo Sconto del Mietitore",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Ti permette di perdere meno risorse quando muori.",
  },
  {
    "key": "upgrade_backpack_lower_death_penalty_01_flavor",
    "metadata": {
      "raw": "Blue Öyster Cult cult classic song Don't fear the reaper",
    },
    "value": ""La morte ti fa più bella."",
  },
  {
    "key": "upgrade_backpack_town_portal",
    "value": "Portale del Perdono",
  },
  {
    "key": "upgrade_backpack_town_portal_desc",
    "metadata": {
      "raw": "El Machino is the name of the city",
    },
    "value": "Ti permette di tornare subito a El Machino senza perdere risorse. Attiva questa abilità nella scheda Sistema.\\n\\n{format bold}Disattivata nelle caverne e quando sei in pericolo. L'icona dell'abilità {image town_portal_small} ti mostra quando può essere usata.{format reset}",
  },
  {
    "key": "upgrade_backpack_town_portal_flavor",
    "value": ""Puoi tenere ciò che è tuo."",
  },
  {
    "key": "upgrade_backpack_double_resources",
    "metadata": {
      "raw": "Famous Internet meme Double Rainbow https://www.youtube.com/watch?v=OQSNhk5ICTI",
    },
    "value": "Scava e Raddoppia",
  },
  {
    "key": "upgrade_backpack_double_resources_desc",
    "metadata": {
      "raw": "new: minor rephrasing",
    },
    "value": "Aggiunge la possibilità di ottenere due risorse da una singola mattonella.",
  },
  {
    "key": "upgrade_backpack_double_resources_flavor",
    "metadata": {
      "raw": "From meme double rainbow",
    },
    "value": ""Allegria!"",
  },
  {
    "key": "upgrade_backpack_pickup_money",
    "value": "Soldi Facili",
  },
  {
    "key": "upgrade_backpack_pickup_money_desc",
    "value": "Ti permette di ottenere denaro istantaneamente quando raccogli risorse di basso valore. Più il valore è basso, più soldi guadagni. Non funziona con le risorse di valore superiore a $7.",
  },
  {
    "key": "upgrade_backpack_pickup_money_flavor",
    "metadata": {
      "raw": " Quote from Tolkiens books, character Samwise Gamgee's line: It's like in the great stories, Mr. Frodo, the ones that really mattered.",
    },
    "value": ""Ti aspettano lì, devi solo andare a prenderli."",
  },
  {
    "key": "upgrade_backpack_extra_value",
    "metadata": {
      "raw": "Pun on Bruce Willis Line in Die Hard, yippie ki-yay combined with yuppie as in newly rich person that makes money",
    },
    "value": "Fiuto per gli affari",
  },
  {
    "key": "upgrade_backpack_extra_value_desc",
    "value": "Ottieni il 30%% di denaro in più quando vendi le risorse.",
  },
  {
    "key": "upgrade_backpack_extra_value_flavor",
    "metadata": {
      "raw": "From Internet meme: http://knowyourmeme.com/memes/it-prints-money",
    },
    "value": ""Non c'è nobiltà nella povertà."",
  },
  {
    "key": "upgrade_armor",
    "value": "Armatura",
  },
  {
    "key": "upgrade_armor_desc",
    "value": "L'armatura ti protegge dai pericoli delle profondità.",
  },
  {
    "key": "upgrade_armor_next_level_desc",
    "value": "Potenzia l'armatura per incrementare la tua salute totale.",
  },
  {
    "key": "upgrade_armor_01",
    "value": "Armatura a Piastre",
  },
  {
    "key": "upgrade_armor_01_desc",
    "value": ""Armatura protettiva di base. Niente di speciale."",
  },
  {
    "key": "upgrade_armor_02",
    "value": "Armatura Robusta",
  },
  {
    "key": "upgrade_armor_02_desc",
    "value": ""Più robusta del modello di base, ma sempre della stessa fascia."",
  },
  {
    "key": "upgrade_armor_03",
    "value": "Armatura Rinforzata",
  },
  {
    "key": "upgrade_armor_03_desc",
    "value": ""Fornisce un'ottima protezione in zone pericolose."",
  },
  {
    "key": "upgrade_armor_04",
    "value": "Armatura Temperata",
  },
  {
    "key": "upgrade_armor_04_desc",
    "value": ""La tempratura è eseguita con una tecnica diversa da quella tradizionale europea."",
  },
  {
    "key": "upgrade_armor_05",
    "value": "Armatura Leggendaria",
  },
  {
    "key": "upgrade_armor_05_desc",
    "metadata": {
      "raw": "From lyrics to song Fame from movie Fame",
    },
    "value": ""Le migliori armature non sono mai perfette come le leggende che le circondano."",
  },
  {
    "key": "upgrade_armor_06",
    "value": "Armatura Apocalittica",
  },
  {
    "key": "upgrade_armor_06_desc",
    "metadata": {
      "raw": "From Doom game manual description of their armor and pun on title "knee-deep in the dead" – the first level from original Doom",
    },
    "value": ""Un'armatura di protezione standard progettata per una difesa da fine del mondo."",
  },
  {
    "key": "upgrade_armor_07",
    "value": "Armatura della Luna Piena",
  },
  {
    "key": "upgrade_armor_07_desc",
    "metadata": {
      "raw": "Reference to Tom Petty's song "Won't back down" from album "Full Moon Fever"",
    },
    "value": ""Quando ululerai davanti alle porte dell'Inferno, ti sarà di grande aiuto."",
  },
  {
    "key": "upgrade_armor_08",
    "value": "Armatura della Fenice",
  },
  {
    "key": "upgrade_armor_08_desc",
    "metadata": {
      "raw": "Thou – old english",
    },
    "value": ""Scrollati la cenere di dosso e inizia una nuova vita."",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01",
    "metadata": {
      "raw": " Landing soft like the cougar feline",
    },
    "value": "Cuscinetti da Felino",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01_desc",
    "value": "Riduce i danni da caduta.",
  },
  {
    "key": "upgrade_armor_reduce_falldamage_01_flavor",
    "value": ""Non è forte colui che non cade mai, ma colui che cadendo si rialza."",
  },
  {
    "key": "upgrade_armor_thorns",
    "value": "Piastre del Karma",
  },
  {
    "key": "upgrade_armor_thorns_desc",
    "value": "Infligge danni a chiunque ti ferisca con il tocco.",
  },
  {
    "key": "upgrade_armor_thorns_flavor",
    "metadata": {
      "raw": "A power ballad song by band Poison",
    },
    "value": ""Ogni rosa ha le sue spine."",
  },
  {
    "key": "upgrade_armor_guts",
    "metadata": {
      "raw": "A spoof on Hasselhoff's song True Survivor for short film Kung Fury",
    },
    "value": "Duro a Morire",
  },
  {
    "key": "upgrade_armor_guts_desc",
    "value": "Quando subisci un danno letale per la prima volta, la tua salute si rigenera completamente. L'abilità si resetta in città.",
  },
  {
    "key": "upgrade_armor_guts_flavor",
    "value": ""Sorridi, domani andrà peggio."",
  },
  {
    "key": "upgrade_armor_resistliquids",
    "metadata": {
      "raw": "Vidar = The Norse God that slayed the Fenrir Wolf",
    },
    "value": "Stivali di Vidar",
  },
  {
    "key": "upgrade_armor_resistliquids_desc",
    "value": "Capaci di resistere ad acido e lava, tuttavia necessitano di un periodo di assestamento dopo l'esposizione.",
  },
  {
    "key": "upgrade_armor_resistliquids_flavor",
    "value": ""uesti stivali ti tolgono acido e lava dai piedi. Letteralmente."",
  },
  {
    "key": "upgrade_armor_damage_reduction",
    "value": "Ultra Composito",
  },
  {
    "key": "upgrade_armor_damage_reduction_desc",
    "value": "Riduce i danni subiti.",
  },
  {
    "key": "upgrade_armor_damage_reduction_flavor",
    "value": ""Un materiale protettivo tra i più solidi mai creati."",
  },
  {
    "key": "upgrade_armor_rainbow_orbs",
    "metadata": {
      "raw": "*NEW* Song "As long as you love me" by Backstreet Boys. I don't care who you are, Where you're from, What you did, As long as you love me. The terms diversity, fluid and rainbow are used as an hommage to tolerance and the LGBTQ community.",
    },
    "value": "Varietà Sostanziale",
  },
  {
    "key": "upgrade_armor_rainbow_orbs_desc",
    "value": "Un'armatura fluida e policromatica che dona una piccola possibilità di ottenere 3 globi arcobaleno ogni volta che un nemico viene sconfitto.",
  },
  {
    "key": "upgrade_armor_rainbow_orbs_flavor",
    "value": ""Non ha importanza chi sei, da dove vieni o perché stai scavando, finché la indossi."",
  },
  {
    "key": "upgrade_armor_deflect",
    "value": "Armatura Aramidica",
  },
  {
    "key": "upgrade_armor_deflect_desc",
    "value": "Devia il primo proiettile che ti colpisce. Necessita di 30 secondi per ricaricarsi.",
  },
  {
    "key": "upgrade_armor_deflect_flavor",
    "metadata": {
      "raw": "A riposte used when someone calls you a name. Indicates that whatever ... I'm rubber you're glue, your words bounce off me and stick to you. Also a nod to its usage in Monkey Island game series.",
    },
    "value": ""Io sono la gomma, tu la colla."",
  },
  {
    "key": "upgrade_watertank",
    "value": "Tanica di acqua",
  },
  {
    "key": "upgrade_watertank_desc",
    "value": "Molte delle tue attrezzature utilizzano acqua, di cui puoi fare rifornimento nelle sorgenti all'interno della miniera.",
  },
  {
    "key": "upgrade_watertank_next_level_desc",
    "value": "Potenzia la tanica di acqua per espandere la tua riserva totale.",
  },
  {
    "key": "upgrade_watertank_01",
    "value": "Vaso semplice",
  },
  {
    "key": "upgrade_watertank_01_desc",
    "value": ""La pietra miliare della tecnologia a vapore."",
  },
  {
    "key": "upgrade_watertank_02",
    "metadata": {
      "raw": "Herman Melville - author of Moby Dick",
    },
    "value": "Regolatore Melville",
  },
  {
    "key": "upgrade_watertank_02_desc",
    "value": ""Dona un tocco classico alla tecnologia ad acqua."",
  },
  {
    "key": "upgrade_watertank_03",
    "metadata": {
      "raw": "The Notourious B.I.G. and his song Mo money Mo problems",
    },
    "value": "Water Whitman",
  },
  {
    "key": "upgrade_watertank_03_desc",
    "value": ""Cogli l'acqua quando è il momento."",
  },
  {
    "key": "upgrade_watertank_04",
    "metadata": {
      "raw": "Old band The Sisters of Mercy",
    },
    "value": "Cistern-act",
  },
  {
    "key": "upgrade_watertank_04_desc",
    "metadata": {
      "raw": "One of their songs",
    },
    "value": ""La madre superiora delle cisterne."",
  },
  {
    "key": "upgrade_watertank_05",
    "metadata": {
      "raw": "From Captain Nemo's submarine Nautilus",
    },
    "value": "Nautilus II",
  },
  {
    "key": "upgrade_watertank_05_desc",
    "metadata": {
      "raw": "Spoof on Jules Verne's book Twenty Thousand Leagues under the sea",
    },
    "value": ""Ventimila leghe d'acqua."",
  },
  {
    "key": "upgrade_watertank_water_pickup_01",
    "value": "Il Mago della Pioggia",
  },
  {
    "key": "upgrade_watertank_water_pickup_01_desc",
    "metadata": {
      "raw": " new: minor rephrasing.",
    },
    "value": "Aggiunge la possibilità di rilascio di un globo d'acqua extra dai nemici sconfitti.",
  },
  {
    "key": "upgrade_watertank_water_pickup_01_flavor",
    "metadata": {
      "raw": "BJ Thomas song Raindrops Keep falling on my head",
    },
    "value": ""Nemici a frittelle, globi a catinelle."",
  },
  {
    "key": "upgrade_watertank_improved_water_pump",
    "metadata": {
      "raw": "Technotronics old song",
    },
    "value": "Pompa Magna",
  },
  {
    "key": "upgrade_watertank_improved_water_pump_desc",
    "value": "Raccoglie l'acqua dalle pozze più rapidamente.",
  },
  {
    "key": "upgrade_watertank_improved_water_pump_flavor",
    "metadata": {
      "raw": "From the song Pump up the Jam",
    },
    "value": ""Tanica bagnata, tanica fortunata."",
  },
  {
    "key": "upgrade_watertank_water_condenser",
    "value": "Condensatore di Umidità",
  },
  {
    "key": "upgrade_watertank_water_condenser_desc",
    "value": "Trasforma l'umidità in acqua allo stato liquido.",
  },
  {
    "key": "upgrade_watertank_water_condenser_flavor",
    "metadata": {
      "raw": "Jimmy cliff song lyrics: I can see clearly now the rain is gone",
    },
    "value": ""Ti lascia secco, ma non ti lascia a secco."",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water",
    "value": "Cacciatore di Tempeste",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water_desc",
    "value": "Converte tutti i globi di luce rilasciati in globi d'acqua. Non ha effetto sui globi arcobaleno.",
  },
  {
    "key": "upgrade_watertank_light_orbs_to_water_flavor",
    "metadata": {
      "raw": "Reference to the Bible where Jesus turned water into wine",
    },
    "value": ""Dalla luce all'acqua, dall'acqua al vino. È un trucco vecchio come il mondo."",
  },
  {
    "key": "upgrade_watertank_regeneration",
    "value": "Rigenerazione Acquatica",
  },
  {
    "key": "upgrade_watertank_regeneration_desc",
    "metadata": {
      "raw": " new: minor rephrasing",
    },
    "value": "Rigenera vita nelle pozze d'acqua.",
  },
  {
    "key": "upgrade_watertank_regeneration_flavor",
    "value": ""Curarne uno per curarli tutti."",
  },
  {
    "key": "upgrade_minimap",
    "value": "Mappa",
  },
  {
    "key": "upgrade_minimap_desc",
    "value": "Tiene traccia dei luoghi dove sei stato e di dove sei diretto.",
  },
  {
    "key": "upgrade_minimap_01",
    "value": "Mappa",
  },
  {
    "key": "upgrade_minimap_01_desc",
    "metadata": {
      "raw": "Quote from Earl Nightingale, american writer",
    },
    "value": ""Tiene traccia dei luoghi dove sei stato e di dove sei diretto."",
  },
  {
    "key": "upgrade_minimap_quest_pointer",
    "metadata": {
      "raw": " (Renamed)",
    },
    "value": "Indicatori",
  },
  {
    "key": "upgrade_minimap_quest_pointer_desc",
    "metadata": {
      "raw": " Text within { } should not be translated.",
    },
    "value": "Mostra gli indicatori ({image quest_pointer_arrow} e {image quest_pointer_crosshair}) sulla mappa per guidarti verso la destinazione da raggiungere nella tua missione.\\n\\n{format bold}Se preferisci esplorare senza indicazioni, disabilita questa Mod con ingranaggio.{format reset}",
  },
  {
    "key": "upgrade_minimap_quest_pointer_flavor",
    "metadata": {
      "raw": "A nod to Lemmy's Show and the character Falconhoof. https://www.youtube.com/watch?v=oWmiShFb0go",
    },
    "value": ""Segui l'indicatore e ti mostrerà la via."",
  },
  {
    "key": "upgrade_minimap_mineral_detector",
    "metadata": {
      "raw": "Nod to the Harry Potter Marauder's Map",
    },
    "value": "Trovarisorse",
  },
  {
    "key": "upgrade_minimap_mineral_detector_desc",
    "value": "Ti mostra tutte le risorse sulla mini-mappa.",
  },
  {
    "key": "upgrade_minimap_mineral_detector_flavor",
    "metadata": {
      "raw": "Small pun on actor Roger Moore",
    },
    "value": ""Mettici una pietra sopra. E un'altra. E un'altra..."",
  },
  {
    "key": "upgrade_minimap_hp_bar",
    "metadata": {
      "raw": " Odin – all-seeing father of norse mythology, quote is merely a question without reference, feel free to make it into your own languages equivalent",
    },
    "value": "Sguardo di Odino",
  },
  {
    "key": "upgrade_minimap_hp_bar_desc",
    "value": "Mostra la salute dei tuoi nemici quando li danneggi.",
  },
  {
    "key": "upgrade_minimap_hp_bar_flavor",
    "value": ""Cosa c'è oltre gli occhi della mente?"",
  },
  {
    "key": "upgrade_run_boots",
    "metadata": {
      "raw": "*DEMO*",
    },
    "value": "Sprint Idraulico",
  },
  {
    "key": "upgrade_run_boots_desc",
    "value": "Per correre, tieni premuto {indicator run} mentre ti muovi.\\nCorrendo, ti muoverai più velocemente e salterai più in alto.",
  },
  {
    "key": "upgrade_run_boots_flavor",
    "metadata": {
      "raw": "I Blame Coco lyrics from song Quicker",
    },
    "value": ""Se vuoi vivere, devi camminare. Se vuoi vivere a lungo, devi correre."",
  },
  {
    "key": "upgrade_buddy",
    "metadata": {
      "raw": "Name",
    },
    "value": "Fen",
  },
  {
    "key": "upgrade_buddy_desc",
    "value": "Una misteriosa entità simile a un fantasma, che ora considera la tua fornace la sua casa.",
  },
  {
    "key": "upgrade_fate",
    "value": "Motore del Destino",
  },
  {
    "key": "upgrade_fate_desc",
    "value": "Potenziamenti misteriosi che fanno muovere gli ingranaggi mettendo in moto l'universo.",
  },
  {
    "key": "upgrade_fate_flavor",
    "metadata": {
      "raw": "Black Sabbath lyrics from song Symptom of the universe",
    },
    "value": ""Un unico, semplice, elegante potenziamento per spiegare tutto!"",
  },
  {
    "key": "upgrade_fate_bloodquest",
    "value": "{image danger}Missione di Sangue{image danger}",
  },
  {
    "key": "upgrade_fate_bloodquest_desc",
    "metadata": {
      "raw": "Blood Stone is a resource in the game. Text within { } should not be translated. ",
    },
    "value": "Ottieni ricompense in cambio di sangue!\\nRaddoppia la possibilità di ottenere Pietre di sangue quando i nemici muoiono, ma raddoppia anche i danni che essi ti infliggono.\\n\\n{format bold}Attivando questa Mod con ingranaggio la tua missione sarà molto più difficile. Consigliata solo per i più esperti.{format reset}",
  },
  {
    "key": "upgrade_fate_bloodquest_flavor",
    "value": ""Una vera arma a doppio taglio."",
  },
  {
    "key": "upgrade_fate_xpx2",
    "value": "{image danger}Brivido dell'Avventuriero{image danger}",
  },
  {
    "key": "upgrade_fate_xpx2_desc",
    "metadata": {
      "raw": "Text within { } should not be translated. ",
    },
    "value": "Ottieni il doppio dell'esperienza dalle uccisioni, ma i nemici rilasciano solo globi da uccisioni creative o bonus.\\n\\n{format bold}Attivando questa Mod con ingranaggio la tua missione sarà molto più difficile. Consigliata solo per i più esperti.{format reset}",
  },
  {
    "key": "upgrade_fate_xpx2_flavor",
    "metadata": {
      "raw": "Made up proverb",
    },
    "value": ""Impara come se dovessi vivere per sempre."",
  },
  {
    "key": "upgrade_fate_explosions",
    "value": "{image danger}Esplosioni Finali{image danger}",
  },
  {
    "key": "upgrade_fate_explosions_desc",
    "metadata": {
      "raw": "Text within { } should not be translated. ",
    },
    "value": "I nemici esplodono non appena muoiono.\\n\\n{format bold}Attivando questa Mod con ingranaggio la tua missione sarà molto più difficile.{format reset}",
  },
  {
    "key": "upgrade_fate_explosions_flavor",
    "metadata": {
      "raw": "Let there be light, from the bible",
    },
    "value": ""Ho appena ucciso un nemico... i nemici esplodono!"",
  },
  {
    "key": "upgrade_fate_resource_exploder",
    "metadata": {
      "raw": " Criss-Cross is refering to that the adjacent tiles will break in a cross pattern. Totally krossed out is Rap duo Kriss-Kross debut album, so it's a pun on that, but with correct spelling with c, not k.",
    },
    "value": "Esplosione incrociata",
  },
  {
    "key": "upgrade_fate_resource_exploder_desc",
    "value": "Distruggendo i blocchi di minerali provocherai una piccola esplosione che danneggerà le mattonelle adiacenti.",
  },
  {
    "key": "upgrade_fate_resource_exploder_flavor",
    "value": ""Rapido e distruttivo."",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil",
    "metadata": {
      "raw": " Latin for Seal of Heaven and Hell",
    },
    "value": "Sigillum Caelum et Infernum",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil_desc",
    "value": "Vicino al picco della solitudine\\nL'abbraccio di un deserto piangente\\nAffronta il cielo per sigillare il tuo destino\\nIn un posto strano e sorprendente.",
  },
  {
    "key": "upgrade_fate_hell_cave_sigil_flavor",
    "metadata": {
      "raw": " Nod to Twin Peaks: Fire Walk With Me, meaning that you invite the devil to join you. Fate walk with me implies that you invite fate into your life.",
    },
    "value": ""Il fuoco è il diavolo celato come un codardo nel fumo."",
  },
  {
    "key": "upgrade_steampack",
    "value": "Motore Aeronautico",
  },
  {
    "key": "upgrade_steampack_desc",
    "value": "Per volare, tieni premuto {indicator jump} quando sei in aria.\\nQuesta camera di combustione diesel sperimentale non consuma acqua, ma si surriscalda dopo poco tempo.",
  },
  {
    "key": "upgrade_steampack_next_level_desc",
    "value": "Potenzia il Motore Aeronautico per aumentare la durata.",
  },
  {
    "key": "upgrade_steampack_01",
    "metadata": {
      "raw": "From Rocketeer comic origin 1939, character Cliff Secord",
    },
    "value": "Secord Mod 38",
  },
  {
    "key": "upgrade_steampack_01_desc",
    "value": ""Un semplice motore in linea a quattro cilindri."",
  },
  {
    "key": "upgrade_steampack_02",
    "value": "Doppio Ciclone",
  },
  {
    "key": "upgrade_steampack_02_desc",
    "value": ""Raffreddato ad aria e invertito."",
  },
  {
    "key": "upgrade_steampack_03",
    "metadata": {
      "raw": "Reference to a French WW1 engine.",
    },
    "value": "Le Rhône 69",
  },
  {
    "key": "upgrade_steampack_03_desc",
    "value": ""Con un sistema di raffreddamento combinato aria/acqua. Tutto o niente."",
  },
  {
    "key": "upgrade_steampack_slayer",
    "value": "Statoreattore Vigoroso",
  },
  {
    "key": "upgrade_steampack_slayer_desc",
    "value": "Quando usi il tuo Motore Aeronautico, i nemici e le mattonelle deboli che vengono in contatto con te saranno distrutte.",
  },
  {
    "key": "upgrade_steampack_slayer_flavor",
    "metadata": {
      "raw": "Reference to Eric Clapton song Grand Illusion",
    },
    "value": ""Tra fuoco e follia."",
  },
  {
    "key": "upgrade_steampack_feather_fall",
    "metadata": {
      "raw": " References is to song Falling by Julee Cruise, and song line Don't let yourself be hurt this time.",
    },
    "value": "Cruise Control",
  },
  {
    "key": "upgrade_steampack_feather_fall_desc",
    "value": "Quando il Motore Aeronautico si surriscalda, tieni premuto {indicator jump} per ridurre la tua velocità di caduta.",
  },
  {
    "key": "upgrade_steampack_feather_fall_flavor",
    "value": ""Quello che il nemico ama più dell'eroe è vederlo cadere!"",
  },
  {
    "key": "upgrade_steampack_boost",
    "metadata": {
      "raw": " Quote from character Maverick from movie Top Gun. Maverick Afterburner is also a reference to the character played by Tom Cruise.",
    },
    "value": "Postbruciatore Maverick",
  },
  {
    "key": "upgrade_steampack_boost_desc",
    "value": "Aumenta la velocità del tuo motore aeronautico. Manda il motore su di giri e ascolta quel soave ruggito.",
  },
  {
    "key": "upgrade_steampack_boost_flavor",
    "value": ""Sento il bisogno... il bisogno di velocità!"",
  },
  {
    "key": "upgrade_steampack_in_air_cooling",
    "metadata": {
      "raw": "*NEW* Eastbound and down is a song from the movie "Smokey and the Bandit" Cletus Snow is a character from the movie, and his dog's name is Fred.",
    },
    "value": "Raffreddamento ad Aria",
  },
  {
    "key": "upgrade_steampack_in_air_cooling_desc",
    "value": "Rilascia {indicator jump} mentre sei in aria per raffreddare il Motore Aeronautico. Prodotto da Snow & Fred Ltd.",
  },
  {
    "key": "upgrade_steampack_in_air_cooling_flavor",
    "value": ""Volare è utile, raffreddare è necessario!"",
  },
  {
    "key": "upgrade_pressurebomb",
    "value": "Bomba a Pressione",
  },
  {
    "key": "upgrade_pressurebomb_desc",
    "value": "Può essere lanciata in avanti, in alto o in basso. Consuma acqua.\\nPremi {indicator tool_pressurebomb} per lanciare!",
  },
  {
    "key": "upgrade_pressurebomb_next_level_desc",
    "value": "Potenzia le bombe a pressione per poterle lanciare più lontano.",
  },
  {
    "key": "upgrade_pressurebomb_01",
    "metadata": {
      "raw": "Osmotic= water pressure terminology",
    },
    "value": "Bomba Osmotica",
  },
  {
    "key": "upgrade_pressurebomb_01_desc",
    "metadata": {
      "raw": "A small refernence, mid-range migraine, to song The Message by Grandmaster Flash and the Furious Five",
    },
    "value": ""Alta pressione = Grande forza = Notevole mal di testa."",
  },
  {
    "key": "upgrade_pressurebomb_02",
    "metadata": {
      "raw": "Per Scholander= physiologist renowned for pressure bomb technology",
    },
    "value": "Bomba Idrostatica Scholander",
  },
  {
    "key": "upgrade_pressurebomb_02_desc",
    "value": ""Lancia quel demonio sotto pressione ancora più lontano!"",
  },
  {
    "key": "upgrade_pressurebomb_03",
    "value": "Bomba Acida",
  },
  {
    "key": "upgrade_pressurebomb_03_desc",
    "metadata": {
      "raw": "Reference to Scooter song Acid Bomb",
    },
    "value": ""Una scioglievolezza irresistibile."",
  },
  {
    "key": "upgrade_pressurebomb_04",
    "metadata": {
      "raw": "Reference: Song Who Put The Bomp by Barry Mann: ""Who put the bomp in the bomp bah bomp bah bomp / Who put the ram in the rama lama ding dong / Who put the bop in the bop shoo bop shoo bop / Who put the dip in the dip da dip da dip."" =So now you can throw the bomb further = bomb bah LONGA' =longer", In Italian the refference is that the bomb sticks, like chewing gum.",
    },
    "value": "Chewing-Bomb",
  },
  {
    "key": "upgrade_pressurebomb_04_desc",
    "value": ""Un'esplosione, ma non di freschezza."",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker",
    "value": "Cartucce Buster",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker_desc",
    "value": "Aggiunge potere perforante alle tue bombe a pressione per far andare in frantumi anche le rocce più dure!",
  },
  {
    "key": "upgrade_pressurebomb_brickbreaker_flavor",
    "metadata": {
      "raw": "Ghostbusters pun - When there's something strange in the neighbourhood, who ya gonna call",
    },
    "value": ""E chi chiamerai?"",
  },
  {
    "key": "upgrade_pressurebomb_launcher",
    "value": "Lanciagranate",
  },
  {
    "key": "upgrade_pressurebomb_launcher_desc",
    "value": "Tieni premuto {indicator tool_pressurebomb} per un lancio ad arco della granata che scatena una devastazione incredibile.",
  },
  {
    "key": "upgrade_pressurebomb_launcher_flavor",
    "metadata": {
      "raw": "Billy Ray Cyrus song Achy breaky heart",
    },
    "value": ""Un trionfo d'arco."",
  },
  {
    "key": "upgrade_pressurebomb_improved_water",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Riduzione delle Tasse",
  },
  {
    "key": "upgrade_pressurebomb_improved_water_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Divide il consumo d'acqua a metà.",
  },
  {
    "key": "upgrade_pressurebomb_improved_water_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED* Biblical referense to Moses",
    },
    "value": ""Una divisione degna di Mosè."",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup",
    "value": "Bomba Aqua",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup_desc",
    "value": "Un globo d'acqua extra verrà rilasciato dalle mattonelle distrutte dalle Bombe a Pressione.",
  },
  {
    "key": "upgrade_pressurebomb_water_pickup_flavor",
    "metadata": {
      "raw": "Reference to band Wet Wet Wet and their song Love is all around",
    },
    "value": ""Doctor Acqua."",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "Amplificatore di Pressione",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius_desc",
    "metadata": {
      "raw": "*NOT CURRENTLY USED*",
    },
    "value": "L'onda d'urto della bomba a pressione danneggia i nemici a distanze maggiori.",
  },
  {
    "key": "upgrade_pressurebomb_increased_radius_flavor",
    "metadata": {
      "raw": "*NOT CURRENTLY USED* Chris Cornell song wave Goodbye",
    },
    "value": ""Tic tic... BOOM!"",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity",
    "metadata": {
      "raw": "Pun on Molotov Cocktail",
    },
    "value": "Vaccino contro le Molotov",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity_desc",
    "value": "Impedisce alle Bombe a Pressione di danneggiarti.",
  },
  {
    "key": "upgrade_pressurebomb_self_immunity_flavor",
    "value": ""Come restare immuni dai pericoli? Basta vaccinarsi."",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple",
    "metadata": {
      "raw": " ThreeForce is a reference to the Legend of Zelda TriForce, The quote is just a rhyme and not important.",
    },
    "value": "Granata Triforza",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple_desc",
    "value": "Quando carichi per sparare una Granata a Pressione, ti consente di sparare ben tre Granate a Pressione!",
  },
  {
    "key": "upgrade_pressurebomb_launcher_triple_flavor",
    "value": ""Tripla sorpresa!"",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb",
    "metadata": {
      "raw": " Norman Greenbaum song lyrics Spirit in the sky, pun on somebody being a mean spirit = bad and mean to people.",
    },
    "value": "Assalto dai Cieli",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb_desc",
    "value": "Ti consente di usare le Bombe a Pressione mentre sei in aria, quindi spicca il volo e lancia le tue bombe da una distanza di sicurezza!",
  },
  {
    "key": "upgrade_pressurebomb_air_bomb_flavor",
    "value": ""Degno della più spietata divinità dei cieli!"",
  },
  {
    "key": "upgrade_jackhammer",
    "value": "Martello Pneumatico",
  },
  {
    "key": "upgrade_jackhammer_desc",
    "value": "Un eccezionale attrezzo da scavo che distrugge i materiali troppo duri per il piccone. Funziona ad acqua. Tieni premuto {indicator tool_jackhammer} per una maggiore potenza!",
  },
  {
    "key": "upgrade_jackhammer_next_level_desc",
    "value": "Potenzia il Martello Pneumatico per migliorarne notevolmente l'efficacia.",
  },
  {
    "key": "upgrade_jackhammer_01",
    "metadata": {
      "raw": "Pun on Peter Gabriels song Sledgehammer",
    },
    "value": "Martello Poderoso",
  },
  {
    "key": "upgrade_jackhammer_01_desc",
    "metadata": {
      "raw": "Pun on Peter Gabriels song Sledgehammer - I want to be your sledgehammer",
    },
    "value": ""Ci va giù pesante!"",
  },
  {
    "key": "upgrade_jackhammer_02",
    "metadata": {
      "raw": "Titans=Mythological adversaries to the gods",
    },
    "value": "Trivella del Titano",
  },
  {
    "key": "upgrade_jackhammer_02_desc",
    "metadata": {
      "raw": "Removed MC Hammer reference",
    },
    "value": ""Grazie al maggiore risparmio di carburante, potrai gestire le tue riserve in modo più sostenibile."",
  },
  {
    "key": "upgrade_jackhammer_03",
    "metadata": {
      "raw": "From Rocky 4 - Character Ivan Drago",
    },
    "value": "Modello "Ivan Drago" Mark IV",
  },
  {
    "key": "upgrade_jackhammer_03_desc",
    "metadata": {
      "raw": "His signature phrase "I must break you"",
    },
    "value": ""Possiede una punta rinforzata con carburo di tungsteno, per spiezzare in due qualsiasi cosa."",
  },
  {
    "key": "upgrade_jackhammer_04",
    "metadata": {
      "raw": "In norse mythology Mjölnir is the hammer of the mighty Thor",
    },
    "value": "Martello Mjölnir",
  },
  {
    "key": "upgrade_jackhammer_04_desc",
    "value": ""Il richiamo di caos e cosmo."",
  },
  {
    "key": "upgrade_jackhammer_improved_water",
    "metadata": {
      "raw": "Jab - to punch NOT CURRENTLY USED",
    },
    "value": "Martello a Secco",
  },
  {
    "key": "upgrade_jackhammer_improved_water_desc",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": "Divide il consumo d'acqua a metà.",
  },
  {
    "key": "upgrade_jackhammer_improved_water_flavor",
    "metadata": {
      "raw": "NOT CURRENTLY USED",
    },
    "value": ""Caldo, ma direi più un caldo secco."",
  },
  {
    "key": "upgrade_jackhammer_faster_windup",
    "value": "Lubrificante Sintetico",
  },
  {
    "key": "upgrade_jackhammer_faster_windup_desc",
    "value": "Migliora la velocità di carica del martello pneumatico.",
  },
  {
    "key": "upgrade_jackhammer_faster_windup_flavor",
    "metadata": {
      "raw": "Frankie goes to Hollywood song Relax",
    },
    "value": ""Pronto a martellare!"",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed",
    "metadata": {
      "raw": "Tribute to band KLF - also known as the Justified Ancients of Mu Mu",
    },
    "value": "Il Cilindro del Destino",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed_desc",
    "value": "Un cilindro pneumatico potenziato. Porta la velocità operativa al massimo, ma aumenta l'utilizzo di acqua.",
  },
  {
    "key": "upgrade_jackhammer_faster_maxspeed_flavor",
    "metadata": {
      "raw": "Their tune Last train to Trancentral",
