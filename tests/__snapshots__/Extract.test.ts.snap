    "key": "upgrade_jackhammer_shockwave_desc",
    "metadata": {
      "raw": "DO NOT TRANSLATE, NOT CURRENTLY USED",
    },
    "value": "Dein Presslufthammer beschädigt zusätzliche Felder.",
  },
  {
    "key": "upgrade_jackhammer_shockwave_flavor",
    "metadata": {
      "raw": "DO NOT TRANSLATE, NOT CURRENTLY USED Reference to Guile from Street Fighter-series",
    },
    "value": ""Man muss aufpassen, dass man sich da unten nichts bricht."",
  },
  {
    "key": "upgrade_jackhammer_slower_winddown",
