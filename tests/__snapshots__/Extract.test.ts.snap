    "notes": "Do not translate",
    "value": "{image %1%} %2% $%3%{image money_small_down}",
  },
  {
    "key": "generic.need_light",
    "notes": "The players lightsource has gone out. This message is showed on screen to remind the player that the light need to be replenished",
    "value": "Need light...",
  },
  {
    "key": "generic.need_water",
    "notes": "The players water has run out. This message is showed on screen to remind the player that water need to be replenished",
    "value": "Need water...",
  },
  {
