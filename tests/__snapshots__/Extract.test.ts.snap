    "value": "Enter Archaea Mine",
  },
  {
    "key": "generic.upgrade_cog",
    "notes": "A cog (gear) that can be inserted into the equipment to give new abilities. *DEMO*",
    "value": "{image cogs_down} Upgrade Cog",
  },
  {
    "key": "generic.gain_xp",
    "notes": "DO NOT TRANSLATE",
    "value": "{format exp_text}%1% XP{format reset}",
  },
  {
    "key": "generic.gain_gold",
    "notes": "Do not translate",
